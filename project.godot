;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RenGodot"
run/main_scene="uid://bt72cvibhnqra"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=30
run/low_processor_mode=true
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"
boot_splash/print_header=true

[audio]

buses/default_bus_layout="uid://dpsiaycixqqoq"

[autoload]

GlobalState="*uid://dpylsu434xitg"
DialogueManager="*uid://c3rodes2l3gxb"
Characters="*uid://deml2lbx057tp"
AudioManager="*uid://dtcbqbwaf6krv"
StageManager="*uid://btasdhwfwk323"
Menus="*uid://bnuu3fof8hmdv"
sys="*res://scripts/Sys.gd"

[debug]

settings/stdout/print_fps=true

[dialogue_manager]

runtime/state_autoload_shortcuts=["\"Characters\""]

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3

[dotnet]

project/assembly_name="RenGodot"

[editor_plugins]

