screen witness_walkaway(spr, blur, timeout):
    layer "master"
    imagebutton:

        if blur:
            idle im.Blur(spr, blur)
            hover im.Blur(im.MatrixColor(spr,
                im.matrix.brightness(0.10)), blur)

        else:
            idle spr
            hover im.MatrixColor(spr,
                im.matrix.brightness(0.10))

        focus_mask True

        action Function(SceneFlags.Raise, "witness tapped"), Return("tap")


        at transform:
            zoom 0.80
            ypos 200
            xpos -203
            linear delay3 xpos 1920-203
            linear delay3 xpos 2*1920-203
    timer (delay2*timeout) action Hide("witness_walkaway"), Return()
    timer 18 action Hide("witness_walkaway"), Return()

transform loop_right2(img_base, img_alter, t=10):
    contains:
        img_base
        xalign .0 xpos .0
        linear t xpos 2.
        img_alter
        xalign .0 xpos .0
        linear t xpos 2.
        block:
            img_base
            xalign .0 xpos .0
            linear t xpos 2.
            repeat
    contains:
        img_alter
        xalign .0 xpos -2.
        linear t xpos .0
        img_base
        xalign .0 xpos -2.
        linear t xpos .0
        block:
            img_base
            xalign .0 xpos -2.
            linear t xpos .0
            repeat

