init python:
    title_needle_speed = 100
    title_needle_size = 7000
    title_needle_treshold1 = title_needle_size * 0.25
    title_needle_treshold2 = title_needle_size * 0.65

    title_speed_mod = 36
    title_base_duration = 240
    title_base_speed = 1.0 / title_base_duration

    class TitleMover(renpy.Displayable):
        def __init__(self, yadj):
            
            super(TitleMover, self).__init__()
            
            self.yadj = yadj
            self.x_center = 0.5
            self.sect_size = None
            self.max_value = None
            self.button_pos = None
            self.button_anchor = (0.5, 0.5)
            self.button_aftertitle = None
            
            self.current_value = 0
            
            self.last_st = 0.0
            self.end_lbl = None
            self.sections = []
            self._section_lbl = None
        
        def add_section(self, value, label):
            '''
        Список пар (значение, лейбл), отсортированный в нисходящем порядке по значениям.
        В рендере есть цикл, который перебирает пары, который прерывается при срабатывании любого из условий.
        1. Если запомненный лейбл равен лейблу, то прерываем цикл, так как мы уже в этой секции.
        2. Если текущее значение больше значения из цикла, то запоминаем лейбл и делаем джамп на него.
        '''
            if value is None:
                self.end_lbl = label
                return
            
            self.sections.append( (value, label) )
            self.sections.sort(key=lambda value: value[0], reverse=True)
        
        
        def render(self, width, height, st, at):
            import pygame
            
            dt = st - self.last_st
            self.last_st = st
            
            if self.max_value is not None and self.current_value >= self.max_value and self.end_lbl:
                renpy.jump(self.end_lbl)
            
            delta = title_base_speed * (1 + title_speed_mod * (pygame.key.get_pressed()[pygame.K_LCTRL] or pygame.key.get_pressed()[pygame.K_RCTRL])) * dt
            
            disp = renpy.get_displayable("endtitles_main", "titles_disp")
            d_width, d_height = disp.render(width, height, st, at).get_size()
            
            if self.max_value is None:
                self.max_value = (d_height - 1080) / d_height
            
            self.current_value += delta
            if self.current_value > self.max_value:
                self.current_value = self.max_value
            
            self.yadj.change(self.current_value * d_height)
            
            for val, lbl in self.sections:
                if self._section_lbl == lbl:
                    break
                if val is not None and self.current_value > val:
                    self._section_lbl = lbl
                    renpy.jump(lbl)
            
            
            
            render = renpy.Render(width, height)
            
            
            
            
            renpy.redraw(self, 0)
            return render

