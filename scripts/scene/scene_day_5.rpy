    $ renpy.start_predict("mask_03_face")
    $ renpy.start_predict("mask_03_hide")

    if not Flags.Has("olya died"):
        $ renpy.start_predict("d5_battle_incar_choise_neu")
        $ renpy.start_predict("d5_battle_incar_choise_yes")
        $ renpy.start_predict("d5_battle_incar_choise_no")
        $ renpy.start_predict("d5_battle_incar_choise_down")
    else:
        $ renpy.start_predict("d5_battle_incar_choise_solo_neu")
        $ renpy.start_predict("d5_battle_incar_choise_solo_yes")
        $ renpy.start_predict("d5_battle_incar_choise_solo_no")
        $ renpy.start_predict("d5_battle_incar_choise_solo_down")

    $ renpy.start_predict("d5_efiba_beast_base 1")
    $ renpy.start_predict("d5_efiba_beast_base 2")
    $ renpy.start_predict("d5_efiba_beast_base 3")
    $ renpy.start_predict("d5_efiba_beast_base 4")
    $ renpy.start_predict("d5_efiba_beast_tears")
    $ renpy.start_predict("d5_efiba_beast_arm 1")
    $ renpy.start_predict("d5_efiba_beast_arm 2")

    $ renpy.start_predict("d5_efiba_car2_olya 01")
    $ renpy.start_predict("d5_efiba_car2_olya 02")
    $ renpy.start_predict("d5_efiba_car2_olya 03")
    $ renpy.start_predict("d5_efiba_car2_olya 04")
    $ renpy.start_predict("d5_efiba_car2_olya 05")

    $ renpy.start_predict("d5_efiba_car0_anton")

    scene d5_uazin_bg_bg:
        subpixel True
        align (.5, 1.)
    show d5s_battle_mid_rev
    show d5s_battle_fg_rev
    show d5_uazin_bg_fg:
        subpixel True
        align (.5, 1.)
        alpha 0.75
    show d5_uazin_bg_1:
        subpixel True
        align (.5, 1.)
    show d5_incarhug oshut
    show d5_uazin_bg_2
    with Dissolve(.5)
    play test_five "voice/olya/5day/35 droz.ogg"
    "Оля прижалась ко мне, дрожа всем телом."
    "В салоне было холодно, но не стужа, а страх заставлял нас трепетать на заднем сидении."
    show d5_incarhug -oshut with Dissolve(.5)
    pause 0.5
    show d5_incarhug otalk with Dissolve(.2)
    voice "voice/olya/5day/37 Chto.ogg"
    Oly "Что они делают?"
    show d5_incarhug -otalk with Dissolve(.2)
    show d5_incarhug otalk with Dissolve(.2)
    voice "voice/olya/5day/38 Gde.ogg"
    Oly "Где мамочка?"
    show d5_incarhug atalk -otalk with Dissolve(.2)
    voice "voice/Anton/5day/282 m.ogg"
    Ant "Мамочка скоро придёт."
    show d5_incarhug -atalk with Dissolve(.2)
    show d5_incarhug oshut with Dissolve(.5)
    "Я обнял сестру и прикрыл рукой её глаза. Ресницы Оли дрожали под ладонью."
    show d5_incarhug atalk with Dissolve(.2)
    voice "voice/Anton/5day/283 n.ogg"
    Ant "Не смотри."
    show d5_incarhug -atalk with Dissolve(.2)

    scene d5_police_front_bg:
        blur 8
    show d5s_battle_bg_rev:
        blur 8
    show d5s_battle_mid_rev:
        blur 8
    show d5s_battle_fg_rev zorder 20:
        blur 8
    show d5_police_front_sl_5 zorder 90
    show d5_police_front_sl_4 zorder 100
    show d5_police_front_sl_3 zorder 110
    show layer master:
        align (.5, .5)
        zoom 1.1
    with Dissolve(.5)

    play sound "sounds/sfx_whoosh.ogg"
    show d4_road_dark_shadow zorder 80:
        anchor (1., 0.)
        pos (0., 1.)
        linear 0.5 pos (1., 0.) anchor (0., 1.)
    "Стёкла милицейского автомобиля затянуло инеем. Я различал лишь смутные пятна, мечущиеся в пурге."

    with hpunch
    play sound "sounds/sfx_car_attack.ogg"
    "Кто-то перепрыгнул через моторный отсек. Прополз под днищем машины. Промчался справа."

    play sound "sounds/sfx_whoosh.ogg"
    show d4_road_dark_shadow zorder 80:
        anchor (0., 0.)
        pos (1., 1.)
        linear 0.5 pos (0., 0.) anchor (1., 1.)
    "Одно пятно, преследующее другое."

    scene d5_uazin_bg_bg:
        subpixel True
        align (.5, 1.)
    show d5s_battle_mid_rev
    show d5s_battle_fg_rev
    show d5_uazin_bg_fg:
        subpixel True
        align (.5, 1.)
        alpha 0.75
    show d5_uazin_bg_1:
        subpixel True
        align (.5, 1.)
    show d5_incarhug oshut
    show d5_uazin_bg_2
    with Dissolve(.5)

    $ renpy.stop_predict("d4_road_dark_shadow")

    show d5_incarhug otalk with Dissolve(.2)
    voice "voice/olya/5day/39 Dya.ogg"
    Oly "Дядя милиционер нас спасёт?"
    show d5_incarhug -otalk with Dissolve(.2)
    "Я не был в этом уверен."
    "Часть меня, до странного хладнокровная и хитрая, осознавала, что надежды на взрослых нет."
    "Надо действовать самому."

    scene d5_efiba_car2_bg:
        align (.4, .5)
        zoom 1.6
    show Olya Weeps b_dark 01 shut 01:
        align (.5, 1.)
        zoom 0.90
        xoffset 100
        yoffset 50
    show d5_efiba_car2_ant_base 2 ahead:
        xoffset -450
    with Dissolve(.5)
    voice "voice/anton/5day/05 tih.ogg"
    "{i}«Тихонов проиграет,{/i} — подумал я, — {i}он слаб».{/i}"
    voice "voice/anton/5day/06 kol.ogg"
    "{i}Колдовство не берут пули, против него действует лишь другое колдовство.{/i}"
    voice "voice/anton/5day/07 mm.ogg"
    "{i}Маска была спрятана под жилеткой с тех пор, как я забрал её из лап чудовищ.{/i}"
    voice "voice/anton/5day/08 oni.ogg"
    "{i}Они хотели, чтобы я был частью их стаи, но сейчас это неважно.{/i}" id event_final_battle_olyayes_c4a6dde4
    voice "voice/anton/5day/09 t.ogg"
    "{i}Только я могу помочь друзьям.{/i}"
    stop music fadeout 4.5
    show d5_efiba_car2_ant_base 2 ahead_to_aside
    voice "voice/anton/5day/10 na.ogg"
    "{i}Надо спешить, пока они не стали кучкой костей в мешке с угощениями...{/i}"
    voice "voice/anton/5day/11 oni.ogg"
    "{i}Они зовут меня!{/i}"

    scene d5_police_rambo_bg:
        xzoom -1
    show d5s_battle_bg_rev:
        blur 8
    show d5s_battle_mid_rev:
        blur 8
    show d5s_battle_fg_rev zorder 8:
        blur 8

    show d5_police_incar_cab zorder 10
    show d5_anton_back zorder 10:
        align (.5, 1.)
        zoom .45
        xoffset 900
    show d5_police_incar_chair zorder 10
    with Dissolve(.5)

    $ renpy.stop_predict("d5_efiba_car2_ant_base 2 ahead_to_aside")

    "В этот момент показалось, что я слышу заглушаемые стихией голоса Полины и Ромки."

    show d5_police_incar_z0 zorder 5:
        align (.5, .5)
        xoffset -200
        zoom 0.8
        parallel:
            easein 1. xoffset 0 zoom 1.
        parallel:
            linear .25 yoffset -15
            linear .25 yoffset 0
            linear .25 yoffset -10
            linear .25 yoffset 0
    with Dissolve(1.)
    play test_six "sounds/piano-hit-3.ogg"
    "Тёмный овал вырос за водительскими дверцами."

    show d5_police_incar_z0:
        align (.5, .5)
        linear .5 xoffset 300 alpha 0
    play music "music/some_ambient.ogg" fadein 4.5
    "Будто чьё-то лицо ткнулось в морозное стекло и сразу же исчезло."
    voice "voice/anton/5day/12 na.ogg"
    "{i}«Надень её»{/i}, — сказал я себе."
    "Или не я?"
    "Это всё ещё мои собственные мысли?"
    "Олины слёзы согревали ладонь. Времени в обрез."
    "Я могу стать героем для Ромы и Полины. И для сестрёнки..."
    "Но без чуда мне их не спасти."

    scene d5_efiba_car2_bg:
        align (.4, .5)
        zoom 1.6
    show Olya Weeps b_dark 01 shut 01:
        align (.5, 1.)
        zoom 0.90
        xoffset 100
        yoffset 50
    show d5_efiba_car2_ant_base 2 ahead:
        xoffset -450
    with Dissolve(.5)
    show d5_battle_incar_hand:
        subpixel True
        yanchor .5
        ypos 540 +200
        parallel:
            easein 2. ypos 540 +0
        parallel:
            xpos 100
            easein 2. xpos 0
        parallel:
            ease 1.5 xoffset -10 yoffset 0
            ease 1.5 xoffset -5 yoffset -10
            ease 1.5 xoffset 5 yoffset 0
            ease 1.5 xoffset 0 yoffset 10
            repeat
    with Dissolve(.5)

    $ renpy.stop_predict("d5_police_rambo_bg")
    $ renpy.stop_predict("d5_police_incar_z0")
    $ renpy.stop_predict("d5_police_incar_chair")
    $ renpy.stop_predict("d5_anton_back")
    $ renpy.stop_predict("d5_police_incar_cab")
    $ renpy.stop_predict("d5_efiba_car2_ant_base 2 ahead")

    play sound "sounds/sfx_mask_rustle.ogg"
    stop test_four fadeout 12
    stop test_five fadeout 12
    "Продолжая закрывать Оле глаза, я вытащил маску."
    "Кто её создал? Кто поселил в ней зверя, и что этой мрачной силе нужно?"
    "Я вправду хочу срастись с тем, о чём не имею ни малейшего представления?"
    "Это же как облиться бензином, поджечь себя и кидаться на противника..."
    voice "voice/anton/5day/13 ne.ogg"
    "{i}«Не думай об этом сейчас»{/i}, — твердил внутренний голос. {i}«Не мешкай».{/i}"
    "Я осторожно отнял руку от Оли. Сестрёнка зажмурилась и спросила не глядя:"

    show Olya Weeps b_dark 01 shut 05 with Dissolve(.2)
    voice "voice/olya/5day/40 Ku.ogg"
    Oly "Куда ты?"
    show Olya Weeps b_dark 01 shut 01 with Dissolve(.2)
    voice "voice/Anton/5day/284 N.ogg"
    Ant "Никуда. Я здесь. Я всегда буду здесь."
    "Маска казалась такой приятной на ощупь. Её изнанка манила."
    "Мурашки покрыли кожу. Предчувствия охватили."
    "Так бывает в детстве, накануне Нового года, когда ты ещё веришь в магию и доброту бродящего под луной старика."
    play sound "sounds/sfx_rustle_cloth_2.ogg"
    show d5_battle_incar_hand:
        parallel:
            ease 1. xpos -300 ypos 540 -50
        parallel:
            ease 1.5 xoffset -10 yoffset 0
            ease 1.5 xoffset -5 yoffset -10
            ease 1.5 xoffset 5 yoffset 0
            ease 1.5 xoffset 0 yoffset 10
            repeat
    "Я поднёс маску к лицу."
    show Olya Weeps b_dark 01 good ahead 01 with Dissolve(.2)

    "Пальцы Оли окольцевали моё запястье. Я слегка покосился на сестру, сталкиваясь с её умоляющим взглядом."
    show Olya Weeps b_dark 01 good ahead 05 with Dissolve(.2)
    voice "voice/olya/5day/41 Ne.ogg"
    Oly "Не надевай её."
    show Olya Weeps b_dark 01 good ahead 01 with Dissolve(.2)

    voice "voice/Anton/5day/285 t.ogg"
    Ant "Ты не понимаешь. Это наш шанс."

    show Olya Weeps b_dark 01 good ahead 06 with Dissolve(.2)
    voice "voice/olya/5day/42 Eto.ogg"
    Oly "Это ловушка! Плохое не может сделать хорошо."
    show Olya Weeps b_dark 01 good ahead 01 with Dissolve(.2)

    "Она подыскивала слова, чтобы убедить меня опомниться."
    "Оля видела что-то такое, чего не замечал я."

    show Olya Weeps b_dark 01 good ahead 05 with Dissolve(.2)
    voice "voice/olya/5day/43 Os.ogg"
    Oly "Остановись."
    show Olya Weeps b_dark 01 good ahead 01 with Dissolve(.2)

    "И что потом? Похороним близких, если сами доживём до похорон?"

    queue sound ["<silence 0.4>","sounds/sfx_car_door_knock.ogg"]
    scene d5_efiba_car3_bg 1
    show layer master:
        subpixel True
        align (.5, .5)
        zoom 1.0
        .5
        block:
            linear .05 zoom 1.04
            linear .15 zoom 1.03
            linear .05 zoom 1.06
            linear .15 zoom 1.05
            linear .05 zoom 1.08
            linear .15 zoom 1.07
            linear .05 zoom 1.10
            linear 1.5 zoom 1.00
    with Dissolve(.15)
    play test_five "voice/olya/5day/44 Vsk.ogg"
    "В дверцы справа от меня яростно заколотили, так что Оля вскрикнула."

    play test_one "sounds/sfx_car_attack.ogg"
    show layer master:
        subpixel True
        align (.5, .5)
        zoom 1.12
        linear 1.5 zoom 1.00
    show d5_efiba_car3_bg 2
    with Dissolve(.15)
    "Размытая пятерня шлёпнулась о стекло, ногти соскребли иней."

    play sound "sounds/sfx_car_door_handle_LOUD.ogg"

    "Ручка трещала под напором того, кто рвался в салон."

    label event_final_battle_olyayes.choice:

    $ story_manager.MarkEvent(("day5", "carmask"))

    window hide
    scene d5_uazin_bg_bg:
        subpixel True
        align (.5, 1.)
    show d5s_battle_mid_rev
    show d5s_battle_fg_rev
    show d5_uazin_bg_fg:
        subpixel True
        align (.5, 1.)
        alpha 0.75
    show d5_uazin_bg_1:
        subpixel True
        align (.5, 1.)
    show d5_uazin_bg_2 zorder 10
    show d5_battle_incar_choise_neu:
        align (.0, .0)
    with Dissolve(.5)

    hide d5_battle_incar_choise_neu
    show screen day5_incar_yes_no_olya_choice()
    with Dissolve(.5)
    $ ui.interact()

label event_final_battle_yes_mask:
    $ Flags.Raise("day5 mask")
    $ story_manager.MarkEvent(("day5", "carmask", "mask"))
    jump event_final_battle_yes_mom

label event_final_battle_yes_mom:
    $ story_manager.MarkEvent(("day5", "scene24"))

    if Flags.Has("day5 mask"):
        show d5_battle_incar_choise_yes:
            align (.0, .0)
        hide screen day5_incar_yes_no_olya_choice
        with Dissolve(.5)
        "Ради тебя, сестрёнка. Надеюсь, ты поймёшь меня позже..."
        window hide
        scene d5_police_front_bg:
            blur 8
        show d5s_battle_bg_rev:
            blur 8
        show d5s_battle_mid_rev:
            blur 8
        show d5s_battle_fg_rev_solo zorder 20:
            blur 8

        show d5_police_front_sl_4 zorder 40
        show mask_03_face zorder 50
        with Dissolve(0.5)

        play sound "sounds/sfx_wear_mask.ogg"

        pause .5

        hide mask_03_face
        show mask_03_hide zorder 50
        with Dissolve(0.3)


        $ achievement_grant("ach_beast")

        window show
        "Маска коснулась лица, как шершавый язык зверя, вызвав короткое замыкание в черепной коробке."
        voice "voice/anton/2day/Vdoh.ogg"
        "Мои лёгкие расширились. Я вдохнул воздух, пахнущий бойней и грязным салоном автомобиля."
    else:
        show d5_battle_incar_choise_no:
            align (.0, .0)
        hide screen day5_incar_yes_no_olya_choice
        with Dissolve(.5)
        voice "voice/Anton/5day/286 t.ogg"
        Ant "Ты права... как всегда... прости меня..."

        hide d5_battle_incar_choise_no
        show d5_battle_incar_choise_down:
            align (.0, .0)
        with Dissolve(.5)

        play test_two "sounds/sfx_rustle_cloth_3.ogg"
        stop music fadeout 5.5


        $ achievement_grant("ach_human")

        "Я выронил маску. Достаточно этого кошмарного волшебства, порождённого лесом и тьмой."
        "Игры в зверей закончились."

    $ renpy.stop_predict("d5_efiba_car3_bg 1")
    $ renpy.stop_predict("d5_battle_incar_choise_neu")
    $ renpy.stop_predict("d5_battle_incar_choise_yes")
    $ renpy.stop_predict("mask_03_face")
    $ renpy.stop_predict("mask_03_hide")
    $ renpy.stop_predict("d5_battle_incar_choise_no")
    $ renpy.stop_predict("d5_battle_incar_choise_down")

    scene d5_efiba_car3_bgbg
    show d5s_battle_mid_rev:
        blur 2
        zoom 2
        align (.5, .5)
        transform_anchor True
        rotate -40
    show d5s_battle_fg_rev:
        align (.5, .5)
        transform_anchor True
        rotate -40
        zoom 2

    show layer master:
        align (.5, .5)
        zoom 1.05
    show d5_efiba_car3_bg 2
    with Dissolve(.5)
    pause 0.5

    stop music fadeout 3.5
    play music2 "music/AmbFinal, full.ogg" fadein 1.5 
    play sound "sounds/sfx_car_door_OPEN.ogg"
    play fon "sounds/ambience_blizzard_inside.ogg" fadein 1 loop
    show d5_efiba_car3_door
    show d5_efiba_car3_bg 3 zorder 1
    with hpunch
    "Будто возражая мне, пассажирская дверца распахнулась так резко, что едва не вылетела из петель."

    play test_one "sounds/sfx_footstep_snow_creepy_1.ogg"
    show d5_efiba_beast_base 1
    show d5_efiba_beast_arm 1
    with Dissolve(.5)
    play test_five "voice/karina/5day/017 krya.ogg"
    "В проёме бушевала вьюга, и вычерчивалась худощавая женская фигура. Голова скрывалась из виду."

    show d5_efiba_beast_arm 2 zorder 3
    with Dissolve(.25)
    play test_five "voice/karina/5day/020 krrr .ogg"
    play sound "sounds/sfx_fight_rustle_1.ogg" volume 0.67
    "Бледные руки шарили по металлу, как какие-то пауки-альбиносы, заползая в наше с Олей убежище."
    "Сестра впилась пальцами в моё плечо."
    "Женщина начала наклоняться, медленно сгибаясь в пояснице, словно проржавелый механизм."

    play sound "sounds/sfx_fight_rustle_1.ogg" volume 0.67
    hide d5_efiba_beast_arm
    show d5_efiba_beast_base 2 zorder 2
    with Dissolve(.5)
    voice "voice/karina/5day/001 Rik.ogg"
    "Показался подбородок в свалянной шерсти... рот... прорези для глаз."

    if Flags.Has("day5 mask"):
        play test_five "voice/karina/5day/005 Dih.ogg"
        "Почти такая же маска, как та, что закрывала моё собственное лицо."
    else:
        play test_five "voice/karina/5day/005 Dih.ogg"
        "Почти такая же маска, как та, что когда-то закрывала моё собственное лицо."
    "Только в разы ужаснее, искажённее, словно отражение в кривом зеркале." id event_final_battle_yes_mom_b1c28aac

    play sound "sounds/sfx_metal_scrape.ogg"

    "Зрачки блеснули в дырах. Ногти заскрежетали по железу."

    $ is_mask = "nomask"
    if Flags.Has("day5 mask"):
        $ is_mask = "mask"

    scene d5_efiba_car2_bg
    show d5_efiba_car0_anton:
        align (.5, 1.)
        zoom 0.9
        xoffset -300
    show d5_efiba_car2_olya 01:
        align (.5, 1.)
        zoom 0.9
        xoffset 100 yoffset 100

    show d5_efiba_car2_arms:
        subpixel True
        xoffset 200 +250
        yoffset -100 -425
        easein 2.0 xoffset 0 +250 yoffset 0 -425
    with Dissolve(.5)
    show d5_efiba_car2_olya 02 with Dissolve(.2)
    voice "voice/olya/5day/45 Ne.ogg"
    Oly "Не надо, тётенька!"
    show d5_efiba_car2_olya 01 with Dissolve(.2)

    scene d5_efiba_car3_bgbg
    show d5s_battle_mid_rev:
        blur 2
        zoom 2
        align (.5, .5)
        transform_anchor True
        rotate -40
    show d5s_battle_fg_rev:
        align (.5, .5)
        transform_anchor True
        rotate -40
        zoom 2
    show layer master:
        align (.5, .5)
        zoom 1.05
    show d5_efiba_car3_door
    show d5_efiba_car3_bg 3 zorder 1
    show d5_efiba_beast_base 2 zorder 2
    with Dissolve(.5)
    "Кто она?"
    play test_five "voice/karina/5day/001 Rik2.ogg"
    "Почему эти гротескные движения конечностей кажутся знакомыми?"

    scene d5_efiba_car2_bg
    show d5_efiba_car0_anton:
        align (.5, 1.)
        zoom 0.9
        xoffset -300
    show d5_efiba_car2_olya 01:
        align (.5, 1.)
        zoom 0.9
        xoffset 100 yoffset 100
    show d5_efiba_car2_arms:
        subpixel True
        xoffset +250
