    label event_m_polina_guitar.r_fail:
        $ story_manager.MarkEvent(("day5", "game guitar", "mistake"))
        python:
            candidates1 = [".fail_01", ".fail_02", ".fail_03", ".fail_04"]
            candidates2 = [".fail_05", ".fail_06", ".fail_07", ".fail_08"]
            options = [opt for opt in candidates1 if opt not in guitar_fail_react]
            if not options:
                options = [opt for opt in candidates2 if opt not in guitar_fail_react]

            if options:
                renpy.random.shuffle(options)
                selected = options.pop()
                guitar_fail_react.append(selected)
            else:
                selected = ".fail_default"
            call_label = "event_m_polina_guitar" + selected


