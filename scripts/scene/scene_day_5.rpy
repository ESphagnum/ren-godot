















































default true_detective_count5 = 0

label d5_setup hide:

    menu:
        "Настроить события":
            pass
        "Продолжить как есть":
            jump day_5
        "Выбрать пресет":
            jump d5_setup.presets

    scene black
    label d5_setup.mainloop hide:

        call d5_setup.check

        menu:
            "День 1":
                jump d5_setup.d1_loop
            "День 2":
                jump d5_setup.d2_loop
            "День 3":
                jump d5_setup.d3_loop
            "День 4":
                jump d5_setup.d4_loop
            "Проверка":

                $ msg = str(Flags.vault)
                "[msg]"
                jump d5_setup.mainloop
            "Начать":

                return

    label d5_setup.check hide:
        $ Flags.Drop("betray")

        if not Flags.Has("fight"):
            $ Flags.Drop("day2 polina")
            $ Flags.Drop("day2 fox")
            $ Flags.Raise("mask")

        if Flags.Has("mask"):
            $ Flags.Raise("agree")
            $ Flags.Drop("polhouse")
            $ Flags.Drop("amulet")
            $ Flags.Drop("polaroid")
            $ Flags.Drop("katya")
            $ Flags.Drop("help")
            $ Flags.Drop("photo")

        if Flags.Has("day2 polina"):
            $ Flags.Drop("day2 fox")
            $ Flags.Raise("polhouse")
            $ Flags.Raise("amulet")
        else:
            $ Flags.Drop("polhouse")
            $ Flags.Drop("amulet")

        if Flags.Has("day2 fox"):
            $ Flags.Drop("day2 polina")
        else:
            $ Flags.Drop("polaroid")
            $ Flags.Drop("katya")
            $ Flags.Drop("help")
            $ Flags.Drop("photo")


        if not Flags.Has("gum"):
            $ Flags.Drop("polaroid")
            $ Flags.Drop("photo")

        return

    label d5_setup.d1_loop hide:
        call d5_setup.check
        menu:
            "Назад":
                jump d5_setup.mainloop

            "Перчатка (-)" if not Flags.Has("glove"):
                $ Flags.Raise("glove")
            "Перчатка (+)" if Flags.Has("glove"):
                $ Flags.Drop("glove")

            "Номер (-)" if not Flags.Has("number"):
                $ Flags.Raise("number")
            "Номер (+)" if Flags.Has("number"):
                $ Flags.Drop("number")

            "Запись (-)" if not Flags.Has("record"):
                $ Flags.Raise("record")
            "Запись (+)" if Flags.Has("record"):
                $ Flags.Drop("record")

        jump d5_setup.d1_loop

    label d5_setup.d2_loop hide:
        call d5_setup.check
        menu:
            "Назад":
                jump d5_setup.mainloop

            "Жвачка (-)" if not Flags.Has("gum"):
                $ Flags.Raise("gum")
            "Жвачка (+)" if Flags.Has("gum"):
                $ Flags.Drop("gum")

            "Отпор Семёну (-)" if not Flags.Has("fight"):
                $ Flags.Raise("fight")
                $ Flags.Raise("day2 polina")
                $ Flags.Raise("amulet")
            "Отпор Семёну (Полина)" if Flags.Has("fight") and Flags.Has("day2 polina"):
                $ Flags.Drop("day2 polina")
                $ Flags.Raise("day2 fox")
            "Отпор Семёну (Лиса)" if Flags.Has("fight") and Flags.Has("day2 fox"):
                $ Flags.Drop("day2 fox")
                $ Flags.Drop("fight")
                $ Flags.Raise("mask")

            "Маска (-)" if not Flags.Has("mask"):
                $ Flags.Raise("mask")
            "Маска (+)" if Flags.Has("mask"):
                $ Flags.Drop("mask")

        jump d5_setup.d2_loop

    label d5_setup.d3_loop hide:
        call d5_setup.check
        menu:
            "Назад":
                jump d5_setup.mainloop

            "Папка (-)" if not Flags.Has("doc"):
                $ Flags.Raise("doc")
            "Папка (1)" if Flags.Has("doc") and not Flags.Has("finger"):
                $ Flags.Raise("finger")
            "Папка (2)" if Flags.Has("finger"):
                $ Flags.Drop("doc")
                $ Flags.Drop("finger")

            "Фоторобот (-)" if not Flags.Has("silent") and not Flags.Has("witness"):
                $ Flags.Raise("silent")
            "Фоторобот (Промолчал)" if Flags.Has("silent"):
                $ Flags.Drop("silent")
                $ Flags.Raise("witness")
            "Фоторобот (Свидетель)" if Flags.Has("witness"):
                $ Flags.Drop("witness")

            "Полароид (N/A)" if not Flags.Has("gum"):
                pass
            "Полароид (-)" if Flags.Has("gum") and not Flags.Has("polaroid"):
                $ Flags.Raise("polaroid")
            "Полароид (+)" if Flags.Has("gum") and Flags.Has("polaroid"):
                $ Flags.Drop("polaroid")

            "Амулет (N/A)" if Flags.Has("mask") or Flags.Has("day2 fox"):
                pass


            "Амулет (+)" if not Flags.Has("mask") and Flags.Has("day2 polina"):
                pass

            "Предательство (N/A)" if Flags.Has("mask") or Flags.Has("day2 polina"):
                pass
            "Предательство (-)" if not Flags.Has("mask") and Flags.Has("day2 fox"):
                pass



        jump d5_setup.d3_loop

    label d5_setup.d4_loop hide:
        call d5_setup.check
        $ katya_prereq = not (Flags.Has("mask") and not Flags.Has("day2 fox"))
        menu:
            "Назад":
                jump d5_setup.mainloop

            "Катя (N/A)" if not katya_prereq:
                pass
            "Катя (не встретил)" if katya_prereq and not Flags.Has("katya"):
                $ Flags.Raise("katya")
            "Катя (встретил/не помог)" if katya_prereq and Flags.Has("katya") and not Flags.Has("help"):
                $ Flags.Raise("help")
            "Катя (помог/без фото)" if katya_prereq and Flags.Has("katya") and Flags.Has("help") and not Flags.Has("photo"):
                if Flags.Has("polaroid"):
                    $ Flags.Raise("photo")
                else:
                    $ Flags.Drop("katya")
                    $ Flags.Drop("help")
            "Катя (фото)" if katya_prereq and Flags.Has("katya") and Flags.Has("help") and Flags.Has("photo"):
                $ Flags.Drop("katya")
                $ Flags.Drop("help")
                $ Flags.Drop("photo")

            "Угощение (-)" if not Flags.Has("agree"):
                $ Flags.Raise("agree")
            "Угощение (+)" if Flags.Has("agree"):
                if not Flags.Has("mask"):
                    $ Flags.Drop("agree")


        jump d5_setup.d4_loop

    label d5_setup.presets hide:
        call d5_setup.check
        menu:
            "Телефон (+)" if Flags.Has("number"):
                $ Flags.Drop("number")
                jump d5_setup.presets
            "Телефон (-)" if not Flags.Has("number"):
                $ Flags.Raise("number")
                jump d5_setup.presets
            "Фоторобот (+)" if Flags.Has("witness"):
                $ Flags.Drop("witness")
                jump d5_setup.presets
            "Фоторобот (-)" if not Flags.Has("witness"):
                $ Flags.Raise("witness")
                jump d5_setup.presets
            "Улики (+)" if Flags.Has("glove") and Flags.Has("finger") and Flags.Has("photo") and Flags.Has("record"):
                $ Flags.Drop("glove")
                $ Flags.Drop("finger")
                $ Flags.Drop("photo")
                $ Flags.Drop("record")
                jump d5_setup.presets
            "Улики (-)" if not (Flags.Has("glove") and Flags.Has("finger") and Flags.Has("photo") and Flags.Has("record")):
                $ Flags.Raise("glove")
                $ Flags.Raise("doc")
                $ Flags.Raise("finger")
                $ Flags.Raise("gum")
                $ Flags.Raise("katya")
                $ Flags.Raise("help")
                $ Flags.Raise("polaroid")
                $ Flags.Raise("photo")
                $ Flags.Raise("record")
                $ Flags.Raise("fight")
                $ Flags.Raise("day2 fox")
                jump d5_setup.presets
            "Угощение (+)" if Flags.Has("agree"):
                $ Flags.Drop("agree")
                jump d5_setup.presets
            "Угощение (-)" if not Flags.Has("agree"):
                $ Flags.Raise("agree")
                jump d5_setup.presets

            "Рут Соло" if Flags.Has("mask"):
                $ Flags.Drop("mask")
                $ Flags.Raise("fight")
                $ Flags.Raise("day2 fox")
                jump d5_setup.presets

            "Рут Лисы" if Flags.Has("day2 fox") and not Flags.Has("mask"):
                $ Flags.Drop("day2 fox")
                $ Flags.Raise("day2 polina")
                jump d5_setup.presets

            "Рут Полины" if Flags.Has("day2 polina") and not Flags.Has("mask"):
                $ Flags.Drop("fight")
                jump d5_setup.presets
            "Начать":

                return


        call d5_setup.check
        return

    return

label d5_police_and_jail hide:
    if not Flags.Has("agree") and Flags.Has("number"):
        if Flags.Has("witness"):
            $ Flags.Raise("jailed")
        if Flags.Has("glove") and Flags.Has("record") and Flags.Has("finger") and Flags.Has("photo"):
            $ Flags.Raise("savior")
    return

label d5_guest_calculator hide:
    if Flags.Has("agree"):
        $ Flags.Raise("guest mom")
    else:
        if Flags.Has("day2 polina"):
            $ Flags.Raise("guest polina")
        if Flags.Has("day2 fox"):
            $ Flags.Raise("guest roma")
    return

label d5_dev_choice_polya hide:
    menu:
        "Полина и Оля застряли! Кого спасать?"
        "СПАСТИ ПОЛИНУ":
            $ Flags.Raise("olya died")
        "СПАСТИ ОЛЮ":
            if Flags.Has("guest polina"):
                $ Flags.Raise("polina died")
    return

label d5_dev_choice_zhulka hide:
    show black as devblack onlayer master1 zorder 100
    menu:
        "УБИТЬ ЖУЛЬКУ":
            $ Flags.Raise("meat")
        "ПОЩАДИТЬ ЖУЛЬКУ":
            pass
    hide devblack onlayer master1
    return

label d5_dev_choice_guests hide:
    show black as devblack onlayer master1 zorder 100
    menu:
        "ОТКРЫТЬ ДВЕРЬ":
            $ Flags.Raise("invited")
        "НИКОГО НЕ ВПУСКАТЬ":
            pass
    hide devblack onlayer master1
    return

label d5_true_detective_calculate hide:

    if true_detective_count5 == 5:
        $ persistent.has_d5_detective = True

    if not persistent.has_d4_detective_rootA:
        return
    if not persistent.has_d4_detective_rootB:
        return
    if not persistent.has_d4_detective_rootC:
        return

    if not persistent.has_d1_detective:
        return
    if not persistent.has_d2_detective:
        return
    if not persistent.has_d3_detective:
        return
    if not persistent.has_d5_detective:
        return


    $ achievement_grant("ach_detective_5")

    return



