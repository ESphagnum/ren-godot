translate japan d5_ending_was_there_aftertitles_f3d6f91e:



    voice "voice/karina/5day/189 Ed.ogg" 
    Mam "あっちをお願い。私がテーブルの準備をするわ。"


translate japan d5_ending_was_there_aftertitles_6857240e:


