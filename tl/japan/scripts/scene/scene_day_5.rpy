translate japan event_m_polina_phone_katya_4cb97242:



    voice "voice/Anton/5day/124 Pro.ogg"
    Ant "どうしたの？"


translate japan event_m_polina_phone_katya_40c680c5:



    voice "voice/kate/5day/19 ya.ogg"
