translate japan d5_ending_was_there_aftertitles_13160a96:


    "私は身震いした。"


translate japan d5_ending_was_there_aftertitles_32dd35b4:


    "背筋に寒気が走った。"


translate japan d5_ending_was_there_aftertitles_70b331f2:



    voice "voice/karina/5day/193 Tri.ogg"
