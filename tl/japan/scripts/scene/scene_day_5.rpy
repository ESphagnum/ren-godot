translate japan d5_ending_was_there_aftertitles_44b3f8b3:



    voice "voice/Anechka/06 ti.ogg"
    Anya "おばあちゃん！"


translate japan d5_ending_was_there_aftertitles_1b3368f8:



    voice "voice/karina/5day/191 Be.ogg"
