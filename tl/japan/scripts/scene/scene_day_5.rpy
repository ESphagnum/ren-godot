translate japan d5_ending_was_there_aftertitles_230d7509:



    voice "voice/olya/5day/118 Sni.ogg"
    Oly "外してって言ってるでしょ！もうすぐご飯よ！"


translate japan d5_ending_was_there_aftertitles_af968b6a:


