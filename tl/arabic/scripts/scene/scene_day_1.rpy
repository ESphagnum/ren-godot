    Ant ".بالتأكيد سنأتي بشيء ما"


translate arabic bunny1_find1_ed32c63e:



    voice "voice/olya/75 O.ogg"
    Oly ".دعنا نطلب من أبي تصحيح عمرك في جواز سفرك"


translate arabic bunny1_find1_1f50fa9e:



    voice "voice/anton/1day/074. S czego.ogg"
    Ant "لماذا سيقوم والدي بتزوير المستندات؟"


translate arabic bunny1_find1_50a2f9db:


