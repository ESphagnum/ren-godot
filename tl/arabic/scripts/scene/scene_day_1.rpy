


translate arabic day_1_9f1c2ade:


    ".طوال الليل هزت الرياح مخالبها عبر النافذة"


translate arabic day_1_75bd1c64:


    ".طاف في الحقول وصار يعوي مثل وحش جائع"


translate arabic day_1_b2f2e307:


    ".أغنية لا نهاية لها تتلوى مثل حبل منسوج من مجموعة متنوعة من الأصوات - الرفيعة والملمحة الناعمة والساخرة"


translate arabic day_1_b5d94530:


    "...بدا أنها تصرخ و تضحك"


translate arabic day_1_004c8f87:


    ".و تجادل في شيء ما..."


translate arabic day_1_57cbf6cb:


    ".كان أحدهم يركض عبر الثلج ويلقي بظلاله الطويلة. إما اقتربوا من السرير أو فلتتراجعوا"


translate arabic day_1_8038cca1:


    ".عاش الدار حياته الخاصة - الحياة الصعبة للمباني القديمة التي تتذكر الكثير من الأشياء ويبدو أنها تحاول سردها"


translate arabic day_1_5e399ea7:


    "...نظر الدار الوحيد إلى الغابة ، ونظرت الغابة الكثيفة إلى الوراء بعيونها الجوفاء وحفّت، واختطفت واومئت"


translate arabic day_1_aa60d53a:


    ".يمكنك الخروج والوقوف على حافة الغابة ، فقط للتأكد من عدم وجود أحد خلف الأشجار الملتوية"


translate arabic day_1_90e30280:


    ".الصور الظلية الغامضة المتدلية في مهب الريح لن تسبب أي ضرر"


translate arabic day_1_16a51654:


    "...هذه لعبة الضوء والظل"


translate arabic day_1_bf6e8a2c:


    ".لعبة فقط"


translate arabic day_1_2178dae0:


    ".أفهم أن هذا خيالي – أنا في ١٢ من عمري"


translate arabic day_1_c70b8af2:


    "...لكن"


translate arabic day_1_542bfb7b:



    voice "voice/karina/10 K.ogg"
    Mam "!ازلْ الكتاب على الفور"


translate arabic day_1_1917188e:



    voice "voice/karina/01 K.ogg"
    Mam "!كم مرة قلتُ - لا تقرأ عندما تأكل! مضر! تجلس محدوباً"


translate arabic day_1_ecef6b19:


    ".وضعتُ كتابي عن مغامرات كونان البربري بإخلاص"


translate arabic day_1_049be23a:


    ".على أي حال، قرأتُ السطر ٣ مرات و ما فهمتُ شيئًا"


translate arabic day_1_ad386629:


    ".تناولتْ عُلا الإفطار وبدأتْ تتناول البيسكويت. تقرمش بحماسة مثل الفتيات في الإعلانات التجارية"


translate arabic day_1_f55d34d7:



    voice "voice/karina/12 K.ogg"
    Mam "!حتى تنهي طعامك - لن تقوم من على الطاولة"


translate arabic day_1_32a06ef6:


    ".وظللتُ أحدق في عصيدة السميد، كما لو كنت آمل أن تتبدد من تلقاء نفسها"


translate arabic day_1_1dca20e6:


    "...بلبلة القلق المبهم. كل ذلك بسبب الليل الذي لا يمكن النوم فيه، والغابة السوداء التي تنحني حول الفناء، والرياح القاتمة"


translate arabic day_1_4ff45d04:


    ".كلما انتظرتُ أطول، أصبحتْ الكتلة البيضاء أكثر برودة"


translate arabic day_1_13dc53a0:


    ".مثل قنديل البحر من «أوديسة كوستو تحت الماء». أحب هذا العرض"


translate arabic day_1_46a6ba39:


    "يا للعجب اتساءل إذا كان زاحفاً جداً في قاع المحيط؟"


translate arabic day_1_cd9a2bf3:


    "وفي الليل في غابة سوداء باردة؟"


translate arabic day_1_0e38e08b:


    ".أسقطتُ الملعقة من يدي"


translate arabic day_1_a51ad1d3:


    ".حدّقتْ أمي بعيون خضراء باردة"


translate arabic day_1_b7a37e34:



    voice "voice/karina/13 K.ogg"
    Mam "ماذا قلتُ؟"


translate arabic day_1_15415c59:



    voice "voice/anton/1day/001. YA dost.ogg"
    Ant "!سأرفع"


translate arabic day_1_ef449e18:


    ".فترة راحة مدتها عشر ثوان قبل معركة جديدة مع عصيدة سيئة"


translate arabic day_1_bf32bfc2:


    ".وجدتُ الملعقة"


translate arabic day_1_8a5d3dc7:


    "ما هذا الممروش تحت الطاولة؟"


translate arabic day_1_91fabee7:


    ".«كا-ري-نا»"


translate arabic day_1_1246aef5:


    "!هه، هذا اسم أمي"


translate arabic day_1_49e434a0:


    ".يبدو، كانت هي التي خربشت شيئاً حادًا في الطفولة"


translate arabic day_1_c77a868a:


    ".اتضح أنها كانت مشاغبة - لقد أفسدتْ الأثاث"


translate arabic day_1_773ffb59:


    ".أوه، لقد كانت ستوبخني طوال هذا الأسبوع"


translate arabic day_1_e691dcdf:


    "هل أذكرها بالمزحة؟"


translate arabic day_1_cf4072af:


    ".لا. لديها مزاج سيء في آخر هذه الأوقات"


translate arabic day_1_10648b5c:


    ".تخيلتُ كيف كانت جالسة هنا، في سني، تحت الطاولة"


translate arabic day_1_1869fd53:


    "يا للعجب، عندما كانت طفلة، كانت أمي تخاف من الظلام؟"


translate arabic day_1_37aaabdd:


    "و من صوت الحفيف في العلية؟"


translate arabic day_1_2d1a12e6:


    "...و من الغابة الكثيفة؟"


translate arabic day_1_27cefc9e:


    ":تخيلتُ كيف تدخل جدتي إلى غرفة نوم والدتي الصغيرة، وتجلس على حافة سرير الأطفال، حيث تنام عُلا الآن، وتقول بصوت ناعم ومنغم"


translate arabic day_1_3b3613ab:



    voice "voice/grandmother/1. Taiga.ogg"
    Gra ".تايغا مكان خاص، يا طفلة"


translate arabic day_1_5908e3e0:



    voice "voice/grandmother/2. Ona.ogg"
    Gra ".هي تنظر إليكِ عن كثب، تشمّكِ"


translate arabic day_1_b31a8e34:



    voice "voice/grandmother/3. Slovno.ogg"
    Gra ".كما لو أنها تريد أن تفهم أي نوع من الحيوانات أنتِ"


translate arabic day_1_bb0fde72:



    voice "voice/grandmother/4.Ponrav.ogg"
    Gra ".إذا أعجبهاكِ ذلك، فلن تتركك في مأزق"


translate arabic day_1_ee87960c:



    voice "voice/grandmother/5.A bud.ogg"
    Gra ".وإذا فعلتِ مقالب، فسوف تمسككِ وتسحبكِ معها تحت الأرض"


translate arabic day_1_90443588:



    voice "voice/grandmother/6.Tut.ogg"
    Gra ".وهذه هي نهاية الأمر"


translate arabic day_1_820042dd:


    "...كانت الجدة أنيسة، لا تتشاجر مع أي شخص ولا تشتم أحد أبداً"


translate arabic day_1_e4566b49:


    ".ثم لم تكن هناك صرخات جنونية حتى وقت متأخر من الليل، أطباق مكسورة واتهامات متبادلة"


translate arabic day_1_1af8038a:


    ".في ذلك الوقت، كان آباؤنا لا يزالون يحبون بعضهم البعض"


translate arabic day_1_d2786426:


    ".أتذكر أنني سمعت بالصدفة محادثة مع أحد الوالدين وعلمتُ أن جدتي خططتْ لجنازتها مسبقاً"


translate arabic day_1_865042d9:


    ".اشترتْ لنفسها نعشاً"


translate arabic day_1_269223c7:


    ".«وسمّته بمودة «نُعيش"


translate arabic day_1_29405cc9:


    ".وقف في المخزن وكأنه ينتظر بصبر"


translate arabic day_1_6dcae77f:


    ".أسود، مع تنجيد بلون اللحم - رأيتُ هذا لاحقاً، عندما دُفِنتْ جدتي"


translate arabic day_1_a488c41a:


    ".بقي الدار كما كان أيام الجدة. تم إزالة الصور فقط ووضعها في مكان ما"


translate arabic day_1_cc0e326e:


    ".طلقات زجاجية بوجوه رمادية لأسلافي. جميعها لها عيون مسطحة ولكنها حادة البصر"


translate arabic day_1_bd0fdb16:


    ".قمتُ من تحت الطاولة"


translate arabic day_1_4c69f865:


    ".انتهيتْ عُلا من البيسكويت، ومثل حيوان ماكر نظرتْ إلى الجزء الخاص بي"


translate arabic day_1_87228586:


    ".ألقيتُ نظرة خاطفة على النافذة الصقيعة"


translate arabic day_1_74977016:


    ".كانت أشجار الصنوبر مظلمة بالخارج، لكنها لم تلفت انتباهي"


translate arabic day_1_86016b61:


    ".نمط يناير مطوي في صورة"


translate arabic day_1_8d54a51e:



    voice "voice/anton/1day/002. Olja gl.ogg"
    Ant "!انظري يا عُلا، ثعلب"


translate arabic day_1_474007d9:



    voice "voice/olya/02 O.ogg"
    Oly "أين؟"


translate arabic day_1_a442274d:


    ".يبدو وكأنه خدعة بصرية على الغلاف الخلفي للدفتر"


translate arabic day_1_198aeb72:


    "...يبدو وكأنه خليط من الخطوط، ولكن إذا أزلت تركيز عينيك عنه"


translate arabic day_1_00fc2fba:


    "..وانظر من زاوية معينة..."


translate arabic day_1_5383802e:



    voice "voice/anton/1day/003. Da ne.ogg"
    Ant "!لا ليس في الشارع! على الزجاج"


translate arabic day_1_8cce2a1a:



    voice "voice/anton/1day/004. Smotri.ogg"
    Ant "...انظري، هذا أنف. هذا"


translate arabic day_1_92ff20c6:



    voice "voice/karina/14 K.ogg"
    Mam "!بسرعة أكمل طعامك"


translate arabic day_1_0d905758:



    voice "voice/anton/1day/005. Da da.ogg"
    Ant ".نعم، نعم...الآن"


translate arabic day_1_af0ccae6:



    voice "voice/olya/03 O.ogg"
    Oly ".لا أرى أي شيء"


translate arabic day_1_1891cde4:



    voice "voice/karina/15 K.ogg"
    Mam "!بسرعة! لم يبقى الكثير"


translate arabic day_1_f61b94b6:



    voice "voice/olya/04 O.ogg"
    Oly ".آه! هنا... لكنه ما زال لا يبدو كذلك"


translate arabic day_1_87f9a929:



    voice "voice/anton/1day/006.A ja gov.ogg"
    Ant ".أنا أقول يبدو كذلك"


translate arabic day_1_179ecb58:



    voice "voice/olya/05 O.ogg"
    Oly "!لا"


translate arabic day_1_5ce7ea3e:



    voice "voice/anton/1day/007.Pohozhe_.ogg"
    Ant "!يبدو كذلك"


translate arabic day_1_4a419efc:



    voice "voice/karina/16 K.ogg"
    Mam "...توقفا عن ذلك! أي نوع من الأطفال"


translate arabic day_1_80ebae61:


    ".الآن لم أتمكن من العثور على الثعلب أيضاً"


translate arabic day_1_0eef0d0c:


    "هو اختفى"


translate arabic day_1_790e5679:


    ".ذهب"


translate arabic day_1_31c97f8e:


    ".فقط الأشكال زحفتْ عبر الزجاج، تبدو مثل أوراق نبات القراص"


translate arabic day_1_16d1eb3c:


    ".دخل أبي إلى المطبخ، ضخم وغير مستعجل"


translate arabic day_1_87115098:


    "!عندما أكبر، أريد أن أصبح مثله - رجل ملتحٍ"


translate arabic day_1_33820e21:


    ".«قالتْ أمي مازحة، طلبتْ من أبي: «من فضلك، احلق لحيتك إنها توخز"


translate arabic day_1_47a2c0cc:


    "...كان ذلك منذ زمن بعيد"


translate arabic day_1_3cf4a827:


    ".والآن كل يوم وطرق الأبواب والتهكم الانتقامي"


translate arabic day_1_39a76bc6:


    "«أغلقتْ عُلا أذنيها عندما سُمعت أصوات ولداينا خلف الحائط: «لماذا كل هذا؟"


translate arabic day_1_e633ef90:


    "«!من أجلكم! - أجاب الأب، - من أجل العائلة»"


translate arabic day_1_de00e241:


    ".«سمعتُ كل صوت وكنت خائفًا من سماع أفظع كلمة وأكثرها فتكاً بالحرف «ط"


translate arabic day_1_10acd95c:


    "...ط-ل-ا"


translate arabic day_1_6eb7bf83:


    ".لا أريد حتى الإستمرار"


translate arabic day_1_b4ef24d7:


    ".أخشى أن أتخيل أنني وأختي الصغيرة سوف نفصل ونذهب لعائلات مختلفة"


translate arabic day_1_5dded2d3:



    voice "voice/olya/06 O.ogg"
    Oly "!ماذا عن الثعلب الخاص بك. ها هي بومة على نافذتي"


translate arabic day_1_fcbb62ca:



    voice "voice/father/01 F.ogg"
    Pap "!مرة أخرى أنتِ مع بومتكِ"


translate arabic day_1_a7849877:



    voice "voice/olya/07 O.ogg"
    Oly "!البارحة صدّقتني"


translate arabic day_1_6524aa0c:



    voice "voice/father/02 F.ogg"
    Pap "هل رأى أحد مفاتيح السيارة؟"


translate arabic day_1_c0028c88:



    voice "voice/father/03 F.ogg"
    Pap "...أعتقد أنك تركته على حافة النافذة"


translate arabic day_1_287dcf3f:



    voice "voice/karina/17 K.ogg"
    Mam "...ربما"


translate arabic day_1_0eb3714b:



    voice "voice/karina/18 K.ogg"
    Mam ".ربما تركتها وربما لا"


translate arabic day_1_809f00ce:



    voice "voice/karina/19 K.ogg"
    Mam "...ربما شخص كبير، أب لطفلين وربما"


translate arabic day_1_bf2f4834:



    voice "voice/father/04 F.ogg"
    Pap ".توقفي من فضلك، يا كارينا"


translate arabic day_1_7ec9c1e3:



    voice "voice/father/06 F.ogg"
    Pap ".اسمحي لي أن أبحث بهدوء"


translate arabic day_1_22967032:



    voice "voice/karina/20 K.ogg"
    Mam ".مفاتيحك في السلة بجانب الهاتف"


translate arabic day_1_9770212d:



    voice "voice/father/07 F.ogg"
    Pap ".شكراً جزيلاً لك"


translate arabic day_1_304afd1a:



    voice "voice/father/08 F.ogg"
    Pap "...يا أنطون، كل بسرعة فأنتَ تجلس كالشهيد"


translate arabic day_1_4b23c8f4:



    voice "voice/olya/07A O.ogg"
    Oly "...و البومة"


translate arabic day_1_51362280:



    voice "voice/father/09 F.ogg"
    Pap ".لم تكن هناك بومة"


translate arabic day_1_d2c87411:



    voice "voice/olya/08 O.ogg"
    Oly "!كانت"


translate arabic day_1_e2f790bc:



    voice "voice/olya/09 O.ogg"
    Oly ".عيون ضخمة - هنا! وهم يلمعون"


translate arabic day_1_14d21c04:


    ".قفزتْ عُلا من كرسيها ووضعتْ يديها على وجهها، وأظهرت عينيها بأصابعها، كل منها بحجم تفاحة"


translate arabic day_1_6eb8c072:



    voice "voice/father/10 F.ogg"
    Pap "في الخزانة، الآن - البومة؟ {u}باباي{/u}-في العام الماضي"


translate arabic day_1_6464d345:



    voice "voice/olya/10 O.ogg"
    Oly "...حسناً رأيتُ"


translate arabic day_1_e92a1260:


    ".بدأتْ تنظر عُلا من والدنا إلى والدتنا، ثم إليّ، لكنها لم تجد الدعم في أي مكان"


translate arabic day_1_7af699de:



    voice "voice/father/11 F.ogg"
    Pap "ألم تفكرين في مصادقتها؟"


translate arabic day_1_36cbc74b:



    voice "voice/father/12 F.ogg"
    Pap "لإطعام الفئران الخيالية، على سبيل المثال؟"


translate arabic day_1_c8ff2149:



    voice "voice/karina/21 K.ogg"
    Mam ".لا تضايق الطفلة"


translate arabic day_1_b8d53edb:



    voice "voice/karina/22 K.ogg"
    Mam ".إنها صغيرة جداً وتخشى النوم بمفردها"


translate arabic day_1_6b146687:


    ".عُلا أمالتْ شفتيها إلى الأمام وركضتْ بسرعة في الممر"


translate arabic day_1_ae748248:


    ".صعدتْ على السلالم إلى الطابق الثاني"


translate arabic day_1_f3f50af6:


    ".نظرتْ أمي بصرامة إلى أبينا"


translate arabic day_1_11726d81:


    ".أوه، ما هذه النظرة! كم هذا غير مريح مثل نظرة في بندقية"


translate arabic day_1_4663e8a5:



    voice "voice/father/13 F.ogg"
    ".أبي لم يهتم وغادر، جلجل مع مجموعة من المفاتيح التي تم العثور عليها"


translate arabic day_1_80d7f865:


    ".«بعد دقيقة في كل الدار سُمِع لحن من «حورية البحر"


translate arabic day_1_97870c02:


    ".لقد كان شريط كاسيت تم مسح الثقوب منه، والذي كان أبي قد لصقه مرة واحدة بالفعل"


translate arabic day_1_d559e945:


    ".كل شيء ممكن مع الأشياء - يمكن إصلاحها أو لصقها معاً"


translate arabic day_1_4011f099:


    "ولكن كيف مع العلاقات؟"


translate arabic day_1_5587ffc5:


    ".ذهبتْ أمي إلى غرفة المعيشة، وبقيتُ وحدي، وأنا أنظر بقلق من النافذة"


translate arabic day_1_672acd0f:


    ".منذ أن انتقلنا إلى هذا الدار القديم، لم تنم عُلا جيداً"


translate arabic day_1_85ad1048:


    ".التقلب في السرير أو التجمع في كرة تحت الأغطية"


translate arabic day_1_571301fe:


    ".أحياناً كانتْ تستيقظ في منتصف الليل لتشغيل آلة تسجيل الفيديو"


translate arabic day_1_8a1a06e5:


    "...ساعدت الرسوم الكرتونية في صرف الانتباه عن هموم الإنتقال، ومشاكل الآباء"


translate arabic day_1_7458f375:


    ".ثم رأت عُلا هذا الوحش المجنح الضخم خارج النافذة"


translate arabic day_1_d22fee20:


    ".أصبحتْ مهووسة بالبومة"


translate arabic day_1_49aa86c2:


    ".مهما فعل الوالدان ومهما كانتْ الحيل التي لجؤوا إليها للقضاء على مخاوفها"


translate arabic day_1_2ddd8b43:


    ".لكن عُلا رفضتْ تماماً أن تنام بمفردها ولم تصدق أن البومة كانت مجرد حلم سيئ"


translate arabic day_1_197c0df2:


    "...بعد الليلة لم أعرف كيف أفكر وكيف أتعامل مع كلام أختي الآن"


translate arabic day_1_6bc5d126:


    "هل يمكن أن تكون الكوابيس معدية؟"


translate arabic day_1_bc5006c8:


    ".في الليلة الماضية استلقيتُ متيقظاً وفكرتُ في ما ينتظرني في المدرسة الجديدة"


translate arabic day_1_6928e078:


    ".بقيت أيام قليلة للحصص"


translate arabic day_1_3c09329b:


    ".في خيالي ممرات طويلة ومتعرجة. قادوا إلى فصل مليء بالأطفال"


translate arabic day_1_81fcfa91:


    "لكن التلاميذ في مكاتبهم كانوا صوراً ظلية داكنة، كما لو كانت مخططة"


translate arabic day_1_141d2d84:


    ".فجوات مستديرة في منتصف وجوههم السوداء، وأعينهم تغمض في الثقوب، كما لو كانت مخلوقات مختلفة تماماً تنظر إلي من خلف أشكال سوداء مسطحة"


translate arabic day_1_21392046:


    ".وكان هناك الكثير من القسوة في هذه النظرات، الكثير من السخرية الجليدية لدرجة أنني أرتجف من رأسي إلى قدم"


translate arabic day_1_07c9f84b:


    "هل سأنجو هنا؟"


translate arabic day_1_b90fa977:


    "...هل ستضربني أقدامهم و دعساتهم السريعة حتى الموت، بأحذيتهم الملطخة بالدماء"


translate arabic day_1_68fcaad4:


    ".دعها تحترق، هذه المدرسة اللعينة"


translate arabic day_1_8ecd919a:


    ".فاليحدث شيء ما - أي شيء. فقط أن لا أذهب إلى الدروس"


translate arabic day_1_e383dbdb:


    ".إن عدم رؤية الأشخاص الذين فقط يحلمون بتوجيه صفعة على الوجه، أو تعثر الأخرين، أو الخروج بلقب آخر هو أكثر هجوماً من الاسم السابق"


translate arabic day_1_04844920:


    ".كأن نظارتي تجعلني غريباً كنوع من الوحوش"


translate arabic day_1_afc290bd:


    ".اجتاحتْ أنظاري الرسومات المعلقة على الجدران"


translate arabic day_1_1b62448e:


    ".لم أعتبر نفسي فنان عظيم لكن عُلا توسلتْ إلي أن أعلقها. الرسم فقط جعلني سعيداً على الأقل مؤخراً"


translate arabic day_1_9dada16d:


    ".أعجب القليل من أصدقائي أيضاً كيف أرسم. بالمناسبة، وعدوا بالاتصال"


translate arabic day_1_ec326b41:


    ".«أحيانًا أتخيل والدتي ترد على الهاتف وتقول ببرود:«لقد وصلت إلى المكان الخطأ"


translate arabic day_1_ed139515:


    ".«أو:«أنطون غير موجود"


translate arabic day_1_8644347e:


    "...أنطون غير موجود"


translate arabic day_1_83e03124:


    ".خيلتُ زملائي المستقبليين وزميلاتي في الفصل الذين، مثلي، كانوا مستلقين في تلك اللحظة على الأسرة، يستمعون إلى عواء المستذئبين غير المرئيين خارج النافذة"


translate arabic day_1_40b4b08e:


    "ربما سيحبني الفصل الجديد بعد كل شيء؟"


translate arabic day_1_ba48469e:


    "على أي حال، من يحب الأشخاص في النظارات السميكة؟"


translate arabic day_1_747ea1fd:


    ".اعتاد أبي على ارتداء النظارات عندما كان طفلاً. وهو الآن متزوج بأجمل امرأة في العالم - أمي"


translate arabic day_1_5bd3fb31:


    ".صرير البيت بسبب الريح"


translate arabic day_1_141aac91:


    ".منزلنا القديم - الخرساني، المكون من تسعة طوابق - كان أحد الجيران يصدر أصواتاً مزعجة، ويتمتم التلفزيون خلف الحائط، ويبكي بشدة بسبب شقة فيها عائلة كبيرة"


translate arabic day_1_defcec41:


    ".المنزل الحالي - اللغة لا تجرؤ على تسميته - كان مختلفاً تماماً"


translate arabic day_1_169cf186:


    ".اليوم هادئ وسهل الانقياد - الظلال تبقى في الزوايا، في شبكة العنكبوت في المخزن، تحت السلم"


translate arabic day_1_c01038f8:


    ".لكن في الليل الظلال تستيقظون"


translate arabic day_1_7ae5a028:


    ".شيء ما ينظر إلي من الزوايا. كان الأمر أشبه بصور أقارب ميتين بعيون ترابية تم تعليقها مرة أخرى على الحائط بدلاً من رسوماتي"


translate arabic day_1_e0c57661:


    ".تتأوه ألواح الأرضية، وتتأوه المزاريب الصدئة، وتعيش الرياح صدى في العلية"


translate arabic day_1_26e041e3:


    ".يبدو الأمر كما لو أن المنزل يعزف بعض اللحن الشيطاني"


translate arabic day_1_acb4f43a:


    ".وفجأة أدركتُ أنني أسمع الموسيقى حقاً، علاوة على أنها كانت تعزف منذ فترة طويلة"


translate arabic day_1_3949419b:


    ".في مكان ما بعيداً، على حدود الإدراك، كان الفلوت يغني"


translate arabic day_1_762028d4:


    ".بدا وكأنه يندمج مع عواء الريح، مع صرير البيت القديم بأفكاري أخيراً"


translate arabic day_1_07780ca0:


    ".نهضتُ وهرعتُ إلى النافذة. أردتُ أن أقنع نفسي أنه لا توجد موسيقى، وأن هذا مجرد خيالي"


translate arabic day_1_f7379f7e:


    ".وأن لا أحد يستطيع اللعب هناك في الليل الثلجي البارد"


translate arabic day_1_8d630b51:


    ".هناك، في الحقل، كان شخص ما يرقص"


translate arabic day_1_25410744:


    ".شخصيات سوداء، بالكاد يمكن تمييزها على خلفية الغابة المظلمة"


translate arabic day_1_ea203a10:


    ".غمرها ضوء القمر، قفزوا فجأة وسقطوا على الجليد، وتدحرجوا في الثلج وزحفوا على أربع"


translate arabic day_1_94c11744:


    ".تذكرتُ قصصاً عن ذئاب تلعب في ضوء القمر. لكنهم لم يكونوا ذئاب"


translate arabic day_1_ab047971:


    ".وقفوا على أقدامهم، ورقصوا في دائرة ، ورفعوا زوابع من الثلج، تذوب في الظلام وتعاود الظهور"


translate arabic day_1_0d0c618a:


    ".شيء غريب كان يحدث"


translate arabic day_1_6e076886:


    ".أشعلتْ رقصة الظلال في الظلام الخالي من النجوم الخيالي وفي نفس الوقت دق ناقوس الخطر"


translate arabic day_1_6a467bdf:


    ".فجأة توقفت الموسيقى"


translate arabic day_1_fa7e0cdc:


    ".تجمد الراقصون - ويمكنني أن أقسم - حدّقتْ في وجهي"


translate arabic day_1_61dffb2a:


    ".فجأة، انفصل أحد الشخصيات عن كرنفال الظلال الغريب واندفع عبر الميدان، ليغطي المسافة بقفزات قوية"


translate arabic day_1_2797e83e:


    ".انزلق، ولم يترك أي خدوش على القشرة المقرمشة، حتى ابتلع ظل الفحم بالمنزل مخلوق الليل، وأصبح أكثر سمكاً وسواداً"


translate arabic day_1_c1a2d327:


    ".بدأ القلب يرفرف مثل طائر في قفص"


translate arabic day_1_a868d9b7:


    ".عدتُ إلى السرير، وكان لدي وقت لإغلاق الستائر"


translate arabic day_1_7625866f:


    "!لقد رأوني"


translate arabic day_1_0246c682:


    ".اجتاحني الخوف في تيار جليدي"


translate arabic day_1_14bcd939:


    ".عندما كنتُ أقف في غرفة مظلمة، سمعت الضيف غير المدعو يعبث ويخدش في الخارج، بينما كان يركض حول الفناء، باحثاً عن مدخل"


translate arabic day_1_4509a8ca:


    ".ذهب الصوت إلى اليمين"


translate arabic day_1_3310c21d:


    "...ذهب في جميع أنحاء المنزل"


translate arabic day_1_41a1b6dc:


    "...الآن الضيف سيكون على عتبة الباب"


translate arabic day_1_6df985dc:


    ".ألقيت بنفسي في السرير وغطيتُ نفسي برأسي، كما لو أن البطانية يمكن أن تحميني"


translate arabic day_1_ea4128e1:


    ".سيطر الخوف على عضلاتي"


translate arabic day_1_24bd9c77:


    ".فجأة تذكرتُ الجنازة مرة أخرى: كيف استلقيت جدتي وذراعيها متصالبتين، مع ملامح وجه حادة، مثل دمية من الشمع"


translate arabic day_1_756c5d6b:


    ".وعلى أرجل الكراسي التي نصب عليها التابوت ، كان النمل يزحف"


translate arabic day_1_18941d23:


    ".تخيلتُ حينها أنهم سيصعدون على رأس الجدة ويرفعون جفونها بمخالبهم"


translate arabic day_1_7a007ad5:


    ".ثم تتحرك مقل العيون المجعدة في الأعشاش ، وترى الجدة أحفادها مرة أخرى"


translate arabic day_1_e7aceb88:


    ".هناك، في الجنازة، كررتُ في نفسي كلمات الرقية التي علمتها لي"


translate arabic day_1_12eab4e3:


    ":وأنا مستلقية تحت الأغطية، مستمعة إلى الصرير والعواء، همست بهذه الكلمات"


translate arabic day_1_c3eda6ce:



    voice "voice/anton/1day/008. Na ost.ogg"
    Ant ".في جزيرة بويان، في المحيط الأزرق، يوجد بيت، فيها - لحم الخنزير المقدد والطين، والشعر الرمادي - طعام الشيطان، وخادم الله أنطون لم يمس أبداً"


translate arabic day_1_6c3fdf64:



    voice "voice/anton/1day/008_1. Besy.ogg"
    Ant ".سوف تنسى شياطين طريق إلى الدار"


translate arabic day_1_c78f2b62:



    voice "voice/anton/1day/008_2. Mertvoe.ogg"
    Ant ".الموتى إلى الاموتى، الاحياء إلى الاحياء"


translate arabic day_1_4ce47add:


    ".هدأتْ الضوضاء غير المفهومة"


translate arabic day_1_11cc5217:


    ".انحنيتُ بعناية من تحت البطانية لأرى الستارة تتأرجح مثل حبل المشنقة تحت السقف"


translate arabic day_1_266ee386:


    ".ثم أذهلتني الليلة بجزء جديد من الرعب الغاضب"


translate arabic day_1_2cff97ee:


    ".مزق الصوت أذني"


translate arabic day_1_500a668e:


    ".كان هناك شيء ما يخدش الباب الأمامي. سرعان ما كشط القماش بالمخالب مطالبين بالسماح له بالدخول"


translate arabic day_1_50cf24ed:


    ".الباب مغلق"


translate arabic day_1_4c1ba04b:


    ".أصبح أبي حذراً وقام بربط قفل آمن"


translate arabic day_1_dd0b9599:


    ".أتذكر كيف حدق في الغابة لفترة طويلة ومتوترة، كما لو كان يبحث عن شخص ما فيها"


translate arabic day_1_22bda1bd:



    voice "voice/anton/1day/008_3. Mertvoe.ogg"
    Ant "!الموتى إلى الاموتى"


translate arabic day_1_5844355a:



    voice "voice/anton/1day/008_4. Zhivoe.ogg"
    Ant "!الاحياء إلى الاحياء"


translate arabic day_1_6554af73:


    ".سحبتُ ركبتيّ، ودفنت ذقني فيها، وحدقت في الباب الداخلي، واهياً وضعيفاً جداً أمام قوة الظلام"


translate arabic day_1_ba2c9e1b:


    "...وفجأة"


translate arabic day_1_62236cdd:


    ".استدار مقبض الباب بخجل"


translate arabic day_1_ea73f171:


    ".ثم قفز مرة، مرتين. كما لو أن من حاول فتح الباب لم يكن بيده"


translate arabic day_1_c6961b2a:


    "...تحرك مقبض الباب مرة أخرى وفجأة"


translate arabic day_1_af2f69a2:


    "...تحرك بجنون"


translate arabic day_1_7d47cd2b:


    ".كان فكي ممسكاً بالخوف. تبلل الأصابع على البطانية"


translate arabic day_1_0d26a094:


    ".صرّ الباب وانفتح"


translate arabic day_1_4aa0ba35:


    ".سخر المنزل وأصبح ريحاً في مزاريب القصدير"


translate arabic day_1_198f008e:


    "...الآن"


translate arabic day_1_2eec08d2:


    "...الآن سترى"


translate arabic day_1_cc845f1e:


    ".الباب انفتح"


translate arabic day_1_cd08da67:


    ".ساد الظلام في الفم النهم للإفتتاح "


translate arabic day_1_a382b04d:



    voice "voice/olya/11A O.ogg"
    Noname "...طو-و-و"


translate arabic day_1_f0244434:



    voice "voice/olya/11B O.ogg"
    Noname "...شا-ا-ا..."


translate arabic day_1_fe543ef5:


    ".كما لو أن الليلة نفسها كانت تخاطبني، الآن ترفرف أجنحة سوداء، صريرها مع حلقات غير مشحمة الآن"


translate arabic day_1_73a4d8e2:


    ".كان الظلام عبارة عن نسيج عنكبوت يتشبث بزوايا الغرفة، ارتجفتُ في شرنقتها وانتظرت خروج الشخص الذي نسج النسيج من الثقب الأسود"


translate arabic day_1_ea17fb6d:



    voice "voice/olya/12A O.ogg"
    Noname "...طو-و-و"


translate arabic day_1_ecc55456:



    voice "voice/olya/12B O.ogg"
    Noname "...شا-ا-ا"


translate arabic day_1_bd0134af:


    ".آلام عضلات البطن، وتقويم القفص الصدري، وعلى استعداد لإطلاق صرخة يائسة"


translate arabic day_1_6f7866a6:


    ":ولكن قبل الصراخ سأل الظلام"


translate arabic day_1_fedb0a85:



    voice "voice/olya/13 O.ogg"
    Noname "هل تنام يا طوشا؟"


translate arabic day_1_c8867b56:


    ".ظهر وجه أختي الشاحب من الظل الكثيف"


translate arabic day_1_3798af37:


    ".كنتُ على وشك الصراخ بارتياح"


translate arabic day_1_fdab305d:



    voice "voice/anton/1day/011. Olja_ja_.ogg"
    Ant "عُلا؟ أنا... أنا لا أنام. ماذا حدث؟"


translate arabic day_1_7b90b5a9:


    ".تجعد أنف عُلا، وبرزت شفتها السفلى - وهي علامة أكيدة على أن أختي ستبكي من ثانية إلى ثانية"


translate arabic day_1_b049dee2:



    voice "voice/olya/14 O.ogg"
    Oly "...هي مرة أخرى طارت وتحدق بي"


translate arabic day_1_cc88885f:



    voice "voice/olya/15 O.ogg"
    Oly ".اِطردها يا طوشا! اِطردها، من فضلك"


translate arabic day_1_6877f76f:



    voice "voice/olya/16 O.ogg"
    Oly "!أخاف جداً"


translate arabic day_1_13b9a051:


    ".الخوف الذي عذبني، قد زحف بعيداً ولكن ظل كامناً في مكان ما في بطني. كان علي أن أهدأ عُلا"


translate arabic day_1_fa94b44e:



    voice "voice/anton/1day/012. Eto by.ogg"
    Ant ".لقد كان حلماً يا سخيفة، لا تخفي - الأحلام لا تلدغ. لن يسيء إليكِ أحد"


translate arabic day_1_76d26d0d:


    ".شهقتْ عُلا"


translate arabic day_1_4134a3aa:


    ".هي حاولتْ جاهدة أن تصدّقني"


translate arabic day_1_8114df3e:


    "لكن هل صدّقتُ نفسي؟"


translate arabic day_1_fea185d7:



    voice "voice/anton/1day/013. U menja.ogg"
    Ant "!عندي فكرة"


translate arabic day_1_2533b8e8:



    voice "voice/anton/1day/013. A poidem.ogg"
    Ant "فلنذهب إلى غرفتكِ، سنرى برامج أطفال.«الجميلة النائمة» على سبيل المثال"


translate arabic day_1_3b5e6552:



    voice "voice/anton/1day/014. Tebe zh.ogg"
    Ant "هل تعجبك هذه الرسوم المتحركة؟"


translate arabic day_1_bd088881:



    voice "voice/olya/17 O.ogg"
    Oly "لماذا الجميلة النائمة لديها أمير وأنا لدي هذا الطائر المخيف؟"


translate arabic day_1_7af48afd:


    "فاجأني السؤال"


translate arabic day_1_d099e5ff:



    voice "voice/anton/1day/014. Ladno.ogg"
    Ant "«حسناً، لنشاهد «سندريلا"


translate arabic day_1_ee4a55c7:


    ".كانت الأفكار مشوشة وغير واضحة"


translate arabic day_1_ca0f304f:


    "ماذا كان هذا؟"


translate arabic day_1_d8cac51c:


    "ما الذي كان ينظر عني ويرقص بحرارة تحت القمر؟"


translate arabic day_1_3162da32:


    ".الظلمة ضغطتْ على زجاج النافذة، ولا يمكن خداعها برقية الجدة العجوزة"


translate arabic day_1_710ab669:


    ".لا يمكنك الغش بتقديم صندوق من لحم الخنزير المقدد والطين بدلاً من نفسك، مع ضفائر رمادية مقصوصة"


translate arabic day_1_8ff5b362:



    voice "voice/olya/18 O.ogg"
    Oly "أنت ذاهب يا طوشا؟"


translate arabic day_1_05f02274:



    voice "voice/anton/1day/015. Da da.ogg"
    Ant ".نعم، نعم. الآن"


translate arabic day_1_a0ae02f4:


    ".هذا هو السبب في أنني لم أرغب في الضحك في الصباح على عُلا وبومتها على الإطلاق"


translate arabic day_1_84606448:


    "من كان من الممكن أن يأتي إلينا في هذه البرية؟"


translate arabic day_1_318bb3b3:


    ".لا نعرف أحداً هنا"


translate arabic day_1_410e2739:


    ".عنيدون"


translate arabic day_1_85e2dc02:


    ".إن التفكير السخيف بأن ضيوف الصباح قد جاءوا مباشرة من الغابة أصبح أمراً غير مريح خاصة"


translate arabic day_1_293b775a:


    ".في الردهة صدرتْ أصوات غير مفهومة"


translate arabic day_1_8d89e157:


    ".أردتُ أن أختبأ"


translate arabic day_1_beb39457:


    "...في الخزانة"


translate arabic day_1_a13f5600:


    "...تحت الطاولة"


translate arabic day_1_ef348d12:


    ".خلف الستارة حيث تحب عُلا الاختباء"


translate arabic day_1_c9d749f9:



    voice "voice/karina/24 Tosha.ogg"
    Mam "!يا طوشا! تعال إلى هنا"


translate arabic day_1_c91fce2e:


    ".كانوا مقيدين بأقدامي مثل الأثقال. مشيت في الممر"


translate arabic day_1_de036176:


    ".وقف رجالان من الشرطة على العتبة"


translate arabic day_1_b1f68214:


    ".كانت تفوح منهما رائحة الصقيع والقلق"


translate arabic day_1_91fde7d8:


    "«عادة عندما أمي ترى سيارات بأضواء ساطعة، تكون متجهمة ومتذمرة بقولها:«أسوأ من قطاع الطرق"


translate arabic day_1_c4180775:


    ".لكنها بدتْ الآن مرتبكة بعض الشيء"


translate arabic day_1_1e497a6a:



    voice "voice/anton/1day/017. Zdravs.ogg"
    Ant ".مرحباً"


translate arabic day_1_733e57bb:


    ".أومأ الكبير برأسه متجهماً"


translate arabic day_1_87e0de14:



    voice "voice/karina/23 K.ogg"
    Mam ".هنا ضاع الصبي أمس. اسمه فوفا"


translate arabic day_1_fc012aae:



    voice "voice/karina/24 K.ogg"
    Mam "انظرْ، من فضلك. هل رأيته؟"


translate arabic day_1_bebdfe5f:


    ".الشرطي أعطاني صورة"


translate arabic day_1_4ee6bd1c:


    ".تم تصوير صبي ذو شعر أحمر يبلغ من العمر حوالي ثماني سنوات على خلفية سجادة. يحمل قطة بين ذراعيه و ذو ابتسامة عريضة"


translate arabic day_1_3032c67b:



    voice "voice/anton/1day/018. Net.ogg"
    Ant ".لا"


translate arabic day_1_f7d81a5b:



    voice "voice/tihonov/1day/01 T.ogg"
    Mil ".بالضبط؟ ألق نظرة فاحصة"


translate arabic day_1_359190b6:



    voice "voice/anton/1day/019. Gde mn.ogg"
    Ant ".أين يمكنني رؤيته؟ لا أعرف أحداً هنا، وقليلاً ما أخرج من المنزل"


translate arabic day_1_6440689f:



    voice "voice/tihonov/1day/02 T.ogg"
    Mil "ربما رأيته من النافذة؟"


translate arabic day_1_43153eb1:



    voice "voice/karina/25 K.ogg"
    Mam ".نعم! لديك النوافذ تطل على الغابة"


translate arabic day_1_17e16a96:


    "...من النافذة"


translate arabic day_1_6f70514d:



    voice "voice/anton/1day/020. Net. N.ogg"
    Ant ".لا. ما رأيت"


translate arabic day_1_2dbc76b6:



    voice "voice/tihonov/1day/03 T.ogg"
    Mil "مفهوم"


translate arabic day_1_2c04b420:


    "...كان صوته متعباً ولكن نظرته"


translate arabic day_1_e107dfe7:


    ".طويلة وثقيلة بشكل لا يطاق. نظر إلي كما لو كان يشتبه في شيء ما"


translate arabic day_1_73d9fb46:


    ".سقط ظله عليّ، وانغمست مجبراً تحت وطأة الذنب الغامض"


translate arabic day_1_04b21416:


    ".أخيراً قام الشرطي برفع عينيه بعيداً عني، وتفحص لفترة وجيزة المدخل والسلالم والشقوق في السقف، والتي ما زلت لم ألاحظها حتى الآن لسبب ما"


translate arabic day_1_581c1816:



    voice "voice/tihonov/1day/04 T.ogg"
    Mil "بالمناسبة كيف حالكم في هذا المكان الجديد؟ هل اعتدتيتم عليه؟"


translate arabic day_1_45a0c3e5:



    voice "voice/karina/26 K.ogg"
    Mam ".شيئاً فشيئاً. ابنتي الصغيرة فقط هي التي تفتقد المدينة"


translate arabic day_1_b3ef5e8f:



    voice "voice/tihonov/1day/05 T.ogg"
    Mil "إنها تشعر بالملل، إذن... لا أحد من السكان المحليين يزعجكم؟"


translate arabic day_1_c6d49db5:



    voice "voice/karina/27 K.ogg"
    Mam ".جيد، شكراً"


translate arabic day_1_4d376e2d:


    ".كانت عيون الشرطي الرمادية تحدق بي مرة أخرى، مما جعل رأسي يدور"


translate arabic day_1_f1fe920b:



    voice "voice/anton/1day/021.Mozhet.ogg"
    Ant "ربما يمكنني مساعدتك بطريقة ما؟"


translate arabic day_1_320bee7e:


    ".سألتُ دون شك، لكي أظهر نفسي كصبي حسن الأخلاق وأن أنهي محادثة مزعجة في أسرع وقت ممكن"


translate arabic day_1_f2e9828d:



    voice "voice/tihonov/1day/08 T.ogg"
    Mil "...أنا أقف هناك وأفكر"


translate arabic day_1_6d8ee17a:



    voice "voice/tihonov/1day/09 T.ogg"
    Mil ".أنتَ يا فتى تبدو مثل ابن أخي"


translate arabic day_1_09dd643a:



    voice "voice/tihonov/1day/10 T.ogg"
    Mil ".طفل نشيط وبعمرك وبنفس النظارات. كان يقرأ الكثير من كتب المحققين"


translate arabic day_1_5d6665c6:



    voice "voice/tihonov/1day/11 T.ogg"
    Mil ".عندما جاء للزيارة في الصيف، قال إنه يحلم بالذهاب إلى مدرسة الشرطة"


translate arabic day_1_33045d65:



    voice "voice/tihonov/1day/12 T.ogg"
    Mil "أراد أن يساعد الناس، كما تعلم؟"


translate arabic day_1_60224ccc:


    ".أنا غير مرتاح. كما لو لم يكن أمامي ضابط شرطة المنطقة، بل شخص من الأقرباء البعيدين"


translate arabic day_1_1bc011a0:



    voice "voice/tihonov/1day/13 T.ogg"
    Mil "...يا أطفال"


translate arabic day_1_ccbfba0f:



    voice "voice/tihonov/1day/14 T.ogg"
    Mil ".اِجلسوا في بيتكم أفضل لكم، ولا تتشاركون في أي شيء. تغيرت الحياة تماما الآن"


translate arabic day_1_42da6324:


    ":كان صوت أمي بارد"


translate arabic day_1_326666f8:



    voice "voice/karina/28 K.ogg"
    Mam ".أنا أعرف"


translate arabic day_1_502bd457:



    voice "voice/tihonov/1day/16 T.ogg"
    Mil "...على أي حال"


translate arabic day_1_4e126390:



    voice "voice/tihonov/1day/17 T.ogg"
    Mil "في أي صف تدرس يا أنطون؟"


translate arabic day_1_b2ba102c:



    voice "voice/anton/1day/022.V shesto.ogg"
    Ant ".في السادس"


translate arabic day_1_ee4921af:



    voice "voice/tihonov/1day/18 T.ogg"
    Mil "هل كونت صداقات في مكانك الجديد حتى الآن؟"


translate arabic day_1_b429a198:



    voice "voice/anton/1day/023. Poka n.ogg"
    Ant ".ليس بعد. سأذهب إلى المدرسة فقط بعد الإجازة"


translate arabic day_1_272cb7d6:



    voice "voice/tihonov/1day/20 T.ogg"
    Mil ".ها هو رقم هاتفي ربما تحتاجونه. اتصلوا إذا... إذا اكتشفتم شيئاً ما"


translate arabic day_1_40c3f83a:


    ".غادر رجالا الشرطة، وأخذا معهما الظلال ورائحة الكولونيا الرخيصة وصورة الطفل المبتسم"


translate arabic day_1_2ce6413c:


    ".لكن وجهه كان لا يزال أمام عيناي"


translate arabic day_1_c41eb049:


    ".فكرتُ كيف يشعر هناك الآن وحده"


translate arabic day_1_d9b96c6f:


    "هناك» - لسبب ما تخيلت غابة تتمايل في مهب الريح»"


translate arabic day_1_d3c147ff:


    "كيف حال والديه البؤساء؟"


translate arabic day_1_8c743147:


    "وماذا سيفعلان والدي لو اختفيتُ؟"


translate arabic day_1_fbc41078:


    "سوف يبكيان؟ بشكل هستيري؟"


translate arabic day_1_1be3917e:


    ".أو سيلومان بعضهما البعض، كالعادة، وسوف ينسياني تماماً في النهاية"


translate arabic day_1_40086b36:



    voice "voice/anton/1day/024. Mam a.ogg"
    Ant "يا أمي، هل ضاع فوفا في غابتنا؟"


translate arabic day_1_7acaef10:



    voice "voice/karina/29 K.ogg"
    Mam "على الأغلب ذلك. طفل مسكين"


translate arabic day_1_d0f83308:


    ".نظرتُ من النافذة إلى الطريق"


translate arabic day_1_43b52794:


    ".الشرطة إلى القرية {u}أُوُاَزْ{/u} توجهت"


translate arabic day_1_75cd779e:


    ".أثناء تقشير طلاء عتبة النافذة، فكرتُ لسبب ما في ابن أخ شرطي المنطقة"


translate arabic day_1_b1f7188d:


    ".والتي كنت قد قرأتها بنفسي خلال الصيف ،{u}«القط الأسود»{/u} تذكرتُ على الفور قصص الأطفال البوليسية من السلسلة "


translate arabic day_1_0dbe5210:


    ".في هذه الكتب بحث تلاميذ المدارس العاديون في حالات غامضة مختلفة"


translate arabic day_1_70f4872d:


    ".كانوا يبحثون عن أدلة ويتجسسوا على كل أنواع الأشخاص المشبوهين"


translate arabic day_1_abf2d1a4:


    ".وبعد مغامرات مثيرة - فجأة! - حلّت قضية معقدة"


translate arabic day_1_b17f3f77:


    ".أصبحوا من المشاهير المحليين ومن الممكن أن يكون الآباء فخورين بهم بشدة"


translate arabic day_1_f861ad43:


    ".لقد لاحظتُ سلسلة من آثار الأقدام التي خلفتها الشرطة إلى الغابة"


translate arabic day_1_d49104d4:


    ":وبعد ذلك خطرت لي فكرة"


translate arabic day_1_5565d67c:


    "لماذا لا تبدأ التحقيق الخاص بك؟"


translate arabic day_1_cafad11f:


    "ربما سأجد الصبي المفقود؟"


translate arabic day_1_7cbc52fc:


    "!سوف يعطوني مكافأة! سوف تكون عُلا مسرورة"


translate arabic day_1_c8aeee5a:


    "...وليس عُلا فقط. أمي وأبي"


translate arabic day_1_ffa3a478:


    "ماذا لو نسوا مناوشاتهما لبعض الوقت؟"


translate arabic day_1_f45d6e25:


    "ربما يمكنني حتى إنقاذنا من كلمة تبدأ بالحرف «ط»؟"


translate arabic day_1_bff95473:


    "...عندما أرتدي ملابسي، تخيلت كيف سأشتري لعُلا «تماغوتشي»، ولنفسي - لاعب والعديد والعديد من أشرطة الكاسيت"


translate arabic day_1_ddc6872b:


    ".وعلبة كاملة من مفاجآت كيندر"


translate arabic day_1_79f6d42d:


    "متى كانت آخر مرة اشترى فيها والدينا ألعاباً لنا؟"


translate arabic day_1_8f10d079:


    ".في الخريف على ما يبدو. ثم فقد أبي وظيفته - التي كانت تُغنى عنها في الأغنية المهووسة"


translate arabic day_1_32a58535:


    ".كانت لدي فكرة غامضة عما يفعله المحاسبون. يعدّون المال على الأغلب"


translate arabic day_1_81d449a3:


    ".في السابق كان الجيران يغارون منا"


translate arabic day_1_9282395b:


    ".الآن والداي بالكاد لديهما ما يكفي من الحلوى، وقام والدي بتقسيم قطعة شوكولاتة واحدة بالتساوي - أنا وعُلا"


translate arabic day_1_d6cdb7b3:


    ".أحياناً أعطيها نصيبي أيضاً"


translate arabic day_1_03b555a7:


    ".بقدر ما أريد شيئاً حلواً فهي فتاة صغيرة"


translate arabic day_1_ba170306:


    ".لم أستطع الانتظار للذهاب للبحث عن الأدلة عاجلاً"


translate arabic day_1_e848c4e9:



    voice "voice/anton/1day/025. Poidu.ogg"
    Ant "!سأذهب في نزهة على الأقدام"


translate arabic day_1_a4bdb71c:



    voice "voice/karina/30 K.ogg"
    Mam ".لا"


translate arabic day_1_b94b46a2:



    voice "voice/karina/31 K.ogg"
    Mam "حتى يعود رجال الشرطة إلى المنازل بصورتك لاحقاً؟"


translate arabic day_1_70d41c8b:



    voice "voice/karina/32 K.ogg"
    Mam "...الغابة كثيفة جداً"


translate arabic day_1_8f6eddb1:



    voice "voice/karina/35 K.ogg"
    Mam "وإذا كانت الحيوانات البرية قد جرّت الفتى بعيداً؟ أو أسوأ؟"


translate arabic day_1_8baf66f0:


    "أسوأ» - تردد صدى أسفل الممر»"


translate arabic day_1_48dec062:



    voice "voice/anton/1day/026. Da ja r.ogg"
    Ant ".سأكون هنا. لن أذهب إلى الغابة"


translate arabic day_1_aa57fbc0:



    voice "voice/karina/33 K.ogg"
    Mam "ماذا قلتُ لكَ؟! هل يجب أن أكررها مرتين؟"


translate arabic day_1_a5e51305:



    voice "voice/karina/37 K.ogg"
    Mam ".من الأفضل تجميع المحفظة أو اللعب مع عُلا"


translate arabic day_1_080f29fe:


    ".بعد ثانية صدر صوت المياه في المطبخ"


translate arabic day_1_2f71f602:


    ".هذا يعني أن الخلاف انتهى بقيت الكلمة الأخيرة مع والدتي"


translate arabic bunny_hall_day1_c7fcecc2:



    voice "voice/karina/41 K.ogg"
    Mam "!أنطون"


translate arabic bunny_hall_day1_51de0685:



    voice "voice/karina/K.ogg"
    Mam "!سوف أضربك بالحزام! ممنوع أن تخطو عتبة الباب"


translate arabic bunny_hall_day1_a9a61586:


    ".تحتاج أمي إلى تشتيت انتباهها بطريقة ما، وإلا فإنها ستوبخ وتضرب بحزام أبي"


translate arabic bunny_pantry_day1_3e54c396:


    ".لا يوجد وقت لهذا، أمي ستعود قريباً"


translate arabic bunny_pantry_day1_0c33659e:



    voice "voice/karina/05 K.ogg"
    Mam "يا أنطون! اُخرجْ من المخزن، إلى من أتكلم؟"


translate arabic bunny_pantry_day1_5a95df71:


    ".مخزن خانق داكن"


translate arabic bunny_pantry_day1_a801bc40:


    "تقول أمي إنها تفوح منها رائحة الفئران بالداخل لكن من أين عرفتْ كيف تشتم؟"


translate arabic bunny_pantry_day1_edfaca95:


    ".إنها حقاً لا تحب ذلك عندما أدخل هناك تخاف من أن أجرح نفسي بشفرة فأس شحذ مؤخراً"


translate arabic bunny_pantry_day1_dadd299d:


    ".ولا يمكنك إغراء عُلا في المخزن. إنها تعتقد أن باباي يعيش هناك"


translate arabic bunny_pantry_day1_d07c77dc:


    ".بمجرد أن حاولتُ التغلب على مخاوفها: فتحت الباب وأشغلتُ مصباحاً خافتاً وقلتُ – انظري، لا يوجد شيء - مجرد شبكة عنكبوت وأدوات أبي وجدران مخدوشة"


translate arabic bunny_pantry_day1_9dfb7ff0:


    ".ْما صدّقت"


translate arabic bunny_pantry_day1_00480f3d:


    ".«يعجبني الاختباء في المخزن والاستماع إلى طريقة عدُّ علا في الخارج:«ثلاثة، أربعة، خمسة، سأبحث"


translate arabic bunny_pantry_day1_ed49803b:


    ".وهي تتجول صريراً على ألواح الأرضية على أمل أن لا تضطر للدخول معي في وكر الفزاعة الضيق"


translate arabic bunny_hall_cross_3e54c396:


    ".لا يوجد وقت لهذا، أمي ستعود قريباً"


translate arabic bunny_hall_cross_3d275501:


    ".صليب أسود"


translate arabic bunny_hall_cross_558159d2:


    ".شاهد هذا الصليب الكثير من الناس يدخلون ويغادرون المنزل إلى الأبد"


translate arabic bunny_hall_cross_5121d3f5:


    ".أسود كما لو كان قد امتص كل الرذائل البشرية لسنوات عديدة تحت هذا السقف"


translate arabic bunny_hall_cross_617410e6:


    ".بعد وفاة جدتي كانت والدتي تخلعه وتعلق حدوة حصان على الباب - من أجل الحظ. لكنها جرحتْ نفسها على الزاوية الحادة للصليب وكادت تسقط من على كرسيها"


translate arabic bunny_hall_cross_45f228b3:


    ".أطلق الأب على هذه الآية وأمر بترك الصليب في مكانه الصحيح"


translate arabic bunny_hall_ula_3e54c396:


    ".لا يوجد وقت لهذا، أمي ستعود قريباً"


translate arabic bunny_hall_ula_fdf5ca15:


    ".لعبة عُلا"


translate arabic bunny_hall_ula_a6cf4ec0:


    ".خذروف الأم. الإرث العائلي"


translate arabic bunny_hall_ula_997717c9:


    ".عندما كانت أمي صغيرة لعبت به ثم هدتني إياه"


translate arabic bunny_hall_ula_f2cc63c1:


    ".بعدي لعبت عُلا بالخذروف بالميراث"


translate arabic bunny_hall_ula_11c874c9:


    ".نظرتْ إلى المغزل الراقص كما لو أنها تريد أن ترى شيئاً هناك: حبكة خرافية أو ربما مستقبلنا"


translate arabic bunny_hall_ula_84d75815:


    ".الآن الأخت كبيرة في السن بالنسبة للخذروف القديم الحاد"


translate arabic bunny_hall_telephone_3e54c396:


    ".لا يوجد وقت لهذا، أمي ستعود قريباً"


translate arabic bunny_hall_telephone_fdf7aab3:



    voice "voice/karina/Anton otoidi ot tel.ogg"
    Mam ".يا أنطون! ابتعدْ عن الهاتف"


translate arabic bunny_hall_telephone_8abda476:


    ".يمنعني والداي من إجراء مكالمات محلية وكم أحياناً أريد سماع الأصدقاء القدماء"


translate arabic bunny_hall_telephone_8af1cf05:


    ".يحدث أنني التقطت الهاتف للتو واستمع إلى صوت طنان خفيف وصدى بعيد - يبدو كما لو أن الريح تعوي في الأسلاك الجليدية"


translate arabic bunny_kitchen_kalendar_3e54c396:


    ".لا يوجد وقت لهذا، أمي ستعود قريباً"


translate arabic bunny_kitchen_kalendar_d123abbc:


    ".لن ألمسه مرة أخرى"


translate arabic bunny_kitchen_kalendar_2665ce12:


    "...كان التقويم الباهت والملطخ هو التسلية المفضلة لدي في دار الجدة"


translate arabic bunny_kitchen_kalendar_d67ce70c:


    ".أتذكر كيف استيقظت وكان أول شيء فعلته هو الركض إلى المطبخ لتمزيق ورقة ذات تاريخ مضى، كما لو كان يعتمد عليّ ما إذا كان سيأتي يوم جديد أو يضيع في مكان ما في غابة التايغا"


translate arabic bunny_kitchen_kalendar_f826050a:


    "...يوم أقرب إلى العام الجديد الذي طال انتظاره. يوم قريب من جنازة الجدة"


translate arabic bunny_kitchen_kalendar_dc93402f:


    ".لم أتطرق إلى هذا التقويم القديم منذ سنوات"


translate arabic bunny_kitchen_kalendar_6bf07a3a:


    ".نظراً لأن الأوصاف الموجودة على الجانب الآخر قد تغيرت من الأمثال المضحكة وستتحول إلى مظلمة وكئيبة مما دفعني إلى اليأس من الرقيات التي لا يمكنني تفسيرها حتى الموت"


translate arabic bunny_kitchen_kalendar_8b59e5b8:


    ".أخذت صفحة التقويم المغبرة بعناية ومزقتها دون صعوبة"


translate arabic bunny_kitchen_kalendar_06f9fbd1:


    ":لسوء الحظ لم تختفِ الأوصاف المخيفة منذ الطفولة في أي مكان"


translate arabic bunny_kitchen_kalendar_507eb4fb:


    "،يحملون جذعاً على سبعة خيول» \n ،إذا لم يحالفهم الحظ سبعة فسوف يسخرون الثامن"


translate arabic bunny_kitchen_kalendar_8f5c9c50:


