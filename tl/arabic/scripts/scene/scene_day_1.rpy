    ".كانت قدمي عالقة في الثلج. اندفعتْ الأفكار المجنونة في رأسي"


translate arabic run_to_home_8c8cbb59:


    ".سيتم القبض علي الآن"


translate arabic run_to_home_000f6ac7:


    ".يستولون"


translate arabic run_to_home_9206116c:


    ".سوف يجرون في الغابة. إلى أبد الآبدين"


translate arabic run_to_home_e9ac85eb:


    ".لكن كان هناك صوت آخر ربما كان صوت العقل. أعطى القوة وسارع الجري"


translate arabic run_to_home_834a54ba:


    Ant_m "«.أنتَ تستطع! لا تتوقف»"


translate arabic run_to_home_88f03c27:


    ".كان هناك زئير وحشي من الخلف"


translate arabic run_to_home_a4aff293:


    ".بصوت عالٍ لدرجة أن أذني مسدودة"


translate arabic run_to_home_85c39711:


    ".يبدو أنه لم يكن هناك زئير مخلوق جائع واحد بل قطيع كامل"


translate arabic run_to_home_fd364890:


    ".يسحب الهواء المتجمد فتحات أنف ويشم خوفي"


translate arabic run_to_home_8d3bdf3b:


    ".رفرف جناحان عملاقان من الأعلى"


translate arabic run_to_home_1d7a2b46:


    ".إجتاح ظل ضخم الحقل. أطلق شيء ما، مع صوت أزير"


translate arabic run_to_home_d0acb615:


    ".الآن كانوا يزمجرون من جميع الجهات"


translate arabic run_to_home_72ce48ac:


    ".من التوت الجاف. من التنوب الملتوي. من تحت مصدات الرياح"


translate arabic run_to_home_66f5b6ae:


    Ant_m "«!أسرع، اركض! لا تنظر للخلف»"


translate arabic run_to_home_e1c5b98e:


    ".كما لو كان في حلم سيئ أصبح الحقل الثلجي لزجاً مثل الرمال المتحركة"


translate arabic run_to_home_fd33c13f:


    ".كنت أقف في مكان واحد"


translate arabic run_to_home_ae150216:


    ".سحبتُ ساقي من مصيدة سائبة للدخول في المصيدة التالية الأعمق"


translate arabic run_to_home_14aa86be:


    ".ظللتُ أغرق وأغرق أعمق مع كل دفعة يائسة"


translate arabic run_to_home_a7a2e53b:


    "هل يعرف الثلج كيف يمسكه؟"


translate arabic run_to_home_0446cfc4:


    ".صرختُ في رعب وأدركت أنه لم يكن ثلج"


translate arabic run_to_home_38771d7e:


    ".أن أحدهم في جرف ثلجي أمسك بساق بنطالي"


translate arabic run_to_home_6016c40a:


    ".جمعتُ كل قوتي في قبضة واندفعت إلى الأمام"


translate arabic run_to_home_b7a9d3a0:


    ".اختفى الضغط وانزلق الحذاء من الحفرة وارتد النعل من السطح الصلب"


translate arabic run_to_home_d1f1f6f2:


    ".في قفزة واحدة وصلتُ إلى الطريق الخالي ومن هناك هرعتُ إلى الدار"


translate arabic run_to_home_96da428c:


    ".لم تعد واجهته الكئيبة تبدوعدائية"


translate arabic run_to_home_f00bd828:


    ".البيت كان حمايتي من الظلال المتساقطة ومن المخلوقات الزاحفة تحت الثلج"


translate arabic run_to_home_a0ffc502:


    ".تعثرتُ فوق العتبة واصطدمتُ بالباب"


translate arabic run_to_home_3cf067a3:


    ".رأيتُ أنه تم عمل خدوش عليه"


translate arabic run_to_home_416d78fa:


    ".مثل كلب يضرب شجرة بمخالبه ويطالب بالسماح له بالتدفئة"


translate arabic run_to_home_54b78c02:


    ".عندما غادرتُ من المنزل في نزهة لم ألاحظ هذه الحفر العميقة"


translate arabic run_to_home_c67c830f:


    ".غرق دقات القلب في أذني الأصوات الأخرى - لم أسمع ما إذا كان أحد يتبعني"


translate arabic run_to_home_5c06a1f7:


    "ماذا لو هو... هم كانوا بالفعل في الفناء وأمي قد أغلقت الباب؟"


translate arabic run_to_home_9c725bcb:


    ".اختنقتُ من الخوف وسحبتُ المقبض - استسلمت "


translate arabic run_to_home_6847cd7f:



    voice "voice/anton/1day/016. Otdyshk.ogg"
    ".اقتحمتُ الممر وأغلقتُ الباب على الفور"


translate arabic run_to_home_4aaa0b08:


    ".صرختْ ألواح الشرفة بهدوء بينما كان المطاردون يصعدون الدرج"


translate arabic run_to_home_ae01d647:


    ".كانت أصابعي تنزلق ولم أستطع غلق القفل"


translate arabic run_to_home_e7a1a36a:


    ".أطبقتُ أسناني وسحبتُ المقبض الحديدي ودفعت القفل إلى فتحات اللوح الخشبي"


translate arabic run_to_home_f41a9fef:


    ".حدقتُ في الباب"


translate arabic run_to_home_8f36d38a:


    ".خلف الباب نحيفاً ومثيراً للشفقة لا فائدة منه أكثر من البطانية، من يقف هناك"


translate arabic run_to_home_25799acc:


    ".دخل التنفس بصوت أجش إلى البيت وتدحرجت الأمواج"


translate arabic run_to_home_c82b26af:


    ".تفوح منه رائحة عرق و صنوبر"


translate arabic run_to_home_46248b4f:


    ".نظرتْ أمي خارج المطبخ وبصوت عالٍ غالباً ما كانت تتحدث إليه مع أبي"


translate arabic run_to_home_a0a9ed5d:



    voice "voice/karina/50 Chto concr.ogg"
    Mam "ما الذي لا يتضح لك بالضبط بشأن طلب «عدم إغلاق الأبواب»؟"


translate arabic run_to_home_ba8d3236:



    voice "voice/anton/1day/030. YA slucz.ogg"
    Ant ".أنا... بدون قصد"


translate arabic run_to_home_97d7e958:


    ".ألقيتُ نظرة جانبية على الباب - اختفت الرائحة مع أنفاسي. إذا كان هناك شخص ما يتنفس"


translate arabic run_to_home_ff4107c3:


    ".هنا على بعد خمسة أمتار من والدتي قلّ الخوف تدريجياً وذاب مثل كرة الثلج في الدفء، ومعه بقايا القوة"


translate arabic run_to_home_382e9cea:


    ".التوت الساقين. دفعت بنفسي إلى الحائط حتى لا أتخبط على الأرض"


translate arabic run_to_home_70b28a12:


    ".فجأة تغير وجه أمي"


translate arabic run_to_home_403a942c:


    ".طار القناع الجليدي من الشدة والغضب سريعاً. أصبحتْ أمي كما كانت قبل كل هذه المشاجرات"


translate arabic run_to_home_5d77a30c:


    ".رأتْ أخيراً حالتي سروالي المبلل مغطى بحزم من الثلج"


translate arabic run_to_home_cdcc65f7:



    voice "voice/karina/51 K.ogg"
    Mam ".أين كنتَ؟ ماذا قلتُ لك، هاه؟! حتى تجلس في البيت"


translate arabic run_to_home_4bbb0313:



    voice "voice/karina/52 K.ogg"
    Mam "هل أنا لا أعني شيئاً لك أيضاً؟"


translate arabic run_to_home_be26a9c4:


    ".كنتُ أخشى أن تبكي. مد يدها إليها كما في الطفولة عندما طلب ذراعيها"


translate arabic run_to_home_860915b4:


    ".لكن والدتي هدأت وعادت على حالها مرة أخرى"


translate arabic run_to_home_22fe8a9e:


    ".تلمع عيناها كالفولاذ. علا الصوت"


translate arabic run_to_home_b8043678:



    voice "voice/karina/53 K.ogg"
    Mam ".اختفتْ سجائر الأب"


translate arabic run_to_home_f3770ff5:



    voice "voice/karina/54 K.ogg"
    Mam "أعترف بذلك هل سرقتها؟ هل تريد التدخين؟"


translate arabic run_to_home_7fe5961c:



    voice "voice/anton/1day/031. Tam za.ogg"
    Ant "...هناك... كان ه-ه-هناك شخص ما يلاح-ح-حقني اعتقدتُ أن هم"


translate arabic run_to_home_12994320:


    ".في محاولة لشرح كل شيء بدأتُ في التلعثم"


translate arabic run_to_home_2f37ff6c:


    ".ارتفعتْ الدموع في حلقي"


translate arabic run_to_home_9cb7c145:



    voice "voice/karina/55 K.ogg"
    ".انحنتْ والدتي واستنشقتني مثل حيوان تبحث عن رائحة التبغ"


translate arabic run_to_home_8a262830:


    ".ثم عبس وجهها ونظرتْ إلى الفناء بغير تصديق"


translate arabic run_to_home_9c3e5fb1:



    voice "voice/karina/56 K.ogg"
    ".وبعد ذلك بعد أن تغير وجهها، غطت فمها بالكف"


translate arabic run_to_home_6f1eb768:



    voice "voice/karina/57 K.ogg"
    Mam "!انظرْ، ها هم! بجوار السياج"


translate arabic run_to_home_a25e6310:


    ".دقاتْ قلبي متسرعة كما لو كنتُ فريسة مرة أخرى وتبعني الضاربون في الحقل"


translate arabic run_to_home_2b0f5871:


    ".كنت على استعداد لأقسم أن شخصاً ما في الخارج قد خدش الباب. تماما مثل كابوسي"


translate arabic run_to_home_6dfcc245:


    ".أومأتْ أمي بإصبعها وأنا بطريقة أو بأخرى حشدتُ الشجاعة نظرتُ من نافذة المطبخ في وجه الخوف"


translate arabic run_to_home_3f6e98a4:


    ".من خلال رسوم الشتاء على الزجاج كانت الصور الظلية في الثلج بالكاد يمكن تمييزها"


translate arabic run_to_home_75fc2f69:


    "!كلاب"


translate arabic run_to_home_5e76b9fe:


    ".مجرد مجموعة صغيرة من الكلاب بدون اسم ومالك، فقط من بعيد تشبه الفزاعات الجائعة التي تعيش على حافة الغابة"


translate arabic run_to_home_4182e477:



    voice "voice/karina/59 K.ogg"
    Mam ".يا الله، انت خائف منها؟ سوف تخيفك يا أنطون"


translate arabic run_to_home_94f672b5:



    voice "voice/anton/1day/032. Oni gn.ogg"
    Ant ".لقد طاردتي... كنتُ مثل أرنباً"


translate arabic run_to_home_aed9f373:



    voice "voice/anton/1day/033. A vdru.ogg"
    Ant ".ماذا لو كانت مسعورة"


translate arabic run_to_home_b89ec521:


    ".تلاشتْ الابتسامة ببطء من وجه والدتي"


translate arabic run_to_home_116545f4:


    ".والآن بدتْ والدتي بشكل مختلف وكأنها رأت هذه الكلاب لأول مرة"


translate arabic run_to_home_d819dc66:



    voice "voice/karina/61 K.ogg"
    Mam "ماذا لو هاجمتْ عُلا؟"


translate arabic run_to_home_674dd6c1:



    voice "voice/anton/1day/034. Mam G.ogg"
    Ant "أمي؟"


translate arabic run_to_home_85d463f7:



    voice "voice/karina/62 K.ogg"
    Mam "...لو كان والدك فقط سيطلق النار عليها جميعاً"


translate arabic run_to_home_bb23eca5:



    voice "voice/anton/1day/035. Mama o.ogg"
    Ant "!أمي! هم على قيد الحياة"


translate arabic run_to_home_ccab9095:



    voice "voice/karina/63 K.ogg"
    Mam "ماذا عن؟"


translate arabic run_to_home_cd816ec4:



    voice "voice/karina/64 K.ogg"
    Mam ".أنت تقرر حقاً ما إذا كانت أصدقاءك أو أعدائك"


translate arabic run_to_home_d0530b59:



    voice "voice/karina/64 Ne malenk.ogg"
    Mam ".لستَ صغيراً بالفعل"


translate arabic run_to_home_f78f9f02:



    voice "voice/karina/65 K.ogg"
    ".ضحكتْ أمي وشعرتُ بالإهانة بشكل لا يطاق لدرجة أنني عضضتُ شفتي وحدقتُ في الزاوية المغطاة بظلال العنكبوت"


translate arabic run_to_home_92c4dd06:


    ".هممم، أنا محقق رديء"


translate arabic run_to_home_f3fe81cc:


    ".ولم أخاطر بحياتي أمام الوحوش المتوحشة بل بسروالي أمام عصابة من الكلاب الأغبياء"


translate arabic run_to_home_0907af3d:


    "...ولماذا كل هذا؟ هل يستحق ذلك"


translate arabic run_to_home_2a3838ef:


    ".القفاز"


translate arabic run_to_home_5f1a5681:


    "!حسناً، بالطبع"


translate arabic run_to_home_4bcba634:


    ".القفاز الداكن اللزج للصبي المفقود والذي كما اتضح لم أفترق عنه طوال هذا الوقت بقي في يدي"


translate arabic run_to_home_b3dad135:


    "!هذه هي بطاقتي الرابحة لمحقق حقيقي"


translate arabic run_to_home_dc140370:


    ".سارعتُ إلى إظهار الدليل على والدتي"


translate arabic run_to_home_7f2a3844:



    voice "voice/anton/1day/032. Mam sm.ogg"
    Ant "!أمي، انظري، هذا قفاز فوفا"


translate arabic run_to_home_fd7be0bc:



    voice "voice/anton/1day/032. Nu tog.ogg"
    Ant "!الشخص الذي سألت عنه الشرطة في الصباح"


translate arabic run_to_home_91ca1acd:



    voice "voice/anton/1day/032. Ona vs.ogg"
    Ant ".إنه ملطخ بالدماء! معلقة على شجرة! هناك، يمكنني أن أريك"


translate arabic run_to_home_86de52c0:



    voice "voice/anton/1day/032. Davai.ogg"
    Ant "...دعنا نتصل بالشرطة في أسرع وقت ممكن، كما طلب منا ضابط شرطة المنطقة"


translate arabic run_to_home_c94e28a8:



    voice "voice/anton/1day/032. Mam gl.ogg"
    Ant "!انظري يا أمي"


translate arabic run_to_home_bff8fd57:



    voice "voice/karina/66 K.ogg"
    Mam "!أف"


translate arabic run_to_home_633611dc:


    ".ظهر ظل الكفر على وجه أمي الملتوي"


translate arabic run_to_home_a8cae514:


    ".مثل ذكرى شيء منسي منذ زمن طويل. لذلك يحاول الناس أن يتذكروا الحلم لكن الصور تفلت من أيدينا"


translate arabic run_to_home_eb09aba8:



    voice "voice/karina/67 K.ogg"
    Mam "!تعال توقف الآن"


translate arabic run_to_home_305dd4d2:



    voice "voice/karina/68 K.ogg"
    Mam "!عُلا تسمعك - سوف تصاب بالجنون"


translate arabic run_to_home_ae95987c:



    voice "voice/karina/69 K.ogg"
    Mam ".إنها لا تنام على أي حال فهي تشتكي من كل شيء"


translate arabic run_to_home_696b0f31:



    voice "voice/karina/70 K.ogg"
    Mam "!أنت أيضاً مع النكات الخاصة"


translate arabic run_to_home_92fbe260:


    ".الآن رأيتُ أن القفاز كان مبتلاً من الثلج"


translate arabic run_to_home_64014dd6:


    ".لا دم"


translate arabic run_to_home_1d1ed326:


    ".أردتُ أن أغوص في الأرض من العار"


translate arabic run_to_home_332e841c:



    voice "voice/karina/71 K.ogg"
    Mam "...تعال هنا يا مثير للقلق"


translate arabic run_to_home_3465e4d7:



    voice "voice/karina/72 K.ogg"
    Mam "!لا تقف هناك، خذ حبة اشربها بسرعة"


translate arabic run_to_home_ec1fca1a:


    ".سقطتْ حبة ذهبية تشبه دبور ميت في كفي"


translate arabic run_to_home_259c0f7d:



    voice "voice/anton/1day/033. YA uzhe.ogg"
    Ant "...لقد شربتُ بالفعل اليوم على الإفطار"


translate arabic run_to_home_7f2e261e:



    voice "voice/karina/73 K.ogg"
    Mam ".عتابني مرة أخرى"


translate arabic run_to_home_a95c09ac:



    voice "voice/karina/74 K.ogg"
    Mam "...قلتُ أن تجلس في المنزل – أليس كذلك؟"


translate arabic run_to_home_550c764b:



    voice "voice/karina/75 K.ogg"
    Mam ".لو كان أبوك سيجلدك"


translate arabic run_to_home_91f3dc41:



    voice "voice/karina/76 K.ogg"
    Mam ".اشرب الآن، وإلا فلن تنام في الليل. ستذهب إلى المدرسة غداً"


translate arabic run_to_home_709e0c31:


    ".اضطررتُ إلى ابتلاع الدواء المر وغسله بما لا يقل عن الماء المثير للاشمئزاز مع طعم التبييض"


translate arabic run_to_home_02d8e55a:


    ".ربما لم يكن قفاز فوفا"


translate arabic run_to_home_840db1a8:


    ".ربما ليس القفاز على الإطلاق"


translate arabic run_to_home_50a68eb9:


    ".وحوش الغابة أيضاً"


translate arabic run_to_home_a073be25:


    "...وبومة عُلا"


translate arabic run_to_home_a832fa6d:


    "هل أجن؟"


translate arabic run_to_home_19d193f4:


    "ماذا يحدث لي؟"


translate arabic run_to_home_e38e8428:


    ".إما أن الحبة عملت على الفور أو أن الدماغ المفرط في الحركة لا يسمح بالخوف"


translate arabic run_to_home_43c85036:


    ".جاء الهدوء واللامبالاة والتثاؤب"


translate arabic run_to_home_9f259c87:



    voice "voice/karina/77 K.ogg"
    Mam ".يا أنطون! هل شربت؟ بإمكانك إذا أردت"


translate arabic run_to_home_d45b220b:



    voice "voice/karina/78 K.ogg"
    Mam "اخلعْ ملابسك! هل نمت أم ماذا؟"


translate arabic run_to_home_ef9e8302:



    voice "voice/anton/1day/034. Net ma.ogg"
    Ant ".لا يا أمي، فقط أفكر"


translate arabic run_to_home_6c10224f:



    voice "voice/karina/79 K.ogg"
    Mam "أتساءل ماذا عن؟"


translate arabic run_to_home_cb3e1037:



    voice "voice/anton/1day/035. Tak gl.ogg"
    Ant ".لذا... كل أنواع الهراء"


translate arabic run_to_home_f8485be8:


    ".أعطتني أمي نظرة مريبة"


translate arabic run_to_home_5d79966b:


    ".كما لو كانت تشك في أن أمامها ابنها وليس أحد المتظاهرين الذين جاءوا من الغابة"


translate arabic run_to_home_a8b046cf:



    voice "voice/karina/80 K.ogg"
    Mam "هل أنت بخير؟"


translate arabic run_to_home_51293679:



    voice "voice/karina/81 K.ogg"
    Mam "...لقد كان لديك مثل هذا الوجه عندما سأل الشرطي عن النافذة"


translate arabic run_to_home_779c8aa6:



    voice "voice/anton/1day/036. Vse no.ogg"
    Ant "لا بأس يا أمي"


translate arabic run_to_home_da8807ab:



    voice "voice/karina/83 K.ogg"
    "أخذتْ عميقاً"


translate arabic run_to_home_9f98221b:



    voice "voice/karina/82 K.ogg"
    Mam ".حسناً"


translate arabic run_to_home_ce2a8eb5:


    ".يبدو أن الدار قد تغير"


translate arabic run_to_home_29794a11:


    ".لقد تلاشى التنجيد"


translate arabic run_to_home_2f2f64ab:


    ".توجد بصمات أصابع على بلاط الحمام"


translate arabic run_to_home_3963ee02:


    ".كانت المصابيح تتألق بشكل مختلف - خافتة وصفراء"


translate arabic run_to_home_88b7bce2:


    ".حتى طعم اللعاب في فمي بدا مختلفاً"


translate arabic run_to_home_ae38163b:


    ".من الطابق الثاني سمعتُ لحن «علاء الدين» - قامت عُلا بمراجعة حلقاتها المفضلة من «حورية البحر الصغيرة» وانتقلت إلى شرائط كاسيت أخرى"


translate arabic run_to_home_a924fbf9:


    ".«خلعتُ ملابسي على عجل وبقيت أمام الحوض أنظر إلى انعكاسي في المرآة ، كما لو كنت أدرس لغز «اكتشف الفرق"


translate arabic run_to_home_5cf98128:


    ".ثم صعدتُ الدرج"


translate arabic run_to_home_f52f8964:


    ".صمتتْ أصوات جعفر وياغو"


translate arabic run_to_home_49fdae1e:


    ".مررتُ بجانب غرفة نوم عُلا وتوغلتُ في غرفتي"


translate arabic bunny_anton_room_circle_a02ae117:


    ".خلال النهار لا تبدو الغابة قاتمة للغاية"


translate arabic bunny_anton_room_circle_367f4057:


    ".أغصان الأشجار الملتوية في الطريق والحقل المغطى بالثلوج بين المنزل والغابة يتسبابان بالتثاؤب"


translate arabic bunny_anton_room_circle_af804bf2:


    ".لكن في بعض الأحيان أجد نفسي أنسى الدروس وأتطلع من النافذة إلى التيجان الجليدية"


translate arabic bunny_anton_room_circle_cc64397f:


    "...كم هو غريب، لقد دفعتُ الستارة"


translate arabic bunny_anton_room_toys_9a1123e2:


    ".تمثال تريسيراتوبس الخاص بي"


translate arabic bunny_anton_room_toys_3620d362:


    "...أعرف كل أنواع الديناصورات تقريباً: فيلوسيرابتور، أفروفينيتورز، هيبسيلوفودون"


translate arabic bunny_anton_room_toys_376a62b5:


    ".أتذكر عندما كنا لا نزال نعيش في المدينة، ذهبت إلى السينما مع والدي في «حديقة الجوراسية»، والتقطت صورة في البهو بالقرب من تي- ريكس الميكانيكية"


translate arabic bunny_anton_room_toys_335f07b2:


    ".أدار رأسه وزمر بصوت يصم الآذان"


translate arabic bunny_anton_room_toys_853c61cb:


    ".كم كانت رائعة"


translate arabic bunny_anton_room_toys_78002136:


    ".وبجانبها لعبة روبوتيك المتحولة"


translate arabic bunny_anton_room_toys_b6142eab:


    "!أنا أحب هذه الرسوم المتحركة جداً"


translate arabic bunny_anton_room_toys_3925ec3d:


    ".مع تسارع طائرة مقاتلة وإصدار أصوات طنين في مشهد القطع، يمكنك التأكد من أن الدقائق العشرين القادمة ستكون مذهلة"


translate arabic bunny_anton_room_toys_bdf18d00:


    "!شركة الفضاء زيتريندي تم التقاطها! ريك، استعد للمعركة"


translate arabic bunny_anton_room_toys_292b87ff:


    ".ألعاباني تريسيراتوبس وروبوتيك"


translate arabic bunny_anton_room_picture_5851df70:


    ".لقد حلمتُ بأن أصبح فنان منذ أن اشترى لي أبي الرسوم الهزلية الأولى"


translate arabic bunny_anton_room_picture_23593fec:


    ".هي الأروع. أحب بشكل خاص حلقة الفضاء الكبيرة مع الوحوش الغريبة والحلقة المضحكة عن الدرك {u}«الذبابة»{/u} مجلة"


translate arabic bunny_anton_room_picture_0769dad2:


    ".منذ ذلك الحين كنت أرسم كل شيء، ويبدو أنه يعمل بشكل جيد"


translate arabic bunny_anton_room_picture_95c3f0db:


    "مرة واحدة في «الذبابة» نشرت رسالتي. ربما ستتم طباعة رسالتي المصورة هناك يوماً ما؟ "


translate arabic bunny_anton_room_picture_bff4b7ac:


    ".أفضل أعمالي"


translate arabic bunny_anton_room_book_7141b782:


    ".الوحوش والأشباح والأطباق الطائرة"


translate arabic bunny_anton_room_book_80638b6e:


    ".موسوعة النشاط الخارق لدار «روسمان» للنشر. علمتُ منه عن وحش بحيرة لوخ نيس وميدوسا جورجون وبيج فوت"


translate arabic bunny_anton_room_book_c2f42282:


    ".وعُلا تبتعد عن الكتاب"


translate arabic bunny_anton_room_book_db8db4d4:


    ".قامت بالتمرير عبر الأقسام الخاصة بالوحوش والأجانب معي لكن وسط الموسوعة حيث قيل عن الأشباح، قد أخافها"


translate arabic bunny_anton_room_book_52b1acb0:


    ".أتذكر بعد قراءة الكتاب حتى أنني بحثت عن الأشباح: قمت بقياس المسافة بين الأشياء على الطاولة بمسطرة وفي الصباح تحققت مما إذا كانوا قد تحركوا تحت تأثير القوى الشبحية"


translate arabic bunny_anton_room_book_08614dfc:


    ".لم تتحرك"


translate arabic bunny_anton_room_book_54e73c3f:


    "ما الذي كنت أتمناه رغم ذلك؟ ما الأمر مع كاسبر؟"


translate arabic bunny_anton_room_book_23d2cfc2:


    ".لقد حفظتُ هذا الكتاب من الغلاف إلى الغلاف"


translate arabic anton_room_continue1_c19cd09b:


    ".كان أحد الأدراج فارغاً. لقد قمتُ بإخفاء رقم هاتف الشرطي المحلي هناك"


translate arabic anton_room_continue1_411a21e5:


    ".مثل هذا العمل البسيط أزال آخر قوتي"


translate arabic anton_room_continue1_75c98029:


    ".جلستُ على السرير"


translate arabic anton_room_continue1_a6fa8f66:


    ".و رأيتُ: كان هناك شخص ما يقف خلف الستارة"


translate arabic anton_room_continue1_1c6f6db7:


    "ارتخت يدي"


translate arabic anton_room_continue1_08744949:


    ".كان اللوم على الدواء أو الإجهاد الذي حدث، لكن الغرفة غير واضحة كما لو كانت الرياح تهب على الجدران مثل القماش"


translate arabic anton_room_continue1_db2e3efd:


    ".الزوايا عائمة ومنحنية"


translate arabic anton_room_continue1_b18f6c7a:


    ".فقط الصورة الظلية بين عتبة النافذة والستارة بقيت ثابتة. غطى القماش الضيف الكامن"


translate arabic anton_room_continue1_8b62d6d5:


    ".إنه مثل الكفن» - اعتقدتُ»"


translate arabic anton_room_continue1_e73f1a54:



    voice "voice/anton/1day/037. Olja.ogg"
    Ant "عُلا؟"


translate arabic anton_room_continue1_b3b008b8:


    "من يقف هناك أيضاً؟"


translate arabic anton_room_continue1_e58de41c:


    ".نهضتُ من السرير ولعقتُ شفتي الجافة"


translate arabic anton_room_continue1_3117f566:



    voice "voice/anton/1day/038. Olja ocz.ogg"
    Ant ".عُلا، مضحك للغاية"


translate arabic anton_room_continue1_f1d0873a:


    ".الصورة الظلية لم تتحرك"


translate arabic anton_room_continue1_16e27c38:


    ".تدفقتْ الستارة برفق حول الخيال. كأنه ليس رجلاً بل ظلام قاتم"


translate arabic anton_room_continue1_53b97452:


    ".وصلتُ للستارة"


translate arabic anton_room_continue1_66cd0b98:


    ".دق - دق، دق - دق» - دقّ القلب المنظم بواسطة حبوب الأقراص»"


translate arabic anton_room_continue1_aa427784:


    ".غنت الريح في الميدان في جوقة متعددة الألحان"


translate arabic anton_room_continue1_7c0f183b:


    ".أردتُ للحظة أن أعود إلى السرير وأستلقي وأنظر إلى الرجل خلف الستارة مع العلم أنه ينظر إليّ"


translate arabic anton_room_continue1_e5926482:


    ".ينظر دون أن يرمش وينتظر أن أنام"


