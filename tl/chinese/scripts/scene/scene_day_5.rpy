    Ambu "救护中心，请讲。"


translate chinese event_m_polina_phone_ambulance_6d2ee7dd:



    voice "voice/Anton/5day/148 Iz.ogg"
    Ant "对不起，不小心拨错了。"


translate chinese event_m_polina_phone_ambulance_1b0e87ef:


