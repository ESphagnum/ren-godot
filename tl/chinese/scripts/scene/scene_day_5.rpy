    voice "voice/Bear/5day/11 da.ogg"
    Bear "让我们在你温热的肠子里安歇。"


translate chinese event_monsters_came2_42abe08c:



    voice "voice/Owl/33 V.ogg" 
    Owl "在你滚烫的血液里，咕呜！"


translate chinese event_monsters_came2_77f1edcc:



    voice "voice/Wolf/12 Vgor.ogg"
    Wolf "在你滚烫的血液里，嗷呜！"


translate chinese event_monsters_came2_3da573a2:



    voice "voice/Bear/5day/12 Utol.ogg"
    Bear "满足我们的饥渴！"


translate chinese event_monsters_came2_968938ec:



    voice "voice/Wolf/13 Poko.ogg"
