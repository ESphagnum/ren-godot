translate chinese event_m_katya_round3_win_81fbdcf8:



    voice "voice/Anton/5day/231 Pe.ogg"
    Ant "这是我第一次煎得这么成功。"


translate chinese event_m_katya_round4_win_7df1ce54:



    voice "voice/kate/5day/165 p.ogg"
    Kate "简直和餐厅里一样对吧？"


translate chinese event_m_katya_round5_win_44baa39a:



    voice "voice/kate/5day/166v.ogg"
    Kate "快赶上妈妈的手艺了！"


