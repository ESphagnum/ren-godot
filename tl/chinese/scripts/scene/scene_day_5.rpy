translate chinese event_police_devend_cf6fdf5b:



    voice "voice/father/day5/29 An.ogg"
    Pap "安东，现在需要你帮忙……"


translate chinese event_police_devend_d2959932:



    voice "voice/father/day5/30 Pr.ogg"
