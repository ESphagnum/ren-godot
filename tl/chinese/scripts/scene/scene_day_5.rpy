translate chinese event_monsters_came2_bfaeaeb0:



    voice "voice/Owl/32 Za.ogg" 
    Owl "小兔子。"


translate chinese event_monsters_came2_87454724:



    voice "voice/Bear/5day/10 Ply.ogg"
    Bear "在血泊中起舞吧，长着长毛的傻瓜！"


