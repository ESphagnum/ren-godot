    voice "voice/kate/5day/185mo.ogg"
    Kate "可以尽情享用美食，不用再管愚蠢的节食计划。"


translate chinese event_m_katya_after_game_63ed6b57:



    voice "voice/kate/5day/186m.ogg"
    Kate "嗯！用天然油煎的肉饼配土豆……"


translate chinese event_m_katya_after_game_b4f35df4:



    voice "voice/kate/5day/187h.ogg"
    Kate "尝一口？"


translate chinese event_m_katya_after_game_8e948e77:


    "卡嘉用叉子插着肉饼递过来，对我露出迷人的微笑。"


translate chinese event_m_katya_after_game_578f66ae:


    "还没反应过来，我已经就着她的手咬了一口，像个傻子似的笑着。"


translate chinese event_m_katya_after_game_d57be047:


    "肉饼美味极了，蓬松又柔软。"


translate chinese event_m_katya_after_game_34fee4e8:


    "当盘子见底时，我问："


translate chinese event_m_katya_after_game_9e107ae9:



    voice "voice/Anton/5day/235 D.ogg"
    Ant "还要吗？"


translate chinese event_m_katya_after_game_25323e8a:



    voice "voice/Anton/5day/236 K.ogg"
    Ant "你没事吧卡嘉？"


translate chinese event_m_katya_after_game_2697f4ac:



    voice "voice/kate/5day/189m.ogg"
    "她沉默着，手指按揉太阳穴。"


translate chinese event_m_katya_after_game_a8545aec:



    voice "voice/Anton/5day/237 Ne.ogg"
    Ant "你不该这么勉强自己的！"


translate chinese event_m_katya_after_game_50543a18:



    voice "voice/kate/5day/190p.ogg"
    Kate "只是……"


translate chinese event_m_katya_after_game_86a14ebd:



    voice "voice/kate/5day/189st.ogg"
    "她咬紧牙关吸气。"


translate chinese event_m_katya_after_game_8f040bf0:



    voice "voice/kate/5day/191g.ogg"
    Kate "……有点头晕。"


translate chinese event_m_katya_after_game_3d356733:



    voice "voice/kate/5day/192 m.ogg"
    Kate "能帮我看看发烧没有？"


translate chinese event_m_katya_after_game_3e038c37:


    "我伸出手。"


translate chinese event_m_katya_after_game_16715220:



    voice "voice/kate/5day/193ne.ogg"
    Kate "不，用嘴唇碰我额头。妈妈都这样量体温。"


translate chinese event_m_katya_after_game_bcd935cc:


    "我不安地觉得卡嘉又在捉弄我。"


translate chinese event_m_katya_after_game_52f13b6b:



    voice "voice/Anton/5day/238 A.ogg"
    Ant "没有体温计吗？"


translate chinese event_m_katya_after_game_a4e33af9:



    voice "voice/Anton/5day/239 Nu.ogg"
    Ant "算了……"


translate chinese event_m_katya_after_game_f325af14:


    "我俯身快速轻吻了她的额头。"


translate chinese event_m_katya_after_game_4090cd59:



    voice "voice/Anton/5day/240 Vr.ogg"
    Ant "不烫。"


translate chinese event_m_katya_after_game_3f7d9c54:



    voice "voice/kate/5day/194do.ogg"
    Kate "扶我回床上吧。"


translate chinese event_m_katya_after_game_454e7dc8:


    "我搀扶卡嘉进卧室，她迅速钻进了被子。"


translate chinese event_m_katya_after_game_3c1a21d9:



    voice "voice/kate/5day/195po.ogg"
    Kate "陪我躺会儿。"


translate chinese event_m_katya_after_game_422494aa:


    "我窘迫得不知所措。"


translate chinese event_m_katya_after_game_8c0478da:



    voice "voice/Anton/5day/241 E.ogg"
    Ant "这……不太合适……"


translate chinese event_m_katya_after_game_22c5c306:



    voice "voice/kate/5day/196ch.ogg"
    Kate "连陪陪朋友都嫌过分？"


translate chinese event_m_katya_after_game_d07a1f2b:



    voice "voice/kate/5day/197m.ogg"
    Kate "妈妈很快就回来换你。在我睡着前陪着我就好。"


translate chinese event_m_katya_after_game_0b74f271:


    "她用恳求的目光看着我。我点点头躺到她身边。"


translate chinese event_m_katya_after_game_2e6231b7:


    "卡嘉伸手关掉了床头灯。"


translate chinese event_m_katya_after_game_763d68f8:


    "我们在黑暗中躺着，听狂风呼啸。"


translate chinese event_m_katya_after_game_7b815e93:


    "卡嘉的指尖滑过我的手背。我们的小指勾在一起。"


translate chinese event_m_katya_after_game_f18d4b13:


    "尽管无需言语，卡嘉还是轻声开口："


translate chinese event_m_katya_after_game_1fd310d8:



    voice "voice/kate/5day/199t.ogg"
    Kate "我真的，真的好喜欢你。"


translate chinese event_m_katya_after_game_7e1cc2ff:



    voice "voice/kate/5day/200s.ogg"
    Kate "如果你也这么想，就告诉我。"


translate chinese event_m_katya_after_game_d6209e36:


    "我舔了舔干涩的嘴唇。"


translate chinese event_m_katya_after_game_e012e6c6:



    voice "voice/olya/5day/15 Anto.ogg"
    Oly "安东……"


translate chinese event_m_katya_after_game_2d1a4e56:


    "角落里传来呼唤。"


translate chinese event_m_katya_after_game_4d02d425:


    "我难以置信地转头。"


translate chinese event_m_katya_after_game_6744b33d:


    "孩童的轮廓潜伏在黑暗中，像来索取我灵魂的小小幽灵。"


translate chinese event_m_katya_after_game_d58dae10:



    voice "voice/Anton/5day/242 K.ogg"
    Ant "卡嘉……"


translate chinese event_m_katya_after_game_35003d86:



    voice "voice/kate/5day/201da.ogg"
    Kate "嗯？"


translate chinese event_m_katya_after_game_eacdd63d:



    voice "voice/Anton/5day/243 T.ogg"
    Ant "那儿有人。"


translate chinese event_m_katya_after_game_6d7b867f:



    voice "voice/kate/5day/202eto.ogg"
    Kate "那只是奖牌架子的影子啦，傻瓜。"


translate chinese event_m_katya_after_game_ca3477ee:



    voice "voice/olya/5day/16 An.ogg"
    Oly "安东，求求你醒醒。"


translate chinese event_m_katya_after_game_34a4b3d8:


    "我转开视线，小指更用力地勾住卡嘉的。"


translate chinese event_m_katya_after_game_22c18bf4:



    voice "voice/Anton/5day/244 K.ogg"
    Ant "卡嘉，有件事要告诉你。"


translate chinese event_m_katya_after_game_d6ca3063:



    voice "voice/kate/5day/203ya.ogg"
    Kate "你不喜欢我？"


translate chinese event_m_katya_after_game_b8de2148:



    voice "voice/Anton/5day/245 De.ogg"
    Ant "不，不是这个。我有时会出现幻觉。"


translate chinese event_m_katya_after_game_a4ad14f1:



    voice "voice/Anton/5day/246 D.ogg"
    Ant "医生说长大就会好。我在吃药。"


translate chinese event_m_katya_after_game_28b55925:



    voice "voice/kate/5day/204ti.ogg"
    Kate "这吓不到我。忘了吗？"


translate chinese event_m_katya_after_game_b42997a4:



    voice "voice/kate/5day/205m.ogg"
    Kate "我那个所谓的父亲就是精神科医生。"


translate chinese event_m_katya_after_game_fc4178ab:



    voice "voice/kate/5day/206v.ogg"
    Kate "按时吃药就没事了。"


translate chinese event_m_katya_after_game_459a277d:



    voice "voice/kate/5day/207da.ogg"
    Kate "没错没错！"


translate chinese event_m_katya_after_game_ca4b5b4b:



    voice "voice/olya/5day/17 Ant.ogg"
    Oly "安东，求求你听我说！"


translate chinese event_m_katya_after_game_afterdev_e7bca60f:


    "我从口袋取出一板药。"


translate chinese event_m_katya_accept_4ce077f5:


    "我嚼碎药片闭上眼睛，听着喧嚣的暴风雪和卡嘉的呼吸……"


translate chinese event_m_katya_accept_767a3b47:


    "……再没有幻听中孩子的哭喊。"


translate chinese event_m_katya_accept_b45b2a34:


    "我感到浑身发热。"


translate chinese event_m_katya_accept_9b0f0dd1:


    "卡嘉用嘴唇轻触我的额头，然后温柔地抚摸我的脸颊。"


translate chinese event_m_katya_accept_b11f39f4:



    voice "voice/kate/5day/208sp.ogg"
    Kate "睡吧，睡醒了就好了。"


translate chinese event_m_katya_accept_b8e6e3b0:


    "我任由温暖的浪潮包裹自己。"


translate chinese event_m_katya_accept_31495008:



    voice "voice/kate/5day/209z.ogg"
    Kate "安心睡，我妈妈会给你爸爸妈妈打电话的。"


translate chinese event_m_katya_accept_5f000982:


    "我坠入虚无……"


translate chinese event_m_katya_accept_566df08a:



    voice "voice/kate/5day/210s.ogg"
    Kate "睡吧，我在这儿陪着你……"


translate chinese event_m_katya_accept_2bad8766:



    voice "voice/kate/5day/210 sp.ogg"
    Kate "睡吧……"


translate chinese event_m_katya_refuse_2ddcf4ae:



    voice "voice/Anton/5day/247 Ya.ogg"
    Ant "我已经吃太多了。"


translate chinese event_m_katya_refuse_464d296c:



    voice "voice/Anton/5day/248 H.ogg"
    Ant "适可而止吧。我不想药物过量致死。"


translate chinese event_m_katya_refuse_2e5af574:



    voice "voice/Anton/5day/249 Ka.ogg"
    Ant "卡嘉？"


translate chinese event_m_katya_refuse_4b7c2d9e:



    voice "voice/kate/5day/211hn.ogg"
    "我听见身旁传来压抑的啜泣。"


translate chinese event_m_katya_refuse_8e37a14b:



    voice "voice/Anton/5day/250 K.ogg"
    Ant "卡嘉，亲爱的，怎么了？"


translate chinese event_m_katya_refuse_d1c18d5e:


    "漆黑的房间里响起黏腻的拍打声。"


translate chinese event_m_katya_refuse_d0e91a19:


    "像创可贴被撕开的声音。"


translate chinese event_m_katya_refuse_e2755dbd:


    "我感觉到一只袜子迅速被粘稠液体浸透。"


translate chinese event_m_katya_refuse_2a7c2b73:


    "颤抖的手在墙上摸索着寻找开关。"


translate chinese event_m_katya_refuse_ba2621d8:


    "床头灯亮起的瞬间，毯子上正蔓延开暗红色污渍。"


translate chinese event_m_katya_refuse_3c25a380:


    "我从沙发滚落到墙边。"


translate chinese event_m_katya_refuse_c7c9c516:



    voice "voice/Anton/5day/251 Ka.ogg"
    Ant "卡嘉，你的伤口裂开了！"


translate chinese event_m_katya_refuse_72c18cf2:


    "我惊慌地掀开毯子。"


translate chinese event_m_katya_refuse_43db9a03:


    "本以为会看到浸透鲜血的绷带，但眼前的景象让我浑身冰凉。"


translate chinese event_m_katya_refuse_318412cc:


    "卡嘉的腿自膝盖以下消失了。"


translate chinese event_m_katya_refuse_41b3a2f7:


    "肥硕的老鼠在血泊中扭动。"


translate chinese event_m_katya_refuse_7c511a23:


    "他们吞噬了卡佳，贪婪的脸埋在她腿根断口沸腾的血肉里。"


translate chinese event_m_katya_refuse_3036fd95:


    "最大那只老鼠正试图从碎骨中吸吮骨髓。"


translate chinese event_m_katya_refuse_3b769688:



    voice "voice/kate/5day/212A.ogg"
    "卡嘉发出尖利的哀鸣。"


translate chinese event_m_katya_refuse_b8a9f644:



    voice "voice/kate/5day/212 A.ogg"
    "她突然直起身，惨白的脸转向我。青筋在皮肤下暴起，眼珠疯狂转动。"


translate chinese event_m_katya_refuse_0509b520:



    voice "voice/kate/5day/213 ti.ogg"
    Kate "你！！！"


translate chinese event_m_katya_refuse_36fd4860:


    "她低吼着，将床单揉成一团。"


translate chinese event_m_katya_refuse_8d0b31df:



