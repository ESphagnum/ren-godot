    Narrator_color ""


translate chinese d4_beasts_choice_take_devend_6b167378:



    voice "voice/anton/4day/205. Ho.ogg"
    Ant_Color "要不要跟我们一起玩？"


translate chinese d4_beasts_choice_take_devend_02fb7e8c:



    voice "voice/Child/4day/Amozno.ogg"
    Children_Color "可以吗？"


translate chinese d4_beasts_choice_take_devend_ff9769b5:



