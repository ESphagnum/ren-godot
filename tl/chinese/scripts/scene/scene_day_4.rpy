translate chinese d4_beasts_choice_take_devend_98e8b7e3:



    voice "voice/kozel/4day/127Ya.ogg"
    Frost_Color "你们最大的愿望，就由我来实现！我保证让你们都开心！"


translate chinese d4_beasts_choice_take_devend_27f9b16d:



