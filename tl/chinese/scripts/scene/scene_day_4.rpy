translate chinese d4_beasts_choice_take_devend_4e6113d4:


    Narrator_color ""


translate chinese d4_beasts_choice_take_devend_73cbd79c:



    voice "voice/anton/4day/204.Mn.ogg"
    Ant_Color "礼物太多了，我们两个根本要不完，要不分点给别人吧？你觉得分给谁好？"


translate chinese d4_beasts_choice_take_devend_15558929:



