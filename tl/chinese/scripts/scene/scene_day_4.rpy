    voice "voice/Alisa/4day/111 TiS.ogg"
    Alis_Color "你开心吗，托沙？"


translate chinese d4_beasts_choice_take_devend_188c437e:



    voice "voice/anton/4day/207. Ya.ogg"
    Ant_Color "开心！"


translate chinese d4_beasts_choice_take_devend_137de5c2:


    Narrator_color ""


translate chinese d4_beasts_choice_take_devend_f1b4bdfe:


    Narrator_color ""


