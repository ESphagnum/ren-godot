translate turkish d4_palace_dev_972c4901:



    voice "voice/olya/4day/37 Da.ogg"
    Oly "Olur!"


translate turkish d4_palace_dev_d1ff0ad1:



    voice "voice/kozel/4day/83.To.ogg"
