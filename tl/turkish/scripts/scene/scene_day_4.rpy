translate turkish d4_beasts_605ec087:



    voice "voice/Alisa/4day/62 Zapr.ogg"
    Alis "Hayhay!"


translate turkish d4_beasts_e8e78cf8:



    voice "voice/Alisa/4day/63 Ol.ogg"
    Alis "Olya, ormanımızda {u}Ayaz Baba{/u}'yı nasıl bulabileceğini biliyor musun?"


translate turkish d4_beasts_18b2a729:


    "Kardeşimin gözleri fal taşı gibi açıldı."


translate turkish d4_beasts_892d6ca4:



    voice "voice/olya/4day/23 K.ogg"
    Oly "Nasıl?"


translate turkish d4_beasts_492495ad:



    voice "voice/Alisa/4day/64 Nu.ogg"
    Alis "Şekerlerin izini sürerek."


translate turkish d4_beasts_2be8123e:


    "Alisa eğilip karların arasından bir şeker çıkardı."


translate turkish d4_beasts_9a8b951e:


    "Olya, ellerini hayretle havaya kaldırdı."


translate turkish d4_beasts_0b0b8933:


    "Hevesle bana baktı, kafa sallayarak onay verdim."


translate turkish d4_beasts_c251c651:


