translate turkish d4_beasts_choice3_refuse_34952e2a:



    voice "voice/Alisa/4day/104 Kogda.ogg"
    Alis "O karlı açıklıkta -az kalsın- aya dişlerini geçirecekti, unuttunuz mu?"


translate turkish d4_beasts_choice3_refuse_1cc67b9a:


    "Hevesi kursağında kalan yamyamlardan çıt çıkmıyordu."


translate turkish d4_beasts_choice3_refuse_f334c70a:


    "Alisa ise o sırada fevri bir karar vermiş..."


translate turkish d4_beasts_choice3_refuse_990b8d86:


    "Kendisiyle tanıştığım o ocak sabahındaki tilki maskeli şirin çocuk hâline dönmüştü."


translate turkish d4_beasts_choice3_refuse_65663d5d:


    "Ağır adımlarla bana yaklaştı, etrafımızı saran korkuyu mandalina ve maytabın büyülü kokusuyla dağıttı."


translate turkish d4_beasts_choice3_refuse_e1922f08:


    "Yumuşacık patileriyle yanaklarıma dokundu, alnıma yapışan bir tutam saçı aldı."


translate turkish d4_beasts_choice3_refuse_9d88dd15:


    "Ardından tilki kız beni kucaklayıp tatlı bir ses tonuyla fısıldadı:"


translate turkish d4_beasts_choice3_refuse_8b3e23e4:



    voice "voice/Alisa/4day/105 Tosha.ogg"
    Alis "Kurtulmak ister misin Toşa?"


translate turkish d4_beasts_choice3_refuse_3f7b8045:


    "Dişlerimi sıkıp sessizliğimi korudum. Gözlerimi kaçırıp bu anlık yanılsamayı mahvetmekten korkuyordum."


translate turkish d4_beasts_choice3_refuse_a86dcc2d:



    voice "voice/Alisa/4day/106 Moi.ogg"
    Alis "Söyle tatlım, kardeşini kurtarmak ister misin?"


translate turkish d4_beasts_choice3_refuse_a061ae89:


    "O an gözlerimden yaşlar boşaldı."


translate turkish d4_beasts_choice3_refuse_13b314a7:



    voice "voice/anton/4day/195. Da.ogg"
    Ant "E-evet."


translate turkish d4_beasts_choice3_refuse_abbbf4c8:


    "Tilki kızın kabanının eteğine yapışmış, burnumu çekip tir tir titriyordum."


translate turkish d4_beasts_choice3_refuse_f61a8d75:



    voice "voice/Alisa/4day/107 Ska.ogg"
    Alis "Sesli söyle de herkes duysun."


translate turkish d4_beasts_choice3_refuse_eafcb284:


    "Gözyaşlarından yüzüm sırılsıklam olmuş hâlde acı acı bağırdım."


translate turkish d4_beasts_choice3_refuse_cbe37d72:



    voice "voice/anton/4day/196.Daa.ogg"
    Ant "EVET!"


translate turkish d4_beasts_choice3_refuse_f4ee5986:


    "Birden ağzımda kan gibi metalik bir tat hissettim."


translate turkish d4_beasts_choice3_refuse_30472b40:


    "Tilki, siyah parmaklarıyla bir parça insan etini boğazıma tıkıvermişti."


translate turkish d4_beasts_choice3_refuse_50d4e61a:


    "Diz çöktüm. Öksürdükçe kan geliyordu ama bir türlü kusamıyordum."


translate turkish d4_beasts_choice3_refuse_cd201783:


    "Hayvan leşleri bir kez daha etrafımı sardı."


translate turkish d4_beasts_choice3_refuse_62ee8d41:



    voice "voice/Owl/4day/Kakoe.ogg"
    Owl "Şaka gibi."


translate turkish d4_beasts_choice3_refuse_abd8aa04:



    voice "voice/Owl/4day/Pozvol.ogg"
    Owl "Efendim, izin verin de kızdan bir lokmacık alayım bari."


translate turkish d4_beasts_choice3_refuse_01244402:


    "O an beynime kan sıçradı ve içimde adını koyamadığım ilkel bir his patlak verdi."


translate turkish d4_beasts_choice3_refuse_f1e82cec:



    voice "voice/anton/4day/198. Tolko.ogg"
    Bunny "Sıkıyorsa al, seni beyinsiz tavuk! O leş dilini koparır, mabadına sokarım!"


translate turkish d4_beasts_choice3_refuse_25aae670:


    "Şom ağızlı baykuş, tilkinin kıkırtıları eşliğinde şaşkınlıkla sıçradı."


translate turkish d4_beasts_choice3_refuse_c5a73fda:


    "Sesim yatıştığında iki büklüm oldum."


translate turkish d4_beasts_choice3_refuse_5bd19a19:


    "Az önce bir türlü çıkaramadığım o bir lokma \"ikram\" ile birlikte ağzımdan kusmuklar saçıldı."


translate turkish d4_beasts_choice3_refuse_cbe7e2da:



    voice "voice/kozel/4day/122.Ti.ogg"
    Master "Haklısın. Tavşancık..."


translate turkish d4_beasts_choice3_refuse_2b091a86:


    voice "voice/kozel/4day/124.Dih2.ogg"


translate turkish d4_beasts_choice3_refuse_1ec87298:


    "Beni parmağıyla dürttü. Göğsümde sapına kadar saplanan bir bıçak varmış gibi hissettim."


translate turkish d4_beasts_choice3_refuse_c83db7cd:



    voice "voice/kozel/4day/123.Tv.ogg"
    Master "İkramda bulunma sırası sende."


translate turkish d4_beasts_choice3_refuse_4b63b882:



    voice "voice/kozel/4day/Dob.ogg"
    Master "Yarın geceye kadar bize et getireceksin..."


translate turkish d4_beasts_choice3_refuse_c0585745:



    voice "voice/Wolf/342 Inche.ogg"
    Wolf "Yoksa..."


translate turkish d4_beasts_choice3_refuse_eea69925:



    voice "voice/Bear/4day/59 Enache.ogg"
    Bear "Yoksa..."


translate turkish d4_beasts_choice3_refuse_0e566ede:


    "Alisa usulca gölgeye çekildi, keçi de pis kokulu ağzını burnumun dibine sokup gürledi."


translate turkish d4_beasts_choice3_refuse_6985d7b0:



    voice "voice/kozel/4day/125.ME.ogg"
    Master "Yoksa... Ailendeki herkesi yeriz."


translate turkish d4_beasts_choice3_refuse_15b5cb8c:


    "Toynağını yere vurduğu gibi her şeyi unutup arkama bile bakmadan kaçtım."


translate turkish d4_beasts_choice3_refuse_64493087:


    "Arkamdan \"Seni de yeriz, hem de canlı canlı!\" diye bağırdıklarını duydum."


translate turkish d4_beasts_choice3_refuse_9ec5d5cf:


    "Omuzlarıma, içinde ölü sıçanlar yatan buz parçaları yağıyordu."


translate turkish d4_beasts_choice3_refuse_ab816d48:


    "Ağaçların, dallarını oynatıp -yulaf lapasına tuz serpen aşçılar gibi- üzerime lapa lapa kar serptiği yere kendimi zor atmıştım."


translate turkish d4_beasts_choice3_refuse_aff4a46b:


    "Rüzgar saçımı çekiştiriyordu."


translate turkish d4_beasts_choice3_refuse_412dadaa:


    "Arkamı dönmemle donakaldım."


translate turkish d4_beasts_choice3_refuse_fcde6f34:


    "Garaj, gözlerimin önünde ortadan kayboluyordu. Önce giderek bulanık ve saydam bir hâle geldi; ardından kuvvetli bir rüzgar, garajın kapkara duvarlarını alıp götürdü."


translate turkish d4_beasts_choice3_refuse_1ee64e2d:


    "Kardeşimi o canavar ininde bıraktığımı ancak o zaman fark ettim."


translate turkish d4_beasts_choice3_refuse_aa93c097:


    "Kalenin olduğu yerde yalnızca dev bir kar yığını kalmıştı."


translate turkish d4_beasts_choice3_refuse_ea144750:


    "O kar yığınının arasından, mezarlara dikilen haçları anımsatan bir kız eli uzanıyordu."


translate turkish d4_beasts_choice3_refuse_d9b08cc9:


    "Dehşetle koşup kar yığınını eşelemeye başladım."


translate turkish d4_beasts_choice3_refuse_cb5bb596:


    "Karların arasından Olya'nın solgun yüzü ile omuzları gözüktü."


translate turkish d4_beasts_choice3_refuse_8ea511d4:


    "Morarmış dudakları titriyordu."


translate turkish d4_beasts_choice3_refuse_7e8f590e:


    "Yaşıyor!"


translate turkish d4_beasts_choice3_refuse_1c884de6:



    voice "voice/anton/4day/200. Ya.ogg"
    Ant "Dayan!"


translate turkish d4_beasts_choice3_refuse_a88bafa3:


    "Aynı şeyi Katya için de söylediğimi hatırlayınca boğazım kuruyuverdi."


translate turkish d4_beasts_choice3_refuse_dcb95226:


    "Dayanması için yalvarıp karları eşelemeye devam ettim."


translate turkish d4_beasts_choice3_refuse_9d725fa4:


    "Bir süre eşeledikten sonra karnını görebilmiştim."


translate turkish d4_beasts_choice3_refuse_7780ba78:



    voice "voice/olya/4day/69Hol.ogg"
    Oly "Üşüyorum."


translate turkish d4_beasts_choice3_refuse_b875e0ff:


    "Hâlsiz konuşuyordu."


translate turkish d4_beasts_choice3_refuse_9bb50de1:



    voice "voice/anton/4day/201. Niche.ogg"
    Ant "Geçecek."


translate turkish d4_beasts_choice3_refuse_6e666fe7:



    voice "voice/anton/4day/201. Otn.ogg"
    Ant "Seni eve taşıyacağım, sonra da sıcak çikolata içip ısınacağız. Yeter ki dayan, tamam mı?"


translate turkish d4_beasts_choice3_refuse_18e3b99a:



    voice "voice/anton/4day/202. Tito.ogg"
    Ant "Yeter ki..."


translate turkish d4_beasts_choice3_refuse_48b6b4e6:


    "Elime sıcacık, vıcık vıcık bir şey geldi."


translate turkish d4_beasts_choice3_refuse_6430601d:


    "Eşelemeye devam ettikçe kar, kırmızı çamura dönüyordu."


translate turkish d4_beasts_choice3_refuse_47984faa:



    voice "voice/olya/4day/50 Cho.ogg"
    Oly "Ne oldu? Ne var orada?"


translate turkish d4_beasts_choice3_refuse_71e470a7:


    "Yutkundum."


translate turkish d4_beasts_choice3_refuse_7b2f9d83:



    voice "voice/olya/4day/51Poch.ogg"
    Oly "Niye bir şey demiyorsun?"


translate turkish d4_beasts_choice3_refuse_4d57b057:


    "Nasıl diyebilirdim ki?"


translate turkish d4_beasts_choice3_refuse_11b3ed5d:


    "Olya belden aşağısını kaybetmiş, bağırsakları boğum boğum saçılmıştı."


translate turkish d4_beasts_choice3_refuse_fa17375e:


    "Kardeşim başını eğip vücudundan geriye kalan korkunç manzaraya baktı."


translate turkish d4_beasts_choice3_refuse_078c17ed:


    "Ardından sağır edici bir çığlık attı."


translate turkish d4_beasts_choice_take_devend_66d4ecfe:


    "Atıştırmalık yığınından en lezzetli görünen abur cuburu bulup aldım."


translate turkish d4_beasts_choice_take_devend_53bc90e1:


    Narr_color "Bir ısırık aldığım gibi sütlü çikolata, ağzımda eriyiverdi."


translate turkish d4_beasts_choice_take_devend_08ff04bf:



    voice "voice/kozel/4day/127.S.ogg"
    Frost_Color "Kutluyorum seçimini, hadi afiyet olsun!"


translate turkish d4_beasts_choice_take_devend_98e8b7e3:



    voice "voice/kozel/4day/127Ya.ogg"
    Frost_Color "Tüm dileklerin, Ayaz Baba'yla gerçek olsun!"


translate turkish d4_beasts_choice_take_devend_27f9b16d:



    voice "voice/olya/4day/53 A.ogg"
    Olya_Color "Anton, bak!"


translate turkish d4_beasts_choice_take_devend_54f9f06d:


    Narr_color "Yüzü gözü çikolata olan kardeşime kızacaktım ki..."


translate turkish d4_beasts_choice_take_devend_55c6ea22:


    Narr_color "Boğazım düğümleniverdi."


translate turkish d4_beasts_choice_take_devend_0103e7e7:


    Narr_color "Dev bir ladin ağacı, göğe fırlayıp yıldızların ve dev gibi ayın arasında uzayın derinliklerine karıştı."


translate turkish d4_beasts_choice_take_devend_6ada7549:


    Narr_color "Dallarında parıltılı devasa toplar ve gökkuşağının her renginden göz alıcı ışıklar vardı."


translate turkish d4_beasts_choice_take_devend_22f3c2c1:


    Narr_color "Çatı ortadan kayboldu ve karanlık gökyüzündeki sayısız takımyıldızı gözler önüne serdi."


translate turkish d4_beasts_choice_take_devend_a8a2c098:


    Narr_color "Müzik, kahkahalar, çam kokusu ve şekerler eksik olmuyordu!"


translate turkish d4_beasts_choice_take_devend_06bfd58f:


    Narr_color "Ayıcık, Kurtçuk ve Baykuşçuk yanımızda dans ediyordu!"


translate turkish d4_beasts_choice_take_devend_ee73c3fd:


    Narr_color "Kar taneleri de göğe yükseliyordu!"


translate turkish d4_beasts_choice_take_devend_16ce1472:


    Narr_color "Kahkahalara boğulup altın simli püsküle dokundum."


translate turkish d4_beasts_choice_take_devend_2d285326:


    Narr_color "O da gerçekti!"


translate turkish d4_beasts_choice_take_devend_47891a70:



    voice "voice/olya/4day/54 E.ogg"
    Olya_Color "Burası... Düşündüğüm yer mi?"


translate turkish d4_beasts_choice_take_devend_dde37a40:



    voice "voice/Alisa/4day/109 Vi.ogg"
    Alis_Color "Varolmayan Ülke'den mi bahsediyorsun acaba?"


translate turkish d4_beasts_choice_take_devend_c18eab2a:



    voice "voice/olya/4day/55 Et.ogg"
    Olya_Color "Burası Varolmayan Ülke mi?"


translate turkish d4_beasts_choice_take_devend_19456adc:


    Narr_color "Alisa tiyatrocu selamı verdi."


translate turkish d4_beasts_choice_take_devend_5d59eb1f:


    Narr_color "Yılbaşı süsleri parıl parıl parlıyor, ruhum da onlarla birlikte ışık saçıyordu."


translate turkish d4_beasts_choice_take_devend_4a06f805:


    Narr_color "Sihirli tayga ormanıyla, yumuşacık çam yapraklarıyla ve tüm takımyıldızlarla bütünleşiyordum."


translate turkish d4_beasts_choice_take_devend_357bf83f:



    voice "voice/Alisa/4day/110 Dobro.ogg"
    Alis_Color "Evinize hoş geldiniz!"


translate turkish d4_beasts_choice_take_devend_10e8c83f:


    Narr_color "Demek, bunca zamandır evim burasıymış."


translate turkish d4_beasts_choice_take_devend_8f2e04c3:


    Narr_color "Karların parıltısı göz alıcıydı."


translate turkish d4_beasts_choice_take_devend_8bd57f33:


    Narr_color "Olya döne döne dans etmeye başlayıp iki eline de birer şeker aldı."


translate turkish d4_beasts_choice_take_devend_c550b507:


    Narr_color "Kurtçuk, Kinder Sürpriz yumurtaları jonglör gibi havada çeviriyordu."


translate turkish d4_beasts_choice_take_devend_fe2b7f12:



    voice "voice/olya/4day/56 T.ogg"
    Olya_Color "Gördün mü?"


translate turkish d4_beasts_choice_take_devend_d6ff85ac:


    Narr_color "Kamyon dolusu oyun konsolu, bebek ve dönüşümlü aksiyon figürü, ladin ağacının altında duruyordu."


translate turkish d4_beasts_choice_take_devend_00147dd7:



    voice "voice/olya/4day/57 Et.ogg"
    Olya_Color "Bunlar bizim mi?"


translate turkish d4_beasts_choice_take_devend_1b531a90:


    Narr_color "Sevinçten ben de dans ederek yanıtladım."


translate turkish d4_beasts_choice_take_devend_73cbd79c:



    voice "voice/anton/4day/204.Mn.ogg"
    Ant_Color "Hepsi ikimize fazla gelir, başkalarına da verelim bence. Sen ne dersin?"


translate turkish d4_beasts_choice_take_devend_4774a691:



    voice "voice/olya/4day/58 Nu.ogg"
    Olya_Color "Sadece uslu çocuklara."


translate turkish d4_beasts_choice_take_devend_293eefa7:


    Narr_color "Ağaçlığın ucunda mest olmuş hâlde dikilen birkaç çocuk, kutlamamızı izliyordu."


translate turkish d4_beasts_choice_take_devend_43afc1b0:



    voice "voice/anton/4day/204. Ei.ogg"
    Ant_Color "Arkadaşlar!"


translate turkish d4_beasts_choice_take_devend_74749d13:


    Narr_color "Tek sıçrayışta açıklığı boydan boya aşıp yanlarına süzüldüm."


translate turkish d4_beasts_choice_take_devend_6b167378:



    voice "voice/anton/4day/205. Ho.ogg"
    Ant_Color "Katılmak ister misiniz?"


translate turkish d4_beasts_choice_take_devend_02fb7e8c:



    voice "voice/Child/4day/Amozno.ogg"
    Children_Color "Olur mu ki?"


translate turkish d4_beasts_choice_take_devend_ff9769b5:



    voice "voice/anton/4day/206. Spr.ogg"
    Ant_Color "Elbette!"


translate turkish d4_beasts_choice_take_devend_61db897b:


    Narr_color "El ele tutuşup peş peşe dizilen çocukları hediyelere götürdüm."


translate turkish d4_beasts_choice_take_devend_40131396:


    Narr_color "Birilerinin hayallerine giden yolda onlara önderlik etmek gibisi yoktu."


translate turkish d4_beasts_choice_take_devend_49461f10:


    Narr_color "Bayramımız tüm coşkusuyla devam ediyordu."


translate turkish d4_beasts_choice_take_devend_3aeb1411:


    Narr_color "Ne kadar güzel olursa olsun, her bayramın bir sonu vardı ve bunu bilmek, insanın içine kurt düşürüyordu."


translate turkish d4_beasts_choice_take_devend_7f47709e:


    Narr_color "Gel gör ki burada, heybetli ladinin çam kanatları altında bayramların sonu yoktu."


translate turkish d4_beasts_choice_take_devend_d16cb81c:



    voice "voice/Alisa/4day/111 TiS.ogg"
    Alis_Color "Mutlu musun Toşa?"


translate turkish d4_beasts_choice_take_devend_188c437e:



    voice "voice/anton/4day/207. Ya.ogg"
    Ant_Color "Evet!"


translate turkish d4_beasts_choice_take_devend_8c6d6639:


    Narr_color "Gökyüzünde görkemli havai fişekler patlıyor, dans edenleri aydınlatıyordu."


translate turkish d4_beasts_choice_take_devend_aacfb3c7:


    Narr_color "Gözlerim yaşardı, kaslarım kasıldı."


translate turkish d4_beasts_choice_take_devend_129c97d0:


    Narr_color "Aya bakmak üzere kafamı kaldırdığımda içime dolup taşan duygularla avazım çıktığı kadar bağırdım."


translate turkish d4_beasts_choice_take_devend_c29124a4:



    voice "voice/Alisa/4day/112 TiScha.ogg"
    Alis_Color "Mutlu musun Tavşancık?"


translate turkish d4_beasts_choice_take_devend_483db378:


    Narr_color "Yıldızlara doğru zıplayıp havada takla attım."


translate turkish d4_beasts_choice_take_devend_a712df1a:


    Narr_color "Haykırışlarım, Varolmayan Ülke'nin dört bir yanında yankılanıyordu."


translate turkish d4_beasts_choice_take_devend_86b66b5c:



    voice "voice/anton/4day/210. Sha.ogg"
    Ant_Color "Mutluyum!"


translate turkish d4_beasts_choice_take_devend_01df1769:


    "Yeni evimizde günlerdir ilk kez yüzüm gülerek uyanmıştım."


translate turkish d4_beasts_choice_take_devend_9dd2b6f0:


    "Bu sefer mutluluk, bünyemi terk etmemekte ısrarcıydı. Neşeyle gerinip vücudumun her bir hücresiyle bu hissin tadına vardım."


translate turkish d4_beasts_choice_take_devend_4b60ada1:


    "Dışarıdan ışıltılı ocak güneşine methiyeler düzen kırmızı göğüslü güzel şakrak kuşlarının cıvıltıları geliyordu."


translate turkish d4_beasts_choice_take_devend_32d67ece:


    "Bu cıvıltılar, penceremin dışındaki yapraksız ormanın günün birinde ailemi ağırlayacak bir cennet bahçesi olacağına dair umutlarımı yeşertiyordu."


translate turkish d4_beasts_choice_take_devend_75ae0c94:



    voice "voice/olya/4day/Hahaha.ogg"
    "Koridorda havlamalar ve minik ayak sesleri yankılanıyordu."


translate turkish d4_beasts_choice_take_devend_fce1ee67:


    "Odamın kapısı çat diye açıldı ve içeriye ılık bir meltemle birlikte sıcacık kahve kokusu doluştu."


translate turkish d4_beasts_choice_take_devend_68fe269f:


    "Mutluluğu nur yüzüne yansıyan Olya, kucağında kuyruğunu kıpır kıpır sallayan tatlı mı tatlı Julka'yla kapıda dikiliyordu."


translate turkish d4_beasts_choice_take_devend_c39db5d0:



    voice "voice/olya/4day/60 To.ogg"
    Oly "Şuna bak Toşa! Babam, bizimle kalabileceğini söyledi!"


translate turkish d4_beasts_choice_take_devend_b6cb706d:


    "Kardeşimin gözleri mutluluktan yaşarmıştı."


translate turkish d4_beasts_choice_take_devend_34a728f5:



    voice "voice/olya/4day/61Um.ogg"
    Oly "Bu artık benim köpeğim!"


translate turkish d4_beasts_choice_take_devend_e22b065f:


    "Bu harika haberi duyunca yatağımdan fırlayıverdim."


translate turkish d4_beasts_choice_take_devend_fe749e65:



    voice "voice/anton/4day/211. Da.ogg"
    Ant "Julka değil mi o?"


translate turkish d4_beasts_choice_take_devend_ea636bf4:



    voice "voice/olya/4day/62 S.ogg"
    Oly "Ne Julka'sı, Prenses o bir kere."


translate turkish d4_beasts_choice_take_devend_2d996e58:



    voice "voice/olya/4day/63 Da.ogg"
    Oly "Değil mi Prenses'im?"


translate turkish d4_beasts_choice_take_devend_8eeadfd5:


    "Köpek de onaylarcasına havladı."


translate turkish d4_beasts_choice_take_devend_35def0c0:



    voice "voice/father/day4/81Tuk.ogg"
    Pap "Tık tık! Gelebilir miyim?"


translate turkish d4_beasts_choice_take_devend_268ab008:


    "Ne şaşırtıcıdır ki gülümseyerek odaya giren babam, daha da ilginç şekilde anneme sarılıyordu."


translate turkish d4_beasts_choice_take_devend_51d18933:



    voice "voice/father/day4/82 Kak.ogg"
    Pap "Ailemizin yeni üyesini beğendin mi?"


translate turkish d4_beasts_choice_take_devend_f6b2183e:



    voice "voice/father/day4/83 Mn.ogg"
    Pap "Haylaz, kendisini arabanın önüne attı, az kalsın eziyordum yavrucağı."


translate turkish d4_beasts_choice_take_devend_0b7103eb:



    voice "voice/father/day4/84M.ogg"
    Pap "Ondan kaçınayım derken bu sefer de arabayı çiziverdim. Sinirden iki elimle boğazına yapışacaktım ki..."


translate turkish d4_beasts_choice_take_devend_323adb41:



    voice "voice/father/day4/84 A.ogg"
    Pap "Gözlerine baktığımda... Bir şey hissettim... Nasıl desem..."


translate turkish d4_beasts_choice_take_devend_abab32c6:



    voice "voice/karina/4day/131 Um.ogg"
    Mam "Zeka belirtisi."


translate turkish d4_beasts_choice_take_devend_62b284ed:



    voice "voice/father/day4/85 Vo.ogg"
    Pap "Aynen! Tir tir titriyordu bir de zavallım."


translate turkish d4_beasts_choice_take_devend_777f481e:



    voice "voice/father/day4/85 Nu.ogg" 
    Pap "Sonra dedim ki, eve varana kadar arabanın koltuğuna pislemezsen bizimle kalabilirsin."


translate turkish d4_beasts_choice_take_devend_c3d03b4b:



    voice "voice/olya/4day/64 Pr.ogg"
    Oly "Prensesler hiçbir yere pislemez bir kere!"


translate turkish d4_beasts_choice_take_devend_712c5bf8:


    "En ufak şeylere bile kahkahayı bastığımız eski günlerdeki gibi hep bir ağızdan güldük."


translate turkish d4_beasts_choice_take_devend_0e22e1cd:



    voice "voice/karina/4day/133 Che.ogg"
    Mam "Niye sustun ya? Birkaç şey daha anlatacaktın."


translate turkish d4_beasts_choice_take_devend_7f69b738:


    "Annemin sevecen bakışlarına yakalanan babam pancar gibi kızardı. İkisi de çocuklar gibi şirindi."


translate turkish d4_beasts_choice_take_devend_c8e40f10:



    voice "voice/father/day4/87 A.ogg"
    Pap "İyi bir haber daha: Babanız terfi etti."


translate turkish d4_beasts_choice_take_devend_76b2ded0:



    voice "voice/father/day4/88 Gre.ogg"
    Pap "Tabii baş muhasebeci kaybolduğu için çok da sevinmemek lazım, ayıp olur."


translate turkish d4_beasts_choice_take_devend_8219fb01:



    voice "voice/father/day4/88 No.ogg"
    Pap "Yine de her şerde bir hayır vardır, derler."


translate turkish d4_beasts_choice_take_devend_18b403dc:



    voice "voice/anton/4day/213. Eto.ogg"
    Ant "Yani artık daha mı fazla mesai yapacaksın?"


translate turkish d4_beasts_choice_take_devend_bfdf91f7:



    voice "voice/karina/4day/134 Eto.ogg"
    Mam "Yani artık baban iki kat ikramiye alacak."


translate turkish d4_beasts_choice_take_devend_02848bab:



    voice "voice/father/day4/89 Pra.ogg"
    Pap "Aynen öyle, Karina!"


translate turkish d4_beasts_choice_take_devend_aa2d6521:



    voice "voice/father/day4/89 Ta.ogg"
    Pap "O yüzden haftaya ailecek çıkacağımız geziye şimdiden hazırlanın."


translate turkish d4_beasts_choice_take_devend_aba3e762:


    "Bu sözleri duyunca kalp atışlarım hızlandı."


translate turkish d4_beasts_choice_take_devend_29600eb8:



    voice "voice/anton/4day/214. Kuda.ogg"
    Ant "N-nereye?"


translate turkish d4_beasts_choice_take_devend_e117af81:


    "Olya da sımsıkı kucakladığı sahipsiz köpeği salıvermişti."


translate turkish d4_beasts_choice_take_devend_bc12e151:



    voice "voice/olya/4day/66 Neu.ogg"
    Oly "Aa! McDonald's'a mı gideceğiz?"


translate turkish d4_beasts_choice_take_devend_53edb999:



    voice "voice/father/day4/90 S.ogg"
    Pap "Olur mu, Olya?"


translate turkish d4_beasts_choice_take_devend_99fc744a:



    voice "voice/father/day4/90 Mi.ogg"
    Pap "Büyük düşün! Bu geziyi uzun zamandır planlıyoruz, yalnızca hep bir aksaklık çıktı."


translate turkish d4_beasts_choice_take_devend_430a3ba3:



    voice "voice/karina/4day/135 Ve.ogg"
    Mam "Çok özür dileriz çocuklar."


translate turkish d4_beasts_choice_take_devend_7e20c7ee:


    "Annem gözyaşını elinin tersiyle sildi."


translate turkish d4_beasts_choice_take_devend_787d9a18:



    voice "voice/father/day4/90Da.ogg"
    Pap "Canımız sağ olsun, Karina. Geçti, gitti artık."


translate turkish d4_beasts_choice_take_devend_41e9ccd8:



    voice "voice/father/day4/91 V.ogg" 
    Pap "Her neyse. Hazır olun, ailecek Disneyland'e uçuyoruz!"


translate turkish d4_beasts_choice_take_devend_0b553c41:


    "Kardeşimle sevinçten havalara uçtuk. Köpek de babamın tutkulu konuşmasından etkilenip bize katıldı."


translate turkish d4_beasts_choice_take_devend_5f6000a8:


    AntOly "Yaşasın!"


translate turkish d4_beasts_choice_take_devend_1f112f81:


    AntOly "Disneyland! Disneyland!"


translate turkish d4_beasts_choice_take_devend_0489bd48:


    "Evin dört yanında yankılanan coşku dolu çığlıklarımız, tavan arasından ve borulardan geçip ön bahçeye çıkmış, oradan da ışıltılı beyaz ormana usulca gitmişti."


translate turkish d4_beasts_choice_take_devend_8914d320:


    "Beraberinde de B harfiyle başlayan kelimeyi alıp götürmüştü."


translate turkish d4_beasts_choice_take_devend_2205018c:


    "Annemle babamın alaycı maskelerini nihayet çıkarıp, onca zamandır tanıyıp sevdiğimiz gerçek yüzlerini gözler önüne serdiği bu günü ömür boyu unutmayacağıma ant içmiştim."


translate turkish d4_beasts_choice_take_devend_25ff058c:


    "Katya kaybolduğundan beri Liliya Pavlovna okula gelmemişti. Bu yüzden iyi bir uyku çekip hava iyice aydınlandıktan sonra okula gitmiştim."


translate turkish d4_beasts_choice_take_devend_1f27a777:


    "Patika; bacalarından huş ve çam kokulu dumanlar tüten, kar beyaz ova manzaralı kapkara evlere doğru uzanıyordu."


translate turkish d4_beasts_choice_take_devend_999688ea:


    "Gecenin dondurucu soğuğu nihayet dinip sabahın ilk ışıklarıyla uykuya çekilmişti. Evlerin çatılarında kar tanecikleri uçuşuyordu."


translate turkish d4_beasts_choice_take_devend_d2065a21:


    "Bugün keyfimi kimsenin kaçıramayacağından emin bir şekilde durakladım."


translate turkish d4_beasts_choice_take_devend_93aa11e9:


    "Başımın belası Pyatifanov veya onun adi kankası Byaşa'nın bile hiç şansı yoktu."


translate turkish d4_beasts_choice_take_devend_82a28b7b:


    "Hatta ölü balık gibi derimi yüzmekle tehdit ettiği o kelebek çakının..."


translate turkish d4_beasts_choice_take_devend_e9b16592:


    "Veya Polina'nın kaçamak bakışlarındaki kibir ve acıma duygusunun da... Hepsini geride bırakmış, yersiz kabuslar gibi unutmuştum."


translate turkish d4_beasts_choice_take_devend_e9572dcc:


    "Ne üzülüyordum ne de Romka'yla Viyana'yı fethetme hayallerine çoktan kapılmış olduğunu düşündüğüm Polina yüzünden kendime acıyordum."


translate turkish d4_beasts_choice_take_devend_c8754a5f:


    "Tüm bu hislerim sonsuza dek silinmişti."


translate turkish d4_beasts_choice_take_devend_9040afed:


    "Uzaklardan uzun bir inek mölemesi duyuldu."


translate turkish d4_beasts_choice_take_devend_6d2f523c:


    "O an daldığım hayallerden kurtulup botlarımla karları ezerek yürümeye devam ettim."


translate turkish d4_beasts_choice_take_devend_c4585769:


    "Tepemde pofuduk bulutlar geziyor, şekilleri hayvan dostlarıma benziyordu."


translate turkish d4_beasts_choice_take_devend_a7103825:


    "Enseme pat diye bir kar topu isabet etti ve ilkbahar melteminde sallanan minik çanları anımsatan kız gibi bir gülüş kulağımı gıdıkladı."


translate turkish d4_beasts_choice_take_devend_7e4e0d94:


    "Hayal alemine giden yolda bana rehberlik eden sevgili Alisa'cığımı görmek umuduyla arkamı döndüm."


translate turkish d4_beasts_choice_take_devend_6e60a630:


    "Fakat ayak izlerinin birbirine karıştığı patikada tilki kızı değil, yanından hiç ayırmadığı keman kutusuyla Polina'yı gördüm."


translate turkish d4_beasts_choice_take_devend_a2464e88:



    voice "voice/Polina/4day/178 Op.ogg"
    Pol "Aklın beş karış havada yine, Petrov."


translate turkish d4_beasts_choice_take_devend_8332352e:


    "Sempatik bir gülüşle üzerime atılıp boynuma sarıldı. Şaşkınlıkla dikildiğim yerden kendimi onun o tatlı parfüm kokusuna bıraktım."


translate turkish d4_beasts_choice_take_devend_d8f95a7b:


    "Daha dün geçirdiği duygu patlamasının şaşkınlığını atlatamamışken Polina'dan uzak durmanın iyi olacağını düşündüm."


translate turkish d4_beasts_choice_take_devend_c62bb6f5:


    "Ne çalkantılı ruh hâliyle ne de o tuhaf dedesiyle yüz göz olmama gerek yoktu."


translate turkish d4_beasts_choice_take_devend_48624517:


    "Ancak bana sarıldığı an, tüm o kabuslar silsilesini unuttum ve bu hünerli kemancının benden vazgeçmesini istemediğime karar verdim."


translate turkish d4_beasts_choice_take_devend_c225322e:



    voice "voice/anton/4day/216. Chto.ogg"
    Ant "B-bir şey mi oldu?"


translate turkish d4_beasts_choice_take_devend_ca7f805e:


    "Yüzünde mahcup bir tebessüm belirdi. Sümbül mavisi gözleri parıldıyordu."


translate turkish d4_beasts_choice_take_devend_4bf2414b:



    voice "voice/Polina/4day/179 De.ogg"
    Pol "Dedem..."


translate turkish d4_beasts_choice_take_devend_853efe52:



    voice "voice/Polina/4day/180 On.ogg"
    Pol "Dedem yeniden ayaklandı, inanabiliyor musun?"


translate turkish d4_beasts_choice_take_devend_61494940:



    voice "voice/Polina/4day/181 V.ogg"
    Pol "Sağlık ocağındaki doktor ümitsiz konuşmuştu ama ona rağmen doğrulup yürümeye başladı."


translate turkish d4_beasts_choice_take_devend_769c0dd5:



    voice "voice/Polina/4day/182 O.ogg"
    Pol "Ah Anton, bugün hayatımın en mutlu günü!"


translate turkish d4_beasts_choice_take_devend_2a0a2c13:


    "Sanki onun için arkadaştan da ötesiymişim gibi belimden sımsıkı kavrayıp göğsüme kapandı."


translate turkish d4_beasts_choice_take_devend_302def22:


    "Endişeyle etrafıma bakındım."


translate turkish d4_beasts_choice_take_devend_88957670:



    voice "voice/anton/4day/217. Pol.ogg"
    Ant "Ee, Polina... Biri bizi görebilir."


translate turkish d4_beasts_choice_take_devend_6169e973:



    voice "voice/Polina/4day/183 Iz.ogg"
    Pol "Pyatifanov'dan mı endişeleniyorsun?"


translate turkish d4_beasts_choice_take_devend_f868a8c7:



    voice "voice/Polina/4day/184 B.ogg"
    Pol "Öyleyse hiç endişelenme çünkü bir süredir ortalıkta yok."


translate turkish d4_beasts_choice_take_devend_2361350f:


    "Şaka mı yapıyordu yoksa ciddi miydi, anlayamadığımdan Polina'nın kollarından kuşkuyla sıyrıldım."


translate turkish d4_beasts_choice_take_devend_4972a937:



    voice "voice/Polina/4day/185 Nu.ogg"
    Pol "Yoksa bana inanmıyor musun?"


translate turkish d4_beasts_choice_take_devend_26262b0c:



    voice "voice/Polina/4day/186 K.ogg"
    Pol "Daha dün gece Üsteğmen Tihonov kapımızı çaldı."


translate turkish d4_beasts_choice_take_devend_7551beaa:



    voice "voice/Polina/4day/187 T.ogg"
    Pol "Romka ile kankası Byaşa'nın kaybolduğunu söyledi."


translate turkish d4_beasts_choice_take_devend_1452c88b:


    "Bir grup kayakçı, yanımızdan geçip ormana doğru vınladı."


translate turkish d4_beasts_choice_take_devend_4071b33b:


    "Polina, gözlerini kayakçılardan ayırmadan kulağıma eğilip fısıldadı."


translate turkish d4_beasts_choice_take_devend_b06d6b9a:



    voice "voice/Polina/4day/188 K.ogg"
    Pol "Anladığım kadarıyla Tihonov, önceki kayıp vakaları konusunda Pyatifanov'dan şüpheleniyormuş."


translate turkish d4_beasts_choice_take_devend_1c8de83e:



    voice "voice/anton/4day/218. Da.ogg"
    Ant "Hadi canım!"


translate turkish d4_beasts_choice_take_devend_68707aa7:



    voice "voice/Polina/4day/189 Ya.ogg"
    Pol "Ben de öyle dedim."


translate turkish d4_beasts_choice_take_devend_a2c1d04d:



    voice "voice/Polina/4day/190 po.ogg"
    Pol "Romka iyice balatayı sıyırmış, diyenler var."


translate turkish d4_beasts_choice_take_devend_0e8cb505:



    voice "voice/Polina/4day/191 Da.ogg"
    Pol "Açıkçası hiç şaşırmadım."


translate turkish d4_beasts_choice_take_devend_d94ef132:



    voice "voice/anton/4day/219. Cto.ogg"
    Ant "Nasıl yani?"


translate turkish d4_beasts_choice_take_devend_0bbc1b2a:



    voice "voice/Polina/4day/192 A.ogg"
    Pol "Romka'nın ailevi sıkıntıları vardı, bilmiyor musun?"


translate turkish d4_beasts_choice_take_devend_b2cf902a:



    voice "voice/Polina/4day/193 D.ogg"
    Pol "Kim bilir, evde başına gelmeyen kalmamıştır."


translate turkish d4_beasts_choice_take_devend_443744bd:


    "Uçan sineğe bile yok yere atarlandığından Romka'nın öfke sorunu olduğunu fark etmiştim."


translate turkish d4_beasts_choice_take_devend_5f2c7350:


    "Uzun zamandır içinde barındırdığı kötülüğü nihayet dışına taşınca kendisi de dahil olmak üzere birçok gencecik masum ruhu ölüme sürüklemişti."


translate turkish d4_beasts_choice_take_devend_251e5e68:


    "İnanması güç ama Romka'yı ilk görüşümde olayların böyle sonlanacağını tahmin etmiştim."


translate turkish d4_beasts_choice_take_devend_454fd863:



    voice "voice/Polina/4day/194 V.ogg"
    Pol "Bir de Romka'ya şans vermemi söyleyen sendin."


translate turkish d4_beasts_choice_take_devend_f421ab9d:



    voice "voice/Polina/4day/195 K.ogg"
    Pol "Aklıma geldikçe tüylerim ürperiyor!"


translate turkish d4_beasts_choice_take_devend_e0105ab2:



    voice "voice/anton/4day/220. Proste.ogg"
    Ant "Çok özür dilerim."


translate turkish d4_beasts_choice_take_devend_d33b61a3:


    "Elini savurup gülümsedi."


translate turkish d4_beasts_choice_take_devend_28d169ac:



    voice "voice/Polina/4day/196 K.ogg"
    Pol "Geçti, gitti artık."


translate turkish d4_beasts_choice_take_devend_2128be7e:



    voice "voice/Polina/4day/197 Vo.ogg"
    Pol "Keşke tüm başıboş köpekler de yok olsa..."


translate turkish d4_beasts_choice_take_devend_ae597115:



    voice "voice/Polina/4day/198 Ne.ogg"
    Pol "O zaman derin bir oh çekerdim."


translate turkish d4_beasts_choice_take_devend_9dcc3c4a:


    "Kuşkuyla Polina'ya baktım."


translate turkish d4_beasts_choice_take_devend_36a661c4:



    voice "voice/Polina/4day/199 Da.ogg"
    Pol "Haha! Şaka yahu!"


translate turkish d4_beasts_choice_take_devend_96a64b51:



    voice "voice/Polina/4day/200 Po.ogg"
    Pol "Hadi gidelim yoksa geç kalacağız."


translate turkish d4_beasts_choice_take_devend_e3199064:


    "Polina elimi tutup neşe dolu kahkahalarla köy yolunda koşmaya başladı."


translate turkish d4_beasts_choice_take_devend_6b0a1f64:


    "Attığı her adım ve kahkahada, yaptığı her şakada unuttuğumu sandığım sıcaklık hissiyle içimi daha da ısıtıyordu."


translate turkish d4_beasts_choice_take_devend_8817b151:


    "İnsanı sarıp sarmalayan aşk, beni sanki bu sefer hiç kaybolmayacakmışçasına etkisi altına almıştı."


translate turkish d4_beasts_choice_take_devend_51a25aed:


    "Sınıftakilerin bize laf atmasından çekindiğim için sınıfa yaklaştığımızda Polina'nın elini bırakmayı denedim."


translate turkish d4_beasts_choice_take_devend_2cb39d8d:


    "Polina ise hiç umurunda değilmişçesine, kapıyı açarken elimi sımsıkı tuttu."


translate turkish d4_beasts_choice_take_devend_613cf513:


    "Haklıydı da... Kurnaz Katya, kalpsiz Romka ve arsız Byaşa artık yoktu. Hâliyle sınıfımız da mikroplardan arınmışçasına kibar ve dostane bir havaya bürünmüştü."


translate turkish d4_beasts_choice_take_devend_a1961258:


    "Artık kin dolu bakışlara maruz kalmıyordum. Kimse kalemini tüftüf yapıp, çiğneyip tükürdükleri kağıt topları bana fırlatmıyordu."


translate turkish d4_beasts_choice_take_devend_00055050:


    "Herkesten uzak sırama oturdum. Polina da yanıma oturdu, hiç şaşırmadım."


translate turkish d4_beasts_choice_take_devend_b02bad6b:


    "O kadar büyüleyiciydi ki ilham perilerinin vücut bulmuş hâliydi."


translate turkish d4_beasts_choice_take_devend_16c3b87e:


    "Doğal olarak bir ilham geldi ve çantamdan eskiz defterimi çıkarıverdim."


translate turkish d4_beasts_choice_take_devend_23882562:


    "Gözlerimi canlı modelimden ayırmadan kurşun kalemimin ucunu yaladım."


translate turkish d4_beasts_choice_take_devend_55bc1f67:


    "Yine gülümsedi."


translate turkish d4_beasts_choice_take_devend_efca3a5a:



    voice "voice/Polina/4day/201 Ch.ogg"
    Pol "Aklında ne var?"


translate turkish d4_beasts_choice_take_devend_8b1ed9e0:



    voice "voice/anton/4day/221. Spok.ogg"
    Ant "Rahat ol! İşi ustasına bırak."


translate turkish d4_beasts_choice_take_devend_84ec3c27:


    "İnsanın aklını başından alan vücut hatlarını kabataslak resmettim."


translate turkish d4_beasts_choice_take_devend_fa3c6cb4:



    voice "voice/anton/4day/222. Znae.ogg"
    Ant "Var ya, seni sıramdan saatlerce izlemişimdir."


translate turkish d4_beasts_choice_take_devend_028accea:


    "Eski sırasına baktıktan sonra utanıp bir tutam saçını kulağının arkasına attı."


translate turkish d4_beasts_choice_take_devend_29de6df2:



    voice "voice/Polina/4day/202 P.ogg"
    Pol "Cidden mi?"


translate turkish d4_beasts_choice_take_devend_dc6c2fe3:


    "Kalın çizgilerle tatlı yanaklarını belirginleştirdim."


translate turkish d4_beasts_choice_take_devend_4f6db853:


    "Birisini bu kadar detaylarına özenerek çizme şansına ilk kez sahip olmuştum."


translate turkish d4_beasts_choice_take_devend_0c81f832:



    voice "voice/anton/4day/223. Po.ogg"
    Ant "Polina..."


translate turkish d4_beasts_choice_take_devend_25f6adff:



    voice "voice/Polina/4day/203 Cht.ogg"
    Pol "Efendim Anton?"


translate turkish d4_beasts_choice_take_devend_2bd5bd45:


    "Yanlış bir hareketle emeğime yazık edip ânın büyüsünü bozmaktan korkarcasına hareketsiz duruyordu."


translate turkish d4_beasts_choice_take_devend_afd10d4d:



    voice "voice/anton/4day/244.Na.ogg"
    Ant "Şöyle biraz eğilir misin?"


translate turkish d4_beasts_choice_take_devend_2871abde:



    voice "voice/anton/4day/244.Vot.ogg"
    Ant "Evet, aynen öyle. Güzel."


translate turkish d4_beasts_choice_take_devend_52b18d53:


    "Heyecandan boğulacak gibi hissetmiş olmalı ki yakasındaki fuları gevşetti."


translate turkish d4_beasts_choice_take_devend_24710dbc:



    voice "voice/anton/4day/225. Yav.ogg"
    Ant "Ne zamandır... Resmini çizmek istiyordum."


translate turkish d4_beasts_choice_take_devend_c5569c6a:


    "O an göz göze geldik."


translate turkish d4_beasts_choice_take_devend_2eaf5093:



    voice "voice/Polina/4day/205 O.ogg"
    Pol "Ah Anton."


translate turkish d4_beasts_choice_take_devend_6f509d93:


    "Kalemimi şak diye çekip göğsünü gölgelendirdim."


translate turkish d4_beasts_choice_take_devend_8a1c2278:



    voice "voice/anton/4day/226. Ska.ogg"
    Ant "Çizgi romanımın başkahramanı olmak ister miydin acaba?"


translate turkish d4_beasts_choice_take_devend_e52f61fa:


    "İçim bir hoş olmuştu. Polina'nın gözleri sevinçten parlayıverdi."


translate turkish d4_beasts_choice_take_devend_2238a926:



    voice "voice/Polina/4day/206 Da.ogg"
    Pol "Tabii ki!"


translate turkish d4_beasts_choice_take_devend_f5494d58:



    voice "voice/Polina/4day/207 K.ogg"
    Pol "Ben de bunu sormanı bekliyordum, canım benim!"


translate turkish d4_wake_up_devend_39d70300:


    "Kalemimin ucu, o anki baskıya dayanamayıp paramparça oldu."


translate turkish d4_wake_up_devend_cec102ee:


    "Çizimime baktığımda gözlerime inanamadım."


translate turkish d4_wake_up_devend_e6aaafef:


    "Korkunç bir tabloyla karşı karşıyaydım. Henüz iki saniye önce Polina'nın yüzünün olduğu yerde biçimsiz bir şey bitivermişti."


translate turkish d4_wake_up_devend_a20cefa7:


    "..."


translate turkish d4_wake_up_devend_999eb8cb:


    "Aslında boş bir sınıfta tek başıma oturduğumu fark etmem biraz zaman aldı."


translate turkish d4_wake_up_devend_885977c8:


    "Mehtaptaki yalnızlığıma sadece havada uçuşan toz zerreleri eşlik ediyordu."


translate turkish d4_wake_up_devend_49cad19b:


    "Dışarısı karanlıktı. Sınıftakiler, Polina ve tüm neşem gitmişti."


translate turkish d4_wake_up_devend_d8474f85:


    "Tebeşirle kara tahtaya yazılan silik tekerlemeyi kısmen okuyabildim:"


translate turkish d4_wake_up_devend_3691f083:


    "Bir, iki."


translate turkish d4_wake_up_devend_fa6b925e:


    "Tavşancık."


translate turkish d4_wake_up_devend_61ff1306:


    "Et..."


translate turkish d4_wake_up_devend_19012565:


    "Yüzümdeki safça gülüşü yitirmiştim."


translate turkish d4_wake_up_devend_d8c361de:


    "Ayağa kalkıp kolumu çimdirdim. Sessizlik zihnimde yankılanıyordu."


translate turkish d4_wake_up_devend_cef95e6b:


    "Ağzımda kusmuk tadı vardı, kulaklarımda ise dinmek bilmeyen acı bir çığlık."


translate turkish d4_wake_up_devend_1707b594:



    voice "voice/anton/4day/228. Ei.ogg"
    Ant "Hop! Kimse yok mu?"


translate turkish d4_wake_up_devend_fb32e943:


    "Gölgeler koridorda cirit atıyordu."


translate turkish d4_wake_up_devend_7fe27bf1:


    "Kapılarına tahta çakılı sınıfların, küflü duvarların ve parıltılı örümcek ağlarının önünden geçtim."


translate turkish d4_wake_up_devend_b63c0781:


    "Tavanda örümcekler geziyordu."


translate turkish d4_wake_up_devend_8311e97a:


    "Işıklar ansızın yanıp sönüyordu."


translate turkish d4_wake_up_devend_c65f54c3:


    "Duyuru panosunun önünden geçerken şaşkınlıkla durakladım."


translate turkish d4_wake_up_devend_21880413:


    "Semyon ve Katya'nın bulunduğu panoya yüzlerce yeni yüz eklenmişti."


translate turkish d4_wake_up_devend_92784406:


    "Boş göz yuvalarıyla bana bakan çocukların siyah beyaz fotoğrafları üst üste asılıp panoyu dev bir üçüncü sayfaya çevirmişti."


translate turkish d4_wake_up_devend_cc1dbefb:


    "Kem gözlerin zulüm gibi bakışlarına daha fazla dayanamayıp koşarak okuldan çıktım."


translate turkish d4_wake_up_devend_6339484f:


    "Ön bahçeden geçip kar tanelerinin acımasız rüzgarda savrulduğu yola fırladım."


translate turkish d4_wake_up_devend_850d519b:


    "Ortalıkta ne insan, ne araba ne de kuş vardı."


translate turkish d4_wake_up_devend_115ab510:


    "Alçalan bulutlar, bacaları teğet geçiyordu."


translate turkish d4_wake_up_devend_becdc878:


    "Pencereler mürekkeple sıvanmıştı sanki."


translate turkish d4_wake_up_devend_43e47e3b:


    "Kayıp şahısların fotoğrafları, direklerin ve çitlerin her yerini kaplamıştı ancak çocuklarla sınırlı kalmayıp yetişkinleri de aralarına katmışlardı."


translate turkish d4_wake_up_devend_b950abca:


    "Sanki köyün tüm sakinleri, \"Kayıp Şahıs\" yazılı siyah beyaz ruhlara dönüşmüştü."


translate turkish d4_wake_up_devend_9c4654ea:


    "Önümde uzanan rahmetli sokaktan ağır adımlarla geçtim."


translate turkish d4_wake_up_devend_3a25123c:


    "Rüzgar, bazı evlerin kırılan camlarından içeriye sızıp kimseye hesap vermeden dolaşıyordu."


translate turkish d4_wake_up_devend_0475d2f7:


    "Estikçe dış kapılar sallanıyordu."


translate turkish d4_wake_up_devend_86a5abb7:


    "Çitlerde asılı duran çocuk montları, kollarını kaldırıp bana uzatıyordu."


translate turkish d4_wake_up_devend_e4177609:


    "Bomboş bir köy, bomboş bir dünya."


translate turkish d4_wake_up_devend_c5409ea9:


    "Hayırdır acaba?"


translate turkish d4_wake_up_devend_a849d7c5:


    "Arka sokakta bir çöp tenekesi devrilip yuvarlandı."


translate turkish d4_wake_up_devend_29def6b7:


    "Kömüre dönmüş hâldeki bakkalın penceresinde bir şey beliriverdi."


translate turkish d4_wake_up_devend_f555d830:


    "O kapkara duvardan derhal uzaklaştım."


translate turkish d4_wake_up_devend_e464d36d:


    "Kuyudan boğuk bir gurultu yükseldi."


translate turkish d4_wake_up_devend_239747bb:


    "Ön bahçelere, kanlı köpek kulübelerine ve derme çatma barakalara çöken karanlığa olabildiğince aldırış etmeden adımlarımı hızlandırdım."


translate turkish d4_wake_up_devend_1fa3da8c:


    "Ay, bulutların ardına saklanmıştı."


translate turkish d4_wake_up_devend_82fec4c0:


    "Bu boğucu sessizlikte tepemden bir şey süzülüverdi."


translate turkish d4_wake_up_devend_774d5484:


    "Üstüme tarım uçaklarınınki gibi dev bir gölge düştü."


translate turkish d4_wake_up_devend_23e91c6a:


    "Beni görmediğini umarak sağa doğru kaçtım."


translate turkish d4_wake_up_devend_85b854b7:


    "Karşıma çıkan küçük yeşil eve sığınmaya karar verdim."


translate turkish d4_wake_up_devend_e522e3dd:


    "Korkudan deliye dönmüşçesine en yakınımdaki o eve topukladım. Orada beni kimsenin bulamayacağını düşündüm!"


translate turkish d4_wake_up_devend_a5790e6a:


    "Ancak o konutun Polina'nın evi olduğunu başta fark edemedim, halbuki duygu patlamasıyla bana burada kalmam için yalvaralı henüz birkaç saat olmuştu."


translate turkish d4_wake_up_devend_1b97b0a3:


    "Korkudan deliye dönmüşçesine en yakınımdaki o eve topukladım."


translate turkish d4_wake_up_devend_2ff418ac:


    "Bahçe kapısını araladım, çömelip evin girişine doğru sıvıştım."


translate turkish d4_wake_up_devend_09ed1aa8:


    "Kolu çektiğimde kapının açık olduğunu fark ettim."


translate turkish d4_wake_up_devend_100cb105:


    "Karanlıktan bir tekerlekli sandalye çıkıp, merdivenlerden takır tukur yuvarlanıp elma ağacının orada durdu. Az kalsın çarpışacaktık."


translate turkish d4_wake_up_devend_34e45cd9:


