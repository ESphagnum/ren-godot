translate turkish d4_setup_presets_92ede1c2:


    ""


translate turkish d4_begin_fox_56afeb5b:


    "Byaşa sırama gelip aramıza katıldı. Endişeyle alt dudağını kemiriyordu."


translate turkish d4_begin_fox_89386159:



    voice "voice/byasha/4day/158To.ogg"
    Bya "Toşik, sen o ormanın dibinde oturmuyor muydun lan?"


translate turkish d4_begin_fox_66a8d62c:



    voice "voice/byasha/4day/158 V.ogg"
    Bya "Dün hiçbir tuhaflık görmedin mi, he?"


translate turkish d4_begin_fox_e88f2dea:


    "Yalanın dibine vurdum."


translate turkish d4_begin_fox_108fdaec:



    voice "voice/anton/4day/4. N.ogg"
    Ant "I-ıh."


translate turkish d4_begin_fox_5b60843f:



    voice "voice/romka/4day/69 Ya.ogg"
    Rom "Ben de hiçbir şey görmedim."


translate turkish d4_begin_fox_99b61351:



    voice "voice/romka/4day/70 po.ogg"
    Rom "Şansıma rehberlikçi, bizimkilere notlarımdan dert yakınmış."


translate turkish d4_begin_fox_fed9ee63:



    voice "voice/romka/4day/71 Vot.ogg"
    Rom "O yüzden provaya salmamışlardı beni."


translate turkish d4_begin_fox_5bee1f04:



    voice "voice/romka/4day/72 A.ogg"
    Rom "Yoksa Katya'nın yerinde biz olurduk."


translate turkish d4_begin_fox_fe36355d:


    "Byaşa, âdemelmasını kaşıdı."


translate turkish d4_begin_fox_1e2cf5ee:



    voice "voice/byasha/4day/159 E.ogg"
    Bya "Ee... Ne diyeceğim he, beyler..."


translate turkish d4_begin_fox_7ed291bb:



    voice "voice/byasha/4day/160 Ya.ogg"
    Bya "Ben bir şey duydum."


translate turkish d4_begin_fox_f1a4703d:



    voice "voice/byasha/4day/161 E.ogg"
    Bya "Bu sabah her zamanki gibi okula geliyordum. Yolda yürürken ağaçların ardından bir çığlık kopuverdi. Kız sesiydi bu arada he."


translate turkish d4_begin_fox_af1b4cac:



    voice "voice/byasha/4day/162 Nu.ogg"
    Bya "O zaman Katya'dan daha haberim yoktu. Hem olsaydı bile korkudan yaklaşamazdım, beyler."


translate turkish d4_begin_fox_7b1cef41:



    voice "voice/byasha/4day/163 Ut.ogg"
    Bya "Burada sabah, geceyi aratmıyor. Öyle karanlık ki göz gözü görmüyor."


translate turkish d4_begin_fox_75c8247a:



    voice "voice/byasha/4day/164 v.ogg"
    Bya "O bağıran, Katya olmasın he?"


translate turkish d4_begin_fox_51142bc5:



    voice "voice/byasha/4day/165A.ogg"
    Bya "Bir de beterin beteri bir yerden, mezarlığın oradaki devrik ağaçların arasından geldi ses."


translate turkish d4_begin_fox_65793266:



    voice "voice/romka/4day/73 Hor.ogg"
    Rom "Kolpaya gel!"


translate turkish d4_begin_fox_22445305:



    voice "voice/byasha/4day/166 Da.ogg"
    Bya "Yemin ederim he! Kendi kulaklarımla duydum."


translate turkish d4_begin_fox_181669a9:



    voice "voice/anton/4day/5. A.ogg"
    Ant "Katya'nın kaybolduğundan emin misiniz yani?"


translate turkish d4_begin_fox_032bf4e4:



    voice "voice/romka/4day/74Vo.ogg"
    Rom "Baksana, annesi Liliya hoca bile derse gelmedi bugün."


translate turkish d4_begin_fox_332bff32:



    voice "voice/byasha/4day/167 S.ogg"
    Bya "Sınav iptal he."


translate turkish d4_begin_fox_b2cec123:



    voice "voice/byasha/4day/168 Ka.ogg"
    Bya "Size diyorum beyler, taygadan haykıran Katya'ydı."


translate turkish d4_begin_fox_3ad865bf:



    voice "voice/byasha/4day/169 A.ogg"
    Bya "O da seri katilin kurbanı oldu!"


translate turkish d4_begin_fox_b67c713f:


    "Katya gözümün önüne geldi. Güzel olduğu kadar kabaydı."


translate turkish d4_begin_fox_9c6ac6ac:


    "Herkesten önce olgunlaşan vücuduyla sınıftaki tüm kızları kıskandırırdı."


translate turkish d4_begin_fox_7d4cd672:


    "Dedikodu kazanının ta kendisi, yılan gibi sinsi bir kaltaktı."


translate turkish d4_begin_fox_618afe2c:


    "Byaşa parmaklarıyla saymaya başladı."


translate turkish d4_begin_fox_d9f6ea58:



    voice "voice/byasha/4day/170 Se.ogg"
    Bya "Seneçka, Vova, Semyon, Katya... Dört kişi oldu he!"


translate turkish d4_begin_fox_e2307988:


    "Roma ellerini bam diye sıraya indirdi."


translate turkish d4_begin_fox_4b6b9b2a:



    voice "voice/romka/4day/75 Ta.ogg"
    Rom "Pekala beyler. Bu saatten sonra hep tetikte geziyoruz."


translate turkish d4_begin_fox_04442c78:



    voice "voice/romka/4day/76 Da.ogg"
    Rom "O aptalca korku filmlerindeki gibi gruptan ayrılayım, demeyin sakın."


translate turkish d4_begin_fox_fc7b27a2:



    voice "voice/romka/4day/77 Na.ogg"
    Rom "Diğerleri umurumda olmaz ama siz ikiniz korumam altındasınız..."


translate turkish d4_begin_fox_89c0bd08:



    voice "voice/romka/4day/78 Kak.ogg"
    Rom "Polina da öyle."


translate turkish d4_begin_fox_f8b3341d:


    "Umarım, ilişkiniz devamına erer."


translate turkish d4_begin_fox_f87ba3e1:


    "Polina'dan hoşlandığım, aklımdan çıkmıştı bile."


translate turkish d4_begin_fox_ad1e32ed:


    "Dün geceden beri zihnimi meşgul eden tek kız Alisa'ydı."


translate turkish d4_begin_fox_f11ae9bd:


    "Bizim çocuklar kantine geçti. Ben ise sıramda bir başıma oturmuş, defterime ağaç tepeleri ile dolunayın arasında uçan iki kişi ve sıra sıra çamlar çiziyordum."


translate turkish d4_begin_fox_f6fb7f8c:


    "Gömleğimden içeriye oyun ararcasına sızan ürpertiler, omuzlarıma kadar tırmanmıştı."


translate turkish d4_begin_fox_9ae3dd81:


    "Göklerde süzülmek çok basit gelse de... Üzerimde beni aşağıya çeken musibet bir yük vardı hâlâ."


translate turkish d4_begin_fox_98a408fd:


    "Bu yük, cebimdeki mühür yüzük mü yoksa duyuru panosundaki kayıp çocukların boğucu bakışları mıydı?"


translate turkish d4_begin_fox_92e56486:


    "Suçlu, şüphesiz ki hâlâ köydeydi. Herkesin yüzüne gülüp arkalarından korkunç işler çeviriyordu."


translate turkish d4_begin_fox_0b267328:



    voice "voice/Polina/4day/134 R.ogg"
    Pol "Ne çiziyorsun?"


translate turkish d4_begin_fox_e6134f99:


    "Sanki ormanın tepesinde uçan kişilerin ayıplanacak bir hâli varmışçasına utançla defterimi örttüm."


translate turkish d4_begin_polina_1734efad:



    voice "voice/Polina/4day/Ya.ogg"
    Pol "İlk başta inanamadım ama Liliya Pavlovna bugün okula gelmemiş."


translate turkish d4_begin_polina_41d79bf7:



    voice "voice/Polina/4day/Kon.ogg"
    Pol "Yani sınav iptal."


translate turkish d4_begin_polina_b67c713f:


    "Katya gözümün önüne geldi. Güzel olduğu kadar kabaydı."


translate turkish d4_begin_polina_77575402:


    "Katya... Herkesten önce olgunlaşan vücudu ile sınıftaki tüm kızları kıskandırırdı."


translate turkish d4_begin_polina_7d4cd672:


    "Dedikodu kazanının ta kendisi, yılan gibi sinsi bir kaltaktı."


translate turkish d4_begin_polina_f6fb7f8c:


    "Gömleğimden içeriye oyun ararcasına sızan ürpertiler, omuzlarıma kadar tırmanmıştı."


translate turkish d4_begin_polina_9ae3dd81:


    "Göklerde süzülmek çok basit gelse de... Üzerimde beni aşağıya çeken musibet bir yük vardı hâlâ."


translate turkish d4_begin_polina_98a408fd:


    "Bu yük, cebimdeki mühür yüzük mü yoksa duyuru panosundaki kayıp çocukların boğucu bakışları mıydı?"


translate turkish d4_begin_polina_92e56486:


    "Suçlu, şüphesiz ki hâlâ köydeydi. Herkesin yüzüne gülüp arkalarından korkunç işler çeviriyordu."


translate turkish d4_begin_polina_c08d8baa:



    voice "voice/Polina/4day/Achto.ogg"
    Pol "Ne çiziyorsun?"


translate turkish d4_begin_polina_e6134f99:


    "Sanki ormanın tepesinde uçan kişilerin ayıplanacak bir hâli varmışçasına utançla defterimi örttüm."


translate turkish d4_polkatya_general_b8abc601:



    voice "voice/anton/4day/8. Da.ogg"
    Ant "Hiç... Rastgele bir şeyler karalıyorum."


translate turkish d4_polkatya_general_d06678e2:


    "Polina dirseklerini sıraya yasladı."


translate turkish d4_polkatya_general_67f3ec94:


    "Kendisinin kemanı anımsatan zarafeti aklımdan çıkmıştı."


translate turkish d4_polkatya_general_7573a2db:


    "Dün telefonla araştığımızda içimi basan öfkem yatışmış, çıktığı deliğe dönmüştü sanki. Polina'ya kızmaya kıyamamıştım."


translate turkish d4_polkatya_general_5633ba56:


    "Keşke o da dünyevi olduğu kadar sahte maskesinden kurtulup bizimle birlikte havalara uçabilseydi."


translate turkish d4_polkatya_general_172f08c6:


    "Yıldızların dört bir yanımızı parıltılarla donattığını, Polina'nın eteğinin rüzgarda uçuştuğunu, tüm bunların rüya olup olmadığını hayretle sorduğunu hayal ettim..."


translate turkish d4_polkatya_general_1e553341:


    "Ve içimden bunun bir öneminin olmadığını söyleyip gülümsedim."


translate turkish d4_polkatya_general_f701ab98:


    "Polina tekrar yüzünü astı."


translate turkish d4_polkatya_general_66d0b8f8:



    voice "voice/Polina/4day/134 Uze.ogg"
    Pol "Katya'dan haberin var mı?"


translate turkish d4_polkatya_general_3075cc93:



    voice "voice/anton/4day/9. Uzas.ogg"
    Ant "Yazık olmuş."


translate turkish d4_polkatya_general_2c7f0383:



    voice "voice/Polina/4day/135 Da.ogg"
    Pol "Evet."


translate turkish d4_polkatya_general_af77b4e4:



    voice "voice/Polina/4day/01 Uz.ogg"
    Pol "Ne yazık ki kendisi için üzüldüğümü söylemekte zorlanıyorum."


translate turkish d4_polkatya_general_e321a007:



    voice "voice/Polina/4day/02 Ya.ogg"
    Pol "Cidden denedim ama onun o çirkeflikleri aklıma geldikçe..."


translate turkish d4_polkatya_general_53c1f636:


    "Polina başını salladı."


translate turkish d4_polkatya_general_1ddd38e2:



    voice "voice/Polina/4day/03YaCh.ogg"
    Pol "Korkunç biriyim, değil mi?"


translate turkish d4_polkatya_general_bef1a361:


    "\"Hayır,\" dedim içimden, \"Sen tanıdığım en güzel kızlardan birisin.\""


translate turkish d4_polkatya_general_978c03be:


    "\"Hayır,\" dedim içimden, \"Sen tanıdığım en güzel kızlardan birisin ancak maalesef, şu anda benim için ikinci plandasın.\""


translate turkish d4_polkatya_general_ca23278e:


    "Bunu sesli bir şekilde söylememeye karar verdim."


translate turkish d4_polkatya_general_50d10bd5:



    voice "voice/Polina/4day/04 Plo.ogg"
    Pol "Anketimi kaybettiğime Katya'nın kayboluşundan daha fazla üzülmüş olmam hiç hoş değil."


translate turkish d4_polkatya_general_ea8d365f:


    "Burnuma şeker, reçine ve havai fişek kokusu geldi."


translate turkish d4_polkatya_general_e112d4cb:



    voice "voice/anton/4day/10. T.ogg"
    Ant "Anketini mi kaybettin?"


translate turkish d4_polkatya_general_1105aed3:



    voice "voice/Polina/4day/05da Ektoto.ogg"
    Pol "Evet. Biz konuşurken sırlarımızı kim bilir kim okuyordur."


translate turkish d4_polkatya_general_8b1cd88e:


    "\"Orman olsa gerek.\" diye düşündüm. Çarpık ağaç dallarının defter sayfalarını çevirdiğini, buzlu çıkıntılarıyla çocukça el yazılarına dokunduklarını hayal ettim."


translate turkish d4_polkatya_general_5e060315:



    voice "voice/Polina/4day/06 Na.ogg"
    Pol "Umarım bulurlar."


translate turkish d4_polkatya_general_ff825d4f:


    "Katya'dan mı defterinden mi bahsediyordu, emin olamadım."


translate turkish d4_polkatya_general_c861f3d5:


    "Bunu ona sormak istesem de Polina'nın gözlerini bana diktiğini fark ettim."


translate turkish d4_polkatya_general_2882cda2:



    voice "voice/anton/4day/11. Cht.ogg"
    Ant "Ne var?"


translate turkish d4_polkatya_general_35977029:



    voice "voice/Polina/4day/07 Ti.ogg"
    Pol "Farklı görünüyorsun."


translate turkish d4_polkatya_general_c8d3cc76:


    "Şaşkınlıkla saçımı düzleştirdim."


translate turkish d4_polkatya_general_904a0f91:



    voice "voice/anton/4day/12. Pros.ogg"
    Ant "Uykumu alamadım da..."


translate turkish d4_polkatya_general_00c6c6b0:



    voice "voice/Polina/4day/08 Se.ogg"
    Pol "Bugün ayrı telden çalıyorsun. Köklü, esrarengiz bir ezgi gibisin."


translate turkish d4_polkatya_general_6bb1fed0:


    "Gür ağaç tepelerinin arasında dolanan flüt ezgisini düşündüm."


translate turkish d4_polkatya_general_ce497e09:



    voice "voice/Polina/4day/09 Nad.ogg"
    Pol "Umarım, dünkü sohbetimizden kimselere bahsetmemişsindir."


translate turkish d4_polkatya_general_e3f1692a:



    voice "voice/anton/4day/13. Cto.ogg"
    Ant "Elbette bahsetmedim!"


translate turkish d4_polkatya_general_f796fec8:


    "Bana gözü kapalı güvenebileceğini anlamışçasına kafa salladı."


translate turkish d4_polkatya_general_7ea31629:


    "Ancak kendisinin güvenine layık mıydım, emin değildim."


translate turkish d4_polkatya_general_f029d401:



    voice "voice/Polina/4day/15 A moz.ogg"
    Pol "Okuldan sonra yürüyüşe çıkalım mı?"


translate turkish d4_polkatya_general_ae27c1e8:



    voice "voice/Polina/4day/16 Ded.ogg"
    Pol "Dedemin durumu şu aralar daha iyi. Eve normalden daha geç dönebilirim."


translate turkish d4_polkatya_general_34766af2:


    "Katmer katmer saçları, omuzlarını sarıyordu. Kokusu o kadar büyüleyiciydi ki hiçbir büyüye başvurmadan beni içimdeki kainatın parlak yıldızlarına fırlatmıştı."


translate turkish d4_school_polina_437c4a4a:


    "Tam o an Byaşa'nın gözlerini bana diktiğini fark ettim. Besbelli bizi izliyordu."


translate turkish d4_school_polina_05fee426:


    "Onun o pis sırıtışını görmemek için gözlüğümü çıkardım."


translate turkish d4_school_polina_3bb2ed56:


    "Bu sefer de Romka'nın bıçağı gözümün önüne geldi ve avuçlarım terledi."


translate turkish d4_school_polina_830e9a79:



    voice "voice/Polina/4day/10 Op.ogg"
    Pol "Yine nereye daldın?"


translate turkish d4_school_polina_312e021f:



    voice "voice/anton/4day/14. Po.ogg"
    Ant "Polina..."


translate turkish d4_school_polina_d00c2cc0:


    "İçimden bir ses \"{i}Sonucu ne olursa olsun, söyle işte.{/i}\" diye fısıldadı."


translate turkish d4_school_polina_eb867b4f:



    voice "voice/anton/4day/15. k.ogg"
    Ant "Romka senden hoşlanıyor gibime geliyor."


translate turkish d4_school_polina_a643e3f7:



    voice "voice/Polina/4day/11 Du.ogg"
    Pol "Farkında değil miyim sence?"


translate turkish d4_school_polina_7b499e9a:



    voice "voice/anton/4day/16. Ot.ogg"
    Ant "Nasıl ya?"


translate turkish d4_school_polina_e7d9f45b:



    voice "voice/Polina/4day/12 Sch.ogg"
    Pol "Bakışlarından anladım, diyelim."


translate turkish d4_school_polina_8ffc70ae:



    voice "voice/Polina/4day/13 Pya.ogg"
    Pol "Ama Pyatifanov hiç umurumda değil."


translate turkish d4_school_polina_f6c60b77:


    "Bu harika haberle öz güvenim iyice yerine gelmişti."


translate turkish d4_school_polina_95cbf125:



    voice "voice/anton/4day/17. Mn.ogg"
    Ant "Bence, senin kalbini kazanacak akıl yok onda."


translate turkish d4_school_polina_ff3d998a:


    "Polina'nın o anki gülüşü büyüleyiciydi."


translate turkish d4_school_polina_b83f8c68:



    voice "voice/Polina/4day/14Ho.ogg"
    Pol "Şükür ki sen varsın."


translate turkish d4_school_polina_af0bea69:



    voice "voice/Polina/4day/15 A.ogg"
    Pol "Okuldan sonra yürüyüşe çıkalım mı?"


translate turkish d4_school_polina_a74474dc:



    voice "voice/Polina/4day/16 De.ogg"
    Pol "Dedemin durumu şu aralar daha iyi. Eve normalden daha geç dönebilirim."


translate turkish d4_school_polina_44e3b345:


    "Verdiğim yanıtla kendi ölüm fermanımı imzaladım."


translate turkish d4_school_polina_f1afa199:



    voice "voice/anton/4day/20. Ko.ogg"
    Ant "Olur tabii!"


translate turkish d4_school_polina_4f77a0ae:



    voice "voice/Polina/4day/17 To.ogg"
    Pol "Sonra görüşürüz madem."


translate turkish d4_school_polina_4704f65d:


    "Öne doğru eğilip dikkatli bakışlarla yeniden bana baktı."


translate turkish d4_school_polina_34598843:


    "Ardından mırıldanarak tahminini dile getirdi."


translate turkish d4_school_polina_201fbf08:



    voice "voice/Polina/4day/18 Ch.ogg"
    Pol "Musorgski sanki..."


translate turkish d4_school_polina_104b473b:



    voice "voice/Polina/4day/19 Ne.ogg"
    Pol "Yok, değil ya."


translate turkish d4_school_polina_02e5a0a9:


    "Polina yanımdan ayrıldığı an Romka'nın sağ kolu, gözlerini bana dikti."


translate turkish d4_school_polina_e8887df7:


    "\"Sen öldün.\" dercesine başparmağını âdemelmasının altından yanlamasına çekti."


translate turkish d4_school_polina_9895e676:


    "Zil çaldı."


translate turkish d4_school_polina_69468793:


    "Kalan dersler de kaşla göz arasında bitti, nihayet çıkış saati gelmişti."


translate turkish d4_school_polina_ddf7ccdd:


    "Okul bahçesinde topaç gibi küçük kasırgalar dolanıyordu."


translate turkish d4_school_polina_849bc9d9:


    "Gökten lapa lapa kar yağıyordu."


translate turkish d4_school_polina_5fb46a39:


    "Sokak lambalarının giderek çöken karanlığa saçtığı ışık soğuktan kristalleşmiş, sivrilip kaskatı kesilmişti."


translate turkish d4_school_polina_99f3ab4c:


    "Uzaktan gelen bir köpek inlemesi, bana zavallı Julka'yı hatırlattı."


translate turkish d4_school_polina_1b57dfc8:


    "Rüzgar, kapının önünde dikilen Polina'nın saçlarıyla oynuyordu."


translate turkish d4_school_polina_900a755c:



    voice "voice/anton/4day/24. Ya.ogg"
    Ant "Şehrin gürültüsünü çoktan unuttum. Burası çok sakin."


translate turkish d4_school_polina_6c01c890:



    voice "voice/Polina/4day/20 O.ogg"
    Pol "Ah, ben ise şehrin kakofonisini düşlüyorum!"


translate turkish d4_school_polina_ace25c96:



    voice "voice/anton/4day/25. O.ogg"
    Ant "Kako... Ne?"


translate turkish d4_school_polina_6ac016e6:


    "Bana eşlik eden güzel kız, kahkahayı bastı."


translate turkish d4_school_polina_3fe53318:



    voice "voice/Polina/4day/21 Kak.ogg"
    Pol "Kakofoni, 'seslerin kaotik karışımı' demek oluyor."


translate turkish d4_school_polina_2d10daea:



    voice "voice/Polina/4day/22 De.ogg"
    Pol "Dedem bana her zaman her şeyde bir ezgi aramayı öğretmiştir."


translate turkish d4_school_polina_e166080a:



    voice "voice/anton/4day/26. On.ogg"
    Ant "Deden harika birine benziyor."


translate turkish d4_school_polina_b6f755d5:



    voice "voice/Polina/4day/23 Ne.ogg"
    Pol "Sahiden öyle biri! Yakında tanışırsınız."


translate turkish d4_school_polina_2ad96f91:



    voice "voice/anton/4day/27. Ti.ogg"
    Ant "Nasıl yani, size gelip de mi?"


translate turkish d4_school_polina_cfd3c3b7:



    voice "voice/Polina/4day/24 A.ogg"
    Pol "Gelmek istemez misin?"


translate turkish d4_school_polina_fc948e45:


    "Bahçenin diğer tarafından çirkin bir ıslık yükseldi."


translate turkish d4_school_polina_50fb5686:


    "Kar yığınlarının arasından iki kişi çıkıverdi. Elleri ceplerinde, başları eğikti."


translate turkish d4_school_polina_467d5147:


    "Bu bitirim ikilinin bize doğru yürüyüşü, hiç hayra alamet görünmüyordu."


translate turkish d4_school_polina_cf0d5948:



    voice "voice/romka/4day/214Anu.ogg"
    Rom "Çek lan o kızdan elini!"


translate turkish d4_school_polina_6b240421:



    voice "voice/romka/4day/215Polin.ogg"
    Rom "İyi misin Polina? Sana bir şey yaptı mı?"


translate turkish d4_school_polina_0d563bf3:



    voice "voice/byasha/4day/01 M.ogg"
    Bya "Görmedik sanma he!"


translate turkish d4_school_polina_7da1d3f6:



    voice "voice/anton/4day/64. Vid.ogg"
    Ant "Neyi gördünüz?"


translate turkish d4_school_polina_950f69c3:



    voice "voice/romka/4day/216Chto.ogg"
    Rom "Onu tıpkı Katya gibi ormana götürmek üzere olduğunu, seni psikopat!"


translate turkish d4_school_polina_05cf235d:



    voice "voice/byasha/4day/02V .ogg"
    Bya "Hızır gibi yetiştik he."


translate turkish d4_school_polina_365ab7f7:


    "Polina, anın öfkesiyle sesini kuş gibi yükseltti."


translate turkish d4_school_polina_3c42763a:



    voice "voice/Polina/4day/25 Da.ogg"
    Pol "Sizin derdiniz ne?"


translate turkish d4_school_polina_0e7859b8:



    voice "voice/romka/4day/217Ati.ogg"
    Rom "Farkında değil misin?"


translate turkish d4_school_polina_7cde9c1f:



    voice "voice/romka/4day/219Kak.ogg"
    Rom "Bu sümsük buraya taşındığından beri kaç tane çocuk kayboldu."


translate turkish d4_school_polina_e44d4252:



    voice "voice/byasha/4day/03 Ag.ogg"
    Bya "Aynen. Daha dün Katya'ya evine kadar eşlik etmeyi teklif edip onu ormana sürüklediğine kendi gözlerimle şahit oldum!"


translate turkish d4_school_polina_0e29644e:


    "Cevabı yapıştırdım."


translate turkish d4_school_polina_69d6ad23:



    voice "voice/anton/4day/Vresh.ogg"
    Ant "Yalan söylüyorsunuz! Katya'dan nefret ediyordum!"


translate turkish d4_school_polina_43dadade:



    voice "voice/romka/4day/220vot.ogg"
    Rom "O yüzden onun icabına baktın zaten."


translate turkish d4_school_polina_e19309ba:



    voice "voice/byasha/4day/04 V.ogg"
    Bya "Mantıklı değil mi, he?"


translate turkish d4_school_polina_caa5feab:


    "Yüzleştiğim adaletsizlikle afallamıştım."


translate turkish d4_school_polina_8b1bcbe6:


    "O an fark ettiğim tek olumlu şey, Romka ile Byaşa'nın berbat oyuncular olduğu gerçeğiydi. Yalanlarını on üzerinden puanlayacak olsaydım en fazla beş verirdim."


translate turkish d4_school_polina_431f22b7:



    voice "voice/romka/4day/221pov.ogg"
    Rom "Jandarmayla işimiz olmadığına dua et."


translate turkish d4_school_polina_ce89a875:



    voice "voice/romka/4day/222ato.ogg"
    Rom "Yoksa seni cinayetten ihbar etmesini bilirdik."


translate turkish d4_school_polina_5bf84e18:



    voice "voice/byasha/4day/05 N.ogg"
    Bya "Rahat ol! Ciddi bir şey konuşacağız sadece he."


translate turkish d4_school_polina_d159990e:



    voice "voice/byasha/4day/06 D.ogg"
    Bya "Tut şunu!"


translate turkish d4_school_polina_8b4df86c:


    "Romka sırıtarak bana yaklaştı."


translate turkish d4_school_polina_14cc36af:



    voice "voice/romka/4day/223zna.ogg"
    Rom "Demek Katya'yı çekemiyordun, he?"


translate turkish d4_school_polina_2b895c92:



    voice "voice/romka/4day/224kone.ogg"
    Rom "Çok belli! Bu kötülüğü senden başka kim yapabilirdi ki?"


translate turkish d4_school_polina_2bf07094:



    voice "voice/Polina/4day/26 Ti.ogg"
    Pol "Sen de yapabilirdin."


translate turkish d4_school_polina_d199fc7e:


    "Polina'ya hayretler içerisinde baktım."


translate turkish d4_school_polina_340f12aa:


    "Romka yumruğunu kaldırdığı gibi donakalmıştı."


translate turkish d4_school_polina_5bdde07e:



    voice "voice/romka/4day/225vsm.ogg"
    Rom "N-nasıl yani?"


translate turkish d4_school_polina_b62141db:



    voice "voice/Polina/4day/27 Ka.ogg"
    Pol "Eğri oturup doğru konuşalım, Katya kimseden haz etmezdi ki."


translate turkish d4_school_polina_b0d3b6ff:



    voice "voice/Polina/4day/28 Du.ogg"
    Pol "Elini kalbine koy da söyle Roma, Katya'nın senin arkandan hiç konuşmadığını mı sanıyorsun?"


translate turkish d4_school_polina_a129432f:



    voice "voice/Polina/4day/29 Chto.ogg"
    Pol "Babanın hapis yattığını veya sürekli seni dövdüğünü dillendirmediğini sana düşündüren ne?"


translate turkish d4_school_polina_e59d3087:


    "Romka kıpkırmızı olmuş, dudakları sudan çıkmış balık gibi titriyordu."


translate turkish d4_school_polina_ef5000fb:


    "Polina öfkeli bir ses tonuyla devam etti:"


translate turkish d4_school_polina_56580e49:



    voice "voice/Polina/4day/30 A.ogg"
    Pol "Peki ya sen, Byaşa, dün akşam neredeydin?"


translate turkish d4_school_polina_6cab9eb0:



    voice "voice/Polina/4day/31 Ka.ogg"
    Pol "Katya, senin Kara Garaj'la karşılaştığından beri keçileri kaçırdığını söylüyordu."


translate turkish d4_school_polina_0b5bebef:


    "Byaşa geri çekildi, kapüşonunun altından beti benzi attığı çok belliydi."


translate turkish d4_school_polina_235ab399:



    voice "voice/Polina/4day/32 Ta.ogg"
    Pol "Belki de Katya'yı kaçıran o psikopat sensindir."


translate turkish d4_school_polina_e518880d:



    voice "voice/byasha/4day/07 N.ogg"
    Bya "Hayır!"


translate turkish d4_school_polina_49d52c08:


    "Byaşa az kalsın cıyaklayacaktı."


translate turkish d4_school_polina_5a96b0bf:


    "Sonra arkasını dönüp bahçe kapısına doğru sallana sallana ilerledi."


translate turkish d4_school_polina_aac15a5d:


    "\"Yuh,\" dedim kendi kendime, \"Byaşa'yı cebinden çıkardı kız.\""


translate turkish d4_school_polina_9b74f614:



    voice "voice/Polina/4day/33 Ch.ogg"
    Pol "Ee, konuş bakalım, çakma Romeo."


translate turkish d4_school_polina_dd8c0e39:



    voice "voice/Polina/4day/34 Ka.ogg"
    Pol "Daha nasıl çirkin yalanlar söyleyip de beni şaşırtacaksın acaba, hı?"


translate turkish d4_school_polina_e4c64c5a:


    "Cesareti epey kırılan Roma yutkundu."


translate turkish d4_school_polina_8ede217e:



    voice "voice/Polina/4day/35 Ci.ogg"
    Pol "Saçmaladın iyice! Kahramancılık mı oynayacağın tuttu?"


translate turkish d4_school_polina_dc534fec:



    voice "voice/Polina/4day/36 To.ogg"
    Pol "Böyle kahraman olunmaz."


translate turkish d4_school_polina_b3f76082:



    voice "voice/Polina/4day/37 E.ogg"
    Pol "Dahası, senden oyuncu falan da olmaz Roma."


translate turkish d4_school_polina_1bb9094c:



    voice "voice/romka/4day/227da.ogg"
    Rom "Beni dinle, bu dört göz..."


translate turkish d4_school_polina_fc04b1f0:



    voice "voice/Polina/4day/38 V.ogg"
    Pol "Sana bin basar."


translate turkish d4_school_polina_c66c9d6e:


    "Bu lafının ardından akıllara zarar bir şey yapıp elimi tuttu."


translate turkish d4_school_polina_646f6536:



    voice "voice/Polina/4day/39 Po.ogg"
    Pol "Hadi Anton."


translate turkish d4_school_polina_0a490a06:


    "Buz kesilen Romka'nın yanından uzaklaştık."


translate turkish d4_school_polina_6cb1ffdf:


    "Kendisine biraz üzülsem de mutluluğumun haddi hesabı yoktu."


translate turkish d4_school_polina_7dac920b:


    "Bizi durdurmamıştı."


translate turkish d4_school_polina_cfcc1f6a:


    "Öylece dikilmiş, giderek şiddetlenen tipiye bakakalmıştı."


translate turkish d4_school_polina_8d971e58:


    "Bahçeden çıktığımızda zıplayıp haykırdım:"


translate turkish d4_school_polina_8adc0949:



    voice "voice/anton/4day/66. Kak.ogg"
    Ant "Sen neymişsin ya!"


translate turkish d4_school_polina_7e0ba999:


    "Polina mahcubiyetle gülümsedi."


translate turkish d4_school_polina_1e37b43d:



    voice "voice/Polina/4day/40 Nu.ogg"
    Pol "Dedem hep der ki 'Kurtlarla yaşarsan, ulumayı öğrenirsin.'"


translate turkish d4_school_polina_b7ed3c77:



    voice "voice/anton/4day/67. On.ogg"
    Ant "Deden de filozof gibi adammış."


translate turkish d4_school_polina_f4f3acb2:



    voice "voice/Polina/4day/41 Kra.ogg"
    Pol "Kendisi aslında etnograf... Eskiden öyleydi yani."


translate turkish d4_school_polina_45fd9bdd:



    voice "voice/Polina/4day/42 On.ogg"
    Pol "Emekli olalı epey oldu, bu aralar da sağlığı hiç yerinde değil."


translate turkish d4_school_polina_95d658dc:


    "Anlayışla kafa salladım."


translate turkish d4_school_polina_205cf682:


    "Polina'ya kaçamak bakışlar atıyordum."


translate turkish d4_school_polina_3b4ac06b:


    "Her bir yüzü parıldayan, ışık saçan, güzelliğinden kolay kolay ödün vermeyen kıymetli bir mücevher gibiydi."


translate turkish d4_school_polina_a846539f:


    "Masumca gülen gözleri \"Ne var?\" diye sordu."


translate turkish d4_school_polina_51ca9cfd:


    "Ağzımı bile açmadan \"Hiç!\" dedim."


translate turkish d4_school_polina_cad25acd:



    voice "voice/Polina/4day/43 Ti.ogg"
    Pol "Cesursun. Bu hoş bir şey."


translate turkish d4_school_polina_bc6e6aa2:



    voice "voice/anton/4day/68. Hr.ogg"
    Ant "Cesur mu? Ağzımı bile açamadan öylece durdum ama..."


translate turkish d4_school_polina_9e1a9bd7:



    voice "voice/Polina/4day/44 No.ogg"
    Pol "Evet ama kaçmadın!"


translate turkish d4_school_polina_62955535:



    voice "voice/Polina/4day/45 Ya.ogg"
    Pol "Romka'ya karşılık verecek cesareti bulman beni hâlâ şaşırtıyor ki Baburin'e yumruk atmandan bahsetmiyorum bile."


translate turkish d4_school_polina_59c5120f:


    Ant "Senin için çok şeyi göze alırım."


translate turkish d4_school_polina_8d06aef6:



    voice "voice/Polina/4day/46 Vot.ogg"
    Pol "Bak, sana demiştim!"


translate turkish d4_school_polina_2dc6f19e:



    voice "voice/Polina/4day/47 Ez.ogg"
    Pol "Sanki bir romandan fırlamış gibi konuştun."


translate turkish d4_school_polina_e481f1c0:



    voice "voice/Polina/4day/48 Ra.ogg"
    Pol "{i}Hepsi senin için, leydim!{/i}"


translate turkish d4_school_polina_279d72d0:


    "Polina kikirdemeye başladı."


translate turkish d4_school_polina_b665ff3b:


    "Yalancıktan surat assam da nihayetinde kendimi gülümsemekten alıkoyamadım."


translate turkish d4_school_solo_ee88ab6e:


    "Byaşa, yırtık dondan fırlar gibi üzerime atılıp kulağımın dibinde bağırdı."


translate turkish d4_school_solo_a6271feb:



    voice "voice/byasha/4day/171 Op.ogg"
    Bya "Hoppala!"


translate turkish d4_school_solo_d655e8d6:



    voice "voice/byasha/4day/172 Ach.ogg"
    Bya "Siz çifte kumrular neyin peşindesiniz, he?"


translate turkish d4_school_solo_247c070b:



    voice "voice/romka/4day/247ti.ogg"
    Rom "Polina'ya sarkıntılık mı ediyorsun lan dört göz?"


translate turkish d4_school_solo_dfe0584b:


    "Yardım istememiş olsam da Polina imdadıma yetişti."


translate turkish d4_school_solo_6f7a849b:


    "Belki de yardıma muhtaç gibi bir hâlim olduğundandır."


translate turkish d4_school_solo_4b262130:



    voice "voice/Polina/4day/174 Ch.ogg"
    Pol "Ne saçmalıyorsunuz ya? Arkadaşız biz."


translate turkish d4_school_solo_e2a9668a:



    voice "voice/romka/4day/248Tvo.ogg"
    Rom "Bu ibneden olsa olsa kız arkadaş olur. Birlikte elbise bakmaya da çıkıyor musunuz?"


translate turkish d4_school_solo_391eb38a:



    voice "voice/Polina/4day/175 N.ogg"
    Pol "İbne falan değil o! Petrov'u rahat bırakın!"


translate turkish d4_school_solo_9914cf4c:


    "Bir şey yapmam gerekirken sıraya sımsıkı tutunmuş, yerimden bile kalkamamıştım."


translate turkish d4_school_solo_40db0068:


    "Romka alay edercesine burnunu çekti."


translate turkish d4_school_solo_b0144e58:



    voice "voice/romka/4day/249baba.ogg"
    Rom "Şimdilik seni salıyorum ama yanındaki kıza dua et... Ucube."


translate turkish d4_school_solo_5bb0e652:


    "Düşmanlarım, sınıfı çirkin kahkahalarla terk etti."


translate turkish d4_school_solo_ab823c9a:


    "Polina ise buruk bir gülümsemeyle beni teselli etti."


translate turkish d4_school_solo_ba6faf82:



    voice "voice/Polina/4day/176 Bu.ogg"
    Pol "Güçlü ol."


translate turkish d4_school_solo_823fc34f:


    "\"Olamıyorum!\" diye bağırmak istemiştim."


translate turkish d4_school_solo_c97ac007:


    "Güçlü olup bu şerefsizlere karşı gelemezdim."


translate turkish d4_school_solo_f6460411:


    "Ne kendimi savunabilirdim ne de başkasını."


translate turkish d4_school_solo_bbbfc7b1:


    "Zavallının tekiydim."


translate turkish d4_school_solo_998b2133:


    "Ormana kaçıp kendimi karların arasına gömmek istiyordum; eve dönüp, yorganımın altına saklanıp herkesten uzaklaşmayı diliyordum."


translate turkish d4_school_solo_a509a28d:


    "Polina yanımdan ayrıldığı gibi, ruhuma zulmeden düşünceler yüzünden ağlamaya başladım."


translate turkish d4_school_solo_a20cefa7:


    "..."


translate turkish d4_school_solo_1baf3423:


    "Polina'yla konuşma küstahlığına cüret ettiğimden bu sefer de Romka'nın öfkesine denk gelmemek için okuldan geç çıkmıştım."


translate turkish d4_school_solo_0f1cb53e:


    "Alaca karanlıkta ağır adımlarla evin yolunu tuttum."


translate turkish d4_school_solo_0cecea13:


    "Sıkılmış bir hademe asfaltı kürüyor, liseliler de sigara içip ağızlarından çizgi romanlardaki konuşma balonlarına benzer dumanlar çıkarıyordu."


translate turkish d4_school_solo_280f1d8a:


    "O balonları samimi sözlerle doldurmak isterdim ancak soğuk bakışları samimiyetten tümüyle uzaktı."


translate turkish d4_school_solo_06c0fb9c:


    "Bayat poğaçaların ve çirkin hakaretlerin tatsız dünyasını terk ediyordum."


translate turkish d4_school_solo_ed0ddb1c:


    "Merdivenlerin orada birisi bana omuz attı. Anneleri babaları, bunları hiç mi terbiye etmemiş?"


translate turkish d4_school_solo_8fa9895d:


    "Köyden çıkıp köprüye yaklaştığımda hızımı düşürdüm. Tilki dostumu görmek umuduyla kafamı çevirsem de ne onu ne de diğer yeni dostlarımı ortalıkta görebildim."


translate turkish d4_school_solo_9515f3cf:


    "Orman, sessizce pusuya yatmış bir yırtıcı gibi karşımda bitiverdi."


translate turkish d4_school_solo_a335325d:


    "Aralıklı tek gözüyle hâlâ beni izliyordu. Sırt çantamın kuşaklarını sımsıkı tutup dört gözümü de yerden ayırmadan ormanın içinden geçtim."


translate turkish d4_school_solo_e9ec62f5:



    voice "voice/Child/4day/Katya.ogg"
    Noname "Kaaatya! Kaaatya!"


translate turkish d4_school_solo_9234e4ad:


    "Yine kapkara gölgeler, yapraksız ağaçların arasında bir görünüp kayboluyor, muhtemelen çoktan ölmüş bir kızın adını durmadan haykırıyordu."


translate turkish d4_school_solo_826e93a6:


    "Çamların tepesindeki güneş, en kısıkta açılan ocak ateşi gibi sönükçe batıyordu."


translate turkish d4_school_solo_d72c52f5:


    "Boynumu kısıp çarpık ağaçlara olabildiğince aldırış etmeden ilerledim."


translate turkish d4_school_fox_betray_597d1f5b:



    voice "voice/anton/4day/18. K.ogg"
    Ant "Elbette."


translate turkish d4_school_fox_betray_65ef2e91:



    voice "voice/anton/4day/19. To.ogg"
    Ant "Yalnız arka kapıdan çıkalım, spor salonunun oradan."


translate turkish d4_school_fox_betray_3e950ccb:



    voice "voice/Polina/4day/136 Pr.ogg"
    Pol "Birinden mi kaçınıyorsun?"


translate turkish d4_school_fox_betray_ecb2db4a:


    "Bakışlarımı sırama indirdim."


translate turkish d4_school_fox_betray_da606b95:


    "Dostlarım beni yalnız bırakarak onlara ihanet edebileceğim apaçık bir fırsat vermişti."


translate turkish d4_school_fox_betray_988a26fa:


    "Vicdan azabı, minik dişlerini yüreğime geçiriverdi."


translate turkish d4_school_fox_betray_562cbe33:



    voice "voice/Polina/4day/137 Tak.ogg"
    Pol "Romka yüzünden mi?"


translate turkish d4_school_fox_betray_39a4a75a:



    voice "voice/Polina/4day/138 Ne.ogg"
    Pol "Bilmemesini mi istiyorsun?"


translate turkish d4_school_fox_betray_eb29b71a:



    voice "voice/anton/4day/21. T.ogg"
    Ant "Senden hoşlanıyor."


translate turkish d4_school_fox_betray_13d3f97b:



    voice "voice/Polina/4day/139 Slo.ogg"
    Pol "Orası her hâlinden belli."


translate turkish d4_school_fox_betray_c01227dd:



    voice "voice/Polina/4day/140 No.ogg"
    Pol "Gel gör ki siz erkekler, işin en önemli kısmını hep unutuyorsunuz: Önce kıza açılmanız gerek."


translate turkish d4_school_fox_betray_3ad7cbcf:



    voice "voice/Polina/4day/141 Ade.ogg"
    Pol "Açılmadan 'Okuldan sonra, arka çıkışın orada.' lafını duyamazsınız."


translate turkish d4_school_fox_betray_3e728777:


    "Gönül rahatlığıyla gülümsedim."


translate turkish d4_school_fox_betray_b4c675dd:


    "Romka sınıfa dönüp göz kırparak bana yaban mersinli çörek attığında vicdan azabım, yüreğimi yiyip bitirmek üzere varlığını tekrar belli etti."


translate turkish d4_school_fox_betray_c475be34:



    voice "voice/romka/4day/Esh.ogg"
    Rom "Aç ayı oynamaz, ye bakayım!"


translate turkish d4_school_fox_betray_22817979:


    "Gerçi kötü adamı oynaması gereken ben, oyunu ekmiştim."


translate turkish d4_school_fox_betray_6a623c02:


    "Cebir dersinin bitmesine daha yirmi dakika varken okuldan çıktım. Öğretmene dişimin ağrıdığına dair yalan söylemiştim."


translate turkish d4_school_fox_betray_a7dfd1e1:


    "Okulun yakınındaki bir çalıya suçlular gibi saklandım."


translate turkish d4_school_fox_betray_4736b656:


    "Çok geçmeden Polina geldi."


translate turkish d4_school_fox_betray_3cd74bee:



    voice "voice/anton/4day/22. Ei.ogg"
    Ant "Hişt, buradayım!"


translate turkish d4_school_fox_betray_08190bd9:



    voice "voice/Polina/4day/142 Tib.ogg"
    Pol "Madem bu kadar saklanman gerekiyordu, kendini karların arasına gömüverseydin."


translate turkish d4_school_fox_betray_1aacb29a:


    "Romka'nın desteğinden olmadan, gizliden gizliye Polina'nın kalbini kazanmak için iki tarafı da idare etmeye çalıştığımı fark etmiştim."


translate turkish d4_school_fox_betray_d128cee2:


    "Birinden biri, planımın farkına varırsa ne olacak?"


translate turkish d4_school_fox_betray_0850d2bd:



    voice "voice/anton/4day/23. Poi.ogg"
    Ant "Hadi bakalım."


translate turkish d4_school_fox_betray_d0b5bff9:



    voice "voice/Polina/4day/143 Nu.ogg"
    Pol "Hadi."


translate turkish d4_school_fox_betray_8212b122:


    "Okulun futbol sahası boyunca yürümeye koyulduk."


translate turkish d4_school_fox_betray_412703b6:


    "Güneş göz alıcı olsa da topraktaki buzların kırılmasına yetmiyordu."


translate turkish d4_school_fox_betray_26d5aba2:


    "Alaca karanlık, saklandığı ağaçlıktan çıkıp köyün üzerine kabus gibi çökeceği ânı telaşla bekliyordu."


translate turkish d4_school_fox_betray_900a755c:



    voice "voice/anton/4day/24. Ya.ogg"
    Ant "Şehrin gürültüsünü çoktan unuttum. Burası çok sakin."


translate turkish d4_school_fox_betray_6c01c890:



    voice "voice/Polina/4day/20 O.ogg"
    Pol "Ah, ben ise şehrin kakofonisini düşlüyorum!"


translate turkish d4_school_fox_betray_ace25c96:



    voice "voice/anton/4day/25. O.ogg"
    Ant "Kako... Ne?"


translate turkish d4_school_fox_betray_6ac016e6:


    "Bana eşlik eden güzel kız, kahkahayı bastı."


translate turkish d4_school_fox_betray_3fe53318:



    voice "voice/Polina/4day/21 Kak.ogg"
    Pol "Kakofoni, 'seslerin kaotik karışımı' demek oluyor."


translate turkish d4_school_fox_betray_2d10daea:



    voice "voice/Polina/4day/22 De.ogg"
    Pol "Dedem bana her zaman her şeyde bir ezgi aramayı öğretmiştir."


translate turkish d4_school_fox_betray_b7ed3c77:



    voice "voice/anton/4day/67. On.ogg"
    Ant "Deden de filozof gibi adammış."


translate turkish d4_school_fox_betray_f4f3acb2:



    voice "voice/Polina/4day/41 Kra.ogg"
    Pol "Kendisi aslında etnograf... Eskiden öyleydi yani."


translate turkish d4_school_fox_betray_e166080a:



    voice "voice/anton/4day/26. On.ogg"
    Ant "Deden harika birine benziyor."


translate turkish d4_school_fox_betray_b6f755d5:



    voice "voice/Polina/4day/23 Ne.ogg"
    Pol "Sahiden öyle biri! Yakında tanışırsınız."


translate turkish d4_school_fox_betray_2ad96f91:



    voice "voice/anton/4day/27. Ti.ogg"
    Ant "Nasıl yani, size gelip de mi?"


translate turkish d4_school_fox_betray_cfd3c3b7:



    voice "voice/Polina/4day/24 A.ogg"
    Pol "Gelmek istemez misin?"


translate turkish d4_school_fox_betray_4259214e:



    voice "voice/anton/4day/28. Net.ogg"
    Ant "Hayır! Yani elbette isterim!"


translate turkish d4_school_fox_betray_205cf682:


    "Polina'ya kaçamak bakışlar atıyordum."


translate turkish d4_school_fox_betray_3b4ac06b:


    "Her bir yüzü parıldayan, ışık saçan, güzelliğinden kolay kolay ödün vermeyen kıymetli bir mücevher gibiydi."


translate turkish d4_school_fox_betray_a846539f:


    "Masumca gülen gözleri \"Ne var?\" diye sordu."


translate turkish d4_school_fox_betray_51ca9cfd:


    "Ağzımı bile açmadan \"Hiç!\" dedim."


translate turkish d4_school_fox_betray_fa9b9a35:



    voice "voice/Polina/4day/TiS.ogg"
    Pol "Cesursun, ne hoş."


translate turkish d4_school_fox_betray_9db9a5b0:



    voice "voice/anton/4day/Smel.ogg"
    Ant "Ben mi cesurum?"


translate turkish d4_school_fox_betray_b3b62f5a:



    voice "voice/Polina/4day/144 Ya.ogg"
    Pol "Baburin'e karşı koyuşun dün gibi aklımda!"


translate turkish d4_school_fox_betray_3c87ae3d:



    voice "voice/anton/4day/30. Pu.ogg"
    Ant "Önemli bir şey değildi."


translate turkish d4_school_fox_betray_b7316e92:



    voice "voice/Polina/4day/145 Zna.ogg"
    Pol "Hiç öyle deme, kızların kendini güvende hissetmesi çok önemli bir şey!"


translate turkish d4_school_fox_betray_e6c73e99:



    voice "voice/anton/4day/31. Za.ogg"
    Ant "Seni korumak benim için şereftir."


translate turkish d4_school_fox_betray_bc9bf51a:



    voice "voice/Polina/4day/146 Vot.ogg"
    Pol "Bak, sana demiştim!"


translate turkish d4_school_fox_betray_1257c57d:



    voice "voice/Polina/4day/147 Ez.ogg"
    Pol "Sanki bir romandan fırlamış gibi konuştun."


translate turkish d4_school_fox_betray_e5c0c899:



    voice "voice/Polina/4day/148 Eto.ogg"
    Pol "Benim için şereftir, leydim!"


translate turkish d4_school_fox_betray_279d72d0:


    "Polina kikirdemeye başladı."


translate turkish d4_school_fox_betray_b665ff3b:


    "Yalancıktan surat assam da nihayetinde kendimi gülümsemekten alıkoyamadım."


translate turkish d4_school_fox_voltron_67590f4d:



    voice "voice/anton/4day/33. Poch.ogg"
    Ant "Neden olmasın... Anlaştık."


translate turkish d4_school_fox_voltron_f8a1f690:



    voice "voice/Polina/4day/149 Togda.ogg"
    Pol "O zaman cebirden sonra arka bahçede görüşürüz."


translate turkish d4_school_fox_voltron_4704f65d:


    "Öne doğru eğilip dikkatli bakışlarla yeniden bana baktı."


translate turkish d4_school_fox_voltron_34598843:


    "Ardından mırıldanarak tahminini dile getirdi."


translate turkish d4_school_fox_voltron_201fbf08:



    voice "voice/Polina/4day/18 Ch.ogg"
    Pol "Musorgski sanki..."


translate turkish d4_school_fox_voltron_104b473b:



    voice "voice/Polina/4day/19 Ne.ogg"
    Pol "Yok, değil ya."


translate turkish d4_school_fox_voltron_6bf60af3:


    "Sınıftan çıkan Polina'nın boşluğunu doldurmak üzere kapıda Romka belirdi. Yanımdaki sıraya çöreklenip kulağıma fısıldadı."


translate turkish d4_school_fox_voltron_ee43f8ff:



    voice "voice/romka/4day/79 Ti.ogg"
    Rom "Polina'yla konuştun mu?"


translate turkish d4_school_fox_voltron_7f3767b1:


    "Roma, yanımıza gelen Byaşa'yı pis bir bakışla durdurdu."


translate turkish d4_school_fox_voltron_aca3f6e3:



    voice "voice/romka/4day/80 Bya.ogg"
    Rom "Byaşa, az ötede dur."


translate turkish d4_school_fox_voltron_b6c681d8:


    "Byaşa hüsranla dudak büzüp sınıfı terk etti."


translate turkish d4_school_fox_voltron_9c12a822:


    "Roma dikkatini yeniden bana çevirdi."


translate turkish d4_school_fox_voltron_e90a36f1:



    voice "voice/romka/4day/81 Nu.ogg"
    Rom "Ee? Konuştun mu?"


translate turkish d4_school_fox_voltron_dd5a53eb:



    voice "voice/romka/4day/82 Ona.ogg"
    Rom "Benden bahsetti mi?"


translate turkish d4_school_fox_voltron_a156606b:


    "Yüzümde beliren acı tebessüme engel olamadım."


translate turkish d4_school_fox_voltron_dc72f573:


    "Voltran Takımı'nın lideri Romka sırılsıklam aşık olmuştu!"


translate turkish d4_school_fox_voltron_fd5f74b1:


    "Bakışları umut, temenni ve endişe doluydu."


translate turkish d4_school_fox_voltron_1b3d80b0:


    "Sporu, serseriliği ve soğukluğu dünyaya karşı kalkan edinmiş, saf mı saf bir çocuk gibiydi."


translate turkish d4_school_fox_voltron_7c9864d3:


    "Böylesine zayıf bir anında ona ihanet edebilir miydim ki?"


translate turkish d4_school_fox_voltron_86355496:


    "Hiçbir şeyin yolunda gitmediği böyle bir durumda doğru kararı verebilir miydim?"


translate turkish d4_school_fox_voltron_bf91bec6:


    "Konuşmadan önce yalancıktan öksürdüm."


translate turkish d4_school_fox_voltron_bb5a383f:



    voice "voice/anton/4day/35. Ona.ogg"
    Ant "Okuldan sonra nerede olacağını sordu."


translate turkish d4_school_fox_voltron_628b18c1:


    "O an yüzünün aldığı ifade, bu yalanımı meşru kılmıştı. Romka'nın ağzı kulaklarına vardı."


translate turkish d4_school_fox_voltron_9fff7b06:



    voice "voice/romka/4day/83 A.ogg"
    Rom "Sen ne dedin peki?"


translate turkish d4_school_fox_voltron_d6a51a75:



    voice "voice/anton/4day/36. Sk.ogg"
    Ant "Arka bahçede olacağını söyledim."


translate turkish d4_school_fox_voltron_e6058462:


    "Romka heyecanla dudaklarını yaladı. Bileğime öyle sıkıca yapıştı ki kıracağını sandım."


translate turkish d4_school_fox_voltron_4f3f3bbf:



    voice "voice/romka/4day/85 Nut.ogg"
    Rom "Sağ ol Toha! Adamın dibisin!"


translate turkish d4_school_fox_voltron_37693a38:



    voice "voice/romka/4day/86 Po.ogg"
    Rom "Hazırlanalım madem!"


translate turkish d4_school_fox_voltron_35adf81b:



    voice "voice/romka/4day/87 Sh.ogg"
    Rom "Onu, unutamayacağı bir gösteri bekliyor!"


translate turkish d4_school_fox_voltron_24a9d506:


    "Suratsız Byaşa'ya katılmak üzere sınıftan ayrıldı, ben ise bir başıma Polina'nın boş sırasına bakakaldım."


translate turkish d4_school_fox_voltron_f57464f1:


    "Dostlardan dost beğenmem gerekmişti."


translate turkish d4_school_fox_voltron_b13023a3:


    "Umarım doğru seçimi yapmışımdır."


translate turkish d4_school_fox_voltron_a5037b9d:


    "Zil sesi, okulun en karanlık köşelerine bile sızan başıboş bir yankıyla kendisini duyurdu."


translate turkish d4_school_fox_voltron_bf5dff60:


    "Montumun fermuarını sonuna kadar çekmeye vakit bile bulamadan aceleyle bahçeye fırladım."


translate turkish d4_school_fox_voltron_b3fd8890:


    "Hava durumu sunucusu, yaklaşan tipi konusunda yalan söylememişti."


translate turkish d4_school_fox_voltron_a71b184e:


    "Kuzeyden gelen kasvetli buluttan kudretli bir gürültü kopuverdi."


translate turkish d4_school_fox_voltron_e7a699e3:


    "Bazı çocuklar buz pistinde sırtını rüzgara vermiş, rüzgar ittirdikçe kahkahalar atıyorlardı."


translate turkish d4_school_fox_voltron_472e8069:


    "Tipi, yükselen kahkahaları mor renkli bilinmezliğe sürüklüyordu."


translate turkish d4_school_fox_voltron_8dd5c0ea:


    "Romka, okulun genelde ıssız olan küçük arka bahçesinde beni görünce yanıma telaşla geldi."


translate turkish d4_school_fox_voltron_508fed88:



    voice "voice/romka/4day/88 G.ogg"
    Rom "Hazır mısın? Yan çizmeyeceksin bak, değil mi?"


translate turkish d4_school_fox_voltron_712ea98f:



    voice "voice/romka/4day/89 V.ogg"
    Rom "Bu tek fırsatımız olabilir."


translate turkish d4_school_fox_voltron_7bfba25a:


    "Hazır değildim, hem de hiç."


translate turkish d4_school_fox_voltron_1a42f2b0:


    "Mideme saplanan ağrı, daha en başından başarısızlığa mahkum olan bu aptalca fikirden cayıp orayı terk etmemi istiyordu."


translate turkish d4_school_fox_voltron_efd9a963:


    "Ancak prensip gereği, Romka'yı yarı yolda bırakamazdım."


translate turkish d4_school_fox_voltron_2606b440:


    "Bu esnada kendisi, mürekkep lekeli parmaklarıyla hızlı bir sayım yapıyordu."


translate turkish d4_school_fox_voltron_40b5c4ac:



    voice "voice/romka/4day/90 B.ogg"
    Rom "Buket tamam."


translate turkish d4_school_fox_voltron_8443ae50:



    voice "voice/romka/4day/91 M.ogg"
    Rom "Sapık da burada."


translate turkish d4_school_fox_voltron_819ea8a3:



    voice "voice/romka/4day/92 Ch.ogg"
    Rom "Başka bir şey lazım mıydı?"


translate turkish d4_school_fox_voltron_cc90f4d6:



    voice "voice/anton/4day/37.A.ogg"
    Ant "Kostümüme ne oldu?"


translate turkish d4_school_fox_voltron_2be82097:



    voice "voice/anton/4day/37.Gde.ogg"
    Ant "Hani konuşmuştuk ya, balta olur..."


translate turkish d4_school_fox_voltron_ccd9a42e:



    voice "voice/anton/4day/37.M.ogg"
    Ant "Maske olur."


translate turkish d4_school_fox_voltron_2be3e561:



    voice "voice/romka/4day/93 Da.ogg"
    Rom "Eh be Toha!"


translate turkish d4_school_fox_voltron_c7288153:



    voice "voice/romka/4day/94 Na.ogg"
    Rom "Yanından ayırmadığın şu tavşan maskesini takıver işte."


translate turkish d4_school_fox_voltron_18c5e83b:



    voice "voice/romka/4day/95 To.ogg"
    Rom "Acele et! Polina bizi birlikte görmesin."


translate turkish d4_school_fox_voltron_8a20785a:


    "Romka'ya şüpheyle baksam da elimi çoktan çantama atmış, fermuarı beklentiyle çekiştiriyordum."


translate turkish d4_school_fox_voltron_7ecade9d:


    "\"Gerçek yüzümü\" çantamdan çıkardığımda şaşıracağım yerde rahatlamıştım."


translate turkish d4_school_fox_voltron_659411f8:


    "Maske bana huzur vermiş, midemdeki ağrıyı dindirmişti."


translate turkish d4_school_fox_voltron_2c529c82:


    "Birden tüy kadar hafif olmanın, uçmanın ve neşenin nasıl bir his olduğunu hatırlayıverdim."


translate turkish d4_school_fox_voltron_3d865891:


    "O an Romka'nın sorunları pek sıkıcı ve önemsiz gelmişti."


translate turkish d4_school_fox_voltron_24ee1bf9:



    voice "voice/romka/4day/96 Da.ogg"
    Rom "Prova ettiğimiz gibi yapalım."


translate turkish d4_school_fox_voltron_517b6e3b:



    voice "voice/romka/4day/97 To.ogg"
    Rom "Kızı gördüğün an..."


translate turkish d4_school_fox_voltron_ca936995:



    voice "voice/anton/4day/38. Ya.ogg"
    Ant "Yolunu keseceğim."


translate turkish d4_school_fox_voltron_bbeded7f:



    voice "voice/romka/4day/98 A.ogg"
    Rom "Aynen, ben de çalıdan bam diye fırlayıp onu kurtaracağım!"


translate turkish d4_school_fox_voltron_b5e278e1:



    voice "voice/romka/4day/99 T.ogg"
    Rom "Elini korkak alıştırma, Toşik."


translate turkish d4_school_fox_voltron_a3d94a44:



    voice "voice/romka/4day/100 Ch.ogg"
    Rom "Gerçeğini aratmasın yani."


translate turkish d4_school_fox_voltron_3e83d28c:



    voice "voice/anton/4day/39. Y.ogg"
    Ant "Elimden geleni yaparım."


translate turkish d4_school_fox_voltron_10007d87:


    "Bu kürklü karton parçası, tipinin gazabına kafa tutabilecek kadar enerji doluydu."


translate turkish d4_school_fox_voltron_18b14bd2:


    "Gerçek yüzümü gözlüğümün üzerine neşeyle taktım."


translate turkish d4_school_fox_voltron_d8825a98:


    "Maskenin deliklerini gözlerime denk getirecek şekilde düzelttim."


translate turkish d4_school_fox_voltron_78e21b39:


    "Romka ortadan kayboldu."


translate turkish d4_school_fox_voltron_15a5ef0b:


    "Çok geçmeden Polina, etrafı dikkatle kolaçan ederek köşede beliriverdi."


translate turkish d4_school_fox_voltron_2eb27fef:


    "Keman kutusu da yanındaydı. Botlarının altında ezilen taze karlardan gıcırtılar yükseliyordu."


translate turkish d4_school_fox_voltron_55985140:


    "Bulutlar güneşi yutmuş, yaklaşan karanlıkta uzun kulaklı bir yabancıya dönüşmüştüm."


translate turkish d4_school_fox_voltron_1e14ca41:


    "Kuşkuyla bana baktıktan sonra Polina, bahçenin etrafından dolanmaya başladı."


translate turkish d4_school_fox_voltron_ddbaf772:


    "Hehe! Beni tanıyamadı."


translate turkish d4_school_fox_voltron_d9529f36:


    "Boyum veya kıyafetlerim yüzünden kimliğimin ifşa olmasından hiç endişelenmeden Polina'nın yolunu kestim."


translate turkish d4_school_fox_voltron_71849bbf:



    voice "voice/anton/4day/40. Ti.ogg"
    Ant "{i}Yolunu mu kaybettin, fıstık? {/i}"


translate turkish d4_school_fox_voltron_f3b7c20b:


    "Polina irkilip geri çekildi."


translate turkish d4_school_fox_voltron_6ed23d23:


    "Hemen arkasındaki çalılardan Romka, küfürler savurarak fırladı."


translate turkish d4_school_fox_voltron_48d13521:


    "Buket tutan elini ardından çıkarmadan yengeç gibi yan yan yürüdü."


translate turkish d4_school_fox_voltron_3a1fc47d:



    voice "voice/romka/4day/102E.ogg"
    Rom "Bana bak lan, psikopat herif!"


translate turkish d4_school_fox_voltron_6b51b9ea:



    voice "voice/romka/4day/103 P.ogg"
    Rom "B-ben varken kimse bu kızın saçının teline dokunamaz."


translate turkish d4_school_fox_voltron_3d5930a5:



    voice "voice/romka/4day/104 Po.ogg"
    Rom "Anladın mı, he?.."


translate turkish d4_school_fox_voltron_59d82fb7:


    "Romka'nın adına utanıp maskenin altından gözlerimi devirdim."


translate turkish d4_school_fox_voltron_8472bc6a:


    "Sesi tam bir budala gibi yapmacık geliyordu. Provadaki tavırları çok daha inandırıcıydı."


translate turkish d4_school_fox_voltron_b3ef2a78:


    "Romka'ya hiç aldırış etmeden Polina'nın yakasına yapışıp onu yüzsüzce kendime çektim."


translate turkish d4_school_fox_voltron_3653c14e:


    "Parmaklarım, ipeksi kâkülünü okşayıverdi."


translate turkish d4_school_fox_voltron_b69bd783:


    "Polina'nın öfkeyle attığı çığlığa pis pis sırıttım."


translate turkish d4_school_fox_voltron_00e8fc0b:


    "Laubali dokunulmazlığımın verdiği yüzsüzlükle yerimde duramıyordum."


translate turkish d4_school_fox_voltron_3bff19b8:


    "Niyetim, Polina'yı yere devirip vücudunu morartana kadar ellemek, ağzını henüz zor açan Romka'nın rol kabiliyetini toparlamasına fırsat vermekti."


translate turkish d4_school_fox_voltron_93330d21:



    voice "voice/romka/4day/106 G.ogg"
    Rom "Uzak dur! Duydun mu lan?"


translate turkish d4_school_fox_voltron_e08f2e27:


    "Romka'nın elini kolunu bağlayıp gıkını çıkaramamasına sebep olan kafa karışıklığı ve güç sarhoşluğuyla kendisine kulak asmadan devam ettim."


translate turkish d4_school_fox_voltron_45abd46f:


    "Tavşan kılığındayken her şeyi yapabilirdim."


translate turkish d4_school_fox_voltron_1db1ca93:



    voice "voice/anton/4day/41. Pro.ogg"
    Bunny "Sıranı bekle, pısırık!"


translate turkish d4_school_fox_voltron_1dc54233:



    voice "voice/anton/4day/42. S.ogg"
    Bunny "Kızla işim bitsin, sana da geleceğim."


translate turkish d4_school_fox_voltron_ffc5263e:


    "Romka'nın gözleri, şaşkınlıktan fal taşı gibi açılmıştı. Sakinliğini koruyup rolüne sadık kalma çabası, hâlinden belliydi."


translate turkish d4_school_fox_voltron_0499387a:


    "Ancak amatör süper kahramanımız elini taşın altına koyamadan Polina olaya müdahale etti."


translate turkish d4_school_fox_voltron_f82069f6:



    voice "voice/Polina/4day/152 Tak.ogg"
    Pol "Bir saniye ya, ne oluyor?"


translate turkish d4_school_fox_voltron_d81d0d4d:



    voice "voice/Polina/4day/153 P.ogg"
    Pol "Pyatifan, şu arkadaşını üzerimden çeker misin?"


translate turkish d4_school_fox_voltron_a533d4e9:


    "Polina, keman kutusunu savurup bana öyle bir vurdu ki bir anda kendime geliverdim."


translate turkish d4_school_fox_voltron_943af9dc:



    voice "voice/romka/4day/108 Ya.ogg"
    Rom "Ben... O, şey..."


translate turkish d4_school_fox_voltron_20a7ad95:



    voice "voice/Polina/4day/155 D.ogg"
    Pol "Ben de anamdan dün doğmadım yani."


translate turkish d4_school_fox_voltron_d4f0035e:



    voice "voice/Polina/4day/156 B.ogg"
    Pol "Kim bu, Byaşa mı?.."


translate turkish d4_school_fox_voltron_e212ff99:


    "Karton maskenin ardını görebiliyormuşçasına yüzüme baktı."


translate turkish d4_school_fox_voltron_d0ec6310:


    "Çevremizi kuşatan loş ışıkta bile yüzünün öfkeyle kızardığını görebiliyordum."


translate turkish d4_school_fox_voltron_50212038:



    voice "voice/Polina/4day/157 An.ogg"
    Pol "Anton?"


translate turkish d4_school_fox_voltron_f74bcc07:



    voice "voice/Polina/4day/158 Vot.ogg"
    Pol "Bunu sana hiç yakıştıramadım."


translate turkish d4_school_fox_voltron_ac8cd650:


    "Bir bahane bulmak veya Romka'nın bana bırakmadan her şeyi açıklaması gibi sönük umutlarla mırıldandım."


translate turkish d4_school_fox_voltron_9d26f6d9:


    "Fakat bizim başarısız aktör kar yığınına bakakalmış, utancından yüzü pancar gibi kızarmıştı."


translate turkish d4_school_fox_voltron_ae0f0019:


    "Böylesine büyük bir oyun kurgulayıp, daha da büyük batırmak..."


translate turkish d4_school_fox_voltron_4fb80ada:


    "Polina yumruklarını sıkmış, bizi izlerken bağırıverdi."


translate turkish d4_school_fox_voltron_dfc9e1c8:



    voice "voice/Polina/4day/159 K.ogg"
    Pol "Sizi soytarılar!"


translate turkish d4_school_fox_voltron_18738e7a:


    "Polina karla örtülü asfaltta koşmaya başladığında haykırışı, tutsak bir güvercin gibi okulun duvarlarından sekmeye devam ediyordu."


translate turkish d4_school_fox_voltron_71f39b98:


    "Katmerli gölgesi, köşeyi döndüğü gibi gözden kayboldu."


translate turkish d4_school_fox_voltron_cc710a17:


    "Romka utançla boynunu büktü. Elindeki hırpalanmış buket, çamurlu kar birikintisine düşüverdi."


translate turkish d4_school_fox_voltron_1fdc2fc4:



    voice "voice/romka/4day/109 E.ogg"
    Rom "Batırdık be, kanka!"


translate turkish d4_school_fox_voltron_51627011:


    "Terli yüzümdeki maskeyi çıkarıp serin rüzgarı tenimde hissettim."


translate turkish d4_school_fox_voltron_bcac9f74:


    "Zihnimi işgal eden bazı düşünceler ve duygulardan da maskeyi çıkarmamla sıyrılmıştım sanki."


translate turkish d4_school_fox_voltron_f7cf369e:


    "Romka yere bakarak dişlerini gıcırdatıyordu."


translate turkish d4_school_fox_voltron_b23f68fd:


    "Dalgın ve kederliydi. Benim aksime kendisi, kaderin kroşelerini savuşturamamıştı."


translate turkish d4_school_fox_voltron_953e97b7:


    "Berbat hissettiği her hâlinden belliydi."


translate turkish d4_school_fox_voltron_a8640f29:


    "Yoluna çıkan herkesi, her şeyi ezip geçecekmiş veya kafasını duvarlara vuracakmış gibiydi."


translate turkish d4_school_fox_voltron_4962a73e:


    "Polina'ya \"Geri dön.\" demek haricinde her şeyi yapabilirdi."


translate turkish d4_school_fox_voltron_4b06b5c7:


    "Güçlü ve cesurdu ancak zayıflık gösterme korkusu, onu bunu söylemekten alıkoyuyordu."


translate turkish d4_school_fox_voltron_42ee8352:


    "Aklıma bir fikir geliverdi. Elimi Romka'nın omuzuna attım."


translate turkish d4_school_fox_voltron_ef23fed9:



    voice "voice/anton/4day/45. Z.ogg"
    Ant "Bekle."


translate turkish d4_school_fox_voltron_bedc0abd:


    "Polina'ya yetişmek için okul bahçesi boyunca son sürat koştum."


translate turkish d4_school_fox_voltron_8bf017d5:


    "Attığım her adım, bahçede yankılanıyordu."


translate turkish d4_school_fox_voltron_f5e278a9:


    "Kızın elindeki keman kutusu, huysuz bir kedinin kuyruğu gibi sallanıyordu."


translate turkish d4_school_fox_voltron_121aba66:



    voice "voice/anton/4day/46. Pol.ogg"
    Ant "Polina!"


translate turkish d4_school_fox_voltron_f688114e:


    "Yavaşlasa da arkasına bakmadı."


translate turkish d4_school_fox_voltron_0b2b82f7:



    voice "voice/anton/4day/47. Nu.ogg"
    Ant "Polina, lütfen!"


translate turkish d4_school_fox_voltron_6265d2c6:


    "Nihayet güzel yüzünü görebildim."


translate turkish d4_school_fox_voltron_5540ef70:



    voice "voice/Polina/4day/160 Ch.ogg"
    Pol "Ne var?"


translate turkish d4_school_fox_voltron_070512c1:


    "Polina'ya yetişip dirseğini nazikçe tuttum. Kendini geri çekmedi, bu iyiye işaretti."


translate turkish d4_school_fox_voltron_62c48d50:



    voice "voice/anton/4day/48. Ti.ogg"
    Ant "Sen bizi çok yanlış anladın."


translate turkish d4_school_fox_voltron_10f0d5ec:


    "Polina, yüzüne düşen bir tutam saçı kenara attı."


translate turkish d4_school_fox_voltron_15d84ae4:


    "Bu hareketi bir Sharon Stone filminden araklamış olmalıydı."


translate turkish d4_school_fox_voltron_cbbbab5b:


    "Ses tonu hâlâ sertti."


translate turkish d4_school_fox_voltron_42066b35:



    voice "voice/Polina/4day/161 Ct.ogg"
    Pol "Neyinizi yanlış anlayayım?"


translate turkish d4_school_fox_voltron_20e1a2db:



    voice "voice/Polina/4day/162 R.ogg"
    Pol "Romka belli ki 'kahramanca bir hareket' yapmak istemiş."


translate turkish d4_school_fox_voltron_a413457c:



    voice "voice/Polina/4day/163 At.ogg"
    Pol "Sen de beni ellerinden kurtaracağı şaklaban olmaya razı gelmişsin."


translate turkish d4_school_fox_voltron_2f310fbf:



    voice "voice/Polina/4day/164 Es.ogg"
    Pol "Her nasılsa sana çirkin mi çirkin bir maske bile ayarlamış!"


translate turkish d4_school_fox_voltron_4ebb71b6:


    "{i}\"Hiç de çirkin değil!\"{/i} diye bağırmak istesem de bambaşka bir şekilde yanıt verdim."


translate turkish d4_school_fox_voltron_89a97bf0:



    voice "voice/anton/4day/49. Avot.ogg"
    Ant "Anlamamışsın işte!"


translate turkish d4_school_fox_voltron_7e5ee5eb:



    voice "voice/anton/4day/50 T.ogg"
    Ant "Romka senden çok hoşlanıyor."


translate turkish d4_school_fox_voltron_7a2e247f:


    "Gözlerinde bir merak uyanmıştı."


translate turkish d4_school_fox_voltron_a50d5f34:


    "Polina'ya sarılıp, aklını çelip onu ormana götürmek..."


translate turkish d4_school_fox_voltron_b6d949d7:


    "...ve yeni dostlarımla tanıştırmak isterdim."


translate turkish d4_school_fox_voltron_6e220332:


    "Birlikte o flüt ezgisini dinlemek isterdim ki eminim, Polina'nın da hoşuna giderdi."


translate turkish d4_school_fox_voltron_c678e495:


    "Onunla bulutlardan da yüksek göklere uçmak isterdim."


translate turkish d4_school_fox_voltron_7becb46c:


    "Geceleyin gökte asılı yıldızların hemen altında Polina'ya ne kadar ihtiyacım olduğunu söylerdim."


translate turkish d4_school_fox_voltron_82495bbb:


    "Onun su gibi olduğunu, benim ise susuzluktan öldüğümü..."


translate turkish d4_school_fox_voltron_3b2f8c60:



    voice "voice/Polina/4day/166 Ya.ogg"
    Pol "Senin de benden hoşlandığını sanıyordum."


translate turkish d4_school_fox_voltron_ad8e285b:


    "Anlamazlıktan geldim."


translate turkish d4_school_fox_voltron_78388682:



    voice "voice/anton/4day/50. Mne.ogg"
    Ant "Ben mi?"


translate turkish d4_school_fox_voltron_1e161082:


    "Sinirleri bozulan Polina, ellerimden kurtuldu."


translate turkish d4_school_fox_voltron_9791d832:



    voice "voice/Polina/4day/168 Vs.ogg"
    Pol "Şimdi anladım!"


translate turkish d4_school_fox_voltron_eec5278b:



    voice "voice/anton/4day/51.Da.ogg"
    Ant "Dur bir saniye! Hoşlanıyorum tabii!"


translate turkish d4_school_fox_voltron_ed12e6af:



    voice "voice/anton/4day/51.T.ogg"
    Ant "Herkes senden hoşlanıyor."


translate turkish d4_school_fox_voltron_61edf533:



    voice "voice/anton/4day/51.No.ogg"
    Ant "Ancak Romka'nınki özel bir mesele."


translate turkish d4_school_fox_voltron_18455e4f:



    voice "voice/Polina/4day/169 Os.ogg"
    Pol "Yalancının nesi özel oluyorsa..."


translate turkish d4_school_fox_voltron_f4bc68dd:



    voice "voice/anton/4day/52. On.ogg"
    Ant "Hem kendisi hem de niyeti sandığından daha ciddi."


translate turkish d4_school_fox_voltron_91109821:



    voice "voice/anton/4day/52.Po.ogg"
    Ant "Bana kaçıp gitmek istediğinden bahsetmiştin hani, Romka'yla bu dileğin gerçek olabilir."


translate turkish d4_school_fox_voltron_fe5e4b6e:



    voice "voice/anton/4day/52.V.ogg"
    Ant "Seni şöyle şatafatlı bir büyükşehre götürür."


translate turkish d4_school_fox_voltron_3472ef45:



    voice "voice/anton/4day/52.Da.ogg"
    Ant "Hatta dilediğin her yere götürür!"


translate turkish d4_school_fox_voltron_abb83b2c:



    voice "voice/anton/4day/52.On.ogg"
    Ant "Çocuk, seni korumaya yemin etti."


translate turkish d4_school_fox_voltron_8f027430:


    "Polina, bakışlarını okulun sınırını kuşatan karanlığa doğru çevirdi. Orada rüzgar ile uçuşan karlardan başka hiçbir şey yoktu."


translate turkish d4_school_fox_voltron_1d10a240:



    voice "voice/Polina/4day/170 E.ogg"
    Pol "Ne yapayım ya?"


translate turkish d4_school_fox_voltron_c36a703f:



    voice "voice/Polina/4day/171 Ot.ogg"
    Pol "Sırf yemin etti diye onunla hayat arkadaşı mı olayım yani?"


translate turkish d4_school_fox_voltron_f7cdd51f:



    voice "voice/anton/4day/52.Dl.ogg"
    Ant "Ondan önce oturup bir çay için, birbirinizi tanıyın."


translate turkish d4_school_fox_voltron_4541ab0d:



    voice "voice/anton/4day/53.Sh.ogg"
    Ant "Şaka bir yana, seri katil hâlâ ortalıkta kol geziyor."


translate turkish d4_school_fox_voltron_50ed1f2c:



    voice "voice/anton/4day/53.Po.ogg"
    Ant "Müsaade et de Romka, bugün sana evine kadar eşlik etsin."


translate turkish d4_school_fox_voltron_766ffc46:


    "Yüzüm kaskatı kesilmiş olsa da uyuşan dudaklarımı konuşmaya zorluyordum."


translate turkish d4_school_fox_voltron_12607e8e:


    "Ses tonumdan Polina'nın gerçek hislerimi anlamasından korkuyordum."


translate turkish d4_school_fox_voltron_af9aa0dd:


    "Sözlerim, göğsümü ve soluk borumu kesip ağzımdan firar eden bir avuç jilet gibiydi."


translate turkish d4_school_fox_voltron_133e1c45:


    "Polina, sanki bitmek bilmeyen bir sessizliğe gömüldü."


translate turkish d4_school_fox_voltron_56d66d09:


    "Öfleyerek parmaklarını keman kutusunda tıkırdattı."


translate turkish d4_school_fox_voltron_3614a427:


    "Nihayetinde iç çekip yanıt verdi."


translate turkish d4_school_fox_voltron_5f391a9e:



    voice "voice/Polina/4day/172 Pe.ogg"
    Pol "Romka'ya söyle, okulun bahçe kapısının orada bekleyeceğim."


translate turkish d4_school_fox_voltron_ebdee67b:



    voice "voice/Polina/4day/173 no.ogg"
    Pol "Ama kafasında yalan yanlış şeyler kurmasın!"


translate turkish d4_school_fox_voltron_3203d220:


    "Sevinmiş gibi yaptım. Gerektiğinde yapmacık duygulara da bürünebiliyordum."


translate turkish d4_school_fox_voltron_09f89631:



    voice "voice/anton/4day/54. T.ogg"
    Ant "Pişman olmayacaksın."


translate turkish d4_school_fox_voltron_c75837ad:


    "Ağır adımlarla köşeyi döndüm. Gözlerimi yummuştum, kalbim ise ruhumun derinlerine çivi çakan bir çekiç gibi küt küt atıyordu."


translate turkish d4_school_fox_voltron_d45d4a5e:


    "Romka çömelip oturmuş, kısacık saçıyla oynuyordu."


translate turkish d4_school_fox_voltron_e7f0bde6:



    voice "voice/anton/4day/55. Ona.ogg"
    Ant "Bahçe kapısında seni bekliyor."


translate turkish d4_school_fox_voltron_447f91d3:


    "Dostumun yüzündeki hayret dolu bakış, teşekkürü aratmamıştı."


translate turkish d4_school_fox_voltron_a0b2083c:


    "Sözcükler boğazına dizilmiş hâlde yerinden fırlayıverdi."


translate turkish d4_school_fox_voltron_82102c1f:


    "Geçen hafta tanıştığım, ağzını bıçak açmayan serseri elebaşından eser kalmamıştı o an."


translate turkish d4_school_fox_voltron_eafae180:



    voice "voice/romka/4day/111 T.ogg"
    Rom "Toşa, sen olmasan ne yapardım ben?"


translate turkish d4_school_fox_voltron_3f94f738:



    voice "voice/romka/4day/112 B.ogg"
    Rom "Sana çok şey borçluyum be kanka."


translate turkish d4_school_fox_voltron_5374187b:



    voice "voice/romka/4day/113H.ogg"
    Rom "Sana Tetris ayarlamamı ister misin? Kavga etmeyi de öğretebilirim..."


translate turkish d4_school_fox_voltron_21de0a2d:



    voice "voice/romka/4day/114 E.ogg"
    Rom "Hatta..."


translate turkish d4_school_fox_voltron_447c29d6:


    "Tek bir isteğim vardı, yalnız kalmak."


translate turkish d4_school_fox_voltron_41c0479e:


    "Yalnız kalayım ki ormanın rüzgarla ileri geri salınışını sessizlik içinde izleyebileyim."


translate turkish d4_school_fox_voltron_49422d7f:


    "Eski püskü maskemi takıp kırağılı havayı içime çekebileyim."


translate turkish d4_school_fox_voltron_640335db:



    voice "voice/anton/4day/56. Ed.ogg"
    Ant "Hadi, hadi."


translate turkish d4_school_fox_voltron_643a9669:


    "Söz konusu Alisa olduğunda da arkadaşlığımız ve hislerim arasında bir ikilemde kalmamayı umuyordum."


translate turkish d4_school_fox_voltron_30bf3170:


    "Ondan başka kimsem yoktu..."


translate turkish d4_school_fox_voltron_2d5d93dd:


    "Yani, belki bir de Olya vardı."


translate turkish d4_school_fox_voltron_1c8e7945:


    "Kendisi, bu zifiri karanlık taygada sahip olduğum tek ışıktı tabii."


translate turkish d4_school_fox_voltron_7c4c0b5d:


    "Nasıl olur da kardeşimi unuturum?"


translate turkish d4_school_fox_voltron_bd182794:



    voice "voice/anton/4day/57. Ya.ogg"
    Ant "Ne istediğimi biliyorum."


translate turkish d4_school_fox_voltron_2f59ea75:


    "Çoktan yürümeye koyulan Romka durup bana baktı."


translate turkish d4_school_fox_voltron_0cd62da7:



    voice "voice/anton/4day/58. Y.ogg"
    Ant "Kardeşimle Disneyland'e gitmek istiyorum."


translate turkish d4_school_fox_voltron_6d427f17:


    "Dostum sırıtıp beresini ensesine doğru çekiştirdi."


translate turkish d4_school_fox_voltron_2888cb1a:



    voice "voice/romka/4day/116 E.ogg"
    Rom "Nasıl olacakmış o?"


translate turkish d4_school_fox_voltron_57caefed:



    voice "voice/romka/4day/117 S.ogg"
    Rom "Banka falan mı soyacağız?"


translate turkish d4_school_fox_voltron_f8af47c8:



    voice "voice/anton/4day/59.Ne.ogg"
    Ant "Hayır, seri katili yakalasak yeter."


translate turkish d4_school_fox_voltron_6b654377:



    voice "voice/anton/4day/60.To.ogg"
    Ant "Tüm bu kayıplardan sorumlu olan katili yani..."


translate turkish d4_school_fox_voltron_44d26a6e:



    voice "voice/anton/4day/60.E.ogg"
    Ant "Yakalarsak jandarma bizi ödüllendirir."


translate turkish d4_school_fox_voltron_5a2bdf1b:


    "Romka irkilip ellerini cebine attı."


translate turkish d4_school_fox_voltron_a593dc05:



    voice "voice/romka/4day/118 D.ogg"
    Rom "Üsteğmenin, yardımını parayla ödüllendireceğini mi sanıyorsun?"


translate turkish d4_school_fox_voltron_7ddf4d7b:



    voice "voice/romka/4day/119 Po.ogg"
    Rom "Verse verse bir kol saati verip kapıyı gösterir!"


translate turkish d4_school_fox_voltron_50fff925:


    "Romka'yla tartışmaktan gına gelmişti."


translate turkish d4_school_fox_voltron_2d4bd537:



    voice "voice/anton/4day/60. Ti.ogg"
    Ant "Yardım edecek misin etmeyecek misin?"


translate turkish d4_school_fox_voltron_862d4bdf:



    voice "voice/romka/4day/120 Ya.ogg"
    Rom "Dediğim gibi, biz bir takımız."


translate turkish d4_school_fox_voltron_c4de9798:



    voice "voice/romka/4day/121 K.ogg"
    Rom "Birlikte hareket edeceğiz."


translate turkish d4_school_fox_voltron_c50213fe:



    voice "voice/anton/4day/60.Ho.ogg"
    Ant "Peki madem."


translate turkish d4_school_fox_voltron_090728aa:



    voice "voice/anton/4day/60.Te.ogg"
    Ant "Bir de nereden başlayacağımızı bilsem."


translate turkish d4_school_fox_voltron_0fc81ef7:



    voice "voice/romka/4day/122 S.ogg"
    Rom "Bir fikrim var!"


translate turkish d4_school_fox_voltron_f8c3b8e8:



    voice "voice/romka/4day/123 By.ogg"
    Rom "Byaşa, mezarlığın arkasındaki devrik ağaçların oradan bir çığlık sesi duyduğunu söylemişti."


translate turkish d4_school_fox_voltron_b2829d5e:



    voice "voice/romka/4day/124 G.ogg"
    Rom "Bence kesin Katya'ydı o."


translate turkish d4_school_fox_voltron_bed8b679:


    "Gitar teli gibi gerildiğimi hissettim."


translate turkish d4_school_fox_voltron_01067e00:


    "Katya'yı bulursak Semyon'u ve ardından Vova'yı da bulabilirdik."


translate turkish d4_school_fox_voltron_2b2a41b3:


    "Jandarmanın o caniyi yakalamasına yardımcı olur, köy sakinlerine nihayet huzur verirdik."


translate turkish d4_school_fox_voltron_c316a343:


    "Olya'nın dışarıya çıkmasına engel olan yasaklar da böylece kaldırılırdı."


translate turkish d4_school_fox_voltron_b17762c9:


    "En nihayetinde kardeşime yeni dostlarıyla göklere uçmayı öğretirdim."


translate turkish d4_school_fox_voltron_70a46197:



    voice "voice/anton/4day/61.Ka.ogg"
    Ant "Planımız nedir madem?"


translate turkish d4_school_fox_voltron_00483945:



    voice "voice/romka/4day/125 T.ogg"
    Rom "Şimdilik kestiremiyorum, hem fazla vaktim de yok."


translate turkish d4_school_fox_voltron_7d63657a:



    voice "voice/romka/4day/126 Da.ogg"
    Rom "İyisi mi, bir saat sonra Polina'nın evinin orada buluşalım."


translate turkish d4_school_fox_voltron_c9eba42b:



    voice "voice/romka/4day/127 N.ogg"
    Rom "Yok, bir buçuk saat sonra olsun!"


translate turkish d4_school_fox_voltron_c4c8c81d:



    voice "voice/romka/4day/128 Z.ogg"
    Rom "Evini biliyorsun, değil mi?"


translate turkish d4_school_fox_voltron_b1700b31:


    "Çaktırmadan Polina'nın anketinden baktığım kapı numarasını hatırladım."


translate turkish d4_school_fox_voltron_7ce67d99:



    voice "voice/anton/4day/63. Du.ogg"
    Ant "Bir şekilde yolumu bulurum."


translate turkish d4_school_fox_voltron_d49f756b:



    voice "voice/romka/4day/129 O.ogg"
    Rom "Kıyak! Hadi ben kaçtım."


translate turkish d4_school_fox_voltron_f69cf603:


    "Ardından Romka hızla uzaklaştı, beni de dörtnala giden kalp atışlarımı dizginlemek üzere bir başıma bıraktı."


translate turkish d4_school_fox_voltron_cee8eb89:


    "Belki de Romka'nın desteğiyle bu kabus artık bir son bulur."


translate turkish d4_school_fox_voltron_0b9a6d9e:


    "Çekirdek çitleyen Byaşa, ona yaklaştığımı gördüğü an yüzünü buruşturdu."


translate turkish d4_school_fox_voltron_4e6ec95c:



    voice "voice/byasha/4day/178 S.ogg"
    Bya "Bakın hele, kimler gelmiş he!"


translate turkish d4_school_fox_voltron_6f4ec44d:



    voice "voice/byasha/4day/179 Br.ogg"
    Bya "İkiniz bir oldunuz da beni unutup gittiniz."


translate turkish d4_school_fox_voltron_ddb6ef0e:



    voice "voice/byasha/4day/180 Aes.ogg"
    Bya "Bir de Voltran takımı olacakmışız, he!"


translate turkish d4_school_fox_voltron_5cbab9d2:


    "Byaşa asık suratıyla bana bakıp arkasını döndü."


translate turkish d4_school_fox_voltron_13501e1c:


