    "Baltayı bırakıp en kıymetlilerimin yanına sokuldum."


translate turkish d5_ending_home_violence_1af651dd:


    "Kollarının arasında bana kadar yerleri vardı."


translate turkish d5_ending_home_violence_7a268e6c:


    "Annemin eli buz gibiydi ancak yakında ısınırdı."


translate turkish d5_ending_home_violence_eb3e4000:


    "O andan itibaren ailemin her türlü badireyi atlatabileceğini, kışın bir gün sona ereceğini, karların eriyeceğini, kardelenlerin filizleneceğini biliyordum."


translate turkish d5_ending_home_violence_6bc80ad0:


    "Rüzgar odada dört dönüyor, masa örtüsünün kenarlarını hışırdatıyordu."


translate turkish d5_ending_home_violence_f206f422:


    "Kar taneleri koridora serpiliyordu."


translate turkish d5_ending_home_violence_0041da57:



    voice "voice/anton/5day/274.m.ogg"
    Ant "Anne, kapı..."


translate turkish d5_ending_home_violence_a606d8dd:



    voice "voice/karina/5day/173 Dv.ogg"
    Mam "Kapılar hep açık. Misafir gelirse diye."


translate turkish d5_ending_home_violence_4d5f1080:



    voice "voice/anton/5day/275.go.ogg"
    Ant "Ne misafiri?"


translate turkish d5_ending_home_violence_f411b2ca:


    "Işıklar titreşiverdi."


translate turkish d5_ending_home_violence_d1774821:


    "Ampul ne zaman sönüp yansa, yerdeki gölgeler iyice uzayıp biçimini yitiriyordu."


translate turkish d5_ending_home_violence_9add9658:


    "Evin ahşap iskeleti heyecanla gıcırdıyordu."


translate turkish d5_ending_home_violence_911eb6cd:


    "Gıcır, gıcır."


translate turkish d5_ending_home_violence_2c053352:


    "Kapı, paslı menteşesini gıcırdatarak çarpıp duruyordu."


translate turkish d5_ending_home_violence_01082441:


    "Annemin elbisesine tutundum."


translate turkish d5_ending_home_violence_55dbee5d:


    "Gözlerimi tavana çevirdim."


translate turkish d5_ending_home_violence_c58868d5:


    "Karanlık."


translate turkish d5_ending_home_violence_02066dbc:


    "Işık."


translate turkish d5_ending_home_violence_eabbb0e3:


    "Kapı pat diye açılıp duvara vurdu."


translate turkish d5_ending_home_violence_92c7bbdf:


    "Boynuzlu bir silüet kapının önünde dikiliyordu."


translate turkish d5_ending_home_violence_4459b3e7:



    voice "voice/kozel/5day/64 Ug.ogg" 
    Master "İkramlar!"


translate turkish d5_ending_home_violence_85b37853:


    "İri yarı davetsiz misafirimiz içeriye girdi."


translate turkish d5_ending_home_violence_ab807a4b:


    "Ormanın kıyısındaki barakamız tüm güvenliğini yitirmişti."


translate turkish d5_ending_home_violence_cd3ac5ff:


    "Pencereleri barikatla örülü bir tuzağa dönüşmüştü."


translate turkish d5_ending_home_violence_e1b23567:


    "Canavarlar barikatın aralıklarından bizi dikizliyordu."


translate turkish d5_ending_home_violence_35297428:


    "Küf lekeleri tavana yayılıyordu."


translate turkish d5_ending_home_violence_d8609697:


    "Kadim taygadan hışırtılar yükseliyor, upuzun çamlarındaki karlar silkeleniyordu."


translate turkish d5_ending_home_violence_439dd406:


    "Pencere aralarında eğri büğrü parmaklar belirdi."


translate turkish d5_ending_home_violence_086226ec:


    "Olya feryat etse de ona yardımcı olamazdım."


translate turkish d5_ending_home_violence_6bb6dbdd:


    "Çaresizce birbirimize sarılıyorduk."


translate turkish d5_ending_home_violence_b675c57a:


    "Gözyaşlarımı hakim olmaya çalışarak yukarıya baktım."


translate turkish d5_ending_home_violence_5788e734:


    "Bakışlarımı annemin göğsünden boynuna doğrulturken... yüzündeki gri tavşan maskesini fark ettim."


translate turkish d5_ending_home_violence_073e7b02:


    "İştahı gözlerinden okunuyordu."


translate turkish d5_ending_home_violence_d1ee2eca:



    voice "voice/anton/5day/277.Ya.ogg"
    "Çığlığı kopardığım an dudaklarını araladı ve leş gibi ağız kokusuna boğuldum."


translate turkish d5_ending_home_violence_90100727:


    "Annem dişlerini suratıma geçiriverdi."


translate turkish d5_ending_home_violence_db79bb90:


    "Olya'yla birlikte ebedi karanlığa teslim olduk."


translate turkish d5_ending_mad_world_afterdev_ad48f06e:


    "Pat diye bir ses geldi."


translate turkish d5_ending_mad_world_afterdev_33c8c1d2:


    "Aynı anda evin ışıkları yandı."


translate turkish d5_ending_mad_world_afterdev_937d18d2:


    "Kapı talaş saçarak açılıverdi."


translate turkish d5_ending_mad_world_afterdev_90cddb25:


    "Kanadı koridora kızak gibi fırlamıştı."


translate turkish d5_ending_mad_world_afterdev_8fdb04bd:


    "Buradalar!"


translate turkish d5_ending_mad_world_afterdev_e9ad7217:


    "Polina'yı mideye indirmek için geldiler."


translate turkish d5_ending_mad_world_afterdev_3c83f67f:


    "Romka'yı mideye indirmek için geldiler."


translate turkish d5_ending_mad_world_afterdev_039e84b3:


    "Olya'yı mideye indirmek için geldiler."


translate turkish d5_ending_mad_world_afterdev_9a78b265:


    "Kadim ormanın ucubelikleriyle yüzleşmek için arkamı döndüm. Kapı eşiğinde gördüğüm suretler karşısında çığlığı kopardım."


translate turkish d5_ending_mad_world_afterdev_f9f17161:



    voice "voice/anton/5day/130.Vot.ogg"
    Ant "Canavarlar, alın size ziyafet!"


translate turkish d5_ending_mad_world_afterdev_75abf2f9:



    voice "voice/anton/5day/130.Netro.ogg"
    Ant "Bana sakın dokunmayın!"


translate turkish d5_ending_mad_world_afterdev_a99ddec4:



    voice "voice/tihonov/5day/02 Det.ogg"
    Tikhonov "İyi misiniz çocuklar?"


translate turkish d5_ending_mad_world_afterdev_19ee3e61:



    voice "voice/tihonov/5day/03 Ant.ogg"
    Tikhonov "Anton, buraya güç bela gelebildik. Annenle baban..."


translate turkish d5_ending_mad_world_afterdev_161c80fb:


    "Üsteğmenin boğazı düğümlenmişti."


translate turkish d5_ending_mad_world_afterdev_1f17d585:



    voice "voice/episod/Doronin.ogg"
    "Onun ardında duran orta yaşlı memur bağırmamak için zor duruyordu."


translate turkish d5_ending_mad_world_afterdev_9b0a8c5f:



    voice "voice/tihonov/5day/04 O.ogg"
    Tikhonov "Aman ya Rabb'im..."


translate turkish d5_ending_mad_world_afterdev_7e16935f:


    "Pencereye baktım."


translate turkish d5_ending_mad_world_afterdev_b8f2030d:


    "Maskeler yok olmuş, onların yerine bir çift jandarma ışığı yanıyordu."


translate turkish d5_ending_mad_world_afterdev_6b94de42:


    "Üsteğmen Tihonov'un şaşkın bakışları bir baltaya bir keline yapışan saç tellerine kayıyordu."


translate turkish d5_ending_mad_world_afterdev_e4d8d20a:


    "Dolaptan dönen Romka çığlık atıp korkuyla geriye doğru sendeledi."


translate turkish d5_ending_mad_world_afterdev_da4eea90:


    "İkinci kattan dönen Polina çığlık atıp korkuyla geriye doğru sendeledi."


translate turkish d5_ending_mad_world_afterdev_41a61ccf:


    "İkinci kattan dönen arkadaşlarım çığlık atıp korkuyla geriye doğru sendeledi."


translate turkish d5_ending_mad_world_afterdev_74cf4fa8:


    "Mutfak mezbahaya dönmüştü."


translate turkish d5_ending_mad_world_afterdev_66dde73e:


    "Üsteğmen feryadı kopardı."


translate turkish d5_ending_mad_world_afterdev_862c9b9e:



    voice "voice/tihonov/5day/05 Chto.ogg"
    Tikhonov "Ne yaptın sen?"


translate turkish d5_ending_mad_world_afterdev_3f743e78:


    "Baltayı bırakıp yüzümü silerek Polina'nın elime bulaşan kanını suratıma boca ettim."


translate turkish d5_ending_mad_world_afterdev_660b2709:


    "Baltayı bırakıp yüzümü silerek dostumun elime bulaşan kanını suratıma boca ettim."


translate turkish d5_ending_mad_world_afterdev_b8ccc8d6:


    "Baltayı bırakıp yüzümü silerek kardeşimin elime bulaşan kanını suratıma boca ettim."


translate turkish d5_ending_mad_world_afterdev_e9ceeede:



    voice "voice/anton/5day/131.vse.ogg"
    Ant "Öyle değil... Şey..."


translate turkish d5_ending_mad_world_afterdev_ee19247d:



    voice "voice/anton/5day/131.Eto.ogg"
    Ant "Yaratıklar yüzünden oldu."


translate turkish d5_ending_mad_world_afterdev_40f91217:



    voice "voice/anton/5day/132.Oni.ogg"
    Ant "Onlar... Onlara ikram sunma sırasının bende olduğunu söylemişlerdi..."


translate turkish d5_ending_mad_world_afterdev_e239d5d0:


    "Dışarıda karlar savruluyor, korkunç devleri andıran biçimler alıyordu."


translate turkish d5_ending_mad_world_afterdev_fe9a14ad:


    "Jandarmanın gözaltına hiç direnmedim."


translate turkish d5_ending_mad_world_afterdev_b620978a:


    "Ellerim ufacık olduğu için kelepçe, bileklerime zor tutunuyordu. Soğuk demir parçaları kayıp duruyordu."


translate turkish d5_ending_mad_world_afterdev_e08b4341:


    "Niye kelepçeyle uğraşıyorlar ki zaten?"


translate turkish d5_ending_mad_world_afterdev_cbe8b301:


    "Ormana, o yamyam canavarların kollarına koşacak değildim ya."


translate turkish d5_ending_mad_world_afterdev_ffc9e8a2:


    "Beni jandarma aracının arkasına tıktılar."


translate turkish d5_ending_mad_world_afterdev_db2d2eb5:


    "Dönüp evime son kez baktım."


translate turkish d5_ending_mad_world_afterdev_dd3ea42a:


    "Kar baykuşunu andıran kar fırtınası, evimizi kanatları arasına almıştı."


translate turkish d5_ending_mad_world_afterdev_398d2f24:


    "Polina kıpırdamadan kapıda dikilmiş, gözaltına alınmamı yaşlı gözlerle izliyordu."


translate turkish d5_ending_mad_world_afterdev_c4424fd4:


    "Hayatını kurtardığımı nasıl anlamaz?"


translate turkish d5_ending_mad_world_afterdev_075917aa:


    "Polina ve Romka kıpırdamadan kapıda dikilmiş, gözaltına alınmamı izliyordu."


translate turkish d5_ending_mad_world_afterdev_dab225ea:


    "Hayatlarını kurtardığımı nasıl anlamazlar?"


translate turkish d5_ending_mad_world_afterdev_13688e1d:


    "Romka kıpırdamadan kapıda dikilmiş, gözaltına alınmamı öfkeli bakışlarla izliyordu."


translate turkish d5_ending_mad_world_afterdev_7ece7aed:


    "Memur bey Olya'yı battaniyeye sarmış, dışarıya çıkarıyordu."


translate turkish d5_ending_mad_world_afterdev_4768735e:


    "Hayatlarını kurtardığımı nasıl anlamazlar?"


translate turkish d5_ending_mad_world_afterdev_b88e77bb:



    voice "voice/anton/5day/133.Gde.ogg"
    Ant "Annemle babam nerede?"


translate turkish d5_ending_mad_world_afterdev_f7c27643:



    voice "voice/tihonov/5day/06 ob.ogg"
    Tikhonov "Biz de onu söylemeye gelmiştik."


translate turkish d5_ending_mad_world_afterdev_f5ebf21a:



    voice "voice/tihonov/5day/07 Bu.ogg"
    Tikhonov "Tipi yüzünden... kaza yapıp son nefesini vermişler."


translate turkish d5_ending_mad_world_afterdev_181a14d5:


    voice "voice/anton/5day/13 hnik.ogg" 


translate turkish d5_ending_mad_world_afterdev_c92fc1d4:


    "Dönüp kasvetli bakışlarını bana yöneltti."


translate turkish d5_ending_mad_world_afterdev_8503e22a:



    voice "voice/tihonov/5day/08 Em.ogg"
    Tikhonov "Şanslıymışsın. Kabahatini öğrenemeyecekler."


translate turkish d5_ending_mad_world_afterdev_e40b8a79:


    "Jandarma UAZ'sinin parmaklıklı camından, dışarıda süzülen kar tanelerini izliyordum. Aracın ışıkları, karanlığı aydınlatmakta güçlük çekiyordu."


translate turkish d5_ending_mad_world_afterdev_29ed3235:


    "Jandarma karakolundaki bir masa lambası gözümü aldı."


translate turkish d5_ending_mad_world_afterdev_a13692c1:


    "Üsteğmen, odayı geniş adımlarla arşınlıyordu."


translate turkish d5_ending_mad_world_afterdev_356f4bbf:


    "Gölgesi Rusya haritasına düşüp duruyor, hiç ayak basamayacağım bölgelerinde belirip yok oluyordu."


translate turkish d5_ending_mad_world_afterdev_79e1172b:



    voice "voice/tihonov/5day/09 Tak.ogg"
    Tikhonov "Konuş bakalım."


translate turkish d5_ending_mad_world_afterdev_92988adb:



    voice "voice/tihonov/5day/10 Kto.ogg"
    Tikhonov "Pencerende kimleri gördüğünü söylemiştin?"


translate turkish d5_ending_mad_world_afterdev_2fa8018b:



    voice "voice/anton/5day/134.Zver.ogg"
    Ant "Yaratıkları."


translate turkish d5_ending_mad_world_afterdev_02a7aabb:



    voice "voice/anton/5day/134.Ali.ogg"
    Ant "Alisa... Baykuşçuk... Ayıcık... Kurtçuk..."


translate turkish d5_ending_mad_world_afterdev_e16784a0:



    voice "voice/anton/5day/135.Oni.ogg"
    Ant "Acıktıkları için gelmişlerdi."


translate turkish d5_ending_mad_world_afterdev_2fa44f85:



    voice "voice/anton/5day/135.E.ogg"
    Ant "Tavşancık da onları beslemem gerektiğini söyledi."


translate turkish d5_ending_mad_world_afterdev_55ccd5e6:


    "Üsteğmen yumruğunu masaya vurdu."


translate turkish d5_ending_mad_world_afterdev_f07b6a4e:



    voice "voice/tihonov/5day/11 Kak.ogg"
    Tikhonov "Ne Kurtçuk'u, ne Tavşancık'ı be? Ne anlatıyorsun sen!"


translate turkish d5_ending_mad_world_afterdev_173ae374:



    voice "voice/tihonov/5day/12 Zoo.ogg"
    Tikhonov "Sirk mi bu?"


translate turkish d5_ending_mad_world_afterdev_54546311:


    "Korkudan boynum bükülmüştü."


translate turkish d5_ending_mad_world_afterdev_66081b36:



    voice "voice/tihonov/5day/13 Na.ogg"
    Tikhonov "Bana bak serseri!"


translate turkish d5_ending_mad_world_afterdev_56ef8af6:



    voice "voice/tihonov/5day/14 Sl.ogg"
    Tikhonov "Haloperidol nedir duydun mu hiç?"


translate turkish d5_ending_mad_world_afterdev_fca62bc1:


    "Kafamı salladım."


translate turkish d5_ending_mad_world_afterdev_a4e517d6:



    voice "voice/tihonov/5day/15 Em.ogg"
    Tikhonov "Aklını kaçıranlara enjekte edilen bir ilaç."


translate turkish d5_ending_mad_world_afterdev_0beceeb2:



    voice "voice/tihonov/5day/16 Me.ogg"
    Tikhonov "Kasları iki büklüm eder. Tam bir işkencedir."


translate turkish d5_ending_mad_world_afterdev_63d0d918:



    voice "voice/tihonov/5day/17 Ho.ogg"
    Tikhonov "Denemek ister misin, he?"


translate turkish d5_ending_mad_world_afterdev_56d77e71:



    voice "voice/anton/5day/136.net.ogg"
    Ant "H-hayır."


translate turkish d5_ending_mad_world_afterdev_332243b0:


    "Neden böyle davranıyorlardı?"


translate turkish d5_ending_mad_world_afterdev_fe342c0b:


    "Halimi anlamıyorlar mıydı?"


translate turkish d5_ending_mad_world_afterdev_3b598767:


    "Ormanda nelerin kol gezdiğinden haberleri yok muydu?"


translate turkish d5_ending_mad_world_afterdev_1b995f2a:


    "Karanlık tayga, memur beyin başının hemen üstünden, haritadan bana bakıyordu."


translate turkish d5_ending_mad_world_afterdev_7d5151f0:


    "Medeniyetten uzak, baykuşların öttüğü, hortlakların buz gibi parmaklarıyla toprağı eşelediği kara orman peşimi bırakmıyordu."


translate turkish d5_ending_mad_world_afterdev_57e24f20:



    voice "voice/anton/5day/139.Vi.ogg"
    Ant "Parmak izi bulabildiniz mi?"


translate turkish d5_ending_mad_world_afterdev_7347bcf5:



    voice "voice/anton/5day/139.Oni.ogg"
    Ant "Kırda, evimizin ön tarafında dolaşıyorlardı."


translate turkish d5_ending_mad_world_afterdev_ff8612e1:



    voice "voice/tihonov/5day/18 Oni.ogg"
    Tikhonov "Başladı yine yahu!"


translate turkish d5_ending_mad_world_afterdev_325d6ff2:


    "Üsteğmen Tihonov gözlerini devirdi."


translate turkish d5_ending_mad_world_afterdev_bb1322f0:



    voice "voice/tihonov/5day/19 Sn.ogg"
    Tikhonov "Fırtına yüzünden eviniz çatıya kadar karla kaplanmıştı!"


translate turkish d5_ending_mad_world_afterdev_2ab23176:



    voice "voice/tihonov/5day/20 Ee.ogg"
    Tikhonov "Ne failleri ne de parmak izlerini bulamayız..."


translate turkish d5_ending_mad_world_afterdev_11a2fca5:



    voice "voice/anton/5day/140.SprPol.ogg"
    Ant "Polina'ya sorun."


translate turkish d5_ending_mad_world_afterdev_fd839b65:



    voice "voice/anton/5day/140.SprRom.ogg"
    Ant "Roma'ya sorun."


translate turkish d5_ending_mad_world_afterdev_7dc85d48:



    voice "voice/Anton/5day/298 oni.ogg"
    Ant "Polina da Romka da olanları gördü..."


translate turkish d5_ending_mad_world_afterdev_519060fc:



    voice "voice/Anton/5day/299 ona.ogg"
    Ant "Polina olanları gördü..."


translate turkish d5_ending_mad_world_afterdev_51c7563e:



    voice "voice/Anton/5day/300 on.ogg"
    Ant "Roma olanları gördü..."


translate turkish d5_ending_mad_world_afterdev_5a8307d9:



    voice "voice/tihonov/5day/21 Ti.ogg"
    Tikhonov "İşimi nasıl yapacağımı sana mı soracağım?"


translate turkish d5_ending_mad_world_afterdev_2b0dc9f3:



    voice "voice/tihonov/5day/22 Sp.ogg"
    Tikhonov "Sorduk zaten."


translate turkish d5_ending_mad_world_afterdev_6991876a:



    voice "voice/tihonov/5day/23 On.ogg"
    Tikhonov "Kurduğun barikatları görmüşler."


translate turkish d5_ending_mad_world_afterdev_70ad7504:



    voice "voice/tihonov/5day/06 Ona.ogg"
    Tikhonov "Kurduğun barikatları görmüş."


translate turkish d5_ending_mad_world_afterdev_18ff980d:



    voice "voice/tihonov/5day/04 On.ogg"
    Tikhonov "Kurduğun barikatları görmüş."


translate turkish d5_ending_mad_world_afterdev_2941b80c:



    voice "voice/tihonov/5day/24 No.ogg"
    Tikhonov "Ancak senin o sirk hayvanlarından tek kelime etmedi!"


translate turkish d5_ending_mad_world_afterdev_e59da802:


    "Böyle bir şey nasıl olur? Onlar da mı canavarların tarafındaydı?"


translate turkish d5_ending_mad_world_afterdev_ce42200e:


    "Böyle bir şey nasıl olur? O da mı canavarların tarafındaydı?"


translate turkish d5_ending_mad_world_afterdev_ef337dab:


    "Böyle bir şey nasıl olur? O da mı canavarların tarafındaydı?"


translate turkish d5_ending_mad_world_afterdev_9d736e35:


    "Julka'nın içinde kıvranan o asalağı hatırladım."


translate turkish d5_ending_mad_world_afterdev_3280814f:



    voice "voice/anton/5day/143.Vmus.ogg"
    Ant "Çöp kutusuna bakın. Köpeğin içinden çıkan yaratık oradaydı."


translate turkish d5_ending_mad_world_afterdev_eea4f3b6:



    voice "voice/tihonov/5day/25 Es.ogg"
    Tikhonov "Katlettiğin sokak köpeğinden mi bahsediyorsun?"


translate turkish d5_ending_mad_world_afterdev_e4a9c4ae:



    voice "voice/tihonov/5day/26 Mu.ogg"
    Tikhonov "Onu buzlukta bulduk ancak çöpte yaratık maratık yoktu."


translate turkish d5_ending_mad_world_afterdev_012ce875:



    voice "voice/anton/5day/144.Na.ogg"
    Ant "Ormandan gelen canavarlar almıştır."


translate turkish d5_ending_mad_world_afterdev_6db1abbb:


    "Polina'ya sarılmayı öyle istiyordum ki kollarımı havaya açıp göğsümde kavuşturdum."


translate turkish d5_ending_mad_world_afterdev_a2f8268c:


    "Romka'ya sarılmayı öyle istiyordum ki kollarımı havaya açıp göğsümde kavuşturdum."


translate turkish d5_ending_mad_world_afterdev_dbefd125:


    "Olya'ya sarılmayı öyle istiyordum ki kollarımı havaya açıp göğsümde kavuşturdum."


translate turkish d5_ending_mad_world_afterdev_5035fe38:


    "Üsteğmen, diğer memurlarla anlamlı anlamlı bakıştı."


translate turkish d5_ending_mad_world_afterdev_ea64e8c5:


    "Tihonov'un sesi yumuşamıştı ancak sanki dile getirmek istediği başka bir konu daha vardı."


translate turkish d5_ending_mad_world_afterdev_770a5429:



    voice "voice/tihonov/5day/27 Ti.ogg"
    Tikhonov "Bu ne biliyor musun?"


translate turkish d5_ending_mad_world_afterdev_184ba62d:


    "Önüme hap dolu plastik bir kutu koydu."


translate turkish d5_ending_mad_world_afterdev_8a21885e:



    voice "voice/anton/5day/145.Vit.ogg"
    Ant "Vitamin haplarım."


translate turkish d5_ending_mad_world_afterdev_54f5bd3f:



    voice "voice/tihonov/5day/28 A.ogg"
    Tikhonov "Peki şizofreni nedir biliyor musun?"


translate turkish d5_ending_mad_world_afterdev_ff55cb0f:



    voice "voice/anton/5day/146.Ps.ogg"
    Ant "Akıl hastalığı mı?"


translate turkish d5_ending_mad_world_afterdev_e5050900:



    voice "voice/tihonov/5day/29 Em.ogg"
    Tikhonov "Aynen evlat. Hastalık."


translate turkish d5_ending_mad_world_afterdev_05ba1783:



    voice "voice/tihonov/5day/30 Ee.ogg"
    Tikhonov "Bilişsel işlev ve duygu yönetim bozukluğu ile sanrılar yaşatır..."


translate turkish d5_ending_mad_world_afterdev_0df2548f:


    "Konuyu nereye çektiğini anlamamıştım."


translate turkish d5_ending_mad_world_afterdev_68db3305:


    "Bunların benimle ne alakası vardı?"


translate turkish d5_ending_mad_world_afterdev_c0f5a508:



    voice "voice/tihonov/5day/31 Est.ogg"
    Tikhonov "Bu hastalığı yatıştırabilen ilaçlar var."


translate turkish d5_ending_mad_world_afterdev_fe4cf860:



    voice "voice/tihonov/5day/32 No.ogg"
    Tikhonov "Ancak her zaman işe yaramayabiliyorlar."


translate turkish d5_ending_mad_world_afterdev_04bc8d63:


    "Kollarımı göğsümden ayırmayı, dudaklarımı yalayıp durmayı bırakmam gerekiyordu ancak dürtülerimle başa çıkamıyordum."


translate turkish d5_ending_mad_world_afterdev_e7ba0b4d:



    voice "voice/anton/5day/147.Ya.ogg"
    Ant "Kara Garaj'ı da gördüm."


translate turkish d5_ending_mad_world_afterdev_69f70fcd:


    "Üsteğmen Tihonov çakmağını çakıp bir sigara yaktı."


translate turkish d5_ending_mad_world_afterdev_d7ea217a:


    "Öksürmeye başlamamla sırıttı."


translate turkish d5_ending_mad_world_afterdev_ade4c13b:



    voice "voice/tihonov/5day/33 Cho.ogg"
    Tikhonov "Kara Garaj bir şehir efsanesidir."


translate turkish d5_ending_mad_world_afterdev_a07c5cee:



    voice "voice/tihonov/5day/34 Ya.ogg"
    Tikhonov "\"Kriminal Haberler\" diye bir gazete okuyorum. Yurt dışındaki seri katillerle ilgili yazılar yayımlıyorlar sık sık."


translate turkish d5_ending_mad_world_afterdev_9325f59e:



    voice "voice/tihonov/5day/35 Pra.ogg"
    Tikhonov "Mevzunun aslı şu ki yirmi küsur yıl önce Herbert Mullin adlı Amerikalı bir adam, depremi önlemek için bir düzine insanı katletmiş."


translate turkish d5_ending_mad_world_afterdev_087ebf5e:



    voice "voice/tihonov/5day/36 Dr.ogg"
    Tikhonov "Bir diğer seri katil olan Richard Chase de Nazilerle iş birliği yapan hapishane çalışanlarının, yemeğine zehir kattığını düşünüp bundan kurtulmak için kurbanlarının kanını içiyormuş."


translate turkish d5_ending_mad_world_afterdev_c533dcbd:



    voice "voice/anton/5day/150.Ya.ogg"
    Ant "Hiçbirini tanımıyorum."


translate turkish d5_ending_mad_world_afterdev_13e238cc:


    "Üsteğmenin yalancıktan kurduğu sempati, sesinden belli oluyordu."


translate turkish d5_ending_mad_world_afterdev_4a76553b:



    voice "voice/tihonov/5day/37 O.ogg"
    Tikhonov "Tanımazsın tabii."


translate turkish d5_ending_mad_world_afterdev_cfb7d8d4:



    voice "voice/tihonov/5day/38 No.ogg"
    Tikhonov "Ancak annesiyle babası boşanmanın eşiğine gelmiş, son derece hasta ve hüzünlü bir çocuk tanıyorsundur. Stres de yarasına tuz basıyordur."


translate turkish d5_ending_mad_world_afterdev_b0846e33:



    voice "voice/tihonov/5day/39 On.ogg"
    Tikhonov "Bu yüzden zihninde konuşan hayvanlar uydurmuştur. Sonra da onlarla arkadaş olmuştur."


translate turkish d5_ending_mad_world_afterdev_65fc9aa1:


    "Üsteğmen Tihonov sigarasından büyük bir fırt alıp dumanı üfledi."


translate turkish d5_ending_mad_world_afterdev_8a8b2b06:



    voice "voice/anton/5day/151.Net.ogg"
    Ant "Hayır..."


translate turkish d5_ending_mad_world_afterdev_71aa886d:


    "Görüşüm bulanıklaşmış, düşüncelerim karman çorman olmuştu."


translate turkish d5_ending_mad_world_afterdev_ca171d8e:


    "Alisa'yla ormanın tepesinde gayet de süzülmüştük!"


translate turkish d5_ending_mad_world_afterdev_b7f32bde:


    "Ayaz Baba'nın sarayında da bulunmuştum!"


translate turkish d5_ending_mad_world_afterdev_9049c216:


    "Hatta..."


translate turkish d5_ending_mad_world_afterdev_c6e7be2c:



    voice "voice/tihonov/5day/41 Pos.ogg"
    Tikhonov "Semyon kaybolduğundan beri gözümüz üzerindeydi."


translate turkish d5_ending_mad_world_afterdev_e4ae3fbd:



    voice "voice/tihonov/5day/42 ta.ogg"
    Tikhonov "Çünkü tuhaf, içine dönük bir çocuktun... Ancak yeterince kanıtımız yoktu."


translate turkish d5_ending_mad_world_afterdev_b80cb1b0:



    voice "voice/tihonov/5day/43 Da.ogg"
    Tikhonov "Katya kaybolduğunda bile..."


translate turkish d5_ending_mad_world_afterdev_add94fb4:



    voice "voice/anton/5day/152.Vr.ogg"
    Ant "Yalan söylüyorsunuz!"


translate turkish d5_ending_mad_world_afterdev_8ad55f83:


    "O yalancı jandarma bozmasının üstüne atıldım ancak yanındaki memur beni yerime geri oturtuverdi."


translate turkish d5_ending_mad_world_afterdev_3129cfca:


    "Hüsrandan göğsüm sıkışmıştı."


translate turkish d5_ending_mad_world_afterdev_d4422e94:


    "Ağzımda çiğ insan parmağı gibi acı mı acı, katlanılmaz bir tat vardı..."


translate turkish d5_ending_mad_world_afterdev_448cd602:


    "İyi de insan etinin tadını nereden biliyordum?"


translate turkish d5_ending_mad_world_afterdev_d51715d4:


    "Şakaklarımı ovdum."


translate turkish d5_ending_mad_world_afterdev_61c09540:


    "Resmen beynim eriyordu."


translate turkish d5_ending_mad_world_afterdev_0da187f8:



    voice "voice/tihonov/5day/44 Mal.ogg"
    Tikhonov "O çocuk hasımlarını icabına bakmıştı."


translate turkish d5_ending_mad_world_afterdev_149a856c:



    voice "voice/tihonov/5day/45 No.ogg"
    Tikhonov "Ancak hayalindeki yaratıklar bununla yetinmemişti."


translate turkish d5_ending_mad_world_afterdev_5ad296ff:



    voice "voice/tihonov/5day/46 Oni.ogg"
    Tikhonov "Çocuğu zorladılar..."


translate turkish d5_ending_mad_world_afterdev_8ca06b01:



    voice "voice/anton/5day/156.Zam.ogg"
    Ant "Susun be!"


translate turkish d5_ending_mad_world_afterdev_503fdd3a:


    "Üsteğmen sigarasını küllüğe bastırdı."


translate turkish d5_ending_mad_world_afterdev_1e13d3f9:



    voice "voice/tihonov/5day/48 Zaru.ogg"
    Tikhonov "... ve o da tek dostunu parçalara ayırdı."


translate turkish d5_ending_mad_world_afterdev_25b999de:



    voice "voice/tihonov/5day/49 Zarub.ogg"
    Tikhonov "... ve o da sevgilisini parçalara ayırdı."


translate turkish d5_ending_mad_world_afterdev_cd3335b3:



    voice "voice/tihonov/5day/47 Zar.ogg"
    Tikhonov "... ve o da kardeşini parçalara ayırdı."


translate turkish d5_ending_mad_world_afterdev_4f5e6244:


    "Alt dudağımı parmaklarımla çekip yanaklarımı gerdirerek dehşetle inildedim."


translate turkish d5_ending_mad_world_afterdev_5ceabbf2:



    voice "voice/tihonov/5day/50 Sem.ogg"
    Tikhonov "Semyon'u ormanda gafil avladın."


translate turkish d5_ending_mad_world_afterdev_2bfd6de7:



    voice "voice/tihonov/5day/53 Kat.ogg"
    Tikhonov "Dedikodu anlatacağım diye kandırıp Katya'yı da okuldan uzak bir yere götürdün."


translate turkish d5_ending_mad_world_afterdev_7993caa7:



    voice "voice/tihonov/5day/51 Vov.ogg"
    Tikhonov "Vova'yla da ormanda dolaşırken karşılaştın."


translate turkish d5_ending_mad_world_afterdev_9ca4a0e6:



    voice "voice/tihonov/5day/52 Voz.ogg"
    Tikhonov "Oyuncak silahıyla oynamak istedin de izin vermedi belki, kim bilir."


translate turkish d5_ending_mad_world_afterdev_aff08a99:



    voice "voice/anton/5day/158.Per.ogg"
    Ant "Yeter!"


translate turkish d5_ending_mad_world_afterdev_92583479:



    voice "voice/tihonov/5day/54 Sl.ogg"
    Tikhonov "Seneçka daha zorlu bir vaka tabii."


translate turkish d5_ending_mad_world_afterdev_04ed8051:



    voice "voice/tihonov/5day/55 ona.ogg"
    Tikhonov "Kızcağız sen köye taşınmadan önce kayboldu. Epeydir şaşkınız... Ancak şimdi hatırladım."


translate turkish d5_ending_mad_world_afterdev_7360cff6:



    voice "voice/tihonov/5day/56 Tv.ogg"
    Tikhonov "Nenen burada gömülüydü değil mi?"


translate turkish d5_ending_mad_world_afterdev_221f9300:



    voice "voice/anton/5day/159.Eto.ogg"
    Ant "Yok öyle bir şey! Hayal görüyorsunuz!"


translate turkish d5_ending_mad_world_afterdev_c12a86ee:


    "Üsteğmen Tihonov dibime kadar sokuldu."


translate turkish d5_ending_mad_world_afterdev_32cad7ae:


    "Losyon ve tütün kokusu burnuma nüfuz etti."


translate turkish d5_ending_mad_world_afterdev_eed4fc45:


    "Acımasız bakışlarla beni süzerek fısıldadı."


translate turkish d5_ending_mad_world_afterdev_451196ce:



    voice "voice/tihonov/5day/57 Ti.ogg"
    Tikhonov "Köye aralık ayında gelmiştin."


translate turkish d5_ending_mad_world_afterdev_aeb9808f:



    voice "voice/tihonov/5day/58 Pro.ogg"
    Tikhonov "Nenenin mezarını ziyaret etmeye."


translate turkish d5_ending_mad_world_afterdev_721eb8da:



    voice "voice/tihonov/5day/59 Tam.ogg"
    Tikhonov "Senya'yı da o vakit görmüşsündür."


translate turkish d5_ending_mad_world_afterdev_856d6262:


    "Mezarlık yolundaki kumaş parçalarını hatırladım."


translate turkish d5_ending_mad_world_afterdev_891d1506:


    "Avazım çıktığı kadar bağırdım."


translate turkish d5_ending_mad_world_afterdev_63d207b6:


    "Üsteğmen geri çekilip bir sigara daha yaktı."


translate turkish d5_ending_mad_world_afterdev_c45465a3:



    voice "voice/tihonov/5day/60 Ad.ogg"
    Tikhonov "Anılar insana acı verir."


translate turkish d5_ending_mad_world_afterdev_db77d2ba:



    voice "voice/tihonov/5day/61 Ya.ogg"
    Tikhonov "Sana vereceğim hiçbir ceza, günahlarınla yaşamaktan daha ağır olamaz."


translate turkish d5_ending_mad_world_afterdev_d4c1bff0:



    voice "voice/tihonov/5day/62 Uv.ogg"
    Tikhonov "Alın şunu!"


translate turkish d5_ending_mad_world_afterdev_91edd27c:



    voice "voice/anton/5day/161.Eto.ogg"
    Ant "Beni kandırdılar! Hepsi onların suçu!"


translate turkish d5_ending_mad_world_afterdev_95c054ab:



    voice "voice/anton/5day/161.Po.ogg"
    Ant "Lütfen inanın bana!"


translate turkish d5_ending_mad_world_afterdev_a8ca38ff:



    voice "voice/anton/5day/162.Let.ogg"
    Ant "Memur bey!"


translate turkish d5_ending_mad_world_aftertitles_40abc550:


    "Hastane odası geniş ve aydınlıktı."


translate turkish d5_ending_mad_world_aftertitles_4dca6f57:


    "Her yer bembeyazdı. Kış geçmek bilmiyordu sanki."


translate turkish d5_ending_mad_world_aftertitles_526eeef0:


    "Yemekler fena değildi ancak çoğunlukla sıvıydı. Sağlık görevlilerinin yemekhaneye geçirdiği komşularımın çoğu, katı gıda çiğneyebilecek dişlere sahip değildi."


translate turkish d5_ending_mad_world_aftertitles_01f77262:


    "Bazısı pipetle besleniyordu. Çoğuyla koridorda sıklıkla karşılaşıyordum."


translate turkish d5_ending_mad_world_aftertitles_6f7a94ea:


    "Pasaklı üst başlarıyla banklarda uyuyor, duvarları tırmalıyorlardı."


translate turkish d5_ending_mad_world_aftertitles_3d981604:


    "Huzursuzluk çıkaranlar da yastıklı odaya, hatta daha kötüsü olan bodruma tıkılıyordu."


translate turkish d5_ending_mad_world_aftertitles_1568c4cc:


    "Sonra da suspus oluyorlar, oyuncak bebek gibi çıt çıkarmadan oturuyorlardı."


translate turkish d5_ending_mad_world_aftertitles_690f0bc8:


    "Tabii ben hep uslu duruyordum."


translate turkish d5_ending_mad_world_aftertitles_705b8856:


    "Çıkıntılık yapanlar gibi copla dövülmüyordum."


translate turkish d5_ending_mad_world_aftertitles_99703f04:


    "Ancak aynı odayı paylaştığım kişiler korkunç derecede kaba davranabiliyordu."


translate turkish d5_ending_mad_world_aftertitles_d7f71e9f:


    "Bazısının rahatsızlığı şi... şifo... Bazı kelimeleri artık hatırlayamıyordum... Neyse, bazısı da {u}askerlikten{/u} kaçmak için buradaydı."


translate turkish d5_ending_mad_world_aftertitles_159e9c74:


    "O sahtekarlar eski sınıf arkadaşlarım gibi bana yok yere zulüm ediyordu."


translate turkish d5_ending_mad_world_aftertitles_dc67d0fa:


    "Sigaralarını çıplak tenimde söndürüyor, bana zorla çamaşır yıkatıp kahkahalara boğuluyorlardı."


translate turkish d5_ending_mad_world_aftertitles_506e5f31:


    "Bir gün köylü dangalağın teki uykumda bana tecavüz etmeye kalktı."


translate turkish d5_ending_mad_world_aftertitles_e0400283:


    "O günden beri gözüme uyku da girmiyor."


translate turkish d5_ending_mad_world_aftertitles_fcbc7ec5:


    "Memur beyin sözlerini düşünüp duruyordum. Amma saf herifmiş."


translate turkish d5_ending_mad_world_aftertitles_f06dc193:


    "O maskeler de, Kara Garaj da ormanda oynaşan hayvanlar da... Hepsi gerçekti."


translate turkish d5_ending_mad_world_aftertitles_2d0cbde8:


    "Öyle olmasaydı bir içim su dediğim kızı neden katlederdim ki?"


translate turkish d5_ending_mad_world_aftertitles_21cef860:


    "Öyle olmasaydı en yakın dostumu neden katlederdim ki?"


translate turkish d5_ending_mad_world_aftertitles_139170b3:


    "Öyle olmasaydı en sevdiğim insanı neden katlederdim ki?"


translate turkish d5_ending_mad_world_aftertitles_a7874968:


    "Bu, delilik olmaz mıydı?"


translate turkish d5_ending_mad_world_aftertitles_b482a8f3:


    "Koridordan bir çığlık yükseldi."


translate turkish d5_ending_mad_world_aftertitles_58ef3e6d:


    "Ancak hiç oralı olmadım."


translate turkish d5_ending_mad_world_aftertitles_62ba1e67:


    "Baharın gelmesini bekliyordum."


translate turkish d5_ending_mad_world_aftertitles_f211bcc6:


    "Odamın tek penceresindeki parmaklıkların arasından dışarıya bakıyordum."


translate turkish d5_ending_mad_world_aftertitles_968e717a:


    "Cemre hiç düşmezse diye korkuyordum."


translate turkish d5_ending_mad_world_aftertitles_e9f3f775:


    "Çok, çok uzaklardan bir flüt sesi gelmeye başladı."


translate turkish d5_ending_mad_world_aftertitles_8c6d2328:


    "Bir de ne göreyim..."


translate turkish d5_ending_apocalypse_965bb1fa:


    "Gözümden tek bir damla yaş süzülüp yanağımda düştüğü yeri sülfürik asit gibi yaktı."


translate turkish d5_ending_apocalypse_20972997:


    "İçim dağlanmıştı."


translate turkish d5_ending_apocalypse_01b80f7f:


    "Gözümü kırpmadan Olya'ya bakıyordum."


translate turkish d5_ending_apocalypse_9167ec39:


    "Olya'nın cansız bedenine."


translate turkish d5_ending_apocalypse_095e159e:


    "Gözlerini hayata yummuştu. Saçı kana bulanmıştı ancak yüzü hala pek berrak, pek huzurluydu."


translate turkish d5_ending_apocalypse_7ed1f1f7:


    "Kafatası, çikolatalı yumurta gibi içine göçmüştü."


translate turkish d5_ending_apocalypse_35b01201:


    "Ancak çikolatalı yumurtanın beyni olmazdı. İçine böyle kemik, saç batmazdı."


translate turkish d5_ending_apocalypse_d3cdc692:


    "Başındaki yara olmasa kardeşimin uyuduğunu sanırdım."


translate turkish d5_ending_apocalypse_94a16171:



    voice "voice/Anton/5day/301 hn.ogg"
    "Sızlanıyordum."


translate turkish d5_ending_apocalypse_7b21e1e9:


    "Kardeşimi kendi ellerimle katletmiştim. Annemle babamı kurtaramamıştım. Ailemizi mahvetmiştim."


translate turkish d5_ending_apocalypse_d49bff7f:


    "Üsteğmen Tihonov'un önderliğinde bir grup yetişkinin evimize dalmasını düşlüyordum."


translate turkish d5_ending_apocalypse_994c07a6:


    "Elimdeki baltayı görüp idam mangasının beni ölümle cezalandırmasını istiyordum."


translate turkish d5_ending_apocalypse_c9b0e1fe:


    "İçimde bunca zamandır uyuyan sinsi varlık, bu düşüncelere kapıldığım gibi dudaklarımın kontrolünü ele geçirdi ve yüzüme çirkin bir gülüş kondurdu."


translate turkish d5_ending_apocalypse_08dd6ad2:



    voice "voice/bunny/20 T.ogg"
    Bunny "Ölümü değil, en güzel mükafatları hak ediyorsun."


translate turkish d5_ending_apocalypse_a5f3d044:



    voice "voice/bunny/21 Ti.ogg"
    Bunny "Doğru olanı yaptın Anton. Fedakarlıkta bulunman gerekiyordu. Her fedakarlığın haklı bir gerekçesi vardır."


translate turkish d5_ending_apocalypse_c8c7fa15:



    voice "voice/anton/5day/27 ti.ogg"
    Bunny "İntikamını alacaksın. Sabırlı ol..."


translate turkish d5_ending_apocalypse_81c67654:



    voice "voice/Anton/5day/301 Kog.ogg"
    Ant "Ne zaman?"


translate turkish d5_ending_apocalypse_bc2d89ef:



    voice "voice/anton/5day/28 p.ogg"
    Bunny "Çok geçmeden dostum. Aradan biraz zaman geçsin..."


translate turkish d5_ending_apocalypse_4a0deb54:



    voice "voice/anton/5day/29 t.ogg"
    Bunny "Hâlâ güçsüzsün. Daha da kuvvetlenmelisin."


translate turkish d5_ending_apocalypse_d045b35c:



    voice "voice/anton/5day/30 e.ogg"
    Bunny "Şu an ölürsen canciğer kuzu sarması hayvanları kim besleyecek?"


translate turkish d5_ending_apocalypse_12fe95a5:



    voice "voice/anton/5day/22 v.ogg"
    Bunny "Şimdi karınlarını doyurma zamanı."


translate turkish d5_ending_apocalypse_6501d0df:


    "Baltayı parkelere pat diye bıraktım. Ancak Olya bu sese rağmen uyanmadı. Çünkü huzur içinde yatıyordu..."


translate turkish d5_ending_apocalypse_391365ff:


    "İçimdeki ses gittiğim yerde giysiye ihtiyacım olmayacağını vurgulamasına rağmen montumu giydim."


translate turkish d5_ending_apocalypse_9eb122ee:


    "Eğilip Olya'yı boynu ve dizlerinin altından tuttum."


translate turkish d5_ending_apocalypse_34c2d582:


    "Ağzımdan kardeşimin göğsüne azıcık salya damladı."


translate turkish d5_ending_apocalypse_533cf5ba:



    voice "voice/anton/5day/23 s.ogg"
    Bunny "Demek ağzımız sulanıyor!"


translate turkish d5_ending_apocalypse_32024df3:


    "Olya'cığım..."


translate turkish d5_ending_apocalypse_e9bb3a8c:


    "Abilik görevimi yapmalı, onu korumalıydım."


translate turkish d5_ending_apocalypse_679350fa:


    "Ancak görevler bizi aciz kılar."


translate turkish d5_ending_apocalypse_493677ba:


    "Güce giden yol, özgürlükte yatar. Olya da artık özgür biriydi."


translate turkish d5_ending_apocalypse_f5059d19:


    "Kardeşimin göz kapaklarını, elmacık kemiklerini gölgeler işgal etmişti."


translate turkish d5_ending_apocalypse_ce58476c:


    "Cansız birinin resmi... Portre mi yoksa natürmort mu sayılırdı?"


translate turkish d5_ending_apocalypse_1845de20:


    "Kardeşimi kucakladım. Tüy kadar hafifti."


translate turkish d5_ending_apocalypse_911ee0eb:


    "Hep mis gibi kokan saçları demir ve pek güzel kan kokuyordu."


translate turkish d5_ending_apocalypse_98b9444d:


    "Olya'nın başı aşağı sarkıyordu."


translate turkish d5_ending_apocalypse_e2435002:


    "Annemin Olya'yı bebekken kucağıma verdiği anları hatırladım."


translate turkish d5_ending_apocalypse_01cfcd68:


    "O zamanlar \"Böyle minik, tatlı insan mı olur?\" diye düşünürdüm."


translate turkish d5_ending_apocalypse_26e9bf08:


    "Artık insan değildi tabii."


translate turkish d5_ending_apocalypse_f31432d4:


    "Bu benim eserimdi. Bir insanı buz gibi, vıcık vıcık ve tatlı bir cansız bedene çevirmiştim."


translate turkish d5_ending_apocalypse_836a2405:


    "Eğilip üşüyen yanağına tuhaf bir öpücük kondurdum. Hâlâ yumuşacıktı."


translate turkish d5_ending_apocalypse_53a8a5ea:



    voice "voice/anton/5day/31 ot.ogg"
    Bunny "Bir ısırık alsana."


translate turkish d5_ending_apocalypse_6962ca5a:


    "Arkamdaki kapı pat diye açılıp içeriye rüzgar doluştu. Koridor karla kaplandı."


translate turkish d5_ending_apocalypse_dc647a1e:


    "Kucağımdaki dehşet verici bedenle fırtınaya temkinli bir adım attım."


translate turkish d5_ending_apocalypse_1fdd644b:


    "Olya, dört harf."


translate turkish d5_ending_apocalypse_81f245b8:


    "Mama da dört harfliydi."


translate turkish d5_ending_apocalypse_7c78c1c6:


    "Kapının önüne çıktım. Dünya değişmişti. Yaptıklarımdan sonra nasıl aynı kalırdı zaten?"


translate turkish d5_ending_apocalypse_c5c96464:


    "Biçimsiz bir kitle köpürüp kabarıyordu."


translate turkish d5_ending_apocalypse_af966151:


    "\"Orman esas kılığına girmiş,\" diye düşündüm."


translate turkish d5_ending_apocalypse_9dc1b671:


    "Yeni evim burasıydı."


translate turkish d5_ending_apocalypse_fa87fd22:


    "Ağaçlar, karanlıkta avına usul usul yaklaşıyor gibiydi. Buz gibi toprakta biten kapkalın kökleri, karda korkunç çizgiler çekmişti sanki."


translate turkish d5_ending_apocalypse_de42cf33:


    "Dünyanın iştahı kabarmıştı. Eğri büğrü çamlarla aramda ise çocukları dikiliyordu."


translate turkish d5_ending_apocalypse_111dd520:


    "Muazzam bir hal almalarına rağmen pek tanıdık, pek samimi görünüyorlardı..."


translate turkish d5_ending_apocalypse_dbdb653c:


    "İzlediğim patika, izbandut suretlere uzanıyordu. Karların eridiği bir diyarda ince bir şeridi takip ediyordum."


translate turkish d5_ending_apocalypse_3cb6bf4a:


    "Kaskatı kesilen toprak, dev bir kertenkelenin pullarını andırıyordu. Ayaklarımın altında bir yükseliyor bir alçalıyordu."


translate turkish d5_ending_apocalypse_2d8eac31:


    "Yanına geldiğim yaratık nefes alıp veriyordu."


translate turkish d5_ending_apocalypse_e58a4031:



    voice "voice/Alisa/5day/03 Mi.ogg" 
    Alis "Hoş geldin Tavşancık."


translate turkish d5_ending_apocalypse_fb60bda6:



    voice "voice/Owl/40 Uh.ogg" 
    Owl "Demek böyle görünüyormuşsun, u-uh."


translate turkish d5_ending_apocalypse_9269f363:



    voice "voice/Wolf/125 k.ogg"
    Wolf "Zarrrif."


translate turkish d5_ending_apocalypse_28c01768:


    "Ağırlığını yoklarcasına Olya'yı kaldırdım."


translate turkish d5_ending_apocalypse_1e185807:



    voice "voice/Anton/5day/304 eto.ogg"
    Ant "Kardeşim. Onu çok seviyorum."


translate turkish d5_ending_apocalypse_6d34d9ac:



    voice "voice/Alisa/5day/04 E.ogg" 
    Alis "Biz de seviyoruz... Getir bakalım."


translate turkish d5_ending_apocalypse_2533fbef:


    "Rüzgar suratıma şamar gibi iniyordu. Kor kokusuyla sümüklerimi eritiyordu."


translate turkish d5_ending_apocalypse_0f0558ef:


    "Yukarıdan kulak tırmalayan bir ses yükseldi. Biraz sivil savunma sirenlerini, biraz da acıyla inildeyen bir kadını andırmıştı."


translate turkish d5_ending_apocalypse_9792d046:


    "Kıvranıp duran milyonlarca solucanı andıran gökyüzüne baktım. Olya gibi canlılığını yitiren gökyüzü, larvaların istilasına uğramıştı."


translate turkish d5_ending_apocalypse_0d353560:


    "Sapsarı ve yuvarlak ay, cansız bir bedenden pörtleyen göz gibi ormanın tepesinde asılıydı."


translate turkish d5_ending_apocalypse_6a0f85f7:


    "Ay, yaptıklarıma tanık olmuş, feryatlara boğulmuştu. Resmen kan ağlıyordu."


translate turkish d5_ending_apocalypse_1045b8cc:


    "Rüzgarda tüy gibiydim. Olya'sız hayat da tam olarak böyleymiş belli ki."


translate turkish d5_ending_apocalypse_80c3258f:


    "Feryat eden ay, çürükler bağlayan gökyüzü, tahtalıköyü sırtında taşıyan tayga..."


translate turkish d5_ending_apocalypse_2a556259:


    "Yaratığın gölgesi hem benim hem de kardeşimin cansız bedeni üstüne düşmüştü."


translate turkish d5_ending_apocalypse_af027513:



    voice "voice/Alisa/5day/05 Sp.ogg" 
    Alis "Sağ ol Tavşancık. Senden hiç kuşku duymadım. Müsaade eder misin?"


translate turkish d5_ending_apocalypse_65c8f9e7:


    "Bakışlarım korkunç silüetler arasında geziyordu. Bir ileri bir geri gidiyorlar, göz kırptığım her an yer değiştiriyorlardı."


translate turkish d5_ending_apocalypse_9548cd7c:


    "Burada bir tuhaflık var. Bu canavarlar beni her an paramparça edebilir."


translate turkish d5_ending_apocalypse_b15357f2:



    voice "voice/anton/5day/24 ra.ogg"
    Bunny "Arkadaş dediğin nasıl davranır?"


translate turkish d5_ending_apocalypse_b4c2f39e:



    voice "voice/anton/5day/25 p.ogg"
    Bunny "İyi bak. Onlar senin ailen, senin kanından..."


translate turkish d5_ending_apocalypse_d4cebdea:



    voice "voice/anton/5day/26 d.ogg"
    Bunny "Güven onlara. Buradan dönüş yok. İş işten geçti. Eti ikram et. Nazik davranırlar elbet. Eti ikram et."


translate turkish d5_ending_apocalypse_265174f8:


    "Uyuşup kana bulanan ellerim boştu."


translate turkish d5_ending_apocalypse_e1b2c5be:


    "Tilki kılıklı aç yaratık, kardeşimin bedenine yaslanmıştı."


translate turkish d5_ending_apocalypse_93b0e405:


    "Kemik çıtırtıları yükseldi."


translate turkish d5_ending_apocalypse_65090373:


    "İğrenç bir kırkayak gerindi ve orak gibi çenesini şaklattı."


translate turkish d5_ending_apocalypse_2a85d47d:


    "Kardeşimin karnını yarıp bir yandan da dişlerini Olya'nın solgun yüzüne geçirdiler."


translate turkish d5_ending_apocalypse_b1e03161:


    "Şaşkınlıktan bakışlarımı o manzaradan ayıramamıştım bile."


translate turkish d5_ending_apocalypse_c9e96ca5:


    "Alisa bağırsakları yana savurdu."


translate turkish d5_ending_apocalypse_f0c3c02d:



    voice "voice/Alisa/5day/08 Pr.ogg" 
    Alis "Afiyet olsun!"


translate turkish d5_ending_apocalypse_4c2c4254:


    "Baykuş da fırlayıp o gri, vıcık vıcık sosislere sarıldı. Leşçil bir it gibi her birini iştahla mideye indirdi."


translate turkish d5_ending_apocalypse_528b0439:


    "Tilki, kardeşimin uzuvlarını teker teker koparıyordu. Pençelere dayanamayan sinirler kopuyordu."


translate turkish d5_ending_apocalypse_448ce9e2:


    "Kanlı insan eti parçaları yerlere saçılıyordu."


translate turkish d5_ending_apocalypse_8b1cb495:


    "Kardeşimin cansız bedeninden fışkıran pıhtılaşmamış kanlar, ayaklarıma doğru akıyordu."


translate turkish d5_ending_apocalypse_3607a6e9:


    "Olya'nın başı, vücuduna küçük bir deri parçasıyla tutunmuş, sarkıyordu."


translate turkish d5_ending_apocalypse_6e770e0a:


    "Boynundaki mor bir boru da gözler önüne serilmişti."


translate turkish d5_ending_apocalypse_d0804750:


    "\"İçinde amma çok şey varmış,\" diye düşündüm."


translate turkish d5_ending_apocalypse_1cf5f603:


    "İç organları boşaltılırken ya kardeşimin gözleri açılmış ya da Alisa, göz kapaklarını koparıp atmıştı."


translate turkish d5_ending_apocalypse_5217a850:


    "Olya bana boş boş bakıyordu. Kafası sarkaç gibi sallanıyordu. Ben de onunla birlikte sallanıyordum."


translate turkish d5_ending_apocalypse_98938c51:


    "Yaratıklar yemek hazırlıyordu. Dev bir ziyafet çekeceklerdi. Cüzzamlı gezegenin hatırına akşam yemeği düzenliyorlardı."


translate turkish d5_ending_apocalypse_12ed03dd:



    voice "voice/Bear/5day/Da.ogg"
    Bear "Bu kadarı yetmez ki..."


translate turkish d5_ending_apocalypse_aa7644d5:


    "Ayı suretini kısmen koruyan yaratık, pembe karların üstünde birkaç oyuncak bebek sürüklüyordu. Ne var ki oyuncak değillermiş..."


translate turkish d5_ending_apocalypse_a4dfa4bf:



    voice "voice/Bear/5day/Za.ogg"
    Bear "Anneye... Babaya..."


translate turkish d5_ending_apocalypse_1d949aca:


    "Ayıcık, annemle babamın cansız bedenlerini kıra fırlattı."


translate turkish d5_ending_apocalypse_32ad29a8:


    "Kollarımı annemle babama uzatarak feryat ettim."


translate turkish d5_ending_apocalypse_75dd97ec:



    voice "voice/Alisa/5day/09 Se.ogg"
    Alis "Bu akşam tıka basa doyacağız."


translate turkish d5_ending_apocalypse_c656842f:


    "Alisa dudaklarını yalayarak babamı tuttu ve onu sürüye fırlattı. Yaratıklar cesedin üzerine atılıverdi."


translate turkish d5_ending_apocalypse_008ea0df:


    "Yılbaşında havai fişekleri daha iyi göreyim diye beni omuzlarına oturtan kişinin..."


translate turkish d5_ending_apocalypse_a7049e07:


    "... artık omuzları yoktu."


translate turkish d5_ending_apocalypse_cdef01d3:


    "Beni kucağına oturtan kişinin..."


translate turkish d5_ending_apocalypse_78485961:


    "... artık bacakları yoktu."


translate turkish d5_ending_apocalypse_d9b4d131:


    "Kesin şunu, bu dünyada babamdan iyisi yoktur."


translate turkish d5_ending_apocalypse_448e498c:


    "O dünya geride kaldı. Yedik bitirdik."


translate turkish d5_ending_apocalypse_037ffb3d:



    voice "voice/Alisa/5day/11 Eto.ogg" 
    Alis "Bu sıradan bir et değil Tavşancık..."


translate turkish d5_ending_apocalypse_0b4fb35d:



    voice "voice/Alisa/5day/12 Eto.ogg" 
    Alis "Aynı zamanda parlak geleceğimize açılan kapının anahtarı."


translate turkish d5_ending_apocalypse_7899a4a9:



    voice "voice/Alisa/5day/13 V.ogg" 
    Alis "O diyarda canımız ne isterse yiyebiliriz."


translate turkish d5_ending_apocalypse_df27cf23:


    "Annem parçalarına ayrılırken çıtırtılar yükseliyordu. Orak gibi pençeleriyle bembeyaz kemiklerde ne kadar et ve yağ varsa sıyırıp koparıyorlardı."


translate turkish d5_ending_apocalypse_54e69e86:


    "Et parçaları düşüp kardeşimin kalıntılarına karışıyordu."


translate turkish d5_ending_apocalypse_26a83494:


    "Olya, karnından çıktığı kişiyle bütünleşiyordu bir bakıma."


translate turkish d5_ending_apocalypse_d8f84104:


    "Birden hatırladım."


translate turkish d5_ending_apocalypse_602f9798:


    "Bir şey hatırlamadın."


translate turkish d5_ending_apocalypse_ae06570d:


    "Annem, Olya'yla beni eğlendirmek için yerde çukur kazardı. İçine boncuk koyar, üstünü mozaik camla kapatırdık."


translate turkish d5_ending_apocalypse_a3249752:


    "Buna da \"hazinemiz\" derdik."


translate turkish d5_ending_apocalypse_70f3a6d9:


    "Ancak bu apaçık mezardı."


translate turkish d5_ending_apocalypse_d091ea8d:



    voice "voice/Alisa/5day/14 Zr.ogg" 
    Alis "Yesene Tavşancık. Hadi. Karşı koyma."


translate turkish d5_ending_apocalypse_09225bd0:


    "İçimdeki hayvan hiç itiraz etmemişti. Gözümü bile kırpamadan kendimi dizlerimin üstünde buldum. Buz kesilmiş vıcık vıcık eti eşeliyordum."


translate turkish d5_ending_apocalypse_ede9132b:



    voice "voice/Anton/5day/305 1v.ogg"
    "Gözümden yaşlar, ağzımdan salyalar akıyordu."


translate turkish d5_ending_apocalypse_8262220a:


    "Ağzıma doğru büyük bir lokmayı yaklaştırdım. Acaba annem miydi yoksa Olya mıydı? Kimin umurunda zaten? Çok acıkmıştım!"


translate turkish d5_ending_apocalypse_d0f7466c:



    voice "voice/Anton/5day/305 0v.ogg"
    "Dişlerimi leziz mi leziz ete geçirdim. İçinde bir parça kemik vardı. Onu da yuttum."


translate turkish d5_ending_apocalypse_d3c2e401:



    voice "voice/Anton/5day/10 Gl.ogg"
    "Annem. Kesin oydu."


translate turkish d5_ending_apocalypse_08bb2396:



    voice "voice/Anton/5day/305 v.ogg"
    Ant "Leziz!"


translate turkish d5_ending_apocalypse_c5352a59:



    voice "voice/Alisa/5day/15 Ne.ogg" 
    Alis "Tavşanı andırmıyor mu tadı?"


translate turkish d5_ending_apocalypse_ea51b454:



    voice "voice/Alisa/5day/16 A t.ogg" 
    Alis "Aya dişlerini geçiremeyen Tavşancık masalını bilir misin?"


translate turkish d5_ending_apocalypse_380480f0:



    voice "voice/Alisa/5day/17 Zi.ogg" 
    Alis "Evvel zaman içinde, bir sürü oyuncağı olan bir çocuk varmış."


translate turkish d5_ending_apocalypse_35f0ef7c:



    voice "voice/Alisa/5day/18 E.ogg" 
    Ant "Çocuk ne zaman uyuyakalsa oyuncakları gecenin köründe ondan kaçıp karlı kıra çıkarmış."


translate turkish d5_ending_apocalypse_0f4d389d:



    voice "voice/Alisa/5day/19 Tam.ogg" 
    Alis "Kırdaysa is gibi kara gökyüzünden dolunay parlarmış."


translate turkish d5_ending_apocalypse_8a59d796:



    voice "voice/Alisa/5day/20 Med.ogg"
    Alis "Önce Ayıcık sıçrayıp aydan bir lokma almış. \"Tadı bal gibi,\" demiş."


translate turkish d5_ending_apocalypse_ce02a861:



    voice "voice/Alisa/5day/21 Go.ogg"
    Alis "Aç kurt yavrusu da göğe fırlayıp dişlerini geçirmiş. \"Etli etli,\" diye kükreyişi kırlarda yankılanmış."


translate turkish d5_ending_apocalypse_ab2f4b93:



    voice "voice/Alisa/5day/22 Pr.ogg" 
    Alis "Bu sefer de tilki, mehtap altında dudaklarını yalamaya koyulmuş."


translate turkish d5_ending_apocalypse_521ae70a:



    voice "voice/Alisa/5day/23 Vs.ogg" 
    Alis "Kurnaz hayvan \"Ayın peynirden olduğunu herkes bilir,\" deyip sırıtmış."


translate turkish d5_ending_apocalypse_d29d14c5:



    voice "voice/Alisa/5day/24 As.ogg" 
    Alis "Baykuş ise hiçbir şey dememiş. Ancak diğerleri, baykuşun her şeyden fare tadı aldığını biliyormuş."


translate turkish d5_ending_apocalypse_4435a87a:



    voice "voice/Alisa/5day/25 E.ogg" 
    Alis "Yükseklere sıçrayıp gökten leziz bir lokma almaya korkan tek canlı Tavşancık'mış."


translate turkish d5_ending_apocalypse_0163bc7c:



    voice "voice/Alisa/5day/26 tr.ogg" 
    Alis "Korkak kız, efendisinden kaçıp kendine yuva yapmış, kendine iki tavşancık dikip içlerini talaşla doldurmuş."


translate turkish d5_ending_apocalypse_1126c3cc:



    voice "voice/Alisa/5day/27 E.ogg" 
    Alis "O vakitten beri hiçbiri ayın tadına tekrar bakamamış çünkü Tavşancık güçlerini çocuklarıyla paylaşmış."


translate turkish d5_ending_apocalypse_fed4482c:



    voice "voice/Alisa/5day/28 No.ogg"
    Alis "Tavşancık, artık o gücün tamamını özümsedin..."


translate turkish d5_ending_apocalypse_f6fa50ea:


    "Ay da katılırcasına uğuldadı. Deliklerinden irin akıyordu."


translate turkish d5_ending_apocalypse_15a8dd5a:


    "Bana işkence eden açlık yüzünden ağzıma bol bol et tıkıyordum."


translate turkish d5_ending_apocalypse_683efc15:


    "Sabahleyin mutfakta güneşlenen annemi gördüm. Bana güzel güzel bakıyor, esrarengiz bir şekilde gülümsüyordu."


translate turkish d5_ending_apocalypse_66d2d10e:


    "Olya'nın odaya koşup bana lap diye sarıldığını gördüm. Gülüşü ne de ışıl ışıldı."


translate turkish d5_ending_apocalypse_56dc20c2:


    "Et gördüm. Boğazım düğümlendi. Annem ve kardeşim dişime takılmıştı."


translate turkish d5_ending_apocalypse_b09469be:


    "Geğirip gülmeye başladım. Parmaklarımı yalarken kahkahalara boğuldum. Ziyafetten artakalanlara keyifle yumruk indiriyordum."


translate turkish d5_ending_apocalypse_5a6bd474:


    "Sürü de aynı şekilde cıvıltılı kahkahalara boğuldu. Kar fırtınasını hissetmemizle hayvanlar ormana döndü."


translate turkish d5_ending_apocalypse_f4a56e34:


    "Dört ayak üstüne düşüp peşlerinden sürünmeye başladım. Karşıma çıkan etleri topluyor, eklemleri yalayıp yutuyordum."


translate turkish d5_ending_apocalypse_5d32cbcc:


    "Damağıma çivi battı. Tükürüp doğruldum."


translate turkish d5_ending_apocalypse_5adcda02:


    "Yaratıklar orman yolunda devam ediyorlardı."


translate turkish d5_ending_apocalypse_701e87e2:


    "Ağaçlar, karanlığın garabetiyle birbirine geçmiş, kimi zaman birbirine saldırıyorlardı."


translate turkish d5_ending_apocalypse_f1345f41:


    "Çukurlarında kırmızı bir sıvı fokurduyordu."


translate turkish d5_ending_apocalypse_d529d6d6:


    "Ağaç gövdelerinde bir dolu göz belirmişti. Her hareketimi takip ediyorlardı."


translate turkish d5_ending_apocalypse_ee88e3c7:


    "Deri değiştirirken kendimi yokladım. Harika bir histi."


translate turkish d5_ending_apocalypse_4fed18f8:


    "Delikanlı kılığındaki geçmişimi geride bırakıyordum."


translate turkish d5_ending_apocalypse_831b237d:


    "Derimin altından vahşi, dizginlenemez bir şey çıkmıştı. Hem de tüm gerçekliğiyle."


translate turkish d5_ending_apocalypse_61f8e512:


    "Ağaçlıkta hiç korkmamıştım. Gece bizimdi. Bense sürü..."


translate turkish d5_ending_apocalypse_da431363:


    Narr_color "Bakıyorum da... Kadim orman... değişmemiş mi sanki?"


translate turkish d5_ending_apocalypse_cccee08c:


    "Dönüp baktım. Ağaçlar bildiğimiz ağaç. Huzursuz böcekler gibi kıvranmıyorlardı."


translate turkish d5_ending_apocalypse_8b4b6654:


    Narr_color "Ayaklarımın altında da bildiğimiz toprak vardı. Çamların ardından da sıradan bir kız çıkmış, bana doğru geliyordu."


translate turkish d5_ending_apocalypse_81b9a4a5:



    voice "voice/Alisa/5day/22 Dob.ogg"
    Alis_Color "Evine hoş geldin Tavşancık."


translate turkish d5_ending_apocalypse_066a9a4c:



    voice "voice/Anton/5day/01 eto.ogg"
    Ant_Color "Burası çok güzel... Bayram coşkusu kulağımda çınlıyor..."


translate turkish d5_ending_apocalypse_753fdff0:



    voice "voice/Alisa/5day/24 Ost.ogg"
    Alis_Color "Reenkarnasyonunun tamamlanmasına çok az kaldı."


translate turkish d5_ending_apocalypse_7d8bb216:



    voice "voice/Alisa/5day/25 Den.ogg"
    Alis_Color "Yeni bir Tavşancık'ın doğuşu..."


translate turkish d5_ending_apocalypse_c5c06a01:



    voice "voice/Alisa/5day/26 raz.ogg"
    Alis_Color "Kulaklarını çekebilir miyim?"


translate turkish d5_ending_apocalypse_f0269c3f:


    Narr_color "Müzik ve konfetiler beni resmen çağırıyordu."


translate turkish d5_ending_apocalypse_8aba7ab4:


    Narr_color "Yakınlarda, bu acayip kırın birkaç adım ötesinde acıklı bir neşe beni bekliyordu."


translate turkish d5_ending_apocalypse_1902cba9:



    voice "voice/Alisa/5day/27 Pot.ogg"
    Alis_Color "Çabuk ol şapşal. Sana son kez \"şapşal\" diyorum bak."


translate turkish d5_ending_apocalypse_533ea142:


    Narr_color "Elini tuttum."


translate turkish d5_ending_apocalypse_2e5d804e:



    voice "voice/Alisa/5day/28 Be.ogg"
    Alis_Color "Koşalım!"


translate turkish d5_ending_apocalypse_10858d97:



    voice "voice/Anton/5day/03 no.ogg"
    Ant_Color "İyi de nereye?"


translate turkish d5_ending_apocalypse_250ca2f5:



    voice "voice/Alisa/5day/29 Ti.ogg"
    Alis_Color "Biliyorsun ya."


translate turkish d5_ending_apocalypse_a4ef02d0:


    Narr_color "Çığlıklar atan ayın taçlandırdığı gökyüzünü işaret etti."


translate turkish d5_ending_apocalypse_0c6db255:


    Narr_color "Güçsüz bacaklarıma bakıp kem küm ettim."


translate turkish d5_ending_apocalypse_a5bdd886:



    voice "voice/Anton/5day/04 ona.ogg"
    Ant_Color "Çok yüksek."


translate turkish d5_ending_apocalypse_df44953d:



    voice "voice/Alisa/5day/30 Pr.ogg"
    Alis_Color "Okulda öğretilen her şeyi unut."


translate turkish d5_ending_apocalypse_4bd27b18:



    voice "voice/Alisa/5day/31 Zem.ogg"
    Alis_Color "Yer çekimine anca salaklar inanır."


translate turkish d5_ending_apocalypse_c8100a7c:



    voice "voice/Alisa/5day/32 Sd.ogg"
    Alis_Color "Birlikte yapalım mı?"


translate turkish d5_ending_apocalypse_6c689111:


    Narr_Color "Başımla onayladım. Elbette birlikte yapacaktık. Yeni gökyüzü ikimiz için biçilmiş kaftandı. Ay da yalnızca bize haykırıyordu."


translate turkish d5_ending_apocalypse_02f15857:



    voice "voice/Alisa/5day/33 R.ogg"
    Alis_Color "Bir..."


translate turkish d5_ending_apocalypse_130c6cb1:


    Narr_color "Sıçradık."


translate turkish d5_ending_apocalypse_ac90b594:



    voice "voice/Anton/5day/05 D.ogg"
    Ant_Color "İki..."


translate turkish d5_ending_apocalypse_23c83544:


    Narr_color "Bir kez daha sıçradık."


translate turkish d5_ending_apocalypse_ae72dac4:



    voice "voice/Alisa/5day/34 Tri.ogg"
    Alis_Color "Üç! Hadi!"


translate turkish d5_ending_apocalypse_62ea6a3a:


    Narr_color "Nihayet."


translate turkish d5_ending_apocalypse_a5b80b07:


    Narr_color "Kuvvetli bacaklarımız buz gibi yerden kesiliverdi ve bedenlerimiz, kapkara gölgelerimizin tüm çirkinliğini geride bırakarak göğe fırladı."


translate turkish d5_ending_apocalypse_d8c08a03:


    "İşkence aleti gibi omurgama kadar nüfuz eden yakıcı soğuğu iliklerimde duymuştum."


translate turkish d5_ending_apocalypse_947da193:


    "Cildim çatladı ve yaralarımdan buz gibi kanlar saçılıverdi."


translate turkish d5_ending_apocalypse_25a74460:


    "Kahkahayı patlatmıştım. Ancak gülme seslerim mosmor olup kaskatı kesilen ağzımdan değil, başka yerimden çıkıyordu."


translate turkish d5_ending_apocalypse_dc25e2cd:


    "Muhtemelen içimde kahkahalara boğulan karanlığın ta kendisiydi."


translate turkish d5_ending_apocalypse_cb0e94e9:


    "Alisa'nın yüzünde göz alıcı bir gülüş belirdi."


translate turkish d5_ending_apocalypse_7b28b5e3:


    "Uğuldayan kasırgada, sivilce gibi saçılmış yıldızların arasında fırıl fırıl dönüyorduk. Kemiklerimizden donmuş et parçaları soyuluyordu."


translate turkish d5_ending_apocalypse_301f0333:



    voice "voice/Alisa/5day/35 Va.ogg"
    Alis "Vals!"


translate turkish d5_ending_apocalypse_a6117cd2:


    "Moraran suratında bir yarık açıldı. Yanağından parçalar, buz kırıkları gibi boşluğa savruldu."


translate turkish d5_ending_apocalypse_a451fe3d:


    "Balçığa dönen gözleri, rüzgarın etkisiyle genişleyen yuvalarından fırladı. Gökyüzündeki dansçıların hareketi yavaşladı."


translate turkish d5_ending_apocalypse_3eefc8f3:


    "Buzdan heykele dönüşen Alisa'ya vals yapar gibi sarıldım. Tek beden olmuştuk."


translate turkish d5_ending_apocalypse_ac2ca439:



    voice "voice/Alisa/5day/30 Ya.ogg" 
    Alis "Seni yerde bekleyeceğim."


translate turkish d5_ending_apocalypse_fdec83ec:



    voice "voice/Anton/5day/306 p.ogg"
    Ant "Bekle!"


translate turkish d5_ending_apocalypse_f610d79f:


    "Benden ayrıldığı an paramparça olup ellerimde ufalandı ve aşağısında kol gezen karanlığa serpiliverdi."


translate turkish d5_ending_apocalypse_d548e741:



    voice "voice/Alisa/5day/31 Let.ogg"
    Alis "Uç!"


translate turkish d5_ending_apocalypse_9a617c5b:


    "Ne yapılması gerektiğini biliyordum. Yukarıya, uzay boşluğunda delikler açan çıbanlara ve larva topçuklarına doğru fırladım."


translate turkish d5_ending_apocalypse_fe60cb8b:


    "Sapsarı aya doğru süzülüyordum."


translate turkish d5_ending_apocalypse_02dab0da:


    "Benim gibi onun da salyaları akıyordu."


translate turkish d5_ending_apocalypse_99f73dbf:


    "Geçmişimi de geride bırakmıştım."


translate turkish d5_ending_apocalypse_8f825f08:


    "Katya."


translate turkish d5_ending_apocalypse_37e65e51:


    "Dedikoducu şıllık benden nefret ederdi."


translate turkish d5_ending_apocalypse_fd8c03a6:


    "Semyon."


translate turkish d5_ending_apocalypse_778bb2ec:


    "Bana \"pısırık\" deyip zorbalık yapan şişko ucubenin tekiydi."


translate turkish d5_ending_apocalypse_cd60e5a8:


    "Romka."


translate turkish d5_ending_apocalypse_7042f478:


    "Gerçek dostum sayılmazdı bile. Canı cehenneme."


translate turkish d5_ending_apocalypse_a37f8a80:


    "Canı cehenneme."


translate turkish d5_ending_apocalypse_cef4fa07:


    "Byaşa."


translate turkish d5_ending_apocalypse_b3dc514d:


    "Korkak ve şakşakçı. İlk fırsatta icabına baksaydım keşke."


translate turkish d5_ending_apocalypse_e48b5207:


    "Annemle babam."


translate turkish d5_ending_apocalypse_c49bbec2:


    "Bağrış çağrışları, bitmek bilmeyen tartışmaları, donuk bakışları..."


translate turkish d5_ending_apocalypse_a33bb6b3:


    "Lanetli köy. Nefret ettiğim bunaltıcı evimiz."


translate turkish d5_ending_apocalypse_f0b32676:


    "Olya."


translate turkish d5_ending_apocalypse_aae978c4:


    "Herkes gibi o da öldü. Canını yitirdi, yok oldu, çürüyüp gitti."


translate turkish d5_ending_apocalypse_8fca9ee6:


    "Nihayet özgürdüm."


translate turkish d5_ending_apocalypse_78ba46c1:


    "Ay beni yukarıya çekiyordu."


translate turkish d5_ending_apocalypse_43b89f5f:


    "İçimdeki beni ben yapan şeyler çatırdayıp dağılmıştı."


translate turkish d5_ending_apocalypse_bb1a83a2:


    "Artık gereksiz şeylerdi."


translate turkish d5_ending_apocalypse_fd8a710d:


    "Babamın adını unutmuştum."


translate turkish d5_ending_apocalypse_402a02cd:


    "Annemin adını unutmuştum."


translate turkish d5_ending_apocalypse_42395f02:


    "Bir zamanlar sımsıkı sarıldığım kız çocuğunun adını da unutmuştum."


translate turkish d5_ending_apocalypse_c82615cd:


    "Hatta sapsarı ayın büyüdükçe tüyler ürperten gölgesinde..."


translate turkish d5_ending_apocalypse_ee7b35d6:


    "... kendi adımı unutmuştum."


translate turkish d5_ending_apocalypse_692a8068:


    "Yine de başardım..."


translate turkish d5_ending_apocalypse_9da5b839:


    "Aya dişlerimi geçirebildim."


translate turkish d5_ending_apocalypse_6253a0e4:


    "Derim kabarıp etimden ayrılıyordu. Kemiklerim de yırtılırcasına kopuyordu."


translate turkish d5_ending_apocalypse_28009ad1:


    "Açlık."


translate turkish d5_ending_apocalypse_d4ab6502:


    "Ağzım öyle bir açıldı ki yanaklarım yırtılıverdi."


translate turkish d5_ending_apocalypse_80c88e54:


    "Artık bir insanınkini değil, hayvanınkini andırıyordu."


translate turkish d5_ending_apocalypse_9b7ffabb:


    "Bebekmişim gibi tüm dişlerim döküldü ve yerlerine bıçak gibi keskin dişlerim çıkıp dudaklarıma saplandı."


translate turkish d5_ending_apocalypse_28009ad1_1:


    "Açlık."


translate turkish d5_ending_apocalypse_271e71b1:


    "Gözlerim pörtleyip suratımın her tarafına saçıldı."


translate turkish d5_ending_apocalypse_ddd5288b:


    "Yüzüm de artık bir insanınkini değil, hayvanınkini andırıyordu."


translate turkish d5_ending_apocalypse_c967b697:


    "Kaslarım bükülüp düğüm düğüm oldu. Göz yuvalarımda yeni bir çift göz oluşuyordu. Her şeyi yemek olarak görüyorlardı."


translate turkish d5_ending_apocalypse_3c54cc0b:


    "Yenilebilir bir dünya. Sonsuz bir orman, sonsuz bir av sahası. İçinde saklanabileceğim bir karanlık."


translate turkish d5_ending_apocalypse_a917f027:


    "Kükredim."


translate turkish d5_ending_apocalypse_fc788f37:


    "Tırnaklarım da kopmuş, pençe çıkarmıştım. Eski derimin, yüzümün, saçlarımın kalıntılarını soyup attım."


translate turkish d5_ending_apocalypse_3d700041:


    "Dönüşümüme tanık olan ay uğuldadı."


translate turkish d5_ending_apocalypse_0d15b8a0:


    "Postumun altında yeni kemiklerim kaynadığında, kafatasım sertleştiğinde ve esas biçimime ulaştığımda, yani ayin tamamlandığında balçık gibi gökte, yıldızların arasında asılı kaldım..."


translate turkish d5_ending_apocalypse_96b90833:


    "... ve dünyanın yolunu tutuverdim."


translate turkish d5_ending_apocalypse_titles_7eb7c1ae:


    ""


translate turkish d5_ending_apocalypse_aftertitles_4f1f2870:


    "Dünya kan ağlıyordu. Gezegen, zifiri karanlığa gömülmüştü. Ateşler sönmüş, kocaman şehirler bir anda küle dönmüştü."


translate turkish d5_ending_apocalypse_aftertitles_f85bb0cb:


    "Bir grup pençe, kuyruk ve diş, sürünerek hayatın ta kendisini noktalamıştı."


translate turkish d5_ending_apocalypse_aftertitles_b059498b:


    "Denizler kırmızıya dönmüştü."


translate turkish d5_ending_apocalypse_aftertitles_ec12dbb1:


    "Orman yangınları tek ışık kaynağı haline gelmişti. Alevlerin için de dev canavarların gölgeleri kol geziyordu."


translate turkish d5_ending_apocalypse_aftertitles_f41bc95d:


    "Nehirleri, dağları yutuyorlar; gerçekliğin kemiklerini kemiriyorlardı."


translate turkish d5_ending_apocalypse_aftertitles_945ec078:


    "Karanlıkta saklanıyordum."


translate turkish d5_ending_apocalypse_aftertitles_e7675e99:


    "Yerleri kazıyor, kazdığım mezarlardan çıkanları mideye indirerek akşamlarımı geçiriyordum. Ancak açlığımdan kurtulamıyordum."


translate turkish d5_ending_apocalypse_aftertitles_b4a15109:


    "Bir an bile olsa dindiremiyordum."


translate turkish d5_ending_apocalypse_aftertitles_4c5e6ebf:


    "Midem kazınıyordu. O kadar açtım ki kendimi kemiriyordum. Ayı yesem doymazdım."


translate turkish d5_ending_apocalypse_aftertitles_5ac75451:


    "Tek yapabildiğim, iştahla tüketmekti. Dünyaları yok eden açlığın ta kendisiydim."


translate turkish d5_ending_apocalypse_aftertitles_b5681231:


    "Hiçliği kendi ellerimle yaratıyordum."


translate turkish d5_ending_apocalypse_aftertitles_c2372922:


    "Dünyayı çekirdeğine kadar yiyor, mezarları mideme indiriyordum."


translate turkish d5_ending_apocalypse_aftertitles_44dbc48e:


    "Uğultum ise ağıt gibiydi. Bedenim kimsenin hayal edemeyeceği kadar büyüktü. Zaten herkesi yemiştim, kimse de hayal edemezdi."


translate turkish d5_ending_apocalypse_aftertitles_9d9df590:


    "Ağzımı açıp uçurumları, denizleri yutarak karanlığa doğru yürüyordum. Gözlerim, etrafında besin ararcasına yuvalarında fır fır dönüyordu."


translate turkish d5_ending_apocalypse_aftertitles_e6112b58:


    "Yıldızları yiyordum."


translate turkish d5_ending_apocalypse_aftertitles_0327f1df:


    "Evreni mideye indiriyordum."


translate turkish d5_ending_apocalypse_aftertitles_bd9f34b4:


    "Gezegenlerin çığlıklarını duyabiliyordum. Ölüm sancılarından asla kurtulamayan kainat da acıyla inildiyordu."


translate turkish d5_ending_genius_24b69a63:


    "Atlattığı badirelerden sonra onu bu tuhaflığı yüzünden yargılayamazdım."


translate turkish d5_ending_genius_5f166b28:


    "Yüzümdeki çirkin tebessüm içimdeki canavarın eseriydi."


translate turkish d5_ending_genius_98bf043d:


    "Nihayetinde, isteyip de uğruna çabaladığım her şey bu kız ile dostluğumuzdan ibaretti."


translate turkish d5_ending_genius_d41696b5:


    "Hatta dostluktan da ötesiydi."


translate turkish d5_ending_genius_222c0f58:


    "Polina'ya sarıldığımda aynı sıcaklıkla karşılık buldum."


translate turkish d5_ending_genius_aftertitles_a6cffed1:



    voice "voice/anton/Adult/01 Ni.ogg"
    Ant "Ufacık köye neden akıl hastanesi kurmuşlar, hiç anlamıyorum."


translate turkish d5_ending_genius_aftertitles_cc5d1ead:



    voice "voice/Polina/5day/240 Et.ogg"
    Pol "Çünkü bölge hastanesi."


translate turkish d5_ending_genius_aftertitles_0533997a:



    voice "voice/Polina/5day/241 E.ogg" 
    Pol "Ayrıca... Ormanın yakınlarında delirmek pek kolay."


translate turkish d5_ending_genius_aftertitles_ff4328a3:


    "Maalesef bu gerçeğin gayet de farkındaydım."


translate turkish d5_ending_genius_aftertitles_072df676:


    "Küçük, ıssız bir parkta yapraksız ağaç dalları rüzgarla hışırdıyordu."


translate turkish d5_ending_genius_aftertitles_4f51b9e6:


    "Güneş, tayganın üstünden batıyordu. Nemli hava, çam kokuyordu."


translate turkish d5_ending_genius_aftertitles_ba6e02b3:


    "Siyah gömlekli delilerin hayaletini andıran gölgeler, yakındaki binanın yıkık dökük cephesine yaklaşıyordu."


translate turkish d5_ending_genius_aftertitles_9cf23689:


    "Köyümüz, içinde kokulu bir sıvının katılaştığı bir cesedi anımsatıyordu."


translate turkish d5_ending_genius_aftertitles_741a7b3f:


    "Bir ölü sevicinin ölülerden çaldığı kıyafetlerle yaptığı korkunç bir bez bebek gibiydi."


translate turkish d5_ending_genius_aftertitles_8f48c252:


    "Yapmam gereken onca şeyden sonra, Polina'yla karanlığa dokunduktan sonra..."


translate turkish d5_ending_genius_aftertitles_4420c13b:


    "Kan gölüne girmiş gibi dirseklerimize kadar bulanmıştık."


translate turkish d5_ending_genius_aftertitles_f30b464f:


    "Arabanın yanında yoldaşımla yan yana dikilirken barikatlı pencerelere baktım."


translate turkish d5_ending_genius_aftertitles_5e6d53a3:


    "Kar taneleri gökten ağır ağır süzülüyordu."


translate turkish d5_ending_genius_aftertitles_1f3801fd:


    "Burada ben de bulunabilirdim. Yatağa bağlanabilir, ilaçla yatıştırılabilirdim."


translate turkish d5_ending_genius_aftertitles_510419b0:


    "Ancak kilitli hastane odalarından kaçmayı başarmıştık."


translate turkish d5_ending_genius_aftertitles_e9698ead:


    "Acil Durumlar Bakanlığı, Byaşa'yı yıllar önce alıp götürdüğünde kendisini orman hendeklerinde sürünürken bulmuşlardı."


translate turkish d5_ending_genius_aftertitles_9a7dc6aa:


    "Doktorlar Byaşa'nın midesinde tarla faresi ve sincap kalıntıları bulmuştu."


translate turkish d5_ending_genius_aftertitles_51bdc441:


    "Canına sahip çıkmak için elinden geleni yapmıştı. Jandarma, zavallı çocuğun seri katilin eline düştüğüne karar kılınca çocukçağız tırlattı."


translate turkish d5_ending_genius_aftertitles_24076b5e:


    "Polina'yla bense kendi yöntemlerimizi kullanarak sağ salim kalmayı başardık."


translate turkish d5_ending_genius_aftertitles_b238fdde:


    "Peki ya esas deliler hastanede değil de dışarıdaysa?"


translate turkish d5_ending_genius_aftertitles_9d9523e7:


    "Telefonuma baktım. Duvar kağıdımdaki pek hoş gülüşüyle babam da bana baktı."


translate turkish d5_ending_genius_aftertitles_e56fd699:


    "Olya'yı kucağında tutuyordu."


translate turkish d5_ending_genius_aftertitles_bdca3966:


    "O yitip gitmiş yaz gününde kardeşim de gülümsüyordu. O an bir kehribarın içinde muhafaza edilmişti sanki."


translate turkish d5_ending_genius_aftertitles_8919fed2:


    "Ekranın köşesinden saate baktım."


translate turkish d5_ending_genius_aftertitles_bb29541b:



    voice "voice/anton/Adult/02 Pr.ogg"
    Ant "Ziyaret saatleri gelmiş."


translate turkish d5_ending_genius_aftertitles_8a746ce9:



    voice "voice/Polina/5day/242 Poi.ogg"
    Pol "Gidelim madem."


translate turkish d5_ending_genius_aftertitles_ceead2b1:


    "Yıkık dökük binanın ana koridorunda cereyanlar esiyordu."


translate turkish d5_ending_genius_aftertitles_8fbee3ed:


    "Ampullerin yarısı patlaktı. Koridor güç bela aydınlanıyordu."


translate turkish d5_ending_genius_aftertitles_936efac0:



    voice "voice/Med/01Vi.ogg"
    Doctor "Buyurun."


translate turkish d5_ending_genius_aftertitles_e579464c:



    voice "voice/Polina/5day/243 K.ogg" 
    Pol "İgor Budaev'i görmeye geldik."


translate turkish d5_ending_genius_aftertitles_c7620562:



    voice "voice/Med/02 A.ogg"
    Doctor "Müdavimimizi yani!.."


translate turkish d5_ending_genius_aftertitles_06921d76:



    voice "voice/Med/04 Pa.ogg"
    Doctor "Hastaların tümü şu an yemekhanede rutin tedaviden geçiyor ancak İgor Dulgaroviç odasına döndü bile."


translate turkish d5_ending_genius_aftertitles_3777a7c7:



    voice "voice/anton/Adult/03 Ka.ogg"
    Ant "Durumu nasıl?"


translate turkish d5_ending_genius_aftertitles_150687a3:



    voice "voice/Med/05 Nad.ogg"
    Doctor "Maalesef iyileşmesini pek ummuyoruz."


translate turkish d5_ending_genius_aftertitles_bc837448:



    voice "voice/Med/06 Bo.ogg"
    Doctor "Muhtemelen hayatı boyunca tıbbi yardıma ihtiyaç duyacak."


translate turkish d5_ending_genius_aftertitles_087ce2fa:



    voice "voice/Med/07 no.ogg"
    Doctor "Ancak kendini yakın zamanda sanat ve zanaata verdi. Burada hobi yoluyla her türlü terapiyi destekliyoruz."


translate turkish d5_ending_genius_aftertitles_27593af4:



    voice "voice/Med/08 on.ogg"
    Doctor "Hatta kendisi çocuk servisindeki sanat kulübünü yönetmeye başladı."


translate turkish d5_ending_genius_aftertitles_91451150:



    voice "voice/anton/Adult/04 Ne.ogg"
    Ant "Aa, yine ahşap mı yakıyor?"


translate turkish d5_ending_genius_aftertitles_4b78d5bf:



    voice "voice/Med/09 da.ogg"
    Doctor "Yok, kendisine lehim aleti emanet edemeyiz."


translate turkish d5_ending_genius_aftertitles_724f1558:



    voice "voice/Med/10 net.ogg"
    Doctor "Amatör tiyatro ekibimize kostüm dikiyor."


translate turkish d5_ending_genius_aftertitles_85f45293:



    voice "voice/Polina/5day/244 Da.ogg"
    Pol "Hastane değil yetenek yuvası mübarek."


translate turkish d5_ending_genius_aftertitles_87ab264d:


    "Doktor, Polina'nın alaycı ifadesini anlamamıştı."


translate turkish d5_ending_genius_aftertitles_29f2f94f:



    voice "voice/Med/11 Na.ogg"
    Doctor "Evet, hepsi pırıl pırıl çocuklar."


translate turkish d5_ending_genius_aftertitles_78a3e29a:



    voice "voice/Med/03 Ed.ogg"
    Doctor "Benimle gelin."


translate turkish d5_ending_genius_aftertitles_82b507c1:


    "Muşambalı zeminde koşan bir hamam böceği belirdi. Polina ayakkabısıyla onu ezip tiksindi."


translate turkish d5_ending_genius_aftertitles_8d7c84ec:


    "Doktor kapıyı açtı."


translate turkish d5_ending_genius_aftertitles_3ec90d1a:



    voice "voice/Med/12 Eg.ogg"
    Doctor "İgor Dulganoviç, misafirlerin var."


translate turkish d5_ending_genius_aftertitles_e651be23:


    "Görüşmeye hazırlansam da zamanın yıprattığı Byaşa'yı görünce şaşıp kalmıştım."


translate turkish d5_ending_genius_aftertitles_b4330c0a:


    "Gri saçlı, önlüklü hastamız gözünü pencereden ayırıp bize baktı."


translate turkish d5_ending_genius_aftertitles_488a9883:


    "Sulu gözlerine boş bakışlar hakimdi."


translate turkish d5_ending_genius_aftertitles_ec7537a7:


    "Byaşa'yla bana mahremiyet sağlamak için doğru an olduğunu fark eden Polina, dikkatini dağıtmak için doktorla konuşmaya başladı."


translate turkish d5_ending_genius_aftertitles_90a6ec6c:


    "Onları artık duyamıyordum. İlk anki şaşkınlığım yerini kararlılığa bırakmıştı."


translate turkish d5_ending_genius_aftertitles_9237ef0b:


    "Eski dostuma yaklaştım."


translate turkish d5_ending_genius_aftertitles_4d3504d8:


    "Üzerine düşen gölgem, canını yakmışçasına ürperdi."


translate turkish d5_ending_genius_aftertitles_844d06ed:



    voice "voice/byasha/5day/01k.ogg"
    Bya "S-s-sen k-k-kimsin, he?"


translate turkish d5_ending_genius_aftertitles_fe016b6f:



    voice "voice/anton/Adult/05 Pr.ogg"
    Ant "Beni unutmuş gibi mi yapacaksın yoksa?"


translate turkish d5_ending_genius_aftertitles_8df23e76:



    voice "voice/byasha/5day/02ne.ogg"
    Bya "C-c-canımı yakma, he."


translate turkish d5_ending_genius_aftertitles_981ea14b:


    "Sesimi alçaltıp fısıldamaya başladım. Tüyler ürperten baş başa konuşmamızı devam ettirdim."


translate turkish d5_ending_genius_aftertitles_4a693303:



    voice "voice/anton/Adult/06 Es.ogg"
    Ant "Canının acısıyla hatırlayacaksan..."


translate turkish d5_ending_genius_aftertitles_5c34aed3:



    voice "voice/byasha/5day/03ee.ogg"
    "Doktorun görüşünü engellemek için Byaşa'nın önünde dikilip yakasına yapıştım."


translate turkish d5_ending_genius_aftertitles_3c264bba:



    voice "voice/byasha/5day/04d.ogg"
    Bya "B-b-beyefendi, l-l-lütfen."


translate turkish d5_ending_genius_aftertitles_1937606d:



    voice "voice/byasha/5day/05Ya.ogg"
    Bya "B-b-ben daha çocuğum, he."


translate turkish d5_ending_genius_aftertitles_7a282e46:



    voice "voice/anton/Adult/07 Te.ogg"
    Ant "Otuz yedi yaşındasın."


translate turkish d5_ending_genius_aftertitles_dc2ff582:



    voice "voice/byasha/5day/06ne.ogg"
    Bya "Y-yalan."


translate turkish d5_ending_genius_aftertitles_5a9473c8:



    voice "voice/byasha/5day/07po.ogg"
    Bya "N-n-niye yalan söylüyorsun?"


translate turkish d5_ending_genius_aftertitles_f2b7b204:


    "Giysisine iyice asıldım."


translate turkish d5_ending_genius_aftertitles_c3ae084c:



    voice "voice/anton/Adult/09 E.ogg"
    Ant "Elimden gelse şuracıkta canına kıyarım, duydun mu?"


translate turkish d5_ending_genius_aftertitles_966c2932:



    voice "voice/anton/Adult/09 V.ogg"
    Ant "Bana bak."


translate turkish d5_ending_genius_aftertitles_12ab6ce5:



    voice "voice/Med/13 Se.ogg"
    Doctor "Beyefendi, hastalarımıza böyle davranamazsınız."


translate turkish d5_ending_genius_aftertitles_8b9e7234:


    "Yakasını bırakıp \"Dur hele, daha başlamadım,\" diye düşündüm."


translate turkish d5_ending_genius_aftertitles_3489f996:



    voice "voice/Polina/5day/246 Vs.ogg" 
    Pol "Dert etmeyin. Onlar eski dost."


translate turkish d5_ending_genius_aftertitles_9156bab7:


    "Byaşa, Polina'yı fark edene dek odanın dört bir yanına baktı."


translate turkish d5_ending_genius_aftertitles_f28dc922:


    "Eski sınıf arkadaşımız tir tir titreyerek sırtını duvara yaslamıştı."


translate turkish d5_ending_genius_aftertitles_7553063e:



    voice "voice/byasha/5day/10za.ogg"
    Bya "O-o-onu buraya niye getirdin?"


translate turkish d5_ending_genius_aftertitles_0deec457:



    voice "voice/byasha/5day/11pr.ogg"
    Bya "Kov ş-ş-şunu, he, kov!"


translate turkish d5_ending_genius_aftertitles_2a301c57:



    voice "voice/byasha/5day/12uh.ogg"
    Bya "Sen de o c-c-canavar da. Defolun!"


translate turkish d5_ending_genius_aftertitles_6115c863:


    "Karanlık köşede kıpırdamadan dikilen Polina'ya döndüm."


translate turkish d5_ending_genius_aftertitles_a832d9bd:


    "Yüzünde açık yara gibi korkunç bir gülüş belirmişti."


translate turkish d5_ending_genius_aftertitles_669933d9:


    "Jest ve mimiklerimizle anlaştık."


translate turkish d5_ending_genius_aftertitles_ae360a4a:


    "Zamanı gelmişti."


translate turkish d5_ending_genius_aftertitles_c3339476:


    "Yolculuk bizi bekliyordu."


translate turkish d5_ending_genius_aftertitles_a23a076b:


    "Polina, doktoru odadan çıkarmak için konuştu."


translate turkish d5_ending_genius_aftertitles_e0d8e1fa:



    voice "voice/Polina/5day/247 M.ogg" 
    Pol "Bya... Budaev'le yürüyüşe çıksak olur mu?"


translate turkish d5_ending_genius_aftertitles_aa056f35:



    voice "voice/Polina/5day/248 Es.ogg" 
    Pol "Bizim gözetimimizde olacak."


translate turkish d5_ending_genius_aftertitles_7c9c5287:



    voice "voice/Med/14 Chto.ogg"
    Doctor "Nasıl yani? Mümkün değil."


translate turkish d5_ending_genius_aftertitles_9cbb0b58:



    voice "voice/Med/15 On.ogg"
    Doctor "Kendisi profesyonellerin denetiminde kalmalı."


translate turkish d5_ending_genius_aftertitles_fa8ba1ba:



    voice "voice/Polina/5day/249 Ya.ogg" 
    Pol "Ben de profesyonelim."


translate turkish d5_ending_genius_aftertitles_ce1197b0:


    "Polina cebinden bir şey çıkarıp doktora gösterdi."


translate turkish d5_ending_genius_aftertitles_137c46b7:


    "Doktor tek kaşını kaldırıp Polina'nın uzattığı zarfa baktı."


translate turkish d5_ending_genius_aftertitles_d4872e76:



    voice "voice/Med/16 U.ogg"
    Doctor "Hanımefendi... Sizde bir tekinsizlik seziyorum..."


translate turkish d5_ending_genius_aftertitles_df3fd28c:



    voice "voice/Med/17 V.ogg"
    Doctor "İkiniz de... pek tuhaf görünüyorsunuz."


translate turkish d5_ending_genius_aftertitles_267efa96:



    voice "voice/Polina/5day/250 Eto.ogg"
    Pol "Pekâlâ gideririz."


translate turkish d5_ending_genius_aftertitles_c12a362a:


    "Polina banknot sayarak rüşveti dolgunlaştırdı."


translate turkish d5_ending_genius_aftertitles_6c66765d:



    voice "voice/Med/18 Ch.ogg"
    Doctor "Öhöm... Doktor Hanım... Hastamız sizinle emin ellerde olacaktır."


translate turkish d5_ending_genius_aftertitles_4419a78a:



    voice "voice/byasha/5day/13ne.ogg"
    Bya "B-b-beni onlara e-emanet etmeyin."


translate turkish d5_ending_genius_aftertitles_ecf61296:



    voice "voice/byasha/5day/14to.ogg"
    Bya "B-b-bunu yapamazsınız, he!"


translate turkish d5_ending_genius_aftertitles_7e9dcec7:



    voice "voice/anton/Adult/10 Na.ogg"
    Ant "Yürü."


translate turkish d5_ending_genius_aftertitles_88b0149b:


    voice "voice/anton/Adult/08 P3.ogg"


translate turkish d5_ending_genius_aftertitles_d853a516:


    "Byaşa'nın omuzunu öyle bir sıktım ki izi çıkmıştır. Bundan pek keyif almıştım."


translate turkish d5_ending_genius_aftertitles_85f1162a:


    "Byaşa, yaşayan bir ölü gibi Polina'ya bakarak dermansızca direniyordu."


translate turkish d5_ending_genius_aftertitles_c614f18c:


    "Doktor pencereye döndü. Vicdanıyla açgözlülüğü yüzleşiyordu."


translate turkish d5_ending_genius_aftertitles_690713d9:


    "Elbette köyümüzün adetidir ki açgözlülük galip geliyordu."


translate turkish d5_ending_genius_aftertitles_20960ef9:



    voice "voice/Med/19 Eg.ogg"
    Doctor "İgor Dulgaroviç'e sakinleştirici ilaç verilmişti."


translate turkish d5_ending_genius_aftertitles_5f6f0d95:



    voice "voice/Med/20 On.ogg"
    Doctor "Fazla direnemeyecektir."


translate turkish d5_ending_genius_aftertitles_a659df83:


    "Dişlerimi sıkıp \"Sıkıyorsa dirensin,\" dedim içimden."


translate turkish d5_ending_genius_aftertitles_9f49c3ee:



    voice "voice/Polina/5day/251 na.ogg" 
    Pol "Az önce konuştuğumuz konuya gelirsek..."


translate turkish d5_ending_genius_aftertitles_6774d79b:



    voice "voice/Med/21 oi.ogg"
    Doctor "Ah, tabii. Çantayı getireyim."


translate turkish d5_ending_genius_aftertitles_90fb7844:


    "Rüzgarlı kıra çıktık. Çamların tepesinde süzülen bulutlar giderek yoğunlaşıyordu."


translate turkish d5_ending_genius_aftertitles_66bdaa47:


    "Byaşa'nın dizlerinin bağı çözülmüştü. Bizi bekleyen araca, siyah \"Tiger\" SUV'me bakarak sızlanıyordu."


translate turkish d5_ending_genius_aftertitles_daae6835:


    "İçeride kendisini sanayi tipi kıyma makinesi bulunan bir salon beklercesine arabayı gözlüyordu."


translate turkish d5_ending_genius_aftertitles_c1ac819a:


    "Krom SUV tüm heybetiyle parıl parıl parlıyordu. Tam bir felaket tellalıydı."


translate turkish d5_ending_genius_aftertitles_4dcd2b2f:


    "Byaşa'yı dirseklerinden tutup arka koltuğa geçirdik."


translate turkish d5_ending_genius_aftertitles_28566fa4:


    "Yüzümüzdeki çirkin gülüşlerin yansıması pencerelerde belirmişti."


translate turkish d5_ending_genius_aftertitles_d10a8930:


    "Savunmasız Byaşa, ömrünün çoğunluğunu geçirdiği hastaneye ara ara bakıyordu."


translate turkish d5_ending_genius_aftertitles_fc7b8195:


    "Çocukluğu geçmişte kalsa da tayganın kıyısındaki köye musallat olan kabus mevcudiyetini koruyor, insanlar kaybolup duruyordu."


translate turkish d5_ending_genius_aftertitles_86bb78f5:


    "Kadim kötülüğün izleri, polis raporlarında yer bulmaya devam ediyordu."


translate turkish d5_ending_genius_aftertitles_57ed8290:


    "Söylentilere ve korku hikayelerine konu oluyor, günümüz öğrencilerinin ağzından düşmüyorlardı."


translate turkish d5_ending_genius_aftertitles_3f340458:



    voice "voice/byasha/5day/17ku.ogg"
    Bya "B-b-beni nereye götürüyorsunuz, he?"


translate turkish d5_ending_genius_aftertitles_353ac3c0:



    voice "voice/Polina/5day/252 T.ogg"
    Pol "Nereye gittiğimizi biliyorsun."


translate turkish d5_ending_genius_aftertitles_a9e0168b:


    "Yoldaşımın elinde bir silah belirdi. Emaneti eski dostumuza doğrulttu."


translate turkish d5_ending_genius_aftertitles_e9cab3f0:


    "38 kalibrelik bir tabanca."


translate turkish d5_ending_genius_aftertitles_cdb71c41:


    "Cehennemin kıyısında kurşuna bel bağlanmazdı tabii."


translate turkish d5_ending_genius_aftertitles_380f4a3b:


    "Burada sözü geçen silahlar başkaydı. Savaş kanunları da öyle."


translate turkish d5_ending_genius_aftertitles_5f73cf90:


    voice "voice/byasha/5day/19Aaa.ogg"


translate turkish d5_ending_genius_aftertitles_5d3fc82d:


    Bya "Ç-çok kötüsünüz, he!"


translate turkish d5_ending_genius_aftertitles_ffa7c0c4:



    voice "voice/byasha/5day/21ti.ogg"
    Bya "S-siz..."


translate turkish d5_ending_genius_aftertitles_16119bb5:


    "Byaşa acıklı gözlerini bana çevirdi. Yanlış yerde yanlış kişiden medet umuyordu."


translate turkish d5_ending_genius_aftertitles_9658d63f:



    voice "voice/byasha/5day/22za.ogg"
    Bya "O ş-ş-şeytan kılıklı yaratığı n-n-niye getirdin?"


translate turkish d5_ending_genius_aftertitles_bc869e78:



    voice "voice/Polina/5day/253 S.ogg"
    Pol "Yakında anlarsın."


translate turkish d5_ending_genius_aftertitles_e917c346:



    voice "voice/anton/Adult/10 Nas.ogg"
    Ant "İyi yolculuklar dostum."


translate turkish d5_ending_genius_aftertitles_81bcbaae:


    "Köyden çıktığımız gibi kuytu bir patikaya girdim. Nemrut çam ağaçları kale duvarı gibi etrafımızı kuşatmıştı."


translate turkish d5_ending_genius_aftertitles_27ec17ae:


    "Dalları aracımıza uzanıyor, çam dikenli patileriyle SUV'nin tavanındaki karları silkeliyorlardı."


translate turkish d5_ending_genius_aftertitles_33f608c5:


    "Akbaba gibi davranan gölgeler, uykusundan uyanıp patikaya sinsice yaklaşıyordu."


translate turkish d5_ending_genius_aftertitles_70ccc4c9:


    "Yolun iki yanında kapkara ağaç gövdeleri bir beliriyor bir gözden kayboluyordu. Patika giderek daralıyordu. Ağaçlıktan gaklamalar, iniltiler geliyordu."


translate turkish d5_ending_genius_aftertitles_cb53f25f:


    "Alçak zemine, fokurdayan bir pınarın yakınına park ettim."


translate turkish d5_ending_genius_aftertitles_11cba82a:


    "Byaşa arka koltukta titremeye başladı. Planımızı anlamış mıydı?"


translate turkish d5_ending_genius_aftertitles_4696c843:



    voice "voice/anton/Adult/12 Vs.ogg"
    Ant "Şimdi hatırladın mı? Çirkin suratına bakılırsa anlamışsın."


translate turkish d5_ending_genius_aftertitles_2e395f5e:



    voice "voice/byasha/5day/23ch.ogg"
    Bya "K-k-ka..."


translate turkish d5_ending_genius_aftertitles_ab2da144:



    voice "voice/anton/Adult/13 N.ogg"
    Ant "Hadi, başaracaksın."


translate turkish d5_ending_genius_aftertitles_6de3dc8f:



    voice "voice/byasha/5day/24ga.ogg"
    Bya "Ga-ga-gara..."


translate turkish d5_ending_genius_aftertitles_1106e9f2:



    voice "voice/anton/Adult/14 Na.ogg"
    Ant "Çık ulan dışarı."


translate turkish d5_ending_genius_aftertitles_2d9726dd:


    "Çıkmak istemiyordu. Byaşa'yı \"Tiger\"dan yaka paça çıkardım."


translate turkish d5_ending_genius_aftertitles_d0edf8b3:


    "Tökezleyip diz üstü düştü. Beti benzi atmış, kar gibi olmuştu."


translate turkish d5_ending_genius_aftertitles_573ba4dd:



    voice "voice/byasha/5day/26toha.ogg"
    Bya "T-Toha... H-he..."


translate turkish d5_ending_genius_aftertitles_ac57496a:



    voice "voice/Polina/5day/254 o.ogg" 
    Pol "Vay be! Aferin. Hastamız iyileşiyor."


translate turkish d5_ending_genius_aftertitles_2a6c328f:



    voice "voice/byasha/5day/27pol.ogg"
    Bya "P-Polina..."


translate turkish d5_ending_genius_aftertitles_49ba09f8:



    voice "voice/byasha/5day/28za.ogg"
    Bya "N-n-niye bunu yapıyorsunuz, he?"


translate turkish d5_ending_genius_aftertitles_376a8124:



    voice "voice/anton/Adult/15 Z.ogg"
    Ant "N-n-niye mi?"


translate turkish d5_ending_genius_aftertitles_b8bbd699:


    "Telefonumu çıkarıp Byaşa'nın pörtleyen gözlerine çevirdim."


translate turkish d5_ending_genius_aftertitles_ade3f856:



    voice "voice/anton/Adult/16 Za.ogg"
    Ant "Niye diye soruyor musun bir de puşt?"


translate turkish d5_ending_genius_aftertitles_1e02adce:


    "Telefon ekranında kısa saçlı bir genç vardı."


translate turkish d5_ending_genius_aftertitles_a9c26fc2:


    "Köyün duyuru grubunda bu gibi bir dolu fotoğraf vardı."


translate turkish d5_ending_genius_aftertitles_9acc8474:


    "Kaybolan akıl hastaları, öksüz gençler ve ardından kimsenin ağlamayacağı kimsesizler..."


translate turkish d5_ending_genius_aftertitles_ecdd0c0b:


    "O kahrolası okulun duyuru panosundaki kayıp posterleri aklıma gelmişti."


translate turkish d5_ending_genius_aftertitles_4573bfb2:



    voice "voice/anton/Adult/17 De.ogg"
    Ant "Baksana, çocuklar kaybolmaya devam ediyor."


translate turkish d5_ending_genius_aftertitles_85fb240d:


    "Byaşa burnunu çekti. Ağzından salyalar akıyor, pijama altına koyu bir leke yayılıyordu. Polina öfkeyle burnunu çekti."


translate turkish d5_ending_genius_aftertitles_628b3daf:



    voice "voice/anton/Adult/18 Kru.ogg"
    Ant "Sanat sepet kulübü demek he?"


translate turkish d5_ending_genius_aftertitles_4a81c56d:



    voice "voice/Polina/5day/255 mi.ogg"
    Pol "Her şeyi biliyoruz."


translate turkish d5_ending_genius_aftertitles_8e4897dd:


    "Polina bagajı açıp Byaşa'ya plastik bir poşet fırlattı."


translate turkish d5_ending_genius_aftertitles_ad9d8de5:


    "Girişimci bir sağlık çalışanının sattığı birkaç hayvan maskesi poşetten düşüp karlara saçıldı."


translate turkish d5_ending_genius_aftertitles_4720a0b9:



    voice "voice/anton/Adult/19 V.ogg"
    Ant "Tımarhanede maske yapıyormuşsun."


translate turkish d5_ending_genius_aftertitles_dfa28b6a:



    voice "voice/byasha/5day/31ya.ogg"
    Bya "T-Toşa, a-anlamıyorum!"


translate turkish d5_ending_genius_aftertitles_f283bd71:



    voice "voice/byasha/5day/32mn.ogg"
    Bya "İ-i-iyileşmeme faydası olur, demişlerdi he..."


translate turkish d5_ending_genius_aftertitles_d6a03cff:



    voice "voice/byasha/5day/33cht.ogg"
    Bya "A-a-aklımı toparlamama yardım edermiş..."


translate turkish d5_ending_genius_aftertitles_d7033208:



    voice "voice/byasha/5day/34ya.ogg"
    Bya "K-k-kötülük ettiğimi bilmiyordum he!"


translate turkish d5_ending_genius_aftertitles_785be999:


    "Zihnimde \"Sanatın kötülüğü olur mu?\" sorusu yankılandı."


translate turkish d5_ending_genius_aftertitles_08dccf41:


    "Ben de hayatın acımasızlığından resim çizerek kaçmaya çalışmıyor muydum?"


translate turkish d5_ending_genius_aftertitles_4f72f212:


    "Kuşkularımı bastırmak için sesimi yükselttim."


translate turkish d5_ending_genius_aftertitles_a21f789c:



    voice "voice/anton/Adult/20 Ti.ogg"
    Ant "Genç hastaları toplamışsın."


translate turkish d5_ending_genius_aftertitles_83eda2cc:



    voice "voice/anton/Adult/21 Ma.ogg"
    Ant "Hepsi şizofren, otistik delikanlılar."


translate turkish d5_ending_genius_aftertitles_1b253aab:



    voice "voice/anton/Adult/22 Ti.ogg"
    Ant "Hastane sakinlerini yiyormuşsun."


translate turkish d5_ending_genius_aftertitles_6eb7d648:


    "Byaşa inildeyerek boyun eğdi. Boğazından bir hırıltı yükseldi."


translate turkish d5_ending_genius_aftertitles_05bb9a0b:



    voice "voice/anton/Adult/23 T.ogg"
    Ant "Nenemi hatırlıyor musun?"


translate turkish d5_ending_genius_aftertitles_3cdf90db:


    "Zihnimde titrek bir mum ışığıyla aydınlanan nenemin silüeti belirdi."


translate turkish d5_ending_genius_aftertitles_19372b6f:



    voice "voice/byasha/5day/36os.ogg"
    Bya "B-b-beni rahat bırakın he..."


translate turkish d5_ending_genius_aftertitles_d5e20698:



    voice "voice/anton/Adult/24 Ba.ogg"
    Ant "Nenem burada yaşıyordu. Manastırın yakınındaki eski kiliseye gidiyordu."


translate turkish d5_ending_genius_aftertitles_21d1da29:



    voice "voice/byasha/5day/37ya.ogg"
    Bya "S-s-seni duyamıyorum he..."


translate turkish d5_ending_genius_aftertitles_3105da58:



    voice "voice/anton/Adult/25 Um.ogg"
    Ant "Keşişin biri ölüm döşeğindeyken, neneme kötülüğün dünyamızda kol gezdiğini ancak kainattaki varlıkların fanilere göz kulak olduğunu söylemiş."


translate turkish d5_ending_genius_aftertitles_7c8191ac:



    voice "voice/byasha/5day/38so.ogg"
    Bya "V-v-varlıklar..."


translate turkish d5_ending_genius_aftertitles_41a80c2c:


