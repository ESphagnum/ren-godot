    voice "voice/Polina/5day/04 eh.ogg"
    Pol "Yok oldu."


translate turkish d5_ending_past_f707d14c:


    "Sözleri içimi dağlamıştı."


translate turkish d5_ending_past_9beb885c:



    voice "voice/anton/5day/215.Poz.ogg"
