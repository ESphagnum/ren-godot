translate turkish event_m_story2_afterdev_b0bdb47c:



    voice "voice/Polina/5day/44 on.ogg" 
    Pol "Hayatını Petrov'a borçlu."


translate turkish event_m_story2_afterdev_5ad68ce4:


    "Sınıf da hemfikir olduğunu belirtti. Apaçık benim tarafımdaydılar."


translate turkish event_m_story2_afterdev_6468c2c9:


    "Bunu sindirmeye zamanım olmadan kader bir kez daha oyununu oynadı."


translate turkish event_m_story2_afterdev_d7f5bf99:


    voice "voice/kate/5day/023pad.ogg"


translate turkish event_m_story2_afterdev_e9a0a7dc:


    "Katya bocalayıverdi. Düşmesin diye onu tutup sırama oturttum."


translate turkish event_m_story2_afterdev_4be644d8:



    voice "voice/kate/5day/06 pr.ogg"
    Kate "Özür dilerim Anton."


translate turkish event_m_story2_afterdev_d3d3aaa1:


    "Maskesi düşmüştü."


translate turkish event_m_story2_afterdev_25f4013a:


    "Jandarma aracının arka koltuğunda elimi sımsıkı tutan Katya tekrar karşımdaydı."


translate turkish event_m_story2_afterdev_9ee51ad9:



    voice "voice/kate/5day/024 Ya.ogg"
    Kate "Sen değil, ayağım yüzünden canım sıkkın."


translate turkish event_m_story2_afterdev_5ca63b63:



    voice "voice/kate/5day/025 Pr.ogg"
    Ant "Çok üzgünüm... Salaklık ettim."


translate turkish event_m_story2_afterdev_0e741821:


    "Katya'nın ani itirafına şaşırıp mırıldandım."


translate turkish event_m_story2_afterdev_918f6c42:



    voice "voice/kate/5day/026 m.ogg"
    Kate "Oturur musun?"


translate turkish event_m_story2_afterdev_e58d406d:



    voice "voice/Anton/5day/58 No.ogg"
    Ant "İyi de Liliya öğretmenim..."


translate turkish event_m_story2_afterdev_cab62222:



    voice "voice/lydia/5day/08 Lad.ogg"
    Lilia_P "Oturabilirsin Petrov."


translate turkish event_m_story2_afterdev_9c44c71a:



    voice "voice/lydia/5day/09 Da.ogg"
    Lilia_P "Derse başlayalım artık."


translate turkish event_m_story2_afterdev_d40067e5:


    "Sırama oturdum. Katya gözünü bana dikmişti. İçim gıdıklanıyordu."


translate turkish event_m_story2_afterdev_90b3cad9:


    "Döndüğümde Polina'nın bakışlarıyla karşılaştım."


translate turkish event_m_story2_afterdev_1e396f10:


    "Katya'yla aramda olup bitenleri anlamak için var gücüyle uğraşıyordu."


translate turkish event_m_story2_afterdev_3fd02895:


    "Ancak ne olduğunu ben bile anlamıyordum."


translate turkish event_m_story2_afterdev_862859e9:



    voice "voice/kate/5day/027 z.ogg"
    Kate "Anton ya, hastanedeyken düşündüm de..."


translate turkish event_m_story2_afterdev_59cf963d:



    voice "voice/kate/5day/028 Ya.ogg"
    Kate "Herkese çok haksızlık ettim."


translate turkish event_m_story2_afterdev_85d1b6ec:



    voice "voice/kate/5day/029 a.ogg"
    Kate "Hele ki sana..."


translate turkish event_m_story2_afterdev_a4b16879:



    voice "voice/Anton/5day/59 Ya.ogg"
    Ant "Ben onları çoktan unuttum bile..."


translate turkish event_m_story2_afterdev_610bd101:



    voice "voice/kate/5day/030 A.ogg"
    Kate "Kesin öyledir. Yalancı seni."


translate turkish event_m_story2_afterdev_3d91507e:


    "Yarış arabalı siyah kalem kutumu dirseğiyle yanlışlıkla itip sıradan düşürdü."


translate turkish event_m_story2_afterdev_dca664bd:


    "Kutumu almak için eğildim."


translate turkish event_m_story2_afterdev_7c112525:


    "O an Katya'nın sargılı ayağını görüp donakaldım. Ardından doğruldum."


translate turkish event_m_story2_afterdev_89300093:


    "Katya bana bir not uzattı."


translate turkish event_m_story2_afterdev_148a518f:


    "\"Artık yalan söylemeyeceğine söz ver.\""


translate turkish event_m_story2_afterdev_423e20e0:


    "Gülümseyip kalemimi aldım ve notun hemen altına yazdım."


translate turkish event_m_story2_afterdev_660aad47:


    "\"Elimden geleni yaparım.\""


translate turkish event_m_story2_afterdev_8e9a116b:


    "Katya da kalem kutusundan kırmızı bir kalem çıkardı."


translate turkish event_m_story2_afterdev_4ff5d37d:


    "Gözlerini kısıp, yazılanları pürdikkat inceledi ve bana baktı. Ardından yazımın hemen altına \"B+\" diye not düştü."


translate turkish event_m_story2_afterdev_ef303ae1:



    voice "voice/kate/5day/031 da.ogg"
    Kate "Tabii, tabii! El yazın biraz biçimsiz, o yüzden A vermedim."


translate turkish event_m_story2_afterdev_b5a30c93:


    "Burnumu çekerek karşılık verdim."


translate turkish event_m_story2_afterdev_cc23e3c0:



    voice "voice/kate/5day/032 o.ogg"
    Kate "Ancak notunu iyileştirmek senin elinde."


translate turkish event_m_story2_afterdev_8dd095e6:


    "Polina'nın bakışlarını hissedebiliyordum."


translate turkish event_m_story2_afterdev_baa84bbd:


    "Tuhaf, kaygı verici ancak keyifli bir duygu selinin içindeydim."


translate turkish event_m_story2_afterdev_90213b43:



    voice "voice/Anton/5day/61 Dop.ogg"
    Ant "Diyelim ki A almak istiyorum."


translate turkish event_m_story2_afterdev_c5bafeed:



    voice "voice/kate/5day/033 t.ogg"
    Kate "O zaman okuldan sonra beni evime geçirmelisin."


translate turkish event_m_story2_afterdev_b7d93f90:



    voice "voice/kate/5day/034 to.ogg"
    Kate "Yani şey..."


translate turkish event_m_story2_afterdev_05d70552:


    "Mahcubiyetle gülümseyip eski benliğinden kaçmaya çalıştı."


translate turkish event_m_story2_afterdev_4ff794e5:



    voice "voice/kate/5day/034 Ya .ogg"
    Kate "Beni evime geçirebilir misin? Rica ediyorum."


translate turkish event_m_story2_afterdev_da950bf4:


    "Bunu... biraz düşünmeliydim."


translate turkish event_m_story2_afterdev_98d65761:


    "Sınıfın en güzel iki kızı onları evlerine geçirmemi istemişti."


translate turkish event_m_story2_afterdev_181f0891:


    "Hayal mı görüyordum yoksa? İlaçlarımı içse miydim?"


translate turkish event_m_story2_afterdev_3d64a051:



    voice "voice/Anton/5day/62 Vd.ogg"
    "Ağzımı açtığım an Romka ve Byaşa'nın sırasında bizden daha küçük bir çocuğun oturduğunu fark ettim."


translate turkish event_m_story2_afterdev_8ca85787:


    "Başını tümüyle örten bir kapüşon takıyordu... "


translate turkish event_m_story2_afterdev_ed7e4aa5:


    "Ruhumdaki boşluk korkuyla doluverdi. Boğazım düğümlendi. Nefesim kesildi."


translate turkish event_m_story2_afterdev_cfa55fc2:


    "O silüeti daha önce görmüştüm. Seri katilin garajında, jeneratörün yanındaydı!"


translate turkish event_m_story2_afterdev_4c5509f9:


    "Lafı ağzımda iyice geveledim."


translate turkish event_m_story2_afterdev_8bc43730:



    voice "voice/Anton/5day/63 Ka.ogg"
    Ant "Katya..."


translate turkish event_m_story2_afterdev_5cb9cb7e:



    voice "voice/kate/5day/35 da.ogg"
    Kate "Söyle."


translate turkish event_m_story2_afterdev_0bd3f6c9:


    "Gözlerimi o tuhaf silüetten ayırıp elimi cebime attım ve avucuma bir hap aldım."


translate turkish event_m_story2_afterdev_45f33762:


    "Doğrudan ağzıma atıp çiğnedim."


translate turkish event_m_story2_afterdev_46ab39ba:



    voice "voice/Anton/5day/65 K.ogg"
    Ant "Baksana, Roma'nın sırasında..."


translate turkish event_m_story2_afterdev_a2c8c894:


    "Tekrar çocuğa baktığımda onu göremedim. Tek gördüğüm, bıçak izleri taşıyan bir sıra ve iki oturaktı."


translate turkish event_m_story2_afterdev_2503f0bc:



    voice "voice/kate/5day/36 E.ogg"
    Kate "Nesi var ki?"


translate turkish event_m_story2_afterdev_f58212c7:


    "Neyim var benim?"


translate turkish event_m_story2_afterdev_3e9ca716:



    voice "voice/Anton/5day/66 Nich.ogg"
    Ant "Yok bir şey. Boş ver."


translate turkish event_m_story2_afterdev_87ac732d:



    voice "voice/tihonov/5day/27 Pro.ogg"
    Tikhonov "Dersinizi bölüyorum. Kusura bakmayın..."


translate turkish event_m_story2_afterdev_a7c2a81e:


    "Üsteğmen Tihonov sınıfa girip şapkasını çıkardı."


translate turkish event_m_story2_afterdev_c0ce8c47:



    voice "voice/lydia/5day/10 Nu.ogg"
    Lilia_P "Yok canım, özre gerek yok. Size her zaman kapımız açık."


translate turkish event_m_story2_afterdev_cedda014:



    voice "voice/tihonov/5day/28 M.ogg"
    Tikhonov "İki öğrencinizden, Petrov ve Pyatifanov'dan bahsetmek istiyorum."


translate turkish event_m_story2_afterdev_6ce7709d:



    voice "voice/lydia/5day/11 Pya.ogg"
    Lilia_P "Bildiğim kadarıyla Pyatifanov evinde istirahat ediyor."


translate turkish event_m_story2_afterdev_b5fbd12c:



    voice "voice/lydia/5day/12 A.ogg"
    Lilia_P "Petrov sınıfımızda. Çıkıntılık yapıyor."


translate turkish event_m_story2_afterdev_9c6c2553:


    "Üsteğmen uzaktan sınıfı tarayıp beni buldu. Ardından boğazını temizledi. Dosyasından bir belge çıkarıp okumaya başladı."


translate turkish event_m_story2_afterdev_3c43fc1a:



    voice "voice/tihonov/5day/30 Za.ogg"
    Tikhonov "Cesareti, içten davranışları ve başka bir vatandaşın hayatını kurtarırken sergilediği yüreklilik için..."


translate turkish event_m_story2_afterdev_2da06d83:



    voice "voice/kate/5day/37 Nu.ogg"
    Kate "Ayağa kalksana. Belge sana."


translate turkish event_m_story2_afterdev_0207ef18:


