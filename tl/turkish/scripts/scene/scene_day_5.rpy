translate turkish d5_ending_was_there_aftertitles_f17f136e:


    "Sütümün geldiğini hissettim."


translate turkish d5_ending_was_there_aftertitles_d6aec267:


    "Hemen ardından içimi bir sıkıntı bastı."


translate turkish d5_ending_was_there_aftertitles_10af9b57:


    "Aç yaratıkların çember olup dans edişi gözümün önüne gelmişti."


translate turkish d5_ending_was_there_aftertitles_6a826683:


    "\"Hep dans ederiz, hep aç gezeriz!\" diyorlardı."


translate turkish d5_ending_was_there_aftertitles_d81f09c7:


    "Beşiğe yaklaşıp içine baktım."


translate turkish d5_ending_was_there_aftertitles_1ca1433c:


    "Oğlum minik ellerini yumruk yapıp havaya savurdu. Göğsünde güve yeniğinden delik deşik olmuş eski bir maske vardı."


translate turkish d5_ending_was_there_aftertitles_a9291031:


    "Gözlerindeki boşluklara bakakaldım."


translate turkish d5_ending_was_there_aftertitles_0ff7df0b:


    "Maskenin ardındaki karanlık da beni gözetliyordu."


translate turkish d5_ending_home_violence_7e7eea8b:


    "Kapının önünde kıllı biri dikiliyor, buram buram çam dikeni ve sülfür kokuyordu."


