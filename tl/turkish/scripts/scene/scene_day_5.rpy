translate turkish event_m_polina_accept_87c7e74d:


    "Yanılsamalar beni yalnız bırakmıştı."


translate turkish event_m_polina_accept_e6990908:



    voice "voice/Anton/5day/186 Y.ogg"
    Ant "Deliyim ya."


translate turkish event_m_polina_accept_e467a3f0:


    "Polina huzurla gülümseyip karşılık verdi."


translate turkish event_m_polina_accept_09c40bdb:



    voice "voice/Polina/5day/145 Sl.ogg" 
    Pol "İtirazım yok."


translate turkish event_m_polina_accept_7a22cd95:



    voice "voice/Polina/5day/146 No.ogg" 
    Pol "Ancak şunu söyleyeyim, tanıdığım en havalı delisin."


translate turkish event_m_polina_accept_57c7ead2:



    voice "voice/Polina/5day/147 ps.ogg"
    Pol "Yakışıklı bir manyaksın."


translate turkish event_m_polina_accept_f24ac718:


    "Polina birden kucağıma oturup olgun bakışlarla beni süzdü."


translate turkish event_m_polina_accept_a8a52eb8:


    "Kalbim anın şaşkınlığıyla tekledi, neredeyse duracaktı."


translate turkish event_m_polina_accept_4ba459db:


    "Neyse ki vücudumun her yerine sıcacık kan pompalamaya devam etti."


translate turkish event_m_polina_accept_b6e1b023:


    "Aklıma babam geldi."


translate turkish event_m_polina_accept_a98baca0:


    "O da annemle tanışmadan önce gençliğinde böyle bir şey yaşamış mıdır?"


translate turkish event_m_polina_accept_ad544772:


    "Ona Polina'nın bana baktığı gibi bakan olmuş mudur?"


translate turkish event_m_polina_accept_e5cd3772:


    "Öyleyse bu hislerle nasıl başa çıkabilmiş?"


translate turkish event_m_polina_accept_714a6986:


    "Polina omuzumu hafifçe silkeleyip fısıldadı."


translate turkish event_m_polina_accept_e5d583fb:



    voice "voice/Polina/5day/148 Ne.ogg" 
    Pol "Bir yere kaçmayacaksın, değil mi?"


translate turkish event_m_polina_accept_ad78aa99:



    voice "voice/Anton/5day/187 N.ogg"
    Ant "Elbette."


translate turkish event_m_polina_accept_8e9f45af:


    "Öpüşüverdik."


translate turkish event_m_polina_accept_31b53116:


    "Mumlar söndü."


translate turkish event_m_polina_refuse_638c1245:


    "Ya yaşadıklarım gerçekse?"


translate turkish event_m_polina_refuse_3e17de76:


    "Avucumdaki hapları sıktım."


translate turkish event_m_polina_refuse_a513747f:


    "Ya Olya'nın bana ihtiyacı varsa, beni uyarmak istediyse?"


translate turkish event_m_polina_refuse_60746dd4:



    voice "voice/Polina/5day/149 A.ogg" 
    Pol "Hadi ya Anton."


translate turkish event_m_polina_refuse_7f3d000c:


    "Polina'nın gözlerinde parlayan korkuyu görünce irkildim. Korku da değil, artan panik hissiydi."


translate turkish event_m_polina_refuse_41ecbc33:



    voice "voice/Anton/5day/188 Ch.ogg"
    Ant "Ne oldu?"


translate turkish event_m_polina_refuse_6d9632d8:


    "Feryat sesleri giderek şiddetleniyor, odanın dört bir yanında yankılanıyordu."


translate turkish event_m_polina_refuse_823805aa:


    "Polina bir şeyden mi ürkmüştü? O da mı köşeye bakmıştı? Duyduklarımı o da mı duyuyordu?"


translate turkish event_m_polina_refuse_cf59fa5d:



    voice "voice/Anton/5day/189 T.ogg"
    Ant "Demek yanılsama değilmiş..."


translate turkish event_m_polina_refuse_b0a1f12b:



    voice "voice/Polina/5day/13 krik.ogg" 
    "Kapıdan yumruk sesleri gelmeye başlayınca Polina çığlık attı."


translate turkish event_m_polina_refuse_e6c3c442:


    "Kedi tavana sıçrayıp perdeleri yırttı ve karanlığa karıştı."


translate turkish event_m_polina_refuse_ae31da7a:


    "İkimiz de ezilip büzüldük."


translate turkish event_m_polina_refuse_9845a920:



    voice "voice/Polina/5day/150 net.ogg" 
    Pol "Hayır, olamaz..."


translate turkish event_m_polina_refuse_0e234806:


    "Zangır zangır titreyerek başını sallıyordu."


translate turkish event_m_polina_refuse_ef7d68f6:


    "Olya'nın çığlıkları ve tipinin ürkütücü sesi koro halinde yükseliyordu. Kapıya tekme, yumruk, ne varsa iniyordu."


translate turkish event_m_polina_refuse_fadfa638:


    "Mumlar titreşiyor, etrafımızı kuşatan karanlık büyüyordu."


translate turkish event_m_polina_refuse_ddd716c5:



    voice "voice/Hariton/02 Po.ogg"
    Noname "Polina! Polina, evde misin?"


translate turkish event_m_polina_refuse_9b4dc826:


    "Dedesiydi... Taburcu olmuştu... İyi de neden gecenin köründe?"


translate turkish event_m_polina_refuse_e0453c58:


    "Sesi de pek keskin dişli bir hayvanı andırıyordu."


translate turkish event_m_polina_refuse_2daf902a:



    voice "voice/Polina/5day/151 Ch.ogg" 
    Pol "Anton, ne yaptın sen? Niye ilaçlarını içmedin?"


translate turkish event_m_polina_refuse_ad94395a:


    "Fal taşı gibi açık gözlerinden yaşlar boşaldı."


translate turkish event_m_polina_refuse_ec243db8:



    voice "voice/Hariton/03 Vi.ogg"
    Noname "Çık dışarıya, cansız evladım!"


translate turkish event_m_polina_refuse_70e39d26:



    voice "voice/Hariton/42.C2.ogg"
    Noname "Çıkmayacaksan bari kendinden bir lokma ver!"


translate turkish event_m_polina_refuse_a97740e1:



    voice "voice/Polina/5day/13 Vs.ogg"
    "Polina salya sümük ağlıyordu. Pörtleyen gözlerinden yaşlar fışkırıyordu."


translate turkish event_m_polina_refuse_a58a1c32:


    "Kapının ardından bir gıcırtı koptu."


translate turkish event_m_polina_refuse_aa05296e:


    "Hariton... Ne ara doğrulmuş da onca kar fırtınasında, karanlıkta yürümüş?.."


translate turkish event_m_polina_refuse_d7fa5639:


    "Pencerede bir anlığına izbandut gibi biri belirdi."


translate turkish event_m_polina_refuse_d2851100:


    "Camdaki kırağı sıcacık bir nefesle çözüldü. O boşlukta pörtlek bir göz göründü."


translate turkish event_m_polina_refuse_95577ecf:


    "Kocaman biri, içeride taze et var mı diye odaya baktı."


translate turkish event_m_polina_refuse_a0fc178d:


    "Pençeleriyle buz tabakasını kırıp camı tırmaladı."


translate turkish event_m_polina_refuse_d9df5bbf:



    voice "voice/Polina/5day/13 krik.ogg"
    "Pencere açılıverip buz gibi hava içeriye doluştu. Yere cam kırıkları saçıldı. Pencerenin kenarlarına kavisli kemikler tutundu."


translate turkish event_m_polina_refuse_fe55777d:


    "Rüzgarın odaya girmesiyle mumların çoğu söndü ancak bir tanesi devrilmesine rağmen yanmaya devam ediyordu."


translate turkish event_m_polina_refuse_0a1f832d:


    "Gece ortaya çıkıp zavallı Polina'yı ziyaret eden yaratıkları görebilmem için sönmemekte ısrar ediyor gibiydi. Önderleri de yanlarındaydı."


translate turkish event_m_polina_refuse_69c180a3:


    "Korkudan ellerimle yüzümü örtmüş, pencerede beliren dev yaratıklara parmaklarımın arasından bakıyordum."


translate turkish event_m_polina_refuse_7b41d586:


    "Kana susamış yaratığın gözleri ay gibi parıldarken bir o kadar da gizemliydi."


translate turkish event_m_polina_refuse_80ab17aa:


    "Yaratık elini uzatıp bıçak gibi keskin parmağıyla bizi işaret etti."


translate turkish event_m_polina_refuse_b5785174:


    "Odaya sel gibi azgın bir kurt sürüsü doluştu."


translate turkish event_m_polina_refuse_fa216c52:


    "Dev yaratık da peşlerinden girdi."


translate turkish event_m_polina_refuse_a92b98a7:


    "Doğruldu. Boyu tavana kadar uzanıyordu."


translate turkish event_m_polina_refuse_0e9bd6c8:


    "Uzun kulakları, kalın kafasının üstünde titreşiyordu."


translate turkish event_m_polina_refuse_c49ab2fc:


    "Yaratıkların gölgeleri duvarlarda fink atıyordu."


translate turkish event_m_polina_refuse_e7b9ebc1:


    "Mumdan yükselen ateş, masa örtüsünü çıtırtılar eşliğinde tutuşturmuştu."


translate turkish event_m_polina_refuse_2099557c:


    "Burun deliklerim dumana boğuldu. Cehennemi andırmayan bu yerde karşımızdaki aç iblisler sırıtıyordu."


translate turkish event_m_polina_refuse_af68d1d4:


    "Korkudan donakalmıştım. Kaçmak için kanepeden sıçrayan Polina'yı ancak izleyebildim."


translate turkish event_m_polina_refuse_30966af4:


    "Odanın ortasına ulaştığında o da titremeye başlayıp korkunç şeytanın önünde dizlerinin üstüne düştü."


translate turkish event_m_polina_refuse_5a48efd3:


    "Şeytan ormandan, buz gibi mezarlardan kopup gelmişti."


translate turkish event_m_polina_refuse_bfebd071:


    "Tavşancık sol patisini uzatıp Polina'nın saçına yapıştı."


translate turkish event_m_polina_refuse_98e873cd:


    "Sağ elinin parmakları pervane gibi dönüyor, kurbanının acizliğinden adeta zevk alıyordu."


translate turkish event_m_polina_refuse_61cd7538:


    "Pençesini kızın çehresinde ağır ağır gezdirdi."


translate turkish event_m_polina_refuse_fdc682a8:


    "Yanaklarından çenesine geçti ve alnına geri döndü."


translate turkish event_m_polina_refuse_2704620a:


    "Polina feryatlar içindeydi."


translate turkish event_m_polina_refuse_45218330:


    "Cildi, o bıçak gibi keskin pençeye teslim olmuştu. Solgun yanaklarından gözyaşları akıyordu."


translate turkish event_m_polina_refuse_a706a7f1:


    "Yanan giysi parçaları, sandalyenin dolgusunu da tutuşturmuştu."


translate turkish event_m_polina_refuse_dd89c83d:


    "Canavar da Polina'nın yüzünü boydan boya tek harekette kesmiş, onu bez parçası gibi bir kenara fırlatıvermişti."


translate turkish event_m_polina_refuse_539b61d6:


    "Gözlerinin, dudaklarının olması gerektiği yerde vıcık vıcık bir et yığını, kas telleri ve yağ bezeleri kalmıştı."


translate turkish event_m_polina_refuse_71f6805c:


    "Derisi yüzülen Polina avazı çıktığı kadar bağırdı."


translate turkish event_m_polina_refuse_efea7482:


    "Alevlerin parıltısı, Polina'nın yüz kemiklerini dolduran kızıl balçıktan görülebiliyordu."


translate turkish event_m_polina_refuse_300b256d:


    "Çığlıkları cıyaklamaya dönüşmüş, cıyaklamaları da yerini bir çeşit kıkırtıya bırakmıştı."


translate turkish event_m_polina_refuse_60e70491:


    "Polina... gülüyor muydu yoksa?"


translate turkish event_m_polina_refuse_74979806:


    "Polina, yüzünün kalan kısmıyla bana döndü."


translate turkish event_m_polina_refuse_282cd1fe:


    "Et yığınındaki bir delikten çirkin bir kahkaha koptu."


translate turkish event_m_polina_refuse_204260cc:


    "Kapaklarını yitiren gözleri yusyuvarlak yuvalarında fırıl fırıl dönüyordu."


translate turkish event_m_polina_refuse_6a7a5e5c:


    "Oracıkta ölsem de bunları bir daha görmesem diye iç geçirmiştim. Korkudan donakalmıştım."


translate turkish event_m_polina_refuse_e8747031:



    voice "voice/Polina/5day/156 ti.ogg" 
    Pol "Hiçbir şey yapamadın korkak!"


translate turkish event_m_polina_refuse_376bbebd:



    voice "voice/Polina/5day/157 ni.ogg" 
    Pol "İşe yaramazın tekisin! Beni bile koruyamadın!"


translate turkish event_m_polina_refuse_f49c5cfa:


    "Kulaklarımı tıkasam da onu hâlâ duyabiliyordum."


translate turkish event_m_polina_refuse_d4c740ee:



    voice "voice/Polina/5day/158 ro.ogg" 
    Pol "Romka senden bin kat iyiydi."


translate turkish event_m_polina_refuse_4d6f84c1:



    voice "voice/Polina/5day/159 zn.ogg" 
    Pol "Sakın unutma sünepe..."


translate turkish event_m_polina_refuse_11abd073:



    voice "voice/Polina/5day/160 ni.ogg"
    Pol "Beni hayatta kurtaramazsın Anton!"


translate turkish event_m_polina_refuse_f2eda78b:



    voice "voice/Polina/5day/161ni.ogg" 
    Pol "Senin olmam imkânsız!"


translate turkish event_m_polina_refuse_e61ef0f4:



    voice "voice/Polina/5day/162 ti.ogg" 
    Pol "Şansına küs!"


translate turkish event_m_polina_refuse_576113a2:


    "Arkamızdaki alev iyice kızdı. Dumanlar Polina'ya ulaştığında bir kez daha bağırdı."


translate turkish event_m_polina_refuse_7f327d70:


    "Sanıyorum olacakların farkındaydı."


translate turkish event_m_polina_refuse_fdaf63a4:


    "Pençenin teki, karnını cart diye yardı."


translate turkish event_m_polina_refuse_7356e36d:


    "Yaratık, Polina'nın karın boşluğuna patisini sokup iç organlarını söktü."


translate turkish event_m_polina_refuse_aab86555:


    "Mor ve kırmızı, korkunç bir renk şöleniydi."


translate turkish event_m_polina_refuse_bec05b1a:


    "Yaratık dudaklarını yalayıp organları Polina'nın boynuna halat gibi doladı. Ardından patisini kaldırdı."


translate turkish event_m_polina_refuse_f0ce1530:


    "Polina kendi iç organlarına asılı halde avizeye fırlayıp sarkaç gibi sallanmaya başladı."


translate turkish event_m_polina_refuse_2872334b:


    "Bacakları hiç de tok olmayan monoton bir sesle duvarlara çarpıyordu. Güçten kesilen parmaklarıyla boynundaki iğrenç ilmeği tırmalıyordu."


translate turkish event_m_polina_refuse_433e946b:


    "Canavar, ağzını bana çevirdi. Yapış yapış salya akıyordu."


translate turkish event_m_polina_refuse_8f00ee4e:


    "Polina'nın kolları gevşemişti ancak cansız bedeni rüzgarda salınmaya devam ediyordu."


translate turkish event_m_polina_refuse_ff603f56:


    "Kurtlar saldırıya hazırdı. Emir bekliyorlardı."


translate turkish event_m_polina_refuse_e042c9ec:


    "Diken diken olan leş gibi tüylerinin altındaki kasları kabarmıştı."


translate turkish event_m_polina_refuse_c4f707ec:


    "Ziyafeti beklerken nasırlı kuyruklarını bir sağa bir sola savuruyorlardı."


translate turkish event_m_polina_refuse_38273307:


    "Canavar elini yavaşça kaldırıp pençesiyle beni dürttü."


translate turkish event_m_polina_refuse_0fa3eb2c:



    voice "voice/bunny/13 Ez.ogg"
    Bunny "Senin gibiler yüzünden dışlandık!"


translate turkish event_m_polina_refuse_11f6ad30:



    voice "voice/bunny/14 Vs.ogg"
    Bunny "Sürüdeki herkes aya dişlerini geçirmişti..."


translate turkish event_m_polina_refuse_7f3458cb:



    voice "voice/bunny/15 As.ogg"
    Bunny "Ancak sen kendini özel sandın!"


translate turkish event_m_polina_refuse_1837a01b:



    voice "voice/bunny/16Tv .ogg"
    Bunny "Etin mide asidinde eriyecek."


translate turkish event_m_polina_refuse_dc3e1303:



    voice "voice/bunny/17Tv.ogg"
    Bunny "Ruhun, ormanın pençesine düşecek."


translate turkish event_m_polina_refuse_f23bc9d5:



    voice "voice/bunny/18 Tv.ogg"
    Bunny "Adın hafızalardan silinecek."


translate turkish event_m_polina_refuse_51430495:


    "Kurtlar uludu."


translate turkish event_m_polina_refuse_73b38b0b:


    "En yakınımdaki yırtıcı sıçrayıp dişlerini boğazıma geçirdi."


translate turkish event_m_polina_refuse_9c7745b6:


    "Polina'nın gölgesi duvarda sallanıyordu."


translate turkish event_m_polina_refuse_5b641b60:


    "Kurdun yapış yapış kafa derisine parmaklarımı geçirip son gücümle onu itmeyi denedim."


translate turkish event_m_polina_refuse_4312a689:


    "Ancak gırtlağımı koparmıştı."


translate turkish event_m_polina_refuse_bc729829:



    voice "voice/bunny/19 Nu.ogg"
    Bunny "Ee... Ölüm korkunç muymuş?"


translate turkish event_m_polina_refuse_2e6f3731:


    Oly "AAAAAAAA!"


translate turkish event_m_polina_refuse_c119b180:



    voice "voice/anton/5day/sluni.ogg"
    "Kendi kanımda boğulduğumu zannederken ağzımda salyalarla gözlerimi açtım."


translate turkish event_m_polina_refuse_4e72f538:


    "Olya'nın çığlığı kesilse de zihnimde yankılanıyordu."


translate turkish event_m_polina_refuse_8b7ec864:


    "Az önceki acıyı artık hissetmiyordum."


translate turkish event_m_polina_refuse_41e3163d:


    "Kurtlar, canavarlar, Polina'nın cansız bedeni... Hepsi yok olmuştu."


translate turkish event_m_polina_refuse_fe6567f3:


    "Hariton'un evindeki yanan odadan evimizin koridoruna ışınlanmıştım. Tüm bunlar rüya mıydı?"


translate turkish event_m_polina_refuse_29fb91a9:


    "Boğazımı yokladım. Yara bere yoktu."


translate turkish event_m_polina_refuse_95a875db:


    "Sadece Polina'larda geçirdiğim gece de değil, geçen ayın tamamı; uzvunu yitiren Katya ve garajdan kaçışımız..."


translate turkish event_m_katya_devend_c6fc05a3:


    "Polina'ya baktım."


translate turkish event_m_katya_devend_596994e6:


    "Masum gülüşüne aldanmamıştım."


translate turkish event_m_katya_devend_915f9f40:


    "Kar taneleri okul bahçesine bembeyaz perde gibi inse de olan biteni daha net görebiliyordum."


translate turkish event_m_katya_devend_3b9f0535:


    "Polina'ya hâlâ güvenemezdim."


translate turkish event_m_katya_devend_786f9a45:



    voice "voice/Anton/5day/192 P.ogg"
    Ant "Üzgünüm Polina. Katya'nın yardımıma daha fazla ihtiyacı var."


translate turkish event_m_katya_devend_d67c4943:


    "Polina bana tokat yemişçesine baktı."


translate turkish event_m_katya_devend_ebc07830:


    "Gözleri kısıldı. Titreyen dudaklarındaki gülüş yok oluverdi."


translate turkish event_m_katya_devend_4b944c3c:



    voice "voice/kate/5day/62 Es.ogg"
    Kate "Senin için sorun olmazsa tabii. Olmaz değil mi Polina?"


translate turkish event_m_katya_devend_4e190ed8:


    "Romka'yı görmemizle aramızdaki tuhaf sessizlik bozuldu."


translate turkish event_m_katya_devend_4d66e3df:


    "Başını eğmiş, köşenin oradan geçiyordu."


translate turkish event_m_katya_devend_bd9f4fde:


    "Dostunu kaybetmek belli ki omuzlarında büyük bir yük doğurmuştu."


translate turkish event_m_katya_devend_3536de2b:


    "Katya dirseğime yapıştı ancak aldırış etmedim."


translate turkish event_m_katya_devend_0fdf0024:



    voice "voice/Polina/5day/165 R.ogg" 
    Pol "Roma!"


translate turkish event_m_katya_devend_6a3a5cdd:


    "Polina, Romka'ya koşup ona sarıldı."


translate turkish event_m_katya_devend_46d51701:



    voice "voice/Polina/5day/166 ro.ogg" 
    Pol "Romoçka, sensiz ne haldeydim bir bilsen!"


translate turkish event_m_katya_devend_4ebc8af6:



    voice "voice/Polina/5day/167 nu.ogg" 
    Pol "Nerelerdeydin?"


translate turkish event_m_katya_devend_3c699788:


    "Kısa bir duraksamadan sonra Romka ellerini Polina'nın ürperen sırtına kondurdu."


translate turkish event_m_katya_devend_58f5d7fb:



    voice "voice/kate/5day/63 b.ogg"
    Kate "Kendini hiç ağırdan satmadı. Bu durum canını sıkmıyor mu Anton?"


translate turkish event_m_katya_devend_b1549d79:


    "Kafamı salladım."


translate turkish event_m_katya_devend_68f91cbb:


    "Romka elini kaldırdı. Her zamanki gururlu gülüşü yüzünde bir anlığına belirip kayboluverdi."


translate turkish event_m_katya_devend_bf673c64:



    voice "voice/romka/5day/41 Nu.ogg"
    Rom "Ağlama yahu, hoşlanmıyorum."


translate turkish event_m_katya_devend_cdeca368:



    voice "voice/romka/5day/42 Na.ogg"
    Rom "Okuldan mı çıktın?"


translate turkish event_m_katya_devend_1f849953:



    voice "voice/Polina/5day/168 bi.ogg" 
    Pol "Aynen..."


translate turkish event_m_katya_devend_10c91e3c:



    voice "voice/romka/5day/43 B.ogg"
    Rom "Byaşa'yı gördün mü?"


translate turkish event_m_katya_devend_b5e4dda1:



    voice "voice/Polina/5day/168 ne.ogg" 
    Pol "Hayır."


translate turkish event_m_katya_devend_d452472c:


    "Roma karlara tükürdü. Ardından bakışlarını Katya'yla bana yöneltti."


translate turkish event_m_katya_devend_b656f847:



    voice "voice/romka/5day/45 A.ogg"
    Rom "Siz Byaşa'yı gördünüz mü peki?"


translate turkish event_m_katya_devend_ba2f83fb:


    "Şaşkınlıkla kafamı salladım."


translate turkish event_m_katya_devend_3b02b3bb:


    "Ayakkabısını ikimiz de görmüştük. Romka ayakkabının dostuna ait olduğunu söylemişti."


translate turkish event_m_katya_devend_10ef62ad:


    "Byaşa ayakkabısını seri katile öylesine vermiş, köyde yalın ayak geziyor olamazdı herhalde."


translate turkish event_m_katya_devend_a704b0c7:



    voice "voice/Anton/5day/193 R.ogg"
    Ant "Roma, Byaşa o garaja düşmüştü."


translate turkish event_m_katya_devend_19455efe:



    voice "voice/romka/5day/46 B.ogg"
    Rom "Ne olmuş? Biz de düşmedik mi? Sağ salim çıktık işte."


translate turkish event_m_katya_devend_9230fad2:


    "Pek aklı yerinde değil gibiydi."


translate turkish event_m_katya_devend_e24f277f:



    voice "voice/romka/5day/47 Ya.ogg"
    Rom "Byaşa'nın başına gelenleri öğrenmeden bana rahat yok."


translate turkish event_m_katya_devend_ad483a0a:


    "Roma ceketinden bir paket ilan çıkardı. Birazını sayıp bana uzattı."


translate turkish event_m_katya_devend_3726f5da:



    voice "voice/romka/5day/48 Ra.ogg"
    Rom "Yol boyunca as bunları."


translate turkish event_m_katya_devend_8908565d:


    "İlanları doğru düzgün inceleyemeden Katya beni yanına çekiverdi."


translate turkish event_m_katya_devend_d22d448e:



    voice "voice/kate/5day/64 K.ogg"
    Kate "Tabii, tabii! Ne kadar ekmek, o kadar köfte."


translate turkish event_m_katya_devend_d35347c2:



    voice "voice/kate/5day/65 A.ogg"
    Kate "Emek vermezsen ekmek de olmaz."


translate turkish event_m_katya_devend_58bc9ee2:



    voice "voice/kate/5day/66 Ch.ogg"
    Kate "Hadi canım, naş naş!"


translate turkish event_m_katya_devend_57eff479:


    "Roma, Katya'nın sözlerine hiç kulak asmadı. Sadece Polina'nın omuzunu ovaladı."


translate turkish event_m_katya_devend_7ca5f718:



    voice "voice/romka/5day/49 Ed.ogg"
    Rom "Gidelim yavrum."


translate turkish event_m_katya_devend_d9ba62e6:



    voice "voice/romka/5day/49 od.ogg"
    Rom "Bu ara buralarda yalnız yürünmez."


translate turkish event_m_katya_devend_3a3f6b24:



    voice "voice/Polina/5day/169 ed.ogg" 
    Pol "Gidelim Romoçka. Sana neler neler anlatacağım."


translate turkish event_m_katya_devend_310a8da4:


    "Giderlerken Romka bana son kez kilitlenip ikimizin bildiği bir sırrı hatırlatırcasına kafasını salladı."


translate turkish event_m_katya_devend_a5366a6a:



    voice "voice/kate/5day/67 E.ogg"
    Kate "Ve sonsuza dek mutlu mesut yaşamışlar..."


translate turkish event_m_katya_devend_3d518b5d:



    voice "voice/lydia/5day/18 Kat.ogg"
    Lilia_P "Katya, yavrum!"


translate turkish event_m_katya_devend_c0d5b245:


    "İkinci kattaki pencereye baktık."


translate turkish event_m_katya_devend_a2c9071b:



    voice "voice/lydia/5day/19 Ver.ogg"
    Lilia_P "Sınıfa dön. Beni beklemen gerekecek."


translate turkish event_m_katya_devend_7d0fbb93:



    voice "voice/lydia/5day/20 Ra.ogg"
    Lilia_P "Bir ton işim var!"


translate turkish event_m_katya_devend_2ce8c1a3:



    voice "voice/Anton/5day/194 L.ogg"
    Ant "Liliya öğretmenim! Katya'yı evine bırakabilirim."


translate turkish event_m_katya_devend_acd18702:



    voice "voice/lydia/5day/21 Pr.ogg"
    Lilia_P "Ciddi misin? Ne iyi edersin ya!"


translate turkish event_m_katya_devend_4866d949:



    voice "voice/lydia/5day/22 No.ogg"
    Lilia_P "Yalnız çocuklar... Yemek hazırlamamıştım."


translate turkish event_m_katya_devend_a416bb45:



    voice "voice/kate/5day/68 Ya.ogg"
    Kate "Olsun anne. Ben bir şeyler hazırlarım. Karnımızı doyururuz."


translate turkish event_m_katya_devend_d89e6860:



    voice "voice/lydia/5day/23 Mo.ogg"
    Lilia_P "Maşallah, aferin size! Yollarda dikkatli olun."


translate turkish event_m_katya_devend_7be81fba:



    voice "voice/Anton/5day/195 K.ogg"
    Ant "Tabii!"


translate turkish event_m_katya_devend_16386849:


    "Yol boyunca ilerledik."


translate turkish event_m_katya_devend_720b1696:


    "Kül rengi bulutlar göğü kaplamış, güneşin üstünü örtmüştü. Dünyamız küf tutmuştu sanki."


translate turkish event_m_katya_devend_22ab6680:



    voice "voice/kate/5day/69 Esh.ogg"
    Kate "Tekrar özür dilerim. Hem bugün hem öncesinde yaşananlar için."


translate turkish event_m_katya_devend_139891da:



    voice "voice/kate/5day/70 T.ogg"
    Kate "Beni pek fesat biri sanmış olmalısın."


translate turkish event_m_katya_devend_54c08a09:



    voice "voice/Anton/5day/196 Che.ogg"
    Ant "Dürüst olayım mı? Benzer düşüncelere kapıldım."


translate turkish event_m_katya_devend_78bdab93:



    voice "voice/kate/5day/71 Nu.ogg"
    Kate "Geri zekalı!"


translate turkish event_m_katya_devend_ae4cefd3:



    voice "voice/Anton/5day/197 H.ogg"
    Ant "Dürüst olmamı isteyen sendin."


translate turkish event_m_katya_devend_e501a76f:



    voice "voice/kate/5day/72 Ya.ogg"
    Kate "O zaman ben de dürüst olayım."


translate turkish event_m_katya_devend_5e6e4613:



    voice "voice/kate/5day/73 Dum.ogg"
    Kate "Fesat biri olduğum için sana zorbalık yaptığımı sandıysan yanılıyorsun."


translate turkish event_m_katya_devend_603a8991:



    voice "voice/kate/5day/74 Da.ogg"
    Kate "Tabii, tabii! Hem de çok yanılıyorsun."


translate turkish event_m_katya_devend_c5c12d67:



    voice "voice/kate/5day/75 Ya.ogg"
    Kate "İlgini çekmek için kırk takla atıyordum."


translate turkish event_m_katya_devend_ffde1c1c:



    voice "voice/kate/5day/77 kh.ogg"
    "Şaşkınlıkla Katya'ya baktım."


translate turkish event_m_katya_devend_be255b32:



    voice "voice/kate/5day/76 V.ogg"
    Kate "Siz oğlanlar, kızların hal ve hareketlerinden hiçbir şey anlamıyorsunuz."


translate turkish event_m_katya_devend_48e236b9:



    voice "voice/kate/5day/79 ai.ogg"
    "Katya tek kaşını kaldırdı. Durakladık."


translate turkish event_m_katya_devend_161cf97d:



    voice "voice/kate/5day/78V.ogg"
    Kate "Neyse. Devam edelim."


translate turkish event_m_katya_devend_0b4a88e1:



    voice "voice/Anton/5day/198 Na.ogg"
    Ant "Değneklerle yürümek çok zor olmalı..."


translate turkish event_m_katya_devend_f1350c3d:


    "Bu sıradan sohbetimiz, Katya'nın dürüstlüğünün bende yarattığı utanç hissinden beni koruyordu."


translate turkish event_m_katya_devend_dadf120d:


    "Jandarma aracının arka koltuğunda el ele tutuştuğumuz anı hâlâ aklımdan çıkaramıyordum."


translate turkish event_m_katya_devend_5aee8c65:



    voice "voice/kate/5day/79 p.ogg"
    Kat "İnsan alışıyor."


translate turkish event_m_katya_devend_e6047c70:



    voice "voice/kate/5day/80 m.ogg"
    Kate "Annem de çok yardımcı oluyor."


translate turkish event_m_katya_devend_b8e87d2b:



    voice "voice/kate/5day/81 E.ogg"
    Kate "Zaten derdi başından aşkın, bir de benim topallığımla uğraşıyor."


translate turkish event_m_katya_devend_b1b2fa2f:



    voice "voice/Anton/5day/199 Y.ogg"
    Ant "Bir şey sorabilir miyim?"


translate turkish event_m_katya_devend_16c422c3:



    voice "voice/kate/5day/82 ri.ogg"
    Kate "Sor gitsin."


translate turkish event_m_katya_devend_526ad992:



    voice "voice/Anton/5day/200 T.ogg"
    Ant "Baban..."


translate turkish event_m_katya_devend_5ebd1e6a:


    "Katya dudak büzdü."


translate turkish event_m_katya_devend_0d790fb1:


    "Tehlikeli sularda yüzüyordum. Ancak bir süre sonra rahatlayıp yanıt verdi."


translate turkish event_m_katya_devend_1ab7f2ff:



    voice "voice/kate/5day/83 Pa.ogg"
    Kate "Babam akıl hastanesinde çalışıyordu."


translate turkish event_m_katya_devend_2e32a0de:



    voice "voice/kate/5day/84 Ya.ogg"
    Kate "Komşularımızın ne kadar harika insanlar olduğunu hep ondan öğrendim."


translate turkish event_m_katya_devend_4ea5f39a:


    "Konuya girmekten kaçınıyordu."


translate turkish event_m_katya_devend_457169c9:



    voice "voice/kate/5day/85 V.ogg"
    Kate "Mesela Polina. Ne biçim bir aileyse..."


translate turkish event_m_katya_devend_3436eb98:



    voice "voice/kate/5day/86 E.ogg"
    Kate "Byaşa'nın annesi, Polina'nın dedesi yüzünden tımarhaneyi boyladı."


translate turkish event_m_katya_devend_7ab20c78:



    voice "voice/Anton/5day/201 Ha.ogg"
    Ant "Hariton mu?"


translate turkish event_m_katya_devend_c63ad7c1:



    voice "voice/kate/5day/87 on.ogg"
    Kate "Ta kendisi. Yok yere değil tabii."


translate turkish event_m_katya_devend_a2f7d389:



    voice "voice/kate/5day/88 Ma.ogg"
    Kate "Byaşa'nın annesi pek dedikoducuydu... Hatta dedikodu bile değil, olmayan şeyleri yayıyordu."


translate turkish event_m_katya_devend_84b6253b:



    voice "voice/kate/5day/89 G.ogg"
    Kat "Köylülerin cinli olduğunu, ihtiyar Hariton'un da şeytan olduğunu söylüyordu."


translate turkish event_m_katya_devend_9809f959:



    voice "voice/kate/5day/90 Na.ogg"
    Kate "Sabah gözünü açtığı gibi içip sarhoş olurdu. Cin, şeytan görmesine şaşırmamalı."


translate turkish event_m_katya_devend_b1036640:


    "Tekerlekli sandalyedeki ihtiyar ve anlattığı basiretli hikâyeleri hatırladım."


translate turkish event_m_katya_devend_d0db524c:



    voice "voice/kate/5day/91 Ko.ogg"
    Kate "Byaşa'nın annesi yastıklı odaya girdiğinde Byaşa'ya Hariton göz kulak olmuştu."


translate turkish event_m_katya_devend_246bd159:



    voice "voice/kate/5day/92 E.ogg"
    Kate "Romka'nın ihmalkâr babasını da babamdan öğrenmiştim."


translate turkish event_m_katya_devend_70c9a703:



    voice "voice/kate/5day/93 Z.ogg"
    Kate "Uyuşturucu bağımlısı olduğu için tedavi gördüğünü biliyor muydun?"


translate turkish event_m_katya_devend_8a039476:



    voice "voice/kate/5day/94 da.ogg"
    Kate "Tabii, tabii!"


translate turkish event_m_katya_devend_cebc3120:



    voice "voice/kate/5day/95  Ez.ogg"
    Kate "O yüzden oğlunu dövüp duruyor."


translate turkish event_m_katya_devend_8d284522:



    voice "voice/kate/5day/96 N.ogg"
    Kate "Romka'da babasına çekerse şaşırmam."


translate turkish event_m_katya_devend_2b8751e8:



    voice "voice/kate/5day/97 S.ogg"
    Kate "Bu gidişle öyle de olacak gibi görünüyor."


translate turkish event_m_katya_devend_66e2d353:


    "Başkalarının karanlık sırlarını dinlemekten hiç hazzetmemiştim."


translate turkish event_m_katya_devend_24507e87:


    "Uyuşturucu bağımlıları, akıl hastası kadınlar... "


translate turkish event_m_katya_devend_ecf834b9:


    "Tüm bunlar, karanlığın yalnızca ormanı değil, eski püskü evlerin tozlu köşelerini de işgal ettiğini hatırlatmıştı..."


translate turkish event_m_katya_devend_8186442f:


    "... Pek tabii insanların zihinlerini de."


translate turkish event_m_katya_devend_a043b7c5:


    "İçlerindeki şeytanlıkları, gaddarlıkları uyandırıyordu."


translate turkish event_m_katya_devend_f5231065:



    voice "voice/Anton/5day/202 Chto.ogg"
    Ant "Çok bahsettik insanlardan. Biraz da kendinden bahset."


translate turkish event_m_katya_devend_36ed3a5a:



    voice "voice/kate/5day/98a.ogg"
    Kate "Neyimden bahsedeyim ki? Her şeyimi biliyorsun."


translate turkish event_m_katya_devend_b7da548f:



    voice "voice/Anton/5day/203 Ne.ogg"
    Ant "Hiçbir şey bilmiyorum bence."


translate turkish event_m_katya_devend_a605cbc8:



    voice "voice/Anton/5day/204 T.ogg"
    Ant "Babanın bir zamanlar çalıştığından bahsetmiştin."


translate turkish event_m_katya_devend_468652cf:



    voice "voice/Anton/5day/205 On.ogg"
    Ant "İstifa mı etti?"


translate turkish event_m_katya_devend_8c204392:



    voice "voice/kate/5day/99t.ogg"
    Kate "Oldu işte bir şeyler..."


translate turkish event_m_katya_devend_9cb28513:


    "Katya'nın bakışları karşımızdaki sis perdesine yöneldi."


translate turkish event_m_katya_devend_e70c74df:



    voice "voice/kate/5day/100e.ogg"
    "İnsan, delilerle uğraşa uğraşa deliriyormuş demek ki."


translate turkish event_m_katya_devend_975e6023:



    voice "voice/kate/5day/101p.ogg"
    Kat "Uçkur düşkünü babam genç bir hemşireyle tanıştıktan sonra bizi terk etti."


translate turkish event_m_katya_devend_f1c0bbc4:



    voice "voice/kate/5day/102ma.ogg"
    Kat "Çocuğu iyi yaşasın diye annem canını dişine takıp çalıştı. Hem öğretmen hem ebeveyn olarak."


translate turkish event_m_katya_devend_cc76e077:



    voice "voice/kate/5day/103z.ogg"
    Kate "Beni ne kadar seviyor, biliyor musun?"


translate turkish event_m_katya_devend_f48ed394:



    voice "voice/kate/5day/104e.ogg"
    Kate "Beni kaybetse kendi canına kıyar."


translate turkish event_m_katya_devend_25e10570:



    voice "voice/kate/5day/105t.ogg"
    Kate "Yani aslında bir değil, iki canı kurtardın."


translate turkish event_m_katya_devend_46ced24c:


    "Aklımda bir sahne canlandı."


translate turkish event_m_katya_devend_71219415:


    "Öğrenciler sınıfta dersi bekliyordu ancak sınıfa öğretmenleri yerine müdür giriyordu."


translate turkish event_m_katya_devend_160664ba:


    "Edebiyat dersinin iptal edildiğini söylüyordu."


translate turkish event_m_katya_devend_540576c0:


    "Liliya Pavlovna'nın öldüğünü, kendini asarak canına kıydığını paylaşıyordu."


translate turkish event_m_katya_devend_e1ac50ef:


    "Bu manzara yüreğimi dağlayıp beni o acıklı güne döndürmüştü."


translate turkish event_m_katya_devend_953e3684:


    "Katya, kopuk ayak parmaklarıyla o kıyma makinesinin haznesindeydi..."


translate turkish event_m_katya_devend_cdb45ff6:


    "Daldığım bu düşüncelerden kurtulmak için gözlerimi kırptım. Katya'ya sakınarak bir soru yönelttim."


translate turkish event_m_katya_devend_6411ec2d:



    voice "voice/Anton/5day/206 Ti.ogg"
    Ant "Nasıl kaçırıldığını hatırlıyor musun?"


translate turkish event_m_katya_devend_908568cd:



    voice "voice/kate/5day/106 gl.ogg"
    "Katya yutkundu."


translate turkish event_m_katya_devend_82d23636:


    "Gevezelik ettiğim için kendime çok kızmıştım. Böyle soru mu olurdu?"


translate turkish event_m_katya_devend_c1e02ba9:



    voice "voice/kate/5day/107 V.ogg"
    Kate "Az buçuk."


translate turkish event_m_katya_devend_74200eb0:



    voice "voice/kate/5day/108on.ogg"
    Kate "Katil... a-arkamdan gelip beni yakaladı ve... bilincimi kaybettim... sanırım."


translate turkish event_m_katya_devend_09fb756f:


    "Anlattıkları hiç yabancı gelmemişti..."


translate turkish event_m_katya_devend_f845bc7f:



    voice "voice/kate/5day/01 p.ogg"
    Kate "Başka nasıl bir açıklaması olabilirdi ki?"


translate turkish event_m_katya_devend_8b68d84b:



    voice "voice/kate/5day/02 u.ogg"
    Kate "Yüzü tıpkı senin gibiydi Anton! Sonra birden havaya fırlayıverdi. Tabii, tabii."


translate turkish event_m_katya_devend_9ec37373:



    voice "voice/kate/5day/03 e.ogg"
    Kate "Sonra daha da tuhaf şeyler oldu ki neler neler!"


translate turkish event_m_katya_devend_da2167d0:



    voice "voice/kate/5day/04 y.ogg"
    Kate "O vakit kabus gördüğümü fark edip u-uyanıverdim ki..."


translate turkish event_m_katya_devend_40080c9a:



    voice "voice/kate/5day/05 s.ogg"
    Kate "Karlarda sürüklendiğimi gördüm."


translate turkish event_m_katya_devend_6f04faa8:



    voice "voice/kate/5day/110 Ya.ogg"
    Kate "Cüzdanımı alıp... yola fırlattım. Belki birileri bulur, dedim de..."


translate turkish event_m_katya_devend_87f86ddd:


    "Köydeki iki apartmanın yakınlarında Katya durakladı ve sırtını bana döndü."


translate turkish event_m_katya_devend_b1e515ba:



    voice "voice/Anton/5day/207 K.ogg"
    Ant "Katya?"


translate turkish event_m_katya_devend_af10dc2b:



    voice "voice/kate/5day/111 hn.ogg"
    "Ağlıyordu."


translate turkish event_m_katya_devend_c0e94151:



    voice "voice/kate/5day/112 ch.ogg"
    Kate "Ne var?"


translate turkish event_m_katya_devend_df8db7f7:



    voice "voice/kate/5day/113 Ya.ogg"
    Kate "Bir bitmedi Katya'nız!"


translate turkish event_m_katya_devend_6b69349d:



    voice "voice/Anton/5day/208 Nu.ogg"
    Ant "Lütfen. Unutalım gitsin."


translate turkish event_m_katya_devend_bf334cda:



    voice "voice/kate/5day/114 At.ogg"
    Kate "Kıyma makinesinin en korkunç yanı neydi biliyor musun?"


translate turkish event_m_katya_devend_bddbd490:



    voice "voice/kate/5day/115ch.ogg"
    Kate "Sana açılamadan ölüp gidecek olmamdı."


translate turkish event_m_katya_devend_81cfdf00:



    voice "voice/Anton/5day/209 V.ogg"
    Ant "Ne konuda açılacaktın ki?"


translate turkish event_m_katya_devend_7180703a:


    "Katya birden bana döndü. Yüzü kıpkırmızı olmuştu."


translate turkish event_m_katya_devend_6568b2ca:



    voice "voice/kate/5day/116 k.ogg"
    Kate "Sende hiç akıl yok, Anton Petrov!"


translate turkish event_m_katya_devend_a47ce4f2:



    voice "voice/kate/5day/117v.ogg"
    Kate "Senden hoşlandığım için açılacaktım!"


translate turkish event_m_katya_devend_8f0584ec:


    "Şaşırıp kalmıştım."


translate turkish event_m_katya_devend_92fe9c12:


    "Ancak kendime gelemeden ağzımdan şu sözcükler döküldü."


translate turkish event_m_katya_devend_3e66440d:



    voice "voice/Anton/5day/210 T.ogg"
    Ant "Ben de senden hoşlanıyorum."


translate turkish event_m_katya_devend_0bb3fc39:



    voice "voice/kate/5day/118 Ch.ogg"
    Kate "Ciddi misin?"


translate turkish event_m_katya_devend_14b7ed21:



    voice "voice/Anton/5day/211 Ch.ogg"
    Ant "Ciddiyim."


translate turkish event_m_katya_devend_3c4b67d0:


    "Nur topu gibi yüzündeki yaşları sildim."


translate turkish event_m_katya_devend_dabc5dab:



    voice "voice/Anton/5day/212 K.ogg"
    Ant "Elbette hoşlanıyorum. Belli olduğunu sanıyordum."


translate turkish event_m_katya_devend_29f555ce:



    voice "voice/kate/5day/119 V.ogg"
    Kate "Siz oğlanlar hep sanırsınız zaten."


translate turkish event_m_katya_devend_82482566:



    voice "voice/kate/5day/120 a.ogg"
    Kate "Ancak biz kızlar bu tarz şeyleri duymak isteriz. Kalbimiz kulaklarımızda atar, bilmez misiniz?"


translate turkish event_m_katya_devend_13168ae4:


    "Aşk meşk işlerinden pek anlamazdım."


translate turkish event_m_katya_devend_c39d3b68:


    "Katya'nın gözyaşları parıldıyordu. Farklı hayatlara kapı aralayacak seçimler sunan yol ayrımına lapa lapa kar yağıyordu."


translate turkish event_m_katya_devend_7e203eac:


    "O anın önemli olduğunu, hafızalarımıza kazınması gerektiğini kanıksamıştım."


translate turkish event_m_katya_devend_098c264f:



    voice "voice/Anton/5day/213 r.ogg"
    Ant "Resmini çizebilir miyim?"


translate turkish event_m_katya_devend_a26beed4:


    "Katya gülümseyip gözyaşlarını sildi."


translate turkish event_m_katya_devend_40ba10ac:



    voice "voice/kate/5day/121 t.ogg"
    Kate "Böyle perişan haldeyken çizme ama."


translate turkish event_m_katya_devend_907de230:



    voice "voice/Anton/5day/214 po.ogg"
    Ant "Anlaştık!"


translate turkish event_m_katya_devend_a9072e72:


    "Karşımızdaki beton yığınına baktı."


translate turkish event_m_katya_devend_bc4a9a7d:



    voice "voice/kate/5day/122 z.ogg"
    Kate "İşte burada yaşıyorum."


translate turkish event_m_katya_devend_687e5aa4:



    voice "voice/Anton/5day/215 Kr.ogg"
    Ant "Ne güzel. Yaşadığın yer bile bir özel, bir farklı."


translate turkish event_m_katya_devend_7d8f4033:



    voice "voice/kate/5day/123 r.ogg"
    Kate "Ailemi apartmana yerleştirmişler. Annemle babam, öğretmen ve doktor olduğu için köyün önde gelen insanlarındanmış."


translate turkish event_m_katya_devend_7875aa0e:



    voice "voice/kate/5day/124 k.ogg"
    Kate "Çöplük manzaralı olsa da rahat bir yer."


translate turkish event_m_katya_devend_d757fab0:


    "Evimizi çevreleyen ormanı her gün görmektense çöplük manzarasını yeğlerdim."


translate turkish event_m_katya_devend_a83a3d9d:



    voice "voice/kate/5day/125 za.ogg"
    Kate "Maalesef asansörümüz yok. Değnekle inip çıkmak çok yoruyor."


translate turkish event_m_katya_devend_8b2b9213:



    voice "voice/kate/5day/126ne.ogg"
    Kate "Üçüncü kata çıkana kadar canım çıkıyor."


translate turkish event_m_katya_devend_92e1171c:



    voice "voice/Anton/5day/216 T.ogg"
    Ant "Yardımcı olayım mı?"


translate turkish event_m_katya_devend_50053941:


    "Annem müstakbel eşiyle, yani babamla, randevusunda bileğini burktuğundan bahsetmişti."


translate turkish event_m_katya_devend_03e3e7e7:


    "Babam da onu iki sokak boyu kollarında taşımış."


translate turkish event_m_katya_devend_e314e09f:


    "Annem o vakit babamla birlikte olmak istediğine karar vermiş."


translate turkish event_m_katya_devend_782d61f0:


    voice "voice/kate/5day/127ah.ogg"


translate turkish event_m_katya_devend_9a1d3dd5:



    voice "voice/kate/5day/128 ok.ogg"
    Kate "Kafayı mı yedin? Hafif değilim oğlum."


translate turkish event_m_katya_devend_c9b3523c:



    voice "voice/Anton/5day/218 K.ogg"
    Ant "Tüy gibi hafifsin işte."


translate turkish event_m_katya_devend_b3aa199e:



    voice "voice/kate/5day/129 oi.ogg"
    Kate "Ay! Eline hâkim ol."


translate turkish event_m_katya_devend_d6487ce5:



    voice "voice/kate/5day/130 at.ogg"
    Kate "Yoksa seni anneme söylerim."


translate turkish event_m_katya_devend_ac5f4ec9:


    "Onu kollarıma alıp apartmana taşıdım."


translate turkish event_m_katya_devend_336acf64:


    "{u}Kozanak{/u} yiyen kadın bir hademe bize yaklaştı. Un kaplı ağzı kulaklarına varmıştı."


translate turkish event_m_katya_devend_e68d48ac:



    voice "voice/episod/06 Vot.ogg"
    Janitor "Bak sen! Hah! Gözlerime inanamıyorum. Pembe dizi gibi!"


translate turkish event_m_katya_devend_5b57f254:



    voice "voice/episod/07 N.ogg" 
    Janitor "Aferin oğluma! Ne iyi taşıyorsun kızçeyi."


translate turkish event_m_katya_devend_6da57047:



    voice "voice/episod/08 L.ogg" 
    Janitor "Bak hele..."


translate turkish event_m_katya_devend_9e56044f:



    voice "voice/episod/09 A.ogg" 
    Janitor "Hollywood filmleri gençlerimizi zehirliyor, diyenler utansın! Memlekette hâlâ nasıl delikanlılar var."


translate turkish event_m_katya_devend_45985722:


    "Mal gibi mırıldandım. Katya utancından kıpkırmızı olmuştu."


translate turkish event_m_katya_devend_61dbd069:


    "Hafif olmasına hafifti ancak merdivenleri çıkarken sendelemeye başlamıştım."


translate turkish event_m_katya_devend_6f720360:


    "Değnekleri ara ara korkuluklara çarpıp takır tukur ediyordu."


translate turkish event_m_katya_devend_48c1b9bd:



    voice "voice/kate/5day/131 hi.ogg"
    "Katya da kikirdiyordu."


translate turkish event_m_katya_devend_49ab9134:



    voice "voice/kate/5day/131 hihi.ogg"
    "Evine çıkarkenki her anı hafızasına kazımaya çalışırcasına davranıyordu."


translate turkish event_m_katya_devend_0fdb4d27:


    "Ben de kayış atmamak için elimden geleni yapıp postürümü koruyordum."


translate turkish event_m_katya_devend_bfad3207:


    "Arkamdan yükselen sesler bana gaz veriyordu."


translate turkish event_m_katya_devend_9e1844b9:



    voice "voice/episod/10 Na.ogg" 
    Janitor "Yürü be delikanlı! Katya, ellere kaptırma bak bu çocuğu!"


translate turkish event_m_katya_devend_85e77347:


    "Katya haykırarak güldü."


translate turkish event_m_katya_devend_99c6a83a:



    voice "voice/kate/5day/132 ob.ogg"
    Kate "Tabii!"


translate turkish event_m_katya_devend_94ac0a7f:


    "Katya'yı daire kapısının önüne, beton zemine nazikçe bıraktım."


translate turkish event_m_katya_devend_7c20d642:



    voice "voice/kate/5day/131 hihihi.ogg"
    "Göz ucuyla bana bakıp alt dudağını ısırarak kapıyı açtı."


translate turkish event_m_katya_devend_8dd138e6:



    voice "voice/kate/5day/133 s.ogg"
    Kate "Sağ ol Herkül!"


translate turkish event_m_katya_devend_a9fc7484:



    voice "voice/kate/5day/134 pr.ogg"
    Kate "İçeri buyur da o sırada ayağımı sarayım. Kendi başımın çaresine bakmayı öğrendim."


translate turkish event_m_katya_devend_14544133:


    "Banyo kapısını üstüne kapattı. Ben de Katya'nın kibrit kutusu kadar odasına girdim."


translate turkish event_m_katya_devend_cf193516:


    "Dışarıda ıslık çalan kar fırtınası odayı daha da huzurlu kılmıştı."


translate turkish event_m_katya_devend_ada0e2d1:


    "O sırada şehirdeki apartman dairemiz aklıma geldi. Hamur işi kokusu eksik olmaz, annemle babamın gülüşleri kulağa ninni gibi gelirdi."


translate turkish event_m_katya_devend_1a4e38af:


    "Katya'nın evi de öyle huzurlu hissettirmişti işte."


translate turkish event_m_katya_lookaround_aqua_1c2eb46a:


    "Büyük bir akvaryum."


translate turkish event_m_katya_lookaround_draw_aqua_8cbe77ec:


    "Balıklar pek ilgi istemeyen canlılar. Evde pek vakit geçiremeyen insanlar için uygun bir evcil hayvan."


translate turkish event_m_katya_lookaround_draw_aqua_b5bed4cd:


    "Katya da bazı derslere gelmemiş, kaç gün ortalıkta görünmemişti."


translate turkish event_m_katya_lookaround_draw_aqua_5cb1a491:



    voice "voice/Anton/5day/220 M.ogg"
    Ant "Balıklarını besleyebilir miyim?"


translate turkish event_m_katya_lookaround_draw_aqua_30584a6b:



    voice "voice/kate/5day/135 T.ogg"
    Kate "Çok besleme."


translate turkish event_m_katya_lookaround_draw_aqua_239c9ea7:



    voice "voice/kate/5day/136 E.ogg"
    Kate "Yemleri bozulursa ölebilirler bile."


translate turkish event_m_katya_lookaround_certif_a85e78f2:


    "Ödül dolu bir raf."


translate turkish event_m_katya_lookaround_certif_6e531818:


    "Çocuklar ve gençler için ritmik jimnastik yarışmalarından türlü türlü madalya."


translate turkish event_m_katya_lookaround_certif_ac7e81a6:


    "Spora bu kadar düşkün olduğunu bilmiyordum."


translate turkish event_m_katya_lookaround_certif_844b831b:


    "Katya kendini Kara Garaj'da bulmadan önce nice başarıya imza atmış demek ki."


translate turkish event_m_katya_lookaround_dollh_1887a83a:


    "Barbie bebek evi."


translate turkish event_m_katya_lookaround_dollh_30de6a4e:


    "Oyuncak bebeklerden pek anlamam ama bu şey epey pahalı olmalı. Liliya Pavlovna kızını şımartmış."


translate turkish event_m_katya_lookaround_dollh_3830cf03:


    "İyi de kız bebekler çay içiyorken erkek olanın niye kafası kopuk?"


translate turkish event_m_katya_lookaround_mirror_3d8c065a:


    "Makyaj masası."


translate turkish event_m_katya_lookaround_mirror_2a5fd420:


    "Katya makyajını ve bakımını burada yapıyor olmalı. Annemden bile daha fazla makyaj eşyası var."


translate turkish event_m_katya_lookaround_musicb_754856f5:


    "Kasetçalar."


translate turkish event_m_katya_lookaround_musicb_43265b63:


    "Japonya menşeli, orijinal bir kasetçalar."


translate turkish event_m_katya_lookaround_musicb_ce125c3b:


    "Yanında da spor ekipmanları var. Burada müzik eşliğinde antrenman yapıyor olmalı."


translate turkish event_m_katya_followup_cc0ce762:


    "Üzerindeki dalgalanan şeritlerle Katya elini geri savurmuş, parmak ucunda duruyor."


translate turkish event_m_katya_followup_9091769b:


    "Kuğu gibi zarif!"


translate turkish event_m_katya_followup_99c021f3:


    "Bu resme bakarken niye hüzünlendim?"


translate turkish event_m_katya_followup_d98f11da:


    "Öyle düşüncelere daldım ki değneklerinin kauçuk uçlarından gelen sesleri duymamıştım bile."


translate turkish event_m_katya_followup_f6973a12:


    "Çerçevede Katya'nın yansımasını fark edip döndüm."


translate turkish event_m_katya_followup_e3e9e2c1:



    voice "voice/kate/5day/137 vz.ogg"
    "Odaya göz gezdirip iç çekti."


translate turkish event_m_katya_followup_c119a55c:



    voice "voice/kate/5day/138 do.ogg"
    Kate "Tüm bunların geçmişte kaldığına hâlâ inanamıyorum."


translate turkish event_m_katya_followup_5ff89c68:



    voice "voice/kate/5day/139 mam.ogg"
    Kate "Annem hep sporcu olmamı istemiştir. Bu isteğini gerçekleştirmem konusunda pek kararlı."


translate turkish event_m_katya_followup_0592d942:



    voice "voice/Anton/5day/221 M.ogg"
    Ant "Çok üzüldüm."


translate turkish event_m_katya_followup_a6669f6f:



    voice "voice/Anton/5day/222 V.ogg"
    Ant "Bunca madalya, fotoğraf... Jimnastik yapamadan hayatına nasıl devam edeceksin?"


translate turkish event_m_katya_followup_78230607:



    voice "voice/kate/5day/140 Us.ogg"
    Kate "Paralimpik sporcu olmaya da hiç niyetim yok."


translate turkish event_m_katya_followup_b75313c5:


    "Katya gülümseyiverdi."


translate turkish event_m_katya_followup_cca7cbb2:



    voice "voice/kate/5day/141 A.ogg"
    Kate "Jimnastikten de gına gelmişti zaten."


translate turkish event_m_katya_followup_532cd4cb:



    voice "voice/kate/5day/142 Vs.ogg"
    Kate "Yok 'şöyle dur', 'böyle dur'... Nasıl istersem dururum!"


translate turkish event_m_katya_followup_ff93fb38:



    voice "voice/kate/5day/143 ed.ogg"
    Kate "Yani yaşanan son olayların tek faydası bu oldu..."


translate turkish event_m_katya_followup_2cd64dd8:



    voice "voice/kate/5day/144 Ya.ogg"
    Kate "Artık yarışma yarışma gezmeme gerek yok."


translate turkish event_m_katya_followup_91e8ca92:



    voice "voice/kate/5day/145 Da.ogg"
    Kate "Tabii, tabii!"


translate turkish event_m_katya_followup_9a6d10c9:



    voice "voice/kate/5day/146 te.ogg"
    Kate "Artık kafama göre takılıyorum!"


translate turkish event_m_katya_followup_1f4ee2ae:



    voice "voice/kate/5day/147 kto.ogg"
    Kate "Katya'nın canı ne isterse o!"


translate turkish event_m_katya_followup_35c8631b:



    voice "voice/kate/5day/148 ha.ogg"
    "Şaka yaptığını vurgularcasına kahkahayı bastı ancak her şakanın altında az da olsa gerçek yatar..."


translate turkish event_m_katya_followup_680e36b9:



    voice "voice/Anton/5day/223 Ch.ogg"
    Ant "Seni dışarıdan görsem hiç kısıtlandığını düşünmezdim."


translate turkish event_m_katya_followup_ca6b4de2:



    voice "voice/kate/5day/149 et.ogg"
    Kate "Bu bir kusur mu sence? Şımarık biri olduğumu mu düşünüyorsun?"


translate turkish event_m_katya_followup_7b4bb55b:


    voice "voice/kate/5day/150 h.ogg"


translate turkish event_m_katya_followup_6eae585f:


    "Katya şakacıktan değneğini kaldırdı."


translate turkish event_m_katya_followup_a96c4ac5:



    voice "voice/kate/5day/151p.ogg"
    Kate "Haddini bil Petrov!"


translate turkish event_m_katya_followup_c7036bc6:



    voice "voice/kate/5day/152 e.ogg"
    Kate "Uyuşuklanmayı da bırak. Yemek hazırlamama yardım etmeyecek misin?"


translate turkish event_m_katya_followup_bc7d947c:



    voice "voice/Anton/5day/224 P.ogg"
    Ant "Etmem mi?"


translate turkish event_m_katya_followup_eb84bdb7:



    voice "voice/kate/5day/153 oh.ogg"
    "Katya beni mutfağa götürdü. Çekmeceyi açtığımda dikkatli bakışlarla donakaldım."


translate turkish event_m_katya_followup_deec41a6:



    voice "voice/Anton/5day/225 Ch.ogg"
    Ant "Burada fare ne arıyor ya?"


translate turkish event_m_katya_followup_198d95c9:


    "Telaşla kafasını salladı."


translate turkish event_m_katya_followup_2f26b7de:



    voice "voice/kate/5day/154 d.ogg"
    Kate "At gitsin ya!"


translate turkish event_m_katya_followup_c33f1a32:


    "Katya'ya yaklaşıp çekmeceye baktım... "


translate turkish event_m_katya_followup_c9dfa9d8:


    "Çatal kaşığın arasına karışmış bir kıyma makinesiyle bakışıyordum."


translate turkish event_m_katya_followup_c7d6b439:



    voice "voice/Anton/5day/226 K.ogg"
    Ant "Tabii..."


translate turkish event_m_katya_followup_aab01929:


    "Kalbim buz tutmuşçasına fareyi aldım."


translate turkish event_m_katya_followup_c2934919:


    "Haznedeki bıçakların gövdeye saplandığını görünce irkildim."


translate turkish event_m_katya_followup_30bf7df7:


    "O dökme demir mutfak eşyasının, garajdaki sanayi tipi makineyle bir alakasının olmadığını kendime hatırlatmam gerekmişti."


translate turkish event_m_katya_followup_354ef7a9:


    "Katya'nın beti benzi atmış, çıt çıkarmadan beni izliyordu."


translate turkish event_m_katya_followup_06cdbdc1:



    voice "voice/kate/5day/155 ne.ogg"
    Kate "Kıyma falan çekemem ben."


translate turkish event_m_katya_followup_41d262fd:



    voice "voice/kate/5day/156pl.ogg"
    Kate "Midem kalkıyor."


translate turkish event_m_katya_followup_970ec169:



    voice "voice/Anton/5day/227 P.ogg"        
    Ant "Bana bırak!"


translate turkish event_m_katya_followup_152b25df:


    "Kıyma makinesini tezgaha yerleştirirken Katya tabak çanağı şangırdatıyor, buzdolabının kapağını bir açıp bir kapatıyordu."


translate turkish event_m_katya_followup_1d025f3c:


    "Biraz et, soğan ve ekmek kırıntısı çıkardı. Salata için sebze doğrarken neşesi yerine gelmişti."


translate turkish event_m_katya_followup_8e8ea047:


    "Malzemeleri kıyma makinesine atıp ben de işe koyuldum."


translate turkish event_m_katya_followup_bca8271b:



    voice "voice/kate/5day/157b.ogg"
    Kate "Parmaklarına dikkat et."


translate turkish event_m_katya_followup_c3993aa9:


    "Kolu çevirmemle makinenin kıvrımlı çubuğu dönerek domuz etlerini çekmeye başladı."


translate turkish event_m_katya_followup_bd8174b3:


    "Makinenin kalburundan kıyma çıkıyordu."


translate turkish event_m_katya_followup_a2ceb183:



    voice "voice/kate/5day/158tc.ogg"
    Kate "Asıl, asıl!"


translate turkish event_m_katya_followup_0a9e457b:



    voice "voice/kate/5day/159 ne.ogg"
    Kate "Korkma, bozulmaz!"


translate turkish event_m_katya_followup_b22a0b41:


    "İnsan kanıyla kaplı bıçakları hatırlayıp ürperdim. Katya'nın ufacık deri parçasıyla bedenine tutunan ayak parmağı aklıma gelmişti."


translate turkish event_m_katya_followup_086d8d39:


    "Çaktırmadan ağzıma bir hap atıp çiğnedim."


translate turkish event_m_katya_followup_b72a52a3:


    "İlaç sayesinde sakinlemiştim. Korku, mağarasına geri çekilmişti."


translate turkish event_m_katya_followup_7c540197:



    voice "voice/kate/5day/160mi.ogg"
    Kate "Bizden amma da manyak bir aile olurmuş."


translate turkish event_m_katya_followup_0df4ac4b:



    voice "voice/kate/5day/161do.ogg"
    Kate "Hayatım, akşama yemekte ne var?"


translate turkish event_m_katya_followup_8ac8e261:


    "Bu oyuna ayak uydurdum."


translate turkish event_m_katya_followup_d2a9ff30:



    voice "voice/Anton/5day/228 K.ogg"
    Ant "Pirzola, bebeğim."


translate turkish event_m_katya_followup_f63048ac:



    voice "voice/kate/5day/162Ah.ogg"
    Kate "Her gün yesem sıkılmam hayatım."


translate turkish event_m_katya_followup_7751245b:



    voice "voice/Anton/5day/229 U.ogg"
    Ant "O zaman yaşadın! Çünkü bir dahaki kışa dek yetecek kadar pirzolamız var."


translate turkish event_m_katya_followup_c06ffd4d:


    voice "voice/kate/5day/163hah.ogg"


translate turkish event_m_katya_followup_99deeed4:


    "Böylelikle şakalaşırken tüm kaygılarımızı ve tiksinç sanrıları unutuvermiştik."


translate turkish event_m_katya_stove_lose1_22acb9c9:



    voice "voice/kate/5day/168 ne.ogg"
    Kate "Bu kadar kara olmamalıydı sanki."


translate turkish event_m_katya_stove_lose2_91837881:



    voice "voice/kate/5day/169ot.ogg"
    Kate "Pencereyi aç yoksa kokudan boğulacağız."


translate turkish event_m_katya_stove_lose3_9062e70e:



    voice "voice/kate/5day/170 m.ogg"
    Kate "Üf... Neyse ki kömür, hazımsızlığa iyi geliyormuş."


translate turkish event_m_katya_round1_win_08333f2a:



    voice "voice/Anton/5day/230 T.ogg"
    Ant "Baksana, çıtır çıtır olmuş!"


translate turkish event_m_katya_round2_win_d2d632fe:



    voice "voice/kate/5day/164 z.ogg"
    Kate "Nasıl güzel koktu... Komşuların da canı çekecek."


translate turkish event_m_katya_round3_win_81fbdcf8:



    voice "voice/Anton/5day/231 Pe.ogg"
    Ant "İlk kez böyle güzel piştiler."


translate turkish event_m_katya_round4_win_7df1ce54:



    voice "voice/kate/5day/165 p.ogg"
    Kate "Restoranlardakini aratmıyor değil mi?"


translate turkish event_m_katya_round5_win_44baa39a:



    voice "voice/kate/5day/166v.ogg"
    Kate "Anne eli değmiş gibi!"


