translate turkish d5_ending_past_8d3fbac3:



    voice "voice/Polina/5day/225 ar.ogg"
    Pol "Roma ne olacak?"


translate turkish d5_ending_past_60dd18a9:



    voice "voice/anton/5day/212.on.ogg"
    Ant "O da bize yetişir. Tut elimi."


translate turkish d5_ending_past_f8651883:


    "Polina'yla yola devam ettik."


translate turkish d5_ending_past_35d787ca:


    "Fırtınanın uğultusu dinmiyordu. Nefes nefese kalmış, koşuyorduk."


translate turkish d5_ending_past_2c1b8b5f:


    "Mezarlıkta bir tüfeğin ateş sesi yankılandı."


translate turkish d5_ending_past_9f5b6474:


    "Yere düşen Polina'yı kaldırdım."


translate turkish d5_ending_past_7ca76651:



    voice "voice/Polina/5day/226 g.ogg" 
    Pol "Roma nerede?"


translate turkish d5_ending_past_58ef80e5:



    voice "voice/anton/5day/213.On.ogg" 
    Ant "Nerede bilmem ama canımızı kurtarmamızı isterdi. En önemlisi o."


translate turkish d5_ending_past_53831a63:


    "Tüfek gecenin karanlığına kurşun saçıyordu."


translate turkish d5_ending_past_d67f7f45:


    "Birden sessizlik çöktü. Tipi de tüfekle birlikte sustu."


translate turkish d5_ending_past_90a9bb84:


    "Kar, mezarları yavaşça örtüyor; gri bulutlar yerini parlak aya bırakıyordu."


translate turkish d5_ending_past_3357e447:


    "Mehtap mezar taşlarını, rahmetlilerin oval fotoğraflarını ve hem Polina'nın hem de benim yüzümü aydınlatıyordu."


translate turkish d5_ending_past_397e0a8a:


    "Üsteğmen Tihonov'un mermisi mi bitmişti yoksa?"


translate turkish d5_ending_past_faf743ae:


    "Belki de fırtınanın ortasında paramparça olmuştu, hayatını kaybetmişti."


translate turkish d5_ending_past_c4f3ecdc:



    voice "voice/anton/5day/214.Scor.ogg"
