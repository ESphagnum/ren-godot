translate turkish event_m_polina_afterphone_b22299ea:


    "Tüm gücümü toplayıp ev telefonumuzu aradım."


translate turkish event_m_polina_afterphone_f3ff86f4:


    "Tek duyduğum bip sesleriydi."


translate turkish event_m_polina_afterphone_fac71b88:


    "Ardından bir hışırtı koptu ve telefon sessizliğe gömüldü."


translate turkish event_m_polina_afterphone_692d0a4f:


    "Babam olsa açıp \"Buyurun,\" derdi."


translate turkish event_m_polina_afterphone_f058719a:


    "Ancak annem ne zaman telefonu açsa sessizliğini korur, arayan kişinin konuşmasını bekler."


translate turkish event_m_polina_afterphone_bd5799f8:



    voice "voice/Anton/5day/150 M.ogg"
    Ant "Anne, benim."


translate turkish event_m_polina_afterphone_47b0f501:



    voice "voice/karina/5day/08 Vas.ogg"
    Mam "Hâlâ okulda mısın?"


translate turkish event_m_polina_afterphone_1f42348d:



    voice "voice/Anton/5day/151 Net.ogg"
    Ant "Hayır. Dinle anne... "


translate turkish event_m_polina_afterphone_70dedb53:



    voice "voice/Anton/5day/152 T.ogg"
    Ant "Endişelenme. Ahlaklı davranışlarım ve cesaretim için bana belge verdiler..."


translate turkish event_m_polina_afterphone_802b6ff8:


    "Kozumu kullanmaya karar vermiştim."


translate turkish event_m_polina_afterphone_5dc72b97:



    voice "voice/karina/5day/09 Me.ogg" 
    Mam "Notlarını iyi tutsan yeter. Belge getirmesen de olur."


translate turkish event_m_polina_afterphone_39fe5c24:


    "Yine Karlar Kraliçesi gibi davrandı."


translate turkish event_m_polina_afterphone_3c70cd9a:



    voice "voice/Anton/5day/153 Pr.ogg"
    Ant "Sınıftakiler adıma çok sevindi."


translate turkish event_m_polina_afterphone_2c1e5a87:



    voice "voice/Anton/5day/154  E.ogg"
    Ant "Pasta kesip gazoz içerek kutlamaya karar verdik..."


translate turkish event_m_polina_afterphone_6e36358e:


    "Yalanımdan çok pis utanmıştım ama başka ne diyebilirdim ki?"


translate turkish event_m_polina_afterphone_c94e5a90:


    "Garaja bile isteye düşmediğimi mi belirtseydim?"


translate turkish event_m_polina_afterphone_f6752b4a:


    "O gün evden çıkmamın tek sebebi Julka'dan kurtulmaktı mı deseydim?"


translate turkish event_m_polina_afterphone_500b0313:



    voice "voice/karina/5day/10 Ka.ogg" 
    Mam "Pasta mı? Anton, sofrayı kurdum artık!"


translate turkish event_m_polina_afterphone_9d1524ca:



    voice "voice/karina/5day/11 T.ogg" 
    Mam "Başına bela mı arıyorsun yine?"


translate turkish event_m_polina_afterphone_527fc259:



    voice "voice/Anton/5day/155 Ya.ogg"
    Ant "Ee... Köyden eve tek dönmektense insan içinde bulunmam daha iyi olur diye düşündüm."


translate turkish event_m_polina_afterphone_e106539e:



    voice "voice/Anton/5day/156 k.ogg"
    Ant "Hem dışarıda tipi var, giderek şiddetleniyor."


translate turkish event_m_polina_afterphone_5226ae3e:


    "Annem bir süre tereddütte kaldı."


translate turkish event_m_polina_afterphone_4f9493a3:



    voice "voice/karina/5day/12 U.ogg" 
    Mam "Babanın arabası yine çalışmıyor. Yoksa alırdı seni..."


translate turkish event_m_polina_afterphone_f7f69684:



    voice "voice/karina/5day/13 Ho.ogg"
    Mam "Pekâlâ, kal madem. Ancak yarın okuldan doğru eve döneceksin."


translate turkish event_m_polina_afterphone_47a417cb:


    "Budur be! İşe yaradı!"


translate turkish event_m_polina_afterphone_9b9e44c1:



    voice "voice/karina/5day/14 T.ogg"
    Mam "Kimde kalacaksın peki?"


translate turkish event_m_polina_afterphone_83533a65:



    voice "voice/karina/5day/15 Ch.ogg" 
    Mam "Bir şey olursa arayabileyim bari."


translate turkish event_m_polina_afterphone_8dfe377e:



    voice "voice/Anton/5day/U.ogg"
    Ant "Şey..."


translate turkish event_m_polina_afterphone_d7c60c86:


    "İlanları cebimden çıkarırken Byaşa'nın kumlu fotoğrafına gözüm ilişti."


translate turkish event_m_polina_afterphone_b9b82b63:



    voice "voice/Anton/5day/157 U.ogg"
    Ant "Bya... İgor Budaev'lerdeyim."


translate turkish event_m_polina_afterphone_41d7f9da:


    "Düşünmeden Polina'nın numarasını söylemiş oldum."


translate turkish event_m_polina_afterphone_020c0d95:



    voice "voice/Anton/5day/158 T.ogg"
    Ant "Numarası 3-24-92."


translate turkish event_m_polina_afterphone_225f3d34:



    voice "voice/karina/5day/16 Pe.ogg" 
    Mam "İgor'a selam söyle. İlaçlarını içmeyi de unutma."


translate turkish event_m_polina_afterphone_c887457f:



    voice "voice/Anton/5day/159 S.ogg"
    Ant "Sağ ol anne! Unutmam."


translate turkish event_m_polina_afterphone_bd6dd6be:



    voice "voice/Anton/5day/160 Ma.ogg"
    Ant "Anne ya, Olya nasıl?"


translate turkish event_m_polina_afterphone_253adcc6:


    "Annem telefonu kapatmıştı. Son sorumu muhtemelen duymamıştı."


translate turkish event_m_polina_afterphone_7e69ecd3:


    "Telefonu bırakıp, Polina'nın girdiği kapı eşiğinden içeriye baktım."


translate turkish event_m_polina_afterphone_13a56fd7:


    "Eşyalarını dolaplara yerleştiriyordu."


translate turkish event_m_polina_afterphone_b008ddab:



    voice "voice/Polina/5day/83 Mo.ogg"
    Pol "Gelebilirsin."


translate turkish event_m_polina_afterphone_b5dca808:



