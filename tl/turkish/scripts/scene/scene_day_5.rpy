translate turkish d5_ending_bloody_claw_c4db67ff:


    "Kurtuluş bahşedeceğine dair ümit kırıntıları taşıyan tılsımı uyuşuk ellerimle Olya'nın boynuna astım."


translate turkish d5_ending_bloody_claw_bc256d25:



    voice "voice/olya/5day/27 Ya.ogg"
    Oly "Annemi istiyorum!"


translate turkish d5_ending_bloody_claw_d44a40c5:


    "Doğru olanı yapıyordum. Abisi olarak Olya'yı korumalıydım."


translate turkish d5_ending_bloody_claw_cd9d70c2:


    "Olya, abisine kıyasla nurunu hiç yitirmemişti."


translate turkish d5_ending_bloody_claw_9674f759:



    voice "voice/Anton/5day/328 B.ogg"
    Ant "Koşalım Olya!"


translate turkish d5_ending_bloody_claw_20b84b4c:


    "Bizi hor gören orman boyunca koşuyorduk. Canlı ve sıcakkanlı olan her şey buna yabancıydı."


translate turkish d5_ending_bloody_claw_b844acf9:


    "Orman bizi biblolar gibi görüyor, buzlar altındaki koleksiyonuna katmak istiyordu."


translate turkish d5_ending_bloody_claw_2924a32d:


    "Sararmış solucan yumağı gibi görünen ay da yapraksız ağaç tepelerinden ara ara bize bakıyordu."


translate turkish d5_ending_bloody_claw_8184fbfe:


    "Ay da ben de biliyorduk. Bize kimsenin yardım edeceği yoktu."


translate turkish d5_ending_bloody_claw_1cb94f90:


    "Yetişkinler bize inanmamıştı. İddialarımı kanıtlayamadığım için Üsteğmen Tihonov da sözlerimi geçiştirmişti."


translate turkish d5_ending_bloody_claw_af33fe50:


    "Her şey bitmişti. Ağaçlık bize mezar olmuştu. Çocukları gömmekte pek iyiydi."


translate turkish d5_ending_bloody_claw_faecfeb5:


    "Peşimden birkaç uğultu geldi. Polina'nın kabanı önümde beliriverdi."


translate turkish d5_ending_bloody_claw_6bf3dc27:


    "O parlak nokta hemen yok oldu."


translate turkish d5_ending_bloody_claw_884749be:


    "Birden durdum. Olya üzerime atılıp bana sarıldı."


translate turkish d5_ending_bloody_claw_d47fe997:



    voice "voice/olya/5day/28 gde.ogg"
    Oly "Polina nerede?"


translate turkish d5_ending_bloody_claw_e36eeac8:


    "Önümüzde kapkara damarları andıran köklerin bulunduğu bir hendek vardı."


translate turkish d5_ending_bloody_claw_75614b4e:


    "Dibindeyse Polina kıvranıyordu. Hendeği fark etmeyip düşmüştü."


translate turkish d5_ending_bloody_claw_4187c7c4:



    voice "voice/Anton/5day/329 P.ogg"
    Ant "Polina!"


translate turkish d5_ending_bloody_claw_37a6fb2b:


    "Hendekten bir inilti yükseldi."


translate turkish d5_ending_bloody_claw_644eac24:



    voice "voice/Anton/5day/330 Y.ogg"
    Ant "Burada kal Olya. Hemen geliyorum."


translate turkish d5_ending_bloody_claw_8c40f37e:


    "Kardeşim tereddütle çekildi. Ağaçlığa bir süre bakıp kimselerin olmadığını doğruladıktan sonra aşağı inmeye koyuldum."


translate turkish d5_ending_bloody_claw_71d94003:


    "Her seferinde karanlıktan ansızın çıkagelirlerdi. Kabus gibi yaratıklara da bu yakışırdı."


translate turkish d5_ending_bloody_claw_613469f6:


    "Kanatlı bir gölgenin çırpıntısını fark ettim. Baykuşçuk'un silüeti ayın önünde belirdi."


translate turkish d5_ending_bloody_claw_a1675bbc:


    "Olya o korkunç kuşu görünce çığlığı basıp ormanın derinliklerine koşturdu."


translate turkish d5_ending_bloody_claw_074eab71:


    "Kanatlı yaratığın yaptığı dalışa rağmen o keskin pençelerden kurtulan kardeşim avlanmadan kaçabilmişti."


translate turkish d5_ending_bloody_claw_8737e674:


    "Yaratık hüsranla inildeyerek süzüldü."


translate turkish d5_ending_bloody_claw_c4121009:


    "Tılsım cidden işe yaramış mıydı?"


translate turkish d5_ending_bloody_claw_ea99e099:


    "Olya'nın peşinden gitmeliydim. Yetişip onu sakinleştirmeli, hepsinin kabus olduğunu söylemeliydim."


translate turkish d5_ending_bloody_claw_9eb2ff06:


    "Hendekten çıkmak istiyordum ancak yokuş aşağı kayıyordum."


translate turkish d5_ending_bloody_claw_e817c35a:


    "Buz gibi toprakta debelenip aşağı yuvarlandım. Düştüğüm yer ise bambaşka bir dehşetin pençesiydi."


translate turkish d5_ending_bloody_claw_ced9afb1:


    "Ayıcık hendeğin dibinden sürünerek çıkıp korkutucu elini salladı."


translate turkish d5_ending_bloody_claw_9ba055b7:



    voice "voice/Polina/5day/13 Vs_wood.ogg" 
    "Dizlerinin üstünde duran Polina, Ayıcık'ın parıldayan gözünü gördüğü gibi çığlığı bastı."


translate turkish d5_ending_bloody_claw_f9e78f4b:



    voice "voice/Polina/5day/232 Dih.ogg" 
    "Çürümeye yüz tutan ayı bozması, çirkin patilerine geçirdiği Polina'yı kendine çekti."


translate turkish d5_ending_bloody_claw_931eec69:



    voice "voice/Bear/5day/Se.ogg"
    Bear "Hainlerin başına ne geldiğini az sonra göreceksin."


translate turkish d5_ending_bloody_claw_0bdc98c7:


    "Polina da ben de korkudan kaskatı kesilmiştik."


translate turkish d5_ending_bloody_claw_ed692f22:


    "Elden ayaktan kesildiğim gibi görüşümü de kaybetmeyeyim diye dualar ediyordum. Ancak görüşüm daha da keskinleşmişti."


translate turkish d5_ending_bloody_claw_0747c0fa:


    "Kurtçuk da gölgelerin arasından bozuk bir oyuncak gibi iki büklüm çıkmıştı. Salyalar akan ağzından korkunç sözler çıkıyordu."


translate turkish d5_ending_bloody_claw_e7815ae6:



    voice "voice/Wolf/126 Z.ogg"
    Wolf "Yiyeliiim! Parrrçalayalım! Öldürrrelim!"


translate turkish d5_ending_bloody_claw_a42d66c9:


    "Ayıcık'ın patilerinde güçsüz düşen Polina bilincini yitirmek üzereydi."


translate turkish d5_ending_bloody_claw_dd5e9a8a:


    "Baykuşçuk da bir kar yığınına konmuş, gaga şaklatıyordu. Tüyleri kana bulanmıştı."


translate turkish d5_ending_bloody_claw_f890d14f:



    voice "voice/Owl/41 Dev.ogg"
    Owl "Kız benim olacaktı!"


translate turkish d5_ending_bloody_claw_83cc05fc:



    voice "voice/Owl/42 Ga.ogg" 
    Owl "Eşek sıpası yüzünden aç kaldım, u-uh!"


translate turkish d5_ending_bloody_claw_f4c4b5a4:


    "Hüsranla sarsılan Baykuşçuk parazit dolu dev kanatlarını açtı."


translate turkish d5_ending_bloody_claw_5a463a8e:


    "Ardından bana yaklaştı. Öfkesi her halinden belliydi."


translate turkish d5_ending_bloody_claw_20badb86:



    voice "voice/Anton/5day/279 N.ogg"
    Ant "Sakın!"


translate turkish d5_ending_bloody_claw_cf25022d:


    "Gölgeler giderek kararıyor, canımı korumak için yalvarışlarımı dinlemek istercesine dibime sokuluyordu."


translate turkish d5_ending_bloody_claw_747d3310:



    voice "voice/Anton/5day/335 N.ogg"
    Ant "Bizi öldürmeyin... Ben..."


translate turkish d5_ending_bloody_claw_e816d2ec:


    "Derken bir aydınlanma yaşadım."


translate turkish d5_ending_bloody_claw_bc51cfa4:



    voice "voice/Anton/5day/336 Ya.ogg"
    Ant "Ben Tavşancık'ım."


translate turkish d5_ending_bloody_claw_b979d4cb:



    voice "voice/Owl/43 Kto.ogg" 
    Owl "U-uh, kim?"


translate turkish d5_ending_bloody_claw_50a1f796:


    "Kurtçuk, dişlerinden damlayan tükürüğünde boğulacaktı az kalsın."


translate turkish d5_ending_bloody_claw_8ace7ae1:


    "Ayı kılıklı kukla, derin birkaç nefes alıp kahkahayı bastı."


translate turkish d5_ending_bloody_claw_dc1a9436:



    voice "voice/Bear/5day/09 ti.ogg"
    Bear "Sen mi? Hiç güleceğim yoktu!"


translate turkish d5_ending_bloody_claw_8b545128:



    voice "voice/Bear/5day/10 na.ogg"
    Bear "Esas Tavşancık çoktan bulundu. Yakında aramızda olacak."


translate turkish d5_ending_bloody_claw_dc89c1dc:



    voice "voice/Bear/5day/11 e.ogg"
    Bear "Öyle bir oyun oynayacağız ki..."


translate turkish d5_ending_bloody_claw_891a1c0b:


    "Kurtçuk bana doğru bir adım attı."


translate turkish d5_ending_bloody_claw_5f8be93f:


    "Ümidim, hatta hayatımın son saniyeleri tükeniyordu."


translate turkish d5_ending_bloody_claw_278182e6:


    "Bu anları iple çektiğim için kendimden utanmıştım."


translate turkish d5_ending_bloody_claw_920814f7:


    "Hatta tılsımı Olya'ya verdiğim için bir an pişmanlığa bile kapılmıştım."


translate turkish d5_ending_bloody_claw_7178ff6b:



    voice "voice/Anton/5day/337 H.ogg"
    Ant "Yeter! Bize niye ihtiyaç duyuyorsunuz?"


translate turkish d5_ending_bloody_claw_7fe02ec3:



    voice "voice/Anton/5day/338 T.ogg"
    Ant "Beni kurtarmıştınız, güvende olacağımı söylemiştiniz hani?.."


translate turkish d5_ending_bloody_claw_b2ba1fbd:


    "Kurtçuk kulaklarını dikmiş, bön bön bakıyordu."


translate turkish d5_ending_bloody_claw_9a343358:


    "Birkaç belirsiz söz mırıldandı."


translate turkish d5_ending_bloody_claw_8b47c6ec:



    voice "voice/Wolf/127 Da.ogg"
    Wolf "Evet... Evet... Gürrrvendesin..."


translate turkish d5_ending_bloody_claw_437e2475:



    voice "voice/Wolf/128 No.ogg"
    Wolf "Ancak şu eski arrrkadaşım..."


translate turkish d5_ending_bloody_claw_12d3c2f6:


    "Flütün gizemli ve büyüleyici sesi kulaklarıma ulaştı."


translate turkish d5_ending_bloody_claw_9a3b7dc5:


    "Çatık kaşlı Kurtçuk bana yaklaşırken duruverdi. Sanki biri fişini çekmişti."


translate turkish d5_ending_bloody_claw_246ca13d:


    "Rüzgar dinmiş, müzik ise şiddetlenmişti."


translate turkish d5_ending_bloody_claw_2969592d:


    "Yaratıklar, duraklatılan VHS kasetlerdeki görüntüler gibi titriyordu."


translate turkish d5_ending_bloody_claw_2b1e10d5:


    "Derken karşımdaki silüette parlak çatlaklar meydana geldi ve üzerindeki yaralardan dumanlar yükselmeye başladı."


translate turkish d5_ending_bloody_claw_bd75a927:


    "Şaşkınlıktan ağzım açık kalmıştı."


translate turkish d5_ending_bloody_claw_d4a842f4:


    "Kurt kostümü resmen buhar olmuş, ufalanarak dağılıyordu."


translate turkish d5_ending_bloody_claw_7fcc9109:


    "Parçalar kül olup hendeğe saçılmıştı."


translate turkish d5_ending_bloody_claw_165fbf92:


    "Kurt maskesi de iyileşen bir yaranın attığı kabuk gibi düşmüştü."


translate turkish d5_ending_bloody_claw_a4180300:



    voice "voice/Polina/5day/229 R.ogg"
    Pol "Roma!"


translate turkish d5_ending_bloody_claw_5558c3ac:


    "Romka'nın solgun yüzü öfkeden çok pis çatılmıştı. Alnındaki damarlar şişmiş, dudakları ise çatlamıştı."


translate turkish d5_ending_bloody_claw_11f19bd3:


    "Üst dudağını yırtıcı bir hayvan gibi kaldırıp bana dik dik baktı. Gözleri alev alev parlıyordu."


translate turkish d5_ending_bloody_claw_0e78f02f:



    voice "voice/romka/5day/52 T.ogg"
    Rom "Onlarda mıydın, he? Polina'cığımın evindeydin, değil mi?"


translate turkish d5_ending_bloody_claw_8f93ff96:



    voice "voice/romka/5day/53 Ri.ogg"
    Rom "Resmini çizdin mi? Elini sürdün mü ona?"


translate turkish d5_ending_bloody_claw_2d455681:



    voice "voice/Polina/5day/230 Ro.ogg"
    Pol "Romoçka..."


translate turkish d5_ending_bloody_claw_959f3f54:



    voice "voice/romka/5day/54 Za.ogg"
    Rom "Kes lan kahpe!"


translate turkish d5_ending_bloody_claw_f4dc25c6:


    "Elden ayaktan kesilen Polina, kendisine eziyet eden o biçimsizin kollarına feryat figan düşüverdi."


translate turkish d5_ending_bloody_claw_5acb042f:


    "Şaşkınlıktan hislerimi yitirmiştim. Romka, Polina'ların orada buluştuğumuzda söylediği sözleri tekrarladı."


translate turkish d5_ending_bloody_claw_560bfecb:


    "Demek öyle olmuş."


translate turkish d5_ending_bloody_claw_7d8f226b:


    "Bunca zamandır maske, Romka'nın aklını esir almıştı ancak zırdeli dostum artık özgürdü."


translate turkish d5_ending_bloody_claw_3bacf6f0:



    voice "voice/Anton/5day/339 R.ogg"
    Ant "Romka, etrafına bak."


translate turkish d5_ending_bloody_claw_8bc52291:


    "Tüyler ürperten hendeğe ve keskin dallara bir göz atması için yalvarmıştım."


translate turkish d5_ending_bloody_claw_6a753eff:


    "Ancak Romka elini uzatmış, gözünü kırpmadan bana bakıyordu... Avucunda ise sımsıkı tuttuğu kelebek çakısı vardı."


translate turkish d5_ending_bloody_claw_39f65137:



    voice "voice/romka/5day/55 Ra.ogg"
    Rom "Seni uyarmadım mı?"


translate turkish d5_ending_bloody_claw_160801d0:



    voice "voice/romka/5day/56 R.ogg"
    Rom "Öl-öl-öldürürüm demedim mi..."


translate turkish d5_ending_bloody_claw_d03f717d:


    "Kaçmam için fırsat doğmuştu. Romka hendeği aşıp beni ittirdi."


translate turkish d5_ending_bloody_claw_50587292:


    voice "voice/Anton/5day/280 v.ogg"


translate turkish d5_ending_bloody_claw_c993c1d4:


    "İki omuzumun arasına şimşek çakmıştı sanki. Düştüğüm gibi nefesim kesiliverdi. Var gücümü kullanarak arkama döndüm."


translate turkish d5_ending_bloody_claw_ec351ee1:


    "Romka'nın kelebeği kanıma bulanmıştı."


translate turkish d5_ending_bloody_claw_257340d6:


    "Ağzımı ne kadar açsam da ciğerime hava dolmuyordu. Ancak soğuk giderek içime işliyordu."


translate turkish d5_ending_bloody_claw_dc5f5212:



    voice "voice/romka/5day/57 Ti.ogg"
    Rom "Beni sırtımdan bıçaklarsın, he? Şimdi ödeştik."


translate turkish d5_ending_bloody_claw_d3d93107:


    "Polina hüngür hüngür ağlıyordu. Ancak bataklığa çöken sis gibi ormana musallat olan o ezgi, Polina'nın feryatlarını bastırıyordu."


translate turkish d5_ending_bloody_claw_8df4dab4:


    "Flütün sesi ne varsa sarıp sarmalamış, Romka da beş karış suratıyla donakalmıştı."


translate turkish d5_ending_bloody_claw_1f2247fb:


    "Sağ gözüm görmemeye başladı. Yine de sol gözümle dalların arasından o sinsi ayı görebiliyordum."


translate turkish d5_ending_bloody_claw_9650c83d:


    "O donuk delinin mehtabı gözümü alıyordu."


translate turkish d5_ending_bloody_claw_095c2769:


    "Ormanın Efendisi'nin devasa silüeti de Romka'nın ardında dikiliyordu."


translate turkish d5_ending_bloody_claw_cad48d54:


    "Keçi, Romka'nın omuzunu babacan bir tavırla okşadı."


translate turkish d5_ending_bloody_claw_324cbb32:


    "Alev alev gözleriyle bön bön bakan Romka'nın ağzından köpükler saçılmaya başladı. Çakısı, solgun parmaklarından kayıp düşüverdi."


translate turkish d5_ending_bloody_claw_96d3af17:



    voice "voice/kozel/5day/65 be.ogg" 
    Master "Zavallı me-evladım, bu ne hal!"


translate turkish d5_ending_bloody_claw_e2029afd:



    voice "voice/kozel/5day/66 ni.ogg" 
    Master "Geçti gitti. Diğer herkes gibi seni de iyileştireceğim."


translate turkish d5_ending_bloody_claw_ac8ec9ec:



    voice "voice/kozel/5day/67 ka.ogg" 
    Master "Her birinizi iyileştirdiğim gibi..."


translate turkish d5_ending_bloody_claw_cbcb12b0:


    "Karanlıktan kısa boylu iki silüet çıkageldi."


translate turkish d5_ending_bloody_claw_7d151ccf:


    "Çatık kaşlı Baykuşçuk sert dil darbeleriyle gagasını yalıyor, Ayıcık ise gözü yaşlı Polina'yı sürüklüyordu."


translate turkish d5_ending_bloody_claw_0b116849:


    "Keçi eğilip küllerin arasından aldığı kurt maskesini Romka'nın yüzüne kondurdu ve kolundan dev bir iğne çıkardı."


translate turkish d5_ending_bloody_claw_568e0f99:


    "Dikkatli bir biçimde maskeyi kurdun yüzüne dikti. İğneyi öyle derine sokmuştu ki Romka'nın kafatasının çizileceğini sanmıştım."


translate turkish d5_ending_bloody_claw_32cbf7cc:


    "Ormanın Efendisi son dikişini de attığında Kurtçuk'un gözleri açıldı."


translate turkish d5_ending_bloody_claw_0f29bbdb:



    voice "voice/Wolf/129 vs.ogg"
    Wolf "O sabah seni yakalayıverrrseydim bunca uğrrraşa gerrrek kalmazdı."


translate turkish d5_ending_bloody_claw_2226a280:



    voice "voice/Wolf/130 po.ogg"
    Wolf "Vova'nın eldivenini hatırlıyor musun?"


translate turkish d5_ending_bloody_claw_423ee718:



    voice "voice/Owl/44 Eto.ogg" 
    Owl "Onu evinin yakınındaki ağacın dalına biz yerleştirmiştik..."


translate turkish d5_ending_bloody_claw_99370b1b:



    voice "voice/Bear/5day/Ti.ogg"
    Bear "Daha o zaman son nefesini verecektin de..."


translate turkish d5_ending_bloody_claw_47c8008f:



    voice "voice/Bear/5day/Vs.ogg"
    Bear "O meymenetsiz tilki 'Tavşancığımız, Tavşancığımız' diye tutturdu... Iy!"


translate turkish d5_ending_bloody_claw_d788067f:


    "Ne hareket edebiliyor ne de duyduklarıma karşılık verebiliyordum. Polina iyice gözyaşlarına boğulmuştu."


translate turkish d5_ending_bloody_claw_14a83807:


    "Kurtçuk öne bir adım atıp keskin dişlerini gösterdi."


translate turkish d5_ending_bloody_claw_e5f3532e:


    "Pençelerini boynuma geçirip âdemelmamı kopardı ve kanım havaya saçıldı."


translate turkish d5_ending_bloody_claw_36cbf93b:


    "Aradan bir süre geçti ve kana bulanan kurt çocuğun korkunç bir tayga kurduna dönüştüğünü fark ettim."


translate turkish d5_ending_bloody_claw_27dc9f56:


    "Diğer canavarlar da hayvana dönüşmüştü."


translate turkish d5_ending_bloody_claw_fceec073:


    "Uzun mu uzun Ormanın Efendisi de elinde flütüyle gür sakallı bir ihtiyar kılığına bürünmüştü ki gerinmesiyle tekrar o orman devine döndü."


translate turkish d5_ending_bloody_claw_83993125:


    "Kaçırdığım aklım, dehşetin merceğinde gerçek ve sanrıların arasına düşen kırılmaların esiri olmuştu."


translate turkish d5_ending_bloody_claw_b972d724:


    "Son nefeslerimi verirken artık gördüklerimi tanıyamaz hale gelmiştim."


translate turkish d5_ending_bloody_claw_ae366bcc:


    "Hatırladığım son şey, kurdun vücudumu iyice deşmesiyle aya sıçrayan kanlar olmuştu."


translate turkish d5_ending_among_us_2cbc0157:


    "Tılsım hurafeden başka bir şey değildi."


translate turkish d5_ending_among_us_d465a386:


    "Kendi çocuklarını ayinlerde kurban eden gözü dönmüş ilkel kabilelerin palavrasıydı."


translate turkish d5_ending_among_us_75b0d22d:


    "Böyle bir tarihi eser beni veya Olya'yı nasıl koruyabilirdi ki?"


translate turkish d5_ending_among_us_753a430e:


    "Tılsımı çıkarıp karanlığın doyumsuz pençesine atmalıydım."


translate turkish d5_ending_among_us_8e7a7632:


    "Ancak nedense... onu saklamaya karar verdim."


translate turkish d5_ending_among_us_285ec359:



    voice "voice/Anton/5day/328 Be.ogg"
    Ant "Koşalım Olya!"


translate turkish d5_ending_among_us_20b84b4c:


    "Bizi hor gören orman boyunca koşuyorduk. Canlı ve sıcakkanlı olan her şey buna yabancıydı."


translate turkish d5_ending_among_us_4e8e1136:


    "Orman bizi biblolar gibi görüyor, buzlar altındaki koleksiyonuna katmak istiyordu."


translate turkish d5_ending_among_us_2924a32d:


    "Sararmış solucan yumağı gibi görünen ay da yapraksız ağaç tepelerinden ara ara bize bakıyordu."


translate turkish d5_ending_among_us_8184fbfe:


    "Ay da ben de biliyorduk. Bize kimsenin yardım edeceği yoktu."


translate turkish d5_ending_among_us_1cb94f90:


    "Yetişkinler bize inanmamıştı. İddialarımı kanıtlayamadığım için Üsteğmen Tihonov da sözlerimi geçiştirmişti."


translate turkish d5_ending_among_us_af33fe50:


    "Her şey bitmişti. Ağaçlık bize mezar olmuştu. Çocukları gömmekte pek iyiydi."


translate turkish d5_ending_among_us_faecfeb5:


    "Peşimden birkaç uğultu geldi. Polina'nın kabanı önümde beliriverdi."


translate turkish d5_ending_among_us_6bf3dc27:


    "O parlak nokta hemen yok oldu."


translate turkish d5_ending_among_us_884749be:


    "Birden durdum. Olya üzerime atılıp bana sarıldı."


translate turkish d5_ending_among_us_b7397738:


    Oly "Polina nereye kayboldu Toşa?"


translate turkish d5_ending_among_us_6c3b493a:


    "Önümüzde kapkara damarları andıran köklerin bulunduğu bir hendek vardı."


translate turkish d5_ending_among_us_9256a114:


    "Dibindeyse Polina kıvranıyordu. Hendeği fark etmeyip düşmüştü."


translate turkish d5_ending_among_us_68fdc5b9:



    voice "voice/Anton/5day/329 Po.ogg"
    Ant "Polina!"


translate turkish d5_ending_among_us_2ff37d6b:


    "Hendekten bir inilti yükseldi."


translate turkish d5_ending_among_us_e3b41659:



    voice "voice/Anton/5day/330 Ya.ogg"
    Ant "Burada kal Olya. Hemen geliyorum."


translate turkish d5_ending_among_us_8c40f37e:


    "Kardeşim tereddütle çekildi. Ağaçlığa bir süre bakıp kimselerin olmadığını doğruladıktan sonra aşağı inmeye koyuldum."


translate turkish d5_ending_among_us_dad57df9:


    "Her seferinde karanlıktan ansızın çıkagelirlerdi. Kabus gibi yaratıklara da bu yakışırdı."


translate turkish d5_ending_among_us_fcba71c4:


    "Kanatlı bir gölgenin çırpıntısını fark ettim. Baykuşçuk'un silüeti ayın önünde belirdi."


translate turkish d5_ending_among_us_7b6b2ed9:


    "Yaratık Olya'yı tutmuş, yıldızlarla bezeli göğe uçuruyordu."


translate turkish d5_ending_among_us_c7d0eccc:


    "Kısa bir çığlık koptuğu gibi ormanın hışırtılarına karıştı."


translate turkish d5_ending_among_us_8a97d17d:


    "Elimden gelen tek şey, kardeşimin az önce durduğu yere çaresizce uzanmaktı."


translate turkish d5_ending_among_us_29ad251f:



    voice "voice/Anton/5day/340 net.ogg"
    Ant "Hayır!"


translate turkish d5_ending_among_us_70cde57e:


    "Çaresizce çığlık atmıştım."


translate turkish d5_ending_among_us_9eb2ff06:


    "Hendekten çıkmak istiyordum ancak yokuş aşağı kayıyordum."


translate turkish d5_ending_among_us_20f1113c:


    "Parmaklarımı toprağa geçirsem de aşağı yuvarlandım. Düştüğüm yer ise bambaşka bir dehşetin pençesiydi."


translate turkish d5_ending_among_us_ced9afb1:


    "Ayıcık hendeğin dibinden sürünerek çıkıp korkutucu elini salladı."


translate turkish d5_ending_among_us_72bef96c:


    "Dizlerinin üstünde duran Polina, Ayıcık'ın parıldayan gözünü gördüğü gibi çığlığı bastı."


translate turkish d5_ending_among_us_f9e78f4b:



    voice "voice/Polina/5day/232 Dih.ogg" 
    "Çürümeye yüz tutan ayı bozması, çirkin patilerine geçirdiği Polina'yı kendine çekti."


translate turkish d5_ending_among_us_931eec69:



    voice "voice/Bear/5day/Se.ogg"
    Bear "Hainlerin başına ne geldiğini az sonra göreceksin."


translate turkish d5_ending_among_us_0bdc98c7:


    "Polina da ben de korkudan kaskatı kesilmiştik."


translate turkish d5_ending_among_us_ed692f22:


    "Elden ayaktan kesildiğim gibi görüşümü de kaybetmeyeyim diye dualar ediyordum. Ancak görüşüm daha da keskinleşmişti."


translate turkish d5_ending_among_us_0747c0fa:


    "Kurtçuk da gölgelerin arasından bozuk bir oyuncak gibi iki büklüm çıkmıştı. Salyalar akan ağzından korkunç sözler çıkıyordu."


translate turkish d5_ending_among_us_e7815ae6:



    voice "voice/Wolf/126 Z.ogg"
    Wolf "Yiyeliiim! Parrrçalayalım! Öldürrrelim!"


translate turkish d5_ending_among_us_a42d66c9:


    "Ayıcık'ın patilerinde güçsüz düşen Polina bilincini yitirmek üzereydi."


translate turkish d5_ending_among_us_37db0296:


    "Baykuşçuk da bir kar yığınına konmuş, gaga şaklatıyordu. Tüyleri kana bulanmıştı."


translate turkish d5_ending_among_us_3266f287:


    "Olya'nın öldüğü düşüncesiyle içim burkuldu. Göğsüme bir acı saplanmıştı ki bıçaktan daha keskindi."


translate turkish d5_ending_among_us_6410b84f:



    voice "voice/Anton/5day/332 Ne.ogg"
    Ant "Sakın!"


translate turkish d5_ending_among_us_cf25022d:


    "Gölgeler giderek kararıyor, canımı korumak için yalvarışlarımı dinlemek istercesine dibime sokuluyordu."


translate turkish d5_ending_among_us_6a4f892a:



    voice "voice/Anton/5day/335 Neu.ogg"
    Ant "Bizi öldürmeyin... Ben..."


translate turkish d5_ending_among_us_0ce9d256:


    "Kurtçuk bana yaklaşıyordu. Etrafta canavarları geciktirmek için kullanabileceğim bir şey arıyordum."


translate turkish d5_ending_among_us_e74a1f56:


    "Aklıma gelen fikirle çarpılmışa döndüm."


translate turkish d5_ending_among_us_33b4003d:


    "Yakamın altındaki kalın ipi yoklayıp çıkardım ve yaklaşan düşmanıma tuttum."


translate turkish d5_ending_among_us_6bd38930:


    "İpte pençeli bir tılsım sallanıyordu."


translate turkish d5_ending_among_us_edb78136:



    voice "voice/Wolf/132 a.ogg"
    Wolf "Ay, aman! Yandım!"


translate turkish d5_ending_among_us_98b644fe:


    "Kurtçuk göğsünü tutup geri sıçradı. Ardından uğultulu bir kahkaha patlattı."


translate turkish d5_ending_among_us_ce2aca0b:



    voice "voice/Wolf/133 t.ogg"
    Wolf "Süt dişin mi o? Diş perrrisi mi sandın beni?"


translate turkish d5_ending_among_us_b8f1e919:



    voice "voice/Wolf/134 oi.ogg"
    Wolf "Dangalak!"


translate turkish d5_ending_among_us_8c613d20:


    "İşe yaramaz tılsım sarkaç gibi sallanıyordu."


translate turkish d5_ending_among_us_fc78a8ef:


    "Polina'yı tutmaya devam eden Ayıcık, kurt maskeli kardeşine öfkeyle bakıyordu."


translate turkish d5_ending_among_us_76ba2a85:



    voice "voice/Bear/5day/Ne.ogg"
    Bear "Komik değil. Başkasının acısına gülmek de hoş değil ayrıca."


translate turkish d5_ending_among_us_26f04357:


    "Patisini gevşetip çirkin pençeli dört parmağını da çekti. Kesik yüzük parmağının olması gereken yerden ise irin akıyordu."


translate turkish d5_ending_among_us_87faf5d0:



    voice "voice/Wolf/136 A.ogg"
    Wolf "Efendimizi kızdırrrmamalıydın."


translate turkish d5_ending_among_us_74ce9404:



    voice "voice/Owl/45 Tog.ogg" 
    Owl "U-uh! O zaman parmağını kesmezdi."


translate turkish d5_ending_among_us_dab75f4c:


    "Kurtçuk bir kez daha bana yaklaştı. Ensemi hendeğe çarptım. Üstüme küçük bir çığ düştü."


translate turkish d5_ending_among_us_d8e7b1c8:



    voice "voice/Anton/5day/333 Ne.ogg"
    Ant "Yaklaşmayın! Polina bu tılsımın beni koruyacağını söyledi!"


translate turkish d5_ending_among_us_e25082cc:



    voice "voice/Wolf/137 S.ogg"
    Wolf "Söylemiştir tabii..."


translate turkish d5_ending_among_us_3935084d:



    voice "voice/Wolf/138 z.ogg"
    Wolf "Siz yalancıları iyi bilirrrim ben."


translate turkish d5_ending_among_us_da940d93:


    "Maskesinin ardında haylaz kıvılcımlar parıldıyordu."


translate turkish d5_ending_among_us_2bf4a686:



    voice "voice/Bear/5day/on.ogg"
    Bear "Çocuk, efendinin korumasında..."


translate turkish d5_ending_among_us_07fe7105:



    voice "voice/Owl/46 Zn.ogg" 
    Owl "Biliyoruz, u-uh! Senin kadar kıt kafalı mıyız sence?"


translate turkish d5_ending_among_us_178b6dc1:



    voice "voice/Bear/5day/Le.ogg"
    Bear "Bir şey derdim de üşendim."


translate turkish d5_ending_among_us_3a92475e:



    voice "voice/Wolf/139 mi.ogg"
    Wolf "Size el sürrrmeyeceğiz."


translate turkish d5_ending_among_us_573cc64b:



    voice "voice/Wolf/140 no.ogg"
    Wolf "İcabınıza efendinin bakmasını istiyorrrsanız..."


translate turkish d5_ending_among_us_51184939:



    voice "voice/Wolf/141 me.ogg"
    Wolf "Karrrışmam."


translate turkish d5_ending_among_us_8625b19c:


    "Kurtçuk tuhaf bir selam verip geri çekildi ve hendekte beliren boynuzlu karaltıya yol verdi."


translate turkish d5_ending_among_us_c704fb34:


    "Belki de en başından beri oradaydı da eğlenceyi izliyordu."


translate turkish d5_ending_among_us_a8364fbb:


    "İzbandut yaratık aydınlığa çıkarken ürperdi."


translate turkish d5_ending_among_us_341f68d5:


    "Uzun parmaklarını sıkıp bırakıyor, ellerini kütürdetiyordu."


translate turkish d5_ending_among_us_1bb975f0:



    voice "voice/kozel/5day/68 k.ogg" 
    Master "Efendiye kafa tutanlar cezayı hak eder."


translate turkish d5_ending_among_us_696e4496:



    voice "voice/kozel/5day/69 a.ogg" 
    Master "Sürüye ihanet edenlerse ölüme layık olur!"


translate turkish d5_ending_among_us_5c986a6c:


    "Kendimi işe yaramaz tılsımla koruyarak çığlık attım. Keçinin gölgesi göğe kadar uzanmış, dünyayı çepeçevre sarmıştı."


translate turkish d5_ending_among_us_7770786e:


    "Yaratıklar dişlerini heyecanla gıcırdatıyordu."


translate turkish d5_ending_among_us_a3e79a83:


    "Keçinin elinde bir flüt beliriverdi. Seyircilere eşyalarını gösteren bir sihirbaz gibi elindeki çalgıyı gösterdi."


translate turkish d5_ending_among_us_090193b4:



    voice "voice/kozel/5day/70 po.ogg" 
    Master "Esas Tavşancık'a hakkını teslim etme zamanı."


translate turkish d5_ending_among_us_b6525cd8:


    "Keçi, kemik gören aç bir köpek gibi flüte daldı."


translate turkish d5_ending_among_us_bb013210:


    "Korkudan donan beynim müziğin etkisiyle çatırdamaya başlamıştı. Yaşadığım zulüm yüzünden iki büklüm olmuştum."


translate turkish d5_ending_among_us_86a8d887:


    "Damarlarım, kaslarım patlayacak; gözlerim yuvalarından fırlayıp önüme düşecekmiş gibi hissediyordum."


translate turkish d5_ending_among_us_039539f3:


    "Keçi hırsla bana bakıp çalmaya devam etti."


translate turkish d5_ending_among_us_f341ab65:


    "Flüt ezgisi zihnimi ele geçirmişti. Kafatasımın içinde korkunç bir basınç oluşmuştu."


translate turkish d5_ending_among_us_5a3bad03:


    "Burnumdan kan gelmişti. İçimden bir şey beni tekmeleyip isteğini dile getirdi."


translate turkish d5_ending_among_us_71496f17:



    voice "voice/anton/5day/35 v.ogg"
    Noname_Bunny "Beni özgür bırak. Beni özgür bırak!"


translate turkish d5_ending_among_us_10ca889d:



    voice "voice/anton/5day/36 ne.ogg"
    Noname_Bunny "Direnme yoksa canın daha çok yanacak."


translate turkish d5_ending_among_us_d49c3ac2:


    "Dizlerimin üstüne düştüm. Bağırsa mıydım bağırmasa mıydım bilmiyordum. Polina da olan biteni dehşetle izliyordu."


translate turkish d5_ending_among_us_4053c1d3:


    "Flüt çalarken bir çatırtı koptu. Alnımdan kan fışkırmaya başladı."


translate turkish d5_ending_among_us_81a25c8b:


    "Kafatasım patlayıp etrafa deri ve kemik parçaları saçıldı."


translate turkish d5_ending_among_us_d2caa54e:


    "Bilincimi yitirmeden hemen önce kafamdan çirkin bir şeyin çıktığını hissettim."


translate turkish d5_ending_among_us_9f761229:


    "Biçimsiz bir kelebek kanatlanıp buz gibi havayı yararak göğe uçmuştu."


translate turkish d5_ending_pack_of_afterdev_48422e6a:


    "Üstümüzde ne kadar ıvır zıvır varsa atıp ormana son sürat koştuk."


translate turkish d5_ending_pack_of_afterdev_a00488df:


    "Ormana son sürat koşuyorduk."


translate turkish d5_ending_pack_of_afterdev_25fe9867:


    "Ancak canavarlar bizden daha hızlıydı."


translate turkish d5_ending_pack_of_afterdev_8f2c581e:


    "Tipide üzerimize atıldılar."


translate turkish d5_ending_pack_of_afterdev_59536a7c:


    "Baykuşçuk Olya'nın omuzlarına alçalıp onu ellerimden zorla aldı."


translate turkish d5_ending_pack_of_afterdev_48b99a09:


    "Kardeşimin dehşeti gözlerinden okunuyordu."


translate turkish d5_ending_pack_of_afterdev_02e01348:


    "Kuş, kardeşimi karların arasına atıp üzerine kondu."


translate turkish d5_ending_pack_of_afterdev_4304d0f3:


    "Kar fırtınası, Polina'yı var gücüyle tartaklıyor, sıyırdığı yerde kırmızı lekeler bırakıyordu."


translate turkish d5_ending_pack_of_afterdev_a0fff66e:


    "Kar tabakasına bir şey çarpıp yuvarlandı."


translate turkish d5_ending_pack_of_afterdev_89a3d969:


    "Roma omuz silkti."


translate turkish d5_ending_pack_of_afterdev_e22ab773:


    "Ardından ellerini kaldırıp... başının olması gereken yere attı."


translate turkish d5_ending_pack_of_afterdev_64afba1a:


    "Boynundan kanlar boşalmaya başlamıştı."


translate turkish d5_ending_pack_of_afterdev_7b5e941e:


    "Kan gölünde beyaz bir kıkırdak görünüyordu."


translate turkish d5_ending_pack_of_afterdev_b570bed2:


    "Pörtlek gözlü kellesi buzda kayıp dibimde durdu."


translate turkish d5_ending_pack_of_afterdev_81ffbe07:


    "Çığlığı bastım."


translate turkish d5_ending_pack_of_afterdev_3ca700aa:


    "Karların arasından fırlayan pençeler baldırıma kanca gibi takıldı."


translate turkish d5_ending_pack_of_afterdev_6a3c0231:


    "Sevdiklerimin imdadına koşamamış, bu kanlı manzarayı ancak dehşet içinde izleyebilmiştim."


translate turkish d5_ending_pack_of_afterdev_3828b244:


    "Baykuşçuk gözünü yusyuvarlak açıp Olya'nın suratını gagaladı."


translate turkish d5_ending_pack_of_afterdev_980e3a5e:


    "Tek darbede burnunu koparıp oluk oluk kan akıtmayı başardı."


translate turkish d5_ending_pack_of_afterdev_8e307025:


    "Çığlıklar atıyor, karları eşeliyordum."


translate turkish d5_ending_pack_of_afterdev_140b42f7:


    "Baykuş bir gaga darbesi daha atıp bu sefer Olya'nın dudaklarını kopardı."


translate turkish d5_ending_pack_of_afterdev_c8478353:


    "Hem üst hem de alt dudağı, birkaç deri parçasıyla Olya'nın yüzüne zorla tutunuyordu."


translate turkish d5_ending_pack_of_afterdev_0920dc35:


    "Olya süt dişlerini de Baykuşçuk'un gagasına kaptırdı."


translate turkish d5_ending_pack_of_afterdev_2d3ce4b1:


    "Canım kardeşimin yüzü kıymaya dönmüştü."


translate turkish d5_ending_pack_of_afterdev_96e8e5b1:


    "Ancak baykuş durmak bilmiyor, kafatasındaki etleri de soyuyordu."


translate turkish d5_ending_pack_of_afterdev_86438218:


    "Birden dört yanıma saplanıp etlerimi koparan dişleri hissettim."


translate turkish d5_ending_pack_of_afterdev_450d8384:


    "Karlar kızıla boyanmıştı."


translate turkish d5_ending_pack_of_afterdev_3692e08a:


    "Zavallı Olya hala hayattaydı. Fırtınanın ortasında sessizce inildiyordu."


translate turkish d5_ending_pack_of_afterdev_f6800775:


    "Baltayı var gücümle savurdum ancak karavana."


translate turkish d5_ending_pack_of_afterdev_0eb6be05:


    "Pençeler bu sefer saç derime yapışmıştı. Diri diri yüzülüyordum."


translate turkish d5_ending_pack_of_afterdev_a661b351:


    "Son nefeslerimi verirken nemrut bir tilkinin yüzünü gördüm. Bana huzurlu, sonsuz bir uykunun kapılarını araladı."


translate turkish d5_ending_pack_of_afterdev_3ac06108:


    "Gördüğüm son şey, üstüme kapanıp beni sonsuz karanlığa mahkum eden çatık kaşlı ayı oldu."


translate turkish d5_ending_rage_48422e6a:


    "Üstümüzde ne kadar ıvır zıvır varsa atıp ormana son sürat koştuk."


translate turkish d5_ending_rage_a00488df:


    "Ormana son sürat koşuyorduk."


translate turkish d5_ending_rage_25fe9867:


    "Ancak canavarlar bizden daha hızlıydı."


translate turkish d5_ending_rage_aff76bbe:


    "İniltilere boğulan Polina'yı karların arasına fırlatmışlardı."


translate turkish d5_ending_rage_a0fff66e:


    "Kar tabakasına bir şey çarpıp yuvarlandı."


translate turkish d5_ending_rage_044b552c:


    "Roma omuz silkti."


translate turkish d5_ending_rage_930c00bd:


    "Ardından ellerini kaldırıp... başının olması gereken yere attı."


translate turkish d5_ending_rage_64afba1a:


    "Boynundan kanlar boşalmaya başlamıştı."


translate turkish d5_ending_rage_7b5e941e:


    "Kan gölünde beyaz bir kıkırdak görünüyordu."


translate turkish d5_ending_rage_b570bed2:


    "Pörtlek gözlü kellesi buzda kayıp dibimde durdu."


translate turkish d5_ending_rage_81ffbe07:


    "Çığlığı bastım."


translate turkish d5_ending_rage_3ca700aa:


    "Karların arasından fırlayan pençeler baldırıma kanca gibi takıldı."


translate turkish d5_ending_rage_6a3c0231:


    "Sevdiklerimin imdadına koşamamış, bu kanlı manzarayı ancak dehşet içinde izleyebilmiştim."


translate turkish d5_ending_rage_b9b9981b:


    "Yaratıklar Polina'yı diri diri deşiyordu."


translate turkish d5_ending_rage_8080220e:


    "Kemiklerini kırıyor, etlerini koparıyorlardı."


translate turkish d5_ending_rage_77d807d7:


    "Kasları yırtılıyor, kıpkırmızı bağları yaratıkların dişlerine dolanıyordu."


translate turkish d5_ending_rage_e718c320:


    "Polina'nın çenesi kafatasından çatırdayarak kopmuştu. Üzerinde yalnızca birkaç parça deri kalmıştı."


translate turkish d5_ending_rage_324b4320:


    "Yüzünde oluşan boşluktan dili de sarkmıştı."


translate turkish d5_ending_rage_fd3456bc:


    "Yüzümü dağlayan, derimi yüzen pençelere esir düşen ben, Polina'nın ölümüne tanık olmuştum."


translate turkish d5_ending_rage_c30327ec:


    "Korkudan tir tir titreyen ellerimle baltayı savuramadım bile."


translate turkish d5_ending_rage_eb8f74d1:


    "Bu fani dünyaya güzel bir nokta koymak için Olya'nın tatlı yüzünü gözümün önüne getirmeye çalışıyordum."


translate turkish d5_ending_rage_2ed53767:


    "Nur topu gibi kardeşimi düşünüp duruyordum."


translate turkish d5_ending_rage_3ac06108:


    "Gördüğüm son şey, üstüme kapanıp beni sonsuz karanlığa mahkum eden çatık kaşlı ayı oldu."


translate turkish d5_ending_nightmare_aa4dbf21:


    "Ben seçime inanmazdım. Kader en başından bellidir. Alın yazım buydu."


translate turkish d5_ending_nightmare_d5d2af34:


    "Maskeyle yüzüm kavuştu. Sanki bir canavarın dili, beynimde kısa devreye neden olmuştu."


translate turkish d5_ending_nightmare_30decc94:



    voice "voice/anton/2day/Vdoh.ogg"
    "Ciğerlerim açılıverdi. Aracın kirli kabininin kokusunu havadaki vahşetle birlikte içime çektim."


translate turkish d5_ending_nightmare_0aa75416:


    "Yolcu kapısı öyle bir kuvvetle açıldı ki menteşelerinden fırlayacaktı."


translate turkish d5_ending_nightmare_eaa5cc27:


    "Tipi ortalığı birbirine katarken bembeyaz manzarada bir kadın silüeti belirdi. Başı neredeydi göremiyordum."


translate turkish d5_ending_nightmare_73a35181:


    "Olya'yla sığındığımız yeri albino örümcekler gibi işgal eden solgun elleriyle metal parçaları yokladı."


translate turkish d5_ending_nightmare_6041bbf0:


    "Kadın paslı bir mekanizma gibi yavaşça içeriye doğru eğildi."


translate turkish d5_ending_nightmare_b2abf5bc:


    "Önce keçe kürklü çenesi, ardından ağzı ve göz çizgileri göründü."


translate turkish d5_ending_nightmare_3b8f5625:


    "Maskesi eskiden taktığım maskeyle neredeyse aynıydı."


translate turkish d5_ending_nightmare_67acf55b:


    "Ancak benimkinden çok daha korkunç ve biçimsizdi. Eğri büğrü bir aynanın yansıması gibiydi."


translate turkish d5_ending_nightmare_8599beb7:


    "Göz bebekleri parıldıyor, tırnaklarını metale sürtüyordu."


translate turkish d5_ending_nightmare_d9eb002c:



    voice "voice/karina/5day/013 Da.ogg"
    Lady_Bunny "Bu ne cüret eşek sıpası!"


translate turkish d5_ending_nightmare_a1724048:


    "Tanımadığım o kadının öfkeli bakışlarıyla taş kesilmiştim. Gücümden eser kalmamıştı."


translate turkish d5_ending_nightmare_d002b316:



    voice "voice/Anton/5day/191 krya.ogg"
    "Kadın hırıldayarak arabaya daldı. Elini savurup uzun tırnaklarıyla boynumu çizdi."


translate turkish d5_ending_nightmare_7bc871b1:



    voice "voice/Anton/5day/253 pomer.ogg"
    "Boynumdan akan kanlar göğsüme, oradan kasıklarıma düştü. Dışarıda rüzgarın uğultuları yankılanıyordu."


translate turkish d5_ending_nightmare_18273a99:


    "Nefes almayı unutuverdim."


translate turkish d5_ending_nightmare_75af7772:


    "Maskeli kadın, aç Tavşancık, başımı kaldırıp gırtlağıma yapıştı."


translate turkish d5_ending_nightmare_4e871604:


    "Ağzını şapırdatarak kanımı büyük iştahla içiyordu."


translate turkish d5_ending_nightmare_adb84fe7:


    "Beynimden çekilen bir şey sanki kadının yaramda kıvranan diline hücum ediyordu."


translate turkish d5_ending_nightmare_3e73de3e:


    "İçimde onca zamandır uykuda bekleyen varlık adeta yem olmuştu."


translate turkish d5_ending_nightmare_bdf867e5:


    "Karanlığa tümüyle teslim olmadan hemen önce..."


translate turkish d5_ending_nightmare_e27f50a8:


    "... boğazımdaki kanlı yarayı sömürenin kim olduğunu fark ettim."


translate turkish d5_ending_nightmare_ca3f2055:


    "Oğlum... Leziz oğlum... Ne de yumuşak eti... Kızımın eti kadar güzel..."


translate turkish d5_ending_nightmare_b4b3545b:


    "Kana bulanan araçtan çıkıp kırmızı dudaklarımı sildim."


translate turkish d5_ending_nightmare_1645d36e:


    "Önce {u}polenyanın{/u} orada Olya'yı yedim, sonra da Anton'u..."


translate turkish d5_ending_nightmare_66c89ab1:


    "Onları geldikleri yere, yani bedenime döndürmüştüm."


translate turkish d5_ending_nightmare_193a7c87:


    "Rüzgar hem anılarını hem de adlarını unutturana kadar benimle olacaklardı."


translate turkish d5_ending_nightmare_28f2c5cc:


    "Bebeklerim mide asidimde eriyene kadar daha var olacaklardı."


translate turkish d5_ending_nightmare_ec38d8b7:


    "Doğruldum."


translate turkish d5_ending_nightmare_c0110509:


    "Bedenime habis güçler dolmuştu ancak zihnime kırmızı bir film, sis perdesi çekilmişti sanki."


translate turkish d5_ending_nightmare_8a4c51b9:


    "Evladımın boğazını kopararak doğru şeyi mi yapmıştım? Kızımın sımsıcak yüreğini yiyerek doğru mu etmiştim? Ben iyi bir anne miydim?"


translate turkish d5_ending_nightmare_3171a48c:


    "Düşüncelerim iç içe geçmişti."


translate turkish d5_ending_nightmare_e77480b5:


    "Boş bakışlarım Ormanın Efendisi'ne denk geldi. Çama yaslanmış, oturuyordu."


translate turkish d5_ending_nightmare_f6d081f5:


    "Bağırsakları karnındaki yarıktan sarkmış, maskesiyse kırmızıya boyanmıştı."


translate turkish d5_ending_nightmare_9d47d220:


    "Onu da yemek istiyordum ancak Ormanın Efendisi elini kaldırdı."


translate turkish d5_ending_nightmare_76c481d7:



    voice "voice/kozel/5day/71 be.ogg" 
    Master "Fevkalade! "


translate turkish d5_ending_nightmare_ec0e107c:



    voice "voice/kozel/5day/72 ti.ogg" 
    Master "Tek kusurun yok kızım. İşte kanlı canlı Tavşancık."


translate turkish d5_ending_nightmare_155d6b9d:



    voice "voice/kozel/5day/73 na.ogg"
    Master "Nihayet sıçrayıp ona ulaşabileceksin."


translate turkish d5_ending_nightmare_e038141c:


    "İşaret parmağını havaya doğrulttu."


translate turkish d5_ending_nightmare_96d1b51e:


    "Mezarlık karla kaplı, gökyüzü bulutlara gömülü olsa da ayın akla zarar güzelliğini görüyordum."


translate turkish d5_ending_nightmare_6985ed6b:


    "Karnıma bir kez daha açlık sancıları girdi."


translate turkish d5_ending_nightmare_c231cea2:


    "Oğlumun dudaklarımdaki kanını yalayıp başımı hafifçe salladım. Arabanın farlarında yaratıkların silüetleri belirdi."


translate turkish d5_ending_nightmare_6b334dbf:


    "Sürünün kalan sakinleri ağaçların ardından çıkıp etrafımda çember oluşturdu."


translate turkish d5_ending_nightmare_f24b34f4:



    voice "voice/kozel/5day/74 td.ogg" 
    Master "Haydi. Aya dişlerini geçir Tavşancık."


translate turkish d5_ending_nightmare_d9bc14f7:


