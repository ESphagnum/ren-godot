translate turkish event_medicated_meat_2258ef4f:


    "Ceset torbası olarak kullandığım çarşafların içine göz attı ve tiksintiyle yüzünü ekşitti."


translate turkish event_medicated_meat_232bfdd1:



    voice "voice/father/day5/10 Tv.ogg"
    Pap "Annen bunu görmesin. Anlaştık mı?"


translate turkish event_medicated_meat_71e470a7:


    "Yutkundum."


translate turkish event_medicated_meat_37d56fae:



    voice "voice/father/day5/11 Po.ogg"
    Pap "Duydun mu beni?"


translate turkish event_medicated_meat_b0f41e99:



    voice "voice/Anton/5day/11 Da.ogg"
    Ant "E-evet."


translate turkish event_medicated_meat_587f0d4e:



    voice "voice/father/day5/12 Un.ogg"
    Pap "Zaten bir ton dert çekiyor..."


translate turkish event_medicated_meat_3d19fa73:



    voice "voice/father/day5/13 Ya.ogg"
    Pap "Hadi, kurtuluver şundan."


translate turkish event_medicated_meat_c535ed0a:



    voice "voice/father/day5/14 Tak.ogg"
    Pap "Sakın ha, Olya da görmesin."


translate turkish event_medicated_meat_1d740679:



    voice "voice/Anton/5day/12 No.ogg"
    Ant "İyi de..."


translate turkish event_medicated_meat_6154a2cb:



    voice "voice/father/day5/15 Se.ogg"
    Pap "Hemen."


translate turkish event_medicated_meat_9b8ad5ec:



    voice "voice/father/day5/16 Ya.ogg"
    Pap "Ben burayı toparlar, kanıtları yok ederim."


translate turkish event_medicated_meat_36094adb:


    "Boyun eğip, çarşafları alıp koridora çıktım."


translate turkish event_medicated_meat_5fda604d:


    "İyi de nasıl atayım? Çöp değil ki bu. Benim yüzümden canından olan bir canlı..."


translate turkish event_medicated_meat_d631353b:


    "Hıçkırmamak için zor durdum. Odanın köşesinden küreği kaptım."


translate turkish event_medicated_zhulka_40d237b9:


    "Babam eğilip baltayı yerden aldı. Julka masanın altından inildiyordu."


translate turkish event_medicated_zhulka_12330c08:



    voice "voice/father/day5/20 Cha.ogg"
    Pap "Bu ne şimdi? Nereden buldunuz bunu?"


translate turkish event_medicated_zhulka_e7a50994:



    voice "voice/Anton/5day/14 Eto.ogg"
    Ant "Dişi. Adı da..."


translate turkish event_medicated_zhulka_c697269e:


    "Babam bir hareketiyle lafımı böldü."


translate turkish event_medicated_zhulka_cb1981bf:



    voice "voice/father/day5/21 Tak.ogg"
    Pap "Burayı o mu dağıttı?"


translate turkish event_medicated_zhulka_552f3f8c:



    voice "voice/Anton/5day/15 Ne.ogg"
    Ant "Tam olarak değil ama..."


translate turkish event_medicated_zhulka_4b835b90:



    voice "voice/father/day5/22 Ya.ogg"
