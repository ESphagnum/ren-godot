    voice "voice/anton/5day/216.no.ogg"
    Ant "Ancak söz veriyorum, sana sahip çıkacağım."


translate turkish d5_ending_past_c021449d:



    voice "voice/anton/5day/217.E.ogg"
    Ant "Moskova'ya, Viyana'ya gideceğiz..."


translate turkish d5_ending_past_b8a9c891:


    "Burnunu çekip bana baktı."


translate turkish d5_ending_past_9d6f2516:



    voice "voice/anton/5day/218.Ya.ogg"
    Ant "Hem seni konu alan çizgi romanımı da yayınlarım Polina."


translate turkish d5_ending_past_1f16d7c9:



    voice "voice/anton/5day/219.Ver.ogg"
    Ant "İnan bana!"


translate turkish d5_ending_past_3c9e40c6:


    "Polina bana sarılıp fısıldadı."


translate turkish d5_ending_past_d4128fa7:



    voice "voice/Polina/5day/06 ti.ogg"
    Pol "Haklısın. Senden başka kimim kaldı..."


translate turkish d5_ending_past_bf0836e3:



    voice "voice/Polina/5day/07 Ya.ogg"
    Pol "Sana inanıyorum."


translate turkish d5_ending_past_a1bf20fb:


    "Polina'nın arkasına baktım. "


translate turkish d5_ending_past_d7bd46c4:


    "Mezarlığın sonundaki kapkara dörtgen bir çukur dikkatimi çekti."


translate turkish d5_ending_past_a0f6ebf9:


    "Haçta asılı duran çelenk, \"İçeriye bak,\" dercesine yas dolu şeritlerini sallandırıyordu."


translate turkish d5_ending_past_267b9bd9:


    "Donuk topraktaki doyumsuz çukura kaskatı bacaklarımı sürüyerek ilerledim."


translate turkish d5_ending_past_b5ba076d:



    voice "voice/Polina/5day/08 Ant.ogg"
    Pol "Anton?"


translate turkish d5_ending_past_bdb39e2d:


    "Çukur beni çağırıyordu."


translate turkish d5_ending_past_c47e00be:


    "Kısa çitin üzerinden atladım."


translate turkish d5_ending_past_34dc542b:


    "Kar taneleri, balodaki kraliyet mensupları gibi fırıl fırıl dönüyordu."


translate turkish d5_ending_past_dcf77145:


    "İpince karla örtülü toprağın altında annemle babam yatıyordu."


translate turkish d5_ending_past_de3fd621:


    "Huzurla sarılmışlardı ancak yatakta değil kara topraktaydılar."


translate turkish d5_ending_past_1a0e5f21:


    "Koyun koyuna yatıyorlardı. Şakaklarındaysa yusyuvarlak kurşun delikleri vardı."


translate turkish d5_ending_past_e1e1b135:


    "Mermiler annemle babamı ebediyen kavuşturmuş, onca lüzumsuz tartışmanın hararetini söndürmüştü."


translate turkish d5_ending_past_48f4d99c:


    "Akıl sağlığımın ve gücümün son kırıntılarını da yitirerek dizlerimin üstüne çöktüm."


translate turkish d5_ending_past_a3610189:


    Ant "Hayır! Bu gerçek olamaz! İnanmıyorum!"


translate turkish d5_ending_past_dc3502c7:


    "Polina yaklaştı."


translate turkish d5_ending_past_0a0132f2:


    "Göz bebekleri karanlıkta pırıl pırıl olmuştu."


translate turkish d5_ending_past_f8cb181a:



    voice "voice/Polina/5day/09 mi.ogg"
    Pol "Geçecek."


translate turkish d5_ending_past_96e76224:



    voice "voice/anton/5day/222.Etot.ogg"
    Ant "Bu kabus..."


translate turkish d5_ending_past_330765da:



    voice "voice/anton/5day/222.On.ogg"
    Ant "Peşimizi bırakmayacak."


translate turkish d5_ending_past_e78eb2b3:



    voice "voice/Polina/5day/10 ti.ogg"
    Pol "Unuttun mu şapşal?"


translate turkish d5_ending_past_74c56822:



    voice "voice/Polina/5day/11 poka.ogg" 
    Pol "Benimle olduğun sürece güvendesin."


translate turkish d5_ending_past_47b387ed:


    "Polina'nın sağ gözü pörtledi."


translate turkish d5_ending_past_a88ff4ee:


    "Göz yuvasından beyin ve ilik parçaları, korkudan kaskatı kesilen yüzüme fışkırdı."


translate turkish d5_ending_past_ef31e970:


    "Polina eğik bir mezar taşının dibine yığıldı. Hemen yanına koştum."


translate turkish d5_ending_past_eb7dbb0b:


    "Güzelliğinden eser kalmayan yüzüne dokundum."


translate turkish d5_ending_past_0b41520e:


    "Göz yuvasından duman tütüyordu."


translate turkish d5_ending_past_ea024fd2:


    "Tüm sıcaklığıyla birlikte neşesini de yitiriyordu."


translate turkish d5_ending_past_3d5e048e:


    "Burnuma saçlarının kokusu çalındı. Çam dikeni ve maytap kokuyordu."


translate turkish d5_ending_past_5ec3e1e1:



    voice "voice/anton/5day/224.Poli.ogg"
    Ant "Polina, lütfen bırakma beni!"


translate turkish d5_ending_past_d6c7ebd6:



    voice "voice/anton/5day/224.Polina.ogg"
    Ant "Polinaaa!"


translate turkish d5_ending_past_4b152f50:


    "Simsiyah bir silahın namlusu alnıma dayandı."


translate turkish d5_ending_past_265b2191:


    "Tetik çıt etti."


translate turkish d5_ending_past_265b2191_1:


    "Tetik çıt etti."


translate turkish d5_ending_past_1ceca1b4:


    "Yarık dudaklı adam tetiği defalarca çekiyordu."


translate turkish d5_ending_past_f906c4d8:



    voice "voice/killer/01Nado.ogg"
    Killer "Ulan! Mermi bitti."


translate turkish d5_ending_past_aadb8b21:


    "Benden anlayış bekler gibi bir hali vardı."


translate turkish d5_ending_past_ad3b4f89:



    voice "voice/killer/02Vot.ogg"
    Killer "Şansıma sıçayım."


translate turkish d5_ending_past_4f67b963:


    "Katil, kemerine sakladığı silahını çıkardı."


translate turkish d5_ending_past_0a0504df:


    "Yukarıya, parıldayan yıldızlara baktı. Ardından istavroz çıkardı."


translate turkish d5_ending_past_3d6f8d0e:



    voice "voice/killer/04 Gospa.ogg"
    Killer "Ey Tanrı, lütfet bana..."


translate turkish d5_ending_past_4304829c:


    "Beni acımasızca karların arasına itip boğazıma yapıştı."


translate turkish d5_ending_past_fae21c90:


    "Yarık dudaklı adam kaşlarını çatmış, bana bakıyordu."


translate turkish d5_ending_past_aea79266:


    "Boğazımı sıkmaya devam etti."


translate turkish d5_ending_past_3d7133e6:



    voice "voice/killer/08prosty.ogg"
    Killer "Sevgin uğruna, sil isyanlarımı, sınırsız merhametin uğruna."


translate turkish d5_ending_past_12420536:



    voice "voice/anton/5day/225.Udu.ogg"
    "Tırnaklarını etime geçirmişti. Nefes alamıyordum."


translate turkish d5_ending_past_32185cd4:


    "Dünyam ölüm dansına kapılmış, durmadan dönerken topuklarımı savuruyordum. Haçları ikişerli, hatta üçerli görüyordum."


translate turkish d5_ending_past_b1677bed:


    "Pantolonum ısınıp sırılsıklam oldu."


translate turkish d5_ending_past_7ea05686:


    "Benzin birikintilerindeki rengarenk lekeleri andıran mavi çemberler gözümü bürümüştü."


translate turkish d5_ending_past_3c3566aa:


    voice "voice/killer/10e.ogg"


translate turkish d5_ending_past_76ab455b:


    Killer "Merhum zavallıların ruhunu bağışla..."


translate turkish d5_ending_past_0b1ead32:


    "Polina'yı hatırlamaya çalışıyordum..."


translate turkish d5_ending_past_d32dcfd7:


    "... tüm güzelliğiyle, asaletiyle."


translate turkish d5_ending_past_711c197c:


    "Binlerce insanın önünde sahne aldığını, ön sıradan gözümü alamadan onu izlediğimi hayal ediyordum."


translate turkish d5_ending_past_6f7a5872:


    "Olya'yı hatırlamaya çalışıyordum."


translate turkish d5_ending_past_e7a71c26:


    "Kardeşimi nurlar içinde taşıdığımı, sabahın ilk ışıklarına karıştığımızı hayal ediyordum."


translate turkish d5_ending_past_d84cdddc:


    "Bugüne kadar hissetmediğim bir mutluluk ve dinginlik ruhuma nüfuz etti."


translate turkish d5_ending_past_3b7f49b1:


    "Gecenin bir yarısında odamda gördüğüm kabustan uyanmışçasına huzura ermiştim."


translate turkish d5_ending_past_6d945515:


    "Evet. Hepsi bir rüyaydı."


translate turkish d5_ending_past_b1cf25dc:


    "Hayal gücümün eseriydi."


translate turkish d5_ending_past_e1cff15a:


    "Bir kez daha huzurla uykuya daldım. Bunların gerçek olmadığını fark edince pek sevinmiştim."


translate turkish d5_ending_past_58969e2e:


    "Sabah olunca kardeşimi, annemle babamı, Polina'yı, dostlarımı görecektim..."


translate turkish d5_ending_past_29bc4a6b:


    "Ancak ne kadar denersem deneyeyim..."


translate turkish d5_ending_past_7f92df59:


    "Gözümü bir daha açamamıştım."


translate turkish d5_ending_hunt_8c909c11:


    "Kardeşimi arabadan çıkardım. Kollarımdaki Olya burnunu çekiyor, kağıt bebek gibi sallanıyordu."


translate turkish d5_ending_hunt_914480ed:


    "Dördümüz de kıvrımlı mezarlık yolundaki sis perdesini aralayarak koşuyorduk."


translate turkish d5_ending_hunt_4278f651:


    "Aç canavarlar her an üstümüze atılabilirdi."


translate turkish d5_ending_hunt_f1e1f8f3:


    "Haçların gölgeleri patikaya düşüyordu."


translate turkish d5_ending_hunt_6dbce6b9:


    "Ardımızdan sağır edici bir uğultu koptu."


translate turkish d5_ending_hunt_4d6c9e27:



    voice "voice/Polina/5day/223 R.ogg" 
    Pol "Roma!"


translate turkish d5_ending_hunt_0272f77b:


    "Arkamı döndüm. Polina tek başınaydı."


translate turkish d5_ending_hunt_ce58bf0e:



    voice "voice/anton/5day/210.Gde.ogg"
    Ant "Roma nerede?"


translate turkish d5_ending_hunt_9f14459b:



    voice "voice/Polina/5day/224 to.ogg" 
    Pol "Daha az önce el eleydik! Roma!"


translate turkish d5_ending_hunt_1cb4ab10:


    "Haçların birinde asılı duran deri cekete gözüm ilişti."


translate turkish d5_ending_hunt_e8cf35f3:


    "Romka'nın ceketiydi."


translate turkish d5_ending_hunt_b7de8d0e:



    voice "voice/anton/5day/211.Poshle.ogg"
    Ant "Hadi Polina. Yetiş."


translate turkish d5_ending_hunt_ad58cae7:



    voice "voice/Polina/5day/225 a.ogg" 
    Pol "Roma ne olacak?"


translate turkish d5_ending_hunt_60dd18a9:



    voice "voice/anton/5day/212.on.ogg"
    Ant "O da bize yetişir. Tut elimi."


translate turkish d5_ending_hunt_103402d1:


    "Ancak Polina sözüme kulak asmadı. Romka'nın adını çaresizce karanlığa haykırarak adım adım geri çekildi."


translate turkish d5_ending_hunt_651088f1:


    "Kısık ve titrek sesi, kabul olmayan bir dua gibi tipiye karışıp yok olmuştu."


translate turkish d5_ending_hunt_48d11fc6:


    "Karanlıktan aldığı tek yanıt, boğuk bir uğultu ve ardından duyulan birkaç el silah sesi oldu."


translate turkish d5_ending_hunt_2c7d1ecd:


    "Aniden esen kar fırtınası kızcağızı yutuverdi ve Polina iz bırakmadan ortalıktan kayboldu. Ne bir feryat işitmiş ne de gölgesini görebilmiştik."


translate turkish d5_ending_hunt_a727c216:


    "Polina'yı koruyamamıştım ancak kardeşime sahip çıkmalıydım."


translate turkish d5_ending_hunt_a7342467:



    voice "voice/anton/5day/226.S.ogg"
    Ant "Hadi gidelim."


translate turkish d5_ending_hunt_4aec438f:


    "Varolmayan Ülke'yi ararken kendini Karlar Kraliçesi'nin buzullarında bulan iki firari gibiydik."


translate turkish d5_ending_hunt_fc1627ff:



    voice "voice/olya/5day/123 Ti.ogg"
    Oly "Hep benimle kalacaksın değil mi?"


translate turkish d5_ending_hunt_6d074693:



    voice "voice/anton/5day/227.Ni.ogg"
    Ant "Elbette."


translate turkish d5_ending_hunt_997f65bf:



    voice "voice/anton/5day/228.No.ogg"
    Ant "Olya..."


translate turkish d5_ending_hunt_d9a5218d:



    voice "voice/anton/5day/229.Es.ogg"
    Ant "Başıma bir şey gelirse kaç, tamam mı?"


translate turkish d5_ending_hunt_df7c416a:



    voice "voice/anton/5day/229.Eshi.ogg"
    Ant "Annemle babamı ara, yetişkinleri ara."


translate turkish d5_ending_hunt_29cb9a43:



    voice "voice/anton/5day/230.Ko.ogg"
    Ant "Maske takmayan herkesten yardım isteyebilirsin."


translate turkish d5_ending_hunt_df9768a8:



    voice "voice/olya/5day/124 Dav.ogg"
    Oly "Bir şeyler yapalım da başımıza iş gelmesin."


translate turkish d5_ending_hunt_cc457aeb:



    voice "voice/anton/5day/231.ko.ogg"
    Ant "Yaparız yapmasına da..."


translate turkish d5_ending_hunt_71e13897:



    voice "voice/anton/5day/231.po.ogg"
    Ant "Yemin et, eğer..."


translate turkish d5_ending_hunt_b7e583b9:



    voice "voice/anton/5day/232.Es.ogg"
    Ant "... yürüyemeyecek hale gelirsem kaçıp yardım arayacaksın."


translate turkish d5_ending_hunt_91bd382b:



    voice "voice/olya/5day/125 Kl.ogg"
    Oly "Annem üstüne yemin ederim!"


translate turkish d5_ending_hunt_4d4f6686:


    "Yüreğimdeki acı nedeniyle rüzgarın uğultusuna eşlik edesim gelmişti."


translate turkish d5_ending_hunt_d7bd46c4:


    "Mezarlığın sonundaki kapkara dörtgen bir çukur dikkatimi çekti."


translate turkish d5_ending_hunt_a0f6ebf9:


    "Haçta asılı duran çelenk, \"İçeriye bak,\" dercesine yas dolu şeritlerini sallandırıyordu."


translate turkish d5_ending_hunt_267b9bd9:


    "Donuk topraktaki doyumsuz çukura kaskatı bacaklarımı sürüyerek ilerledim."


translate turkish d5_ending_hunt_e4008983:



    voice "voice/olya/5day/126 To.ogg"
    Oly "Nereye Toşa?"


translate turkish d5_ending_hunt_bdb39e2d:


    "Çukur beni çağırıyordu."


translate turkish d5_ending_hunt_c47e00be:


    "Kısa çitin üzerinden atladım."


translate turkish d5_ending_hunt_34dc542b:


    "Kar taneleri, balodaki kraliyet mensupları gibi fırıl fırıl dönüyordu."


translate turkish d5_ending_hunt_dcf77145:


    "İpince karla örtülü toprağın altında annemle babam yatıyordu."


translate turkish d5_ending_hunt_de3fd621:


    "Huzurla sarılmışlardı ancak yatakta değil kara topraktaydılar."


translate turkish d5_ending_hunt_1a0e5f21:


    "Koyun koyuna yatıyorlardı. Şakaklarındaysa yusyuvarlak kurşun delikleri vardı."


translate turkish d5_ending_hunt_e1e1b135:


    "Mermiler annemle babamı ebediyen kavuşturmuş, onca lüzumsuz tartışmanın hararetini söndürmüştü."


translate turkish d5_ending_hunt_48f4d99c:


    "Akıl sağlığımın ve gücümün son kırıntılarını da yitirerek dizlerimin üstüne çöktüm."


translate turkish d5_ending_hunt_1ac2f205:



    voice "voice/olya/5day/127 Chto.ogg"
    Oly "Kim o?"


translate turkish d5_ending_hunt_3ac53925:



    voice "voice/anton/5day/233.Ne.ogg"
    Ant "Yaklaşma!"


translate turkish d5_ending_hunt_939c1ba4:



    voice "voice/olya/5day/128 T.ogg"
    Oly "Beni korkutuyorsun!"


translate turkish d5_ending_hunt_d064c054:



    voice "voice/anton/5day/234.Sto.ogg"
    Ant "Olduğun yerde kal!"


translate turkish d5_ending_hunt_2c655d1e:



    voice "voice/olya/5day/129 To.ogg"
    Oly "O adam beni korkutuyor..."


translate turkish d5_ending_hunt_108738ac:


    "Adam mı?"


translate turkish d5_ending_hunt_5217a38c:


    "Bir mermi kulağımı sıyırıp geçmişti. Sebep olduğu çınlama yüzünden aklımı yitirecektim."


translate turkish d5_ending_hunt_0da2ecd6:


    "Granit taşın etrafında dolanan yarık dudaklı bir adam vardı."


translate turkish d5_ending_hunt_0f3e0500:


    "Ben kendime gelemeden yaşlara boğulan Olya bana siper oldu."


translate turkish d5_ending_hunt_7871252e:


    "Korkudan perişan olmuştu."


translate turkish d5_ending_hunt_2d7b6d4c:


    "Ancak beni kaybetme korkusu baskın gelmişti." "Ben de aynı şekilde hissediyordum. Hatta korkum onunkinden beterdi."


translate turkish d5_ending_hunt_e8e52ff1:



    voice "voice/olya/5day/131 Cht.ogg"
    Oly "Ne istiyorsun? Defolun!"


translate turkish d5_ending_hunt_3cb1e5fc:



    voice "voice/olya/5day/131 mi.ogg"
    Oly "Bize sakın dokunma!"


translate turkish d5_ending_hunt_0032675a:


    "İzbandut adam sükunetini bozmuyordu. Çocukların feryatlarını duymaya alışık gibi bir hali vardı."


translate turkish d5_ending_hunt_0277e9e0:


    "Mesafeyi kapatıp doğrudan alnıma nişan aldı."


translate turkish d5_ending_hunt_9a8abced:


    "Çaresizlikle silahın patlamasını bekledim."


translate turkish d5_ending_hunt_c7235f8c:


    "Bedenimin kar taneleri gibi yere düşmesini, ardımdaki çukuru boylamayı bekliyordum."


translate turkish d5_ending_hunt_5dbe35ec:


    "Hayata gözlerini yuman annemle babama kavuşacaktım."


translate turkish d5_ending_hunt_265b2191:


    "Tetik çıt etti."


translate turkish d5_ending_hunt_265b2191_1:


    "Tetik çıt etti."


translate turkish d5_ending_hunt_1ceca1b4:


    "Yarık dudaklı adam tetiği defalarca çekiyordu."


translate turkish d5_ending_hunt_f906c4d8:



    voice "voice/killer/01Nado.ogg"
    Killer "Ulan! Mermi bitti."


translate turkish d5_ending_hunt_aadb8b21:


    "Benden anlayış bekler gibi bir hali vardı."


translate turkish d5_ending_hunt_b3d738dc:



    voice "voice/olya/5day/132 Os.ogg"
    Oly "Bırak bizi! Defol!"


translate turkish d5_ending_hunt_c30a2512:



    voice "voice/killer/02Vot.ogg"
    Killer "Şansıma sıçayım."


translate turkish d5_ending_hunt_4f67b963:


    "Katil, kemerine sakladığı silahını çıkardı."


translate turkish d5_ending_hunt_0a0504df:


    "Yukarıya, parıldayan yıldızlara baktı. Ardından istavroz çıkardı."


translate turkish d5_ending_hunt_3d6f8d0e:



    voice "voice/killer/04 Gospa.ogg"
    Killer "Ey Tanrı, lütfet bana..."


translate turkish d5_ending_hunt_5d76932d:


    "Beni acımasızca karların arasına itip boğazıma yapıştı."


translate turkish d5_ending_hunt_fae21c90:


    "Yarık dudaklı adam kaşlarını çatmış, bana bakıyordu."


translate turkish d5_ending_hunt_aea79266:


    "Boğazımı sıkmaya devam etti."


translate turkish d5_ending_hunt_f9e8af79:


    "Olya adamı yumrukluyor, beni hazin sonumdan kurtarmaya çalışıyordu."


translate turkish d5_ending_hunt_1dc752cd:


    "Yeminini bozmuştu. Olya kaçmamıştı."


translate turkish d5_ending_hunt_461360c2:


    "Kaçamamıştı. Onun yerinde olsam ben de kaçamazdım."


translate turkish d5_ending_hunt_fed4f715:


    "Katil savunmasız ve narin kardeşimi en yakın mezara tekmeledi."


translate turkish d5_ending_hunt_7344b05d:


    "Bir süre sonra mezardan yürek dağlayan bir çığlık koptu ve delicesine ağlayışlara dönüştü."


translate turkish d5_ending_hunt_7b27a60d:



    voice "voice/olya/5day/134 Mam.ogg"
    Oly "Anne! Anneciğim!"


translate turkish d5_ending_hunt_5d2cf269:



    voice "voice/olya/5day/134 Mam2.ogg"
    Oly "Anneee!"


translate turkish d5_ending_hunt_25667c85:


    "Katil, Olya'nın feryadını bastırmaya çalışırcasına mırıldandı."


translate turkish d5_ending_hunt_3d7133e6:



    voice "voice/killer/08prosty.ogg"
    Killer "Sevgin uğruna, sil isyanlarımı, sınırsız merhametin uğruna."


translate turkish d5_ending_hunt_35668412:


    "Tırnaklarını etime geçirmişti. Nefes alamıyordum."


translate turkish d5_ending_hunt_32185cd4:


    "Dünyam ölüm dansına kapılmış, durmadan dönerken topuklarımı savuruyordum. Haçları ikişerli, hatta üçerli görüyordum."


translate turkish d5_ending_hunt_b1677bed:


    "Pantolonum ısınıp sırılsıklam oldu."


translate turkish d5_ending_hunt_7ea05686:


    "Benzin birikintilerindeki rengarenk lekeleri andıran mavi çemberler gözümü bürümüştü."


translate turkish d5_ending_hunt_b6ba89d6:



    voice "voice/killer/10e.ogg"
    Killer "Merhum zavallıların ruhunu bağışla..."


translate turkish d5_ending_hunt_68d059c0:



    voice "voice/olya/5day/136 Rud2.ogg"
    "Yeni kazılmış mezarın dibindeki Olya'nın çığlıkları susmuyordu."


translate turkish d5_ending_hunt_fb0ca14e:


    "Kutsal Kitap'taki sureleri duydukça gücümü yitiriyordum."


translate turkish d5_ending_hunt_bdc5ec14:



    voice "voice/Anton/5day/Begi.ogg"
    "İçimdeki ses fısıldayarak \"Kaç! Kurtul!\" diyordu."


translate turkish d5_ending_hunt_13076743:


    "Son kez kurtulmayı denedim."


translate turkish d5_ending_hunt_543e7e50:


    "Ancak kendimi hayal dünyamda buldum."


translate turkish d5_ending_hunt_35fa3968:


    "Olya'yı kurtarmak için koştuğumu hayal ettim."


translate turkish d5_ending_hunt_0778b339:


    "Kardeşimi nurlar içinde taşıdığımı, sabahın ilk ışıklarına karıştığımızı hayal ediyordum."


translate turkish d5_ending_hunt_28e05773:


    "Bugüne kadar hissetmediğim bir mutluluk ve dinginlik ruhuma nüfuz etti."


translate turkish d5_ending_hunt_c2ba2c8d:


    "Gecenin bir yarısında odamda gördüğüm kabustan uyanmışçasına huzura ermiştim."


translate turkish d5_ending_hunt_1340b01e:


    "Evet. Hepsi bir rüyaydı."


translate turkish d5_ending_hunt_b1cf25dc:


    "Hayal gücümün eseriydi."


translate turkish d5_ending_hunt_e1cff15a:


    "Bir kez daha huzurla uykuya daldım. Bunların gerçek olmadığını fark edince pek sevinmiştim."


translate turkish d5_ending_hunt_58969e2e:


    "Sabah olunca kardeşimi, annemle babamı, Polina'yı, dostlarımı görecektim..."


translate turkish d5_ending_hunt_29bc4a6b:


    "Ancak ne kadar denersem deneyeyim..."


translate turkish d5_ending_hunt_7f92df59:


    "Gözümü bir daha açamamıştım."


translate turkish d5_ending_call_7b1c038d:


    "Omuzumda bir dokunuş hissettim."


translate turkish d5_ending_call_678044ef:


    "Karanlıktan Polina çıkageldi. Nefes nefeseydi ve saçı birbirine karışmıştı."


translate turkish d5_ending_call_bd75c83b:



    voice "voice/Polina/5day/12 be.ogg"
    Pol "Kaç!"


translate turkish d5_ending_call_4ad05603:


    "Ona Romka'yı sormak istedim ancak soramadan Kurtçuk'un karlı mezarlıktaki uğultusunu duydum."


translate turkish d5_ending_call_4e5cc8c8:


    "Sımsıkı dikilmiş mezar taşlarına çarpa çarpa canavarlardan kaçıyorduk."


translate turkish d5_ending_call_bf9d7b57:



    voice "voice/tihonov/5day/105 mi.ogg"
    Master "Sizi bulacağız!"


translate turkish d5_ending_call_e854bb08:



    voice "voice/tihonov/5day/106 v.ogg"
    Master "Hendekte de olsanız, çukurda da köklerin altında da sizi bulacağız, emin olun!"


translate turkish d5_ending_call_2199010b:


    "Havaya kalkan kar taneleri cildimi gıdıklıyordu."


translate turkish d5_ending_call_1774bad5:


    "Yoğun mu yoğun, devasa bir bulut üstümüzde belirip ayı yutmuştu."


translate turkish d5_ending_call_f50e1f49:


    "Gece bekçisinin ıssız kulübesini, tahrip olmuş yüzlerin yer aldığı granit mezar taşlarını, isimlerin değil sayıların yazılı olduğu mezarları ve önceki asırdan kalma türbeleri görüyordum."


translate turkish d5_ending_call_8d11f69a:


    "Yerdeki koskoca delikler, vazolardaki yapay çiçekler ve karanlıktaki aç gözler de dikkatimden kaçmamıştı."


translate turkish d5_ending_call_41890c80:


    "Çok geçmeden, çitlerin dışına kadar uzanan orman dikkatimi çekti."


translate turkish d5_ending_call_f75ad509:


    "Parmaklıkların arasından geçtik."


translate turkish d5_ending_call_712c88a6:


    "Polina, tellerini koparmak üzere olan bir keman gibiydi."


translate turkish d5_ending_call_2f9c97d9:


    "Aynı zamanda bir kış akşamında patlayan havai fişeği andırıyordu."


translate turkish d5_ending_call_bc6c0825:


    "Peşimizdeki yaratıklar giderek yaklaşıyordu."


translate turkish d5_ending_call_d01deefe:


    "Kemiklerimizi, sulu sulu etimizi unutamayacak kadar açlardı."


translate turkish d5_ending_call_5862bb65:


    "Onların avı olmuştuk."


translate turkish d5_ending_call_7ffaf512:


    "Aslında en başından beri av bizdik. Hiç yorulmayan, takibi bırakmayan avcıların hedefiydik."


translate turkish d5_ending_call_9a557374:


    "Yolun sonuna geldik."


translate turkish d5_ending_call_99e10d2b:


    "Karşımızda karların arasında kol gezen gölgelerin krallığı, yani tayga duruyordu."


translate turkish d5_ending_call_1893e9ed:


    "Kadim çamların yakınında durdum."


translate turkish d5_ending_call_edd08438:


    "Kaybettiğim, ormanın benden alıp götürdüğü her şeyi; bilgelik dolu sıcacık gülüşlü babamı, güzel annemi, kabarık saçlı ve nur yüzlü kardeşimi hatırladım."


translate turkish d5_ending_call_72c813bb:


    "Ailem taygada helak olmuştu."


translate turkish d5_ending_call_3f31f0b1:


    "Yalnızca onlar da değildi..."


translate turkish d5_ending_call_ad6830b1:


    "Orman, pek uzaklardaki Disneyland'in pamuk şekerlerini, oyuncaklarımı, yayınlayamadığım çizgi romanımı, ilk öpücüğümü ve geleceğimi de elimden almıştı."


translate turkish d5_ending_call_a2780765:


    "Okul, arkadaşlık ve aşk yerine bu çam dikenli cehennemin eğri büğrü dalları bana kucak açmıştı."


translate turkish d5_ending_call_2ebc2c87:



    voice "voice/anton/5day/247.Kakoi.ogg"
    Ant "Ormana kaçsak ne yazar?"


translate turkish d5_ending_call_a1104b14:


    "Ne tuhaftır ki Polina buruk bir gülüşle karşılık verdi."


translate turkish d5_ending_call_365aa329:



    voice "voice/Polina/5day/13 pom.ogg"
    Pol "Sana şapşal dememeye söz vermiştim ya..."


translate turkish d5_ending_call_9c1e082f:


    "Şaşkınlıkla Polina'ya baktım."


translate turkish d5_ending_call_e36b47c7:



    voice "voice/Polina/5day/14 m.ogg"
    Pol "Biz kaçmak için doğduk."


translate turkish d5_ending_call_2e6b355e:



    voice "voice/Polina/5day/15 tak.ogg"
    Pol "O yüzden..."


translate turkish d5_ending_call_55ab51a9:


    "Elini uzattı."


translate turkish d5_ending_call_ad686cb5:


    "Buz gibi parmaklarını tuttum."


translate turkish d5_ending_call_ac775f00:


    "Kimsenin sağ çıkamadığı o ormana birlikte adım attık."


translate turkish d5_ending_call_20633c4e:


    "Gölgeler inlerinde kıvranıyordu."


translate turkish d5_ending_call_99bcf6db:


    "Bizse koşuyorduk."


translate turkish d5_ending_call_a275ae50:


    "Bizi saran ebedi karanlıkta..."


translate turkish d5_ending_call_d8d5fc79:


    "... güneş bir daha hiç doğmayacaktı."


translate turkish d5_ending_traces_95a1e25d:



    voice "voice/anton/5day/32 be.ogg"
    "İçimdeki ses bana {i}\"Kaç!\"{/i} diye fısıldadı."


translate turkish d5_ending_traces_8c909c11:


    "Kardeşimi arabadan çıkardım. Kollarımdaki Olya burnunu çekiyor, kağıt bebek gibi sallanıyordu."


