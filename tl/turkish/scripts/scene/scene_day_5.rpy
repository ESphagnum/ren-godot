    voice "voice/Anton/5day/35 Mne.ogg"
    Ant "Üzgünüm dostum."


translate turkish event_m_story_0e46a17f:


    "Aslında dost most değildik."


translate turkish event_m_story_5ef76643:


    "Ancak Romka'yı böylesine perişan görünce insafa gelmiştim."


translate turkish event_m_story_27257ac7:


    "Dostunu kaybetmek ne zordur, hayal bile edemezdim."


translate turkish event_m_story_6595a624:



    voice "voice/tihonov/5day/12 Uho.ogg"
    Tikhonov "Gidelim."


translate turkish event_m_story_d7cb8c72:


    "Romka ayakkabıyı bıraktı."


translate turkish event_m_story_7b3ff4d8:


    "Kar fırtınası tüm şiddetiyle devam ederken birer birer dışarı çıktık."


translate turkish event_m_story_409f4a87:


    "Sırık gibi çamlar etrafımızı sarmıştı. Oyuk kemikleri andırıyor, ağır yakıyorlardı sanki."


translate turkish event_m_story_54127452:


    "Kar, devrik bir traktörün kabinini örtmüştü. Garaj da kar yığınına saplanmıştı."


translate turkish event_m_story_cf82f2e3:


    "Yakınlara da bir jandarma aracı park edilmişti."


translate turkish event_m_story_d577f05c:


    "Jandarma çakarları, ürpertici ağaçlar ve bembeyaz yaban... Bu manzarayı hiç unutmayacağım."


translate turkish event_m_story_d1abd1fd:


    "Uzaktan birkaç el daha silah sıkıldı."


translate turkish event_m_story_cedf20ac:


    "Ardından sır perdesi aralandı."


translate turkish event_m_story_ecd0641e:


    "Traktör sürücüsü!"


translate turkish event_m_story_fecbd5da:


    "Garajı bir oraya bir buraya taşıyormuş. Seri katil oymuş!"


translate turkish event_m_story_ca82bac7:



    voice "voice/tihonov/5day/13 Dor.ogg"
    Tikhonov "Doronin -ve diğerleri- suçlunun peşinden gitti."


translate turkish event_m_story_6051a29a:


    "Julka kuyruğunu sallayarak bana doğru koştu."


translate turkish event_m_story_8d5caa87:



    voice "voice/tihonov/5day/14 Agero.ogg"
    Tikhonov "İşte minik kahramanımız."


translate turkish event_m_story_f8af5641:



    voice "voice/Anton/5day/36 Ger.ogg"
    Ant "Kahraman mı?"


translate turkish event_m_story_177df244:



    voice "voice/tihonov/5day/15 Eto.ogg"
    Tikhonov "Bize garajı gösteren oydu. Kokunu almış olmalı."


translate turkish event_m_story_98ccb25e:



    voice "voice/tihonov/5day/16 Po.ogg"
    Tikhonov "Jandarma mı olacaksın sen, tüy yumağı?"


translate turkish event_m_story_8bb946af:


    "Julka onaylarcasına havladı."


translate turkish event_m_story_956588dc:


    "Köpeğin sırtını okşadım."


translate turkish event_m_story_d0da99e0:



    voice "voice/Anton/5day/37 Kak.ogg"
    Ant "Nasıl buldunuz beni?"


translate turkish event_m_story_8fddf710:



    voice "voice/tihonov/5day/17 Slu.ogg"
    Tikhonov "Köpeklerimiz kokunu aldı."


translate turkish event_m_story_28ec03ea:



    voice "voice/tihonov/5day/18 Sch.ogg"
    Tikhonov "Kolay olmadı tabii. Şansımız yaver gitti."


translate turkish event_m_story_863ba5fc:


    "Uzaklarda bir yerde köpek sürüsü var gücüyle havlıyordu."


translate turkish event_m_story_1ce6d117:



    voice "voice/tihonov/5day/19 pog.ogg"
    Tikhonov "Suçlunun peşine düştüler. Yakalasalar da ısırıp o kansızın bir yerlerini koparsalar."


translate turkish event_m_story_1d1f82c8:


    "Orman buz kesiyordu."


translate turkish event_m_story_5596f627:


    "Tihonov Katya'ya abi şefkatiyle baktı ve bize döndü."


translate turkish event_m_story_7d6f68a6:



    voice "voice/tihonov/5day/20 A.ogg"
    Tikhonov "Torpidomda ilk yardım seti var. Anton... Git de bize sargı bezi getir."


translate turkish event_m_story_7c9a41d2:


    "Bir koşuda bez getirdim."


translate turkish event_m_story_ac9e914a:


    "Tihonov, Katya'nın ayağını tuttu. Karlara kocaman kan damlaları düşüyordu."


translate turkish event_m_story_c63fe806:


    "Doğru yapıp yapmadığımı teyit etmek için ara ara üsteğmenin yüzüne bakarak Katya'nın ayağını sardım."


translate turkish event_m_story_dabaa60b:



    voice "voice/tihonov/5day/22 tep.ogg"
    Tikhonov "Şuraya da bir düğüm at... Oldu."


translate turkish event_m_story_9df7e50d:


    "Kırağıyı andıran ancak öyle olmadığını bildiğim kırmızı, küçük bir leke sargıya yayılıyordu."


translate turkish event_m_story_29d094ae:


    "Gözümü alamıyordum."


translate turkish event_m_story_592fe227:



    voice "voice/tihonov/5day/23 Mu.ogg"
    Tikhonov "Arkadaşınızla arabada kalın gençler."


translate turkish event_m_story_2360b642:



    voice "voice/tihonov/5day/24 Ya.ogg"
    Tikhonov "Ben Dodorin'i bulayım."


translate turkish event_m_story_7c9d47f9:


    "Tihonov, Katya'yı arabaya taşıdı."


translate turkish event_m_story_85a3b1a1:



    voice "voice/tihonov/5day/25 Sl.ogg"
    Tikhonov "Bacaklarını hep yukarıda tutsun."


translate turkish event_m_story_0964bed2:



    voice "voice/tihonov/5day/26 A.ogg"
    Tikhonov "Yoksa kan kaybından ölür."


translate turkish event_m_story_2cf6c772:


    "Memur bey bu sözlerinin ardından gitti."


translate turkish event_m_story_39bcd3a1:


    "Ön koltuktaki Roma şakağını cama yaslamış, düşüncelere dalmıştı."


translate turkish event_m_story_c6db0554:


    "Konuşacak mecali kalmamıştı."


translate turkish event_m_story_decc5576:


    "Ben de arkada, Katya'nın yanında oturuyordum."


translate turkish event_m_story_9d622f45:


    "Yüzü kireç gibi solsa da güzelliğiyle hâlâ nefes kesiyordu."


translate turkish event_m_story_5b67de37:


    "Artık sinsi bir yılan değil, kollarımda can çekişen bir kuğu gibiydi."


translate turkish event_m_story_dd3c9c31:


    "Arabanın içinde biraz ısınınca hâlâ hayatta olduğumu fark ettim."


translate turkish event_m_story_cfbdcff5:


    "Hayatımın dehşet dolu bir dönemini geride bırakmıştım."


translate turkish event_m_story_af26bc0a:


    "Dışarıdaki amansız tipiden gözlerimi ayırıp başımı şaşkınlıkla eğdim."


translate turkish event_m_story_9afb16e1:



    voice "voice/kate/5day/09 dih.ogg"
    "Katya elimi sımsıkı tutmuştu."


translate turkish event_m_story_396c0539:


    "Kısık gözleriyle bana bakıyordu."


translate turkish event_m_story_08fafa8e:



    voice "voice/kate/5day/010 eto.ogg"
    Kate "Hayatımı... kurtardın..."


translate turkish event_m_story_6c93cdcf:


    "Romka'nın da benimle olduğunu, hatta Tihonov ve jandarma ekibinin de civarda olduğunu söylemek üzereydim."


translate turkish event_m_story_5eb55148:


    "Ancak nedense sessiz kalmayı tercih ettim."


translate turkish event_m_story_3b62d865:



    voice "voice/kate/5day/011 spa.ogg"
    Kate "Sağ ol."


translate turkish event_m_story_0b97dece:


    "Bezgin bir gülümsemeyle karşılık verdim."


translate turkish event_m_story_a9f102f9:



    voice "voice/Anton/5day/38 Otd.ogg"
    Ant "Güzelce dinlen. Hatta hepimiz dinlenmeliyiz."


translate turkish event_m_story_1f1d83bd:


    "Katya'nın dokunuşlarının keyfini sürerek cama döndüm."


translate turkish event_m_story2_afterdev_8f4ce4ee:


    "Zil çaldı. Sınıflardan öğrencilerin bağrış çağrışları yükseliyordu."


translate turkish event_m_story2_afterdev_f13a0cf2:


    "Rüzgar okul bahçesini karla örtmüştü. Botlara yapışan karlar eriyip sınıfları, okul koridorlarını kirletiyordu."


translate turkish event_m_story2_afterdev_54c2358c:


    "Seri katilin ininden kurtulalı iki hafta olmuştu."


translate turkish event_m_story2_afterdev_22a29f9d:


    "Romka okula neredeyse hiç gelmemişti. Onunla konuşma fırsatım da olmamıştı."


translate turkish event_m_story2_afterdev_842ca1ca:


    "Katya'yı da en son jandarma aracında görmüştüm."


translate turkish event_m_story2_afterdev_362bc2cb:


    "Liliya Pavlovna ise kızıyla ilgilenmek için izne çıkmıştı. Onun yerine vekil öğretmen gelmişti."


translate turkish event_m_story2_afterdev_54e273bd:


    "Babam annemi ikna etmeseydi ben de evde kilitli olacaktım."


translate turkish event_m_story2_afterdev_7072f026:


    "O olaydan beri annemle babamın gözü üstümde."


translate turkish event_m_story2_afterdev_b560681e:


    "Sınıftakilerin bana bakışlarında da bir farklılık vardı. Sanki uzak gezegenlerden gelen bir uzaylıydım."


translate turkish event_m_story2_afterdev_2b0faab7:


    "Ancak nasıl bir uzaylıydım, bilmiyorum."


translate turkish event_m_story2_afterdev_6d8d7587:


    "O Steven Spielberg filmindeki gibi mi yoksa {i}Yaratık{/i} gibi mi?"


translate turkish event_m_story2_afterdev_212b7c3f:


    "Pencere dibinde dikilip bembeyaz bahçeye baktım."


translate turkish event_m_story2_afterdev_a94e04e8:


    "Dünya sanki bu okul ve çevresinden ibaretti, etrafı girdap gibi dönen karanlıkla çevriliydi."


translate turkish event_m_story2_afterdev_f72f1862:


    "Katil kaçmayı başarmıştı."


translate turkish event_m_story2_afterdev_9c74f4c5:


    "Hâlâ kol geziyordu."


translate turkish event_m_story2_afterdev_ea96bdd0:


    "Muhtemelen öncekinden daha kara ve korkunç bir garaj hazırlıyordu."


translate turkish event_m_story2_afterdev_8ee64e0f:



    voice "voice/Polina/5day/23 Pr.ogg" 
    Pol "Selam kahramanım."


translate turkish event_m_story2_afterdev_3a5cf7a7:


    "Polina ellerini arkasına atmış, gülümsüyordu."


translate turkish event_m_story2_afterdev_08452c95:



    voice "voice/Polina/5day/24 kak.ogg" 
    Pol "Ne zamandır konuşmadık!"


translate turkish event_m_story2_afterdev_a6d0b0b0:



    voice "voice/Anton/5day/39 Po.ogg"
    Ant "Daha dün araştık."


translate turkish event_m_story2_afterdev_8be1c2fa:



    voice "voice/Polina/5day/25 Te.ogg" 
    Pol "O sayılmaz."


translate turkish event_m_story2_afterdev_981277cb:



    voice "voice/Polina/5day/26 Av.ogg" 
    Pol "Yüz yüze konuşmadıktan sonra ne anlamı var?"


translate turkish event_m_story2_afterdev_c20532e3:



    voice "voice/Polina/5day/27 kak.ogg" 
    Pol "Görüşmeyeli nasılsın?"


translate turkish event_m_story2_afterdev_b70014a2:


    "Nasıl mıyım?"


translate turkish event_m_story2_afterdev_00e7d791:


    "Katya'nın iki ayak parmağını kocaman bıçaklara kaptırdığını gördüm, nasıl olabilirim ki?"


translate turkish event_m_story2_afterdev_ad5a6a80:



    voice "voice/Anton/5day/40 Vse.ogg"
    Ant "İyiyim... Sanırım yani."


translate turkish event_m_story2_afterdev_cafb2ce6:



    voice "voice/Polina/5day/28 Ti.ogg" 
    Pol "Farklı görünüyorsun. Olgunlaşmışsın sanki."


translate turkish event_m_story2_afterdev_5d021d0b:



    voice "voice/Polina/5day/29 Do.ogg" 
    Pol "Bizim Anton Petrov'un birini kıyma makinesinden kurtardığına hâlâ inanamıyorum."


translate turkish event_m_story2_afterdev_5ae6061d:



    voice "voice/Anton/5day/41 Mi.ogg"
    Ant "Romka'yla birlikte..."


translate turkish event_m_story2_afterdev_71341171:



    voice "voice/Polina/5day/30 Ro.ogg" 
    Pol "Romka..."


translate turkish event_m_story2_afterdev_cb5ae6d4:



    voice "voice/Polina/5day/31 St.ogg" 
    Pol "Kazara birini öldürmemiş olmasına hayret ettim. Öyle bahtsız biri ki..."


translate turkish event_m_story2_afterdev_c825317a:


    "Polina alnını kırıştırdı."


translate turkish event_m_story2_afterdev_3c014ca5:



    voice "voice/Polina/5day/32 A.ogg" 
    Pol "Sen farklı birisin. Yanındayken güvende hissediyorum."


translate turkish event_m_story2_afterdev_fbfc7cc0:



    voice "voice/Polina/5day/33 De.ogg" 
    Pol "Kızlar böyle şeyleri hisseder."


translate turkish event_m_story2_afterdev_f108d335:


    "Ne diyeceğimi bilememiştim."


translate turkish event_m_story2_afterdev_9f22d5df:



    voice "voice/Anton/5day/43 Nu.ogg"
    Ant "Ne bileyim..."


translate turkish event_m_story2_afterdev_0561646a:



    voice "voice/Polina/5day/34 ne.ogg" 
    Pol "Tevazuya gerek yok! Gerçi yüzün kızarınca da pek tatlı oldun!"


translate turkish event_m_story2_afterdev_a03dbc06:



    voice "voice/Polina/5day/10 Vot.ogg"
    Pol "Bu dünyada keşke senin gibi daha fazla şövalye olsa."


translate turkish event_m_story2_afterdev_1f072daf:



    voice "voice/Polina/5day/11 Eto.ogg" 
    Pol "Ne çok sorunumuz çözülürdü, haksız mıyım?"


translate turkish event_m_story2_afterdev_bcfe65b2:


    "Bana şövalye mi dedi?"


translate turkish event_m_story2_afterdev_a6de9f2a:


    "Yüzüm kıpkırmızı, içimden utangaçlığıma söverek bir şeyler mırıldandım."


translate turkish event_m_story2_afterdev_46c1bfc3:


    "Polina pencereden dışarıya, havada süzülen karların ördüğü bembeyaz örtüye baktı."


translate turkish event_m_story2_afterdev_37a32b82:


    "Çiçeklerin ardında aşması imkansız bir karanlık örülüydü."


translate turkish event_m_story2_afterdev_e06e297f:



    voice "voice/Polina/5day/12 Du.ogg" 
    Pol "Sence o psikopat hâlâ köyümüzde mi?"


translate turkish event_m_story2_afterdev_2f1f8d97:



    voice "voice/Anton/5day/45 Na.ogg"
    Ant "Umarım değildir."


translate turkish event_m_story2_afterdev_ad2cbac8:



    voice "voice/Anton/5day/46 Mi.ogg"
    Ant "Jandarma köyü didik didik aradı."


translate turkish event_m_story2_afterdev_7e9581be:



    voice "voice/Polina/5day/13 U.ogg" 
    Pol "Anton, senden bir iyilik isteyeceğim."


translate turkish event_m_story2_afterdev_8cb6c5fe:



    voice "voice/Polina/5day/14 De.ogg" 
    Pol "Dedem şu an hastanede."


translate turkish event_m_story2_afterdev_3df6cb72:



    voice "voice/Anton/5day/47 Ch.ogg"
    Ant "Cidden mi?"


translate turkish event_m_story2_afterdev_1c0513d3:



    voice "voice/Polina/5day/39 V.ogg" 
    Pol "Yaş gelince her sağlık sorunu ciddileşiyor..."


translate turkish event_m_story2_afterdev_64b33a0b:



    voice "voice/Polina/5day/40 Zn.ogg" 
    Pol "Haliyle evimde olsam bile korkuyorum..."


translate turkish event_m_story2_afterdev_dfd0567d:



    voice "voice/Polina/5day/41 A.ogg" 
    Pol "Hele ki dışarıda... O kar fırtınasında... Eve giderken gözyaşlarıma hakim olamadım."


translate turkish event_m_story2_afterdev_319aa4ac:



    voice "voice/Polina/5day/42 G.ogg" 
    Pol "Çok saçma değil mi?"


translate turkish event_m_story2_afterdev_68957e96:



    voice "voice/Anton/5day/48 Vo.ogg"
    Ant "Hiç değil."


translate turkish event_m_story2_afterdev_42b4acfd:


    "Onu hiç bu kadar açık yürekli görmemiştim."


translate turkish event_m_story2_afterdev_78bb9c1a:


    "Bu içtenliğini Polina'ya çok yakıştırmıştım. Güzelliğine güzellik katıyordu."


translate turkish event_m_story2_afterdev_11c996a7:


    "Büyüleyici gözleri de... Hem kuşku hem güven uyandırıyordu."


translate turkish event_m_story2_afterdev_62e31fe0:


    "Onun karşısında kim olsa şövalye olmak isterdi."


translate turkish event_m_story2_afterdev_1698ceb1:



    voice "voice/Polina/5day/19 Ti.ogg" 
    Pol "Okuldan sonra beni evime geçirir misin?"


translate turkish event_m_story2_afterdev_fb799476:



    voice "voice/Polina/5day/20 Dr.ogg" 
    Pol "Diğer çocuklar bunu bana teklif etti ancak katil karşımıza çıkarsa ne yapabilirler ki?"


translate turkish event_m_story2_afterdev_60782d60:


    "Gururum okşanmıştı ancak şunu sormadan da edemedim: \"{i}Ben{/i} ne yapabilirdim ya\"?"


translate turkish event_m_story2_afterdev_8e8d43e1:


    "Chuck Norris gibi Uzi mi çekerdim?"


translate turkish event_m_story2_afterdev_924aea35:


    "Polina sırt çantamda bir, hatta bir sürü silah taşıyormuşum gibi bana bakıyordu."


translate turkish event_m_story2_afterdev_b4685d32:



    voice "voice/Polina/5day/21 Mi.ogg" 
    Pol "Ee, ne dersin?"


translate turkish event_m_story2_afterdev_80a2ac91:


    "Yanıt vermek istesem de merdivende iki kişiyi gördüm."


translate turkish event_m_story2_afterdev_550ee75d:


    "Liliya Pavlovna ve değnekle yürüyen Katya."


translate turkish event_m_story2_afterdev_f196be23:


    "Kilo vermiş, haftalarca okula gelmedikten sonra pek çelimsiz hale gelmişti."


translate turkish event_m_story2_afterdev_136b3986:


    "Jandarma aracında otururkenki narin bakışlarını hatırladım."


translate turkish event_m_story2_afterdev_1e2f28b7:


    "O korkunç gün, ölümün pençesinden kaçan iki kişinin arasındaki bağı güçlendiren anlar sayesinde biraz olsun iyi bir anıya dönüşmüştü."


translate turkish event_m_story2_afterdev_973cebd9:


    "Zil çaldı. İçim ürperdi."


translate turkish event_m_story2_afterdev_3ddd0c9a:



    voice "voice/Polina/5day/22 Vs.ogg"
    Pol "Dersler bitince görüşürüz."


translate turkish event_m_story2_afterdev_2c8c7034:


    "Sınıfa girdik."


translate turkish event_m_story2_afterdev_5ee8214d:


    "Liliya Pavlovna'nın döndüğü söylentisi, okula kendisinden önce ulaşmıştı."


translate turkish event_m_story2_afterdev_0957ca5f:


    "Sınıfa girdiğinde herkes dikkat kesildi."


translate turkish event_m_story2_afterdev_ed9e335b:



    voice "voice/lydia/5day/02 sa.ogg"
    Lilia_P "Oturun çocuklar."


translate turkish event_m_story2_afterdev_b132c251:



    voice "voice/lydia/5day/03 ka.ogg"
    Lilia_P "Kendin yürüyebilecek halde misin Katya'cığım?"


translate turkish event_m_story2_afterdev_fbf66b84:



    voice "voice/kate/5day/08 smog.ogg"
    Kate "Yürürüm anne."


translate turkish event_m_story2_afterdev_7cfa946f:



    voice "voice/kate/5day/013 hod.ogg"
    "Katya topallayarak sırasına geçti. Sınıftakilerin gözleri üzerindeydi."


translate turkish event_m_story2_afterdev_b6ce582c:


    "Muhtemelen herkes kendini onun yerine koyup psikopatın garajını hayal ediyordu."


translate turkish event_m_story2_afterdev_0cc519c8:



    voice "voice/kate/5day/014 hod.ogg"
    "Belki de iki parmağın olmadan yürümenin nasıl hissettirdiğini düşünüyorlardı."


translate turkish event_m_story2_afterdev_6a0b8e02:


    "Katya sekerek sırasına geçmek yerine, yokluğunda sırasını unutmuş gibi benim sıramın yanında durdu."


translate turkish event_m_story2_afterdev_f8419676:


    "Öylece dikilip aşağıya baktı."


translate turkish event_m_story2_afterdev_8f0584ec:


    "Şaşırıp kalmıştım."


translate turkish event_m_story2_afterdev_7208f390:


    "Çünkü bir yandan Polina yarım yamalak dönmüş, endişeyle bizi izliyordu."


translate turkish event_m_story2_afterdev_6e6b94e4:



    voice "voice/kate/5day/015 pod.ogg"
    Kate "Kayar mısın?"


translate turkish event_m_story2_afterdev_4543926f:


    "Ne yapacağımı bilememiştim."


translate turkish event_m_story2_afterdev_d69934d9:


    "Babamın da dediği gibi, iki arada bir derede kalmıştım."


translate turkish event_m_story2_afterdev_483c3113:


    "Polina avucundaki kalemi sıktı. Neredeyse kırılacaktı."


translate turkish event_m_story2_afterdev_58bf02e5:


    "Üzerimdeki baskıdan tüylerim ürpermişti."


translate turkish event_m_story2_afterdev_c32e634f:



    voice "voice/kate/5day/015 mne.ogg"
    Kate "Ee?"


translate turkish event_m_story2_afterdev_610d45cf:



    voice "voice/Anton/5day/49 Ch2.ogg"
    Ant "Ne var?"


translate turkish event_m_story2_afterdev_45fad262:



    voice "voice/kate/5day/011 ti.ogg"
    Kate "Geri zekalı mısın?"


translate turkish event_m_story2_afterdev_cdc1a2b3:


    "Nihayet bana baktı. Onun o gudubet bakışlarını hiç özlememiştim."


translate turkish event_m_story2_afterdev_306e60d6:



    voice "voice/kate/5day/016 k.ogg"
    Kate "Dolaba kaysana optik."


translate turkish event_m_story2_afterdev_a82f4a02:


    "Sinirden nefesim kesildi."


translate turkish event_m_story2_afterdev_e9be34a6:


    "Bana ne cüretle \"optik\" der?"


translate turkish event_m_story2_afterdev_8179914a:


    "Hem de onca olaydan sonra..."


translate turkish event_m_story2_afterdev_cb11dc04:


    "Yanaklarım kıpkırmızı olsa da lafını dinledim."


translate turkish event_m_story2_afterdev_697dcc81:



    voice "voice/kate/5day/017 na.ogg"
    Kate "Yere bak."


translate turkish event_m_story2_afterdev_80164e43:



    voice "voice/Anton/5day/49 Ch.ogg"
    Ant "Ne var?"


translate turkish event_m_story2_afterdev_ce1aa1ec:



    voice "voice/kate/5day/018 na.ogg"
    Kate "Kirlenmiş."


translate turkish event_m_story2_afterdev_ae021562:



    voice "voice/Anton/5day/50 Ya.ogg"
    Ant "Temizlik sırası bende değil."


translate turkish event_m_story2_afterdev_9187fde8:



    voice "voice/kate/5day/019 eto.ogg"
    Kate "Leş gibi toynaklarınla kirletmişsin işte. Temizle!"


translate turkish event_m_story2_afterdev_d1ff0359:


    "Sınıftakilere bakmadan, onların da bize bakmadığını umarak yutkundum."


translate turkish event_m_story2_afterdev_c0e179e7:


    "Bu utanç verici gösteriyi izlemediklerini ümit ediyordum."


translate turkish event_m_story2_afterdev_d700fa59:



    voice "voice/Anton/5day/52 Hor.ogg"
    Ant "Pekala."


translate turkish event_m_story2_afterdev_66e693d0:


    "Gözlerimi Katya'ya dikip, sıramın altındaki küçük birikintiyi ayakkabımın tabanıyla sildim."


translate turkish event_m_story2_afterdev_246464d4:



    voice "voice/lydia/5day/04 ti.ogg"
    Lilia_P "Katya, ne dikiliyorsun?"


translate turkish event_m_story2_afterdev_34472f65:



    voice "voice/kate/5day/020 Lil.ogg"
    Kate "Öğretmenim! Öğretmenim! Petrov ortalığı batırmış!"


translate turkish event_m_story2_afterdev_d5f8911c:



    voice "voice/kate/5day/021 da.ogg"
    Kate "Tabii, tabii!"


translate turkish event_m_story2_afterdev_a772766d:



    voice "voice/kate/5day/022 vot.ogg"
    Kate "Temizlesin diye bekliyorum."


translate turkish event_m_story2_afterdev_325398e2:



    voice "voice/lydia/5day/05 pe.ogg"
    Lilia_P "Petrov, acele et lütfen. Derse başlamalıyız."


translate turkish event_m_story2_afterdev_b9f37c04:


    "Öfkeden patlayacaktım."


translate turkish event_m_story2_afterdev_73a3cada:


    "Dayanamayıp kinimi kustum."


translate turkish event_m_story2_afterdev_83113041:



    voice "voice/Anton/5day/53 Ser.ogg"
    Ant "Nereden çıktı bu ya? Niye temizliyormuşum?"


translate turkish event_m_story2_afterdev_ee6d168a:



    voice "voice/Anton/5day/54 Eto.ogg"
    Ant "Bana böyle mi teşekkür ediyorsun?"


translate turkish event_m_story2_afterdev_2fa398fa:


    "Katya'nın yüzü kızarsa da küstahça bakmaya devam etti."


translate turkish event_m_story2_afterdev_c22959f7:


    "Kendimi tutmayı bırakıp açtım ağzımı, yumdum gözümü. Lafımı esirgememiştim."


translate turkish event_m_story2_afterdev_79d6bb50:


    "Belki de bir aydır içimde biriken korkuyu daha fazla bastıramamıştım."


translate turkish event_m_story2_afterdev_44472747:


    "Yanımdaki sırayı itip eğildim ve gömleğimin bileğiyle yeri silmeye koyuldum."


translate turkish event_m_story2_afterdev_99e32ae8:



    voice "voice/Anton/5day/55 Chis.ogg"
    Ant "Nasıl, iyi mi böyle? Prenses hazretleri oturabilir mi artık?"


translate turkish event_m_story2_afterdev_012d5afb:



    voice "voice/kate/5day/023 pf.ogg"
    "Katya küstahça burnunu çekti."


translate turkish event_m_story2_afterdev_95dd6adc:



    voice "voice/kate/5day/023 cto.ogg"
    Kate "Evet. Aferin."


translate turkish event_m_story2_afterdev_5f8ab9a4:



    voice "voice/Anton/5day/56 Ks.ogg"
    Ant "Bu arada..."


translate turkish event_m_story2_afterdev_cd3ee2e5:



    voice "voice/Anton/5day/57 Sama.ogg"
    Ant "Bir dahakine imdadına yetişmem! Geri zekalı seni!"


