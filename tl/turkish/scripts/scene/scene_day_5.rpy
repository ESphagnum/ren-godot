    Childs "Yaşa be Petrov!"


translate turkish event_m_story2_afterdev_ba9599c4:



    voice "voice/kate/5day/40 Ura.ogg"
    Childs "Helal sana!"


translate turkish event_m_story2_afterdev_7a5b89da:


    "Liliya öğretmenimiz de gözlüğünü çıkarıp mendiliyle gözlerini sildi."


translate turkish event_m_story2_afterdev_01d35ef1:



    voice "voice/lydia/5day/13 St.ogg"
    Lilia_P "Çok mahcup oldum."


translate turkish event_m_story2_afterdev_673f7483:



    voice "voice/lydia/5day/14 Sv.ogg"
    Lilia_P "Katya hayal görüyor sanıyordum... Ancak hepsi gerçekmiş..."


translate turkish event_m_story2_afterdev_6cd2e490:



    voice "voice/lydia/5day/15 Pet.ogg"
    Lilia_P "Petrov, evladımı kurtardı. Ben ise onu müdürün odasına göndermeye kalkıştım..."


translate turkish event_m_story2_afterdev_b28063c7:



    voice "voice/tihonov/5day/32 Ot.ogg"
    Tikhonov "Çocuğun müdürle işi yok! Ancak onur listesine pek yakışır."


translate turkish event_m_story2_afterdev_0f7868f4:


    "O an fotoğrafımın onur listesine değil ancak duyuru panosuna, diğer kayıp çocukların hemen yanına asıldığını hayal ettim."


translate turkish event_m_story2_afterdev_504538b3:


    "Aklımdaki bu görüntü, üstün başarıma gölge düşürmüştü."


translate turkish event_m_story2_afterdev_5f096b94:


    "Dersten sonra Katya'nın alt kata inmesine yardımcı oldum. Dirseğinden tutup ona eşlik ederken değneklerini taşıdım."


translate turkish event_m_story2_afterdev_6e734674:


    "Okul bahçesinden birlikte çıktık."


translate turkish event_m_story2_afterdev_fcc82b01:



    voice "voice/kate/5day/41 Zna.ogg"
    Kate "İşin tuhafı ne biliyor musun?"


translate turkish event_m_story2_afterdev_fe99f1b4:



    voice "voice/kate/5day/42 Ya.ogg"
    Kate "Ayak parmaklarımı hâlâ hissedebiliyorum."


translate turkish event_m_story2_afterdev_a80fb6db:



    voice "voice/kate/5day/42 Eh.ogg"
    Kate "Aslında yoklar ama hislerim yerinde..."


translate turkish event_m_story2_afterdev_f5089fdf:



    voice "voice/Anton/5day/67 Bil.ogg"
    Ant "Keşke daha çabuk davranabilseydim..."


translate turkish event_m_story2_afterdev_640decaf:



    voice "voice/kate/5day/43 B.ogg"
    Kate "Deme öyle yahu. Süpermen bile olsa yetişemezdi."


translate turkish event_m_story2_afterdev_b3537bdf:



    voice "voice/kate/5day/44 T.ogg"
    Kate "Üsteğmenin dediğine göre şansım yaver gitmiş. Haklı da..."


translate turkish event_m_story2_afterdev_41de0bee:



    voice "voice/Polina/5day/45 s.ogg" 
    Pol "İyileşmene çok sevindim Katya."


translate turkish event_m_story2_afterdev_42a5ef55:


    "Polina gözlerini Katya'ya dikmiş, köşeden çıkıverdi."


translate turkish event_m_story2_afterdev_27735082:


    "Katya, sınıf arkadaşının dik bakışları karşısında gururla duruyordu."


translate turkish event_m_story2_afterdev_fb54b666:



    voice "voice/kate/5day/45 S.ogg"
    Kate "Sağ ol Polina."


translate turkish event_m_story2_afterdev_5560eaf7:



    voice "voice/kate/5day/46 E.ogg"
    Kate "Sen de sevgilin de var olun. O da pek yardımcı oldu."


translate turkish event_m_story2_afterdev_5840f8da:


    "Katya o an Romka'yla Polina'nın ilişkisini bana hatırlatmak ister gibiydi."


translate turkish event_m_story2_afterdev_2e34c55d:



    voice "voice/Polina/5day/46 Es.ogg"
    Pol "Pyatifanov'dan bahsediyorsan biz çıkmıyoruz. İyi çocuk ama..."


translate turkish event_m_story2_afterdev_308adca2:



    voice "voice/Polina/5day/47 Vi.ogg" 
    Pol "Siz ikiniz... bir yere mi gidiyorsunuz?"


translate turkish event_m_story2_afterdev_fd5a34fb:


    "Katya benden önce yanıt verdi."


translate turkish event_m_story2_afterdev_16e9240a:



    voice "voice/kate/5day/47 Ya.ogg"
    Kate "Hâlâ sakatım diye yanımdaki delikanlıyı beni eve geçirmeye ikna ettim."


translate turkish event_m_story2_afterdev_37a65f7a:



    voice "voice/kate/5day/48 Da.ogg"
    Kate "Tabii, tabii!"


translate turkish event_m_story2_afterdev_53009b32:


    "Çok tuhaf bir durumdu... "


translate turkish event_m_story2_afterdev_e3823326:



    voice "voice/Anton/5day/68 polin.ogg"
    Ant "Polina, dinle..."


translate turkish d5_polkatya_dev_205e6eb6:



    voice "voice/Polina/5day/48 Ya.ogg"
    Pol "Salak değiliz herhalde. Anlıyorum."


translate turkish d5_polkatya_dev_faceff7b:


    "Polina'nın gözlerinde anlık bir hüzün belirse de kaderine boyun eğercesine gülümsedi."


translate turkish d5_polkatya_dev_dc82d5d8:



    voice "voice/Polina/5day/49 Ti.ogg" 
    Pol "Tam bir beyefendisin. Dedemin dediği gibi, türünün son örneklerindensin."


translate turkish d5_polkatya_dev_4807d004:



    voice "voice/Polina/5day/50 Ne.ogg" 
    Pol "Her kıza nasip olmaz..."


translate turkish d5_polkatya_dev_0abfeff8:


    "Fırtına okul bahçesini karla örtüyordu."


translate turkish d5_polkatya_dev_9256156a:


    "Polina dönüp düşüncelere dalmış, endişeyle karanlığa bakıyordu."


translate turkish d5_polkatya_dev_6173c80e:



    voice "voice/kate/5day/49 Za.ogg"
    Kate "Mağdur triplerine girme. Bıktırıyorsun beni."


translate turkish d5_polkatya_dev_49e6aa3a:


    "Fısıldayarak söylediği bu cümleyi benden başka duyan olmamıştı."


translate turkish d5_polkatya_dev_aba416d3:



    voice "voice/kate/5day/51 T.ogg"
    Kate "Herkes ona acısın diye başımdan geçenleri seve seve göze alır."


translate turkish d5_polkatya_dev_2d4333e6:


    "Karanlıktan bir hışırtı koptu ve Julka okul bahçesinden fırladı."


translate turkish d5_polkatya_dev_606dafe2:



    voice "voice/kate/5day/52 oi.ogg"
    Kate "Köpeciğe bak!"


translate turkish d5_polkatya_dev_7d018b82:


    "Julka, Polina'yı fark edip hafiften hırladı."


translate turkish d5_polkatya_dev_6b5a6fa7:


    "Polina gözlerini kırptı. İki damla gözyaşı yanaklarından aşağı süzülürken donakaldı."


translate turkish d5_polkatya_dev_ae039e0f:



    voice "voice/Polina/5day/51 Ti.ogg" 
    Pol "O zaman beni eve geçirmeyeceksin herhalde."


translate turkish d5_polkatya_dev_0dc46ef8:


    "Julka yanıt verircesine havladı."


translate turkish d5_polkatya_dev_c24368ed:



    voice "voice/kate/5day/53 nu.ogg"
    Kate "Ee? Gidiyor muyuz?"


translate turkish d5_polkatya_dev_a5513a74:



    voice "voice/kate/5day/54 Pu.ogg"
    Kate "Bırak şu mızıkçıyı, eve tek başına gidebilir. Hava o kadar kararmadı."


translate turkish event_m_polina_devend_16fe57e4:


    "Bir anlığına Polina'ya bakıp Katya'ya döndüm."


translate turkish event_m_polina_devend_7fa5d009:


    "İkilemde kalmıştım."


translate turkish event_m_polina_devend_d5215e28:


    "O işkence odasından kaçmak kadar olmasa da karar vermesi zordu."


translate turkish event_m_polina_devend_88cea688:


    "Katya'yı üzmek istemiyordum. Ne var ki iki parmağını kaybetmiş olması, kişiliğinde bir fark yaratmamıştı."


translate turkish event_m_polina_devend_ff2dd467:


    "Hâlâ eskisi kadar çıkarcı biriydi."


translate turkish event_m_polina_devend_f3bbd593:



    voice "voice/Anton/5day/69 Kat.ogg"
    Ant "Katya, Polina'ya sözüm vardı..."


translate turkish event_m_polina_devend_914bc47e:



    voice "voice/kate/5day/54 no.ogg"
    Kate "İyi de..."


translate turkish event_m_polina_devend_222c53a5:



    voice "voice/Anton/5day/70 mi.ogg"
    Ant "Merak etme. Bir fikrim var."


translate turkish event_m_polina_devend_533c08c3:


    "Elimi kaldırdım."


translate turkish event_m_polina_devend_9f9d94d6:



    voice "voice/Anton/5day/71 Liliya.ogg"
    Ant "Liliya Öğretmenim!"


translate turkish event_m_polina_devend_9e2fdf12:


    "Öğretmenimiz pencereden baktı."


translate turkish event_m_polina_devend_559231b0:



    voice "voice/Anton/5day/72 ya.ogg"
    Ant "Katya'yı aşağıya indirdim. Eve de siz geçirir misiniz?"


translate turkish event_m_polina_devend_26ceccaa:



    voice "voice/lydia/5day/16 Kon.ogg"
    Lilia_P "Tabii! Geliyorum Katya'cığım, bekle."


translate turkish event_m_polina_devend_44cb4472:



    voice "voice/lydia/5day/17 Sp.ogg"
    Lilia_P "Yardımın için sağ ol Anton."


