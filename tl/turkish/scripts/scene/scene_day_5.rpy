translate turkish event_monsters_polina_special_31a11251:


    "Karanlığın arasından ağaçlar çıkagelmişti."


translate turkish event_monsters_polina_special_86d92175:


    "Ağaç kökleri ve dalları arasında daracık köy yolu kıvrıla kıvrıla uzanıyordu."


translate turkish event_monsters_polina_special_85e059b0:


    "Canımızdan olacağımız yer tam da burasıydı."


translate turkish event_monsters_polina_special_f728d07e:


    "Kardeşim birden taş gibi ağır gelmeye başlamıştı."


translate turkish event_monsters_polina_special_03d39039:


    "Ciğerlerim bu işkenceye daha fazla tahammül edemiyordu."


translate turkish event_monsters_polina_special_07c36276:


    "Koşmaya mecalimiz kalmamış, sallanarak yürüyorduk."


translate turkish event_monsters_polina_special_bc471dce:


    "Polina çaresizlikle mırıldanıyordu."


translate turkish event_monsters_polina_cross_1f55c296:


    "Ağaçlar iki yanımızdan hızla geçiyor, buz dikitlerine dönüşüyordu."


translate turkish event_monsters_polina_cross_bd86dec0:


    "Dallar, habis baykuşların ayakları gibi eğri büğrü bir hal almış, bizi yamuk pençeleriyle kör etmeye çalışıyorlardı."


translate turkish event_monsters_polina_cross_20dc5149:


    "Olya'nın eli yağa bulanmışçasına elimden kayıyordu."


translate turkish event_monsters_polina_cross_c0eca2dc:


    "Çok geçmeden orman patikasının sonuna vardık. Yüksek mi yüksek kar yığınlarının arasındaydık."


translate turkish event_monsters_polina_cross_43fbcc40:


    "Ayaklarımız buz tabakalarını kırıyor, karlara saplanıyordu. Yürürken bacaklarımızı olabildiğince kaldırmaya çalışıyorduk."


translate turkish event_monsters_polina_cross_9e555d32:


    "Kaslarım kasılıyordu. Nefesimiz tükenmişti."


translate turkish event_monsters_polina_cross_43bd14fd:


    "Ancak peşimizdeki o şey yorulmak bilmiyordu."


translate turkish event_monsters_polina_cross_1050abb3:



    voice "voice/olya/5day/20 ya.ogg"
    Oly "Ben daha fazla dayanamayacağım."


translate turkish event_monsters_polina_cross_22708c63:



    voice "voice/Anton/5day/261 Mi.ogg"
    Ant "Dayanmalıyız!"


translate turkish event_monsters_polina_cross_9b41e2d0:


    "Bunu söylediğim gibi bitkinlikten yüzüstü kapaklandım."


translate turkish event_monsters_polina_cross_20748dee:


    "Ağaçlığın bitmek bilmeyen soğuğu yüzümü yakmıştı."


translate turkish event_monsters_polina_cross_1b787926:


    "Korku ve acıdan gözlerimden yaşlar boşalıp yanağımda donakaldı."


translate turkish event_monsters_polina_cross_a4270a68:


    "Polina nefes nefese yanımda oturuyordu. Karanlığa dikkatle bakıyordu."


translate turkish event_monsters_polina_cross_2a01394b:


    "Onu korumak istiyordum ancak giderek gücünü yitiren elimi ona uzatmaktan başka bir şey yapamamıştım."


translate turkish event_monsters_polina_cross_8b6a39e6:


    "Aklıma gelen bir fikre çaresizce bel bağlayarak, evden aldığım siyah haçı çıkardım."


translate turkish event_monsters_polina_cross_5b11a86c:


    "Eski ve bayağı görünüyordu ancak haçın, \"Şeytan\" filmindeki gibi, kötülüğe karşı bir silah olduğuna kendimi zorla inandırdım."


translate turkish event_monsters_polina_cross_9aa8191f:


    "Bunca zaman peşimizden gelen Polina yanımdan fırlayıverdi."


translate turkish event_monsters_polina_cross_4016fccf:



    voice "voice/Polina/5day/200 B.ogg"
    Pol "Kes şunu! Çoktan geldiler."


translate turkish event_monsters_polina_cross_a644cd49:


    "Gölgeler kara ormanın iğrenç sirk hayvanları biçimini alarak bize yaklaşıyordu."


translate turkish event_monsters_polina_cross_8c5b5582:


    "Nefes nefese kalan Polina durup bana şaşkınlıkla baktı."


translate turkish event_monsters_polina_cross_d7ae154a:



    voice "voice/Polina/5day/201 Et.ogg"
    Pol "Boşa kürek çekiyoruz. Hepimiz burada son nefesimizi vereceğiz."


translate turkish event_monsters_polina_cross_2fa7d829:


    "Nenemin cenazesi aklıma geliverdi. Anlattığı masalları hatırladım. Yuvamızı davetsiz misafirlerden koruyan o haç gözümde canlandı."


translate turkish event_monsters_polina_cross_ae0ea94c:


    "Evimize kurt falan girmemişti. Hepsi bir kabustu."


translate turkish event_monsters_polina_cross_d7da1bcf:


    "Belki de..."


translate turkish event_monsters_polina_cross_2_3cedca58:


    "Baltayı bir kenara fırlatıp nenemin haçını karanlığa doğrulttum."


translate turkish event_monsters_polina_cross_2_0cf9a487:


    "Polina dehşet ve şaşkınlıkla bana bakıyordu."


translate turkish event_monsters_polina_cross_2_ecdc8931:



    voice "voice/Anton/5day/263 Pr.ogg"
    Ant "Defolun!"


translate turkish event_monsters_polina_cross_2_dee30937:


    "Karanlıktan alaycı bir uğultu koptu. Gölgeler giderek dibimize sokuluyordu."


translate turkish event_monsters_polina_cross_2_56413235:



    voice "voice/Anton/5day/264 Ya.ogg"
    Ant "Size emrediyorum!"


translate turkish event_monsters_polina_cross_2_a480f8b6:



    voice "voice/Polina/5day/202 bro.ogg" 
    Pol "Boş ver! Gidelim buradan!"


translate turkish event_monsters_polina_cross_2_4266a95f:


    "Polina'nın sesi hem çaresiz hem bıkkın gelmişti."


translate turkish event_monsters_polina_cross_2_16fe1f12:



    voice "voice/Polina/5day/203 os.ogg" 
    Pol "Görmüyor musun? İşe yaramıyor işte! Ölmek istemiyorum..."


translate turkish event_monsters_polina_cross_2_1837f05c:



    voice "voice/olya/5day/21 Ya.ogg"
    Oly "Ben de..."


translate turkish event_monsters_polina_cross_2_b808d942:


    "Beni bırakıp kaçmaya hazır bir tavırla titreyerek ayağa kalktı."


translate turkish event_monsters_polina_cross_3_b2c13ac2:


    "Kaçamayız... Vaktimiz tükendi..."


translate turkish event_monsters_polina_cross_3_d95123e8:


    "Bu canavarlara karşı yardıma, bir çeşit doğaüstü güce ihtiyacım vardı."


translate turkish event_monsters_polina_cross_3_f13eee66:


    "Gözlerimi yumup nenemi düşündüm. Sırtını bana dönmüş, köşedeki dini figürlerin altında dikiliyordu."


translate turkish event_monsters_polina_cross_3_3a39c49f:


    "Dua! Torununa karanlıkta kol gezen varlıkları nasıl savuşturacağını öğretmişti."


translate turkish event_monsters_polina_cross_3_68194437:


    "Kuruyan dudaklarımı araladım."


translate turkish event_monsters_polina_cross_3_f98103c1:


    "Saçma bir düşünceydi ancak..."


translate turkish event_monsters_polina_cross_3_5d923444:



    voice "voice/Anton/5day/265 Na.ogg"
    Ant "Masmavi sulardaki Buyan adasında, ahşap bir kulübe var solgun güneşin altında..."


translate turkish event_monsters_polina_cross_3_b957b4af:


    "Sonrası nasıldı?"


translate turkish event_monsters_polina_cross_3_621cacdb:


    "Polina kuşkuyla bana bakıyordu."


translate turkish event_monsters_polina_cross_3_d2db0968:



    voice "voice/Anton/5day/266 V.ogg"
    Ant "İçinde ağarmış saçlar ve domuz yağı..."


translate turkish event_monsters_polina_cross_3_f41e3be4:


    "Ağzımdan çıkan her kelimeyle buz gibi zeminde iyice doğrulup başımı kaldırıyordum."


translate turkish event_monsters_polina_cross_3_080bdde5:



    voice "voice/Anton/5day/267 V.ogg"
    Ant "İninden çıkan iblisin dölü yiyip doymalı, ki Tanrı'nın sadık kulu Anton'u rahat bırakmalı."


translate turkish event_monsters_polina_cross_3_155538fa:


    "Donakalan arkadaşıma aldırış etmeden, neredeyse bağırarak duanın son sözlerini okudum."


translate turkish event_monsters_polina_cross_3_85c85d52:



    voice "voice/Anton/5day/268 B.ogg"
    Ant "Evimizden uzak dura her türlü musibet!"


translate turkish event_monsters_polina_cross_3_4fb9fd81:


    "Olya da haykırışlarıma bir feryatla eşlik etti."


translate turkish event_monsters_polina_cross_3_61454c61:


    "Kapkara kabus gibi baykuş pençeleri kardeşimi karlı hiçliğe doğru sürükledi."


translate turkish event_monsters_polina_cross_3_e0f803d9:


    "Polina'nın çabalarına rağmen Olya gözden kayboluvermişti."


translate turkish event_monsters_polina_cross_3_71eb7dbd:


    voice "voice/anton/5day/08 Vd.ogg"


translate turkish event_monsters_polina_cross_3_a848ca7a:


    "Bunlar gerçek olamazdı. Aklım bana oyun oynuyor olmalıydı. Deliriyordum herhalde."


translate turkish event_monsters_polina_cross_3_3d7b6f2b:


    "Olya'cığım pek tabii hayattaydı. Annem ve babamla odadaydı. Buz gibi gecenin ortasında kaybolmuş veya canından olmuş değildi."


translate turkish event_monsters_polina_cross_3_10b9b3f8:



    voice "voice/Polina/5day/204 ant.ogg" 
    Pol "Anton! Olya'yı kaybetmiştik."


translate turkish event_monsters_polina_cross_3_6bc3e3d0:



    voice "voice/anton/5day/13 hnik.ogg"
    "Yanağımdan bir damla gözyaşı süzüldü. Artık ne yorgunluğum ne de giderek yaklaşan ölüm umurumdaydı."


translate turkish event_monsters_polina_cross_3_d3acea65:



    voice "voice/Anton/5day/269 ne.ogg"
    Ant "Olamaz, olamaz... Hiçbiri gerçek değil!"


translate turkish event_monsters_polina_cross_3_6dbee9c3:



    voice "voice/Anton/5day/270 Ol.ogg"
    Ant "Olya hayatta. Bizi korkutmaya çalışıyorlar."


translate turkish event_monsters_polina_cross_3_7fe1d707:


    "Maalesef hepsi benim suçumdu. Planım işe yaramamıştı. Olya'yı kaybetmiştik."


translate turkish event_monsters_polina_cross_3_3d2aa244:


    "Kaçmalı, canımı kurtarmalı, anneme ulaşmalıydım. Ona Olya'nın ışığının söndüğünü söylemeliydim."


translate turkish event_monsters_polina_cross_3_182bf39a:


    "Yoksa mucizelere bel bağlayacak, duanın son sözlerini sayıklayıp duracaktım."


translate turkish event_monsters_polina_cross_3_c978fd9b:


    "Polina feryatlara boğularak az öteme düştü."


translate turkish event_monsters_polina_cross_3_e4f9b99e:


    "Bu karanlıktan kurtuluş yolu görünmüyordu. Yine de karar vermeliydim."


translate turkish event_monsters_polina_amulet_3d735a73:


    "Rampadan aşağı kayarken bir kement boynumu sımsıkı kavrayıp korku dolu kaçışıma engel oldu."


translate turkish event_monsters_polina_amulet_9d1bd76d:


    "Çat diye duruverince Olya da bana çarpıp karlara kapaklandı. Yerden birkaç santim yüksekte asılı kalmıştım."


translate turkish event_monsters_polina_amulet_3eeb9f9b:



    voice "voice/anton/5day/262 kr.ogg"
    "Polina'nın tılsımının ipi, eğri büğrü bir dala takılıp benimle resmen adam asmaca oynamıştı."


translate turkish event_monsters_polina_amulet_1642a001:


    "Balta ellerimden düşüp karlara gömüldü."


translate turkish event_monsters_polina_amulet_32ddf3f2:


    "Bu korkunç şey bana tuzak mı kurmuştu?"


translate turkish event_monsters_polina_amulet_941e008b:


    "Tılsımı koparıp atmak için boynumu kanatana kadar debelendim."


translate turkish event_monsters_polina_amulet_d032f338:


    "Onca çabama rağmen ağaç beni sanki yavaş yavaş tepesine çekiyordu."


translate turkish event_monsters_polina_amulet_5ee7699f:


    "Havada kıvranıyor, parmaklarımı araya sokup kendimi ipten almaya çalışıyordum."


translate turkish event_monsters_polina_amulet_af4af5e2:


    "Ancak boşa kürek çekiyordum."


translate turkish event_monsters_polina_amulet_5fa4961e:


    "Ayağımın altındaki karlar gıcırdıyordu. Dudaklarımdan şiddetli bir inilti koptu."


translate turkish event_monsters_polina_amulet_33b1aef8:


    "Asılı olduğum yerden birkaç manevra daha yapmayı denedim ancak daldan kurtulamadım."


translate turkish event_monsters_polina_amulet_a75fcbd4:


    "İyice havasız kalıyordum. Gözüm giderek kararıyordu."


translate turkish event_monsters_polina_amulet_304865e6:


    "Ne var ki Polina yetişip beni var gücüyle itti. İp etime gömülmüş, boğazımı sıkıyordu."


translate turkish event_monsters_polina_amulet_a9fabff9:


    "Dal çatırdayıp nihayet bizi bıraktı. Kendimizi feryatlara boğulan Olya'nın kollarında buluverdik."


translate turkish event_monsters_polina_amulet_7615ecba:


    "Keskin siciminden kurtulduğum tılsım, kırık dalın ucunda asılı kalmıştı."


translate turkish event_monsters_polina_amulet_11f6748f:


    "Bu uğursuz hediye canıma mı kastetmişti? Yoksa beni uyarmaya mı çalışmıştı?"


translate turkish event_monsters_polina_amulet_04a293c7:



    voice "voice/Polina/5day/233 Sk.ogg" 
    Pol "Hadi! Yaklaştılar."


translate turkish event_monsters_polina_amulet_b87f800e:


    "Kemancı kız ağaçlığın derinlerine kaptırırken ben, gözleri yaşlı Olya'dan güç alarak doğrulmaya çalışıyordum."


translate turkish event_monsters_polina_amulet_e27f15fd:


    "Kırık dalın ucunda sallanan o pençe, resmen kendisinden yardım almamı istiyordu."


translate turkish event_monsters_polina_amulet_6fc28d4e:


    "Bu kovalamaca esnasında zihnimde, hızla yaklaşan ecelime dair çirkin düşünceler peyda olmuştu."


translate turkish event_monsters_polina_amulet_676bfe7b:


    "Tılsım hayatımı kurtarabilir miydi?"


translate turkish event_monsters_polina_amulet_2f7a6301:



    voice "voice/olya/5day/26 To.ogg"
    Oly "Toşa, korkuyorum..."


translate turkish event_monsters_polina_amulet_4de3167f:


    "Canım kardeşimin hayatını kurtarabilir miydi?"


translate turkish event_monsters_polina_amulet_47eaf14e:


    "Arkamı döndüm."


translate turkish event_monsters_polina_amulet_b0cd796a:


    "Etrafımızı kuşatan yırtıcıların çirkin kahkahaları birkaç adım ötemizden yükselip karanlık ormanda yankılanıyordu."


translate turkish event_monsters_polina_amulet_8ccd60b1:


    "Bu gudubet yaratıklar istedikleri an canımızı alabilirdi."


translate turkish event_monsters_polina_amulet_77afe596:


    "Ancak ağırdan alıyor, bizimle resmen oyun oynuyorlardı."


translate turkish event_monsters_polina_amulet_0baaae17:


    "Canımızı kurtarmaya yönelik nafile çabalarımız, giderek artan telaşımız ve çaresizliğimiz onları eğlendiriyor olmalıydı."


translate turkish event_monsters_polina_amulet_10017e9e:


    "Tılsımın sahibine el sürmekten çekinirler miydi acaba?"


translate turkish event_monsters_polina_amulet_85fbb826:


    "Ya oyunun kurallarını ve eninde sonunda yakalanacağımızı kabullenip kaçmaya devam edecektik..."


translate turkish event_monsters_polina_amulet_94f1f7db:


    "... Rüzgarda sallanan o uğursuz tılsıma bir kez daha baktım..."


translate turkish event_monsters_polina_amulet_9629c7c5:


    "Ya da bu şaman ıvır zıvırına birimiz bel bağlayacaktık."


translate turkish event_monsters_polina_amulet_eb513222:


    "Diğerleriyse muhtemelen ölecekti."


translate turkish d5_choice_polya_olya_67ce2161:


    ""


translate turkish event_runaway_girlstrapped_roma_olya_646b0d02:


    "Baltayı bırakıp diz üstü çöktüm. Uyuşuk parmaklarımla Olya'nın koltuk altlarına yapıştım."


translate turkish event_runaway_girlstrapped_roma_olya_485f3045:


    "Tek yanlış hareketimle karların arasına gömülebilirdim."


translate turkish event_runaway_girlstrapped_roma_olya_34369d3c:


    "Kardeşimi kurtaracak kimse de kalmazdı."


translate turkish event_runaway_girlstrapped_roma_olya_ba9ec7eb:



    voice "voice/anton/5day/184.der.ogg"
    Ant "Dayan Olya!"


translate turkish event_runaway_girlstrapped_roma_olya_84d3ffbf:


    "Romka da Polina'nın imdadına yetişip koltuk altlarından tuttu ve var gücüyle onu kurtarmaya çalıştı."


translate turkish event_runaway_girlstrapped_roma_olya_492f5292:



    voice "voice/romka/5day/266 ya.ogg" 
    Rom "Geldim!"


translate turkish event_runaway_girlstrapped_roma_olya_a8c2173f:


    "Yangın manzarası eşliğinde yaratıklar bize doğru koşuyordu. Gölgeleri upuzun halılar gibi yere serilmişti."


translate turkish event_runaway_girlstrapped_roma_olya_21613bd0:


    "Karlı çukurda kıvranan Olya da Polina da cıyaklıyordu."


translate turkish event_runaway_girlstrapped_roma_olya_cf53ab0e:



    voice "voice/anton/5day/33 br.ogg"
    "İçimdeki ses {i}\"Bırak onu, kaç hadi uzun kulak!\"{/i} diyordu."


translate turkish event_runaway_girlstrapped_roma_olya_f88a2174:


    "Haykırarak Olya'yı kurtardım. O sırada Romka da Polina'yı doğrulttu."


translate turkish event_runaway_girlstrapped_roma_olya_d1744ccb:



    voice "voice/olya/5day/65 Pro.ogg"
    Oly "Özür dilerim. Ahududuları düşünecektim..."


translate turkish event_runaway_girlstrapped_roma_olya_17244b77:



    voice "voice/anton/5day/186.Niche.ogg"
    Ant "Geçti gitti abiciğim."


translate turkish event_runaway_girlstrapped_roma_olya_90d89232:


    "Hayvan sürüsü arayı kapatıyordu. Açlığı gözlerinden okunuyordu."


translate turkish event_runaway_girlstrapped_roma_olya_ede300f9:



    voice "voice/romka/5day/303 bir.ogg" 
    Rom "Çabuk! Baltayı al da fırlayalım!"


translate turkish event_runaway_girlstrapped_roma_olya_8cede4a5:


    "Rüzgar sırtlarımızı tartaklıyordu."


translate turkish event_runaway_girlstrapped_roma_olya_6477ff1c:


    "Yürek dağlayan uğultular giderek yaklaşıyordu."


translate turkish event_runaway_girlstrapped_roma_polina_7ab37cf0:


    "Baltayı bırakıp diz üstü çöktüm. Uyuşuk parmaklarımla Polina'nın koltuk altlarına yapıştım."


translate turkish event_runaway_girlstrapped_roma_polina_cc9320b5:


    "Tek yanlış hareketimle karların arasına gömülebilirdim."


translate turkish event_runaway_girlstrapped_roma_polina_7ecbfe4e:


    "Arkadaşımı kurtaracak kimse de kalmazdı."


translate turkish event_runaway_girlstrapped_roma_polina_31750585:



    voice "voice/anton/5day/188.De.ogg"
    Ant "Dayan Polina!"


translate turkish event_runaway_girlstrapped_roma_polina_76c70620:


    "Polina'nın kabanını sımsıkı tutmuştum ancak kendisinde bir hafiflik vardı."


translate turkish event_runaway_girlstrapped_roma_polina_642892f1:


    "Tam o sırada Polina'nın ardından Romka'nın yardım ettiğini fark ettim."


translate turkish event_runaway_girlstrapped_roma_polina_5257b746:



    voice "voice/romka/5day/266 ya2.ogg" 
    Rom "Geldim!"


translate turkish event_runaway_girlstrapped_roma_polina_a93a1dcf:


    "O zaman kardeşime kim yardım ediyordu ki?"


translate turkish event_runaway_girlstrapped_roma_polina_3719bc86:


    "Olya'nın çığlığını duyduğum an korkunç gerçeklikle yüzleştim."


translate turkish event_runaway_girlstrapped_roma_polina_493ef77f:



    voice "voice/olya/5day/35 To.ogg"
    Oly "Toooşaaa!"


translate turkish event_runaway_girlstrapped_roma_polina_958d449a:



    voice "voice/anton/5day/190.Olya.ogg"
    Ant "Olya!"


translate turkish event_runaway_girlstrapped_roma_polina_c0896c68:


    "Aç karaltılar onu çukurdan çıkarıp zifiri karanlığa sürüklüyordu. Az sonrasında çatır çutur sesler yükseldi."


translate turkish event_runaway_girlstrapped_roma_polina_46c6e3d9:


    "Kardeşimin ölümüne neden olacak bir karar vermiştim. Annemle babamın güvenini de boşa çıkarmıştım."


translate turkish event_runaway_girlstrapped_roma_polina_555c76dd:


    "Ailemin mutluluğuna dair son umudumu kendi ellerimle ziyan etmiştim."


translate turkish event_runaway_girlstrapped_roma_polina_581b0f8b:


    "Romka, Polina'yı içinde bulunduğu durumdan kurtardı ve omuzuma asıldı."


translate turkish event_runaway_girlstrapped_roma_polina_f8594fad:



