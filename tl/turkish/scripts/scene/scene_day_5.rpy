translate turkish event_medicated_zhulka_4dc924b5:



    voice "voice/Anton/5day/16 Pa.ogg"
    Ant "İyi de baba!.."


translate turkish event_medicated_zhulka_010e8c1c:



    voice "voice/father/day5/23 To.ogg"
