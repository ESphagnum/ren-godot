translate turkish d5_ending_nightmare_687849be:


    "Kaslarımı kasıp zıpladım."


translate turkish d5_ending_nightmare_14b70874:


    "Ayağım yerden kesildi. Havaya uçup ağzımı açtım."


translate turkish d5_ending_nightmare_f4dce51d:


    "Aya giderek yaklaşıyordum."


translate turkish d5_ending_nightmare_1a1e7a78:


    "Hayvan dostlarım ufacık kalmıştı..."


translate turkish d5_ending_nightmare_be168cc7:


    "Ayini tamamlamak için aşağıya inmemi bekliyorlardı."


translate turkish d5_ending_past_dd3da380:


    "Üçümüz de kıvrımlı mezarlık yolundaki sis perdesini aralayarak koşuyorduk."


translate turkish d5_ending_past_4278f651:


    "Aç canavarlar her an üstümüze atılabilirdi."


translate turkish d5_ending_past_f1e1f8f3:


    "Haçların gölgeleri patikaya düşüyordu."


translate turkish d5_ending_past_6dbce6b9:


    "Ardımızdan sağır edici bir uğultu koptu."


translate turkish d5_ending_past_472a57f1:



    voice "voice/Polina/5day/229 ro.ogg" 
    Pol "Roma!"


translate turkish d5_ending_past_0272f77b:


