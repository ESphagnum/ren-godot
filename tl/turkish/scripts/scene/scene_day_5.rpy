    Bya "Yok! E-e-eve gitmek istiyorum!"


translate turkish d5_ending_genius_aftertitles_8d224019:



    voice "voice/anton/Adult/70 Ne.ogg"
    Ant "Kötülükten korkmam!"


translate turkish d5_ending_genius_aftertitles_026e868e:



    voice "voice/byasha/5day/79s.ogg"
    Bya "Anneciğim, korkuyorum!"


translate turkish d5_ending_genius_aftertitles_cca5be34:



    voice "voice/anton/Adult/71 T.ogg"
    Ant "Çünkü sen benimlesin. Çomağın, değneğin güven verir bana!"


translate turkish d5_ending_genius_aftertitles_bf813931:


    "İnsanın içini dağlayarak kıvranıp inildeyen Byaşa'yı sürüklediğimi gören Polina gözyaşlarına boğuldu."


translate turkish d5_ending_genius_aftertitles_de44464e:



    voice "voice/byasha/5day/80b.ogg"
    Bya "Allah'ım yardım et!"


translate turkish d5_ending_genius_aftertitles_0e3c129f:



    voice "voice/anton/Adult/72 K.ogg"
    Ant "Kime dua ediyorsun şeytan?"


translate turkish d5_ending_genius_aftertitles_59ba6332:



    voice "voice/anton/Adult/121 Pol.ogg"
    Ant "İzle Polina! "


translate turkish d5_ending_genius_aftertitles_c49ffbbc:



    voice "voice/anton/Adult/122 Smotry.ogg"
    Ant "Ağlama. Şeytanın helak oluşunu izle!"


translate turkish d5_ending_genius_aftertitles_b49d1a79:


    "Sözlerimi duyunca doğruldu."


translate turkish d5_ending_genius_aftertitles_2a74b873:



    voice "voice/Polina/5day/274 Da.ogg"
    Pol "Evet. İzliyorum."


translate turkish d5_ending_genius_aftertitles_d782fbd0:



    voice "voice/anton/Adult/74 M.ogg"
    Ant "Ürkekliğin sonu cehennem azabı."


translate turkish d5_ending_genius_aftertitles_bf5dc4fc:



    voice "voice/Polina/5day/275 V.ogg" 
    Pol "Sonsuz işkence."


translate turkish d5_ending_genius_aftertitles_8443d4c7:



    voice "voice/anton/Adult/75 Am.ogg"
    Ant "Amin."


translate turkish d5_ending_genius_aftertitles_807bb854:


    "Byaşa'yı garaja fırlattım."


translate turkish d5_ending_genius_aftertitles_840d3777:


    "Flüt ve etrafa saçılan maskeler, yani yeni bir yaratık neslinin yüzleri karda öylece duruyordu."


translate turkish d5_ending_genius_aftertitles_8cf9170a:


    "Polina hepsini toplayıp karanlık kapı eşiğinden içeri fırlattı."


translate turkish d5_ending_genius_aftertitles_aa0ea41b:



    voice "voice/byasha/5day/82 po.ogg"
    Bya "Acıyın bana he!"


translate turkish d5_ending_genius_aftertitles_7d651c54:



    voice "voice/byasha/5day/83e.ogg"
    Bya "Benim ya, Byaşaaa!"


translate turkish d5_ending_genius_aftertitles_9d104228:



    voice "voice/byasha/5day/84ya.ogg"
    Bya "Ç-ç-çok hastayım he!"


translate turkish d5_ending_genius_aftertitles_f80792ee:



    voice "voice/anton/Adult/77 E.ogg"
    Ant "Rabb'im, sen onu selamete erdir."


translate turkish d5_ending_genius_aftertitles_fa157c60:


    "Polina'nın elindeki ikinci bidonu alıp garajın her yerine benzin döktüm."


translate turkish d5_ending_genius_aftertitles_0eaa1052:


    "Vücudumun her köşesinde o ilahi varlığın korumasını hissediyordum. Elbette Polina da öyle."


translate turkish d5_ending_genius_aftertitles_62c19461:


    "Aynı anda birer kibrit çakıp benzin birikintisine fırlattık."


translate turkish d5_ending_genius_aftertitles_5bb77728:


    "Garaj saniyeler içinde alevlere gömüldü. Muhafız, bize rehberlik ederek fani düşmanımızı küle çevirmişti."


translate turkish d5_ending_genius_aftertitles_aa5359f4:


    "Byaşa ateşler içinde acıyla bağırıyordu."


translate turkish d5_ending_genius_aftertitles_68dc08b1:


    "Feryatlarını duyan Polina ürpermişti. İstemsizce kapının kızgın koluna uzandı."


translate turkish d5_ending_genius_aftertitles_684582ea:


    "Koluna yapışıp gözlerinin içine anlamlı anlamlı baktım."


translate turkish d5_ending_genius_aftertitles_97329f96:



    voice "voice/anton/Adult/78 B.ogg"
    Ant "Byaşa çoktan öldü. Onu kimse kurtaramaz. Kurtulmak da istemiyordu."


translate turkish d5_ending_genius_aftertitles_43d59857:



    voice "voice/anton/Adult/79 Ti.ogg"
    Ant "Biçim değiştiren o hayvanların neler yapabildiğini biliyorsun."


translate turkish d5_ending_genius_aftertitles_3253651d:



    voice "voice/Polina/5day/277 Z.ogg" 
    Pol "Biliyorum."


translate turkish d5_ending_genius_aftertitles_85d2a54a:



    voice "voice/Polina/5day/278 Du.ogg" 
    Pol "Sence Byaşa cidden de?.."


translate turkish d5_ending_genius_aftertitles_0af05e2a:


    "Cümlesini tamamlamadan sesi kısıldı."


translate turkish d5_ending_genius_aftertitles_45e50e21:


    "Fırına dönen garajdan Byaşa'nın iniltileri geliyordu."


translate turkish d5_ending_genius_aftertitles_f3c91bba:



    voice "voice/anton/Adult/80 e.ogg"
    Ant "Şeytan can çekişiyor."


translate turkish d5_ending_genius_aftertitles_5fde9973:



    voice "voice/anton/Adult/81 Ag.ogg"
    Ant "Izdırabını duyuyor musun?"


translate turkish d5_ending_genius_aftertitles_6f527339:



    voice "voice/Polina/5day/279 Da.ogg"
    Pol "Evet. Hayata tutunmaya çalışıyor."


translate turkish d5_ending_genius_aftertitles_c6205ea0:



    voice "voice/anton/Adult/82 No.ogg"
    Ant "Muhafız onu azat etmez."


translate turkish d5_ending_genius_aftertitles_0ca4d735:



    voice "voice/Polina/5day/280 A.ogg" 
    Pol "Arkamızdaki melek."


translate turkish d5_ending_genius_aftertitles_aba10499:


    "Yoldaşımın azmi yerine gelmişti. Benim de imanım kuvvetlenmişti."


translate turkish d5_ending_genius_aftertitles_9b07250e:



    voice "voice/anton/Adult/83 Li.ogg"
    Ant "Pek esrarengiz, pek mağrur. Gözlerindeki ışık pek kuvvetli."


translate turkish d5_ending_genius_aftertitles_378b3ea8:


    "Polina elimi tutmuştu. Parmaklarımı sıkabildiğim kadar sıktım."


translate turkish d5_ending_genius_aftertitles_447226db:


    "Kocaman bir alevin karşısında dikiliyorduk. Gölgelerimiz karları eritiyordu."


translate turkish d5_ending_genius_aftertitles_1592cc02:



    voice "voice/Polina/5day/281 Mir.ogg"
    Pol "Dünya kurtuldu. Canilerin kökünü kazıdık."


translate turkish d5_ending_genius_aftertitles_6292c63c:



    voice "voice/anton/Adult/84 M.ogg"
    Ant "Doğru olanı yaptık."


translate turkish d5_ending_genius_aftertitles_ba4311d9:



    voice "voice/anton/Adult/85 X.ogg"
    Ant "Muhafız zihnimizde temiz bir sayfa açacak."


translate turkish d5_ending_genius_aftertitles_bd24965e:



    voice "voice/Polina/5day/282 A.ogg" 
    Pol "O zaman..."


translate turkish d5_ending_genius_aftertitles_3bc56b09:



    voice "voice/Polina/5day/283 M.ogg" 
    Pol "Her şeyi... unutacak mıyız? Birbirimizi de unutmayalım?"


translate turkish d5_ending_genius_aftertitles_2225a88f:



    voice "voice/anton/Adult/86 Ya.ogg"
    Ant "Seni kaybetmeyeceğim."


translate turkish d5_ending_genius_aftertitles_b0e65639:


    "Garajın alevler püsküren kapısı anbean mahvoluyor, küller ve çığlıklar giderek diniyordu."


translate turkish d5_ending_genius_aftertitles_a771660f:


    "Duvarları, çatısı bükülüyordu."


translate turkish d5_ending_genius_aftertitles_3156b4f5:


    "Dönüp bakmaya cesaretimi topladığımda, ağaçların arasındaki dev suret kaybolmuştu."


translate turkish d5_ending_genius_aftertitles_4b59b99b:


    "Tıpkı lanetli köydeki çocuklar gibi..."


translate turkish d5_ending_genius_aftertitles_400bc189:


    "Hatta Byaşa'ymış gibi davranan keçi..."


translate turkish d5_ending_genius_aftertitles_bb9caa40:


    "... ve unutmak üzere olduğumuz anılarımız gibi."


translate turkish d5_ending_genius_aftertitles_cca847e6:


    "Çığlıklar nihayet sustu."


translate turkish d5_ending_genius_aftertitles_d8c5ff4c:


    "Ateşe bakarken alt dudağımı öyle sert ısırdım ki kanadı. Sebebiyse kulaklarda yankılanan sessizlikte, zihnimde beliren soruydu."


translate turkish d5_ending_genius_aftertitles_b293166e:


    "Polina'ya da kendi deliliğimi bulaştıracak kadar aklımı kaçırmış olabilir miydim?"


translate turkish d5_ending_genius_aftertitles_505768b8:


    "Melek gerçekten var mıydı?"


translate turkish d5_ending_genius_aftertitles_547a2985:


    "Yoksa korkunç bir hastalıktan muzdarip olup ilaçlarını içmeyi bırakan bir genç mi vardı sadece?"


translate turkish d5_ending_genius_aftertitles_7a581459:


    "Belki de o yaratık, ilacı bıraktığından beri kendisiyle konuşuyordur."


translate turkish d5_ending_genius_aftertitles_467cd620:


    "Ormandaki değil, hasta zihninin derinliklerindeki."


translate turkish d5_ending_genius_aftertitles_e17131b5:


    "Şizofren miydim yoksa? Akli dengem yerinde değildi... Peki ya melekler neredeydi?"


translate turkish d5_ending_genius_aftertitles_32b97c80:


    "Biz ne yapmıştık?"


translate turkish d5_ending_genius_aftertitles_2e61c4da:


    "Beynimde bir patlama yaşanmıştı sanki. Gözlerimi açtığımda, yabancı bir kadının birkaç metre ötesinde, karlarda yatıyordum."


translate turkish d5_ending_genius_aftertitles_007fd5b5:


    "Etrafımızı saran çamlar, masmavi gökyüzüne uzanıyordu ancak hiç korkunç bir manzara değildi."


translate turkish d5_ending_genius_aftertitles_b618e9f6:


    "Buraya nasıl geldiğimi bilmediğimden sıkıntı da hissetmemiştim."


translate turkish d5_ending_genius_aftertitles_11508d0b:


    "Tek merak ettiğim, kadının yaşayıp yaşamadığıydı. Çok geçmeden o da kıpırdayıp gözlerini açtı."


translate turkish d5_ending_genius_aftertitles_0e1a5a34:


    voice "voice/Polina/5day/07 pr1.ogg" 


translate turkish d5_ending_genius_aftertitles_c9268efb:


    "Hiç bu kadar büyüleyici gözler görmemiştim. Yüzü de bir o kadar güzeldi."


translate turkish d5_ending_genius_aftertitles_37274059:



    voice "voice/Polina/5day/07 pr3.ogg" 
    "Şaşkınlıkla bana baktı."


translate turkish d5_ending_genius_aftertitles_5d9e05a8:


    "Ani bir istekle elimi uzattım. Kadın da bir an tereddüt etse bile aynı şekilde karşılık verdi."


translate turkish d5_ending_genius_aftertitles_d8663afe:


    "Parmaklarımız birbirine kavuştu. Vücuduma yayılan sıcaklığın etkisiyle gülümsedim."


translate turkish d5_ending_genius_aftertitles_6ccc6a6d:



    voice "voice/Polina/5day/07 p4.ogg" 
    "Kadın da bana gülümsedi."


translate turkish d5_ending_recipe_dfabe4aa:


    "Balta havada savrulup yere, maskenin yakınına bir darbe indirdi."


translate turkish d5_ending_recipe_36a15e2f:


    "O darbe geçmişimin gölgesini paramparça etmişti."


translate turkish d5_ending_recipe_c42c1f00:


    "Bunca zamandır kendimi kandırıyordum."


translate turkish d5_ending_recipe_7d2daaaa:


    "Kendimden çekiniyordum."


translate turkish d5_ending_recipe_6d03e973:


    "Annemle babam muhtemelen inadım yüzünden ölmüştü. Olya da bu yüzden ölümün eşiğinden dönmüştü."


translate turkish d5_ending_recipe_f9ead611:



    voice "voice/Anton/5day/11 A.ogg"
    Ant_m "Alisa haklıydı. İnsanların arasında da makus kaderi hak eden yaratıklar vardı."


translate turkish d5_ending_recipe_14b3fd52:



    voice "voice/Anton/5day/12 U.ogg"
    Ant_m "O kader de ormanda bizim gibi birileriyle karşılaşmaktı."


translate turkish d5_ending_recipe_cbbf40e8:



    voice "voice/Anton/5day/13 E.ogg"
    Ant_m "Tabutu boylayan nenelerin öğrettiği saçma dualar sayesinde korunamazlardı."


translate turkish d5_ending_recipe_eb3b5749:



    voice "voice/Anton/5day/14 Eh.ogg"
    Ant_m "Babamın inandığı yüce varlık da onları kurtaramazdı."


translate turkish d5_ending_recipe_ac056344:



    voice "voice/Anton/5day/15 Z.ogg"
    Ant_m "Buradaki tek yüce varlık, sürünün ta kendisi."


translate turkish d5_ending_recipe_cd01e4d8:



    voice "voice/Anton/5day/16 E.ogg"
    Ant_m "Ben de o sürünün bir parçasıydım."


translate turkish d5_ending_recipe_b85773ce:


    "Uyuşan parmaklarımla maskeye uzandım."


translate turkish d5_ending_recipe_0ac8eea9:


    "İşte..."


translate turkish d5_ending_recipe_3dd006f2:


    "Kadim mi kadim maskeye dokundum."


translate turkish d5_ending_recipe_abd9f451:


    "Dünyanın küllerinden biten çamlardan da eskiydi."


translate turkish d5_ending_recipe_3ca3e569:


    "Mezarlarda kıvranan yaratıklardan da yaşlıydı."


translate turkish d5_ending_recipe_5588ee3f:



    voice "voice/anton/5day/46 ho.ogg"
    Ant_m "Güzel..."


translate turkish d5_ending_recipe_12b30aed:


    "Uzun kulaklı maskenin göz deliklerinden Alisa'nın iki bulanık suretini görüyordum. Eski hayatıma veda etme fırsatım olmamıştı."


translate turkish d5_ending_recipe_be1e83c9:



    voice "voice/Alisa/5day/01 poc A.ogg" 
    Alis "Hisset."


translate turkish d5_ending_recipe_c1b57016:


    "Maske tenime değdi."


translate turkish d5_ending_recipe_57bc45bd:


    "Yüzümü kaynar suya sokmuşum gibi hissetmiştim ancak her nasılsa pek hoştu..."


translate turkish d5_ending_recipe_6d310c73:


    Ant_m "Toprak kokusu vücuduma doluşmuştu."


translate turkish d5_ending_recipe_c7b23af7:


    Ant_m "Karlı kırda tavşan ayak izleri görüyordum, adım adım ormana doğru uzanıyordu."


translate turkish d5_ending_recipe_7995d572:


    Ant_m "Titrek kalbimden fışkırıp birbirine dolanan, kıpırdayıp duran köklere tanık olmuştum."


translate turkish d5_ending_recipe_136119c5:


    Ant_m "Kızgın gökte asılı duran aya uzanan bir merdiveni andıran kapkara dalları fark etmiştim."


translate turkish d5_ending_recipe_9545e3f8:


    Ant_m "Postuma düşen kar taneleri eriyordu."


translate turkish d5_ending_recipe_9ecd0492:


    Ant_m "Tüylerimin dibi pirelerle doluydu. Arka ayağımla kaşınmak istiyordum."


translate turkish d5_ending_recipe_a0fa9aea:


    "Kardeşimi hatırlamaya çalıştım."


translate turkish d5_ending_recipe_165f1b0d:


    Ant_m "Ağaç kovuklarında dolanan rüzgarı..."


translate turkish d5_ending_recipe_ffa20d50:


    Ant_m "Yaşlanınca dökeceğim kirli tüyleri..."


translate turkish d5_ending_recipe_7532c8b5:


    Ant_m "Karanlıkta dişlerimle koparıp yutabileceğim leziz mi leziz yemişleri düşündüm."


translate turkish d5_ending_recipe_2c1b58eb:



    voice "voice/Alisa/5day/02 Ya.ogg" 
    Alis "Yakışacağını biliyordum. Ne zamandır erteliyordun Antoşa."


translate turkish d5_ending_recipe_c09db700:



    voice "voice/Anton/5day/18 A.ogg"
    Ant_m "Antoşa..."


translate turkish d5_ending_recipe_4caf6cef:



    voice "voice/Anton/5day/19 Ch.ogg"
    Ant_m "Kimden bahsediyordu?"


translate turkish d5_ending_recipe_2a2ec13a:



    voice "voice/Anton/5day/19 Z.ogg"
    Ant_m "İsme artık ne gerek vardı?"


translate turkish d5_ending_recipe_04778d8d:



    voice "voice/Anton/5day/20 Z.ogg"
    Ant_m "Bir hayvanın gece dolaşabilecek dört ayağı, bir de et çiğneyip yutmak için ağzında dişleriyle salyası olsa yeterdi."


translate turkish d5_ending_recipe_339b11c8:



    voice "voice/Anton/5day/21 Zv.ogg"
    Ant_m "Bir hayvana, insanların birbirini ayırt etmek için kullandığı takma adlar değil, çeviklik lazımdı."


translate turkish d5_ending_recipe_29b39e84:



    voice "voice/Anton/5day/22 Ya.ogg"
    Ant_m "Ben de onlarla aynıydım. Gölgelere karışacak, sürünün parçası olacaktım..."


translate turkish d5_ending_recipe_0b967706:


    "Kafamı salladım."


translate turkish d5_ending_recipe_0c44d59b:



    voice "voice/Alisa/5day/01 A.ogg" 
    Alis "Hadi gidelim. Kardeşinle ilgilenmeliyiz."


translate turkish d5_ending_recipe_149abfac:


    "Olya!"


translate turkish d5_ending_recipe_57cf6e7f:


    "Onu buradan çıkarmalıydım."


translate turkish d5_ending_recipe_4cc50ecd:


    "Üstü karlarla örtülü duvarın ardına baktığımda, makine yağını ve çocuksu korkuları sezdiğim jandarma UAZ'sini gördüm."


translate turkish d5_ending_recipe_804a21ec:



    voice "voice/Anton/5day/23mo.ogg"
    Ant_m "Minik bir oyun mu oynasak!"


translate turkish d5_ending_recipe_bbe1fe4f:



    voice "voice/Anton/5day/24 p.ogg"
    Ant_m "Maskelerimizi cama yaslayıp Olya'nın bizi tanıyıp tanımadığını görebilirdik."


translate turkish d5_ending_recipe_c23f2dc2:


    Ant_m "Mezarlıkta insanlara şaka yapmak çok eğlenceli olurdu."


translate turkish d5_ending_recipe_09b1930e:


    Ant_m "Kendimi zorlayıp harekete geçtim."


translate turkish d5_ending_recipe_9937abe6:


    Ant_m "Bir pati... Bir el, tabii ki bir el yolcu kapısını açtı."


translate turkish d5_ending_recipe_6b6de426:



    voice "voice/Anton/5day/06 vse.ogg"
    Ant "Her ş..."


translate turkish d5_ending_recipe_36613560:



    voice "voice/olya/5day/55 Tosh.ogg"
    Oly "Toşa!"


translate turkish d5_ending_recipe_9b016694:


    "Avazı çıktığı kadar bağırdıktan hemen sonra Olya sesini kesti."


translate turkish d5_ending_recipe_47b6ce9b:


    "Bilincini yitirip kapaklandı."


translate turkish d5_ending_recipe_7c3de312:


    "Arabanın kapısında onu kurtarmaya gelenleri değil, canavarları görmüştü."


translate turkish d5_ending_recipe_ca0af31c:


    "Kış ve ormanın yaratıklarını..."


translate turkish d5_ending_recipe_bbcbc221:



    voice "voice/Alisa/5day/05 Pus.ogg"
    Alis "Bırak dinlensin. Yeni yüzüne aşina değil."


translate turkish d5_ending_recipe_d1480469:


    "Kardeşimi arabadan çıkarırken fark ettim..."


translate turkish d5_ending_recipe_71665fe6:



    voice "voice/Anton/5day/25 s.ogg"
    "{i}Pek leziz görünüyordu.{/i}"


translate turkish d5_ending_recipe_c798c755:


    "Julka'nın içindeki asalak, Kara Garaj'ın içindeki karanlık gibi benim içimde de kadim bir varlık sırıtıp uzun kulaklarını sallıyordu."


translate turkish d5_ending_recipe_b3b0a640:


    "Küflü maske, cildimi germişti."


translate turkish d5_ending_recipe_cb3f02dd:


    "Sabahları düzenlenen kostüm partilerinden bir maskeydi aslında."


translate turkish d5_ending_recipe_e21f9fe6:



    voice "voice/anton/5day/47 O.ogg"
    "İçimdeki alaycı ses {i}\"Sabah kavramına inanıyor musun ya?\"{/i} diye sordu."


translate turkish d5_ending_recipe_fb44348d:


    "İstediğim zaman maskeyi çıkarabilirdim."


translate turkish d5_ending_recipe_cad72ac3:



    voice "voice/Anton/5day/26 no.ogg"
    "{i}Ancak istemiyorsun, seni hayvan...{/i}"


translate turkish d5_ending_recipe_da3660a3:


    "İçine karlı tüyler uçuşan gözlerim yaşarmıştı."


translate turkish d5_ending_recipe_8957a8db:


    "Unutulmaya yüz tutmuş bir anıyı hatırlamıştım: Bir abi, elindeki kırmızı yıldızı yılbaşı ağacının tepesine yerleştirsin diye kardeşini kucağına almıştı."


translate turkish d5_ending_recipe_d3c37467:


    "Olya'yı sıra sıra mezarların arasından taşıyordum. Karlardan ayaklarımı zor hareket ettiriyordum."


translate turkish d5_ending_recipe_09814891:


