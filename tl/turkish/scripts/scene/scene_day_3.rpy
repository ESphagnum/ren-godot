translate turkish day3_draw_fox_cbe188b2:



    voice "voice/anton/3day/035 T.ogg"
    Ant "İçinde bir şey buldum... Mühür yüzük."


translate turkish day3_draw_fox_08873c02:



    voice "voice/anton/3day/036 S.ogg"
    Ant "Hem de Syoma'nın taktığı... Hatta yüzüğü cepledim."


translate turkish day3_draw_fox_3c14c43d:



    voice "voice/byasha/3day/90 Da.ogg"
    Bya "Hadi lan! Göstersene!"


translate turkish day3_draw_fox_812ead4c:


    "Etrafı hırsız gibi kolaçan ettikten sonra çalıntı yüzüğü cebimden temkinlice çıkardım."


translate turkish day3_draw_fox_3b6c8691:



    voice "voice/byasha/3day/92 T.ogg"
    Bya "Tam da düşündüğüm gibi he! Katil, Semyon'u gebertmiş."


translate turkish day3_draw_fox_f4b36d9a:



    voice "voice/byasha/3day/93 Na.ogg"
    Bya "Bizi de parça pinçik edecek."


translate turkish day3_draw_fox_8eb1f658:


    "Bu durum Romka'nın pek hoşuna gitmemişti. Suratını asıp kafa salladı."


translate turkish day3_draw_fox_c8c6d8c8:



    voice "voice/anton/3day/037 A.ogg"
    Ant "Dosyada... Siyah bir garaj resmi de vardı."


translate turkish day3_draw_fox_fb76289d:


    "Byaşa bunu duyunca karnına yumruk yemişçesine kıvranıp yüzünü elleriyle örttü."


translate turkish day3_draw_fox_78ded07b:


    "Romka gözlerini devirip küfretti."


translate turkish day3_draw_fox_8662809a:



    voice "voice/romka/3day/34 O.ogg"
    Rom "Yine mi be?"


translate turkish day3_draw_fox_65184e46:



    voice "voice/romka/3day/35 Nu.ogg"
    Rom "Sakin ol kanka, telaş yapma."


translate turkish day3_draw_fox_b89faa0a:



    voice "voice/anton/3day/038 B.ogg"
    Ant "Byaşa, sen daha önce Kara Garaj'la karşılaşmıştın, değil mi?"


translate turkish day3_draw_fox_f205637d:



    voice "voice/anton/3day/038 R.ogg"
    Ant "Hatta Roma, içerisine göz attığını söylemişti."


translate turkish day3_draw_fox_49010965:


    "Buryat çocuk, kara kışın ortasında kapı dışarı edilmişçesine titremeye başladı. Sorduğum sorular, Byaşa'nın başından aşağı kovalarca soğuk su dökmüşçesine durumu kötüleştiriyordu."


translate turkish day3_draw_fox_3069eeec:



    voice "voice/anton/3day/039 Ch.ogg"
    Ant "Orada ne gördün?"


translate turkish day3_draw_fox_76608aac:



    voice "voice/byasha/3day/97 Bee А.ogg"
    Bya "Mee-mee-mee..."


translate turkish day3_draw_fox_bb3e7275:


    "Romka sorularımdan hoşlanmamış olacak ki aramıza girip arkadaşını kolladı."


translate turkish day3_draw_fox_bbc18f08:



    voice "voice/romka/3day/36 Za.ogg"
    Rom "Sal! Bu konu hakkında tek kelime etmeyecek."


translate turkish day3_draw_fox_122e27ce:



    voice "voice/romka/3day/37 B.ogg"
    Rom "Biri ne zaman bunun sözünü açsa Byaşa'nın devreler yanıyor."


translate turkish day3_draw_fox_e40dc1ca:



    voice "voice/romka/3day/38 K.ogg"
    Rom "Ama artık bizimle takıldığın için bir defaya mahsus söyleyeceğim."


translate turkish day3_draw_fox_d89856a0:


    "Romka, benimle bir sır paylaşacağını belli edercesine kulağıma eğildi, anıları tazelemekten çekinircesine irkilip fısıldamaya başladı."


translate turkish day3_draw_fox_deda0fdd:



    voice "voice/romka/3day/39 O.ogg"
    Rom "Geçen sonbahar, bir gün sıkıntıdan patlıyorduk. Biz de kara büyü işlerini kurcalamaya karar verdik. Maça Kızı'nı çağırırız veya Puşkin'in ruhuyla dalga geçeriz falan, dedik."


translate turkish day3_draw_fox_ac2e03c2:



    voice "voice/romka/3day/40 A.ogg"
    Rom "Ama başımızdan geçenler hiç eğlenceli olmadı kanka."


translate turkish day3_draw_fox_a9c3bb44:



    voice "voice/romka/3day/41 O.ogg"
    Rom "Deli moruğun teki, büyüklerimizin en kutsal tabularından birini bozarsak gerçek bir hayalet çağırabileceğimizi söylemişti."


translate turkish day3_draw_fox_17d04ac7:



    voice "voice/romka/3day/42 Ch.ogg"
    Rom "O lavuğun birkaç tahtasının eksik olduğunu biliyordum da işte."


translate turkish day3_draw_fox_aba4f7dd:



    voice "voice/romka/3day/43 V.ogg"
    Rom "Gecenin bir vakti, o sıra sıra garajların oraya gidip..."


translate turkish day3_draw_fox_218754cc:



    voice "voice/romka/3day/44 E.ogg"
    Rom "Siyah olanın kapısını tıklatmamız gerekiyormuş."


translate turkish day3_draw_fox_a3e6fa3e:



    voice "voice/romka/3day/45 Ta.ogg"
    Rom "Tıklatınca o kara teneke belirip, çocukları alıp harikalar diyarına götürüyormuş. Kolpaya gel!"


translate turkish day3_draw_fox_4378d672:



    voice "voice/romka/3day/46 Vo.ogg"
    Rom "Biz de bunu yemiş gibi yapalım, dedik."


translate turkish day3_draw_fox_cd063b61:


    "Byaşa elleriyle kulaklarını kapatıp uzun uzun meledi."


translate turkish day3_draw_fox_61246a2e:



    voice "voice/byasha/3day/97 be.ogg"
    Bya "Mee."


translate turkish day3_draw_fox_55421c27:



    voice "voice/romka/3day/48 A.ogg"
    Rom "Byaşa'nın bu cesaret sınavından geçerken sadece kapıyı tıklatması gerekiyordu ama andaval çocuk, içeriye bakmaya karar verdi."


translate turkish day3_draw_fox_f66433e4:



    voice "voice/romka/3day/50 E.ogg"
    Rom "Belki de hayırlısı buydu."


translate turkish day3_draw_fox_9824f3a3:



    voice "voice/romka/3day/51 On.ogg"
    Rom "Öyle bir çığlık attı ki gözünden yaşlar boşaldı."


translate turkish day3_draw_fox_747b09f8:



    voice "voice/romka/3day/52 Ot.ogg"
    Rom "Harbi diyorum, hayatımda kimseyi o kadar beter bir hâlde görmemiştim."


translate turkish day3_draw_fox_b1202bfb:



    voice "voice/romka/3day/53 Ya.ogg"
    Rom "Yani içeride harikalar diyarı falan yokmuş."


translate turkish day3_draw_fox_6ce97580:



    voice "voice/romka/3day/54 S.ogg"
    Rom "O günden beri Kara Garaj, sokaklarımızda sinsice dolaşıp masum çocukların canına kıyıyor."


translate turkish day3_suefa_2effae3d:



    voice "voice/anton/3day/040 Chto.ogg"
    Ant "Peki ya ne yapacağız?"


translate turkish day3_suefa_939aa76d:



    voice "voice/romka/3day/55 V.ogg"
    Rom "Birbirimizi kollayacağız. Bu üçlü, {u}Voltran{/u} gibi güçlü."


translate turkish day3_suefa_44528941:


    "Girdiği şoku atlatıveren Byaşa mırıldandı:"


translate turkish day3_suefa_65e597c7:



    voice "voice/byasha/3day/98 Eto.ogg"
    Bya "Ee..."


translate turkish day3_suefa_09f31088:



    voice "voice/byasha/3day/99 V.ogg"
    Bya "Voltran beş kişi değil miydi, he?"


translate turkish day3_suefa_0c332d98:



    voice "voice/romka/3day/56 Nu.ogg"
    Rom "Biz de bacaksız Voltran oluruz madem."


translate turkish day3_suefa_6fe9b509:


    "Olgun bakışlarla bana bakıp kafa salladı. Gözlerinden endişe ve hüzün akıyordu."


translate turkish day3_suefa_4d8d110a:



    voice "voice/romka/3day/57 La.ogg"
    Rom "Neyse, Syoma'da artık yok zaten. Hadi!"


translate turkish day3_suefa_a60f5ca6:



    voice "voice/romka/3day/58 D.ogg"
    Rom "İşimiz gücümüz var. Sen sağı solu kes, herkes senden ölümüne korkuyor nasılsa."


translate turkish day3_suefa_39b9f0d4:


    "Ölümüne mi korkuyor? Benden mi?"


translate turkish day3_suefa_93f330e4:


    "Bu söylenenlere tam anlam veremesem de üzerimdeki baskıyı hissetmemle bana verilen görevi şipşak kabul ettim."


translate turkish day3_suefa_84031f32:


    "Çok pis gaza gelmiştim, okulumuzun alaca karanlık koridorlarında Romka ile Byaşa'nın peşine takıldım."


translate turkish day3_suefa_68c9d36c:


    "Bir mafya filminden fırlayan başkahramanlar gibi kasıla kasıla yürüyorduk."


translate turkish day3_suefa_0a7d8871:


    "Sanki aramızda bizden başka kimsenin bilmediği bir sır vardı."


translate turkish day3_suefa_acd464d8:


    "Bana ne yapacağımızı baştan söyleseydiler onlarla gelir miydim, bilmiyorum tabii."


translate turkish day3_suefa_00cf44f0:


    "Okulun spor salonunun yakınında bir kuytuya saklandık ve ahbaplarım, soyunma odasından çıkan çocukları izleyerek parmaklarını kütletmeye başladılar."


translate turkish day3_suefa_ef2c479f:


    "Nihayetinde Byaşa, kalabalıktaki birini gösterdi."


translate turkish day3_suefa_8b5be5a6:



    voice "voice/byasha/3day/100 Vo.ogg"
    Bya "Aha, gördüm o sünepeyi!"


translate turkish day3_suefa_690a1642:


    "Romka pis pis sırıtıp alçak sesle buyurdu:"


translate turkish day3_suefa_16210ca8:



    voice "voice/romka/3day/59 S.ogg"
    Rom "Ortalığı kolaçan et. Hoca görürsen bizi uyandır."


translate turkish day3_suefa_5e047216:



    voice "voice/byasha/3day/101 G.ogg"
    Bya "Dört gözünle birden izle he."


translate turkish day3_suefa_0ebf394d:



    voice "voice/romka/3day/60 Davai.ogg"
    "Çelişkili hisler ve düşüncelerle köşede dikildim."


translate turkish day3_suefa_fe40110a:



    voice "voice/romka/3day/60 Nono.ogg"
    "Arkamdaki çıkmaz koridorun sonunda Romka, beşinci sınıf bir çocuğu lafa tutmuştu."


translate turkish day3_suefa_54461ec3:



    voice "voice/romka/3day/60 Schet.ogg"
    "Çocuk dokunsan ağlayacak hâlde kendini açıklamaya çalışsa da Romka, duruşundan taviz vermeden küfürler savuruyor, Byaşa da araya birkaç kelime serpiştiriyordu."


translate turkish day3_suefa_1d02d079:



    voice "voice/romka/3day/30 Cry.ogg"
    "Böyle işlere bulaştığımı bilse babam ne derdi?"


translate turkish day3_suefa_cad86628:



    voice "voice/romka/3day/61 v.ogg"
    Rom "Hadi şimdi yol al."


translate turkish day3_suefa_c8d6a577:


    "Yeni dostlarım, çıkmaz koridordan döndüler."


translate turkish day3_suefa_b24cf588:


    "Tavandan vuran ışık, Romka'nın elindeki kamerayı aydınlattı."


translate turkish day3_suefa_d166b24f:



    voice "voice/anton/3day/041 Og.ogg"
    Ant "Oha! Polaroid... Senin mi?"


translate turkish day3_suefa_34608943:


    "Romka, elindeki kapaklı flaşa sahip siyah renkli teknolojik mucizeyi ilgisizce salladı."


translate turkish day3_suefa_5e69feea:



    voice "voice/romka/3day/62 Te.ogg"
    Rom "Artık benim."


translate turkish day3_suefa_be200e59:



    voice "voice/romka/3day/63 M.ogg"
    Rom "Hakkımda ileri geri konuştuğu için bir çocuğun bana bisiklet borcu vardı."


translate turkish day3_suefa_43f667f5:



    voice "voice/romka/3day/64 N.ogg"
    Rom "Gel gör ki bisikleti yokmuş."


translate turkish day3_suefa_fb16fb04:



    voice "voice/romka/3day/65 V.ogg"
    Rom "Bu yüzden bedelini bu kamerayla ödedi."


translate turkish day3_suefa_8d9fcbdf:



    voice "voice/romka/3day/66 A.ogg"
    Rom "Ne bokuma yarayacaksa..."


translate turkish day3_suefa_e4b62a14:


    "Çocuğa üzülsem de içimdeki kötü his, Romka'nın elindeki ganimete baktığım anda kayboldu."


translate turkish day3_suefa_64ab74d7:


    "Olya'ya bu Polaroid'i versem ne kadar mutlu olurdu. Kız kardeşimin, annemin, babamın fotoğraflarını çekerdim."


translate turkish day3_suefa_edcea9c6:


    "Ailemin yüzleri, dağılan sislerin arasından sıyrılır gibi yavaş yavaş filmlerde belirirdi."


translate turkish day3_suefa_3b9f4bc6:


    "Polina'nın da fotoğrafını çekip saklardım tabii."


translate turkish day3_suefa_dda74a63:


    "Masamın çekmecesine koyar, kilitlerdim."


translate turkish day3_suefa_86d53139:



    voice "voice/anton/3day/042.Ra.ogg"
    Ant "İhtiyacın yoksa ben alabilir miyim?"


translate turkish day3_suefa_7cb3488c:


    "Romka, tanıştığımız günküne benzer bakışlarla..."


translate turkish day3_suefa_22660c74:


    "Etçil bir sürünün hırçın lideri edasıyla beni tarttı."


translate turkish day3_suefa_ac090bcd:



    voice "voice/romka/3day/67 T.ogg"
    Rom "Kusura bakma kanka, böyle bir şeyi hayrına veremem."


translate turkish day3_suefa_e9504dc6:



    voice "voice/romka/3day/68 M.ogg"
    Rom "Tefeciye satar veya bahse koyarım, daha iyi."


translate turkish day3_suefa_f11e9a56:


    "Nedense \"oyun\" dediğinde aklıma Alisa geldi."


translate turkish day3_suefa_44e732fb:


    "Polaroid'e baktım."


translate turkish day3_suefa_6673fbb1:



    voice "voice/anton/3day/043 Nu.ogg"
    Ant "Bahse var mısın madem? Ne oynayalım?"


translate turkish day3_suefa_91096b51:


    "Byaşa yumruk yaptığı eline doğru kıs kıs güldü."


translate turkish day3_suefa_9e094967:



    voice "voice/byasha/3day/108 Che.ogg"
    Bya "Şş, Romka, Antoşka'ya gömleğini mi çıkarttırsak, ne dersin?"


translate turkish day3_suefa_17db49a4:



    voice "voice/romka/3day/69 Ya.ogg"
    Rom "İbne misin de karşında erkek soyundurayım lan?"


translate turkish day3_suefa_efac7a8c:


    "Romka beni tepeden tırnağa süzdü."


translate turkish day3_suefa_7ec7845d:



    voice "voice/romka/3day/70 N.ogg"
    Rom "Nesine oynarsın?"


translate turkish day3_suefa_abeb7886:



    voice "voice/romka/3day/71 U.ogg"
    Rom "Paran var mı?"


translate turkish day3_suefa_a4408478:



    voice "voice/byasha/3day/110 Vo.ogg"
    Bya "Aynen he! Zıpla da ceplerini duyalım Toşik."


translate turkish day3_suefa_817a3f63:


    "Yemek paramdan artakalan üç beş bozuk para bulmak umuduyla pantolonumun ceplerini yavaşça ters çevirdim."


translate turkish day3_suefa_6a6bf768:


    "Cebimde biriken tüyler haricinde birkaç bozukluk, bir düğme ve az kullanılmış kauçuk bir silgi vardı."


translate turkish day3_suefa_d211242b:



    voice "voice/byasha/3day/112 Da.ogg"
    Bya "Seni fukara!"


translate turkish day3_suefa_557fc850:



    voice "voice/romka/3day/72 P.ogg"
    Rom "Kusura bakma kanka."


translate turkish day3_suefa_89626e81:



    voice "voice/romka/3day/73 N.ogg"
    Rom "Buradan sana ekmek çıkmaz."


translate turkish day3_suefa_b1ff7556:



    voice "voice/romka/3day/74 A.ogg"
    Rom "Sonuçta kumarda ne kadar ekmek, o kadar köfte."


translate turkish day3_suefa_20e496ab:



    voice "voice/romka/3day/75 D.ogg"
    Rom "Başka zaman bakarız."


translate turkish day3_suefa_f5663c64:


    "Romka, Polaroid'i boynuna asıp göz kırptı."


translate turkish day3_suefa_945b599e:



    voice "voice/romka/3day/76 N.ogg"
    Rom "Ee beyler, biraz manitacılık mı kovalasak?"


translate turkish day3_suefa_1d639e26:


    "Cebimden bir hışırtı geldi."


translate turkish day3_suefa_cc6994e4:


    "Alisa sağ olsun, Mercedes-Benz resmini çekip çıkardım."


translate turkish day3_suefa_ee235025:


    "Sanırım sırt çantamdaki ıvır zıvırlar ormanda etrafa saçıldığında bu resmi hiç düşünmeden cebime atmışım."


translate turkish day3_suefa_607bde9e:



    voice "voice/anton/3day/044.Ana.ogg"
    Ant "Mercedes-Benz'ine oynar mısın?"


translate turkish day3_suefa_73207e60:


    "Araba resmini yakından gösterdiğimde Byaşa'nın gözleri az kalsın yuvalarından fırlayacaktı ancak Romka'nın kılı bile kıpırdamamıştı."


translate turkish day3_suefa_74689fc0:



    voice "voice/romka/3day/77 H.ogg"
    Rom "Bir kağıt parçasına karşılık koskoca kamerayı ortaya koyar mıyım sence?"


translate turkish day3_suefa_557044c2:



    voice "voice/byasha/3day/114 E.ogg"
    Bya "Bu..."


translate turkish day3_suefa_3e513a93:



    voice "voice/romka/3day/78 Da.ogg"
    Rom "Sakız dediğin bir ruble, bu Polaroid'in içindeyse daha hiç kullanılmamış film var bir kere."


translate turkish day3_suefa_8d0b4c73:



    voice "voice/byasha/3day/114 Et.ogg"
    Bya "Baksana, bu..."


translate turkish day3_suefa_fe8cf318:



    voice "voice/romka/3day/79 O.ogg"
    Rom "Bende bu resimlerden bir ton var hem. Niye dahasını..."


translate turkish day3_suefa_c9e08283:



    voice "voice/byasha/3day/115 M.ogg"
    Bya "Mercedes-Benz lan! Bir türlü bulamadığımız araba he, Romka!"


translate turkish day3_suefa_e8e9ee53:


    "Romka yere tükürüp Byaşa'nın ensesine bir tokat patlattı."


translate turkish day3_suefa_018262af:



    voice "voice/romka/3day/81 Nu.ogg"
    Rom "Hay senin şom ağzını... Çocuğun arabası şimdi kıymete binecek."


translate turkish day3_suefa_fabbf30f:


    "Tam da düşündüğüm gibi bu araba, her Turbo sakız koleksiyoncusunun canla başla aradığı nadide bir parçaydı."


translate turkish day3_suefa_a2b6896d:



    voice "voice/anton/3day/045.Aga.ogg"
    Ant "Aha, ilgini çekti demek!"


translate turkish day3_suefa_ad6a8b7c:



    voice "voice/anton/3day/046.Ta.ogg"
    Ant "Ne oynuyoruz o zaman?"


translate turkish day3_suefa_4f7c7f5e:



    voice "voice/byasha/3day/117 V.ogg"
    Bya "Batak!"


translate turkish day3_suefa_28a56e2e:



    voice "voice/romka/3day/82 V.ogg"
    Rom "Çelik çomak!"


translate turkish day3_suefa_67b16daf:


    "Kaşla göz arasında Byaşa'nın elinde hileli olduğunu düşündüğüm pis bir iskambil destesi belirdi, Romka da çelik çomak hazırlamak üzere kelebek çakısını çıkarıp suratıma doğru ustalıkla salladı."


translate turkish day3_suefa_f907da74:


    "Onların kurallarıyla oynamaya hiç niyetim yoktu."


translate turkish day3_suefa_886f3e16:



    voice "voice/anton/3day/047 A.ogg"
    Ant "Taş-kağıt-makas oynayalım."


translate turkish day3_suefa_2f153c75:



    voice "voice/romka/3day/83 O.ogg"
    Rom "Oo, sen de tam kumarbaz çıktın he."


translate turkish day3_suefa_82011ae4:



    voice "voice/romka/3day/84 Nu.ogg"
    Rom "Pekala, Mercedes'ine karşılık Polaroid'im o zaman."


translate turkish day3_suefa_8a9adf4a:



    voice "voice/anton/3day/048 Po.ogg"
    Ant "Anlaştık."


translate turkish suefa_lose_0230524e:


    "Byaşa öyle sert bir alkış tuttu ki koridordan geçen çocuklar bize tuhaf tuhaf bakıyordu."


translate turkish suefa_lose_3991f3ec:


    "Çok pis yenilmiştim."


translate turkish suefa_lose_48398744:



    voice "voice/byasha/3day/122 F.ogg"
    Bya "Gösteri bitti Toşik! Ver bakayım, he."


translate turkish suefa_lose_5f1fe322:


    "Alisa'nın varlığının tek kanıtı, ellerimden kayıp Byaşa aracılığıyla Romka'nın ellerine gitti."


translate turkish suefa_lose_7cc1fedd:



    voice "voice/romka/3day/92 A.ogg"
    Rom "Hoş geldin, koleksiyonumun göz bebeği."


translate turkish suefa_lose_0d8724a3:



    voice "voice/romka/3day/93 S.ogg"
    Rom "Sağ ol Toşa, seninle bahse girmek büyük bir zevkti."


translate turkish suefa_win_86b2dc1c:



    voice "voice/anton/3day/052.Viig.ogg"
    Ant "Ee, kazandım mı, yoksa Byaşa'yı da mı yenmem lazım?"


translate turkish suefa_win_d8c8306c:


    "Romka, burnunun altından bir şeyler homurdandı."


translate turkish suefa_win_431d77ac:


    "Oyunbozanlık yapıp beni eli boş gönderecekmiş gibi bir hâli vardı."


translate turkish suefa_win_63e5857b:



    voice "voice/byasha/3day/124 E.ogg"
    Bya "Romka, çocuk alnının akıyla kazandı he."


translate turkish suefa_win_7470762a:


    "Romka, gönülsüzce de olsa yola geldi."


translate turkish suefa_win_1e4a7fb5:



    voice "voice/romka/3day/95 V.ogg"
    Rom "Ne şanslı piçsin he. Al!"


translate turkish suefa_win_8280cfd7:



    voice "voice/romka/3day/96 T.ogg"
    Rom "Çükünün fotoğrafını çekme yalnız."


translate turkish suefa_win_fe73ea8e:


    "Polaroid'i avuçlarımın arasına almış, büyük bir şampiyon gibi otuz iki diş sırıtıyordum."


translate turkish dev_day3_week_end_89cbaa24:


    "Üsteğmen, sınıfımızı ziyaret edeli yedi gün olmuştu."


translate turkish dev_day3_week_end_2e1f9a27:


    "İlk bakışta her şey, bir hafta önceki hâlinden farksızdı."


translate turkish dev_day3_week_end_ae8b5578:


    "Ormanın yabani pençeleri hâlâ köye uzanıyor, rüzgarın kaldırdığı pudramsı kar taneleri ise her gece beyaz bayraklar gibi havada dalgalanıyordu."


translate turkish dev_day3_week_end_085bf04c:


    "Annem ile babam ne zaman yan odada tartışsa, Olya'nın yanına oturup televizyonun sesini açarak tartışma seslerini bastırıyordum."


translate turkish dev_day3_week_end_81f07fa2:


    "Vova ile Semyon'un resmi, hâlâ duyuru panosundaki iki kara lekeydi ve toparlak yüzlü Senya da henüz yuvasına dönmemişti."


translate turkish dev_day3_week_end_a63d26aa:


    "Vova ile Semyon'un resmi, hâlâ duyuru panosundaki iki kara lekeydi."


translate turkish dev_day3_week_end_24353978:


    "Ancak değişen bir şey vardı. Sınıftakilerin bakışlarının ne kadar farklı olduğunu görebiliyordum."


translate turkish dev_day3_week_end_5f08d5cd:


    "Bana sataşmanın ve hakaret etmenin yepyeni yollarını bulmuşlardı. Nefret, alay ve yalnızlık, sadık dostlarım hâline gelmişti."


translate turkish dev_day3_week_end_ba89e478:


    "Ceplerim, bana ikram ettikleri meyvelerle dolmuştu. Artık bana kin beslemiyorlardı. Okul da eskisi gibi korkunç gelmiyordu."


translate turkish dev_day3_week_end_1a2ca336:


    "Ama en önemlisi..."


translate turkish dev_day3_week_end_c714843c:


    "Az ötemden geçen bir gölge, sırama gizemli bir not bıraktı."


translate turkish dev_day3_week_end_e4be60dd:


    "Sıraların arasından uzanan koridora baktım ancak gizemli notu ileten elçiyi göremedim."


translate turkish dev_day3_week_end_19eabedc:


    "Bana bu notu kim göndermişti? Bu özenle yırtılıp katlanmış kağıt parçasının içinde beni ne bekliyordu?"


translate turkish dev_day3_week_end_03f29a04:


    "Daha fazla tehdit ve hakaret mi, yoksa?.."


translate turkish dev_day3_week_end_9ebcb98a:


    "Kağıt parçasını alıp burnuma ilişen kokuyu içime çektim."


translate turkish dev_day3_week_end_42387107:


    "Böğürtlen."


translate turkish dev_day3_week_end_039a9db6:


    "Kağıtta güzel el yazısıyla bir mesaj vardı: \"Soyunma odasının oradaki çıkmazda bekliyorum. Yalnız gel.\""


translate turkish dev_day3_week_end_70a53e56:


    "Bu mesajın bende yarattığı heyecanla hemen yola koyuldum. Kimsenin beni takip etmediğinden emin olmak için ara ara arkama bakıyordum."


translate turkish dev_day3_week_end_2aba4024:


    "İlk başta bunun Romka ile Byaşa'nın kurduğu bir pusu olduğundan şüphelensem de bu düşünce, çok geçmeden aklımdan çıkıverdi."


translate turkish dev_day3_week_end_76e73391:


    "O ikisinde Polina'nın el yazısını taklit edebilecek akıl yoktur."


translate turkish dev_day3_week_end_35c603f1:


    "Koridorun köşesine yaklaştığımda heyecandan depara kalkmak üzere olduğumu fark etmemiştim bile."


translate turkish dev_day3_week_end_f3545699:


    "Seke seke köşeyi döndüğüm an, o kuytuda birine tosladım."


translate turkish dev_day3_week_end_b8262865:



    voice "voice/Polina/3day/01 O.ogg"
    Pol "Ay!"


translate turkish dev_day3_week_end_e4e95e7a:


    "Polina'nın elindeki yeşil defter, ayağıma doğru egzotik bir kuş gibi süzülüverdi."


translate turkish dev_day3_week_end_c1e50c61:


    "Polina, öfkesini abartarak yanaklarını şişirdi."


translate turkish dev_day3_week_end_18d4d800:



    voice "voice/Polina/3day/02 P.ogg"
    Pol "Petrov, hepten mi kör oldun?"


translate turkish dev_day3_week_end_20c5893d:


    "Gözlüğümü düzelttim, miyopluğumdan artık o kadar da utanmıyordum."


translate turkish dev_day3_week_end_cef9b154:


    "Eğilip defteri yerden aldım."


translate turkish dev_day3_week_end_a4a5c4ad:



    voice "voice/anton/3day/054 Pr.ogg"
    Ant "Kusura bakma, acelem vardı. Beni mi bekliyordun yoksa? Bir şey mi oldu?"


translate turkish day3_amulet_before_668394f4:


    "Polina'nın şakacıktan bana yansıttığı öfkesi yatışmış, doğru sözcükleri seçmeye çalışırken susup kalmıştı."


translate turkish day3_amulet_before_d44fed01:


    "Sanki sohbeti sürdürmemi ve bizi bu rahatsız edici sessizlikten kurtarmamı umarcasına endişeli ve üzgün bakıyordu."


translate turkish day3_amulet_before_227a95fa:


    "Ancak tek kelime etmedim, o esnada onun o titreyen dudaklarına bakıyordum."


translate turkish day3_amulet_before_7d58b206:


    "En sonunda Polina, derin bir iç çekip utana sıkıla sordu:"


translate turkish day3_amulet_before_df254e32:



    voice "voice/Polina/3day/04 A.ogg"
    Pol "Anton, bana kızdın mı yoksa?"


translate turkish day3_amulet_before_ded77cee:


    "Yanıt bile veremeden lafına devam etti."


translate turkish day3_amulet_before_fd37eb8b:



    voice "voice/Polina/3day/05 Oh.ogg"
    Pol "Elbette kızdın. Ne kadar salakça bir soru bu."


translate turkish day3_amulet_before_208b1059:



    voice "voice/Polina/3day/06 P.ogg"
    Pol "Çok özür dilerim ama niyetim bu değildi cidden!"


translate turkish day3_amulet_before_e5291523:



    voice "voice/Polina/3day/07 Ko.ogg"
    Pol "O gaddar çocuk, Pyatifanov, o köpeciğe tekme attığında..."


translate turkish day3_amulet_before_4625a7df:



    voice "voice/Polina/3day/08 Et.ogg"
    Pol "Sanki kendimde değildim, anlıyor musun?"


translate turkish day3_amulet_before_1d4e870a:


    "Sıkkınlıkla derin bir nefes verdi. Okyanus rengi gözlerinin ışıltısını okulun loş koridorlarında bile görebiliyordum."


translate turkish day3_amulet_before_c656cd09:



    voice "voice/Polina/3day/09 Da.ogg"
    Pol "Bunun hoş bir şey olmadığının farkındayım."


translate turkish day3_amulet_before_0383dcbe:



    voice "voice/Polina/3day/10 Ne.ogg"
    Pol "Bir hayvanın acınası hâline kimse gülmemeli."


translate turkish day3_amulet_before_b6288ad5:



    voice "voice/Polina/3day/11 Nez.ogg"
    Pol "Benim hakkımda ne düşündüğünü aklıma getirmek bile istemiyorum."


translate turkish day3_amulet_before_6d16e30a:



    voice "voice/Polina/3day/12 No.ogg"
    Pol "Ne var ki kendime engel olamıyorum, Anton."


translate turkish day3_amulet_before_a1e585d5:



    voice "voice/Polina/3day/13 S.ogg"
    Pol "O gece kendisine köpek sürüsü saldırdığında dedemin başından geçenleri hatırladıkça..."


translate turkish day3_amulet_before_38426ae2:



    voice "voice/Polina/3day/14 K.ogg"
    Pol "Bende film kopuyor."


translate turkish day3_amulet_before_fc14c203:


    "Polina'nın defteri hâlâ elimde, sahibine dönmeyi bekliyordu ama geri vermek için bir türlü fırsat bulamıyordum."


translate turkish day3_amulet_before_de05be8b:



    voice "voice/Polina/3day/15 T.ogg"
    Pol "Muhtemelen aklımı kaçırdığımı düşünüyorsun."


translate turkish day3_amulet_before_ec6ee115:


    "O anki dalgınlığımla bilinçaltım bana defalarca deli saçması şeyler hatırlatırken Polina, bana umut dolu gözlerle bakıyordu."


translate turkish day3_amulet_before_8830703e:


    "Bir başkasının akıl sağlığını yorumlamak bana düşmezdi yani."


translate turkish day3_amulet_before_b3458b4b:



    voice "voice/Polina/3day/16 M.ogg"
    Pol "Bazen kendime hakim olamıyorum."


translate turkish day3_amulet_before_09e563da:



    voice "voice/Polina/3day/17 No.ogg"
    Pol "Ama kimseyi de bilerek incitmem, anlatabiliyor muyum?"


translate turkish day3_amulet_before_32ec3fae:



    voice "voice/Polina/3day/18 N.ogg"
    Pol "Zalim Romka'nın aksine..."


translate turkish day3_amulet_before_a652539f:



    voice "voice/Polina/3day/19 A.ogg"
    Pol "Anton, lütfen ondan uzak dur!"


translate turkish day3_amulet_before_f6178b49:


    "Kafama o an bir şey dank etti. Kuşkuyla Polina'ya baktım."


translate turkish day3_amulet_before_4fcf92dc:



    voice "voice/anton/3day/58 V.ogg"
    Ant "Geçen hafta biz kavga ederken ona seslenişin ilginçti..."


translate turkish day3_amulet_before_5fb18fdf:



    voice "voice/anton/3day/58 R.ogg"
    Ant "Romoçka diye."


translate turkish day3_amulet_before_932cddcc:



    voice "voice/anton/3day/59 Sk.ogg"
    Ant "Çıkıyor musunuz yoksa?"


translate turkish day3_amulet_before_478e3b4e:


    "Polina, yıldırım çarpmışa dönmüştü."


translate turkish day3_amulet_before_6b7eb97e:



    voice "voice/Polina/3day/20 E.ogg"
    Pol "Yok artık! O şerefsiz bana kene gibi yapıştı."


translate turkish day3_amulet_before_7b54b872:



    voice "voice/Polina/3day/22 T.ogg"
    Pol "Onun gibilerin yüzüne tükürsen 'Şükür,' der."


translate turkish day3_amulet_before_c13b528d:


    "Yüzümdeki yara bereyi fark edince sesi biraz daha yatıştı."


translate turkish day3_amulet_before_f20eaa60:



    voice "voice/Polina/3day/23 P.ogg"
    Pol "Olanlar için tekrar çok üzgünüm."


translate turkish day3_amulet_before_5fbb6f33:



    voice "voice/Polina/3day/24 Ya.ogg"
    Pol "O gün... Sana yardımcı olabileceğimi sanmıştım."


translate turkish day3_amulet_before_de9c531f:



    voice "voice/Polina/3day/25 Z.ogg"
    Pol "O şerefsizlerden haysiyet görmeyi bekleyerek hata ettim."


translate turkish day3_amulet_before_7fde70d5:



    voice "voice/Polina/3day/26 V.ogg"
    Pol "Buyur, sana bir hediyem var."


translate turkish day3_amulet_before_1904fa4b:


    "Yeleğinin en üst düğmesini çözdü, şaşkın bakışlarımı görünce utandı."


translate turkish day3_amulet_before_aa0fdb1d:


    "Koynundan kalın deri ipli, ucu büyük hayvan pençeli bir tılsım çıkarıp bana uzattı."


translate turkish day3_amulet_before_09760c86:



    voice "voice/Polina/3day/28 E.ogg"
    Pol "Bu tılsımı bana dedem vermişti."


translate turkish day3_amulet_before_c8127670:



    voice "voice/Polina/3day/29 G.ogg"
    Pol "Dediğine göre cinden, deliden korurmuş."


translate turkish day3_amulet_before_5a6693de:



    voice "voice/Polina/3day/30 On.ogg"
    Pol "Şamanın birinden almış."


translate turkish day3_amulet_before_fdeaacfc:



    voice "voice/Polina/3day/31M.ogg"
    Pol "İster inan ister inanma, dedem bu tılsımı takmayı tek bir gün unutmuştu, o gün de başına malum olay geldi."


translate turkish day3_amulet_before_f80bca25:


    "Üzerinde derin çizikler bulunan, hangi hayvana ait olduğunu çıkaramadığım bu pençeye tekrar göz attım."


translate turkish day3_amulet_before_ff0cac13:



    voice "voice/anton/3day/60 A.ogg"
    Ant "Bu ne acaba? Ne pençesi yani?"


translate turkish day3_amulet_before_6a73ead3:



    voice "voice/Polina/3day/32 D.ogg"
    Pol "Bilmem."


translate turkish day3_amulet_before_046333a7:



    voice "voice/Polina/3day/33 M.ogg"
    Pol "Ayı veya kaplan pençesi olabilir."


translate turkish day3_amulet_before_7354033f:



    voice "voice/Polina/3day/34 K.ogg"
    Pol "Ormanımızda çeşit çeşit hayvan var."


translate turkish day3_amulet_before_69687a22:



    voice "voice/Polina/3day/35 V.ogg"
    Pol "Her neyse, lütfen bunu da özrümle birlikte kabul et."


translate turkish day3_amulet_yes_93fc9bd0:



    voice "voice/anton/3day/61 E.ogg"
    Ant "Yani, madem senin için bu kadar önemli..."


translate turkish day3_amulet_yes_dcdb442f:



    voice "voice/anton/3day/156 Horosh.ogg"
    Ant "Pekala, sil baştan başlayalım."


translate turkish day3_amulet_yes_af10671b:


    "Boş elime nazikçe aldığım tılsımdan Polina'nın sıcaklığı ve cezbedici böğürtlen kokusu yayılıyordu."


translate turkish day3_amulet_yes_4e92af6a:


    "Boynuma asıp gömleğimin yakasının altına sokuşturdum."


translate turkish day3_amulet_yes_e8a622b2:


    "Bu hediyenin hayatımı değiştirebileceğine dair tuhaf bir his doğmuştu içimde."


translate turkish day3_amulet_yes_e973dcf3:


    "Aramızdaki buzların ağır ağır eridiğini hissederek Polina'yla aynı anda gülümsedik."


translate turkish day3_amulet_yes_8627d6e3:



    voice "voice/Polina/3day/36 S.ogg"
    Pol "Sağ ol Anton."


translate turkish day3_amulet_yes_b648586e:



    voice "voice/Polina/3day/37 D.ogg"
    Pol "Bu benim için çok şey ifade ediyor."


translate turkish day3_amulet_no_bc8f2f3e:



    voice "voice/anton/3day/62 Da.ogg"
    Ant "Lütfen sende kalsın."


translate turkish day3_amulet_no_2e5c328f:



    voice "voice/anton/3day/63 Eto.ogg"
    Ant "Sonuçta dede yadigarıymış."


translate turkish day3_amulet_no_a6aa4596:



    voice "voice/anton/3day/64 Da.ogg"
    Ant "Hem bu tılsımın seni koruduğunu bilirsem içim öyle daha rahat eder."


translate turkish day3_amulet_no_3ed35aa2:



    voice "voice/Polina/3day/38 V.ogg"
    Pol "Hep başkalarını düşünüyorsun."


translate turkish day3_amulet_no_215cf8d0:



    voice "voice/Polina/3day/39 Z.ogg"
    Pol "Var ya, centilmenliğin sadece kitap karakterlerine mahsus olduğunu sanırdım..."


translate turkish day3_amulet_no_198e6fc2:



    voice "voice/Polina/3day/40 P.ogg"
    Pol "Ta ki seni tanıyana dek."


translate turkish day3_amulet_no_f7f51b2e:


    "Biraz utanmıştım, botumun burnuyla yerde daireler çizmeye başladım."


translate turkish day3_amulet_no_166635fd:



    voice "voice/anton/3day/65 S.ogg"
    Ant "Abartma canım sen de."


translate turkish day3_amulet_no_ec5e4531:



    voice "voice/Polina/3day/41 Ya.ogg"
    Pol "Ciddiyim!"


translate turkish day3_amulet_no_9807a448:



    voice "voice/Polina/3day/42 A.ogg"
    Pol "Ee, özrüme ne diyorsun? Kabul ediyor musun?"


translate turkish day3_amulet_no_dc75a1e7:


    "Polina, gözlerime bakıp ışıl ışıl gülümsedi. Kıpkırmızı oluverdim."


translate turkish day3_amulet_no_35a45a00:



    voice "voice/anton/3day/66 Da.ogg"
    Ant "Evet ama sana zaten kırılmamıştım."


translate turkish day3_amulet_no_f6563c33:



    voice "voice/anton/3day/156 Bilo.ogg"
    Ant "Bir yanlışın olmadı yani."


translate turkish day3_amulet_after_5d897d87:


    "Polina beni dikkatlice süzüp dilini şaklattı."


translate turkish day3_amulet_after_1cf1ff52:



    voice "voice/Polina/3day/03 A.ogg"
    Pol "Neye benziyorsun, biliyor musun Antoşa?"


translate turkish day3_amulet_after_a20cefa7:


    "..."


translate turkish day3_amulet_after_491ef6b3:



    voice "voice/Polina/3day/04 Na.ogg"
    Pol "Doğaçlama blues müziğe."


translate turkish day3_amulet_after_0ba124ec:


    "Gözlerimi şaşkınlıkla kırptım."


translate turkish day3_amulet_after_86c6fc25:



    voice "voice/anton/3day/055 Eto.ogg"
    Ant "Nasıl yani?"


translate turkish day3_amulet_after_37c7afd0:



    voice "voice/Polina/3day/05 D.ogg"
    Pol "Tanıdığım insanları çeşitli şeylere benzetirim hep."


translate turkish day3_amulet_after_2efc4eb1:



    voice "voice/anton/3day/056..ogg"
    Ant "Onu ben de yaparım da müziğe benzetmem."


translate turkish day3_amulet_after_9cafe419:



    voice "voice/Polina/3day/06 Vo.ogg"
    Pol "Ben ise müzikten başka hiçbir şeye benzetemem!"


translate turkish day3_amulet_after_8f02e323:



    voice "voice/Polina/3day/07 B.ogg"
    Pol "Bazı insanlar gitar solosu, bazısı bateri gibidir. Liliya Pavlovna gibiler de savaş marşını çağrıştırır mesela."


translate turkish day3_amulet_after_6877d187:



    voice "voice/Polina/3day/08 A.ogg"
    Pol "Sen ise pek düşünceli, pek gizemli, kimi zaman biraz da hüzünlüsün."


translate turkish day3_amulet_after_73b1cda1:



    voice "voice/Polina/3day/09 T.ogg"
    Pol "Yani tam olarak blues'sun."


translate turkish day3_amulet_after_c68636e1:



    voice "voice/anton/3day/057 A.ogg"
    Ant "Peki doğaçlamadan kastın neydi?"


translate turkish day3_amulet_after_fa868b83:



    voice "voice/Polina/3day/10 A.ogg"
    Pol "Hani mesela dinleyiciler bestenin nasıl gelişeceğini, hangi tempoda devam edeceğini kestiremez ya."


translate turkish day3_amulet_after_17a9e0e9:


    "Elbette Polina'nın anlattığı şeylerin bazılarından tek kelime anlamamıştım."


translate turkish day3_amulet_after_76ef7855:


    "Yine de mayıs meltemleri gibi huzur veren gülüşünden, okyanuslar gibi derin ve masmavi bakışlarından gözlerimi alamıyordum."


translate turkish day3_amulet_after_96bf6be1:



    voice "voice/Polina/3day/11 Ch.ogg"
    Pol "Birinin içindeki müziği tanımak için deneyim ve zevk sahibi olmak gerek."


translate turkish day3_amulet_after_475e8d65:



    voice "voice/Polina/3day/12 E.ogg"
    Pol "Pop müzik olmadığın besbelli."


translate turkish day3_amulet_after_a925e992:



    voice "voice/anton/3day/058.Ya.ogg"
    Ant "Blues'un B'sini bile bilmiyorum, desem..."


translate turkish day3_amulet_after_e6f39c01:


    "Polina şaşkınlıkla derin bir iç çekip kaşlarını çattı. İnsan bu hâliyle bile mi güzel olur?"


translate turkish day3_amulet_after_a28184b0:



    voice "voice/Polina/3day/13 Ne.ogg"
    Pol "Ağzından çıkanı kulağın duysun! Sana muhakkak bir kaset vermem lazım."


translate turkish day3_amulet_after_e1e5cab9:



    voice "voice/Polina/3day/14 R.ogg"
    Pol "Dedem önceden bana şehirden çeşit çeşit müzik getirirdi. Caz, swing, klasik..."


translate turkish day3_amulet_after_ccdfffad:



    voice "voice/Polina/3day/15 E.ogg"
    Pol "Müzik kulağım olduğunu da dedem fark etmişti."


translate turkish day3_amulet_after_9365a293:



    voice "voice/Polina/3day/16 Ya.ogg"
    Pol "Daha küçücükken doğa seslerini, yağmurun ve ormanın ezgili hışırtısını notalarıyla kağıda yazmayı denermişim."


translate turkish day3_amulet_after_159cff4d:



    voice "voice/anton/3day/059 Eh.ogg"
    Ant "Keşke sendeki kulak bende olsa."


translate turkish day3_amulet_after_43952e6c:



    voice "voice/Polina/3day/17 A.ogg"
    Pol "Keşke ben de senin gibi görebilsem!"


translate turkish day3_amulet_after_a3cc9515:


    "Benimle alay mı ediyor acaba, diye düşünüp irkildim ama Polina hemen başını salladı."


translate turkish day3_amulet_after_6d46ca07:



    voice "voice/Polina/3day/18 Da.ogg"
    Pol "Tabii, çok ciddiyim. Tam bir ressam gibi bakmasını biliyorsun."


translate turkish day3_amulet_after_dbad2c12:



    voice "voice/Polina/3day/19 S.ogg"
    Pol "Bir şeylerin resmini çizmekte çok iyisin. Ben çizemem mesela."


translate turkish day3_amulet_after_66aba2f9:


    "Katya, akıllara kazınan soğuk bakışlarıyla ötemizden geçti."


translate turkish day3_amulet_after_bdf2a25b:


    "Ondan saklanmak için karanlık bir köşeye sokulduk."


translate turkish day3_amulet_after_1c29ff9e:



    voice "voice/Polina/3day/21 t.ogg"
    Pol "Neden saklandığımızın farkındasın, değil mi? Onun gibilerden."


translate turkish day3_amulet_after_73b76bb2:



    voice "voice/anton/3day/060 AKat.ogg"
    Ant "Peki Katya nasıl bir ezgi?"


translate turkish day3_amulet_after_7800b077:


    "Polina haylazca güldü."


translate turkish day3_amulet_after_2c3f4132:



    voice "voice/Polina/3day/22 Sk.ogg"
    Pol "Paslı kapı menteşelerinin gıcırtısı o."


translate turkish day3_amulet_after_ed6e52d7:



    voice "voice/Polina/3day/23 Z.ogg"
    Pol "Durmadan ciyaklayıp kafa şişiriyor ya."


translate turkish day3_amulet_after_94f70379:


    "Elimle ağzımı örtüp kikirdedim."


translate turkish day3_amulet_after_0a1190a5:


    "Katya, fısıltılarımızı duymasa da -bir şeyden nem kapmış olacak ki- birden arkasına dönüp etrafına baktı. Hemen ardından iç çekip yoluna devam etti."


translate turkish day3_amulet_after_defff995:


    "Hâlâ elimde sımsıkı tuttuğum bir defter olduğunu hatırladım. Kendime doğru çevirdim."


translate turkish day3_amulet_after_afcdc29e:


    "Ön kapağında ders adı yerine sahibinin adı ile iki kelime, \"Arkadaşlarıma özel\" yazıyordu."


translate turkish day3_amulet_after_7cf6454c:



    voice "voice/Polina/3day/24 L.ogg"
    Pol "Merak kediyi öldürür yalnız."


translate turkish day3_amulet_after_a83f534c:



    voice "voice/anton/3day/062 Pr.ogg"
    Ant "Affedersin. Anket mi bu?"


translate turkish day3_amulet_after_6b02000a:



    voice "voice/Polina/3day/25 Za.ogg"
    Pol "Hiç anket doldurdun mu?"


translate turkish day3_amulet_after_c2d19ea7:


    "Doldurduğuma dair yalan söyledim."


translate turkish day3_amulet_after_e5412364:


    "İşin doğrusu, eski okulumdaki hiçbir kız bana anket doldurtmamıştı. Pek can sıkıcı bir durum."


translate turkish day3_amulet_after_37651e1b:


    "Gerçi bu tarz şeylerle kızlar uğraşırdı. En sevdiğin oyuncu ve renge dair birkaç klişe soruyu yanıtlar, geçerdin. Tabii anket defterini birine emanet etmek, arkadaşlığın göstergesiydi..."


translate turkish day3_amulet_after_61b9ea7f:


    "Hatta arkadaşlıktan fazlası da denebilir, bir zamanlar aklım buna pek ermezdi."


translate turkish day3_amulet_after_b000dcee:



    voice "voice/Polina/3day/26 Ho.ogg"
    Pol "İstersen benimkini de doldurabilirsin."


translate turkish day3_amulet_after_d65237c1:


    "Kalp atışım hızlandı."


translate turkish day3_amulet_after_d33d60bd:



    voice "voice/anton/3day/064 Ho.ogg"
    Ant "Tabii, sağ ol."


translate turkish day3_amulet_after_2baf87f3:


    "Polina kikirdedi."


translate turkish day3_polinahall_amuletfox_f2d44a56:



    voice "voice/Polina/3day/27 A.ogg"
    Pol "Aslında... Defterimde birçok kişinin sırrı var!"


translate turkish day3_polinahall_amuletfox_2587a07d:



    voice "voice/Polina/3day/28 Na.ogg"
    Pol "Biz kızların ne düşündüğünü bilmesen daha iyi."


translate turkish day3_polinahall_amuletfox_dc447d71:


    "Benimle şakalaşırcasına deftere uzandı. Polina engel olmayı denese de elimdeki defteri diğer elime pasladım."


translate turkish day3_polinahall_amuletfox_2249b1f4:


    "Yüzümü okşayan ipeksi saç telleri burnumu gıdıkladı."


translate turkish day3_polinahall_amuletfox_9d1a7e00:


    "O an tüm dünyamı saran mis gibi, çekici, cıvıl cıvıl bir koku aldım."


translate turkish day3_polinahall_amuletfox_fc9f8f32:


    "Keşke bu kokuyu bir şekilde saklayabilseydim!"


translate turkish day3_polinahall_amuletfox_80109d1f:


    "Başım dönmüştü ancak kafamı toplayıp Üsteğmen Tihonov'u anımsatan bir ses tonuyla konuştum:"


translate turkish day3_polinahall_amuletfox_b5c36104:



    voice "voice/anton/3day/065 Va.ogg"
    Ant "Anketiniz, delil olarak büyük önem teşkil ediyor. Bu yüzden korkarım ki incelemek üzere buna el koymak zorundayım."


translate turkish day3_polinahall_amuletfox_a924f44a:


    "Polina ağzını örtüp korkmuş numarası yaptı."


translate turkish day3_polinahall_amuletfox_ff0b887a:



    voice "voice/Polina/3day/29 E.ogg"
    Pol "Peki ya delil gizlemenin cezası nedir?"


translate turkish day3_polinahall_amuletfox_61544d90:



    voice "voice/anton/3day/066.S.ogg"
    Ant "Onu dava sürecinde kararlaştıracağız."


translate turkish day3_polinahall_amuletfox_7844f50b:



    voice "voice/Polina/3day/30 S.ogg"
    Pol "Teslim oluyorum, memur bey."


translate turkish day3_polinahall_amuletfox_2993f416:



    voice "voice/Polina/3day/31 T.ogg"
    Pol "Yalnız, yazılanları okumayacağınıza söz verin."


translate turkish day3_polinahall_amuletfox_33c34c35:



    voice "voice/Polina/3day/32 Z.ogg"
    Pol "İçerisinde çok gizli bilgiler var."


translate turkish day3_polinahall_amuletfox_1828e250:



    voice "voice/anton/3day/067 B.ogg"
    Ant "Üzgünüm ancak Bay Petrov'a âşık birileri var mıymış, araştırmam gerekiyor."


translate turkish day3_polinahall_amuletfox_e07636fd:


    "Polina kahkahayı basıp göğsüme kapandı. O an altında minik damarlar yatan, neredeyse şeffaf gibi görünen süt gibi teninin ve saçlarının kokusu üstüme sindi."


translate turkish day3_polinahall_amuletfox_6bbaec61:


    "Nefesi, tavada cızırdayan bir parça tereyağı gibi sıcacıktı."


translate turkish day3_polinahall_amuletfox_05c5aa79:



    voice "voice/Polina/3day/33 T.ogg"
    Pol "O zaman bu bilgileri saklı tutacağınıza yemin edin."


translate turkish day3_polinahall_amuletfox_05915cdf:



    voice "voice/anton/3day/068 Ch.ogg"
    Ant "Rozetim üstüne yemin ederim!"


translate turkish day3_polinahall_ring_1a839ed7:



    voice "voice/Polina/3day/34 At.ogg"
    Pol "Ama şimdi derse yetişmemiz lazım, Antoşa."


translate turkish dev_day3_anketa_after_7f92231e:


    "Dersteyken defteri çıkardım."


translate turkish dev_day3_anketa_after_e45e7040:


    "Hassas bir hazineymiş gibi büyük özenle davrandım."


translate turkish dev_day3_anketa_after_ea6a5bb6:


    "Başkalarının ne yazdığını görmek için sayfaları karıştırmaya başladım."


translate turkish dev_day3_anketa_after_f11a34da:


    "Sayfaların arasında Romka'nın biçimsiz el yazısına rastladığımda epey şaşırdım."


translate turkish dev_day3_anketa_after_2bec8d72:


    "Harfleri, sanki biçimsiz olmalarından utanıp karelerin dışına taşmıştı."


translate turkish dev_day3_anketa_after_35eb0279:


    "Ağır abi Romka, nasıl olmuş da böyle bir zırvaya vakit ayırmış?"


translate turkish dev_day3_anketa_after_48fc44ef:


    "Romka'nın en sevdiği çizgi filmin \"Karakanat Ördek\" değil de \"Varyemez Amca\" olduğunu görünce kıs kıs güldüm."


translate turkish dev_day3_anketa_after_cca373f4:


    "Diğer sınıfların birinden, öğrencilerine Andreev'in \"Isırıkçı\"sından kesitler okuyan bir öğretmenin sesi geliyordu. Uzaktan gelen bu sese kulağımı tıkadım."


translate turkish dev_day3_anketa_after_e1d22ccc:


    "Polina'nın sayfası, çiçek çizimleri ve \"Cool Girl\" dergisinden kesilen kupürlerle süslenmişti."


translate turkish dev_day3_anketa_after_2e90cde8:


    "En sevdiği müzisyen Schubert'miş."


translate turkish dev_day3_anketa_after_c808c3d6:


    "En iyi dostu ise dedesi."


translate turkish dev_day3_anketa_after_0101639e:


    "Hobisi -tahmin ettiğim gibi- keman çalmak değilmiş ama ne tuhaftır ki \"dinlemek\"miş."


translate turkish dev_day3_anketa_after_2b7e3e69:


    "Bu kadar sıradan bir eylem, hobi sayılır mı ki?"


translate turkish dev_day3_anketa_after_f369ca00:


    "Diğer öğrencilerin önünde oturan Polina'ya baktım. Derste anlatılanları pürdikkat not alıyordu."


translate turkish dev_day3_anketa_after_e71e71c0:


    "Sayfaları çevirip kendime boş bir yer buldum ve kalemi elime aldım."


translate turkish dev_day3_anketa_after_f5d8ef70:


    "Anton Petrov. 6-B."


translate turkish dev_day3_anketa_after_e287da2e:


    "En sevdiğim müzisyene karar vermekte epey zorlandım, ta ki kliplerinde havalı dansçıların oynadığı meşhur pop grubu {u}Car-Man{/u}'i hatırlayana dek."


translate turkish dev_day3_anketa_after_c45980e9:


    "En sevdiğim özel gün... Bu kolay, yılbaşı."


translate turkish dev_day3_anketa_after_519220e0:


    "Hobim, çizim."


translate turkish dev_day3_anketa_after_955764f1:


    "En büyük hayalim... Disneyland'e gitmek, diyelim."


translate turkish dev_day3_anketa_after_8eadd7a5:


    "Kahramanım..."


translate turkish dev_day3_anketa_after_d903b6c7:


    "Hiç düşünmeden \"Ba\" yazıverdim."


translate turkish dev_day3_anketa_after_1f21c3d9:


    "O iki harften sonra duraksadım. Ya benden sonra bu defteri okuyanlar, yanıtımı gülünç ve aptalca bulursa?"


translate turkish dev_day3_anketa_after_1e9b9018:


    "Bir süre düşündükten sonra, her aklıma geleni kağıda yazmamaya karar verdim."


translate turkish dev_day3_anketa_after_e7258088:


    "Böylelikle \"Ba\"yı \"Örümcek ABam\"a çevirdim. Yazım hatası yapmıştım ama önemli değildi."


translate turkish dev_day3_anketa_after_8531b6b0:


    "En korktuğum şey, he?"


translate turkish dev_day3_anketa_after_a0dd1eb4:


    "Önemsediğim birisini kaybetmek, yazıverdim."


translate turkish dev_day3_anketa_after_1f023c1e:


    "Telefon numaram..."


translate turkish dev_day3_anketa_after_20732a48:


    "Gizlimiz, saklımız yok: 3 03 95."


translate turkish dev_day3_anketa_after_1b843023:


    "En sevdiğim çizgi film..."


translate turkish dev_day3_anketa_after_ae39e5ff:


    "\"Transformers.\""


translate turkish dev_day3_anketa_after_f67c6a11:


    "En iyi arkadaşım..."


translate turkish dev_day3_anketa_after_e20ebf1a:


    "Bir süre tereddütte kalıp kalemimin kapağını kemirdim."


translate turkish dev_day3_anketa_after_3f58d5b0:


    "Ağaçların ardında süzülen, karanlıkların arasından coşkuyla gülen Alisa'yı düşündüm."


translate turkish dev_day3_anketa_after_5215dbd2:


    "Onu bir haftadır görmemiş, hatta onun için endişelenmiştim."


translate turkish dev_day3_anketa_after_7ad99175:


    "Neticede geceleri ormanda kol gezen o dev canavarın beni parça pinçik etmesine Alisa engel olmuştu."


translate turkish dev_day3_anketa_after_8f045cae:


    "Önceden Romka ile Byaşa'ya maskeli kızdan bahsettiğimde bana tuhaf tuhaf bakmışlardı."


translate turkish dev_day3_anketa_after_c7ef351e:


    "Acaba şu an ne âlemde?"


translate turkish dev_day3_anketa_after_2e530719:


    "\"En iyi arkadaşın?\" sorusunu dışımdan okudum. Basit olduğu kadar önemli bir soruydu."


translate turkish dev_day3_anketa_after_b466ada4:


    "Yanıtım üç harften oluşuyordu. Karelerin dışına taşırmadan, özenle yazdım:"


translate turkish dev_day3_anketa_after_30bf1b93:


    "\"Sen.\""


translate turkish dev_day3_anketa_after_5ff4fe07:


    "Okuldan koşa koşa çıkarken \"sen\" diye sayıklayıp durdum."


translate turkish dev_day3_anketa_after_d7598c5b:


    "İnsanı ferahlatan buz gibi hava, yanaklarımı pancar gibi kızartmıştı."


translate turkish dev_day3_anketa_after_5e46e232:


    "Dışarısı aydınlıktı. Güneş, yumurtanın sarısı gibi görünüyordu."


translate turkish dev_day3_anketa_after_44791357:


    "Yolu kaplayan kar tabakası, güneşin altında gümüş gibi parıldıyordu. Kör edici aydınlığa gözlerimi kısıp gülümsedim."


translate turkish dev_day3_anketa_after_075fd31f:


    "Aynı zamanda içimde beni dürtükleyen büyülü bir his vardı."


translate turkish dev_day3_anketa_after_d23f8072:


    "Çünkü arkadaşlıklar çok daha güzel noktalara evrilebilir."


translate turkish dev_day3_anketa_after_c939b9f2:


    "Bunun yanıtı kardeşimdi, bu yüzden adını karelerin dışına taşırmadan, özenle yazdım:"


translate turkish dev_day3_anketa_after_c3ff8367:


    "\"Olya.\""


translate turkish dev_day3_anketa_after_7f5c998e:


    "Okuldan usulca çıkarken \"Olya\" adını sayıklayıp durdum."


translate turkish dev_day3_anketa_after_55fdf8f0:


    "Defterimde canım kardeşimi sevindirmek için daha yeni çizdiğim tatlı mı tatlı bir ejderha vardı."


translate turkish dev_day3_anketa_after_4937b9c6:


    "Karanlığın ve her türlü kandırmacanın hüküm sürdüğü bu diyarda kardeşimin desteği, çizime devam etmem ve insanlığa olan umudumu yitirmemem konusundaki yegane ilham kaynağımdı."


translate turkish dev_day3_anketa_after_d7598c5b_1:


    "İnsanı ferahlatan buz gibi hava, yanaklarımı pancar gibi kızartmıştı."


translate turkish dev_day3_anketa_after_5e46e232_1:


    "Dışarısı aydınlıktı. Güneş, yumurtanın sarısı gibi görünüyordu."


translate turkish dev_day3_anketa_after_44791357_1:


    "Yolu kaplayan kar tabakası, güneşin altında gümüş gibi parıldıyordu. Kör edici aydınlığa gözlerimi kısıp gülümsedim."


translate turkish dev_day3_anketa_after_8ca52407:


    "Artık gerçek bir dostum kalmadıysa ne yapayım yani?"


translate turkish dev_day3_anketa_after_aff56b60:


    "Beni bekleyen daha önemli bir şey; bana asla ihanet etmeyecek, zarar vermeyecek, yardımıma muhtaç biri vardı."


translate turkish dev_day3_anketa_after_884228e6:


    "\"Tek gerçek ailem, gerisi yalan.\" derdi babam da hep."


translate turkish day3_corner_fox_92851a1b:



    voice "voice/byasha/125 Tosh.ogg"
    Bya "Ne sırıtıyorsun Toşa?"


translate turkish day3_corner_fox_4ef8917f:


    "Gülüşüm boğazıma dizildi ve kızardım."


translate turkish day3_corner_fox_9b4fea9d:



    voice "voice/anton/3day/070 Aneg.ogg"
    Ant "Aklıma bir espri geldi de..."


translate turkish day3_corner_fox_9d3571b2:


    "Bahçenin orta yerinde dikilen Byaşa, botlarını buzun üzerinde kıpır kıpır sürüyordu."


translate turkish day3_corner_fox_4ce0fb50:



    voice "voice/byasha/126 Nu.ogg"
    Bya "Söyle de biz de gülelim he."


translate turkish day3_corner_fox_fe04b8aa:


    "Bugün kantinde duyduğum rastgele bir espriyi hafızamdan çekip Byaşa'ya pat diye söyleyiverdim."


translate turkish day3_corner_fox_f0ec7842:



    voice "voice/anton/3day/069 Ko.ogg"
    Ant "Bir elma neden diskoya gitmiş? Kurtlarını dökmek için."


translate turkish day3_corner_fox_c6a30e12:



    voice "voice/byasha/127 Yasno.ogg"
    Bya "Seni gidi {u}Petrosyan{/u}."


translate turkish day3_corner_fox_70213e20:



    voice "voice/byasha/128 NuIdem.ogg"
    Bya "Hadi gidelim he."


translate turkish day3_corner_fox_17f1ef2b:


    "Beni beklemeden okulun köşesine doğru ilerledi. Ben de kuşkuyla peşine takıldım."


translate turkish day3_corner_fox_bca22474:



    voice "voice/anton/3day/071 A.ogg"
    Ant "Nereye gidiyoruz?"


translate turkish day3_corner_fox_a711250f:



    voice "voice/byasha/129 Idem А.ogg"
    Bya "Görürsün he."


translate turkish day3_corner_fox_bbbc0907:



    voice "voice/byasha/130 mi.ogg"
    Bya "Artık sürü hâlinde takılıyor, birlikte ilerliyoruz."


translate turkish day3_corner_fox_d15ca125:



    voice "voice/byasha/131 Po.ogg"
    Bya "Şimdi de ufak bir işimiz var, yardımın lazım."


translate turkish day3_corner_fox_867c30bb:


    "Vücudumda deli ürpertiler geziyordu. Bu \"ufak bir iş,\" kulağıma pek tekin gelmemişti."


translate turkish day3_corner_fox_ceec2a79:


    "Hele ki bunu söyleyen kişi, lafının ardından tükürüyorsa ortada pis işler dönüyor demektir."


translate turkish day3_corner_fox_fc4bf575:


    "Eskiden yabancılar, ev telefonumuzu arayıp \"Babanı çağır bakayım, ufak bir iş konuşacağız.\" derdi."


translate turkish day3_corner_fox_2ed09bd9:


    "Byaşa arkasını döndü. Sımsıkı kapüşonuyla astronotu anımsatıyordu."


translate turkish day3_corner_fox_8784baf2:


    "Byaşa bir ses olsaydı kesinlikle bir gözcünün sağır edici uyarı ıslığı olurdu."


translate turkish day3_corner_fox_0d73765d:


    "O an, tekinsiz bir duruma sürükleniyor olduğum düşüncesiyle dizlerim titremeye başladı."


translate turkish day3_corner_fox_2a9ce2a6:


    "Tihonov'un sert bakışlarla beni hapse tıktığı, babamın öfkeyle demir parmaklıkları dövüşü, annem ile Olya'nın ağlayışı birden gözümün önüne geldi."


translate turkish day3_corner_fox_b88cb265:


    "Neyse ki arka bahçede kimse yoktu."


translate turkish day3_corner_fox_c0858647:


    "Tabii çatık kaşlı Romka hariç."


translate turkish day3_corner_fox_a781b17d:


    "Bacaklarını aralayıp sağ elini ardına saklamış, öylece dikiliyordu."


translate turkish day3_corner_fox_35ef256d:


    "Herhalde elinde bir çakı, kurbanının nabzına konmayı bekleyen çelik bir ölüm kelebeği vardı."


translate turkish day3_corner_fox_232991b5:


    "Romka kuruyan dudaklarını sımsıkı kapatmış, bir sağı solu bir beni kesiyordu."


translate turkish day3_corner_fox_083c67cf:


    "Hayırdır?"


translate turkish day3_corner_fox_69df07b3:


    "Romka, aklımı okumuşçasına ağzını açtı:"


translate turkish day3_corner_fox_4b894ea1:



    voice "voice/romka/3day/01 Ct.ogg"
    Rom "Hayırdır?"


translate turkish day3_corner_fox_abf41794:



    voice "voice/byasha/132 Niche.ogg"
    Bya "Hiç be, gezmeye çıktık da."


translate turkish day3_corner_fox_aa90ad60:


    "Byaşa'nın ses tonu çatallı ve alaycıydı."


translate turkish day3_corner_fox_45dee8b5:



    voice "voice/romka/3day/02 Pr.ogg"
    Rom "Gezecek yer mi bulamadınız?"


translate turkish day3_corner_fox_52b909ad:



    voice "voice/byasha/134 A mne.ogg"
    Bya "Canımız burada gezmek istedi, değil mi bebeğim?"


translate turkish day3_corner_fox_02ee3918:


    "\"Bebeğim\" mi? Ben miyim o?"


translate turkish day3_corner_fox_b607d0be:


    "Şaşkınlıktan boğazım düğümlenmişti."


translate turkish day3_corner_fox_be4f1a0c:


    "Belalı yeni dostlarımın canlandırdığı bu tuhaf sahneyi öylece izlemeye devam ettim."


translate turkish day3_corner_fox_6d19609d:



    voice "voice/romka/3day/03 Vi.ogg"
    Rom "Al işte, korkuttun kızı."


translate turkish day3_corner_fox_a94fd886:



    voice "voice/byasha/3day/136 Atebe.ogg"
    Bya "Sana ne lan, dallama? Başına bir iş gelmeden defol he."


translate turkish day3_corner_fox_f36f79ad:


    "Duyduklarımı sindirmeye çalışıyordum. Byaşa az önce Romka'ya dallama mı dedi? Aklını mı kaçırdı bu çocuk?"


translate turkish day3_corner_fox_dc1e2187:



    voice "voice/anton/3day/072 Pa.ogg"
    Ant "Beyler..."


translate turkish day3_corner_fox_6019df39:


    "Güç bela çıkan sesimi duymazdan gelen Byaşa, Roma'ya yaklaşıp tuhaf ve gülünç bir yumruk savurdu."


translate turkish day3_corner_fox_286f27a3:


    "Romka sağ elini ardından çıkarmadan boştaki eliyle gelen yumruğu engelledi."


translate turkish day3_corner_fox_8c7f0c7e:


    "Annemin bayılarak izlediği o Hint filmlerindeki aktörler bile daha inandırıcı dövüşüyordu."


translate turkish day3_corner_fox_0e9e3249:


    "Romka'nın yumruğunun isabet etmediğini görmeme rağmen Byaşa inlemeye başladı."


translate turkish day3_corner_fox_026c06af:



    voice "voice/byasha/138 Ai.ogg"
    Bya "Ay, ay, ay, canım acıyor! Beyin sarsıntısı geçiriyorum galiba!"


translate turkish day3_corner_fox_d01bb4fd:


    "Romka, Byaşa'nın dizine tekme atıp onu iniltiler içerisinde alaşağı etti."


translate turkish day3_corner_fox_0e42e060:


    "Ardından bana yaklaşmakta olan Romka'yı gözümü dahi kırpmadan izledim."


translate turkish day3_corner_fox_28c50920:


    "Dirseğini kıpırdatıp elini ardından yavaşça çıkarmaya başladı. Olduğum yere resmen kök salmıştım."


translate turkish day3_corner_fox_8cee35ae:


    "Şimdi çakıyı göreceğim ben."


translate turkish day3_corner_fox_68d03680:


    "İşte geliyor!"


translate turkish day3_corner_fox_58ed6067:


    "Romka'nın elini ardından çıkarmasıyla dişlerim takırdadı."


translate turkish day3_corner_fox_775583cc:


    "Bu buz gibi havada nereden çıktığını bilmediğim bir kardelen demeti, burnumun dibinde bitiverdi."


translate turkish day3_corner_fox_920a806c:


    "Bu ne şimdi? Çiçek ne alaka?"


translate turkish day3_corner_fox_fcffa732:



    voice "voice/romka/3day/05 Poz.ogg"
    Rom "Sana eşlik edeyim."


translate turkish day3_corner_fox_d2867a7f:



    voice "voice/romka/3day/06 Ato.ogg"
    Rom "Biliyorsun, bu civarda... Her türlü sapık geziyor."


translate turkish day3_corner_fox_e7b2cd18:



    voice "voice/byasha/3day/141 N.ogg"
    Bya "Ne yani? Benim gibi sapıklar artık hava almaya da mı çıkamayacak, he?"


translate turkish day3_corner_fox_82a2a110:



    voice "voice/romka/3day/07 Xr.ogg"
    Rom "Senden sapık olmazmış Byaşa. Baksana, daha Toha'yı korkutamadın."


translate turkish day3_corner_fox_55dd4bdc:



    voice "voice/romka/3day/08 A ona.ogg"
    Rom "Ama benim kız, bu numarayı kesin yutacaktır."


translate turkish day3_corner_fox_fcb93ad0:


    "Düğümlenen boğazım anca çözüldü."


translate turkish day3_corner_fox_1d863ed1:



    voice "voice/anton/3day/073 Ona.ogg"
    Ant "Senin kız da kim? Neyin peşindesiniz?"


translate turkish day3_corner_fox_e3062979:


    "Romka, burnundan verdiği solukla çiçeklerin üzerindeki kar tanelerini dağıttı."


translate turkish day3_corner_fox_d79c4337:



    voice "voice/romka/3day/09 Da.ogg"
    Rom "Ufak bir prova yapıyoruz kanka."


translate turkish day3_corner_fox_74c2daa9:



    voice "voice/romka/3day/10 Ho.ogg"
    Rom "Senin de tepkini merak ettik."


translate turkish day3_corner_fox_800ceff3:


    "Byaşa ayağa kalkıp silkelendi."


translate turkish day3_corner_fox_4b0d2aa7:



    voice "voice/byasha/3day/142 Da.ogg"
    Bya "Romka bir güzele sırılsıklam aşık da."


translate turkish day3_corner_fox_f8c28d6c:



    voice "voice/byasha/3day/143 V.ogg"
    Bya "Bu çiçekleri de karları eşeleyip bulduk he."


translate turkish day3_corner_fox_6b6c70d2:



    voice "voice/romka/3day/11 Pa.ogg"
    Rom "Bir sus be!"


translate turkish day3_corner_fox_34f568f3:



    voice "voice/romka/3day/12Ya.ogg"
    Rom "Öyle işte... Bir kızı tavlamak istiyorum da..."


translate turkish day3_corner_fox_d52320f8:



    voice "voice/romka/3day/13 Ra.ogg"
    Rom "Böyle bir oyun hazırladık, yoksa ona yanaşmamın imkanı yok."


translate turkish day3_corner_fox_1ab4bb1d:



    voice "voice/romka/3day/14 Ti.ogg"
    Rom "O dışarıda kendi hâlinde yürürken Byaşa denen mankafa, ona sarkıntılık edecek."


translate turkish day3_corner_fox_b5df61c6:


    "Byaşa sıkkınlıkla homurdandı."


translate turkish day3_corner_fox_c07ab6a6:



    voice "voice/byasha/3day/144 S.ogg"
    Bya "Ben mankafa değilim!"


translate turkish day3_corner_fox_acdda043:



    voice "voice/romka/3day/15 Nu.ogg"
    Rom "Ben de o noktada devreye girip bam diye kızı kurtaracağım!"


translate turkish day3_corner_fox_ad806ef6:



    voice "voice/romka/3day/16 No.ogg"
    Rom "Gel gör ki Byaşa, rol kesmeyi bilmiyormuş."


translate turkish day3_corner_fox_8c35158b:



    voice "voice/romka/3day/17 Da.ogg"
    Rom "Bir de sen sapık olmayı dene, hadi."


translate turkish day3_corner_fox_cce0919e:



    voice "voice/anton/3day/074 Ya.ogg"
    Ant "Ben mi?"


translate turkish day3_corner_fox_50e67497:



    voice "voice/romka/3day/18 Nu.ogg"
    Rom "Evet, sen."


translate turkish day3_corner_fox_9f76a0c8:



    voice "voice/romka/3day/19 Kak.ogg"
    Rom "Televizyonda gördüm. Sapıklar hep sessiz, utangaç tipler oluyormuş."


translate turkish day3_corner_fox_ca74ddaa:



    voice "voice/romka/3day/20 Vot.ogg"
    Rom "Yani senin gibi."


translate turkish day3_corner_fox_6e24c8d7:



    voice "voice/romka/3day/21 A.ogg"
    Rom "Hem dedikoducu Katya sağ olsun, bütün okul Baburin'i senin geberttiğini sanıyor."


translate turkish day3_corner_fox_27f4fdc0:



    voice "voice/romka/3day/22 Da.ogg"
    Rom "Hadi be Toha."


translate turkish day3_corner_fox_b4c686f4:


    "Rahatlamıştım. Tekinsiz bir durum yokmuş, ortada dönen oyun kız meselesiymiş."


translate turkish day3_corner_fox_71a9cbfc:



    voice "voice/anton/3day/075 A.ogg"
    Ant "Ne yapmam lazım?"


translate turkish day3_corner_fox_3c68ca2e:



    voice "voice/romka/3day/23 T.ogg"
    Rom "Byaşa'nın attığı taklaları gördün, değil mi?"


translate turkish day3_corner_fox_e8ce79fa:



    voice "voice/romka/3day/24 Tip.ogg"
    Rom "Bana diklenerek yaklaşacaksın, hatta böğrüme yumruk da atabilirsin."


translate turkish day3_corner_fox_a50403f4:



    voice "voice/romka/3day/25 A.ogg"
    Rom "Ben de 'ha' yapacağım, karların arasına uçacaksın."


translate turkish day3_corner_fox_f9cf9e2d:



    voice "voice/anton/3day/076.Nu.ogg"
    Ant "Deneyelim madem."


translate turkish day3_corner_fox_6ec8fd7f:


    "Roma coşuverdi."


translate turkish day3_corner_fox_4c7ac33a:



    voice "voice/romka/3day/26 O.ogg"
    Rom "Güzel!"


translate turkish day3_corner_fox_5bed8b43:



    voice "voice/romka/3day/27 B.ogg"
    Rom "Byaşa, senaryo değişti. Sen şimdi benim kızı oynayacaksın."


translate turkish day3_corner_fox_9cc4d024:



    voice "voice/romka/3day/28 G.ogg"
    Rom "Yürü!"


translate turkish day3_corner_fox_de0afb38:


    "Byaşa dudağını büzüp ayağını sürüyerek ilerledi."


translate turkish day3_corner_fox_26974d7c:



    voice "voice/byasha/3day/145 Ya.ogg"
    Bya "Ben bir kızım, güzel bir kızım, yürüyüşe çıktım, lalala!"


translate turkish day3_corner_fox_50f170e0:



    voice "voice/romka/3day/29 To.ogg"
    Rom "Sıra sende Toha."


translate turkish day3_corner_fox_6b9cd3c5:


    "Gülmemek için kendimi zor tutarak Romka'ya yaklaştım."


translate turkish day3_corner_fox_f7c96b54:


    "Kaşlarını çatmış, elini tekrardan arkasına götürmüştü. On üzerinden onluk bir aktördü."


translate turkish day3_corner_fox_1c3e46ef:



    voice "voice/anton/3day/077 Ona.ogg"
    Ant "Kız benim!"


translate turkish day3_corner_fox_936edeb9:



    voice "voice/romka/3day/30 Ris.ogg"
    Rom "Hodri meydan!"


translate turkish day3_corner_fox_582f54f6:


    "Dostuma bir yumruk sallamayı denedim. Yumruğum, üzerindeki deri ceketi sıyırıp geçse de Romka, birden kendini yerde buluverdi."


translate turkish day3_corner_fox_8792404c:


    "Tabii ki attığım gülünç yumruğun etkisiyle değil ancak buzda ayağı kayıp düşmüştü."


translate turkish day3_corner_fox_76c4b8e5:


    "Elini ardından çıkarmaya fırsat bile bulamadan bütün ağırlığıyla sırtüstü çakılmıştı."


translate turkish day3_corner_fox_509e2bd0:


    "Ezilen çiçeklerden dökülen yapraklar da kara yapışıp kalmıştı."


translate turkish day3_corner_fox_d25362aa:


    "Aceleyle yardıma koştum."


translate turkish day3_corner_fox_32c05105:



    voice "voice/romka/3day/32 Oi.ogg"
    Rom "Ha siktir... Dur biraz, kaldırma."


translate turkish day3_corner_fox_33596420:



    voice "voice/anton/3day/078 N.ogg"
    Ant "Bir yerin kırılmadı, değil mi?"


translate turkish day3_corner_fox_cecbc0c2:


    "Roma nazikçe bileğini yokladı."


translate turkish day3_corner_fox_7972a3da:



    voice "voice/romka/3day/33 Ta.ogg"
    Rom "Yok ama burkuldu galiba."


translate turkish day3_corner_fox_1d27cf23:



    voice "voice/byasha/3day/146 L.ogg"
    Bya "Buz tut, iyi gelir he."


translate turkish day3_corner_fox_f403cbda:



    voice "voice/romka/3day/34 Te.ogg"
    Rom "Ben sana bir şey tutturacağım da..."


translate turkish day3_corner_fox_fd7d4750:



    voice "voice/romka/3day/35 O.ogg"
    Rom "Buz mu olur, bilemem."


translate turkish day3_corner_fox_06560567:


    "Doğrulup çiçekleri toplarken Romka'nın neşesi çoktan geri gelmişti."


translate turkish day3_corner_fox_4f0a95c9:



    voice "voice/romka/3day/37 d.ogg"
    Rom "Öf, benim kızın önünde de böyle uçarsam onu anca rüyamda görürüm."


translate turkish day3_corner_fox_5244e143:



    voice "voice/anton/3day/079 Da.ogg"
    Ant "Hadi, bir daha deneyelim."


translate turkish day3_corner_fox_5023da74:


    "Roma teklifimi reddedercesine kafa salladı."


translate turkish day3_corner_fox_2a5bf464:



    voice "voice/romka/3day/38 V.ogg"
    Rom "Akşama elim iyileşsin de..."


translate turkish day3_corner_fox_1691b0fb:



    voice "voice/romka/3day/39 N.ogg"
    Rom "Okulun ilk kemancısının önünde sıçıp batırmak istemem."


translate turkish day3_corner_fox_3debf21b:



    voice "voice/anton/3day/080 Dog.ogg"
    Ant "Pek..."


translate turkish day3_corner_fox_7ef34a77:


    "Lafımı tamamlayamadan kalakaldım."


translate turkish day3_corner_fox_cb9f1aea:


    "O an taşlar yerine oturmuş, olup biteni anlamıştım."


translate turkish day3_corner_fox_8d89cc2c:


    "Romka'nın ara ara Polina'yı kestiğini hatırladım."


translate turkish day3_corner_fox_5b7a04cd:


    "Polina'nın anketindeki eğri büğrü yazıları aklıma geldi. Niye daha yakından incelememiştim ki?"


translate turkish day3_corner_fox_68075fe5:


    "Birisi kafama koca bir tokmakla vurup beni yerin dibine gömmüş gibi hissettim."


translate turkish day3_corner_fox_e88f3890:


    "Polina... Romka'nın yönettiği bu oyunun başrolü oydu."


translate turkish day3_corner_fox_2b0a2a03:


    "Ben ise dış kapının dış mandalından ibarettim."


translate turkish day3_corner_fox_ac9b0a89:


    "Dalgınlıkla mırıldandım:"


translate turkish day3_corner_fox_f4203830:



    voice "voice/anton/3day/081D.ogg"
    Ant "Pekala."


translate turkish day3_corner_fox_bba059f1:



    voice "voice/romka/3day/40 V.ogg"
    Rom "Aynen öyle, işte Voltran takımı!"


translate turkish day3_corner_fox_da76c484:



    voice "voice/romka/3day/41 Od.ogg"
    Rom "Hepimiz birimiz..."


translate turkish day3_corner_fox_083063b0:



    voice "voice/byasha/3day/147 I.ogg"
    Bya "Birimiz hepimiz için!"


translate turkish day3_corner_fox_15d75673:



    voice "voice/romka/3day/42 Z.ogg"
    Rom "Kes lan!"


translate turkish day3_corner_fox_4c917114:



    voice "voice/romka/3day/43 E.ogg"
    Rom "Antoha, olur da başın sıkışırsa bana gelebilirsin."


translate turkish day3_corner_fox_b59b9041:



    voice "voice/romka/3day/44 A.ogg"
    Rom "Hadi bakalım!"


translate turkish day3_corner_fox_b60697b1:



    voice "voice/romka/3day/45 V.ogg"
    Rom "Akşamleyin seni almaya geliriz."


translate turkish day3_corner_notfox_61086ba3:



    voice "voice/byasha/3day/148 S.ogg"
    Bya "Ne sırıtıyorsun lan?"


translate turkish day3_corner_notfox_1704b999:


    "Hissiz dudaklarım aniden büzüştü."


translate turkish day3_corner_notfox_9d3571b2:


    "Bahçenin orta yerinde dikilen Byaşa, botlarını buzun üzerinde kıpır kıpır sürüyordu."


translate turkish day3_corner_notfox_6af2c672:



    voice "voice/anton/3day/082 Ya.ogg"
    Ant "Sırıtmıyorum."


translate turkish day3_corner_notfox_df2b68fa:


    "Geçiştirip yoluma gitmeye çalışsam da nafile."


translate turkish day3_corner_notfox_360f357a:


    "Alaca karanlık çökerken bahtsız bir bedevi gibi gafil avlanmıştım."


translate turkish day3_corner_notfox_99447d0e:



    voice "voice/byasha/3day/149 To.ogg"
    Bya "Acelen mi var, he?"


translate turkish day3_corner_notfox_2050b82c:



    voice "voice/anton/3day/083 N.ogg"
    Ant "Biraz, babam beni bekliyor da."


translate turkish day3_corner_notfox_bfd2ed86:



    voice "voice/byasha/3day/150 Ya.ogg"
    Bya "Babana {u}çağrı{/u} atar, gelmeyeceğini söyleriz. Ne olacak, he?"


translate turkish day3_corner_notfox_4e20cfc8:


    "Gözüm seğiriyor, soğuk terler döküyordum."


translate turkish day3_corner_notfox_0fe81a55:



    voice "voice/byasha/3day/151 Ed.ogg"
    Bya "Hadi, gidelim. Ufak bir işimiz var he."


translate turkish day3_corner_notfox_b213b01e:


    "Vücudumda delice ürpertiler geziyordu."


translate turkish day3_corner_notfox_df66faee:


    "Bu \"ufak bir iş,\" kulağıma pek tekin gelmemişti."


translate turkish day3_corner_notfox_ceec2a79:


    "Hele ki bunu söyleyen kişi, lafının ardından tükürüyorsa ortada pis işler dönüyor demektir."


translate turkish day3_corner_notfox_fc4bf575:


    "Eskiden yabancılar, ev telefonumuzu arayıp \"Babanı çağır bakayım, ufak bir iş konuşacağız.\" derdi."


translate turkish day3_corner_notfox_2ed09bd9:


    "Byaşa arkasını döndü. Sımsıkı kapüşonuyla astronotu anımsatıyordu."


translate turkish day3_corner_notfox_63d6cecd:


    "Byaşa bir ses olsaydı kesinlikle bir gözcünün sağır edici uyarı ıslığı olurdu."


translate turkish day3_corner_notfox_b88cb265:


    "Neyse ki arka bahçede kimse yoktu."


translate turkish day3_corner_notfox_c0858647:


    "Tabii çatık kaşlı Romka hariç."


translate turkish day3_corner_notfox_02bbfa4d:


    "Bacaklarını aralayıp sağ elini ardına saklamış, öylece dikiliyordu."


translate turkish day3_corner_notfox_9fa11c47:


    "Romka kuruyan dudaklarını sımsıkı kapatmış, bir sağı solu bir beni kesiyordu."


translate turkish day3_corner_notfox_bbb85dc9:


    "Romka'nın beni Polina'yla görmemiş olmasını büyük içtenlikle diliyordum."


translate turkish day3_corner_notfox_65a4dec4:



    voice "voice/byasha/3day/152 Pri.ogg"
    Bya "Geldik işte he."


translate turkish day3_corner_notfox_0aa923e8:



    voice "voice/romka/3day/46 Vi.ogg"
    Rom "Görmediğimi sanma."


translate turkish day3_corner_notfox_18840639:



    voice "voice/romka/3day/47 Nu.ogg"
    Rom "Vay, hoş geldin Antoşa!"


translate turkish day3_corner_notfox_a9677707:



    voice "voice/anton/3day/084 Ch.ogg"
    Ant "Ne istiyorsun?"


translate turkish day3_corner_notfox_241fc610:


    "Ardından ağır bir hareketle incecik, yırtıcı bir çakı çıkardı."


translate turkish day3_corner_notfox_426e4a18:


    "Bu kelebek çakı, kurbanının nabzına konmayı bekleyen çelik bir ölüm kelebeğiydi."


translate turkish day3_corner_notfox_83b76614:


    "İstemsizce geri çekilmemle Byaşa'ya tosladım. Romka'nın emir kulu beni geri tepti."


translate turkish day3_corner_notfox_533af75f:



    voice "voice/romka/3day/48 Am.ogg"
    Rom "Bir şeyi merak ettik de..."


translate turkish day3_corner_notfox_76a38d7a:



    voice "voice/romka/3day/49 T.ogg"
    Rom "Benimle veya Byaşa'yla bir sıkıntın var mı?"


translate turkish day3_corner_notfox_1788547f:


    "Romka bana bakıp pis pis sırıtarak sapsarı tırnağını kurcalamaya başladı."


translate turkish day3_corner_notfox_44223f11:



    voice "voice/romka/3day/50 Nu.ogg"
    Rom "Hani ormanda... Sana biraz kabalık ettik ya."


translate turkish day3_corner_notfox_b07911b6:



    voice "voice/byasha/3day/153 Sa А.ogg"
    Bya "Anamız babamız bizi böyle yetiştirmiş, ne yapacaksın?"


translate turkish day3_corner_notfox_9542c3e3:



    voice "voice/romka/3day/51 D.ogg"
    Rom "Aynen. Siz şehirlilere pek benzemeyiz."


translate turkish day3_corner_notfox_8fbc3731:



    voice "voice/romka/3day/52 V.ogg"
    Rom "Arada bir tersimiz tutuyor."


translate turkish day3_corner_notfox_da25c980:


    "Bakışlarım bıçağa sabitlenmiş hâlde kafamı salladım."


translate turkish day3_corner_notfox_078f5aca:



    voice "voice/romka/3day/53 Sk.ogg"
    Rom "Söyle bakalım, Antoşa..."


translate turkish day3_corner_notfox_c9a58729:



    voice "voice/romka/3day/54 Y.ogg"
    Rom "Geçen sefer seni çok hırpalamadım, değil mi?"


translate turkish day3_corner_notfox_5526c225:



    voice "voice/anton/3day/085 Da.ogg"
    Ant "Yok..."


translate turkish day3_corner_notfox_52fd82ce:



    voice "voice/romka/3day/55 Nu.ogg"
    Rom "Ha şöyle!"


translate turkish day3_corner_notfox_8377ba9e:



    voice "voice/romka/3day/55 A.ogg"
    Rom "Kafana vura vura seni aptal ettim de... Sana söylediğim iki çift lafı unuttun diye endişelendim."


translate turkish day3_corner_notfox_ebe1bf81:



    voice "voice/anton/3day/086 Ya.ogg"
    Ant "Unutmadım."


translate turkish day3_corner_notfox_c31e4a40:


    "Çakı, batan güneşin altında parıldıyordu. Aynı musibet ışığı Romka'nın gözlerinde de görebiliyordum."


translate turkish day3_corner_notfox_fa709f8b:


    "Bana yaklaştı."


translate turkish day3_corner_notfox_1c77e194:


    "Çakısı, montumu teğet geçti."


translate turkish day3_corner_notfox_47f9235a:


    "Tek bir hareketle elindeki keskin çelik, üzerimdeki kumaş parçasına saplanabilirdi, hele ki daha da derine inecek olursa..."


translate turkish day3_corner_notfox_effd6812:



    voice "voice/romka/3day/56 Na.ogg"
    Rom "Kuşlar bize dedi ki yine Polina'ya yanaşıyormuşsun."


translate turkish day3_corner_notfox_74e222c2:


    "O kadar korkmuştum ki Polina'nın kim olduğunu bile bir anlığına unutuverdim."


translate turkish day3_corner_notfox_bbf35f3f:


    "Beynim durmuş, dizlerimin bağı çözülmüştü."


translate turkish day3_corner_notfox_03a6a262:


    "Birden sınıf temsilcimiz, Romka'nın ardından ağır adımlarla çıkageldi."


translate turkish day3_corner_notfox_08ded944:



    voice "voice/kate/106 KA.ogg"
    Kate "Oo, bakıyorum da pek iyi anlaşıyorsunuz."


translate turkish day3_corner_notfox_65fd4ddd:



    voice "voice/romka/3day/57 Z.ogg"
    Rom "Sana borçlandım, Katya."


translate turkish day3_corner_notfox_65d089b7:



    voice "voice/kate/107 KA.ogg"
    Kate "Ay, olur mu hiç öyle şey, Romoçka? Ömrüm boyunca gerçek aşkı savunacağım!"


translate turkish day3_corner_notfox_bf1e6e65:



    voice "voice/kate/108 KA.ogg"
    Kate "Tabii, tabii!"


translate turkish day3_corner_notfox_2d65523d:


    "\"{i}Yemin ederim, seni öldüreceğim!{/i}\""


translate turkish day3_corner_notfox_3c7fb579:



    voice "voice/romka/3day/58 T.ogg"
    Rom "Duyamadım, Polina'ya yanaştın mı yanaşmadın mı?"


translate turkish day3_corner_notfox_77f5282f:



    voice "voice/anton/3day/087 M.ogg"
    Ant "Ben... Şey... Birlikte takılmıyoruz."


translate turkish day3_corner_notfox_d37ed9dc:



    voice "voice/romka/3day/59 B.ogg"
    Rom "Şimdi sana bu elimdekini takarsam görürsün takılmayı."


translate turkish day3_corner_notfox_7e9921e7:


    "Bıçağın sırtı, kolumdan yukarıya tırmanıp yakama yapıştı."


translate turkish day3_corner_notfox_c59eb11f:


    "Rüzgardan yüzümün donmasına rağmen şakağımdan bir boncuk ter süzülüverdi."


translate turkish day3_corner_notfox_65c1c71b:


    "O an taşlar yerine oturmuş, olup biteni anlamıştım."


translate turkish day3_corner_notfox_8d89cc2c:


    "Romka'nın ara ara Polina'yı kestiğini hatırladım."


translate turkish day3_corner_notfox_c28b16cc:


    "Polina'nın anketindeki eğri büğrü yazıları aklıma geldi. Niye daha yakından incelememiştim ki?"


translate turkish day3_corner_notfox_e4be2bd4:



    voice "voice/romka/3day/60 Ese.ogg"
    Rom "Bir daha Polina'ya yaklaştığını görürsem sana vurmakla kalmam."


translate turkish day3_corner_notfox_bc73088f:



    voice "voice/romka/3day/60 Us.ogg"
    Rom "Anladın mı?"


translate turkish day3_corner_notfox_4c776fe7:



    voice "voice/anton/3day/089 Da_l.ogg"
    Ant "Evet."


translate turkish day3_corner_notfox_39bdd3be:



    voice "voice/romka/3day/61 P.ogg"
    Rom "Hadi şimdi uza!"


translate turkish day3_corner_notfox_ce06fcac:


    "Çakıya öyle bir kilitlenmiştim ki Romka tekrar haykırdı."


translate turkish day3_corner_notfox_c7648417:



    voice "voice/romka/3day/62 Von.ogg"
    Rom "Uza!"


translate turkish day3_corner_notfox_f3fe10a1:


    "Bahçeden ayrılırken soğuk, keskin çakıyı düşünüp durdum."


translate turkish day3_corner_notfox_63d8c126:


    "Bu şerefsizlere verdiğim yemini bozacak cesaretim olup olmadığını sorguluyordum."


translate turkish day3_corner_notfox_bf9a99af:



    voice "voice/romka/3day/63Na.ogg"
    Rom "Anlayacağın dilden konuşayım madem."


translate turkish day3_corner_notfox_b7c0da96:


    "Bıçak ve kanat gibi ayrılan sapı, yoluna çıkan her şeyi kesip atan helikopter pervaneleri gibi döne döne tehlikeli bir dansa koyuldu."


translate turkish day3_corner_notfox_1e7aae31:


    "Savuşturmayı denesem de bıçağın keskin yüzü, omzumu sıyırdı."


translate turkish day3_corner_notfox_7f511f95:


    "Bıçağın tenime saplanıp açtığı taze yaranın kanla doluşuna dehşetle tanıklık ettim."


translate turkish day3_corner_notfox_643a22f4:


    "Adrenalinin verdiği gücün vücudumdan çekilmesiyle hissettiğim keskin acı, zavallı bir çığlığa dönüşüp dudaklarımın arasından firar etti."


translate turkish day3_corner_notfox_710b49b7:



    voice "voice/anton/3day/088 AAAAAA.ogg"
    Ant "Aaah!"


translate turkish day3_corner_notfox_4a9f0bea:


    "Romka bıçağı zorla çıkardığı gibi arkama bakmadan, kanayan yaramı örtmeye çalışarak kaçtım."


translate turkish day3_corner_notfox_91ef1037:



    voice "voice/romka/3day/65 Po.ogg"
    Rom "Sakın aklından çıkarma!"


translate turkish day3_corner_notfox_ace03eb1:



    voice "voice/romka/3day/66 Ant.ogg"
    Rom "Antoşa!"


translate turkish day3_corner_notfox_bf9a99af_1:



    voice "voice/romka/3day/63Na.ogg"
    Rom "Anlayacağın dilden konuşayım madem."


translate turkish day3_corner_notfox_b7c0da96_1:


    "Bıçak ve kanat gibi ayrılan sapı, yoluna çıkan her şeyi kesip atan helikopter pervaneleri gibi döne döne tehlikeli bir dansa koyuldu."


translate turkish day3_corner_notfox_a84d6691:


    "Savuşturmayı denesem de bıçağın keskin yüzü, omzumu sıyırdı."


translate turkish day3_corner_notfox_f76df969:


    "Sanki bu anı bekliyormuşçasına Polina'nın tılsımı, yakamın altından bıçağa doğru fırladı."


translate turkish day3_corner_notfox_82efa145:


    "Tılsımı boynumda tutan deri ip yüzünden pençe, hasmımın boynuna saplanmayıp pat diye göğsüme düştü."


translate turkish day3_corner_notfox_df2e0296:


    "Bu tılsım yüzünden öyle bir bıçak yiyecektim ki kanımda boğulmam çok sürmezdi."


translate turkish day3_corner_notfox_fa7f31cc:


    "Fakat nedense Romka, öylece dikilip bakakaldı."


translate turkish day3_corner_notfox_2e5516ff:


    "Çakısı aksiyona hazırdı ama kendisi, boynumdaki süs eşyasına kilitlenmişti. Bıyık altından homurdandı."


translate turkish day3_corner_notfox_7160c981:


    "Polina'nın hediyesi, Romka'yı çılgına çevirdiği kadar elini kolunu da bağlamıştı."


translate turkish day3_corner_notfox_e8346b0d:


    "Bu duraksama o kadar uzun sürdü ki Byaşa'nın keyfinin kaçtığı, asık suratından belliydi."


translate turkish day3_corner_notfox_922a4b86:


    "Yukarıdan bir pencere gıcırtısı duyuldu."


translate turkish day3_corner_notfox_e689620c:



    voice "voice/lydia/3day/08 Pyatifanov.ogg"
    Teacher "Pyatifanov!"


translate turkish day3_corner_notfox_2a0ea734:


    "O an hissettiğim adrenalinin etkisiyle havalara uçacakmışçasına süratle kaçtım."


translate turkish day3_corner_notfox_1957bf2b:


    "Romka aklını başına topladığında çoktan uzaklaşmıştım. Ardımdan korkunç bir tehdit savurdu:"


translate turkish day3_corner_notfox_91ef1037_1:



    voice "voice/romka/3day/65 Po.ogg"
    Rom "Sakın aklından çıkarma!"


translate turkish day3_corner_notfox_ace03eb1_1:



    voice "voice/romka/3day/66 Ant.ogg"
    Rom "Antoşa!"


translate turkish dev_d3_olyatalk_end_ac64a469:


    "İlaçlarımla içtiğim su, ağzımda leş gibi bir tat bırakmıştı."


translate turkish dev_d3_olyatalk_end_94278a10:


    "Yırtık bir bez ve tentürdiyotla pansuman yapılan yaram sızlıyordu."


translate turkish dev_d3_olyatalk_end_3e3ff7d5:


    "Annemle babama işin doğrusunu değil, ormanda keskin bir dala takıldığımı söylemiştim."


translate turkish dev_d3_olyatalk_end_9dbb44d3:


    "Sürekli meşgul olan ebeveynlerimden ilgi görmek için fırsat kolluyordum."


translate turkish dev_d3_olyatalk_end_1b82c94b:


    "Aklım fikrim Polina'daydı."


translate turkish dev_d3_olyatalk_end_8b6d1cd1:


    "Ancak Romka'nın tehditleri de aklımdan çıkmıyordu."


translate turkish dev_d3_olyatalk_end_6ab6e41b:


    "Ancak kötü adam rolü oynadığım oyun da aklımdan çıkmıyordu."


translate turkish dev_d3_olyatalk_end_6659d757:


    "Aklım başımdan gitmiş hâlde evde dolaşıyor, kardeşimin söylediği tek kelimeyi dahi anlamasam da kafa sallıyordum."


translate turkish dev_d3_olyatalk_end_e59e8152:


    "Olya durmadan konuşuyor, arada bir kollarını kaldırıp gülüyor, çok geçmeden susuverip annemin o meşhur huysuz bakışını atıyordu."


translate turkish dev_d3_olyatalk_end_d1d96c97:


    "Dinmek bilmeyen düşüncelerimin dedikoducu kadınlar gibi gagalayıp içerisinde beni mahkum tuttuğu beynimin odalarından kapı dışarı oluverdim."


translate turkish dev_d3_olyatalk_end_e9cd8dcd:


    "Kardeşime baktım. Olya, tıpkı annemin küçülmüş hâliydi."


translate turkish dev_d3_olyatalk_end_795cd405:


    "Daha doğrusu tavana doğru kaldırdığı kaşları ve gözdağı verircesine duruşuyla annemin buraya taşındıktan sonraki hâlini anımsatıyordu."


translate turkish dev_d3_olyatalk_end_8ef16303:



    voice "voice/olya/3day/02 Ti.ogg"
    Oly "Beni niye dinlemiyorsun?"


translate turkish dev_d3_olyatalk_end_d6707c40:


    "Neredeyse tüm boş zamanını birlikte geçirdiği kişinin yüz ifadesini taklit ederek bana birkaç kelime savurdu."


translate turkish dev_d3_olyatalk_end_9468b3fd:


    "Olya'nın yıllardır saçtığı ışığın esintilere karışıp uzun soluklu değişimler sonucunda giderek söndüğünü hissettim bir anlığına."


translate turkish dev_d3_olyatalk_end_544d919d:


    "Çok yakında benim güzel prensesim, içerisine hapsolduğu kuleyi koruyan ejderhanın ta kendisine dönüşecekti. Bunun düşüncesi, geleceğe dair içime korku salan her şeyden daha dehşet vericiydi."


translate turkish dev_d3_olyatalk_end_e6f43059:



    voice "voice/anton/3day/04 Ol.ogg"
    Ant "Olya, kusura bakma."


translate turkish dev_d3_olyatalk_end_b2cfae7b:



    voice "voice/anton/3day/05T.ogg"
    Ant "Dalmışım da kızmadın bana, değil mi?"


translate turkish dev_d3_olyatalk_end_7ac2570b:


    "Olya'nın dikkatini dağıtabilecek bir şeyler bulmak için bakışlarımı aç bir hayvan gibi bir o eşyadan diğerine çevirerek odaya göz gezdirdim."


translate turkish dev_d3_olyatalk_end_ae2de6bd:



    voice "voice/anton/3day/06 A.ogg"
    Ant "Hadi gel, Atari oynayalım!"


translate turkish dev_d3_olyatalk_end_4a13ca17:


    "Olya suratını assa da minik zümrüt gözlerinde ufak bir ilgi kıvılcımı parladı."


translate turkish dev_d3_olyatalk_end_ca63da58:


    "Karlar Kraliçesi'nin içindeki buzlar erimeye başlamıştı."


translate turkish dev_d3_olyatalk_end_3b7bf4e4:



    voice "voice/olya/3day/04 A.ogg"
    Oly "Ama ikinci kumandamız çalışmıyor ki."


translate turkish dev_d3_olyatalk_end_a66f4d92:



    voice "voice/olya/3day/05 A.ogg"
    Oly "Babamın da tamir edecek vakti yok."


translate turkish dev_d3_olyatalk_end_7f361827:



    voice "voice/anton/3day/07 M.ogg"
    Ant "Hım... Biz de ışın tabancasıyla oynarız."


translate turkish dev_d3_olyatalk_end_4ced8023:



    voice "voice/anton/3day/08 V.ogg"
    Ant "Ne oynamak istersin? Kovboyluyu mu ördekliyi mi?"


translate turkish dev_d3_olyatalk_end_33067940:



    voice "voice/olya/3day/06 Т.ogg"
    Oly "Sen ikisinde de benden iyisin ki."


translate turkish dev_d3_olyatalk_end_ccb42ec2:



    voice "voice/anton/3day/09 Da.ogg"
    Ant "Olur mu öyle şey?"


translate turkish dev_d3_olyatalk_end_7643f2b1:



    voice "voice/anton/3day/10 P.ogg"
    Ant "Ben okuldayken sen kesin bolca alıştırma yapmışsındır."


translate turkish dev_d3_olyatalk_end_4571a709:


    "Olya kahkahayı bastı. Kalbi yeniden sıcacık olmuştu."


translate turkish dev_d3_olyatalk_end_7b7ebfc8:



    voice "voice/olya/3day/08 A.ogg"
    Oly "Nereden bildin?"


translate turkish dev_d3_olyatalk_end_e178081f:



    voice "voice/olya/3day/09 Ya.ogg"
    Oly "Ama artık sahiden iyi bir nişancıyım! Seni yendim bile."


translate turkish dev_d3_olyatalk_end_18196794:



    voice "voice/anton/3day/11 Ne.ogg"
    Ant "Şimdi yanlış kişiye çattın! Hadi bakalım, Atari'yi aç."


translate turkish open_box_table_db7c425d:


    "Semyon'un mühür yüzüğünü masamın çekmecesine sakladım."


translate turkish open_box_table_9a7ef6ab:


    "Bu kadar hayati bir delili memur beyden çalarak iyi mi etmiştim, hâlâ emin değildim."


translate turkish open_box_table_b4f40b9d:


    "Kardeşimin odasına geçtim."


translate turkish open_box_table_ba415a04:


    "Minik Olya, sekerek televizyon sehpasına yaklaştı. Güç tuşuna basıp konsolun kablosunu anten girişine takmak üzere Foton televizyonun arkasını yoklamaya koyuldu."


translate turkish open_box_table_472c2a8a:


    "Aradığımız \"{u}Dendy{/u}\" sinyalinin bulunduğu kanalı açmak üzere kumandayı elime aldığım an CRT ekranda, filmlerden kısacık kesitler oynamaya başladı."


translate turkish open_box_table_41a61dd1:



    voice "voice/anton/3day/12 Ch.ogg"
    Ant "Ben yokken ilginç bir şeyler oldu mu?"


translate turkish open_box_table_438eae8b:


    "Hiç düşünmeden öylesine sorduğum bir soruydu."


translate turkish open_box_table_f04a93c5:


    "Fakat Olya'nın yüz ifadesi birden değişti, büyük çabalarla takındığı çocuksu masumiyeti yok oluverdi."


translate turkish open_box_table_0c4847c0:



    voice "voice/anton/3day/13 Ol.ogg"
    Ant "Olya, ne oldu?"


translate turkish open_box_table_3a3f10ce:


    "Kardeşim kabloyu takıp eline bulaşan tozları silkti."


translate turkish open_box_table_ef08b76f:


    "Belli ki konuşmayı sürdürecek cesareti arıyordu."


translate turkish open_box_table_708c5be5:



    voice "voice/olya/3day/13 Ma.ogg"
    Oly "Annem..."


translate turkish open_box_table_ba5417a1:


    "Olya'dan çıt çıkmıyordu, hatta bir anda gözleri doluverdi."


translate turkish open_box_table_36025220:



    voice "voice/olya/3day/16 U.ogg"
    Oly "Yine o... Korkunç şey oldu."


translate turkish open_box_table_efd839e2:


    "Kardeşim, sırılsıklam gözleriyle bana baktı."


translate turkish open_box_table_a88ec01c:



    voice "voice/anton/3day/14 P.ogg"
    Ant "Krize mi girdi?"


translate turkish open_box_table_f665fe9b:


    "Pek nüksetmese de geçmişte annemin krize girdiği durumlar olmuştu. Ne var ki bu dağ başına taşındığımızdan beri bu krizler epey sıklaştı."


translate turkish open_box_table_3fb4082a:



    voice "voice/olya/3day/17 Pa.ogg"
    Oly "Babam eve kocaman bir balık getirdi."


translate turkish open_box_table_217421b7:



    voice "voice/olya/3day/18 Ona.ogg"
    Oly "Gazeteye sarılıydı, öyle pis kokuyordu ki... Iy."


translate turkish open_box_table_fcd84c3e:



    voice "voice/olya/3day/19 A.ogg"
    Oly "Annem de yine sinirlenip bıçağı eline aldı."


translate turkish open_box_table_6a0bcdc6:


    "Olya kıvranıp pencereden dışarı korkuyla baktı."


translate turkish open_box_table_ad18198c:



    voice "voice/olya/3day/20 O.ogg"
    Oly "Sonra bağrışmaya başladılar."


translate turkish open_box_table_0e746259:


    "Kardeşimi ufacık cüssesiyle mutfak kapısında dikilirken hayal etmemle donakaldım."


translate turkish open_box_table_a6301fd9:


    "Annemle babamın Olya'yı fark etseler de aldırış etmedikleri, kardeşimin her hâlinden belliydi."


translate turkish open_box_table_56ba1e73:



    voice "voice/olya/3day/21E.ogg"
    Oly "Annem de bıçağı saplayıverdi."


translate turkish open_box_table_d998d42b:



    voice "voice/olya/3day/22 V.ogg"
    Oly "Böyle!"


translate turkish open_box_table_ad8af6b4:


    "Olya, yumruğunu hafifçe indirerek saplama hareketini gösterdi."


translate turkish open_box_table_a7298dfd:



    voice "voice/olya/3day/23 R.ogg"
    Oly "Zavallı balık."


translate turkish open_box_table_a749a852:



    voice "voice/olya/3day/24 O.ogg"
    Oly "Hâlâ yaşıyordu, Toşa. Kesin canı acıyordu. Annem... Annem ise..."


translate turkish open_box_table_56dacb65:


    "Sonrasında ne olduğunu tahmin etmek zor olmadı: Can çekişirken yüzgeçlerinin arasına bıçak saplanan balık, annemin suratına bir miktar kötü kokulu mukus fışkırtmıştır."


translate turkish open_box_table_1bf45c52:


    "Annem, ne zaman ölüm fikrine bu kadar yakından tanıklık etse, gerek gözümüzün önünde biri otobüsün altında kalıp ön camları kana buladığında..."


translate turkish open_box_table_42940ea4:


    "Gerekse nenem bir tavuğun kafasını kestiğinde, annem böyle korkunç, şiddetli bir krize girer."


translate turkish open_box_table_333cf89c:


    "Gözleri devrilir, yere kütük gibi yüzüstü serilir ve o zavallı balık gibi kıvranmaya, sandalyeleri devirmeye, korkunç laflar etmeye başlardı."


translate turkish open_box_table_3d3d9d70:



    voice "voice/anton/3day/15 A.ogg"
    Ant "Peki ya babam, annemle ilgilendi mi?"


translate turkish open_box_table_5bdbe820:


    "Olya, anılarından incinmişçesine ürperdi."


translate turkish open_box_table_2e3f5781:



    voice "voice/olya/3day/26 Da.ogg"
    Oly "Evet ama ilkten..."


translate turkish open_box_table_90bc00f8:



    voice "voice/olya/3day/27 On.ogg"
    Oly "Gülmeye başladı, Toşa!"


translate turkish open_box_table_22f9618c:



    voice "voice/olya/3day/28 T.ogg"
    Oly "Annemi o hâlde görünce canavar gibi güldü..."


translate turkish open_box_table_7572e0d3:



    voice "voice/olya/3day/29 A.ogg"
    Oly "Sonra da ağladı."


translate turkish open_box_table_affd2b7d:


    "Olya'nın anlattıkları, içime kurt düşürmüştü."


translate turkish open_box_table_724545cf:


    "Sanırım yavaşça ormanın dışına taşan delilik; annemi yutmakla kalmamış, aynı zamanda yiğit mi yiğit babama da bulaşmıştı."


translate turkish open_box_table_14d17451:


    "Hemen Olya'ya sokulup ona sımsıkı sarıldım."


translate turkish open_box_table_fdfbcba3:


    "Başını göğsüme koyduğunda gömleğimin ıslandığını hissettim."


translate turkish open_box_table_7a7740dd:



    voice "voice/olya/3day/30 Z.ogg"
    Oly "Niye birbirlerine böyle davranıyorlar, Toşa?"


translate turkish open_box_table_e8740cc5:



    voice "voice/olya/3day/31 Oni.ogg"
    Oly "Delirdiler mi?"


translate turkish open_box_table_dad6c61e:


    "Ebeveynlerimizin bu yaptığına bir mazeret bulamayıp kem küm ettim."


translate turkish open_box_table_dc9ad77d:


    "Söyleyecek sözüm yoktu. Elimden gelen tek şey, Olya'ya sımsıkı sarılmaktı."


translate turkish open_box_table_5471976a:


    "Olya çığlık atıp arkama saklandı."


translate turkish open_box_table_944a1b17:



    voice "voice/olya/3day/33 Per .ogg"
    Oly "Kapa şunu, çabuk!"


translate turkish open_box_table_5aa9ec71:


    "Bu jeneriği kaç kez izlerse izlesin, her gördüğünde aynı tepkiyi verirdi, tıpkı o baykuşu gördüğünde olduğu gibi."


translate turkish open_box_table_7c282941:


    "Gerçi televizyonda {u}beti benzi atmış bu yüzü{/u} her gördüğümde benim de tüylerim diken diken olurdu. Bu yüzden kardeşimin lafını ikiletmedim."


translate turkish day3_goosehunt_e32f059f:


    "Nihayetinde, satın aldığımızda konsolla birlikte gelen kasetin oyun seçim menüsü ekranda belirdi."


translate turkish day3_goosehunt_d4658a9f:


    "Ekrandaki isimlerin birçoğunun, aynı oyunun farklı bölümlerinden ibaret oluşu biraz can sıkıcıydı."


translate turkish day3_goosehunt_b4269dfb:


    "Gri dikdörtgen kumandayı alıp piksel harflerin arasından \"ördek\" anlamına geldiğini tahmin ettiğim o İngilizce kelimeyi aramaya koyuldum."


translate turkish day3_goosehunt_0511ee60:


    "Arka planda çalan menü müziği, zihnini yatıştırmış olmalı ki Olya sakince sordu:"


translate turkish day3_goosehunt_2f558bbf:



    voice "voice/olya/3day/34 Aka.ogg"
    Oly "Okul nasıl gidiyor?"


translate turkish day3_goosehunt_af1465c4:



    voice "voice/anton/3day/34 Ya.ogg"
    Ant "Bir kızla arkadaş oldum."


translate turkish day3_goosehunt_20581887:



    voice "voice/olya/3day/54 A.ogg"
    Oly "Güzel mi peki?"


translate turkish day3_goosehunt_7f15ab29:


    "Utandım."


translate turkish day3_goosehunt_f42917b3:



    voice "voice/anton/3day/35 Nu.ogg"
    Ant "Yani... Bilmem."


translate turkish day3_goosehunt_95990784:



    voice "voice/olya/3day/55 Xa.ogg"
    Oly "Aha, kızardın. Demek ki çok güzel!"


translate turkish day3_goosehunt_3f520a9f:



    voice "voice/anton/3day/36 Pe.ogg"
    Ant "Lütfen Olya."


translate turkish day3_goosehunt_ffc67c76:



    voice "voice/olya/3day/56 Vl.ogg"
    Oly "Aşıksın! Aşıksın!"


translate turkish day3_goosehunt_9fbc738b:



    voice "voice/anton/3day/37 Ol.ogg"
    Ant "Olya, böyle devam edersen seninle oynamam bak."


translate turkish day3_goosehunt_20c05d35:



    voice "voice/olya/3day/57 D.ogg"
    Oly "Haha! Şaka yapıyorum!"


translate turkish day3_goosehunt_eee9f35a:



    voice "voice/olya/3day/58 A.ogg"
    Oly "Bizimle de tanıştıracak mısın?"


translate turkish day3_goosehunt_0544d9f7:



    voice "voice/anton/3day/38 Nu.ogg"
    Ant "Ee... Belki."


translate turkish day3_goosehunt_1433960d:



    voice "voice/olya/3day/59 Ak.ogg"
    Oly "Peki ya ismi ne?"


translate turkish day3_goosehunt_c59a979b:



    voice "voice/anton/3day/39 P.ogg"
    Ant "P-Polina."


translate turkish day3_goosehunt_b68c1a49:



    voice "voice/olya/3day/60 Pok.ogg"
    Oly "Bak, yine kızardın!"


translate turkish day3_goosehunt_5137f46a:



    voice "voice/olya/3day/61 A.ogg"
    Oly "Peki ya evlenince nerede yaşayacaksınız?"


translate turkish day3_goosehunt_980a9436:



    voice "voice/anton/3day/40 M.ogg"
    Ant "Oyun oynayacak mıyız?"


translate turkish day3_goosehunt_a1f273f4:



    voice "voice/anton/3day/41 Da.ogg"
    Ant "Yani birkaç arkadaş edindim... Sanırım."


translate turkish day3_goosehunt_a2a46b98:



    voice "voice/olya/3day/63 Og.ogg"
    Oly "Oho, birkaç hem de! Şanslısın."


translate turkish day3_goosehunt_0f654aa0:



    voice "voice/anton/3day/42 A.ogg"
    Ant "Sen de tilki gördüğünü söylemiştin hani."


translate turkish day3_goosehunt_9d3052c9:



    voice "voice/olya/3day/64 Aga.ogg"
    Oly "Ah, evet. İsmi Alisa."


translate turkish day3_goosehunt_9dfbdcf0:


    "Yeni arkadaşımın ismini duyunca huzursuzlanıverdim."


translate turkish day3_goosehunt_98967370:



    voice "voice/anton/3day/43 Ot.ogg"
    Ant "Nereden biliyorsun, sana ismini mi söyledi?"


translate turkish day3_goosehunt_b234b2b1:



    voice "voice/olya/3day/64 da.ogg"
    Oly "Evet, annemle çöpü çıkardığımız vakit. Bir de seni kurtardığını söyledi."


translate turkish day3_goosehunt_00ae6be4:



    voice "voice/anton/3day/44 S.ogg"
    Ant "Beni mi kurtarmış?"


translate turkish day3_goosehunt_41334921:


    "Serserilerle ormanda ettiğim kavgayı ve çalıların arasından gelen o gizemli ıslığı hatırladım."


translate turkish day3_goosehunt_df532002:


    "Can havliyle kaçan Semyon ve dibimde dikilip elini uzatan o boynuzlu dev gözümün önünde canlandı."


translate turkish day3_goosehunt_6af72e3e:


    "Alisa'yı göremesem de her an, eğri büğrü ağaçların ardından kızıl maskesiyle gülümseyip beni izliyormuşçasına varlığını hissetmiştim."


translate turkish day3_goosehunt_834d55eb:


    "Bu sanrıyı zihnimden defedip derin bir iç çektim."


translate turkish day3_goosehunt_d40a40ba:



    voice "voice/anton/3day/45 A.ogg"
    Ant "Başka bir şey söyledi mi?"


translate turkish day3_goosehunt_1e3cfcbd:



    voice "voice/olya/3day/65 Nea.ogg"
    Oly "I-ıh."


translate turkish day3_goosehunt_ec84c30f:



    voice "voice/olya/3day/66 Ma.ogg"
    Oly "Çünkü annem çabucak döndü... Onu bizimkilerle tanıştırmak istedim ama tilki çoktan kaçıp gitmişti."


translate turkish day3_goosehunt_dd1f9828:



    voice "voice/anton/3day/46 T.ogg"
    Ant "Ondan korkmuyor musun?"


translate turkish day3_goosehunt_9bb48ca7:



    voice "voice/olya/3day/67 A.ogg"
    Oly "Niye korkayım ki? Alisa çok nazik, pofuduk, bir de güzel..."


translate turkish day3_goosehunt_0722b841:



    voice "voice/olya/3day/68 Ne.ogg"
    Oly "O baykuş ise hiç de Alisa gibi değil."


translate turkish day3_goosehunt_c9f0db26:


    "Kardeşimin kıkırtıları eşliğinde ışın tabancasını ikinci kumanda girişine taktım."


translate turkish day3_goosehunt_e4425e18:



    voice "voice/olya/3day/62 Chu.ogg"
    Oly "Önce ben!"


translate turkish day3_goosehunt_7c6321c2:



    voice "voice/anton/3day/18 Ni.ogg"
    Ant "Hiç iyi olmadı."


translate turkish day3_goosehunt_f042bc93:



    voice "voice/anton/3day/19 Sh.ogg"
    Ant "Farklı bir okula gitsem bile gördüğüm muamele yine aynı."


translate turkish day3_goosehunt_b8d138ad:



    voice "voice/anton/3day/20 S.ogg"
    Ant "Sanki hiç taşınmamışız gibi... Bıktım bundan."


translate turkish day3_goosehunt_b3397bdb:


    "Ümitsizlik, beni bunalımlı düşüncelerin pençesine sürükleyemeden kafatasımın kuytularında fesat bir düşünce filizlendi."


translate turkish day3_goosehunt_a62a59e6:


    "Vahşice olduğu kadar keyif dolu anılarım canlandı."


translate turkish day3_goosehunt_9ef13be8:



    voice "voice/anton/3day/21 H.ogg"
    Ant "{i}Aslında... İyi bir şey oldu.{/i}"


translate turkish day3_goosehunt_2cc154ff:


    "Yüzümde falçata yarası gibi fesat bir sırıtış belirirken Olya, umut dolu gözlerle bana kulak kesilmişti."


translate turkish day3_goosehunt_1264792f:



    voice "voice/anton/3day/22 E.ogg"
    Ant "{i}Bir çocuk daha kayboldu.{/i}"


translate turkish day3_goosehunt_f4aff973:



    voice "voice/olya/3day/35 To.ogg"
    Oly "Toşa, sence bu iyi bir şey mi? Niye öyle diyorsun?"


translate turkish day3_goosehunt_2aa336f4:


    "Şişe dibi camların ardındaki gözlerime bakarken kardeşimin sesi titreyiverdi."


translate turkish day3_goosehunt_d7f45e6e:



    voice "voice/anton/3day/23 Z.ogg"
    Ant "{i}Hani diğer kayıp çocuk Vova vardı ya... Belki tüm bu başına gelenler, kendisinin suçudur.{/i}"


translate turkish day3_goosehunt_75db774a:



    voice "voice/anton/3day/24 M.ogg"
    Ant "{i}Belki de o kadar kötü bir şey yapmıştır ki... Ölmeyi hak etmiştir.{/i}"


translate turkish day3_goosehunt_41b6653c:



    voice "voice/olya/3day/36 Ne.ogg"
    Oly "Bu kadar acımasız olmasana!"


translate turkish day3_goosehunt_6a3205a1:


    "Olya dizlerini çenesine yaslayıp bacaklarına sarıldı."


translate turkish day3_goosehunt_8631f769:


    "Sanki küçülmeye, hatta tümüyle yok olmaya çalışıyordu."


translate turkish day3_goosehunt_dc656140:


    "Bize düşen tek mantıklı şey de buydu, tüm o kırık oyuncakların arasında kaybolmak..."


translate turkish day3_goosehunt_79c12299:


    "Ve huysuz ebeveynlerle, sınıftaki delilerle bir daha hiç karşılaşmamak."


translate turkish day3_goosehunt_f9108c8f:


    "Bizim birbirimizden başka kimsemiz, koruyup kollayanımız, dinleyenimiz, anlayanımız yok."


translate turkish day3_goosehunt_a40b485e:


    "Bu yüzden onlar, yani güçsüzü ezmeye pek meraklı olan çocuk kılığındaki hayvanlar hakkında ne düşündüğümü Olya dinlemek zorundaydı."


translate turkish day3_goosehunt_04ac3e1a:


    "Şimdi söz bendeydi."


translate turkish day3_goosehunt_13ce5b95:



    voice "voice/anton/3day/25 D.ogg"
    Ant "{i}Bence bununla da kalmayacak.{/i}"


translate turkish day3_goosehunt_7abe357b:


    "Nefesim hızlandı, parmaklarımı parkelerin üstünde tıkırdatmaya başladım."


translate turkish day3_goosehunt_5a7dc737:



    voice "voice/anton/3day/27 Ta.ogg"
