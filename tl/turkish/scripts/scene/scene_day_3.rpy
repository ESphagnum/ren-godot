translate turkish day3_draw_witness_class_6aa92411:



    voice "voice/kate/105 KA.ogg"
    Kate "Değil mi, Anton?"


translate turkish day3_draw_witness_class_ec0fbd7d:


    "\"Kesin öyledir!\" dedim içimden."


translate turkish day3_draw_witness_class_ca649212:


    "Bendeki ışığı görünce Katya bile arkadaş olmak istemişti."


translate turkish day3_draw_witness_class_50e33216:



    voice "voice/anton/3day/027 Pr.ogg"
    Ant "Kusura bakma, başkasına söz verdim."


translate turkish day3_draw_witness_class_6dd07138:


    "Katya'nın yüzünün hafifçe düştüğünü gördüm ama buna rağmen tek kelime etmedi."


translate turkish day3_transit_wrong_fox_64fa5170:


    "Sıraların arasından Polina'yı arar gözlerle güç bela sıyrıldım."


