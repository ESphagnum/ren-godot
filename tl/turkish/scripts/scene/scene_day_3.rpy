translate turkish day3_night_c22f7918:


    "Bu sefer başka bir yöne, çam kokulu ormanın dikenlerle dolu kıyısına doğru koşmaya başladım."


translate turkish day3_night_1b917811:


    "Kalp atışlarım, saniyelerle yarışıyordu."


translate turkish day3_night_5b291001:


    "Kurt çocuk, insani yaradılışını unutmuşçasına arkamdan hırıldadı:"


translate turkish day3_night_653ea721:



    voice "voice/Wolf/308 GR.ogg"
    Wolf "Hırr... Hırr..."


translate turkish day3_night_99d1fcf3:


    "Sağ ayağım kar dolu bir çukura saplandı."


translate turkish day3_night_c3938cc3:


    "Soluk soluğa sövüp, ayağımı zorla çekip kurtardığım gibi yere kapaklandım."


translate turkish day3_night_a6aaa2d8:


    "İçine düştüğüm çimento gibi kar yığını, kalkmama veya tutunacak bir yer bulmama engel oluyordu."


translate turkish day3_night_ee23910d:


    "Yine de dizginlenemeyen yaşama hırsım, bu talihsiz durumdan kurtulmama yardımcı oldu."


translate turkish day3_night_d3b965b1:


    "Karanlık, yanıp küle dönen ölülerden tüten zararlı duman gibi giderek yaklaşıyordu. Aldığım her nefes boğazımı yaksa da koşmaya devam ettim."


translate turkish day3_night_14e9ce2e:


    "Saçım rüzgarda dalgalanıyordu."


translate turkish day3_night_300c8747:


    "Yere düştüğümde beremi de düşürmüştüm. Ayrıca vücudum terden sırılsıklam olmuş, kulaklarım ise dondurucu soğuktan yanıyordu."


translate turkish day3_night_07528e7a:


    "Nihayetinde kırı geride bıraktım."


translate turkish day3_night_751b4f6d:


    "Ormana kaçmanın pek akıllıca bir fikir olmadığını fark etsem de ağaçların arasına daldım."


translate turkish day3_night_07eefd08:


    "Bir elimle yüzümü örtmüş, durmadan koşuyordum."


translate turkish day3_night_90b35300:


    "Yolumdaki dalların gözümü çıkarmasını istemezdim."


translate turkish day3_night_d369cad4:


    "Ağaç dalları kıyafetlerimi kamçılıyor, kıyma makinesine domuz sürükleyen bir kasap acımasızlığıyla derimde sıyrıklar bırakıyordu."


translate turkish dev_bunny3_candyjumps_end_d23787c0:


    "Topraktan fışkıran boğum boğum kökler, ayağıma sarılıverdi."


translate turkish dev_bunny3_candyjumps_end_a23654dc:


    "Çiziklerle dolu gövdesine yapıştığım ağacın dibine serildim ve etrafımı telaşla kolaçan ettim."


translate turkish dev_bunny3_candyjumps_end_6658ba0c:



    voice "voice/Alisa/3day/01 Uh.ogg"
    Alis "Üf, amma hızlısın!"


translate turkish dev_bunny3_candyjumps_end_06a57dbf:


    "O an Alisa'nın üstüne atılıp ona sarılmak istedim."


translate turkish dev_bunny3_candyjumps_end_1d627136:


    "Fakat bu isteğime direnip çama sımsıkı sarıldım."


translate turkish dev_bunny3_candyjumps_end_5bbcfa1d:



    voice "voice/anton/3day/133.Ti.ogg"
    Ant "Burada... Ne arıyorsun?"


translate turkish dev_bunny3_candyjumps_end_2ae2c44e:



    voice "voice/Alisa/3day/02 Da.ogg"
    Alis "Hiç."


translate turkish dev_bunny3_candyjumps_end_b20198fb:


    "Düşürdüğüm beremi uzattı."


translate turkish dev_bunny3_candyjumps_end_afccd4f6:



    voice "voice/Alisa/3day/03 V.ogg"
    Alis "Kayıp eşya ofisinde yarı zamanlı çalışıyorum."


translate turkish dev_bunny3_candyjumps_end_cd96a14c:



    voice "voice/Alisa/3day/04 N.ogg"
    Alis "Al da tak, yoksa kulakların donup düşecek."


translate turkish dev_bunny3_candyjumps_end_d8e2c47f:


    "Kıs kıs güldü."


translate turkish dev_bunny3_candyjumps_end_fdaa5e55:


    "Alisa'nın elinde kesik bir kafa veya çok daha korkunç bir şey olabileceği kuşkusuyla gözlerimi kısıp bir ona bir bereye baktım."


translate turkish dev_bunny3_candyjumps_end_6084c24e:


    "Ne var ki boşuna kuruntu yapmışım, elindeki sadece bereymiş."


translate turkish dev_bunny3_candyjumps_end_7495fd83:


    "Alıp kafama geçirdim."


translate turkish dev_bunny3_candyjumps_end_79588491:



    voice "voice/Alisa/3day/06 T.ogg"
    Alis "Isındın mı?"


translate turkish dev_bunny3_candyjumps_end_7fe9a557:


    "Yanıt vermedim."


translate turkish dev_bunny3_candyjumps_end_e6b8f262:



    voice "voice/anton/3day/134 Tam.ogg"
    Ant "Bahçede birkaç çocuk gördüm."


translate turkish dev_bunny3_candyjumps_end_5fac3ab4:



    voice "voice/Alisa/3day/07 E.ogg"
    Alis "Ne olmuş? Isırdılar mı yoksa?"


translate turkish dev_bunny3_candyjumps_end_b0899b65:



    voice "voice/anton/3day/135 net.ogg"
    Ant "Hayır."


translate turkish dev_bunny3_candyjumps_end_64731e00:



    voice "voice/Alisa/3day/08 A.ogg"
    Alis "O zaman niye kaçtın?"


translate turkish dev_bunny3_candyjumps_end_c647e0ba:


    "Bu sorunun yanıtı belli olsa da kem küm edip mırıldandım:"


translate turkish dev_bunny3_candyjumps_end_821821c7:



    voice "voice/anton/3day/136 Nez.ogg"
    Ant "Ne bileyim..."


translate turkish dev_bunny3_candyjumps_end_1fe4f5de:



    voice "voice/Alisa/3day/09 E.ogg"
    Alis "Eh, sana bir daha mankafa demeyeceğime niye söz verdiysem..."


translate turkish dev_bunny3_candyjumps_end_c6148e59:



    voice "voice/Alisa/3day/10 A.ogg"
    Alis "Neyse, yine de sözümden dönmem."


translate turkish dev_bunny3_candyjumps_end_1d75767b:


    "Dibime gelip koluma yapıştı."


translate turkish dev_bunny3_candyjumps_end_76f91645:


    "O tanıdık nane, portakal ve maytap kokusu burnuma geldi."


translate turkish dev_bunny3_candyjumps_end_628b39a0:


    "Alisa'ya iyice sokulup kokusunu dakikalarca içime çekmek istiyordum."


translate turkish dev_bunny3_candyjumps_end_5703dc0f:



    voice "voice/Alisa/3day/11 S.ogg"
    Alis "Sana kaç kere söyleyeceğim? Benimle olduğun sürece güvendesin."


translate turkish dev_bunny3_candyjumps_end_64bf6ccf:



    voice "voice/Alisa/3day/12 Ya.ogg"
    Alis "Ben senin dostunum."


translate turkish dev_bunny3_candyjumps_end_9e7780fd:



    voice "voice/Alisa/3day/13 E.ogg"
    Alis "Onlar da öyle."


translate turkish dev_bunny3_candyjumps_end_5f3fb549:


    "Tilki kızın eliyle işaret ettiği tarafa dönüverdim."


translate turkish dev_bunny3_candyjumps_end_44cabe5d:


    "Açıklıkta maskeli çocuklar vardı, daha doğrusu boyları kısa olduğundan çocuk gibi görünüyorlardı."


translate turkish dev_bunny3_candyjumps_end_a371808c:


    "Kurt çocuk, baykuş kız ve ayı çocuk."


translate turkish dev_bunny3_candyjumps_end_198e188f:


    "Koşturmaktan yorulmuş olacaklar ki soluk soluğaydılar."


translate turkish dev_bunny3_candyjumps_end_61828efb:



    voice "voice/Owl/3day/09 Ya.ogg"
    Noname "Düşüp karların arasında kaybolduğunu-uh sandım."


translate turkish dev_bunny3_candyjumps_end_a3580c35:



    voice "voice/Owl/3day/10 S.ogg"
    Noname "Karları eşeledik ama seni bulamadık."


translate turkish dev_bunny3_candyjumps_end_edc39a8a:



    voice "voice/Bear/3day/01 A.ogg"
    Noname "Ben eşelemedim, çok da umurumdaydın ya."


translate turkish dev_bunny3_candyjumps_end_9f3b548e:



    voice "voice/Bear/3day/02 O.ogg"
    Noname "Farkındaysan sadece salaklar etrafta koşturup karları eşeler."


translate turkish dev_bunny3_candyjumps_end_28a9ecd0:



    voice "voice/Bear/3day/03 Ae.ogg"
    Noname "Aklı olan, diğerlerinin koşturup eşelerken yorulmasını bekler."


translate turkish dev_bunny3_candyjumps_end_1fabc808:



    voice "voice/Bear/3day/04 E.ogg"
    Noname "Ne diyecekse ondan sonra der."


translate turkish dev_bunny3_candyjumps_end_34eaf921:



    voice "voice/Wolf/309 Kak.ogg"
    Noname "Seni arrrsız!"


translate turkish dev_bunny3_candyjumps_end_f93e8529:



    voice "voice/Wolf/310 D.ogg"
    Noname "Umarrrsız!"


translate turkish dev_bunny3_candyjumps_end_aceacf69:



    voice "voice/anton/3day/137A.ogg"
    Ant "Hı?"


translate turkish dev_bunny3_candyjumps_end_483fef82:



    voice "voice/Alisa/3day/12 Neobr.ogg"
    Alis "Takma sen onu, ucubenin teki de."


translate turkish dev_bunny3_candyjumps_end_3b8fcacb:


    "Ağzım açık, ellerim iki yanımda anlamsızca dururken şaşkınlıkla bakakaldım."


translate turkish dev_bunny3_candyjumps_end_3370613a:


    "Gececi misafirlerimin bu sözlerine nasıl tepki vermeliydim, bilememiştim fakat yüzüme zoraki bir gülüş konduruverdim."


translate turkish dev_bunny3_candyjumps_end_074923f5:



    voice "voice/anton/3day/138 V.ogg"
    Ant "Beni korkuttunuz ama..."


translate turkish dev_bunny3_candyjumps_end_4fb41b20:


    "Birbirlerine baktılar. Hatta bir tanesi, sanki komik bir şey söylemişim gibi horuldayarak güldü."


translate turkish dev_bunny3_candyjumps_end_b849d4a1:



    voice "voice/Wolf/310 Da.ogg"
    Noname "Evet, evet! Aferrrin tilki..."


translate turkish dev_bunny3_candyjumps_end_4935c659:



    voice "voice/Bear/3day/06 Eto.ogg"
    Noname "Aradığımızı bulduk!"


translate turkish dev_bunny3_candyjumps_end_6f0f6059:



    voice "voice/Alisa/3day/15 N.ogg"
    Alis "Hayır, bu..."


translate turkish dev_bunny3_candyjumps_end_a0d695e9:



    voice "voice/Owl/3day/15 N.ogg"
    Noname "Bulduk mu hele?"


translate turkish dev_bunny3_candyjumps_end_16be64c4:



    voice "voice/Bear/3day/07 Na.ogg"
    Noname "Tavşancığımız!"


translate turkish dev_bunny3_candyjumps_end_a777c8f6:



    voice "voice/Owl/3day/16 D.ogg"
    Noname "Evet, evet, anımsatıyor."


translate turkish dev_bunny3_candyjumps_end_b8a6b306:


    "Kurt çocuk, heyecanla kostümünün bir uzvunu kuyruğuymuş gibi sallamaya başladı."


translate turkish dev_bunny3_candyjumps_end_49f017ed:



    voice "voice/Wolf/312 P.ogg"
    Noname "Birrrinciyim!"


translate turkish dev_bunny3_candyjumps_end_e816cfd0:



    voice "voice/Alisa/3day/17 Nu.ogg"
    Alis "Evet, birinci oldun."


translate turkish dev_bunny3_candyjumps_end_6142db16:



    voice "voice/Alisa/3day/18 Et.ogg"
    Alis "İçindeki tavşanı ilk Kurtçuk hissetti. Bize de senden o bahsetti."


translate turkish dev_bunny3_candyjumps_end_1071845e:



    voice "voice/anton/3day/52 Zd.ogg"
    Ant "Merhaba."


translate turkish dev_bunny3_candyjumps_end_4a43d924:



    voice "voice/Alisa/3day/02 S.ogg"
    Alis "Baykuşçuk ile zaten tanışmıştın. O kadar da ürkütücü değilmiş, değil mi?"


translate turkish dev_bunny3_candyjumps_end_1a349986:



    voice "voice/anton/3day/53 Da.ogg"
    Ant "Sanırım."


translate turkish dev_bunny3_candyjumps_end_bdd81665:



    voice "voice/Alisa/3day/04 A.ogg"
    Ant "Bu güler yüzlü koca adam da Ayıcık."


translate turkish dev_bunny3_candyjumps_end_a7d86708:



    voice "voice/Alisa/3day/05 T.ogg"
    Alis "Nazik ol, yoksa kafanı bir ısırıkta koparır."


translate turkish dev_bunny3_candyjumps_end_b6cbf604:



    voice "voice/anton/3day/54 Za.ogg"
    Ant "Ne?"


translate turkish dev_bunny3_candyjumps_end_f58f64ba:



    voice "voice/Alisa/3day/06 M.ogg"
    Alis "Kaçarken espri anlayışını da düşürdün herhalde."


translate turkish dev_bunny3_candyjumps_end_e71dd051:


    "Bu acayip hayvancıkların niyetini bilmediğimden ellerimi arkamda bağlamış, maskelerindeki deliklere bakmamak için elimden geleni yapıyordum."


translate turkish dev_bunny3_candyjumps_end_bec136b2:


    "Alisa yapmacık bir hareketle elini beline atıp her nasılsa tilki yüzüyle göz kırptı."


translate turkish dev_bunny3_candyjumps_end_2d7d06d7:



    voice "voice/Alisa/3day/19 K.ogg"
    Alis "Bir dahaki geldiğimizde çan çalarız ki bizi görünce korkmayasın."


translate turkish dev_bunny3_candyjumps_end_da040db9:



    voice "voice/Owl/3day/01 A.ogg"
    Owl "Çanımız var mı ki?"


translate turkish dev_bunny3_candyjumps_end_8f3b3a5a:



    voice "voice/Bear/3day/09 Ch.ogg"
    Bear "Ben çalamam."


translate turkish dev_bunny3_candyjumps_end_bf20dad7:



    voice "voice/Bear/3day/10 U.ogg"
    Bear "Patim acıyor."


translate turkish dev_bunny3_candyjumps_end_3b082654:


    "Yüzümdeki gülüş, yapmacıklığını yitirmişti."


translate turkish dev_bunny3_candyjumps_end_f0b0a64b:



    voice "voice/Alisa/3day/13 Ozu.ogg"
    Alis "Oo, dişlerini gösterdi, iyiye işaret."


translate turkish dev_bunny3_candyjumps_end_f4798c41:



    voice "voice/Alisa/3day/14 Neo.ogg"
    Alis "Seni güldürebileceğimizi sanmıyordum."


translate turkish dev_bunny3_candyjumps_end_6ed7db57:



    voice "voice/Alisa/3day/15 Ya.ogg"
    Alis "Hatta Disneyland'e gitmedikçe gülmeni beklemiyordum bile."


translate turkish dev_bunny3_candyjumps_end_c73bd6d8:



    voice "voice/anton/3day/140 Otk.ogg"
    Ant "Bunu da nereden biliyorsun?"


translate turkish dev_bunny3_candyjumps_end_aeba8e4e:



    voice "voice/Alisa/3day/20 Da.ogg"
    Alis "Bir yerde okudum işte."


translate turkish dev_bunny3_candyjumps_end_8443a7ab:



    voice "voice/anton/3day/141 Pro.ogg"
    Ant "Benim hakkımda bir şey mi okudun?"


translate turkish dev_bunny3_candyjumps_end_ff500d94:



    voice "voice/Alisa/3day/24 Pr.ogg"
    Alis "Güldürme beni! Yok canım, Disneyland hakkında."


translate turkish dev_bunny3_candyjumps_end_d8fa0f28:



    voice "voice/Owl/3day/12 T.ogg"
    Owl "Sen insanca okuyabiliyor musun?"


translate turkish dev_bunny3_candyjumps_end_49c09e0b:



    voice "voice/Alisa/3day/25 Z.ogg"
    Alis "Her gün okula yok yere mi gidiyorum sence?"


translate turkish dev_d3_dance_82a8cae4:


    "Bu sözünün ardından cilveli bir ses tonuyla şarkı söylemeye başladı:"


translate turkish dev_d3_dance_0f7305ed:


    Alis "Hayal kırıklığı ve ihmal nerede öğrenilir? \nMahalle mektebinde, sınıfta elbette!{w=7.367}{nw}"


translate turkish dev_d3_dance_42a1854c:


    Alis "Küçüklere vuralım, eziklere dadanalım! \nMahalle mektebinde, sınıfta elbette!"


translate turkish dev_d3_dance_7b77ae2d:


    "Sakıngan bir kahkaha attım."


translate turkish dev_d3_dance_7b479f9a:


    "Yeni dostlarım artık ürkünç gelmiyor, aksine pek iyi ve arkadaş canlısı görünüyorlardı."


translate turkish dev_d3_dance_8fa9069a:


    "Onlarda her nedense samimi bulmuştum."


translate turkish dev_d3_dance_2817a298:


    "Tıpkı bu açıklık, ay ve kaseti geri sarıyormuşçasına yerden göğe uçan kar taneleri gibi..."


translate turkish dev_d3_dance_79c4994f:


    "Maskeli çocuklar yaklaşıp bana dokundu. Gerçek olup olmadığımı anlamaya çalışırcasına kıyafetlerimle beni okşadılar."


translate turkish dev_d3_dance_3625f588:


    "Dokunuşlarında hayvani bir fesatlık değil, sadece çocuksu bir merak vardı."


translate turkish dev_d3_dance_dd393ce1:


    "O an içimden şunu söyledim:"


translate turkish dev_d3_dance_a09953e9:


    Ant_m "{i}Onlara güvenebilirim.{/i}"


translate turkish dev_d3_dance_9350eaa2:


    "Kar taneleri durmadan yükseliyordu."


translate turkish dev_d3_dance_6280243e:



    voice "voice/Owl/3day/14 N.ogg"
    Owl "Artık kimse sana zarar veremez."


translate turkish dev_d3_dance_34c4abe3:



    voice "voice/Wolf/313 D.ogg"
    Wolf "Arrrkadaş."


translate turkish dev_d3_dance_d50beac4:



    voice "voice/Bear/3day/12 P.ogg"
    Bear "Aynen ama olur da kalkışırlarsa!.."


translate turkish dev_d3_dance_030fbec3:


    "Tilki, omzumu dürtüp kahkahalara boğuldu."


translate turkish dev_d3_dance_ef1594b5:



    voice "voice/Alisa/3day/28 N.ogg"
    Alis "Ee Toşa, çığlıklar atarak kaçacak mısın, yoksa bizimle mi geleceksin?"


translate turkish dev_d3_dance_d5bafe11:



    Ant "Nereye?"
    Ant "Nereye?"


translate turkish dev_d3_dance_94b2f8f8:



    voice "voice/Alisa/3day/29 N.ogg"
    Alis "Ahaha! Lunaparka!"


translate turkish dev_d3_dance_7bbcc2ac:


    "O an tayganın yanıltıcı sessizliği, uzaktan gelen bir flüt sesiyle son buldu."


translate turkish dev_d3_dance_0619fc55:


    "Büyüleyici ve cezbedici bu ses, kristal bir bardağın çınlamasını ve dupduru, buz gibi bir pınarın şırıltısını anımsatıyordu."


translate turkish beasts_sky_4efbbdb1:


    "İçimde birkaç şüphe kırıntısı kaldıysa bile bu flüt ezgisi, hepsini silip süpürmüştü."


translate turkish beasts_sky_d6a50f28:


    "Karar vermeye fırsat bulamadan yeni dostlarımın peşine takıldım."


translate turkish beasts_sky_c287e515:


    "Bacaklarım almış başını, gidiyor; çamlar bize yol veriyor, çalılar da huzurumuzda saygıyla eğiliyordu."


translate turkish beasts_sky_08f24ff4:


    "Rüya gibi bir manzaraydı."


translate turkish beasts_sky_bd378890:


    "Çünkü geldiğimiz açıklığı da bundan önce bir tek rüyamda görmüştüm."


translate turkish beasts_sky_660e14b6:


    "Ağaç tepelerinden büyüleyici kuşları anımsatan bir flüt sesi geliyordu."


translate turkish beasts_sky_26e34a61:


    "Kar taneleri döne döne yükseliyordu."


translate turkish beasts_sky_db670388:


    "Mehtap, ağaç dallarını gümüşe boyuyordu."


translate turkish beasts_sky_027d1de4:


    "Alisa hayretle iç çekti, ben de onun kadar mest olmuştum."


translate turkish beasts_sky_6f63c12e:


    "Kafamı alabildiğine kaldırıp yukarıya baktım."


translate turkish beasts_sky_767eb594:



    voice "voice/Owl/3day/15 K.ogg"
    Owl "U-uh, manzaraya bak!"


translate turkish beasts_sky_79e7605f:



    voice "voice/anton/3day/144 Och.ogg"
    Ant "Ne kadar güzel."


translate turkish beasts_sky_ee192c5b:


    "Kurtçuk da uluyarak bize katıldı."


translate turkish beasts_sky_5ad141cd:



    voice "voice/Alisa/3day/31 E.ogg"
    Alis "Bu daha ne ki?"


translate turkish beasts_sky_fcd1c646:



    voice "voice/Alisa/3day/32 Ya.ogg"
    Alis "Sana neler neler göstereceğim..."


translate turkish beasts_sky_5a0dde28:



    voice "voice/Alisa/3day/33 E.ogg"
    Alis "İstersen tabii."


translate turkish beasts_sky_c918fdfe:


    "İstiyordum. Kapüşonunun gölgesine saklanan tilki kızın gördüklerini ben de görmeye hevesliydim!"


translate turkish beasts_sky_b118a3d8:


    "Artık maskeli çocukları tuhaf bulmuyordum, aksine aralarından bir tek benim maskemin olmayışı tuhaftı."


translate turkish beasts_sky_b86eee6c:


    "Sanki ocak rüzgarlarının ortasında çırılçıplaktım."


translate turkish beasts_sky_a8649788:



    Ant "Neden bu maskeleri takıyorsunuz?"
    Ant "Neden bu maskeleri takıyorsunuz?"


translate turkish beasts_sky_5b776bb7:


    "Ürpersem de korkmuyordum."


translate turkish beasts_sky_85af34cd:


    "Ürpermemin sebebi de soğuk değil, acayip bir kaygı ile harika şeyler görme beklentisiydi."


translate turkish beasts_sky_32e90ab3:



