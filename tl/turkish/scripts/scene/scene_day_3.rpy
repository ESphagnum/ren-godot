translate turkish day3_draw_notfox_011f0ccd:



    voice "voice/byasha/3day/77 Zato.ogg"
    Bya "Ama aklının ucundan geçti, değil mi, he?"


translate turkish day3_draw_notfox_a9c33ee1:


    "Leş gibi sigara kokusuyla Romka, diklenerek bana yaklaştı."


translate turkish day3_draw_notfox_6d8fbc59:



    voice "voice/romka/3day/05 Ti.ogg"
    Rom "Syoma ortadan kayboldu diye rahat nefes alabileceğini sanıyorsan çok yanılıyorsun."


translate turkish day3_draw_notfox_c57e641e:



    voice "voice/romka/3day/06 M.ogg"
    Rom "Öyle kendini deli deli yapıp Polina'yı etkileyeceksin diye resim mesim çizdiğini görmeyeyim."


translate turkish day3_draw_notfox_1d53904c:



    voice "voice/romka/3day/07 mi.ogg"
    Rom "Sana bu okulu zindan ederiz, ayıktın mı?"


translate turkish day3_draw_notfox_222027e8:



    voice "voice/romka/3day/08 Do.ogg"
    Rom "Hadi işine bak, dört göz!"


translate turkish day3_draw_notfox_912baf39:


    "Yediğim tokatla başım yana savruldu."


translate turkish day3_draw_notfox_5c12b84f:



    voice "voice/byasha/3day/78 Vot.ogg"
    Bya "Koyduğumun eziği he!"


translate turkish day3_draw_notfox_02d1649b:


    "Teneffüste, sırtımda bir kağıt parçası olduğunu fark ettiğimde hiç şaşırmadım."


translate turkish day3_draw_notfox_d8b86e34:


    "Üzerinde \"VUR BANA!\" yazıyordu."


translate turkish day3_draw_notfox_14a82f11:


    "Bu kabus yakın zamanda biteceğe benzemiyordu."


translate turkish day3_draw_fox_e268d836:


    "Ancak kader, karşıma Polina yerine yeni \"dostlarımı\" çıkardı."


translate turkish day3_draw_fox_b344ba2c:


    "Romka ile Byaşa, panonun önünde beni bekliyordu."


translate turkish day3_draw_fox_e3f190a0:



    voice "voice/romka/3day/09 Ya.ogg"
    Rom "Hislerimi haklı çıkardın Toşik."


translate turkish day3_draw_fox_e1d70d3c:



    voice "voice/romka/3day/10 Pa.ogg"
    Rom "Helal be oğlum! O pis domuzu eşek sudan gelene kadar dövdük de bizi ispiyonlamadın."


translate turkish day3_draw_fox_1a3ef2cf:



    voice "voice/anton/3day/028 Eto.ogg"
