translate turkish day3_draw_fox_3d10c588:



    voice "voice/romka/3day/11 M.ogg"
    Rom "Yok, sen kendinden emin misin?"


translate turkish day3_draw_fox_e4db2e0b:



    voice "voice/romka/3day/12 Po.ogg"
    Rom "O karanlıkta bizden nasıl kaçtığını unuttun herhalde."


translate turkish day3_draw_fox_62205c80:



    voice "voice/byasha/3day/79 A.ogg"
    Bya "Aynen! Bir an içimden 'Bu dört göz harbi tazı gibi çıktı...'"


translate turkish day3_draw_fox_3ed84c1b:



    voice "voice/byasha/3day/80 Sh.ogg"
    Bya "'Dombiliyi bir eline geçirirse canına okur he!' dedim."


translate turkish day3_draw_fox_cfb5a8cd:



    voice "voice/romka/3day/13 baz.ogg"
    Rom "Aynen öyle!"


translate turkish day3_draw_fox_87bd7d11:



    voice "voice/romka/3day/14 Od.ogg"
    Rom "Ama sana güveniyoruz. Hem bu işler karşılıklı, değil mi?"


translate turkish day3_draw_fox_cc26a277:


    "Romka'nın dik bakışlarından huzursuzlanıp kafa salladım."


translate turkish day3_draw_fox_3d89ddf4:



    voice "voice/romka/3day/15 Vo.ogg"
    Rom "İyi madem."


translate turkish day3_draw_fox_507e3864:



    voice "voice/byasha/3day/81 Et.ogg"
    Bya "Ee... Anton, böyle kalem tutmayı nereden öğrendin?"


translate turkish day3_draw_fox_14af39f8:


    "Bunu duyunca utansam da çaktırmadım. Ayağımı yere sürterek Byaşa'ya yanıt verdim."


translate turkish day3_draw_fox_d79acc1d:



    voice "voice/anton/3day/030 Da.ogg"
    Ant "Şey, küçüklükten beri resim çiziyorum da..."


translate turkish day3_draw_fox_2d49b15b:



    voice "voice/byasha/3day/82 K.ogg"
    Bya "Vay ulan! Benim de elimden... Sanat sepet işleri gelir."


translate turkish day3_draw_fox_9d06e115:



    voice "voice/byasha/3day/84 Pa.ogg"
    Bya "Lehim tabancasıyla oduna resim çizebiliyorum."


translate turkish day3_draw_fox_7b9199f6:



    voice "voice/byasha/3day/85 Von.ogg"
    Bya "Anamın doğum gününde kesme tahtasına lale çizmiştim."


translate turkish day3_draw_fox_cdcc38b1:



    voice "voice/byasha/3day/86 V.ogg"
    Bya "Anlayacağın, tanıştığımız iyi oldu."


translate turkish day3_draw_fox_b746de6a:



    voice "voice/romka/3day/16 T.ogg"
    Rom "Tamam, siz de yavşaklık etmeyin iyice."


translate turkish day3_draw_fox_e023f3e4:


    "Romka sesini alçaltıp sağı solu kesti."


translate turkish day3_draw_fox_942a5fea:


    "Diğer çocuklar ara ara bize bakıyor, fısıldaşıyordu."


translate turkish day3_draw_fox_cb4dd344:



    voice "voice/romka/3day/17 Sh.ogg"
    Rom "Ee, Syoma harbiden kayboldu."


translate turkish day3_draw_fox_717c814f:



    voice "voice/romka/3day/18 K.ogg"
    Rom "Kaybolmakla da kalmayıp muhtemelen öldü."


translate turkish day3_draw_fox_a6add373:



    voice "voice/byasha/64 Otshat.ogg"
    "Byaşa ürperdi."


translate turkish day3_draw_fox_8ad33688:



    voice "voice/anton/3day/031 A.ogg"
    Ant "Nereden biliyorsun?"


translate turkish day3_draw_fox_562d3a99:



    voice "voice/romka/3day/19 D.ogg"
    Rom "Yani!.."


translate turkish day3_draw_fox_96cdf64b:



    voice "voice/romka/3day/29 M.ogg"
    Rom "Bunu daha önce konuşmuştuk. İlk kez böyle bir şey olmuyor."


translate turkish day3_draw_fox_996afcbc:



    voice "voice/romka/3day/30 D.ogg"
    Rom "Seneçka, Vova ve Syoma'nın Narnia'ya mı gittiğini sanıyorsun?"


translate turkish day3_draw_fox_9f222d41:



    voice "voice/romka/3day/31 P.ogg"
    Rom "Orada biraz vakit geçirip, avuç avuç şeker yiyip ormana dönecek değiller ya!"


translate turkish day3_draw_fox_506511b4:



    voice "voice/romka/3day/32 Ya.ogg"
    Rom "Bu işin sorumlusu apaçık ortada."


translate turkish day3_draw_fox_20f02d1d:



    voice "voice/anton/3day/032 N.ogg"
    Ant "Acaba Kara..."


translate turkish day3_draw_fox_d93b1d70:



    voice "voice/byasha/3day/87 Ma.ogg"
    Bya "Seri katil!"


translate turkish day3_draw_fox_5602cd31:



    voice "voice/byasha/3day/88 BL.ogg"
    Bya "Adım gibi eminim, beyler! Bu lavuk bizim köyün {u}Çikatilo{/u}'su kesin he."


translate turkish day3_draw_fox_68ffcc6c:



    voice "voice/byasha/3day/89 Mne.ogg"
    Bya "Anamın iş arkadaşı da o yarık dudağı köyde gördüğünü söylemiş."


translate turkish day3_draw_fox_2ae7a9d0:



    voice "voice/anton/3day/033 V.ogg"
    Ant "Bir de onun kim olduğunu öğrenebilsek..."


translate turkish day3_draw_fox_ac2af4c5:



    voice "voice/romka/3day/33 Nu.ogg"
    Rom "Yalnız o katil, Baburin'i geberttiyse bizim de peşimize düşebilir."


translate turkish day3_draw_fox_20da0b8f:



    voice "voice/anton/3day/034 S.ogg"
    Ant "Ne diyeceğim, Tihonov sınıfa duyuru yaparken dosyasına şöyle bir göz gezdirdim."


translate turkish day3_draw_fox_b9d7f0da:


