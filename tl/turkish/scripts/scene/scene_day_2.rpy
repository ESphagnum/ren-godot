translate turkish bunny2_fox_garage_dev_b00d226a:



    voice "voice/romka/2day/145 CZisto.ogg"
    Rom "Dur, aklına kazıyayım."


translate turkish bunny2_fox_garage_dev_ad51b1a0:


    "Yumruğunu şakağıma indirdi."


translate turkish bunny2_fox_garage_dev_ce6a2458:


    "Dünyam tersine döndü."


translate turkish bunny2_fox_garage_dev_7c9f0285:


    "Çürük et rengi gökyüzüne düşüyordum sanki."


translate turkish bunny2_fox_garage_dev_dd0e1f8e:


    "Daha da tepetaklak olmayayım diye köklere tutundum."


translate turkish bunny2_fox_garage_dev_907d4984:


    "Şuurum boşlukta süzülüyor, sönük bir balon gibi sonsuz derinliklere sürükleniyordu."


translate turkish bunny2_fox_garage_dev_a79a0681:


    "Kalkmayı denedim."


translate turkish bunny2_fox_garage_dev_df1125e6:


    "Muhtemelen Polina'ya ait olan bulanık silüet dirense de diğer ikisi onu kolundan tutmuş, sürükleyerek uzaklaştırıyordu."


translate turkish bunny2_fox_garage_dev_d12dae17:



    voice "voice/byasha/Mi domoi.ogg"
    Bya "Korkma he, seni evine bırakacağız."


translate turkish bunny2_fox_garage_dev_7b91bab2:



    voice "voice/semen/2day/100 Mal.ogg"
    Sem "Ormanda ne biçim manyaklar geziniyordur, bilemezsin."


translate turkish bunny2_fox_garage_dev_1de1a736:



    voice "voice/romka/2day/146 A Tosha.ogg"
    Rom "Toşa da burada kalıp biraz dinlensin."


translate turkish bunny2_fox_garage_dev_aa4f5c26:



    voice "voice/anton/2day/171. Polina (Tosha).ogg"
    Ant "Polina!"


translate turkish bunny2_fox_garage_dev_eb22fe14:


    "Romka, ayağındaki botu alnıma yapıştırdı."


translate turkish bunny2_fox_garage_dev_e6f47010:


    "Elimin burkulması ve kafamı arkamdaki buz parçasına çarpmamla gözlerim devriliverdi."


translate turkish bunny2_fox_garage_dev_21b04505:


    "Karanlık boy gösterip..."


translate turkish bunny2_fox_garage_dev_fa3cbbdf:


    "Beni yutmaya gelmişçesine bir tavır takındı."


translate turkish bunny2_fox_garage_dev_a20cefa7:


    "..."


translate turkish bunny2_fox_garage_dev_a1266d00:



    voice "voice/anton/2day/142. Semen.ogg"
    Ant "Of... Öhö..."


translate turkish bunny2_happy_family_nightmare_9bf61907:


    "Burnumu yatağa sürterek yattığım yerde döndüm. Büyük güçlükle gözlerimi açtım."


translate turkish bunny2_happy_family_nightmare_aebc9ab4:


    "Duvarlarda resimler; kitaplar, çizgi romanlar, karikatür dergileri..."


translate turkish bunny2_happy_family_nightmare_5c8173b8:


    "Keskin bir acı hissetme korkusuyla çeneme dokundum."


translate turkish bunny2_happy_family_nightmare_281a6b55:


    "Parmaklarım oradan şakaklarıma kaydı, ne bir şişlik vardı ne ağrı."


translate turkish bunny2_happy_family_nightmare_11b18b13:


    "Şaşkınlıkla gözlerimi kırparak doğruldum. Gözlüğümü düzelttim."


translate turkish bunny2_happy_family_nightmare_e9b0b5c2:


    "Ellerime baktım, tertemizdi. Tırnaklarımın altında tek bir çamur lekesi yoktu."


translate turkish bunny2_happy_family_nightmare_2f658558:


    "Okul çantam masamın ayağına yaslıydı. Kapının ardından ufak ufak konuşma sesleri geliyordu."


translate turkish bunny2_happy_family_nightmare_1fc526ce:


    "Evde, odamdaydım."


translate turkish bunny2_happy_family_nightmare_e28c8691:


    "Buraya kendim mi gelmiştim? Peki gözlüğüm ne alaka, Semyon geri mi vermişti? Polina veya tanımadığım bir hayırsever getirmiş olabilirdi..."


translate turkish bunny2_happy_family_nightmare_df8657a1:


    "Bu soruları sonraya bırakıp pencereden dışarıya baktım. Orman sırlarla doluydu ancak bunları benimle paylaşmak konusunda pek tez canlı değildi."


translate turkish bunny2_happy_family_nightmare_6567e101:


    "Komodinimdeki saat sabah 10'u gösteriyordu."


translate turkish bunny2_happy_family_nightmare_03fb36a0:


    "Güneş çoktan tepeye konmuş olsa da sıcaklığından eser yoktu."


translate turkish bunny2_happy_family_nightmare_c2dd439e:


    "Ağaçlık, kemik gibi dallarının çıtırtısıyla inildedi."


translate turkish bunny2_happy_family_nightmare_37640ae5:


    "Koridora çıktığımda konuşmalar biraz daha netleşti. Kahkaha sesleri... Annemin kahkaha attığını duymayalı epey uzun zaman olmuştu."


translate turkish bunny2_happy_family_nightmare_8272c84d:


    "Sessiz bir evde sinsi gölgelerin arasında..."


translate turkish bunny2_happy_family_nightmare_c10a4a34:


    "Pek sıradan ama içten bir gülüş."


translate turkish bunny2_happy_family_nightmare_1bf9b043:


    "Bu neşeye nazar değdirmekten korkarcasına ağır ve sessiz adımlarla alt kata indim."


translate turkish bunny2_happy_family_nightmare_3f29a478:



    voice "voice/father/day_2/13 A ya emu.ogg"
    Pap "Sonra dedim ki 'Elinizde çizgi roman var mı? Tavşanım için soruyorum da...'"


translate turkish bunny2_happy_family_nightmare_fd0a8c08:



    voice "voice/father/day_2/13 A on vash.ogg"
    Pap "Adam da 'Tavşanınız çizgi roman mı okuyor?' demesin mi!"


translate turkish bunny2_happy_family_nightmare_2d79b9bc:


    "Annem ve Olya, peş peşe kahkahayı bastı."


translate turkish bunny2_happy_family_nightmare_167996b2:



    voice "voice/father/day_2/14 Nu da govoru.ogg"
    Pap "Ben de 'Tabii, tavşanım okuryazar!' dedim."


translate turkish bunny2_happy_family_nightmare_c865214e:



    voice "voice/karina/2day/108 Bozhe ty.ogg"
    Mam "Ahaha, âlemsin yahu!"


translate turkish bunny2_happy_family_nightmare_1cdfe4d4:



    voice "voice/father/day_2/15A ti somnevalas.ogg"
    Pap "Şüphen mi vardı?"


translate turkish bunny2_happy_family_nightmare_e6e64303:



    voice "voice/karina/2day/109 Ni na.ogg"
    Mam "Hiç olur mu?"


translate turkish bunny2_happy_family_nightmare_a9c44229:



    voice "voice/olya/2day/48 Zenih.ogg"
    Oly "Sizi çifte kumrular!"


translate turkish bunny2_happy_family_nightmare_6378598d:


    "Mutfağa girdiğimde annem babamı alnından öpüyor, babam da annemin omzunu okşuyordu."


translate turkish bunny2_happy_family_nightmare_d7545b4c:


    "Olya da bir eline çatal almış, ikisinin arasında oturuyordu."


translate turkish bunny2_happy_family_nightmare_fcef2c19:


    "Masadaki puantiyeli tencereden -kapağı kapalı olmasına rağmen- mis gibi bir koku geliyordu."


translate turkish bunny2_happy_family_nightmare_2fd6d415:



    voice "voice/father/day_2/16_a_vot.ogg"
    Pap "Vay, kimler gelmiş!"


translate turkish bunny2_happy_family_nightmare_a883f4b4:



    voice "voice/karina/2day/111 Privet.ogg"
    Mam "Hoş geldin uykucu! Aynı babasına çekmiş."


translate turkish bunny2_happy_family_nightmare_bc44d30b:


    "Ardındaki kırağılı cam, annemi bembeyaz tuvaldeki bir portre gibi gösteriyordu."


translate turkish bunny2_happy_family_nightmare_185c48aa:



    voice "voice/father/day_2/17_sadis.ogg"
    Pap "Gel, otur. Ayakta yorulma!"


translate turkish bunny2_happy_family_nightmare_e3c65cc6:



    voice "voice/father/day_2/18_zavtrak.ogg"
    Pap "Kahvaltı, hele ki sağlıklı bireyler için günün en önemli öğünüdür!"


translate turkish bunny2_happy_family_nightmare_b37715f9:


    "Yüzümde cıvıltılı bir gülüşle oturdum."


translate turkish bunny2_happy_family_nightmare_e9cd923c:


    "Olya'nın bana göz kırpmasıyla tavandaki ampul sönüp yanıverdi."


translate turkish bunny2_happy_family_nightmare_63ec4378:



    voice "voice/karina/2day/112 Zaspanny.ogg"
    Mam "Beyefendi uykusunu alamamış!"


translate turkish bunny2_happy_family_nightmare_053efa6b:



    voice "voice/father/day_2/19_kakoy_yest.ogg"
    Pap "Ee, elden ne gelir? Evlat, bizim evlat. Yetimhaneye de veremeyiz ki artık!"


translate turkish bunny2_happy_family_nightmare_01865e0a:


    "Babam şaka yaptığını belli etmeye çalışırcasına güldü. Annem nazikçe babamın omzuna vurdu."


translate turkish bunny2_happy_family_nightmare_336fbb8f:



    voice "voice/olya/2day/49 Oi ya.ogg"
    Oly "Oy, çok acıktım!"


translate turkish bunny2_happy_family_nightmare_d4eefa7d:



    voice "voice/karina/2day/113 A my.ogg"
    Mam "Bir tek senin mi ağzın sulandı sanıyorsun, kızım?"


translate turkish bunny2_happy_family_nightmare_3ec6fe67:



    voice "voice/olya/2day/50 Bratik.ogg"
    Oly "Abi, bu hâlde yemek mi yenir?"


translate turkish bunny2_happy_family_nightmare_d9edb2e7:



    voice "voice/anton/2day/204. Kak.ogg"
    Ant "Nasıl?"


translate turkish bunny2_happy_family_nightmare_3e456c16:


    "Annemle babamın gözlerindeki parıltıyı fark ettim."


translate turkish bunny2_happy_family_nightmare_1c24d550:


    "Bir kameram olsaydı onları fotoğraf çekerdim, böylece dilediğim zaman yüzlerindeki gülüşe bakabilirdim."


translate turkish bunny2_happy_family_nightmare_e7109bf0:


    "Bu güzel an sonsuza dek sürsün istemiştim."


translate turkish bunny2_happy_family_nightmare_4e8d6ebe:


    "Ampul tekrar sönüp yandı ve pencere hafifçe titredi."


translate turkish bunny2_happy_family_nightmare_3c114aa4:



    voice "voice/karina/2day/114 Snimy.ogg"
    Mam "Oğlum, maskeni çıkarsana. Yemek yerken engel olmasın."


translate turkish bunny2_happy_family_nightmare_ad28b04a:



    voice "voice/anton/2day/205. Kakyu masku.ogg"
    Ant "Ne maskesi?"


translate turkish bunny2_happy_family_nightmare_35b06650:


    "Şapşalca gülümsüyordum."


translate turkish bunny2_happy_family_nightmare_cd1547c2:


    "Babam piyano tuşları gibi bembeyaz, sapasağlam dişlerini gösterip bana seslendi:"


translate turkish bunny2_happy_family_nightmare_d6179239:



    voice "voice/father/day_2/20_snimay.ogg"
    Pap "Hadi tavşancık, çıkarıver."


translate turkish bunny2_happy_family_nightmare_7f0fec2a:


    "Elimi yanaklarımda gezdirip güldüm."


translate turkish bunny2_happy_family_nightmare_5d91b50b:



    voice "voice/anton/2day/207. Vi o chem.ogg"
    Ant "Nasıl yani?"


translate turkish bunny2_happy_family_nightmare_48f24f39:


    "Ailem beni işaret ederek, masaya ve dizlerine vurarak hep bir ağızdan gülüyordu."


translate turkish bunny2_happy_family_nightmare_b420b78a:


    "Babam gülmekten yaş gelen gözlerini elinin tersiyle siliverdi."


translate turkish bunny2_happy_family_nightmare_acd4624b:



    voice "voice/father/day_2/21_nasmeshil.ogg"
    Pap "Bizi güldürdün ya, sen de gülesin oğlum."


translate turkish bunny2_happy_family_nightmare_5e1cc284:



    voice "voice/father/day_2/22_a_teper_masky.ogg"
    Pap "Ama çıkar artık şu maskeyi."


translate turkish bunny2_happy_family_nightmare_3a997966:


    "Tekrar yüzüme dokundum. Cildimin uyuştuğunu hissettim."


translate turkish bunny2_happy_family_nightmare_78a8d323:



    voice "voice/anton/2day/208. No na mne.ogg"
    Ant "İyi de maske takmıyorum ki."


translate turkish bunny2_happy_family_nightmare_0bd63a9d:


    "Annem oturduğu sandalyede kurtlu gibi kıpırdanıyordu. Başını eğip gözlerini kıstı."


translate turkish bunny2_happy_family_nightmare_0046a5c7:


    "Ardındaki tuval grileşmiş, her geçen saniye daha da kararıyordu."


translate turkish bunny2_happy_family_nightmare_27792774:



    voice "voice/karina/2day/117 Poka ne.ogg"
    Mam "O maskeyi çıkarmadan başlamak yok."


translate turkish bunny2_happy_family_nightmare_7777a3bc:



    voice "voice/olya/2day/52 No ya.ogg"
    Oly "Ben daha fazla dayanamayacağım!"


translate turkish bunny2_happy_family_nightmare_fc418571:



    voice "voice/father/day_2/23_snimi_masky.ogg"
    Pap "Güldük, eğlendik, yeter. Çıkar artık maskeni."


translate turkish bunny2_happy_family_nightmare_98ffe476:


    "Sesi tatlı ama sertti."


translate turkish bunny2_happy_family_nightmare_b7e98c19:



    voice "voice/olya/2day/53 Mam.ogg"
    Oly "Anne... Toşa beni korkutuyor."


translate turkish bunny2_happy_family_nightmare_010930dd:


    "Sandalyenin ayakları parkelere sürtündü. Olya benden uzaklaştı."


translate turkish bunny2_happy_family_nightmare_ced9ab11:


    "Kardeşim artık gülmüyordu. Hatta duvardaki çatlakları saymazsak odadaki kimsenin yüzündeki gülüşten eser kalmamıştı."


translate turkish bunny2_happy_family_nightmare_b94b359e:



    voice "voice/father/day_2/25_chto_nadelal.ogg"
    Pap "Ne yapıyorsun sen? Kardeşini ağlattın!"


translate turkish bunny2_happy_family_nightmare_5c673ff6:



    voice "voice/anton/2day/209. No.ogg"
    Ant "İyi de..."


translate turkish bunny2_happy_family_nightmare_f1803adc:


    "Olya, içini çekerek gözlerinden yaşlar döküyor, bana ara ara ürkek bakışlar atıyordu."


translate turkish bunny2_happy_family_nightmare_c1b3c838:


    "Annem yumruğunu masaya indiriverdi. Sandalyemle birlikte az kalsın yere devriliyordum."


translate turkish bunny2_happy_family_nightmare_e1629be7:



    voice "voice/karina/2day/118 Syn.ogg"
    Mam "Senin gibi evlat olmaz olsun! Ne güzel gülüp eğleniyorduk, uyandığın gibi neşemizin içine ettin!"


translate turkish bunny2_happy_family_nightmare_12dde6af:


    "Suratıma tükürükler saçıldı."


translate turkish bunny2_happy_family_nightmare_9c37f22b:


    "Bana ne olup bittiğini anlatması için dönüp babama yalvarırcasına baktım."


translate turkish bunny2_happy_family_nightmare_33b3f3ca:


    "Sakalından tişörtüne yapış yapış pekmez damlıyor, gözleri şaşı bakıyordu."


translate turkish bunny2_happy_family_nightmare_c6381d2c:


    "Tavan arasından bir ses yükselmiş, su boruları gurulduyordu."


translate turkish bunny2_happy_family_nightmare_fe895238:


    "Ev canlanmıştı."


translate turkish bunny2_happy_family_nightmare_53ee7734:


    "Her odada zırvalayan, köşe bucak dolaşan, nefes alıp veren birileri vardı."


translate turkish bunny2_happy_family_nightmare_4944ba59:


    "Ampul, ışıldak gibi yanıp sönmeye başladı."


translate turkish bunny2_happy_family_nightmare_d108f975:


    "Ebeveynlerimin yüzü karanlığa gömülüp çok geçmeden tekrar gün yüzüne çıktı."


translate turkish bunny2_happy_family_nightmare_e0ff1448:


    "Pencerenin dışından uzun bir gölge geçti."


translate turkish bunny2_happy_family_nightmare_f30b3310:


    "Aslında yerimden fırlayıp kaçacaktım ama bedenim zihnimi dinlemiyor, ellerim ise uslu bir şekilde masada duruyordu."


translate turkish bunny2_happy_family_nightmare_65406e71:


    "Olan biteni öylece izliyordum."


translate turkish bunny2_happy_family_nightmare_185be18a:


    "Işıklar söndü. Zifiri karanlıkta kalbim üç kere attı."


translate turkish bunny2_happy_family_nightmare_4d9fc5b6:


    "Ardından ampul kör edici ışıkla parladı."


translate turkish bunny2_happy_family_nightmare_a39e0de4:


    "Üç maske, meraklı gözlerle bana bakıyordu."


translate turkish bunny2_happy_family_nightmare_650ee620:


    "Birkaç saniye önce annemin oturduğu yerde bir tilki kadın belirdi."


translate turkish bunny2_happy_family_nightmare_f6b3f8ef:


    "Masanın başında bir kurt adam..."


translate turkish bunny2_happy_family_nightmare_bb732d6d:


    "Ve tavşan kız, Olya'cığım vardı."


translate turkish bunny2_happy_family_nightmare_c1e89823:


    "O tuhaf ve korkunç hayvan yüzlerini neden takındıklarını..."


translate turkish bunny2_happy_family_nightmare_9e9759d6:


    "Veya o kat kat kağıtların altında kıpırdayan bir şeyler varmış da maskelerini pörtletiyormuşçasına, üzerlerindeki kürkün neden hareket ettiğini soramadım bile."


translate turkish bunny2_happy_family_nightmare_59d4bce0:


    "Dilim, beynimin yağdırdığı emirlere kulak asmıyordu."


translate turkish bunny2_happy_family_nightmare_bc84e118:


    "Yalnızca gözümü bir maskeden ayırıp diğerine çevirebiliyordum. Ailemin arkasında boy gösteren uzun çarpık gölgeleri izliyordum."


translate turkish bunny2_happy_family_nightmare_bd23655b:



    voice "voice/karina/2day/119 Kyashat.ogg"
    Mam "Afiyet olsun!"


translate turkish bunny2_happy_family_nightmare_c9af7ee6:


    "Annem tencerenin kapağını kaldırdı."


translate turkish bunny2_happy_family_nightmare_17132c22:


    "Yemeğin kanlı suyunda kesik bir baş yüzüyordu."


translate turkish bunny2_happy_family_nightmare_6f6160a9:


    "Cam gibi bir çift göz, tencerenin içinden bana bakıyor; ağzından sessiz bir çığlık yükseliyordu."


translate turkish bunny2_happy_family_nightmare_eca6f86e:


    "Tencerenin dibindeki kelle bana aitti."


translate turkish bunny2_happy_family_nightmare_123b9a61:


    "Kellenin dehşet dolu yüzünden kanlar boşalıyordu."


translate turkish bunny2_happy_family_nightmare_95a1a9d5:


    "O an burun deliklerime sıcak bir şeyin akmasıyla masa örtüsüne kızıl damlalar düşmeye başladı."


translate turkish bunny2_happy_family_nightmare_c89f7b23:



    voice "voice/karina/2day/120 Esh.ogg"
    Mam "Yesene!"


translate turkish bunny2_happy_family_nightmare_438cd1fe:


    "Çığlığı bastım."


translate turkish bunny2_happy_family_nightmare_a20cefa7:


    "..."


translate turkish bunny2_happy_family_nightmare_8f536ff1:


    "Yerimden sıçradım. Çenem yanıyor, şakaklarım da bir o kadar sızlıyordu."


translate turkish bunny2_happy_family_nightmare_e6468b0d:


    "Mutfak, hayvan maskeli yaratıklar ve kelle; hepsi yok oluvermişti..."


translate turkish bunny2_happy_family_nightmare_9979576f:


    "Tabii serserilerin beni aşağılamak için bana zorla taktırdığı kahrolası maske hariç."


translate turkish bunny2_happy_family_nightmare_d1366b9a:


    "Üzerime kene gibi yapışan tavşan maskesini çekip atıverdim. Gözümü açtığım yer, ormandaki yıkık kardan adamın az ötesiydi."


translate turkish bunny2_happy_family_nightmare_a4cfd7af:


    "Dikensi çam yaprakları ve kara bulanmıştım. Ne gözlüğüm ne de yüzümün eski hâlinden eser vardı."


translate turkish bunny2_happy_family_nightmare_35839a79:


    "Bayılmışım... Kabus gibiydi."


translate turkish bunny2_happy_family_nightmare_867f0938:


    "Vücudumdaki yaraların zonklayışı, az önce tanık olduğum korkunç manzaraya kıyasla nimet gibi gelmişti."


translate turkish bunny2_happy_family_nightmare_50055e48:


    "Kan tükürerek ayağa kalktım."


translate turkish bunny2_happy_family_nightmare_2fa60dd0:


    "Ormanın ahşap parmaklıkları ardında bir mahkum gibiydim. Ne zamandır baygındım, bilmiyordum."


translate turkish bunny2_happy_family_nightmare_9aa91c15:


    "Elim ayağım uyuşmuş, pantolonum sırılsıklam olmuştu."


translate turkish bunny2_happy_family_nightmare_1a9f70b2:


    "Kule gibi ağaçların ortasında çaresizce dikilmiş, bir bilinmezliğe bakıyordum."


translate turkish bunny2_happy_family_nightmare_cad5a8d7:


    "Etrafımdaki her şey tir tir titriyordu. Tüm bu hışırtıdan da hiçbir şey duyamıyordum."


translate turkish bunny2_happy_family_nightmare_a6534b63:


    "Ağaçların tepeleri buhar olup kainatın karanlığına karışıyordu."


translate turkish bunny2_happy_family_nightmare_2d8c53bd:


    "Çalılar, mahkumlarının firar ettiği boş hücrelerden farksızdı."


translate turkish bunny2_happy_family_nightmare_0a5b2458:


    "Karanlıktan bir avuç pençe fırlayıp şaşkın suratıma her an yapışabilirmiş gibi hissediyordum."


translate turkish bunny2_happy_family_nightmare_23dfdb57:


    "Uzaklardan birinin haykırdığını duydum."


translate turkish bunny2_happy_family_nightmare_d9f19e0a:



    voice "voice/father/day_2/Antooon.ogg"
    Noname "Anton!"


translate turkish bunny2_happy_family_nightmare_dc852f1f:


    "Biri beni arıyordu, tıpkı..."


translate turkish bunny2_happy_family_nightmare_a53e46a6:


    "O kayıp çocuk gibi."


translate turkish bunny2_happy_family_nightmare_804140e0:


    "Gözlerim yaşla dolup kirpiklerimden koca bir damla düştü."


translate turkish bunny2_happy_family_nightmare_eb122af1:



    voice "voice/father/day_2/Antooon2.ogg"
    Noname "Anton!"


translate turkish bunny2_happy_family_nightmare_1212bdb7:


    "Ses giderek yaklaşıyordu. Bir an için kurtulacağıma dair umutlanmıştım."


translate turkish bunny2_happy_family_nightmare_44afc908:



    voice "voice/anton/2day/188. Ya zes.ogg"
    Ant "Buradayım!"


translate turkish bunny2_happy_family_nightmare_8c56523c:


    "Gözlerime bir ışık vurdu. Elimle yüzümü örttüm."


translate turkish bunny2_happy_family_nightmare_d6e9aeae:


    "Ağaçlardan biri kıpırdadı."


translate turkish bunny2_happy_family_nightmare_a3673dca:


    "Romka değildi, Byaşa da değildi."


translate turkish bunny2_happy_family_nightmare_d89c075a:


    "Boylu boslu, uzun kollu bir yetişkindi."


translate turkish bunny2_happy_family_nightmare_25e9f2ca:


    "Peşinden köpekleri anımsatan bir sürü karaltı geliverdi ancak bu karaltılar, Julka'dan çok daha büyüktü."


translate turkish bunny2_happy_family_nightmare_b7e3b8bc:


    "Orman uykusundan uyanmış, yüzündeki maskeyi düşürmüştü."


translate turkish bunny2_happy_family_nightmare_5a9f3690:


    "Far görmüş tavşan gibi kalakaldım, hayvanların gözleri üzerimdeydi."


translate turkish bunny2_happy_family_nightmare_4bd938b8:


    "Bu alaca karanlıkta gözlüksüz pek bir şey göremiyordum. Yine de görebildiklerim, dehşetle donakalmama yetmişti."


translate turkish bunny2_happy_family_nightmare_441734fc:


    "Bu ucube töreninin başını çeken devin bana yaklaşmasıyla açıklığı leş gibi hayvan sidiği ve ıslak kürk kokusu kuşattı."


translate turkish bunny2_happy_family_nightmare_69e0d830:


    "Korkudan elim ayağım boşaldı. Karların arasına, dizlerimin üstüne çöktüm. Karşımdaki silüete, ağaçlara, karanlığa yalvarıyor gibi görünüyordum."


translate turkish bunny2_happy_family_nightmare_270e9931:


    "Gözümü doğrultmaya cesaret edemediğimden, bana yaklaşıp pis kokusuyla burnumun direğini sızlatan şeyin bacaklarının gri kürkle kaplı olduğunu sandım."


translate turkish bunny2_happy_family_nightmare_17871447:


    "Gözlerimi öyle sıkıca yumdum ki göz kapaklarımın içinde kızıl daireler dans etmeye başladı."


translate turkish bunny2_happy_family_nightmare_cd9ca1c4:


    "Bakmak istemiyorum!"


translate turkish bunny2_happy_family_nightmare_f9a600e7:


    "Ne var ki her şeyi duyabiliyordum."


translate turkish bunny2_happy_family_nightmare_ef3a7497:


    "Nefesi, kulağımı zımpara kağıdı gibi tırmalıyordu."


translate turkish bunny2_happy_family_nightmare_6700d43b:


    "Sesi kalın, boğuktu. Hırıldıyordu."


translate turkish bunny2_happy_family_nightmare_40253270:



    voice "voice/kozel/2day/02 Hrr A.ogg"
    Noname "Hırr..."


translate turkish bunny2_happy_family_nightmare_424bb012:


    "Hafızamın ücra köşelerinden nenemin bana öğrettiği duayı anımsadım:"


translate turkish bunny2_happy_family_nightmare_d0763be8:



    voice "voice/anton/2day/190. Mertvoe.ogg"
    Ant "Topraktan gelen toprağa gidecek! Topraktan..."


translate turkish bunny2_happy_family_nightmare_2973654a:


    "Muhatabım, leş gibi bir hırıltıyla karşılık verdi."


translate turkish bunny2_happy_family_nightmare_82a514d4:


    "Bir avuç pençeyle karşı karşıyayken dualara sığınamazdım. Çaresizdim."


translate turkish bunny2_happy_family_nightmare_01ca1ed4:


    "Ancak hemen sonrasında yakınlardan tanıdık, hoş bir ses geldi."


translate turkish bunny2_happy_family_nightmare_29b0ff20:



    voice "voice/Alisa/Alisa2day/183 Nu ze.ogg"
    Alis "Hadi kızım, fırla! Şunun tadına bakıver."


translate turkish bunny2_happy_family_nightmare_e24ff65a:



    voice "voice/anton/2day/191. Ne nado.ogg"
    Ant "Hayır!"


translate turkish bunny2_happy_family_nightmare_c61e0486:


    "Halat gibi boğumlu, yapışkan ve sıcak bir şey boğazıma giriverdi..."


translate turkish bunny2_happy_family_nightmare_a15f81c7:


    "Ağzımda birinin dili vardı."


translate turkish bunny2_happy_family_nightmare_f2d879ab:



    voice "voice/Alisa/Alisa2day/184 Ya ze.ogg"
    Alis "Size söylemiştim efendim!"


translate turkish bunny2_happy_family_nightmare_9dc121d6:



    voice "voice/Alisa/Alisa2day/185 Eto nash.ogg"
    Alis "İşte, tavşanımız."


translate turkish bunny2_happy_family_nightmare_562c3fea:



    voice "voice/Alisa/Alisa2day/186 O nem.ogg"
    Alis "Ona iyi bakınız."


translate turkish bunny2_happy_family_nightmare_a91a85bb:


    "Titrek parmaklarımla örtüp incecik aralayabildiğim göz kapaklarımın arasından ürkünç bir silüetin başımda dikildiğini gördüm."


translate turkish bunny2_happy_family_nightmare_d4b09ed5:


    "Köpek kulübesi, gübre ve yosun kokusunu ister istemez içime çekiyordum."


translate turkish bunny2_happy_family_nightmare_2872a818:


    "Dosta güven, düşmana korku salan otoriter heybetiyle önümde boynuzlu bir hayvan duruyordu."


translate turkish bunny2_happy_family_nightmare_44e59605:


    "Asaletini göze çarpan duruşuyla belli ediyordu."


translate turkish bunny2_happy_family_nightmare_25d949c0:


    "Boynuzlarıyla bulutları üzerinde taşıyordu. Çıkık ve ağarmış göz bebekleri, diken gibi iğneleyici bir bakışla yuvalarından fırlamaya hazır durumdaki gözlerime saplanmıştı."


translate turkish bunny2_happy_family_nightmare_f9ecaada:


    "Avuçları ikramla doluydu."


translate turkish bunny2_happy_family_nightmare_69597d23:


    "Parlak ve göz alıcı ambalajlara sarılı şekerler yere döküldü. Kar yığınındaki parıltılı paketli çikolatalar ve plastik çubuklu lolipop gözüme çarptı."


translate turkish bunny2_happy_family_nightmare_2988afe5:



    voice "voice/kozel/2day/03 Tebe.ogg"
    Master "Sanaa!"


translate turkish bunny2_happy_family_nightmare_0261f0ed:


    "Ayaklarıma konfeti gibi şekerler yağdı."


translate turkish bunny2_happy_family_nightmare_817abbb0:


    "Oyuncak bir silah buza düşüp önüme serildi. Kayıp Vova'nın da aynen böyle bir silahı vardı."


translate turkish bunny2_happy_family_nightmare_bd6ed0a9:


    "Yakınına oyuncak bir bebek düştü, ardından oyuncak yağmaya başladı: topaç, burnu yırtık bir ayıcık; kurmasız, kızıl saçlı bir Karlsson bebek; bayraklı bir kurşun asker, itfaiye aracı ve ilaçlama uçağı..."


translate turkish bunny2_happy_family_nightmare_e5afa70d:


    "Oyuncaklara kan değmemişti ama zihnim, kendince onlara kızıl fırça darbeleri vuruyordu."


translate turkish bunny2_happy_family_nightmare_918fce23:


    "Yaratığın boynuzlu gölgesi, bir zamanlar yabancı çocuklara ait olan hazineye düştü."


translate turkish bunny2_happy_family_nightmare_4f3c7ebe:



    voice "voice/kozel/2day/04 Beri.ogg"
    Master "Aal."


translate turkish bunny2_happy_family_nightmare_df9f5b41:


    "Etrafımızı kuşatan karanlığa tüylü ellerini daldırdı, kabusum olan uyuz tavşan maskesini çıkardı..."


translate turkish bunny2_happy_family_nightmare_dfb0b180:


    "Ve zorla yüzüme geçirdi."


translate turkish bunny2_happy_family_nightmare_a8a784eb:



    voice "voice/kozel/2day/05 Zaichick.ogg"
    Master "Tavşancık."


translate turkish bunny2_happy_family_nightmare_25a20648:


    "Etraftaki hayvanların gölgesi, ağır bir zarafetle arka ayakları üzerine doğruldu."


translate turkish bunny2_happy_family_nightmare_6b256c37:


    "Ardından yaratığı iki parça eden bir ışık yüzüme vurdu."


translate turkish bunny2_happy_family_nightmare_9353c0c1:


    "Korunmak için elimi siper ettim."


translate turkish bunny2_happy_family_nightmare_8ed2a454:


    "El fenerinden saçılan ışık alçaldı."


translate turkish bunny2_happy_family_nightmare_4cd4446e:



    voice "voice/father/day_2/32_anton_vot_ty_gde.ogg"
    Pap "Anton! Hele buldum seni!"


translate turkish bunny2_happy_family_nightmare_a563d76a:



    voice "voice/father/day_2/33_sovsem_sdyrel.ogg"
    Pap "Aklını mı kaçırdın?"


translate turkish bunny2_happy_family_nightmare_3c98f818:



    voice "voice/father/day_2/32_Anton_Z.ogg"
    Pap "Anton!"


translate turkish bunny2_happy_family_nightmare_3bf86ee1:



    voice "voice/father/day_2/32_vot_ty_gde.ogg"
    Pap "Hele buldum seni"


translate turkish bunny2_happy_family_nightmare_279897b7:



    voice "voice/father/day_2/33_sovsem_sdyrel.ogg"
    Pap "Aklını mı kaçırdın?"


translate turkish bunny2_happy_family_nightmare_4b28ec0e:



    voice "voice/father/day_2/34_eto_voobshe_kak_ponimat.ogg"
    Pap "Neyin peşindesin?"


translate turkish bunny2_happy_family_nightmare_c6bf311d:


    "Babam karanlıkların arasından çıkageldi."


translate turkish bunny2_happy_family_nightmare_5bf3b80e:


    "Kaçırdığım aklımın bana yeni bir oyun oynamadığını, babamın da yok olmayacağını umarak ona kavuşmak için fırladım."


translate turkish bunny2_happy_family_nightmare_6c59c72a:


    "Meğer tüm sıcaklığı ve diriliğiyle gerçekmiş."


translate turkish bunny2_happy_family_nightmare_fdc4907a:


    "Büyük şaşkınlıkla babama, az önceki yaratığın bulunduğu yere baktım."


translate turkish bunny2_happy_family_nightmare_d8a72140:


    "Açıklık tekrar karanlığa karışmıştı ama kardaki oyuncaklar ile şekerlerin hatlarını zar zor da olsa hâlâ seçebiliyordum."


translate turkish bunny2_happy_family_nightmare_38a0495d:


    "Ayrıca eminim ki çalılara yaklaşmaya cesaretim olsaydı orada hayvan izlerine de rastlardım."


translate turkish bunny2_happy_family_nightmare_60dc64e9:



    voice "voice/father/day_2/39_yazik_proglotil.ogg"
    Pap "Dilini kedi mi yuttu?"


translate turkish bunny2_happy_family_nightmare_c016f605:



    voice "voice/father/day_2/39_ya_vstretil_odnoklassnicy.ogg"
    Pap "Yolda sizin sınıftan bir kızla karşılaştım, dedi ki..."


translate turkish bunny2_happy_family_nightmare_e76111d5:



    voice "voice/father/day_2/36_ondoklassniki_tvoi.ogg"
    Pap "Sınıf arkadaşların bize geldi!"


translate turkish bunny2_happy_family_nightmare_ee41755c:



    voice "voice/father/day_2/36_skazali_chto_sbezhal.ogg"
    Pap "Dediler ki yanlarından kaçıp ormanın derinlerine gitmişsin de..."


translate turkish bunny2_happy_family_nightmare_8ff67639:



    voice "voice/father/day_2/36_chto_za_dryan_napyalil.ogg"
    Pap "O suratındaki ne öyle?"


translate turkish bunny2_happy_family_nightmare_81a4bbfa:


    "Maskeyi terli yüzümden çıkarıp oyuncak yığınına fırlattım."


translate turkish bunny2_happy_family_nightmare_6118b9bb:


    "Uzaktaki dallar çatırdadı."


translate turkish bunny2_happy_family_nightmare_8a477d1d:


    "Korktuğumdan babama sarılıp göğsüne kapandım. O da durumun farkına varıp etrafına bakınmaya başladı..."


translate turkish bunny2_happy_family_nightmare_db161afe:


    "Ve çok daha endişeli bir ses tonuyla dedi ki:"


translate turkish bunny2_happy_family_nightmare_024b51ad:



    voice "voice/father/day_2/41_poydem_otsyda.ogg"
    Pap "Pekala, hadi gidelim artık."


translate turkish bunny2_happy_family_nightmare_c1607f5b:



    voice "voice/father/day_2/41_mat_yznaet_kakoy.ogg"
    Pap "Annen, olanları duyarsa öyle bir kızar ki bugünü ömrümüz boyu unutamayız!"


translate turkish bunny2_happy_family_nightmare_eaae37d3:


    "Tüylerimi ürperten korkuyu henüz içimden atamadan babama elimi uzattım."


translate turkish bunny2_happy_family_nightmare_9b5b2bbe:


    "Elini sımsıkı tuttum, babamın hızla atan nabzını parmak uçlarımda hissettim."


translate turkish bunny2_happy_family_nightmare_383e5940:


    "Ardından ayağa kalkıp babamın peşinde bıraktığı silik ayak izlerini yalpalayarak takip ettim."


translate turkish bunny2_happy_family_nightmare_ea959f1e:


    "Medeniyete, aydınlığa, babamın aracını park ettiği yola yürüdük."


translate turkish bunny2_happy_family_nightmare_dcf43bfb:



    voice "voice/father/day_2/43_doma_ni_slova.ogg"
    Pap "Evde bu konuda tek kelime etmek yok, tamam mı?"


translate turkish bunny2_happy_family_nightmare_9a65af9c:



    voice "voice/father/day_2/43_ni_edinogo_nameka.ogg"
    Pap "Sakın ha, seni nerede bulduğumu çaktırma."


translate turkish bunny2_happy_family_nightmare_d30d8dd4:



    voice "voice/anton/2day/194. Da pap.ogg"
    Ant "Tamam baba."


translate turkish bunny2_happy_family_nightmare_36991087:


    "Babam, elimi dünyadaki en kıymetli şeymiş gibi tutuyor, beni veya Olya'yı kaybetmekten ne kadar korktuğunu sayıklıyordu."


translate turkish bunny2_happy_family_nightmare_15ef5576:


    "Başımla onaylayıp peşinden devam ettim."


translate turkish bunny2_happy_family_nightmare_a20cefa7_1:


    "..."


translate turkish bunny2_happy_family_nightmare_4c7d9bde:


    "Ne zaman ki arabaya vardık, babam sıyrıklarımı fark etti."


translate turkish bunny2_happy_family_nightmare_55475c3c:



    voice "voice/father/day_2/45_tebya_bili.ogg"
    Pap "Biri sana bir şey mi yaptı?"


translate turkish bunny2_happy_family_nightmare_b594bcb1:


    "Yanağıma dokundum."


translate turkish bunny2_happy_family_nightmare_70e75287:



    voice "voice/anton/2day/195. Podralsya.ogg"
    Ant "Kavga ettim."


translate turkish bunny2_happy_family_nightmare_a78db4eb:



    voice "voice/father/day_2/48_iz_za_chego.ogg"
    Pap "Niye?"


translate turkish bunny2_happy_family_nightmare_b1ef0239:



    voice "voice/anton/2day/196. Iz-za devushki.ogg"
    Ant "Kız meselesi."


translate turkish bunny2_happy_family_nightmare_db92180f:


    "Babam düşünceli bir şekilde kafa salladı."


translate turkish bunny2_happy_family_nightmare_16ca79b7:


    "Motorun çalışmasıyla boğuk bir ses yükseldi."


translate turkish bunny2_happy_family_nightmare_3f49dcb5:


    "Babamın yüzünde korkulu bir ifade sezmiştim. Tabii beni kabusumda kötürüm eden, sakız gibi yapışkan korkudan farklıydı bu sanırım."


translate turkish bunny2_happy_family_nightmare_4f52993c:


    "Onun korkusu, cam gibi bir elmas kadar asildi."


translate turkish bunny2_happy_family_nightmare_be29bd6c:


    "Torpidoyu açıp birkaç ıslak mendil çıkardı."


translate turkish bunny2_happy_family_nightmare_9e3cecc9:



    voice "voice/father/day_2/49_mama_by_seychas.ogg"
    Pap "Bak, ne diyeceğim oğlum: Annen olsa aksini söylerdi ama..."


translate turkish bunny2_happy_family_nightmare_da62b406:



    voice "voice/father/day_2/49_dratsya_za_devushky.ogg"
    Pap "Hoşlandığın kız için kavga ederek doğrusunu yapmışsın."


translate turkish bunny2_happy_family_nightmare_9306c95f:



    voice "voice/father/day_2/51_nyzno_reshat.ogg"
    Pap "Elbette önce meseleyi konuşup çözmek gerekir ancak kimi zaman... Kelimeler kifayetsiz kalır."


translate turkish bunny2_happy_family_nightmare_7a1efd37:


    "Babamın o anki gülümseyişi yüreklendiriciydi."


translate turkish bunny2_happy_family_nightmare_2236e6a7:


    "Tam torpidoyu kapatacakken içindeki bezin altında bir kabza ilişti gözüme."


translate turkish bunny2_happy_family_nightmare_71bf25b7:


    "Yanında silah taşıyormuş. Mürekkep yalamış bir birey olan babamın -tıpkı aksiyon filmi kahramanları gibi- silahı varmış."


translate turkish bunny2_happy_family_nightmare_2e6d3f91:


    "\"{i}Ya da haydutun teki gibi{/i}.\" dedi o an içimden bir ses."


translate turkish bunny2_happy_family_nightmare_47cba6b3:


    "Arabanın camından hızla arkamızda kalan çamlara bakıyordum. Arabanın farları karanlıkla güç bela başa çıkıyordu."


translate turkish bunny2_happy_family_nightmare_4f2e56c5:


    "Dört teker, evin yolunu tutmuştuk. Babam dikiz aynasından dikkatle beni süzüyordu."


translate turkish bunny2_happy_family_nightmare_5d1dee6b:


    "O esnada silahı, rüyalarımı, ailemin kılığına giren hayvan maskeli yabancıları düşünüyordum."


translate turkish bunny2_happy_family_nightmare_3b09f86b:


    "Ancak bunlar, insanın üstüne bir hayvan dili kadar yapışan korkular değildi."


translate turkish bunny2_happy_family_nightmare_e8eb508b:


    "Onun korkusu, cam gibi bir elmas kadar asildi. Dediklerini başımla onaylayıp peşinden devam ettim."


translate turkish bunny2_happy_family_nightmare_24b5ef79:


    "O an arkamdan tanıdık bir ses geldi:"


translate turkish bunny2_happy_family_nightmare_a0be3d3d:



    voice "voice/Alisa/Alisa2day/187 Pomni.ogg"
    Alis "Unutma..."


translate turkish bunny2_happy_family_nightmare_d9b462c6:



    voice "voice/Alisa/Alisa2day/188 Poka.ogg"
    Alis "Benimle olduğun sürece ormandaki hiç kimse sana zarar veremez."


translate turkish bunny2_happy_family_nightmare_a20cefa7_2:


    "..."


translate turkish bunny2_happy_family_nightmare_5a296b85:


    "Arabayla evin yolunu tuttuk."


translate turkish bunny2_happy_family_nightmare_5872c97d:


    "Yanağımı cama yaslamış, dışarıyı izlerken ağaçların arasında alçak bir konut, gece karası bir baraka gördüm."


translate turkish bunny2_happy_family_nightmare_70f5c86d:


    "Ağaçlarla örtülü garaj, metalden yapılmış bir mezar odası."


translate turkish bunny2_happy_family_nightmare_1661c63c:


    "Sanki bizi takip ediyordu."


translate turkish bunny2_happy_family_nightmare_ffef0761:


    "Bir süre sonra baraka, köşede gözden kayboldu."


translate turkish bunny2_happy_family_nightmare_dd1cc902:


    "Kederle yutkundum."


translate turkish bunny2_happy_family_nightmare_657be259:


    "Bembeyaz kar taneleri, yıldızlı gökyüzündeki dansına devam ediyordu."


translate turkish bunny2_home_evening_baeffe94:



    voice "voice/karina/2day/05 Tak ya ne.ogg"
    Mam "Bu ne hâl? Anton, gözlüğün nerede? Kayıp mı ettin yoksa?"


translate turkish bunny2_home_evening_abd546a8:



    voice "voice/anton/2day/Danumam.ogg"
    Ant "Anne, şey..."


translate turkish bunny2_home_evening_fb26fa52:



    voice "voice/karina/2day/06 I kak.ogg"
    Mam "Aklın beş karış havada gezersen tabii! Para basıyoruz da benim mi haberim yok?"


translate turkish bunny2_home_evening_7c826de7:



    voice "voice/karina/2day/06 Кakze.ogg"
    Mam "Peki madem! Seneye kadar eski gözlüğünle idare ediver."


translate turkish bunny2_home_evening_128338d7:


    "Olya hızla yanıma geldi."


translate turkish bunny2_home_evening_e4e3ea29:



    voice "voice/father/day_2/53_a_vot_i_my.ogg"
    Pap "İşte geldik!"


translate turkish bunny2_home_evening_06eeb0a9:



    voice "voice/karina/2day/Yavilis nezapililis.ogg"
    Mam "Bakın hele, kim gelmiş!"


translate turkish bunny2_home_evening_5d268b67:


    "Annem, babama attığı meşhur ters bakışıyla merdivenden iniyordu."


translate turkish bunny2_home_evening_86e99377:


    "Öfke ile horgörü arasında bir ifade takınmıştı."


translate turkish bunny2_home_evening_d8eaedce:


    "Aniden bakışlarını muhatabına soğuk terler akıtacak kadar uzun bir süreliğine bana dikti."


translate turkish bunny2_home_evening_baeffe94_1:



    voice "voice/karina/2day/05 Tak ya ne.ogg"
    Mam "Bu ne hâl? Anton, gözlüğün nerede? Kayıp mı ettin yoksa?"


translate turkish bunny2_home_evening_e6bc098b:



    voice "voice/father/day_2/Da v shkole.ogg"
    Pap "Herhalde okulda unutmuştur, kerata."


translate turkish bunny2_home_evening_92ed087e:


    "Kekremsi bir sessizlik oldu."


translate turkish bunny2_home_evening_0dfe5346:



    voice "voice/karina/2day/04 Ves.ogg"
    Mam "Kimin oğlu işte."


translate turkish bunny2_home_evening_cc623b33:


    "Babam, anneme dargınca baktıktan sonra bana anlaşmamızı hatırlatırcasına göz kırptı."


translate turkish bunny2_home_evening_c3f18f57:



    voice "voice/father/day_2/Nu nichego.ogg"
    Pap "Neyse ki yedek gözlüğümüz var, onunla idare ederiz."


translate turkish bunny2_home_evening_92dac484:


    "Annemle babam bir süre daha sessiz kaldıktan sonra kendi işlerine bakmaya koyuldu."


translate turkish bunny2_home_evening_c9668956:


    "Olya, henüz ben montumu çıkaramadan kollarıma atladı."


translate turkish bunny2_home_evening_1357ba80:



    voice "voice/olya/2day/04 A ya.ogg"
    Oly "Tilki gördüm!"


translate turkish bunny2_home_evening_449d9e9e:


    "Beynimden vurulmuşçasına şaşkına döndüm."


translate turkish bunny2_home_evening_7f73c68f:


    "Dudaklarımı ancak anlamsızca kıpırdatabildim."


translate turkish bunny2_home_evening_b16cd6e7:


    "Aniden şiddetli bir şangırtı sesi patlak verdi."


translate turkish bunny2_home_evening_74bc3627:


    "Annem elindeki fincanı düşürüp paramparça etmişti."


translate turkish bunny2_home_evening_6a526f4a:


    "Beti benzi atmış, gözünü yerden ayıramıyordu."


translate turkish bunny2_home_evening_ea1564a6:


    "O saniyelik duraksama, hiç son bulmayacak gibi gelmişti."


translate turkish bunny2_home_evening_c50f66cf:


    "Ancak sonrasında annem hüsranını dile getirdi:"


translate turkish bunny2_home_evening_777bddaa:



    voice "voice/karina/2day/88 To sova to lisa.ogg"
    Mam "Önce baykuştu, şimdi de tilki çıktı başımıza!"


translate turkish bunny2_home_evening_e0dfd3dd:



    voice "voice/karina/2day/89 Kogda zh.ogg"
    Mam "Bıkmadın mı bunlardan yahu?"


translate turkish bunny2_home_evening_a40999a9:



    voice "voice/olya/2day/05 Pravda-pravda.ogg"
    Oly "Ama gerçek diyorum anne!"


translate turkish bunny2_home_evening_fe3a47fa:



    voice "voice/olya/2day/06 Takaya.ogg"
    Oly "Nasıl da pofuduktu!"


translate turkish bunny2_home_evening_d38a15de:



    voice "voice/olya/2day/07 Ona u zabora.ogg"
    Oly "Çitin orada tıpkı insan gibi arka ayakları üzerine doğruldu."


translate turkish bunny2_home_evening_c17db89b:



    voice "voice/olya/2day/08 Ona menya.ogg"
    Oly "Tilki, adımı çağırdı ama annem gelince kaçtı."


translate turkish bunny2_home_evening_8f99ea53:



    voice "voice/karina/2day/90 Ne bilo tam.ogg"
    Mam "Tilki falan yoktu."


translate turkish bunny2_home_evening_3f650de5:



    voice "voice/karina/2day/91 Ne vid.ogg"
    Mam "Kafandan uydurmayı bırak!"


translate turkish bunny2_home_evening_d0642c18:



    voice "voice/anton/2day/212. Ne podhodi k nei.ogg"
    Ant "Sakın ona yaklaşma!"


translate turkish bunny2_home_evening_f2f3942b:


    "Gerekirse kardeşimi bir bez bebek gibi silkeleyip aklını başına toplamaya razıydım."


translate turkish bunny2_home_evening_9ffaaf27:



    voice "voice/olya/2day/09 Ti chego.ogg"
    Oly "Niye ki Toşa?"


translate turkish bunny2_home_evening_6f6e2ff8:



    voice "voice/anton/2day/213. Ne podhodi slish.ogg"
    Ant "Yaklaşma dedim sana!"


translate turkish bunny2_home_evening_6763db01:


    "Annem koridora çıkıp şaşkınlıkla bana baktı."


translate turkish bunny2_home_evening_b0277fbe:


    "Lafımı sakınma ihtiyacı hissettim."


translate turkish bunny2_home_evening_3035267b:



    voice "voice/anton/2day/214. Nu lisa ved.ogg"
    Ant "Yani tilki bu, ısırır."


translate turkish bunny2_home_evening_ce4108af:


    "Tilkilerin çocukları kaçırdığı masalları hatırladım."


translate turkish bunny2_home_evening_ca61f047:


    "Yırtıcı Alisa'cığımın elinde torbayla gece vakti ormanı arşınladığını hayal ettim."


translate turkish bunny2_home_evening_23f1bd90:


    "Yırtıcı Alisa'nın elinde torbayla gece vakti ormanı arşınladığını hayal ettim."


translate turkish bunny2_home_evening_4c12205d:



    voice "voice/karina/2day/92 Eto ze.ogg"
    Mam "O tilki gerçek değil."


translate turkish bunny2_home_evening_fb8c9c17:



    voice "voice/karina/2day/93 Rasskazi.ogg"
    Mam "Söylesene abine, Olya."


translate turkish bunny2_home_evening_953c4e04:



    voice "voice/olya/2day/10 Ona na.ogg"
    Oly "Elbise giymiş, iki ayağı üstünde duruyordu..."


translate turkish bunny2_home_evening_332b747a:



    voice "voice/olya/2day/11 Tolko ona.ogg"
    Oly "Ama gerçekti işte."


translate turkish bunny2_home_evening_4eb5229d:



    voice "voice/karina/2day/94 Vidish.ogg"
    Mam "Duydun mu?"


translate turkish bunny2_home_evening_bde3724c:


    "Annem, konunun açıklığa kavuşması için Olya'nın bu yanıtı yeterli olmuşçasına bezginlikle gülümsedi."


translate turkish bunny2_home_evening_1bdfe85d:


    "Ben de zoraki bir gülümsemeyle yanıt verdim."


translate turkish bunny2_home_evening_029da0b1:


    "Gülüşüm, insanın avucunda eriyip gitmek üzere olan incecik bir kalıp sabun gibiydi."


translate turkish bunny2_home_evening_17dc1c73:


    "Kardeşimle baş başa kaldığım gibi fısıldadım:"


translate turkish bunny2_home_evening_51d2c40c:



    voice "voice/anton/2day/215. Eshe raz.ogg"
    Ant "Onu tekrar görürsen kaç."


translate turkish bunny2_home_evening_e296527c:


    "Ailemi çirkin maskelerin ardında gördüğüm o kabusun hatıraları, beklenmedik anda sınıftakilerden yediğim yumruklar gibi üzerime yağıyordu."


translate turkish bunny2_home_evening_5388e389:


    "Ailemin vıcık vıcık salyalı, keskin dişli, kürklü yüzleri gözümün önüne geldi."


translate turkish bunny2_home_evening_19d193f4:


    "Ne oluyor bana?"


translate turkish bunny2_home_evening_6e7e4bc3:


    "Aklım bana ne biçim oyunlar oynuyor?"


translate turkish bunny2_home_evening_47c357bf:


    "Tavşan maskesi gerçekti. Sanki kendisini ormana hiç atmamışım gibi ansızın sırt çantamdan çıkıvermişti."


translate turkish bunny2_home_evening_6aab693b:


    "Ormandaki o yaratığın düşüncesi, sağanak bir şeker ve oyuncak yağmuru gibi üzerime yağdı."


translate turkish bunny2_home_evening_dfd32328:


    "Arkasına ağaçlığı almış, önümde dikilen tüylü bir silüet vardı."


translate turkish bunny2_home_evening_77813321:


    "Kimdi o? Ormanda ne olmuştu?"


translate turkish bunny2_home_evening_19d193f4_1:


    "Ne oluyor bana?"


translate turkish bunny2_home_evening_7ae65de0:


    "Gözlerimi kapayıp, vitaminlerimi ağzıma atıp bir yudum suyla mideye indirdim."


translate turkish bunny2_home_evening_0e705f7b:


    "Beni daha da delirtmeyin, lütfen."


translate turkish bunny2_night_room_anton_table_d5dbc47c:


    "Ev ödevimin başına zar zor oturabildim ancak matematik problemleri epey güçlük çıkardı."


translate turkish bunny2_night_room_anton_table_dc7bfe1f:


    "Defterdeki sayılar dans edercesine fırıl fırıl dönüyor, birbirine karışıyor, arada bir de çizgilerin dışına taşıyordu."


translate turkish bunny2_night_room_anton_table_c1a431a4:


    "Tüm bu curcuna yüzünden epey ağırlaştım, az kalsın o sayı zincirine kafayı gömüyordum."


translate turkish bunny2_night_room_anton_table_a6208c31:


    "Sanki göz kapaklarıma pazardaki okkalardan bağlanmış gibiydi."


translate turkish bunny2_night_room_anton_table_9417e8b6:


    "O günün anıları, tam da pes edip defterimi kapamışken gözlerimin önünden film şeridi gibi geçmeye başladı."


translate turkish bunny2_night_room_anton_table_801ca47a:


    "Her pazar akşamında olduğu gibi ödevlerimi yapıyordum."


translate turkish bunny2_night_room_anton_table_2b4f1e9e:


    "Zor kısmı çoktan bitmişti."


translate turkish bunny2_night_room_anton_table_151d538e:


    "Geriye sadece en sevdiğim dersin ödevi, yani resim kalmıştı."


translate turkish bunny2_night_room_anton_table_d5f7abe8:


    "Fantastik bir yaratık çizmem gerekiyordu."


translate turkish bunny2_night_room_anton_table_461bdffe:


    "Aslında dinozor çizmek istemiştim ama fırçam, kendini turuncu boyaya daldırıverdi."


translate turkish bunny2_night_room_anton_table_322861da:


    "Bir fırça darbesi, bir tane daha derken kağıtta bir tilki resmi oluşmaya başladı."


translate turkish bunny2_night_room_anton_table_f7447bc7:


    "Kar beyaz kağıttan fırlayacak gibi görünüyordu."


translate turkish bunny2_night_room_anton_table_0a68415d:


    "Yüzünde kurnaz bir gülüşle arka ayakları üzerinde duruyordu."


translate turkish bunny2_night_room_anton_table_e83675a3:


    "Fırçam, tekrar işe koyulup pofuduk bir kuyruk çizdikten az sonra çelimsiz parmaklarımdan düşüverdi."


translate turkish bunny2_night_room_anton_table_205d4b06:


    "Tamamladığım resmimi bir süre, bu kızıl yaratığın nereden çıktığını anlayamamışçasına şaşkınlıkla inceledim."


translate turkish bunny2_night_room_anton_table_5671e505:


    "Baktıkça gülüşü daha da korkunç bir hâl alıyordu."


translate turkish bunny2_night_room_anton_table_ec62154c:


    "Şehirdeki büfelerde satılan yetişkin dergilerinde yer alan kadınlarınki gibi yırtıcı ama sahte..."


translate turkish bunny2_night_room_anton_table_ef18976e:


    "Altına kök salan art niyetleri maskeleyen çekici bir gülüştü."


translate turkish bunny2_night_room_anton_table_f81f1ad6:


    "Tilkinin gözleri de kan sıçramışçasına kıpkırmızı olmuştu."


translate turkish bunny2_night_room_anton_table_a07d007e:


    "Daha çok aksiyon filmlerindeki mermi deliklerini anımsatıyordu."


translate turkish bunny2_night_room_anton_table_e6e92568:


    "Gözlerini böyle çizmemiştim sanki."


translate turkish bunny2_night_room_anton_table_7e83ba8d:


    "Masamdan ve lambanın ıslak boyadan yansıyan ışığından uzaklaştım."


translate turkish bunny2_night_room_anton_table_7524ce4e:


    "Resmim pek göz alıcıydı. Sanki kağıttaki tilki beni izliyor..."


translate turkish bunny2_night_room_anton_table_f4ccc382:


    "Ve sabırla..."


translate turkish bunny2_night_room_anton_table_650c389e:



    voice "voice/father/day_2/55_anton.ogg"
    Pap "Anton!"


translate turkish bunny2_night_room_anton_table_663ca060:



    voice "voice/father/day_2/56_ty_ogloh_B.ogg"
    Pap "Sağır mısın?"


translate turkish bunny2_night_room_anton_table_c2761792:



    voice "voice/anton/2day/217. Ya zadumals.ogg"
    Ant "D-dalmışım."


translate turkish bunny2_night_room_anton_table_68143d59:



    voice "voice/father/day_2/57_tebya_sprashivau.ogg"
    Pap "Bir daha soruyorum, kardeşini gördün mü?"


translate turkish bunny2_night_room_anton_table_72f1e974:



    voice "voice/father/day_2/58_opyat_ona_gdeto.ogg"
    Pap "Yine bir yere saklanmış."


translate turkish bunny2_night_room_anton_table_49a8276e:


    "Yatağımın altında bir kıpırtı hissedip donakaldım."


translate turkish bunny2_night_room_anton_table_c4c13261:


    "İşaret parmağını diklemesine dudağına konduran Olya'nın tozlu yüzünü gördüm."


translate turkish bunny2_night_room_anton_table_762236ce:



    voice "voice/olya/2day/13 Tss.ogg"
    Oly "Şş."


translate turkish bunny2_night_room_anton_table_7c145aff:



    voice "voice/father/day_2/59_olya_ya_vizhu.ogg"
    Pap "Olya! Seni görüyorum."


translate turkish bunny2_night_room_anton_table_9c2e8d4b:



    voice "voice/father/day_2/59_vylezhai.ogg"
    Pap "Çık oradan. Üstün başın toz olmuş!"


translate turkish bunny2_night_room_anton_table_6013a7a6:


    "Olya sürünerek yatağın altından çıktı, eğilip çoraplarını silkeledi."


translate turkish bunny2_night_room_anton_table_64d160b7:



    voice "voice/father/day_2/60_poydem_ol.ogg"
    Pap "Hadi kızım."


translate turkish bunny2_night_room_anton_table_2b271ae5:



    voice "voice/father/day_2/60_ya_tebe_skazky_pochitau.ogg"
    Pap "Gel de sana masal okuyayım."


translate turkish bunny2_night_room_anton_table_5068a23b:



    voice "voice/father/day_2/60_posizhu_s_toboy_poka.ogg"
    Pap "Uykuya dalana dek başından ayrılmayacağım."


translate turkish bunny2_night_room_anton_table_f4cd89d6:



    voice "voice/olya/2day/14 Ya s vami.ogg"
    Oly "Ama ben kendi odamda değil, sizinle uyumak istiyorum."


translate turkish bunny2_night_room_anton_table_963d0354:



    voice "voice/olya/2day/15 Tam.ogg"
    Oly "Orası..."


translate turkish bunny2_night_room_anton_table_2870c108:


    "Odaya annem girdi."


translate turkish bunny2_night_room_anton_table_3547b730:



    voice "voice/karina/2day/102 Chto opyat.ogg"
    Mam "Ne var, yine mi baykuş?"


translate turkish bunny2_night_room_anton_table_c7fb241f:



    voice "voice/father/day_2/61_a_kto_eshe.ogg"
    Pap "Başka ne olacaktı?"


translate turkish bunny2_night_room_anton_table_42f12ce4:



    voice "voice/father/day_2/61_ol_ona_ne_pridet.ogg"
    Pap "Kızım, baykuş artık gelmeyecek."


translate turkish bunny2_night_room_anton_table_1cd31267:



    voice "voice/father/day_2/61_ya_ee_prognal.ogg"
    Pap "Kovdum ben onu."


translate turkish bunny2_night_room_anton_table_4ee58437:


    "Olya, bu söze inanmadığından kafasını iki yana salladı."


translate turkish bunny2_night_room_anton_table_148c1168:



    voice "voice/olya/2day/Neprognal.1.ogg"
    Oly "Kovmadın ki..."


translate turkish bunny2_night_room_anton_table_e80c5929:



    voice "voice/olya/2day/Onapridet.2.ogg"
    Oly "Tekrar gelecek."


translate turkish bunny2_night_room_anton_table_ba9aa114:



    voice "voice/olya/2day/Ona skazala.3.ogg"
    Oly "Her gece geleceğini söyledi."


translate turkish bunny2_night_room_anton_table_375607ad:



    voice "voice/father/day_2/62_o_tak_ona.ogg"
    Pap "Ah, şimdi de dile mi geldi?"


translate turkish bunny2_night_room_anton_table_d7c86999:


    "Olya, bu soruyu duymazdan gelip yepyeni bir umutla tekrar sordu:"


translate turkish bunny2_night_room_anton_table_208cbe1f:



    voice "voice/olya/2day/Moznoyasva.1.ogg"
    Oly "Sizinle uyuyabilir miyim?"


translate turkish bunny2_night_room_anton_table_41665d8d:



    voice "voice/olya/2day/Mozno.2.ogg"
    Oly "Lütfen!"


translate turkish bunny2_night_room_anton_table_bff4ad70:



    voice "voice/olya/2day/Vsamiposledni.3.ogg"
    Oly "Son kez olsun."


translate turkish bunny2_night_room_anton_table_47bf8998:



    voice "voice/karina/2day/103 Ty ze govorila.ogg"
    Mam "Dün de aynısını dememiş miydin?"


translate turkish bunny2_night_room_anton_table_43ff6005:



    voice "voice/father/day_2/63_olga_ty_yzhe_bolshaya.ogg"
    Pap "Olga, abla olacak yaşa geldin artık."


translate turkish bunny2_night_room_anton_table_2b273d34:



    voice "voice/anton/2day/Apust.ogg"
    Ant "Gelsin, benim yanımda uyusun!"


translate turkish bunny2_night_room_anton_table_b144830c:


    "Bence iyi bir fikirdi ama Olya tekrar başını salladı."


translate turkish bunny2_night_room_anton_table_81b612f7:



    voice "voice/olya/2day/18 Net u tebya.ogg"
    Oly "Hayır, seninle uyumak istemiyorum. Seni de izliyor."


translate turkish bunny2_night_room_anton_table_21bc3017:


    "Tüylerim tepeden tırnağa diken diken oldu."


translate turkish bunny2_night_room_anton_table_8cf1b1fc:



    voice "voice/karina/2day/104 Hvatit.ogg"
    Mam "Yeter!"


translate turkish bunny2_night_room_anton_table_cf86e983:



    voice "voice/karina/2day/105 Net nikakoy.ogg"
    Mam "Baykuş maykuş yok!"


translate turkish bunny2_night_room_anton_table_1ae542ba:



    voice "voice/karina/2day/105 Ty segodnya.ogg"
    Mam "Kendi odanda uyuyacaksın, diyorum sana!"


translate turkish bunny2_night_room_anton_table_63e28d8d:



    voice "voice/olya/2day/Nupozaluistamam.ogg"
    Oly "Ama anne, lütfen!"


translate turkish bunny2_night_room_anton_table_621ce3f2:



    voice "voice/olya/2day/Pozaluista.ogg"
    Oly "Lütfen!"


translate turkish bunny2_night_room_anton_table_db6656c0:


    "Annem, elinden tuttuğu Olya'yı odamdan çıkarmayı denedi."


translate turkish bunny2_night_room_anton_table_ef053e5f:



    voice "voice/karina/2day/106 Poydem milaya.ogg"
    Mam "Hadi tatlım, abini rahat bırakalım."


translate turkish bunny2_night_room_anton_table_4aa30553:


    "Olya, boştaki eliyle yatağımın başlığına tutunuverdi."


translate turkish bunny2_night_room_anton_table_889077a3:



    voice "voice/olya/2day/PozaluistaPozaluista.ogg"
    Oly "Lütfen! Lütfen! Lütfen!"


translate turkish bunny2_night_room_anton_table_9ef7873d:



    voice "voice/olya/2day/Nehochyknei.ogg"
    Oly "Odama gitmek istemiyorum!"


translate turkish bunny2_night_room_anton_table_44a0d149:


    "Annem Olya'yı kendine çekmeye çalışsa da ne fayda, o esnada yatağın başlığı can çekişircesine gıcırdıyordu."


translate turkish bunny2_night_room_anton_table_304a07c4:


    "Araya girme ihtiyacı hisseden babam, çaresizce direnip derdini anlatmaya çalışan Olya'yı kucaklayıp odadan çıkardı."


translate turkish bunny2_night_room_anton_table_57328fbe:



    voice "voice/olya/2day/Nenado.ogg"
    Oly "Olmaz!"


translate turkish bunny2_night_room_anton_table_1a61fb1c:



    voice "voice/olya/2day/Nenadoknei.ogg"
    Oly "Bırak!"


translate turkish bunny2_night_room_anton_table_88f9939e:



    voice "voice/olya/2day/Onaopyatsmotret.ogg"
    Oly "Yine beni izleyecek!"


translate turkish bunny2_night_room_anton_table_2899033f:


    "Kardeşimi yatağına yatırmak için annemle babamın verdiği mücadeleyi dinledim."


translate turkish bunny2_night_room_anton_table_a6df4a01:


    "Nihayetinde pes edip Olya'nın yanlarında uyumasına razı geldiler."


translate turkish bunny2_night_room_anton_table_cd232cb9:


    "Kesinlikle son kezdi tabii."


translate turkish bunny2_night_room_anton_table_f30a2b77:


    "Herkes durulunca -yatağımda uzanırken- Olya'nın sözleri kulağımda çınladı:"


translate turkish bunny2_night_room_anton_table_a038bb74:



    voice "voice/olya/2day/Ona.ogg"
    "\"Seni de izliyor.\""


translate turkish bunny2_night_room_anton_table_0acea364:


    "Huzursuzlanmıştım."


translate turkish bunny2_night_room_anton_table_e208a4ad:


    "Odamın perdelerini sımsıkı kapayınca anca sakinleyebildim."


translate turkish bunny2_night_room_anton_table_55e88530:


    "Ancak o gün yaşadıklarım, gözlerimi kapadığım gibi zihnimde canlanıverdi."


translate turkish day2_nightmare_c986b703:


    "Kalabalık bir okul koridorunun tam ortasındaydım."


translate turkish day2_nightmare_f0227932:


    "Olduğum yerden edebiyat sınıfını, ölü klasik yazarların portreleri ve sınıf öğretmenimiz Liliya Pavlovna'nın heybetli olduğu kadar ciddi duruşunu görebiliyordum."


translate turkish day2_nightmare_a6fe7ba9:


    "Köşede de dedikoducu ve ispiyoncu kızı Katya, sabırsızlıkla beni bekliyordu."


translate turkish day2_nightmare_7b25238d:



    voice "voice/kate/15 KA.ogg"
    Kate "Hişt, yeni çocuk! Yeni çocuk!"


translate turkish day2_nightmare_e01fce44:



    voice "voice/anton/2day/219. Chego tebe.ogg"
    Ant "Ne var Katya?"


translate turkish day2_nightmare_7a580114:


    "Elleri arkasında, ayaklarının ucuna yükseldi ve yüzünde yapmacık bir gülüşle sordu:"


translate turkish day2_nightmare_c9a2d820:



    voice "voice/kate/16 KA.ogg"
    Kate "Söyler misin, buraya neden nakloldun, he?"


translate turkish day2_nightmare_ea980f9d:


    "Esas nedenini Polina sormuş olsaydı söylerdim."


translate turkish day2_nightmare_15182214:


    "Ancak Katya, bunun dedikodusunu sakız parasına satardı. Bu da kafamın içindeki düşüncelerin çıktısını alıp herkesin okuması için Vova'nın resminin yanına asmaktan farksız olurdu."


translate turkish day2_nightmare_232b9f9c:


    "Bu yüzden ezberime danıştım:"


translate turkish day2_nightmare_6ea49044:



    voice "voice/anton/2day/220 Eto vse.ogg"
    Ant "Ebeveynlerim yüzünden..."


translate turkish day2_nightmare_faa9b193:



    voice "voice/anton/2day/220.2 U papi.ogg"
    Ant "Babam burada yeni bir iş buldu, annem de... Annem..."


translate turkish day2_nightmare_66b3616b:


    "Katya beni doğru düzgün dinlememişti bile. Kulaklarını çanak anten gibi çeviren arkadaşlarının yanına hemen yetişip, ara ara bana bakıp kikirdeyerek bir şeyler fısıldadı."


translate turkish day2_nightmare_f139ff72:



    voice "voice/kate/17 KA.ogg"
    Kate "Aynen, aynen, kesin öyledir!"


translate turkish day2_nightmare_f0855326:



    voice "voice/kate/18 KA.ogg"
    Kate "Bizi aptal yerine koyuyor bu bücür."


translate turkish day2_nightmare_a57da774:



    voice "voice/kate/19 KA.ogg"
    Kate "Duydum ki her şey babası yüzündenmiş."


translate turkish day2_nightmare_55750c13:



    voice "voice/kate/20 KA.ogg"
    Kate "Kodamanın tekine yamuk mu yapmış, nedir, ailecek saklanmaya gelmişler köyümüze."


translate turkish day2_nightmare_391ded90:



    voice "voice/anton/2day/221. Nepravda.ogg"
    Ant "Yok öyle bir şey! Sallama!"


translate turkish day2_nightmare_95e3f6b0:



    voice "voice/kate/21 KA.ogg"
    Kate "Ah, Baburin'e yok yere yumruk attığından da haberiniz var mı?"


translate turkish day2_nightmare_ecc158fb:



    voice "voice/kate/22 KA.ogg"
    Kate "İnsan nasıl bir zırdeli olmalı ki daha ilk günden sınıf arkadaşlarına zorbalık yapsın?"


translate turkish day2_nightmare_056a4040:



    voice "voice/anton/2day/222. Prekrati on perviy.ogg"
    Ant "Kes! Farkındaysan o başlatmıştı!"


translate turkish day2_nightmare_95c2baf1:



    voice "voice/kate/23 KA.ogg"
    Kate "Bir de bunun üstüne Baburin'den bir güzel dayak yedi, onu duydunuz mu?"


translate turkish day2_nightmare_73e4b8a7:



    voice "voice/kate/24 KA.ogg"
    Kate "Pısırıklık edip yediği dayağa gıkını bile çıkaramadı."


translate turkish day2_nightmare_319b2ee8:



    voice "voice/anton/2day/223. Prekrati ne odin.ogg"
    Ant "Kes dedim! Tek başına değildi, bunu sen de biliyorsun!"


translate turkish day2_nightmare_f1976bd2:



    voice "voice/kate/25 KA.ogg"
    Kate "Tüm bunlar yetmezmiş gibi..."


translate turkish day2_nightmare_23c74b4e:



    voice "voice/kate/32 KA.ogg"
    Kate "Duyduğuma göre bu ucube, yanında sürekli tavşan maskesiyle geziyormuş."


translate turkish day2_nightmare_0ec83e58:



    voice "voice/kate/33 KA.ogg"
    Kate "Aklıselim insan hiç böyle şeyler yapar mı, he kızlar?"


translate turkish day2_nightmare_a256839c:



    voice "voice/kate/34 KA.ogg"
    Kate "Antoşka'nın gerçekten özel bir çocuk olduğu çok belli."


translate turkish day2_nightmare_bbf15fa8:



    voice "voice/kate/35 KA.ogg"
    Kate "Belki otistiktir, bilemiyorum ama..."


translate turkish day2_nightmare_56ee0596:



    voice "voice/kate/36 KA.ogg"
    Kate "Ya seri katilse?"


translate turkish day2_nightmare_52f64465:



    voice "voice/kate/38 KA.ogg"
    Kate "Çantasının altını üstüne getirsek eminim, balta veya daha da beter şeyler çıkar içinden!"


translate turkish day2_nightmare_ada749bb:



    voice "voice/kate/26 KA.ogg"
    Kate "Diyorlar ki Romka Pyatifan ve yanındaki serserilerle takılıyormuş."


translate turkish day2_nightmare_0dfa5d19:



    voice "voice/kate/27 KA.ogg"
    Kate "Çantalarınıza sahip çıkın, kızlar!"


translate turkish day2_nightmare_54aa5bf9:



    voice "voice/kate/28 KA.ogg"
    Kate "Dolabımdaki kıyafetler birer birer kaybolsa hiç şaşırmam şu an."


translate turkish day2_nightmare_ba6bc255:



    voice "voice/kate/29 KA.ogg"
    Kate "Nasılsa kimin suçlu olduğunu biliyoruz: Petrov ve arkadaşları."


translate turkish day2_nightmare_23c74b4e_1:



    voice "voice/kate/32 KA.ogg"
    Kate "Duyduğuma göre bu ucube, yanında sürekli tavşan maskesiyle geziyormuş."


translate turkish day2_nightmare_0ec83e58_1:



    voice "voice/kate/33 KA.ogg"
    Kate "Aklıselim insan hiç böyle şeyler yapar mı, he kızlar?"


translate turkish day2_nightmare_a256839c_1:



    voice "voice/kate/34 KA.ogg"
    Kate "Antoşka'nın gerçekten özel bir çocuk olduğu çok belli."


