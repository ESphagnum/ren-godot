translate turkish day2_nightmare_8c9ce15c:



    voice "voice/olya/2day/44 Pls.ogg"
    Oly "Lütfen!"


translate turkish day2_nightmare_9493d8c7:


    "Mehtabın aniden solmasıyla odam karanlığa gömülmüş, o parlak göz de kaybolmuştu."


translate turkish day2_nightmare_60783264:


    "Boğazıma oturan yumruyu küçük dilim gibi yuttum."


translate turkish day2_nightmare_87ce9218:


    "Biçimsiz misafirimin lafına kanıp perdeye bir adım yaklaştım."


translate turkish day2_nightmare_19c692ba:


    "Olya arkamdan \"Uslu olacağım, uslu olacağım, uslu olacağım!\" diye sayıklıyordu."


translate turkish day2_nightmare_36cbc57e:


    "Soğuk pencerenin hemen önündeki perde hışırdadı."


translate turkish day2_nightmare_4dd91d3d:


    "Korkumla yüzleşmek için perdeyi açmaya uzandım."


translate turkish day2_nightmare_8c15bcf2:


    "Tam o anda annemlerin odasından bir ses geldi."


translate turkish day2_nightmare_67c78d98:


    "Tereddüt bile etmeden tek harekette perdeyi açtım."


translate turkish day2_nightmare_4bb628cf:


    "Kimse yoktu."


translate turkish day2_nightmare_e92e7cf6:


    "Tuhaftır ki pencerenin önündeki bir tutam tüyün arasında parlak bir şey duruyordu."


translate turkish day2_nightmare_eaa01684:


    "Gözlüğüm."


translate turkish day2_nightmare_be6ab821:


    "Hani Semyon'un benden çarptığı..."


translate turkish day2_nightmare_e7909e93:


    "Burada ne arıyordu ki?"


translate turkish day2_nightmare_e88263aa:


    "Acaba çağlayan gecenin lütfu muydu yoksa baykuş mu getirmişti?"


translate turkish day2_nightmare_366e9cd3:


    "Bahçeye, uğursuz kıra ve dikenlerle dolu ormana baktım."


translate turkish day2_nightmare_fc1cc08c:


    "İn cin top oynuyordu. Gececi misafirden eser yoktu."


translate turkish day2_nightmare_c4fd22f0:


    "Tek görebildiğim, karlı çöllerde yalnız bir bekçi gibi hayale dalmış, eski lamba direğiydi."


translate turkish day2_nightmare_e3d48c2e:


    "Penceredeki kupkuru çıta gıcırdadı."


translate turkish day2_nightmare_d1ac9215:


    "Üzerindeki yalıtım bandını ve {u}yapışık gazete şeritlerini{/u} kopardım."


translate turkish day2_nightmare_46c562d6:


    "Pencereyi güç bela açtım."


translate turkish day2_nightmare_74e37d7d:


    "Dondurucu soğukla olduğum yere mıhlandım. Odamın duvarlarındaki resimler de içeri giren esintiyle titreyiverdi."


translate turkish day2_nightmare_13dba34e:


    "Elime aldığım gibi eriyip gideceğini sansam da..."


translate turkish day2_nightmare_dc860464:


    "Gözlüğüme dokunduğumda gerçek olduğunu anladım."


translate turkish day2_nightmare_32f6824d:


    "Tüm bunlara anlam verebilmek için aklım var gücüyle uğraştı. Semyon ve tayfası bana eşek şakası yapmıştı herhalde."


translate turkish day2_nightmare_9c797ad5:


    "Öyle olsa gerek."


translate turkish day2_nightmare_720c0ba4:


    "Bahçemizin önündeki sokak lambasının altına serpilen kar taneleri, parıldayarak pürüzsüz kar tabakasına konuyordu."


translate turkish day2_nightmare_b99940ae:


    "Biri gerçekten evimize sokulup borudan falan pencereme tırmansaydı ardında iz bırakırdı."


translate turkish day2_nightmare_d910f327:


    "Ancak hiç ayak izi de yoktu."


translate turkish day2_nightmare_cf3dd397:


    "Gözlüğümü dikkatlice aldım."


translate turkish day2_nightmare_47d9aa6c:


    "Bileğim hâlâ yerindeydi."


translate turkish day2_nightmare_54bddbb1:


    "Kimse beni tutup amansız, azgın karanlığa sürüklememişti."


translate turkish day2_nightmare_88a04769:



    voice "voice/karina/2day/95 Vy pochemy.ogg"
    Mam "Niye yatağınızda değilsiniz siz?"


translate turkish day2_nightmare_492e8f8a:


    "Annemin sesini duymamla dengemi kaybedip camdan düşeyazdım."


translate turkish day2_nightmare_e1dd7c56:



    voice "voice/karina/2day/96 Sovsem sdyreli.ogg"
    Mam "Aklınızdan zorunuz mu var?"


translate turkish day2_nightmare_139b9270:



    voice "voice/karina/2day/97 Zharko.ogg"
