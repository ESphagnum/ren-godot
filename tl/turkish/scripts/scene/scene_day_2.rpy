    Fox "Eminim, aklını kaçırırsın."


translate turkish bunny2_take1_c7b933ef:


    "Sıra dışı ikramlar."


translate turkish bunny2_take1_0f8da800:


    "Tıpkı ona dair diğer her şey gibi."


translate turkish bunny2_take1_65a7c4bf:


    "Nadide bir kelebeği kavanoza saklar gibi özenle resmi çantama koydum. Tilki kikirdedi."


translate turkish bunny2_take1_944a71a2:


    "Bir pazartesi sabahının böyle gelişeceğini kim tahmin edebilirdi?"


translate turkish bunny2_cont1_60165612:


    "Kimsin sen?"


translate turkish bunny2_cont1_3a3fce99:


    "Bu soruyu dile getirmekten kaçındım. Zaten yanıt da vermezdi veya yalan söyleyip geçiştirirdi."


translate turkish bunny2_cont1_8362ccae:


    "Maskenin ardındaki yüzü görmeyi çok istiyordum."


translate turkish bunny2_cont1_f434882e:


    "Onun sıradan bir kız olmadığına olan inancım her saniye artıyordu."


translate turkish bunny2_cont1_9e04e60a:



    voice "voice/Alisa/Alisa2day/70 Mozet Vova.ogg"
    Fox "Ya Vova da bulduğu şeker dolu bir kar yığınında yüzüyorsa?"


translate turkish bunny2_cont1_2093f378:



    voice "voice/Alisa/Alisa2day/71 Slushai.ogg"
    Fox "Hatta ya ormanda yaşamaya karar verdiyse?"


translate turkish bunny2_cont1_c4af9d85:



    voice "voice/Alisa/Alisa2day/72 Togda navernoe.ogg"
    Fox "Eldiveninin teki olmadan donuyordur oracıkta."


translate turkish bunny2_cont1_4ba0c838:


    "Rüzgar, tilkinin sözlerini ateşten duman alırcasına alıp karanlığın derinlerine, ürpertici ağaçlığa götürdü."


translate turkish bunny2_cont1_dde789ff:


    "Arkamdaki ağaçların kılçıksı dalları çıtırdadı."


translate turkish bunny2_cont1_1d92fe5b:



    voice "voice/Alisa/Alisa2day/73 Ili s nim.ogg"
    Fox "Ya... Yolda başına bir şey geldiyse?"


translate turkish bunny2_cont1_accdaae3:



    voice "voice/Alisa/Alisa2day/74 Chto-to scary.ogg"
    Fox "Hem de korkunç bir şey."


translate turkish bunny2_cont1_8022bc34:


    "Orman canlanıp tilkinin sözlerine kulak verdi. Tilki, meraklı bir hayvan gibi kulaklarını dikip üzerimi kokladı..."


translate turkish bunny2_cont1_77229bac:


    "Ve gözlerini yine bana dikti."


translate turkish bunny2_cont1_b7a01965:



    voice "voice/anton/2day/024. Dikie zveri.ogg"
    Ant "Vahşi hayvanlar gibi mi?"


translate turkish bunny2_cont1_e9a64b80:



    voice "voice/Alisa/Alisa2day/75 Eto po tvoemu.ogg"
    Fox "Senin korkunç anlayışın bu mu?"


translate turkish bunny2_cont1_7897c010:



    voice "voice/anton/2day/025. Nu ne znay.ogg"
    Ant "Yani... Ne bileyim."


translate turkish bunny2_cont1_cdc8032c:



    voice "voice/Alisa/Alisa2day/76 Ne znaet.ogg"
    Fox "Ne bileceksin ki?"


translate turkish bunny2_cont1_8efd2f80:



    voice "voice/Alisa/Alisa2day/77 Uz ne s.ogg"
    Fox "Ah canım, bir mankafayla mı arkadaş oldum yoksa?"


translate turkish bunny2_cont1_6a5a76a4:


    "Bana mankafa demesi gücüme gitse de onunla arkadaş olmak kulağa hoş geliyordu."


translate turkish bunny2_cont1_126a9829:



    voice "voice/anton/2day/026. Ya horoshist.ogg"
    Ant "Benim notlarım pekiyi bir kere!"


translate turkish bunny2_cont1_97eaae3d:



    voice "voice/Alisa/Alisa2day/78 Bel da pus.ogg"
    Fox "Öyle mi?"


translate turkish bunny2_cont1_d9ca8a00:



    voice "voice/Alisa/Alisa2day/79 Poidesh so mnoi.ogg"
    Fox "Benimle gelir misin, hepsi pekiyi Anton?"


translate turkish bunny2_cont1_edd08b87:



    voice "voice/Alisa/Alisa2day/80 Naidesh svoego.ogg"
    Fox "Senin şu Vova'yı buluruz, ona ormanın kuytularında nelere rastladığını sorarsın."


translate turkish bunny2_cont1_27c6ded4:



    voice "voice/Alisa/Alisa2day/81 Ved poka mi vmeste.ogg"
    Fox "Benimle olduğun sürece ormandaki hiç kimse sana zarar veremez."


translate turkish bunny2_cont1_52e73d60:



    voice "voice/Alisa/Alisa2day/82 Vot uvidish.ogg"
    Fox "Görürsün."


translate turkish bunny2_cont1_93cfe323:


    "Midemde endişeli kelebekler uçuşmaya başladı."


translate turkish bunny2_cont1_056a93c5:


    "İçimden bir ses \"Kaçsan iyi olur.\" dedi."


translate turkish bunny2_cont1_ab629183:



    voice "voice/anton/2day/027. Ya tebe ne veryu.ogg"
    Ant "Sana inanmıyorum."


translate turkish bunny2_cont1_d38dea26:



    voice "voice/Alisa/Alisa2day/83 Ti dumaesh.ogg"
    Fox "Bana yalancı mı diyorsun?"


translate turkish bunny2_cont1_f868cbf8:



    voice "voice/Alisa/Alisa2day/84 Da i poz.ogg"
    Fox "Aman, senin de diğerlerinden farkın yok!"


translate turkish bunny2_cont1_22ad9e93:


    "Kızın sesi acıklıydı ancak içtenliği tartışılırdı."


translate turkish bunny2_cont1_e2dafc70:


    "Bana olan tüm ilgisini yitirmiş gibi arkasını döndü."


translate turkish bunny2_cont1_03df2dbb:


    "Ağzımdaki sakız da o an acılaştı."


translate turkish bunny2_cont1_bf099adb:


    "Babamın bana hep söylediği \"Yiğidin sermayesi edeptir.\" lafını hatırladım."


translate turkish bunny2_cont1_6ca3efd7:


    "Tilki bana karşı nazikti elbet."


translate turkish bunny2_cont1_b148834c:



    voice "voice/anton/2day/28 Ne obiz.ogg"
    Ant "Lütfen darılma."


translate turkish bunny2_cont1_d28911a6:



    voice "voice/anton/2day/28.2 Lisi bivaut.ogg"
    Ant "İyi tilkiler de vardır elbet..."


translate turkish bunny2_cont1_d7d086da:



    voice "voice/anton/2day/29 Nu kak v skazkah.ogg"
    Ant "Masallardaki gibi mesela."


translate turkish bunny2_cont1_da812178:



    voice "voice/anton/2day/29.2 Mne bi tolko.ogg"
    Ant "Önce seni biraz tanımam lazım, hepsi bu."


translate turkish bunny2_cont1_f4ca043d:


    "Kız, elleriyle maskesinin burnunu örterek kikirdedi."


translate turkish bunny2_cont1_7441e1a8:



    voice "voice/Alisa/Alisa2day/95 Togda.ogg"
    Fox "Benimle ormana gelirsen tanıma şansın olur."


translate turkish bunny2_cont1_6ab1d9bb:



    voice "voice/Alisa/Alisa2day/96 No ne.ogg"
    Fox "Şimdi değil tabii, şafak söktükten sonra. Baksana, tir tir titriyorsun, kıyamam."


translate turkish bunny2_cont1_7e6db105:



    voice "voice/Alisa/Alisa2day/97 Togo i glyadi.ogg"
    Fox "Soğuktan beynin donacak."


translate turkish bunny2_cont1_aaa84190:



    voice "voice/Alisa/Alisa2day/98 Aida.ogg"
    Fox "Hadi, gel de seni okula geçireyim."


translate turkish bunny2_cont1_c585db5b:


    "Bunu duyan köpek, eldivenle uğraşmayı bırakıp onaylarcasına havladı."


translate turkish bunny2_cont1_2eb44ccb:


    "Benden kaçmaya kalkan eldivenin tekine eğilip uzandım."


translate turkish bunny2_cont1_587ccbe2:



    voice "voice/anton/2day/030. Nu esli tebe po puti.ogg"
    Ant "Peki, aynı yöne gidiyorsak..."


translate turkish bunny2_cont1_224c192e:


    "Okula, sökmek bilmeyen şafağa doğru yola koyulduk."


translate turkish bunny2_cont1_885a5fee:


    "Önünden geçtiğimiz evlerin pencerelerinden yansıyan ışıklar, yolun iki yanından -köy sakinleri bizi uyarıyormuşçasına- yüzümüze vuruyordu."


translate turkish bunny2_cont1_81166c76:


    "Perdelerin ardında gölgeler saklanıyor, arada bir köpekler havlıyor..."


translate turkish bunny2_cont1_463e6304:


    "Bacalarda sarmal dumanlar tütüyor, mutfaklardan televizyon mırıltıları ve bulaşık tıkırtıları geliyordu."


translate turkish bunny2_cont1_99f44390:


    "Kardaki lastik izlerini adım adım takip ediyor, köyün kış uykusundan miskince uyanışına tanık oluyorduk."


translate turkish bunny2_cont1_d66efb50:


    "Ben soldaki, kız sağdaki lastik izinde yürüyor; köpek de hemen peşimizden geliyordu."


translate turkish bunny2_cont1_e8d220a1:


    "Tilkinin yine saçma bir şeyler yumurtlamasını bekliyordum fakat okul yolu boyunca içinden \"Bir, iki, üç, tıp!\" demişçesine ağzını bile açmamıştı."


translate turkish bunny2_cont1_a0132a05:


    "Ancak köpek, burnuna düşen kar taneleri yüzünden hapşırdığı zaman arada bir kikirdiyordu."


translate turkish bunny2_cont1_b39fd445:


    "Nihayetinde sessizliği bozdum."


translate turkish bunny2_cont1_d6914285:



    voice "voice/anton/2day/031. Tak kak tebya.ogg"
    Ant "İsmin neydi acaba?"


translate turkish bunny2_cont1_002a4078:



    voice "voice/Alisa/Alisa2day/100 Nu konechno.ogg"
    Fox "Yine başladık."


translate turkish bunny2_cont1_558f1adf:



    voice "voice/Alisa/Alisa2day/101 Imena.ogg"
    Fox "İsim, isim, isim!"


translate turkish bunny2_cont1_76672992:



    voice "voice/Alisa/Alisa2day/102 Ludyam.ogg"
    Fox "Siz insanlar niye her şeye isim koymaya bu kadar meraklısınız?"


translate turkish bunny2_cont1_0edf40a5:



    voice "voice/Alisa/Alisa2day/103 Nu i kak bi.ogg"
    Fox "Sen olsan benim gibi bir tilkiye ne isim verirdin?"


translate turkish bunny2_cont1_fc1b8378:



    voice "voice/anton/2day/32 Daze ne znay.ogg"
    Ant "Bilmem ki..."


translate turkish bunny2_cont1_8fbf60bf:



    voice "voice/anton/2day/32.2 No ya chital.ogg"
    Ant "Aslında okuduğum bi masalda tilki Alisa vardı."


translate turkish bunny2_cont1_99ecacc5:



    voice "voice/Alisa/Alisa2day/104 A chto.ogg"
    Fox "Bence..."


translate turkish bunny2_cont1_11ccd93d:



    voice "voice/Alisa/Alisa2day/105 Ya ne.ogg"
    Fox "Hiç fark etmez."


translate turkish bunny2_cont1_3d8cadc5:



    voice "voice/Alisa/Alisa2day/106 Pust budet.ogg"
    Alis "Alisa olalım bakalım."


translate turkish bunny2_cont1_614e6e75:


    "Şaka mı yapıyordu, ciddi miydi, anlayamamıştım."


translate turkish bunny2_cont1_f4f43e97:


    "Güneşten mahrum kalan karanlık gökyüzünden veya köpekten bir yanıt bekler gibi arkamı döndüm."


translate turkish bunny2_cont1_a2237f2c:


    "Sessiz sorum yanıtsız kalmıştı."


translate turkish bunny2_cont1_2e961d03:


    "Okul ufukta belirmişti."


translate turkish bunny2_cont1_95aaf467:


    "Sonsuz geceye hapsolmuş, tuğladan devasa bir kutu."


translate turkish bunny2_cont1_fccf13fc:


    "Pencerelerindeki ışıklar hayra alamet görünmüyordu."


translate turkish bunny2_cont1_222666fd:


    "Bahçedeki ağaçlar okulun bekçiliğini yapıyordu."


translate turkish bunny2_cont1_181a77db:


    "Haykırışlar, çocukça kahkahalar ve ıslık sesleri, sessizliği bölüyordu."


translate turkish bunny2_cont1_ef50a5ef:


    "Yeni taşındığımızda buraya annemle gelmiştim. Cila kokan boş koridorları ve bahçesindeki pofuduk karlar ile burası epey samimi görünmüştü."


translate turkish bunny2_cont1_7c51940e:


    "Buraya ikinci gelişim kitaplarımı almak için oldu. O gün korkuluklardan kayan yaşıtlarımı, kütüphaneye koşuşturan küçüklerimi ve topuklarını kibirle vurarak koridorlarda yürüyen öğretmenlerimi hayal edip durmuştum."


translate turkish bunny2_cont1_ee5e82d3:


    "Liseliler, eşofmanları ve kafalarındaki yün bereleriyle girişte sigara içiyordu."


translate turkish bunny2_cont1_7536f11f:


    "Görünüşleri, okulun samimiyetine dair içimdeki son umut kırıntılarını silip süpürmüştü."


translate turkish bunny2_cont1_0f5bd0ee:


    "İğneleyici bakışları ve nikotinden sararmış dişleriyle pis pis sırıtışları, bulutlu bir kış sabahı kadar kasvetliydi."


translate turkish bunny2_cont1_95048b38:


    "Düşüncelere dalıp gitmiş, bir anlığına yol arkadaşımı unutmuştum."


translate turkish bunny2_cont1_a89bf231:



    voice "voice/Alisa/Alisa2day/107 Posle.ogg"
    Alis "Okuldan sonra seni arka bahçede bekliyor olacağım..."


translate turkish bunny2_cont1_b5ef17ac:



    voice "voice/Alisa/Alisa2day/108 Vozle.ogg"
    Alis "Adam astıkları yerde."


translate turkish bunny2_cont1_d568a13d:



    voice "voice/anton/2day/033. Vozle kogo.ogg"
    Ant "Nerede dedin?"


translate turkish bunny2_cont1_93a786a5:


    "Sorumu öylece duymazdan geldi."


translate turkish bunny2_cont1_e7f8449d:



    voice "voice/Alisa/Alisa2day/109 Ne opazd.ogg"
    Alis "Geç kalma."


translate turkish bunny2_cont1_e6ba0b58:


    "Arada kalmıştım."


translate turkish bunny2_cont1_5c2a4301:


    "İki seçenek arasında kaldığımda annem hep \"Karar ver, ya öyle ya böyle.\" derdi."


translate turkish bunny2_cont1_81776c54:


    "Annemin bu lafını düşünerek yanıt verdim:"


translate turkish bunny2_cont1_8b1569eb:



    voice "voice/anton/2day/034. Ya posle shkoli.ogg"
    Ant "Okuldan sonra doğru eve dönmem lazım."


translate turkish bunny2_cont1_33d65fc8:



    voice "voice/Alisa/Alisa2day/110 Eh.ogg"
    Alis "Ah, peki Antoşa. Teklif var, ısrar yok."


translate turkish bunny2_cont1_b05ba69a:



    voice "voice/Alisa/Alisa2day/111 Drugie ze.ogg"
    Alis "Ancak bil ki diğerleri, yüzüne gülüp yakana yapışmak için fırsat kollayacak. Onlardan kolay kolay kurtulamazsın."


translate turkish bunny2_cont1_9a81bfca:



    voice "voice/Alisa/Alisa2day/112 Popomni.ogg"
    Alis "Bu lafımı unutma."


translate turkish bunny2_cont1_dad2209d:


    "Tilki, ağzı yırtılacakmışçasına esnedi."


translate turkish bunny2_cont1_2756e5f7:


    "Bu nasıl bir hareket?"


translate turkish bunny2_cont1_ee0b4763:


    "Ötede koşuşturan biri adımı haykırdı."


translate turkish bunny2_cont1_f06d8671:


    "Düşünmeden arkamı döndüm."


translate turkish bunny2_cont1_2bf8a4a8:


    "Koca bir kartopu, omzumu sıyırıp köpeğe isabet etti."


translate turkish bunny2_cont1_77c6cfb1:


    "Vurulunca inildeyerek pınara doğru kaçıverdi."


translate turkish bunny2_cont1_111157cd:


    "Karanlık, köpeği ağır ağır yuttu."


translate turkish bunny2_cont1_1b7dabba:


    "Tilki kız da ortadan kaybolmuştu. Buhar olup dondurucu havaya karışmıştı."


translate turkish bunny2_cont1_9abeaa76:


    "Yoksa gölgeme mi saklanmıştı?"


translate turkish bunny2_cont1_71e470a7:


    "Yutkundum..."


translate turkish bunny2_cont1_26093803:


    "Ve sakızımı yuttum."


translate turkish bunny2_cont1_82a498ad:


    "Ne şanssızım."


translate turkish bunny2_cont1_5d487545:


    "Derin bir nefes aldıktan sonra köfte kokularının ve kara düşen ışıkların geldiği yere, yani okulun girişine vardım."


translate turkish bunny_school_night_gopniks_8e4ee35a:


    "Üst sınıflardan bir grup."


translate turkish bunny_school_night_gopniks_c88b3af6:


    "Üst sınıflardan berelerini eğik takmış, çene çalan bir grup. Gözlerine batmasam iyi olur."


translate turkish bunny_school_night_dog_bf4c135f:


    "Siyah bir Volga."


translate turkish bunny_school_night_dog_f048a38e:


    "Okul bahçesinin önüne gıcır gıcır bir Volga park etmiş, ön lastiklerinden biri buzlu kaldırıma çıkmıştı."


translate turkish bunny_school_night_dog_6139d581:


    "İs lekesi gibi simsiyahtı ve fırtınada tavan arasına saklandığımızda babamın anlattığı korku hikayelerinden fırlamış gibi kasvetliydi."


translate turkish bunny_school_night_dog_5d70a0d4:


    "Çocuk kaçıran o siyah arabadan bahsederken yüzüne hüzünlü bir tebessüm kondururdu hep..."


translate turkish bunny_school_night_dog_d6e9e5ae:


    "Ve şunu derdi:"


translate turkish bunny_school_night_dog_45ef1328:


    "\"İçerisine, beyaz perdelerine falan bakınca cenaze aracına benziyor...\""


translate turkish bunny_school_night_dog_90e42ab2:


    "\"Plakasında ise 'SÇÖ' yazıyor. Ne demek, biliyor musun? Sovyet çocukları ölecek.\""


translate turkish bunny_school_night_dog_d408c533:


    "Gülünç, ben de Sovyetlerde doğmuştum."


translate turkish bunny_school_night_witness_6c52b6a5:


    "Uzun boylu bir adam bahçe kapısının ardında dikiliyor, iki parmağının arasından çektiği dumanı rüzgara üflüyordu."


translate turkish bunny_school_night_witness_f8cdae21:


    "Öğretmene benzer bir hâli yoktu ama..."


translate turkish bunny_school_night_witness_8a1b1ebc:


    "Belki de bedenciydi."


translate turkish bunny_school_night_witness_02ac147c:


    "Sigarasını kıstırdığı yarık üst dudağıyla oyma granit gibi yüzünü dikkatle inceledim."


translate turkish bunny_school_night_witness_49d3ffd1:


    "Araba anahtarlarını tespih gibi sallıyor, bakışlarıma aynen karşılık veriyordu."


translate turkish bunny_school_night_witness_bcfeb3d4:


    "Aldığı her nefesle yanıp sönen sigarası, sıcacık yuvalarındaki gözlerinin parlamasına sebep oluyordu."


translate turkish bunny_school_night_witness_8ca60f6e:


    "Başımı eğdim."


translate turkish bunny_school_night_witness_32a666ca:


    "İzbandut herif miskin bakışlarını yavaşça benden ayırıp yola doğru yürümeye başladı."


translate turkish bunny_school_night_nest_e0a5e08d:


    "Kuzgun yuvası."


translate turkish bunny_school_night_nest_aea897a3:


    "Acaba ne yuvası bu?"


translate turkish bunny_school_night_nest_63acb064:


    "Hırsız saksağan mı?"


translate turkish bunny_school_night_nest_733c3ea6:


    "Öyleyse çeşit çeşit parlak eşya vardır."


translate turkish bunny_school_night_nest_30dc6a7e:


    "Renkli cam kırıkları, şişe kapakları, madeni paralar... Belki de çocukların diş telleri."


translate turkish total_test_8f7d9d7f:


    "Kapıların ardından boğuk sesler geliyor, ışıklar yanıp sönüyordu."


translate turkish total_test_8c57e863:


    "Karanlık, pencereleri sarmış; okulum sanki başıboş bir uzay gemisi gibi bilinmezliğe sürükleniyordu."


translate turkish total_test_977fcae1:


    "İkinci kata çıktığımda duyuru panosunun önündeki öğrenci izdihamını fark ettim."


translate turkish total_test_2204d5cc:


    "Aralarında hararetli bir fikir alışverişi dönüyordu."


translate turkish total_test_3fece921:


    "Herkesin ilgisini çeken o şeye göz atmak için sırt çantalarından oluşan kalabalığı yararak panoya yaklaştım."


translate turkish total_test_8df279be:


    "Panonun soluna bir çıktı asılmıştı."


translate turkish total_test_d52d886a:


    "\"Dikkat! Kayıp aranıyor!\""


translate turkish total_test_573c005f:


    "İsmi Vova Matyuhin..."


translate turkish total_test_3545f9f1:


    "Dördüncü sınıfmış."


translate turkish total_test_d5fd301f:


    "Çıktının kumlu görüntüsü yüzünden Vova, solgun dudakları ve boş bakışlarıyla ölüden pek farksızdı."


translate turkish total_test_9c6325ec:


    "Acaba ormanın kuytularında kol gezen karanlık, gözeneklerine doluşup yüzüne zarar vermiş olabilir miydi?"


translate turkish total_test_0b9abaf8:


    "Fısıldayan dallardan ve uğuldayan rüzgardan, oyuncak bir silahla korunamazdı."


translate turkish total_test_6d583564:


    "Kayıp çocuğun karanlık bakışları ruhuma yalvarırcasına nüfuz etti."


translate turkish total_test_51c4fbba:


    "Gözlerimi gözlerinden kaçırıp kendimi pencere kenarına attım ve duvara yaslandım."


translate turkish total_test_2f7c69df:


    "Birkaç kişilik gruplar koridoru yavaşça dolduruyordu."


translate turkish total_test_335938d4:


    "Kimse bana aldırış etmiyordu."


translate turkish total_test_fdeca0db:


    "Birkaç çocuk, okul tuvaletinin karanlığında bir tekerleme söylüyordu:"


translate turkish total_test_87b63541:



    voice "voice/Child/2day/Child_01.ogg"
    Childs "Ayıya ve tilkiye, \nTavşancık getirsin yemek!"


translate turkish total_test_a53b4ad7:


    "Çocukları daha net seçebilmek için kafamı o yöne çevirdiğimde dikkatim, koridorda yankılanan topuk seslerine kaydı."


translate turkish total_test_978b3ec6:


    "Kadın bir öğretmen, koridor boyunca başı dik bir şekilde ilerliyordu."


translate turkish total_test_41c76830:


    "Topuklarını minyatür bir çift toynak gibi tak tak vuruyordu."


translate turkish total_test_1cc27419:


    "Öğretmenin peşinde her adımını izleyen bir kız vardı."


translate turkish total_test_da48a8e9:


    "O da kendisini beğenmiş bir edayla arada bir durup arkadaşlarının kulağına dedikodu kusuyordu."


translate turkish total_test_05d12286:


    "Elindeki yoklama defterine bakılırsa sınıf temsilcisi olmalıydı."


translate turkish total_test_eb0257f7:



    voice "voice/lydia/2day/01 Ekaterina.ogg"
    Teacher "Ekaterina, şunu alır mısın?"


translate turkish total_test_daa3b393:


    "Öğretmen sınıfın kapısını açtığı gibi çocuklar akın akın, bağıra çağıra ve itişe kakışa içeriye doluştu."


translate turkish total_test_0177291a:


    "Aralarından kızıl saçlı, uzun boylu ve şişmancana bir çocuk dikkatimi çekti. Sivilcelerle dolu yüzü, basbayağı nar tanelerini anımsatıyordu."


translate turkish total_test_c928b946:


    "Onu görünce içimde kötü bir his uyanıverdi."


translate turkish total_test_2131fce7:


    "Tedirgin bakışları ve hunharca gülüşüyle onun gibilerini daha önce de görmüştüm."


translate turkish total_test_ecdbdb66:


    "Öğretmenin minyatür kopyası olan kız, çevik bir el hareketiyle oğlanı uyarıp kalabalığın arasından sınıfa girdi."


translate turkish total_test_2fd6fefc:


    "Kızıl saçlı oğlan, yolunu kapatan bir çocuğu itip haykırdı:"


translate turkish total_test_425cf901:



    voice "voice/semen/2day/01 Topa.ogg"
    Noname "Yürüsene lan, dingil!"


translate turkish total_test_5a53ca0f:


    "Az kalsın kafası üstü uçan zavallı, kollarını çırparak dengesini korumaya çalıştı."


translate turkish total_test_2e7a2e4a:


    "Dombilinin kahkahayı patlatmasıyla birkaç yüzsüz çocuk da hunharca ona katıldı."


translate turkish total_test_3a469f16:


    "Gülüşleri, büyük bir bahçe makasını anımsatıyordu."


translate turkish total_test_69c189cf:


    "Sınıfın tüm çocukları yutmasıyla koridor bomboş kaldı."


translate turkish total_test_00da5ea2:


    "Keşke kök salsam da pencereden ayrılmasam, dedim içimden."


translate turkish total_test_6ed3f277:


    "Dışarıda bir avuç sokak lambası karanlıkla mücadele veriyor, zifiri okyanuslardaki fener balıkları gibi kıvranıyordu."


translate turkish total_test_a04ece92:


    "Kaçmak için hâlâ vaktim var."


translate turkish total_test_04a90d9d:


    "Dışarı çıkıp karanlığa karışsam..."


translate turkish total_test_d532a38f:


    "Ayağımda botlarımla karları yararak, gıcırdatıp çiğneyerek koşsam, attığım her adımla daha da hafiflesem..."


translate turkish total_test_cabbccc0:


    "Zilin çalmasıyla gerçek dünyaya döndüm."


translate turkish total_test_595543b6:


    "Pencere kenarından büyük güçlükle ayrıldım."


translate turkish total_test_99b5895f:


    "Deli gibi atan kalbimi yatıştırmak için birkaç derin nefes alıp sınıfa girdim."


translate turkish bunny2_school_classroom1_20abb2c8:


    "Katılığı ve siniri yüzünden açıkça okunan öğretmen, gözlüğünün üzerinden bana baktı."


translate turkish bunny2_school_classroom1_21f5e34e:



    voice "voice/anton/2day/37 Ya novenkiy.ogg"
    Ant "Ben... Buraya yeni nakloldum."


translate turkish bunny2_school_classroom1_4d094841:



    voice "voice/anton/2day/37.2 Mne vot skazali.ogg"
    Ant "Bu sınıfa gelmemi söylediler."


translate turkish bunny2_school_classroom1_6a422ec3:


    "Karlı orman yolu gözümün önüne gelip duruyordu. Çamların hışırtısı artık kulağıma eskisi gibi tehditkar gelmiyordu."


translate turkish bunny2_school_classroom1_f3fe97e5:



    voice "voice/lydia/2day/02 Hm.ogg"
    Teacher "Hım..."


translate turkish bunny2_school_classroom1_905c25bb:


    "Sınıf defterine gömülüp sayfaları karıştırdı."


translate turkish bunny2_school_classroom1_1be496a8:



    voice "voice/lydia/2day/03 A fam.ogg"
    Teacher "Soyadın?"


translate turkish bunny2_school_classroom1_44e02a14:



    voice "voice/anton/2day/038. P-petrov.ogg"
    Ant "P-p-petrov."


translate turkish bunny2_school_classroom1_4588e27b:



    voice "voice/lydia/2day/04 Gromche.ogg"
    Teacher "Evladım, ne mırıldanıyorsun?"


translate turkish bunny2_school_classroom1_d4e69f0a:



    voice "voice/lydia/2day/05 Chego.ogg"
    Teacher "Sesli konuşsana!"


translate turkish bunny2_school_classroom1_3e8850d8:



    voice "voice/anton/2day/039. Petrov.ogg"
    Ant "Petrov!"


translate turkish bunny2_school_classroom1_d5a4e171:



    voice "voice/lydia/2day/06 Net.ogg"
    Teacher "Hım... Listede yoksun."


translate turkish bunny2_school_classroom1_ca38f934:


    "Yalanım varsa diye uzun ve pürdikkat bakışlarıyla beni bir tarttı."


translate turkish bunny2_school_classroom1_5b0c65f4:


    "Yer yarılsa da içine girsem, dedim içimden."


translate turkish bunny2_school_classroom1_98d2c2e2:


    "Solumda ne kadar puslu bakış varsa üzerime dikilmişti. Sınıftakiler tek yürek olmuş, yırtıcı bir hayvan gibi hep bir ağızdan soluyup horulduyordu."


translate turkish bunny2_school_classroom1_588a34e4:



    voice "voice/lydia/2day/08 Ty ne.ogg"
    Teacher "Emin misin?"


translate turkish bunny2_school_classroom1_c9172a76:



    voice "voice/lydia/2day/09 Net takogo.ogg"
    Teacher "Burada adın yazılı değil."


translate turkish bunny2_school_classroom1_4f03fad1:


    "Dizlerim tam da titreyecek zamanı bulmuştu. Başım da dönmeye başladı."


translate turkish bunny2_school_classroom1_46af784e:


    "Yumruklarımı öyle bir sıktım ki parmağımdaki boğumlar ağardı."


translate turkish bunny2_school_classroom1_86aac762:



    voice "voice/anton/2day/040. Mne skazali 204.ogg"
    Ant "204'e git, 6-C sınıf öğretmeni Liliya Pavlovna'ya ulaş, demişlerdi bana."


translate turkish bunny2_school_classroom1_0f4d8e16:


    "Söylediklerim sınıfın kulağına şaka gibi gelmiş olmalıydı ki herkes gülmeye başladı."


translate turkish bunny2_school_classroom1_01d96308:



    voice "voice/lydia/2day/10 Chto za.ogg"
    Teacher "Derdiniz ne sizin?"


translate turkish bunny2_school_classroom1_3a621d46:


    "Sınıf suspus kesildi."


translate turkish bunny2_school_classroom1_b5125474:


    "Çocuklar, pis gülüşlerini daha iyi bir zamana sakladılar."


translate turkish bunny2_school_classroom1_a94dc9b7:



    voice "voice/lydia/2day/11 Ponaberut.ogg"
    Teacher "Boşuna stajyer alıyoruz sanki."


translate turkish bunny2_school_classroom1_a85f7b92:



    voice "voice/lydia/2day/12 Tolko.ogg"
    Teacher "Balon gibi dudaklarına ruj sürmeyi biliyorlar ama bir sıkıntı çıkınca benden başka kimse elini taşın altına koymuyor!"


translate turkish bunny2_school_classroom1_4cdcfaa4:



    voice "voice/lydia/2day/13 A bumagi.ogg"
    Teacher "Ne bir evrak ne bir şey olmadan niye gönderdilerse seni de... Öf, ilk kez olsa hadi neyse."


translate turkish bunny2_school_classroom1_37512f7b:



    voice "voice/lydia/2day/14 Podozdi.ogg"
    Teacher "Burada bekle, geleceğim."


translate turkish bunny2_school_classroom1_b5e1fae1:



    voice "voice/lydia/2day/15 Seychas.ogg"
    Teacher "Gidip idareyle konuşayım hele."


translate turkish bunny2_school_classroom1_1d596fb0:


    "Öğretmen haklı öfkesiyle mırıldanarak yanımdan fırladığında sınıfın ortasında kalakalmıştım."


translate turkish bunny2_school_classroom1_f7312241:


    "Sınıftakilerin üzerime yönelttiği alaycı bakışları hissetmemle bakışlarımı halkın önünde infaz edilecek bir mahkum gibi indirdim."


translate turkish bunny2_school_classroom1_e61b070d:


    "Gözleri tenimde kırmızı lazerler gibi geziyor, bu da bana batıyordu."


translate turkish bunny2_school_classroom1_1793a86b:


    "Bir kez daha kaçıp gitmeyi, rüzgarın pençelerine göğüs germeyi ve bir sıçrayışta çamları aşmayı düşledim..."


translate turkish bunny2_school_classroom1_8fb0145a:


    "Tek dostum arkamdan esen rüzgar olurdu."


translate turkish bunny2_school_classroom1_3e90f530:


    "Yeni sınıf arkadaşlarım \"Bu yeni çocuk bizden mi yabancı mı?\" dercesine bakıyordu."


translate turkish bunny2_school_classroom1_cfe63c7b:


    "Yükselen bir fısıltı sonucunda sınıfta susmak bilmeyen bir kahkaha koptu."


translate turkish bunny2_school_classroom1_48830d25:



    voice "voice/semen/2day/03 Dosk.ogg"
    Noname "Tahtayı sil!"


translate turkish bunny2_school_classroom1_2fc8a06e:


    "Sınıfın şaklabanının kim olduğunu tahmin etmek hiç de zor olmadı."


translate turkish bunny2_school_classroom1_48ace0d8:



    voice "voice/semen/2day/04 Ei.ogg"
    Noname "Sana diyorum optik!"


translate turkish bunny2_school_classroom1_d5ccdfb5:



    voice "voice/semen/2day/05 Ty cz.ogg"
    Noname "Ulan, zaten körsün, kulağın da mı duymuyor?"


translate turkish bunny2_school_classroom1_8c8df63b:



    voice "voice/semen/2day/06 Dosk.ogg"
    Noname "Silsene oğlum tahtayı!"


translate turkish bunny2_school_classroom1_738b68c7:


    "Vücudumun titreyen tek yeri dizlerim değildi artık."


translate turkish bunny2_school_classroom1_9e7bf20d:


    "Tepeden tırnağa zangırdarken öğretmenin bir an önce gelmesi için dua ettim."


translate turkish bunny2_school_classroom1_b17ebba1:


    "Duam kabul olmuş olmalı ki..."


translate turkish bunny2_school_classroom1_c431201d:



    voice "voice/lydia/2day/17 Nu chto.ogg"
    Teacher "Ne yapsak şimdi seni?"


translate turkish bunny2_school_classroom1_1b081236:



    voice "voice/lydia/2day/18 Kuda saj.ogg"
    Teacher "Nereye oturtsak?"


translate turkish bunny2_school_classroom1_958539b7:



    voice "voice/lydia/2day/19 Davai-ka.ogg"
    Teacher "Bak, Semyon'un yanı boşmuş."


translate turkish bunny2_school_classroom1_fdd0734e:



    voice "voice/lydia/2day/20 On vse.ogg"
    Teacher "Buyur, geç."


translate turkish bunny2_school_classroom1_08f24a18:



    voice "voice/semen/2day/07 Escze.ogg"
    Sem "Oldu canım!"


translate turkish bunny2_school_classroom1_7828fab5:


    "Dombili, çantasını sıraya koyarak itirazını sundu ve göbeğini kaşıyıp pis pis güldü."


translate turkish bunny2_school_classroom1_d1577ab3:



    voice "voice/lydia/2day/21 Ti opyat.ogg"
    Teacher "Yine başlama istersen!"


translate turkish bunny2_school_classroom1_0114a185:



    voice "voice/lydia/2day/22 Snova.ogg"
    Teacher "İlla neneni mi aramamı istiyorsun?"


translate turkish bunny2_school_classroom1_27854818:


    "Sınıf sustu."


translate turkish bunny2_school_classroom1_13f34d07:



    voice "voice/semen/2day/09 A cze.ogg"
    Sem "Ara da selamımı söyle!"


translate turkish bunny2_school_classroom1_7900e344:



    voice "voice/lydia/2day/23 Ne ona.ogg"
    Teacher "Nenen seni affeder ama ben affetmem."


translate turkish bunny2_school_classroom1_459724b8:



    voice "voice/lydia/2day/24 Bag.ogg"
    Teacher "Kaldır o çantayı!"


translate turkish bunny2_school_classroom1_935dd0b2:


    "Semyon kılını bile kıpırdatmadı."


translate turkish bunny2_school_classroom1_ebf7a471:


    "Aldırış etmeden duvardaki yazarların portrelerini incelemeye başladı."


translate turkish bunny2_school_classroom1_166f9191:


    "Bu meseleyi çözmek, kendimi sağlama almak için bir şey yapmam gerekiyordu."


translate turkish bunny2_school_classroom1_7e70797b:



    voice "voice/anton/2day/41 Ya.ogg"
    Ant "İsterseniz..."


translate turkish bunny2_school_classroom1_2840248c:


    "Boğazımı temizleyip benimle alakası bile olmayan boğuk bir ses tonuyla cümlemi tamamladım:"


translate turkish bunny2_school_classroom1_a6a43aca:



    voice "voice/anton/2day/42.2 Ya mogu za posl.ogg"
    Ant "En arka sıraya geçebilirim."


translate turkish bunny2_school_classroom1_4c50fa35:



    voice "voice/anton/2day/42.3 Tam kazetsa.ogg"
    Ant "Sanırım orası boş."


translate turkish bunny2_school_classroom1_1849e564:


    "Öğretmen homurdandı."


translate turkish bunny2_school_classroom1_339e9ac4:


    "Önce bana, sonra Semyon'a, sonra tekrar bana baktı."


translate turkish bunny2_school_classroom1_4d0a40b5:



    voice "voice/lydia/2day/26 Ladno.ogg"
    Teacher "Peki, şimdilik geç."


translate turkish bunny2_school_classroom1_d9623b27:



    voice "voice/lydia/2day/27 A s toboy.ogg"
    Teacher "Sana gelince Baburin..."


translate turkish bunny2_school_classroom1_5f5953f2:



    voice "voice/lydia/2day/28 Chtobi.ogg"
    Teacher "Seninle dersten sonra konuşacağız."


translate turkish bunny2_school_classroom1_7211a89f:



    voice "voice/lydia/2day/29 Budesh.ogg"
    Teacher "Çıkışta temizliğe kalacaksın. Duydun mu?"


translate turkish bunny2_school_classroom1_001c0804:


    "Semyon sapkınca sırıttı. Burnunun ucunda biten vıcık vıcık sivilceler, patlamaya can atarcasına şişti."


translate turkish bunny2_school_classroom1_eb86836b:


    "Takılıp düşersem tüm sınıfın hâlime güleceği korkusuyla temkinli adımlarla ilerledim."


translate turkish bunny2_school_classroom1_f732acfb:


    "En arkaya, eski poster yığınının yanındaki son sıraya geçtim."


translate turkish bunny2_school_classroom1_5268be80:


    "Dışlananlar da yerini aldığına göre..."


translate turkish bunny2_school_classroom1_b08ae83c:



    voice "voice/lydia/2day/30 Vot i.ogg"
    Teacher "Pekala, derse başlıyorum!"


translate turkish bunny2_school_classroom1_1d429e67:



    voice "voice/lydia/2day/31 Tema.ogg"
    Teacher "Bugünün konusu Zoşçenko'nun 'Yalan Söyleme' eserindeki Rus ve uluslararası edebiyat gelenekleri."


translate turkish bunny2_school_classroom1_47fc7fb6:


    "Dombili bana döndü. Günlerce, haftalarca hatta aylarca sürecek zorbalığın gelişi bakışlarından okunuyordu."


translate turkish bunny2_school_classroom1_9c7aa603:


    "Gevrek gevrek \"Gözüm üzerinde.\" diyordu sanki."


translate turkish bunny2_school_classroom1_45b3c192:


    "Henüz birkaç ders sonra defterimde koca bir balgam lekesi gördüm."


translate turkish bunny2_school_classroom1_c1bae452:


    "Sonra bu Semyon denen şerefsiz, yemekhanede \"yanlışlıkla\" üzerime {u}kompot{/u} döktü."


translate turkish bunny2_school_classroom1_dd950d97:


    "Dahası, tuvaletten çıkınca ellerini ıslak ıslak çırpıp üzerimi ıslattı."


translate turkish bunny2_school_classroom1_a89adfd3:


    "Bir de o günün son teneffüsünde beni bizim sınıftan kendi hâlinde takılan bir kız grubunun arasına itekledi."


translate turkish bunny2_school_classroom1_127ec896:


    "Bela okuyarak önümden çekilseler de dengemi kaybedip sınıf temsilcisi olduğunu düşündüğüm o kızın tam da göğsüne yüz üstü kapaklanıverdim."


translate turkish bunny2_school_classroom1_0cf0b377:



    voice "voice/kate/04 KA.ogg"
    Kate "Ay!"


translate turkish bunny2_school_classroom1_75713efb:


    "Utancımdan kahrolup hemen çekildim."


translate turkish bunny2_school_classroom1_93b8f62f:



    voice "voice/anton/2day/043. Prosti ti v.ogg"
    Ant "Özür dilerim, iyi misin?"


translate turkish bunny2_school_classroom1_4fa29942:


    Kate "Ben..."


translate turkish bunny2_school_classroom1_14237df4:


    "Birden ellerini ağzına götürdü."


translate turkish bunny2_school_classroom1_1aca1a47:



    voice "voice/kate/06 KA.ogg"
    Kate "Şu densize bakın ya!"


translate turkish bunny2_school_classroom1_28d02167:



    voice "voice/kate/07 KA.ogg"
    Kate "Herkesin önünde beni taciz etti!"


translate turkish bunny2_school_classroom1_f5ce3c05:



    voice "voice/kate/08 KA.ogg"
    Kate "Seni anneme söyleyeceğim!"


translate turkish bunny2_school_classroom1_e116d69b:



    voice "voice/kate/09 KA.ogg"
    Kate "Okuldan atılacaksın, pis sapık!"


translate turkish bunny2_school_classroom1_df57f5d7:


    "Karıncaları bantla toplayan küçük bir çocuk gibi sadistçe zevkten dört köşe olmuştu."


translate turkish bunny2_school_classroom1_ac4f308e:



    voice "voice/anton/2day/044. Ya nechayanno.ogg"
    Ant "İstemeden oldu! Beni itti..."


translate turkish bunny2_school_classroom1_c66340cd:



    voice "voice/kate/10 KA.ogg"
    Kate "Hepimiz ne olduğunu bal gibi gördük! Kör değiliz ya!"


translate turkish bunny2_school_classroom1_977b7ce1:


    "Gözlüğüme bakarak fesatça sırıttı."


translate turkish bunny2_school_classroom1_d8b383cf:


    "İçimde kızgın dumanlar tütse de Semyon'un gülüşü hepsini yel gibi alıp götürdü."


translate turkish bunny2_school_classroom1_eb624fc8:



    voice "voice/semen/2day/10 Tolk.ogg"
    Sem "Ben mi ittim? Harbi mi?"


translate turkish bunny2_school_classroom1_75e51d5b:


    "Kasıla kasıla dibime sokuldu -ay çekirdeği ve çürük diş kokusundan burnumun direği kırılmıştı- ve beni yere yığdı."


translate turkish bunny_day2_semen_a1e509c9:



    voice "voice/semen/2day/11 Vot.ogg"
    Sem "Böyle mi, he? Şimdi n'apıcan?"


translate turkish bunny_day2_semen_3f2cc123:


    "Zorba velet..."


translate turkish bunny_day2_semen_5fb007a3:


    "\"Hadi! Yiyorsa vur ulan!\" dercesine diklenerek üzerime yürüdü."


translate turkish bunny2_semen_fight_2cae11ee:



    voice "voice/anton/2day/048. Slushai ti.ogg"
    Ant "Bana bak..."


translate turkish bunny2_semen_fight_036aa548:


    "Boğazım kurumuş, dudaklarım kendi çalıp kendi oynuyordu; sesim kapı gıcırtısı gibi iç gıcıklayıcı..."


translate turkish bunny2_semen_fight_334c0df1:


    "Semyon'un yüzündeki gülüş ise alaycıydı."


translate turkish bunny2_semen_fight_8baaf7c0:



    voice "voice/semen/2day/12 Dava.ogg"
    Sem "Devam et optik."


translate turkish bunny2_semen_fight_20da7407:



    voice "voice/semen/2day/13 CZo p.ogg"
    Sem "Niye sustun?"


translate turkish bunny2_semen_fight_774aaf5e:



    voice "voice/semen/2day/14 Nam.ogg"
    Sem "Seni dinliyoruz."


translate turkish bunny2_semen_fight_4f95a321:



    voice "voice/anton/2day/049. Esle eshe hot raz.ogg"
    Ant "Bir daha bana dokunursan..."


translate turkish bunny2_semen_fight_650a4cdb:


    "Semyon yavaşça parmağını kaldırıp alnımı dürttü."


translate turkish bunny2_semen_fight_0df377f4:



    voice "voice/semen/2day/15 Nu t.ogg"
    Sem "Dokundum, ee?"


translate turkish bunny2_semen_fight_81aa11d2:



    voice "voice/anton/2day/50.1Eshohotraz.ogg"
    Ant "Bir daha dokunursan..."


translate turkish bunny2_semen_fight_9ed44231:



    voice "voice/semen/2day/16 Tron.ogg"
    Sem "Bir daha dokundum."


translate turkish bunny2_semen_fight_b4d52d12:



    voice "voice/semen/2day/17 A vo.ogg"
    Sem "Bir kere daha!"


translate turkish bunny2_semen_fight_534ec0ef:



    voice "voice/semen/2day/18 I escz.ogg"
    Sem "Bir daha!"


translate turkish bunny2_semen_fight_b21cff91:



    voice "voice/semen/2day/19 I escz.ogg"
    Sem "Bir daha!"


translate turkish bunny2_semen_fight_cd1fd502:



    voice "voice/semen/2day/20 I escz.ogg"
    Sem "Bir daha!"


translate turkish bunny2_semen_fight_37aaa9f7:


    "O kadar sert dürtüyordu ki kafam ileri geri savruluyordu."


translate turkish bunny2_semen_fight_e5108d03:


    "Gözyaşlarıma hakim olmalıyım."


translate turkish bunny2_semen_fight_738c095e:


    "Yoksa rezil olurum!"


translate turkish bunny2_semen_fight_1ed733dd:



    voice "voice/semen/2day/21 CZe t.ogg"
    Sem "Senin gibi bir pısırık bana ne yapabilir ki?"


translate turkish bunny2_semen_fight_1a27b109:


    "Sinirden gözüm dönmüştü."


translate turkish bunny2_semen_fight_737035c8:


    "Rüzgar gibi doğrulup fırladım..."


translate turkish bunny2_semen_fight_9069e541:


    "Ve gelişine yapıştırdım!"


translate turkish bunny2_semen_fight_c20ea4c3:


    "Gözümü açtığımda gördüğüm manzara dehşet verici olduğu kadar büyüleyiciydi."


translate turkish bunny2_semen_fight_6892a9c4:


    "Semyon kulağını tutup şaşkınlıkla bakakalmıştı."


translate turkish bunny2_semen_fight_348a606c:


    "Onun okuldaki sarsılmaz hükmüne baş kaldıran ilk kişi mi olmuştum?"


translate turkish bunny2_semen_fight_2a160f10:


    "Kaçmam gerekiyordu ancak Semyon'un kankaları çoktan başıma üşüşmüştü."


translate turkish bunny2_semen_fight_bc73e961:



    voice "voice/kate/11 KA.ogg"
    Kate "Öğretmenim!"


translate turkish bunny2_semen_fight_27681eb9:



    voice "voice/kate/12 KA.ogg"
    Kate "Liliya öğretmenim! Petrov, Baburin'e vurdu!"


translate turkish bunny2_semen_fight_1961be53:


    "Semyon'un yanakları iyice kızardı, sivilceleri de larvalar gibi sapsarı kesildi."


translate turkish bunny2_semen_fight_fc0d7c21:


    "Ancak sonrasında, orada bulunanlar arasından sadece benim fark ettiğim bir gülüş belirdi yüzünde."


translate turkish bunny2_semen_fight_e968ad13:


    "Dibime sokuldu ve çürük dişlerinin kokusu balçık gibi üzerime sıvandı."


translate turkish bunny2_semen_fight_191ea168:



    voice "voice/semen/2day/23 Tebe.ogg"
    Sem "Sen..."


translate turkish bunny2_semen_fight_9eb649ab:



    voice "voice/semen/2day/24 Pizd.ogg"
    Sem "Bittin."


translate turkish bunny2_semen_fight_856169be:


    "Sesi, cezvesinden taşmak üzere olan acı kahve gibi kızgın ve tehditkar geliyordu."


translate turkish bunny2_semen_fight_b48a278a:


    "Kalbimin küt küt atışını dinlerken nereyi hedef alabileceğini düşünerek..."


translate turkish bunny2_semen_fight_a624da6c:


    "Yiyeceğim yumruğu bekledim."


translate turkish bunny2_semen_fight_56050602:


    "Karın boşluğuma mı, çeneme mi yoksa burnuma mı?"


translate turkish bunny2_semen_fight_729b62ba:


    "Oysa arkasını dönüp olay yerinden uzaklaştı."


translate turkish bunny2_semen_fight_defd716c:


    "Zihnimde son derece haklılıkla soğukkanlı bir düşünce filizlendi:"


translate turkish bunny2_semen_fight_ffb84a00:


    "Bugün öldüğüm gündür."


translate turkish bunny2_meet_pol_9611ee70:


    "Dersler bittikten sonra çıkışta bilerek oyalandım."


translate turkish bunny2_meet_pol_2f4a059f:


    "Semyon son derste yoktu. Temizlik cezasından kaçıp, beni unutup eve dönmüş olabileceği düşüncesiyle umutlanmıştım."


translate turkish bunny2_meet_pol_bc34d2e6:


    "İnfazı yarına ertelenen bir idam mahkumu gibi derin bir oh çektim."


translate turkish bunny2_meet_pol_9ff06f1f:


    "Yine de ses tonu, intikamla yanıp tutuşan bakışları ve belaya davet uyandıran gülüşü aklıma kazınmıştı."


translate turkish bunny2_meet_pol_2acfe66b:


    "Bir nebze de olsa rahatlamıştım. Onunla bu boş koridorda karşı karşıya gelmek istemezdim."


translate turkish bunny2_meet_pol_ebdf6de6:


    "Sınıftakilerin at nalını anımsatan sırıtışları gözlerimin önünden gitmiyordu."


translate turkish bunny2_meet_pol_2d726005:


    "Herkese bir güzel alay malzemesi olmuştum. Görenler ve duyanlar, uğradığım zorbalığı duymayanlara en ince detayına kadar anlatıyordu."


translate turkish bunny2_meet_pol_3f59d217:


    "Keşke bir ucube okuluna naklolsaydım. Kambur, topal ve kayık tiplerin arasında daha az göze batardım."


translate turkish bunny2_meet_pol_1c0ded8b:


    "Diğer öğrenciler neşeyle okuldan ayrılırken ben..."


translate turkish bunny2_meet_pol_81f5d08b:


    "Pencere kenarında dikilip kitap karıştırıyormuş gibi yapıyor, endişeyle dışarıyı izliyordum."


translate turkish bunny2_meet_pol_daf0a700:


    "Ne ön bahçede ne girişte Semyon'dan eser yoktu."


translate turkish bunny2_meet_pol_5a69387d:


    "Şansımdan şüphe duyarak tedbiri elden bırakmamak gerektiğini düşündüm. Bu yüzden giderek boşalan koridorda biraz daha oyalanmaya karar verdim."


translate turkish bunny2_meet_pol_97e33ae6:


    "Koridorun bütün telaşesi alt kata damladı."


translate turkish bunny2_meet_pol_4fabbc14:


    "Biyoloji laboratuvarındaki iskelet, kapı aralığından boy gösteriyordu. Şakacının teki, kafatasına akbabalı bir şapka takmıştı."


translate turkish bunny2_meet_pol_1fe84169:


    "Tuvaletten şırıl şırıl su sesi geliyordu."


translate turkish bunny2_meet_pol_34ac41ac:


    "Koskoca okulda bir başıma kalmıştım."


translate turkish bunny2_meet_pol_42c800a0:


    "Birden kendi kendime \"Yalnız değilim ki!\" dedim."


translate turkish bunny2_meet_pol_03cb6c63:


    "Kayıp çocuğu hatırladım, takvimin oradaki duyuru panosunda resmi asılıydı."


translate turkish test_polina_42c6ff1d:


    "Gülüşünü..."


translate turkish test_polina_006de54d:


    "Bana bakışını..."


translate turkish test_polina_5f0e7666:


    "Ve muhtemelen çoktan ölmüş olduğunu düşündüm."


translate turkish test_polina_5b6dc0fa:



    voice "voice/Polina/2day/1 Privet.ogg"
    Noname "Merhaba!"


translate turkish test_polina_e78a7c0b:


    "Bir ürpertiyle sesin geldiği yöne döndüm."


translate turkish test_polina_c8be7c34:


    "Gözüme ilk çarpan şey, siyah keman kutusu oldu."


translate turkish doehal_1_77843044:


    "Sonra kutuyu tutanın sınıfımdan bir kız olduğunu fark ettim."


translate turkish doehal_1_6a66d915:


    "Kendisi ortadan en ön sırada oturuyordu. Hatta birkaç kez beni kestiğini gördüğüme yemin edebilirdim."


translate turkish doehal_1_2ca6bee0:


    "Ben de onu ara ara kesmiştim tabii."


translate turkish doehal_1_948d3bb9:


    "İnsanın ruhunu okşayan şeyleri, mesela akan bir dereyi, uzaklardan göz kırpan yıldızları veya Semyon'un şakalarına gülmeyen bir kızı izlemenin tadı bir başka."


translate turkish doehal_1_02e6a478:


    "Hem Katya'ya milletin kirli çamaşırlarını da dökmüyordu."


translate turkish doehal_1_744ef1ba:


    "O da teneffüslerini benim gibi geçiriyordu: Usulca sırasında oturuyor, pencereden dışarısını izliyor veya yeşil defterine bir şeyler karalıyordu."


translate turkish doehal_1_ec44091a:



    voice "voice/anton/2day/052. Zdravstvui.ogg"
    Ant "Merhaba!"


translate turkish doehal_1_b6acc600:


    "Domates gibi kızarıp parkeleri inceliyormuş gibi yaptım."


translate turkish doehal_1_0fb5d652:



    voice "voice/Polina/2day/02 Kruto ti emu.ogg"
    Noname "Semyon'a vurarak ne iyi ettin!"


translate turkish doehal_1_ec630a39:



    voice "voice/anton/2day/053.Eto vishlo slych.ogg"
    Ant "Ufak bir kaza oldu, sayılır."


translate turkish doehal_1_d7c3947a:


    "Elim boş kalmasın diye kitaplarımı çantama atmaya koyuldum."


translate turkish doehal_1_fa85fc10:



    voice "voice/Polina/2day/40 Ya videka.ogg"
    Noname "Seni ittirişi gözümden kaçmadı."


translate turkish doehal_1_1f034e16:



    voice "voice/Polina/2day/41 Ti v poryadke.ogg"
    Noname "İyi misin peki?"


translate turkish doehal_1_082addb0:


    "Başımdaki şişlik acısa da pek sıkıntı değildi."


translate turkish doehal_1_16f67fe6:



    voice "voice/anton/2day/Vporyadke.ogg"
    Ant "İyiyim."


translate turkish doehal_1_d452eb08:



    voice "voice/anton/2day/Pustyak.ogg"
    Ant "Önemi yok."


translate turkish doehal_1_460ff58e:



    voice "voice/Polina/2day/42 Aga.ogg"
    Noname "Gayet de var!"


translate turkish doehal_1_76483979:



    voice "voice/Polina/2day/43 Etot.ogg"
    Noname "Salak çocuk bu aralar kendine iyice kaybetti."


translate turkish doehal_1_606adcc2:



    voice "voice/Polina/2day/44 Vrezal.ogg"
    Noname "Sen de ona vursaydın keşke."


translate turkish doehal_1_2331f9a0:


    "Bir şey diyemedim."


translate turkish doehal_1_c8e43769:



    voice "voice/Polina/2day/03 Vrode semen.ogg"
    Noname "Semyon önceden böyle değildi."


translate turkish doehal_1_2cfbc2bf:



    voice "voice/Polina/2day/04 On k nam.ogg"
    Noname "O da buraya yakın zaman önce nakloldu."


translate turkish doehal_1_b5901d25:



    voice "voice/Polina/2day/05 Babushka.ogg"
    Noname "Nenesi bana Semyon'un taşındığından beri delirdiğini söylemişti."


translate turkish doehal_1_c0809c35:



    voice "voice/Polina/2day/06 Semena daze.ogg"
    Noname "Biliyor musun, üst sınıflar bile Semyon'dan korkuyor..."


translate turkish doehal_1_8ff06ee5:



    voice "voice/Polina/2day/07 A ti vot.ogg"
    Noname "Ama sen farklısın."


translate turkish doehal_1_bf535004:



    voice "voice/Polina/2day/08 Ne strusil.ogg"
    Noname "Cesursun."


translate turkish doehal_1_2331f9a0_1:


    "Bir şey diyemedim."


translate turkish doehal_1_ec98f73e:


    "Ben mi cesurum? Aynen öyledir."


translate turkish doehal_1_bcbfd781:


    "Dayak yememek için okul koridorunda oyalanan delikanlı mı olurmuş?"


translate turkish doehal_1_d7c3947a_1:


    "Elim boş kalmasın diye kitaplarımı çantama atmaya koyuldum."


translate turkish doehal_1_77cf359a:


    "Kız beni nazik ve meraklı bakışlarla izliyordu."


translate turkish doehal_1_14d6dbdc:



    voice "voice/Polina/2day/09 A ti za rekoi.ogg"
    Noname "Nehrin orada mı yaşıyorsun?.."


translate turkish doehal_1_72e23da9:



    voice "voice/Polina/2day/10 V tom dome.ogg"
    Noname "O ahşap evde hani?"


translate turkish doehal_1_85ec85e1:



    voice "voice/anton/2day/055. Nu da.ogg"
    Ant "Aynen."


translate turkish doehal_1_5a305d38:



    voice "voice/Polina/2day/11 Tam navernoe.ogg"
    Noname "O civar korkunç bir yere benziyor."


translate turkish doehal_1_2ad71960:



    voice "voice/Polina/2day/11 Da esche.ogg"
    Noname "Üstüne üstlük okula gelirken ormandan geçmen gerekiyor."


translate turkish doehal_1_23a7a60a:



    voice "voice/Polina/2day/12 Ya bi tak.ogg"
    Noname "Ben cesaret edemezdim."


translate turkish doehal_1_8d60e38f:


    "Ormanın bahsi geçince bir ürperti geldi."


translate turkish doehal_1_5f90f5d7:


    "İç içe geçen dallar, yılan gibi kıvrılan patika ve çarpık ağaçların arasını küf gibi saran sonsuz karanlık, gözümün önüne gelmişti."


translate turkish doehal_1_fa8138ea:


    "Bu yüzden bir yalan uyduruverdim:"


translate turkish doehal_1_16f0d2d2:



    voice "voice/anton/2day/56 Da ne tak uzh.ogg"
    Ant "O kadar korkunç değil."


translate turkish doehal_1_427f3bfd:



    voice "voice/anton/2day/56.2 A chto tebya.ogg"
    Ant "Niye korkuyorsun ki?"


translate turkish doehal_1_62a45ecc:


    "Daldığı hayalden kendisini çekip çıkarırcasına..."


translate turkish doehal_1_8354c230:


    "Hafifçe silkinip gülümsedi."


translate turkish doehal_1_35e2a47b:



    voice "voice/Polina/2day/13 Da tak.ogg"
    Noname "Yani... Neyse, boş verelim."


translate turkish doehal_1_5003b418:



    voice "voice/Polina/2day/14 Menya kstati.ogg"
    Noname "Bu arada, adım Polina."


translate turkish doehal_1_5d2b690d:



    voice "voice/anton/2day/057. A menya Anton.ogg"
    Ant "Ben de Anton."


translate turkish doehal_1_d5186d42:



    voice "voice/Polina/2day/15 Nu eto ya znayu.ogg"
    Pol "Biliyorum ya."


translate turkish doehal_1_a309072a:


    Pol "..."


translate turkish doehal_1_f13fc8b4:



    voice "voice/Polina/2day/16 Slushai.ogg"
    Pol "Ee, Anton..."


translate turkish doehal_1_1ae1c214:


    "Cümlesinin devamını getirip getirmemek arasında bir kararsızlıkla duraksadı."


translate turkish doehal_1_53327191:



    voice "voice/Polina/2day/17 A chto ti.ogg"
    Pol "Okuldan sonra ne yapıyorsun?"


translate turkish doehal_1_774ec3d5:


    "Sorduğu masum soru göğsüme acı ama -nedense- tatlı bir ateş düşürmüştü."


translate turkish doehal_1_aea8a46d:



    voice "voice/anton/2day/058. Nichego takogo.ogg"
    Ant "Ne yapayım..."


translate turkish doehal_1_9ce490d6:


    "Tekleyip cümlemin kalanını getiremedim."


translate turkish doehal_1_3d4cf095:


    "Gözümün önüne Alisa'nın yırtıcı bakışları gelmişti."


translate turkish doehal_1_368f3b93:


    "Maskesindeki yarıklardan bana neşeyle bakan gözleri, muhtemelen hayal ürünümdü tabii."


translate turkish doehal_1_b68a4c1a:


    "Ya tilki kız gerçekten de çıkışta beni bekliyorsa?"


translate turkish doehal_1_f36f4914:


    "Yoksa bu da onun tuhaf şakalarından biri miydi?"


translate turkish doehal_1_f796dfbf:


    "Acaba kabanının altında gizlediği büyük, kırmızı bir kuyruğu var mıdır?"


translate turkish doehal_1_e8ceb904:


    "Beden eğitimi dersinden çıkmış gibi boncuk boncuk terleyiverdim."


translate turkish doehal_1_2f9856e1:


    "Tilki kızı düşünmek; lekelenmiş, çamura batmış ve ormanın kucağına tıpış tıpış düşmüşüm gibi bir kirlilik hissi ve yıkanma isteği uyandırdı içimde."


translate turkish doehal_1_281cd472:



    voice "voice/Polina/2day/18 Y meanya seychas.ogg"
    Pol "Keman dersim var, ondan sonra müsait olacağım."


translate turkish doehal_1_738ff75a:



    voice "voice/Polina/2day/19 Ded mne.ogg"
    Pol "Dedem bana öğretmen tuttu da..."


translate turkish doehal_1_98164afb:



    voice "voice/Polina/2day/20 Nash uchitel.ogg"
    Pol "Müzik öğretmenimiz kemancı ama bu civarda öğretebileceği kimse yok... Benden başka tabii."


translate turkish doehal_1_7fcde81a:


    "Keman yayını tellerin üzerinde dans ettirircesine elini ileri geri salladı."


translate turkish doehal_1_01da2f8d:


    "Sanki müziği duyabiliyordum."


translate turkish doehal_1_27248510:


    "Alisa'yı kafamdan uzaklaştırmıştı."


translate turkish doehal_1_75ccaaa4:


    "Hayranlıkla donakalsam da Polina'nın ağzından çıkan her bir kelimeye özenle dudaklarını izliyordum."


translate turkish doehal_1_787f6563:


    "Sıcacık, huzur verici..."


translate turkish doehal_1_43f479d6:


    "Ve iç gıdıklayıcıydı."


translate turkish doehal_1_143de9e3:


    "Küçücükmüşüm de hislerim uçsuz bucaksız olduğu için içime sığamıyormuş gibi hissetmiştim."


translate turkish doehal_1_713bb406:



    voice "voice/Polina/2day/21 Tut govoryat.ogg"
    Pol "Köyde elini kolunu sallaya sallaya gezen bir seri katil olduğunu söylüyorlar."


translate turkish doehal_1_2bbb6461:



    voice "voice/Polina/2day/22 Ranshe.ogg"
    Pol "Normalde dedem beni okuldan alırdı ama şu an rahatsız olduğu için alamıyor."


translate turkish doehal_1_dcf4d5b8:


    "Göz ucuyla Vova'nın resmine baktım."


translate turkish doehal_1_31d01f39:


    "Dipsiz bakışlarıyla beni kesiyor, dudaklarına da kapkara ruj sürülüydü sanki."


translate turkish doehal_1_01421e0f:


    "Mezar taşlarındaki portreler gibiydi."


translate turkish doehal_1_9842b712:



    voice "voice/Polina/2day/24 Ti ne.ogg"
    Pol "Yani korktuğumdan değil de..."


translate turkish doehal_1_1771d8a1:



    voice "voice/Polina/2day/25 Prosto mne.ogg"
    Pol "Brlikte daha güvenli olur diye düşündüm."


translate turkish doehal_1_3df0c262:



    voice "voice/Polina/2day/26 Anton ti.ogg"
    Pol "Eve birlikte dönelim mi Anton?"


translate turkish doehal_1_ed0f5016:


    "İşte!"


translate turkish doehal_1_e607107a:


    "Nihayet macera kitaplarında okuyup hayalini kurduğum her şey hayatımda yer etmeye başlamıştı."


translate turkish doehal_1_1dbb5584:


    "Gizemli bir dava, güzel bir yabancı ve destansı bir düello."


translate turkish doehal_1_f25a4311:


    "Düello, ya..."


translate turkish doehal_1_2bebbff2:


    "Semyon'u hatırlayınca dünyaya dönüp kendime geliverdim. Ayaklarımın altı, hırçın sulardaki gemilerin güvertesi gibi gidip gelmeye başladı."


translate turkish doehal_1_0c8584af:


    "Keşke Polina'nın önünde bari duruşumu koruyabilseydim."


translate turkish doehal_1_24432b60:


    "Çünkü her ne kadar cesur davransam da Semyon gibi bir tosuna karşı şansım olmadığının ikimiz de gün gibi farkındaydık."


translate turkish doehal_1_ac3de96a:


    "Hele ki en kötüsünden bahsetmiyorum bile..."


translate turkish doehal_1_7311f11b:


    "Dayak yemem değil, Polina'nın gözünün önünde dayak yemem."


translate turkish doehal_1_6eadd510:


    "Herkes gibi o da hâlime güler."


translate turkish doehal_1_4373a861:


    "Olmaz, kimsenin beni o utanç dolu hâlde görmesine gerek yok."


translate turkish doehal_1_eaeae510:



    voice "voice/anton/2day/59 Segonya vryad li.ogg"
    Ant "Bugün olmaz."


translate turkish doehal_1_c0c1b440:



    voice "voice/anton/2day/59.2 You know.ogg"
    Ant "Farkındaysan Semyon çıkışta beni bekliyor."


translate turkish doehal_1_8cd54096:



    voice "voice/anton/2day/60. Better mne.ogg"
    Ant "Bu meseleyi erkek gibi teke tek çözmemiz lazım."


translate turkish doehal_1_bb0bbf07:



    voice "voice/Polina/2day/27 Gluposti kakie.ogg"
    Pol "Saçmalama."


translate turkish doehal_1_7a6d859a:


    "Polina alnına düşen saçın birazını kenara attığında, burnuma hafif bir böğürtlen kokusu çalındı."


translate turkish doehal_1_241347bd:


    "Bu kız, sokakta maç yaptıktan sonra içilen su gibi bir içimdi, tadına doyum olmazdı..."


translate turkish doehal_1_9ba6540f:


    "Bana kır evimizdeki yaz akşamlarını, ateşin kekremsi dumanını, komşunun ağaçlarından bahçemize sarkan dutları ve ayaklarımın altına serilen çam yapraklarını anımsatmıştı."


translate turkish doehal_1_62ffa3d8:


    "Kendimi son derece güvende hissettiğim huzurlu günlerdi."


translate turkish doehal_1_d680be66:


    "Annem hamakta uzanır, babam mangal yapardı."


translate turkish doehal_1_bcaef86f:


    "Gelmekte olan faciayı kömürlerin çıtırtısından, annemle babamın gülüşünden, temmuzun veda kokan esintisinden nasıl öngöremedim?"


translate turkish doehal_1_01793e98:


    "Dünyanın ne kadar hassas ve dengesiz olduğunu nasıl fark edemedim?"


translate turkish doehal_1_72409e26:



    voice "voice/Polina/2day/28 Dumaesh.ogg"
    Pol "O zalimin seninle gerçekten adilce dövüşeceğini mi sanıyorsun?"


translate turkish doehal_1_0f3a0e94:



    voice "voice/Polina/2day/29 So svoimi.ogg"
    Pol "Arkadaşlarını toplayıp sana nefes bile aldırmadan üstüne çullanırlar."


translate turkish doehal_1_b69404b0:


    "Polina'nın yüzünde kurnaz bir gülüş beliriverdi."


translate turkish doehal_1_6f23d1fc:



    voice "voice/Polina/2day/30 No esli mi.ogg"
    Pol "Ancak birlikte dönersek işler değişir."


translate turkish doehal_1_8ca7b144:



    voice "voice/Polina/2day/31 Ya ze ne tolko.ogg"
    Pol "Sadece köydeki ilk kemancı değil, aynı zamanda bir kızım ben!"


translate turkish doehal_1_3f525a87:



    voice "voice/Polina/2day/32 Slishala.ogg"
    Pol "Tanıdığım belalı bir çocuktan öğrendiğime göre yanında kız varken birine saldırılmazmış."


translate turkish doehal_1_53d5e758:



    voice "voice/Polina/2day/33 Predstavlyaesh.ogg"
    Pol "İlginç ama böyle bir görgü kuralı varmış işte."


translate turkish doehal_1_cc5f8c38:


    "\"Tanıdığım belalı bir çocuk\" mu? Hayırdır acaba?"


translate turkish doehal_1_eba80c9d:


    "Benden iyi biri midir? Daha uzun, daha yakışıklı?.."


translate turkish doehal_1_312de3fc:



    voice "voice/Polina/2day/34 Oi mne.ogg"
    Pol "Ah, müzik dersine gitmeliyim."


translate turkish doehal_1_922e2192:


    "Birkaç adım atıp durakladı."


translate turkish doehal_1_b5f7d4c1:


    "İnanılmaz... Polina, görünüşü itibarıyla filmlerdeki aktrisler veya dergilerdeki mankenlere benzemiyordu."


translate turkish doehal_1_3c44a57d:


    "Yine de titreşen avizelerin altında onlardan çok daha çekici görünüyordu."


translate turkish doehal_1_7853fe0f:



    voice "voice/Polina/2day/35 A ti.ogg"
    Pol "Sen bir şeyler çalabiliyor musun?"


translate turkish doehal_1_7cde66ed:


    "Annemle babam bana birkaç sene önce gitar almıştı."


translate turkish doehal_1_b46d39cf:


    "Birkaç nota öğrenip tıngırdatmayı denediğimi hatırlayıverdim."


translate turkish doehal_1_477b4ec2:


    "La minör, Mi minör... Değişim, hepimiz bekliyoruz değişimi..."


translate turkish doehal_1_678e6540:


    "{u}Tsoy{/u}'un zihnimde yankılanan şarkısı, düşüncelerime ve bir şeyleri değiştirme arzuma ayna tutmuştu."


translate turkish doehal_1_5141b18b:


    "O gitar, ormanın yakınındaki eski eve taşınmayı reddedercesine kaybolmuştu."


translate turkish doehal_1_5182a5f1:


    "Muhtemelen ebeveynlerim, gerçekten ihtiyaç sahibi birine vermiştir."


translate turkish doehal_1_e83ac275:



    voice "voice/anton/2day/61. Uvy ne.ogg"
    Ant "Maalesef hayır."


translate turkish doehal_1_fa83e76c:



    voice "voice/Polina/2day/36 Eh.ogg"
    Pol "Tüh."


translate turkish doehal_1_41d966d8:



    voice "voice/Polina/2day/37 Nu ladno.ogg"
    Pol "Peki madem. Ben gideyim."


translate turkish doehal_1_c424224f:



    voice "voice/Polina/2day/38 Poka.ogg"
    Pol "Hoşça kal!"


translate turkish doehal_1_292d00a7:


    "Haykırışı yüksek bir yankıya kapılıp..."


translate turkish doehal_1_328deaa0:


    "Ayakkabılarından çıkan sesle birlikte okul koridorlarına dağıldı."


translate turkish doehal_1_41ef594c:



    voice "voice/anton/2day/62.Poka.ogg"
    Ant "Hoşça kal."


translate turkish doehal_1_6e49bc48:


    "Polina beni duymuş muydu acaba?"


translate turkish doehal_1_97afc316:


    "Tekrar pencereden dışarı baktım."


translate turkish doehal_1_98d42e8d:


    "Okul bahçesi neredeyse boştu, sadece kartopu savaşı yapan bir avuç ilkokullu vardı."


translate turkish doehal_1_e15d462b:


    "Semyon denen ayıboğan ve kankalarına benzeyen hiç kimse yoktu."


translate turkish doehal_1_2b403ae7:


    "Ümitlerim yeşermişti."


translate turkish doehal_1_bafaa53a:


    "Ne yapsam?"


translate turkish doehal_1_59bb6cd1:


    "Polina buradaki ilk arkadaşım olabilir!"


translate turkish doehal_1_9cea7441:


    "Hem bir katille karşılaşır da başı tehlikeye girerse onu şövalye gibi korurum."


translate turkish doehal_1_e33c60fd:


    "Her ne kadar iç sesim, geceleri ormanda kol gezen katillerden çekinip kaçmamı tembihlese de..."


translate turkish doehal_1_8715fa8d:


    "Polina buna değerdi."


translate turkish doehal_1_c4229e8b:


    "Öte yandan kızıl kurnaz tilki de merakımı körüklüyordu."


translate turkish doehal_1_357f744e:


    "Vova'yı aramama yardım edeceğine söz vermişti ki işin ucunda ödül var."


translate turkish doehal_1_ecb34966:


    "Yeterince para, ailemin ihtiyacı olan huzuru sağlar herhalde."


translate turkish doehal_1_f72825f8:


    "Olya'ya da çeşit çeşit hediye..."


translate turkish doehal_1_70d4b1df:


    "Kız kardeşimin \"Doruk Noktası\" yarışmasında {u}Suponev{/u}'den ödüller kazanan kızlar gibi sevindiğini hayal ettim."


translate turkish doehal_1_c9fa5e5f:


    "Meşhur şarkıcılarla, hatta {u}{i}Ivanushki International{/i}{/u} gibi yeni ünlenen bir müzik grubuyla dans bile edebilir."


translate turkish doehal_1_8d33f57b:


    "Annem ve babam Ostankino Parkı'nda sarılır..."


translate turkish polfox_test_5db2a3d1:


    "Ardından hep birlikte Disneyland'e gideriz."


translate turkish bucket_see_fd226cd4:


    "Dibinde bir bez ve bulanık musluk suyuyla ağzına kadar dolu, başıboş bir çinko kova."


translate turkish bucket_see_da4be1ad:


    "Buram buram, leş gibi kimyasal kokusuyla midemi bulandırdı. Okulun hademesiyle aynı kaderi paylaşmamak için dua ederek kovadan uzaklaştım."


translate turkish bucket_see_c72bdb8a:


    "Kokuşmuş kova."


translate turkish airplane_see_0b81c32f:


    "\"Kimmiş salak, çevir de bak.\" Kesin diğer yüzünde kırıcı bir şey yazıyor."


translate turkish airplane_see_89827d33:


    "Bu uçak Semyon'un eline düşseydi kaç defa çevirirdi acaba?"


translate turkish airplane_see_5d5a5d17:


    "Kağıt uçak."


translate turkish shoes_see_9445ba4f:


    "Birisi okul ayakkabılarını pencere kenarında bırakmış. Numarasına bakılırsa benim yaşlarımda bir çocuğa ait."


translate turkish shoes_see_5598add4:


    "Okul ayakkabıları."


translate turkish bunny2_fox_win_2a12072d:


    "Çantamı kapayıp merdivenlerden aşağıya kaptırdım."


translate turkish bunny2_fox_win_eb01af05:


    "Ana koridordaki pencereden etrafı kolaçan ettim."


translate turkish bunny2_fox_win_ec60805a:


    "Ortalık sakin görünüyordu."


translate turkish bunny2_fox_win_d18c62cf:


    "Okul kapısından çıkan gıcırtı, polisiye gerilim filmlerinde sarsıcı bir sahneden önce çalan tiz notaları çağrıştırmıştı."


translate turkish bunny2_fox_win_b3d2144e:


    "Dikkat çekmemeye çalışarak okulun köşesinden döndüm."


translate turkish bunny2_fox_win_91d5e0fc:


    "Okul yemekhanesinden leziz hamur işi ve karamelize şeker kokuları geliyordu."


translate turkish bunny2_fox_win_194e5258:


    "İkinci kat penceresindeki silüeti gördüğümde donakaldım: Kafası hafif yana eğik, boynuna yasladığı kemanı çalan bu kişi Polina olmalıydı."


translate turkish bunny2_fox_win_b853592c:


    "Ne çaldığını keşke duyabilseydim... Maalesef Polina'nın penceredeki sarı perdeye düşen gölgesini görebiliyordum yalnızca."


translate turkish bunny2_fox_win_f345bfff:


    "Ayağımı sürüyerek ilerledim."


translate turkish bunny2_fox_win_9aca36d7:


    "Sahadaki kalenin filesi rüzgarla tir tir titriyordu."


translate turkish bunny2_fox_win_337a5bdf:


    "Aynı rüzgar, bahçeye beyaz hortumcuklar saçıyordu."


translate turkish bunny2_fox_win_05afaebf:


    "Susmak bilmeyen bir karga sürüsü, yakınlardan yükselen traktör sesinden irkilip kanatlanmıştı."


translate turkish bunny2_fox_win_8ace68aa:


    "Bu kulak tırmalayan motor sesi, karlı yabanda peşime düşen aç hayvanların uğultusunu anımsatıyordu."


translate turkish bunny2_fox_win_054dc6d8:


    "Ürkütücü maskesiyle Alisa aklıma geliverdi."


translate turkish bunny2_fox_win_ca2764f2:


    "O an gündüz gözüyle gerçek olduğuna inanmak pek güçtü."


translate turkish bunny2_fox_win_125d77b5:


    "Ne demişti?"


translate turkish bunny2_fox_win_ae5964ff:


    "Arka bahçede... Adam astıkları yerde..."


translate turkish bunny2_fox_win_6a0b1112:


    "Ne demek istediyse artık..."


translate turkish bunny2_school_near2_73325047:



    voice "voice/anton/2day/Ezvinite.ogg"
    Ant "A-affedersiniz?"


translate turkish bunny2_school_near2_2870004b:


    "Kim olduğu belirsiz silüet, köşeden kopup bahçenin çıkmazına doğru gözden kayboldu..."


translate turkish bunny2_school_near2_584bf47b:


    "Ardında ise sigara dumanından başka bir şey bırakmadı."


translate turkish bunny2_school_near2_14d3bd17:


    "Yetişkindi. Belki de öğretmendir."


translate turkish bunny2_school_near4_410836a0:


    "Adam asmaca."


translate turkish bunny2_school_near4_6e7afd0a:


    "Karşımdaki duvar boyunca uzanan kalın kara reçinenin altında darağacına asılı bir adam vardı."


translate turkish bunny2_school_near4_75b50baa:


    "Birileri burada adam asmaca oynamış."


translate turkish bunny2_school_near4_4b029d01:


    "Adamın hemen yanına \"KAÇIŞ,\" \"KORKU\" ve \"GERÇEK\" kelimeleri yazılmış."


translate turkish bunny2_school_near4_b2bdc362:



    voice "voice/Alisa/Alisa2day/114 Blize.ogg"
    Noname "Yaklaş, tatlım..."


translate turkish bunny2_school_near4_11183ab1:


    "Sesin nereden geldiğini anlamam biraz vakit aldı."


translate turkish bunny2_school_near4_d5b1380a:


    "Okulun arka bahçesindeki çıkmaza, pencerelere ve kar yığınlarına göz gezdirdim."


translate turkish bunny2_school_near5_b1502ab3:


    "Şırınga."


translate turkish bunny2_school_near5_396c79ff:


    "İzmaritlerin arasında kullanılmış bir şırınga var... Birinin insülin iğnesine ihtiyaç duyduğuna inanmak istiyorum."


translate turkish bunny2_school_near6_c946d655:


    "Sincap."


translate turkish bunny2_school_near6_79b60857:


    "Ay çekirdeklerini kıtır kıtır kemiren bir orman sincabı. Okuldan birileri onu muhtemelen besliyordur. İlginç..."


translate turkish bunny2_school_near1_c7bf2262:


    "Kar yığınlarından biri, püskürmek üzere bir volkan gibi titremeye başladı."


translate turkish bunny2_school_near1_0483c714:


    Alis "Alırım aklını!"


translate turkish bunny2_school_near1_6c2e8ee6:


    "Beyaz tepecik, kaşla göz arasında ufalanıp içerisinden bir tilki fırlayıverdi."


translate turkish bunny2_school_near1_20c9ecfd:


    "Üzerimde yarattığı etkinin gururuyla eğilip kibarca selam verdi."


translate turkish bunny2_school_near1_535b7487:


    "Kabanındaki kar taneleri sim gibi parlıyordu."


translate turkish bunny2_school_near1_65816506:


    "Kuyruklu kızların düşüncesinin böyle -nasıl desem- bulaşıcı..."


translate turkish bunny2_school_near1_29a5c9af:


    "Veya tatlı bir zehirden farksız olacağını tahmin etmezdim. Bir şeye benzetmesi de pek zor."


translate turkish bunny2_school_near1_fb00d248:



    voice "voice/Alisa/Alisa2day/116 Otpor.ogg"
    Alis "Aldım aklını, ne yapacaksın?"


translate turkish bunny2_school_near1_32ca8c7c:


    "Öyle içten güldü ki neşesi bana da bulaştı."


translate turkish bunny2_school_near1_a585c782:



    voice "voice/anton/2day/63. Da nu tebya.ogg"
    Ant "Seni gidi!.."


translate turkish bunny2_school_near1_4b3c017d:


    "Çabucak bir kartopu yapıp Alisa'ya fırlattım."


translate turkish bunny2_school_near1_37f306de:


    "Kaçmayı denese de nafile, omzundan vurdum."


translate turkish bunny2_school_near1_19f7c455:



    voice "voice/Alisa/Alisa2day/118 Ah ti.ogg"
    Alis "Ah, seni küstah çocuk!"


translate turkish bunny2_school_near1_eb2dac10:



    voice "voice/anton/2day/66. Da vot takoy ya.ogg"
    Ant "Aynen öyleyim!"


translate turkish bunny2_school_near1_de67e1ea:


    "Tilki yavaşça geri çekilip cephane hazırlamaya koyuldu."


translate turkish bunny2_school_near1_a0b0ab88:



    voice "voice/Alisa/Alisa2day/119 Ti hiter.ogg"
    Alis "Sen çakalsan ben de tilkiyim!"


translate turkish bunny2_school_near1_133ae8ea:



    voice "voice/Alisa/Alisa2day/120 Lovok.ogg"
    Alis "Kurnazlık esas benim işim!"


translate turkish bunny2_school_near1_8fcd5ab7:


    "Tilkinin intikamı son sürat geldi. Fırlattığı kartopu, karlı bahçe ile havadaki kargaların üzerinden süzülüverdi."


translate turkish bunny2_school_near1_1ee61357:


    "Eğilmeyi denesem de kayıp dizlerimin üstüne düştüm."


translate turkish bunny2_school_near1_97b732c4:


    "Bunun üstüne kalkmaya uğraşırken suratıma koca bir kar güllesi yedim. Cildim soğuktan yandı."


translate turkish bunny2_school_near1_114ae85f:


    "Ailemden sakladığım kasetlerdeki {u}{i}Sektor Gaza{/i}{/u} şarkılarında duyduğum kelimeleri anımsadım..."


translate turkish bunny2_school_near1_aad7e231:


    "Ve avazım çıktığınca büyük bir hüsranla küfürü bastım."


translate turkish bunny2_school_near1_44da6806:


    "Babam dediklerimi duysa suratıma şamarı indiriverirdi."


translate turkish bunny2_school_near1_44c3e26e:


    "Yakışıksız kelimelere pek tahammül edemez, Rusçayı her zaman temiz bir üslupla konuşurdu."


translate turkish bunny2_school_near1_40e914d7:



    voice "voice/Alisa/Alisa2day/121 Da ladno.ogg"
    Alis "Abartma yahu."


translate turkish bunny2_school_near1_2b56e4f8:



    voice "voice/Alisa/Alisa2day/122 Ne bolno.ogg"
    Alis "O kadar acıtmış olamaz."


translate turkish bunny2_school_near1_5eef5d37:


    "Merhamet gösterircesine kapüşonumu silkeledi ve dirseğimden tutup kalkmama yardım etti."


translate turkish bunny2_school_near1_9b6e6e58:


    "Çoluk çocuktan görülmeyecek bir ilgiyle gözlüğümü çıkardı, üzerine yapışan kar tanelerine üfleyip geri verdi."


translate turkish bunny2_school_near1_96de3992:



    voice "voice/Alisa/Alisa2day/123 Vot tak.ogg"
    Alis "Şimdi ödeştik Toşa."


translate turkish bunny2_school_near1_d2bfb6e5:


    "Bana yalnızca samimi olduğum kişiler böyle seslenirdi."


translate turkish bunny2_school_near1_b8f74985:


    "Halbuki gerçek yüzünü, soyadını, sınıfını veya kuyruğunun gerçek olup olmadığını bilmiyordum bile."


translate turkish bunny2_school_near1_22b8fafb:



    voice "voice/Alisa/Alisa2day/124 Zelaes.ogg"
    Alis "Devam edecek misin?"


translate turkish bunny2_school_near1_6e446fa8:



    voice "voice/anton/2day/68. Mi hoteli poiskat.ogg"
    Ant "Vova'yı arayacaktık hani, unuttun mu?"


translate turkish bunny2_school_near1_2858deb4:



    voice "voice/anton/2day/69. Lucshe potorop.ogg"
    Ant "Acele etmezsek ben Vova'yı bulamadan ebeveynlerim beni bulacak."


translate turkish bunny2_school_near1_2246f84a:


    "Tilki gevşekçe esnedi:"


translate turkish bunny2_school_near1_2980a5d3:



    voice "voice/Alisa/Alisa2day/125 Parents.ogg"
    Alis "Ebe-ğğ-veynlerin, he?"


translate turkish bunny2_school_near1_0c9a9a40:



    voice "voice/Alisa/Alisa2day/126 Kak skuchno.ogg"
    Alis "Çok sıkıcı muhabbetler, uykum geldi!"


translate turkish bunny2_school_near1_c8e9224d:



    voice "voice/Alisa/Alisa2day/127 Davai.ogg"
    Alis "Hadi biraz oyun oynayalım, evde sıkıntıdan yeterince patlıyorsun zaten."


translate turkish bunny2_school_near1_9ed5ae82:



    voice "voice/anton/2day/70. A ti otkuda znaesh.ogg"
    Ant "Nereden biliyorsun ki?"


translate turkish bunny2_school_near1_d11f2fa5:



    voice "voice/Alisa/Alisa2day/128 Toze mne.ogg"
    Alis "Bunu bilmeyecek ne var?"


translate turkish bunny2_school_near1_225fbe5e:



    voice "voice/Alisa/Alisa2day/129 So vzrosl.ogg"
    Alis "Yetişkinlerle dört duvar arasına hapsolmak epey sıkıcı olsa gerek!"


translate turkish bunny2_school_near1_41643732:



    voice "voice/Alisa/Alisa2day/130 Y menya.ogg"
    Alis "Duvarlar ve yetişkinler beni çok geriyor, baksana!"


translate turkish bunny2_school_near1_f5997f37:


    "Tilkinin tüylü yüzü seğirmeye başladı."


translate turkish bunny2_school_near1_d2a446a9:


    "Maskesini yüzüymüşçesine kolaylıkla oynatabilmesi komik miydi, anlam veremediğimden yapmacık bir gülüşle karşılık verdim."


translate turkish bunny2_school_near1_368edce2:



    voice "voice/Alisa/Alisa2day/131 Nu ze.ogg"
    Alis "Bir karar ver yahu, Toşa."


translate turkish bunny2_school_near1_267c8f66:



    voice "voice/Alisa/Alisa2day/132 Ya ze.ogg"
    Alis "Oyun istediğini biliyorum."


translate turkish bunny2_school_near1_08bf7411:



    voice "voice/Alisa/Alisa2day/133 I esli.ogg"
    Alis "Hem kazanırsan..."


translate turkish bunny2_school_near1_9cdff5b8:


    "Tilki kız, parmak uçlarında yükselerek iyice dibime sokuldu. Pürüzlü minik burnuyla yüzüm arasında kıl payı mesafe kalmıştı."


translate turkish bunny2_school_near1_c8908314:


    "Gözleri coşkun ateşlerin sıcacık ışığıyla parlıyordu."


translate turkish bunny2_school_near1_530a3911:


    "Mis kokusu şekerlenmiş meyveler gibiydi."


translate turkish bunny2_school_near1_ca698964:


    "Sonsuz özgürlüğün kokusu böyle bir şey miydi?"


translate turkish bunny2_school_near1_060efdc8:


    "Yani hayattaki tek amacının kafana göre takılıp abur cubur yemek olduğu özgürlüğün..."


translate turkish bunny2_school_near1_d3590815:


    "Kulağıma sımsıcak bir nefesle fısıldadı:"


translate turkish bunny2_school_near1_dadb7f43:



    voice "voice/Alisa/Alisa2day/134 Esli.ogg"
    Alis "Kazanırsan rehberin olurum."


translate turkish bunny2_school_near1_83c6de63:



    voice "voice/Alisa/Alisa2day/135 Pover.ogg"
