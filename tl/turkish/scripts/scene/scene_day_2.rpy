    Kate "Çantasının altını üstüne getirsek eminim, balta veya daha da beter şeyler çıkar içinden!"


translate turkish day2_nightmare_336404ad:



    voice "voice/kate/30 KA.ogg"
    Kate "Tabii, tabii!"


translate turkish day2_nightmare_be7ab16a:



    voice "voice/anton/2day/224. Zamolchi.ogg"
    Ant "Bir sus be! Sus!"


translate turkish day2_nightmare_46f6df57:



    voice "voice/kate/39 KA.ogg"
    Kate "Ne biçim bağırıyor ya! Canına kıyıyorlar sanki!"


translate turkish day2_nightmare_bb038898:



    voice "voice/kate/40 KA.ogg"
    Kate "Göz bebeklerine bakın bir de! Kocaman olmuşlar!"


translate turkish day2_nightmare_ff1b6582:



    voice "voice/kate/41 KA.ogg"
    Kate "Umarım, yine kafayı sıyırıp şiddete başvurmaz."


translate turkish day2_nightmare_570a784a:



    voice "voice/kate/42 KA.ogg"
    Kate "Annesi ona o ilaçları boşuna içirmiyor sonuçta."


translate turkish day2_nightmare_ee0e1a52:


    "Katya'nın ilaç kullandığımı nereden öğrendiğini biçare anlamaya çalışırken şaşkınlık içerisinde kalakalmıştım. İşin asıl korkunç yanı, saçmaladığı onca lafın gerçeklik payı vardı."


translate turkish day2_nightmare_447f9b51:



    voice "voice/kate/43 KA.ogg"
    Kate "Tabii!"


translate turkish day2_nightmare_f4f6327c:



    voice "voice/kate/44 KA.ogg"
    Kate "Kız kardeşi de kendisi gibi zırdeli."


translate turkish day2_nightmare_341b4096:



    voice "voice/kate/45 KA.ogg"
    Kate "İnsan kadar bir baykuşun her gece onu ziyaret ettiğini söyleyen bir kardeşiniz olduğunu düşünsenize!"


translate turkish day2_nightmare_76bc4623:



    voice "voice/kate/46 KA.ogg"
    Kate "Tabii!"


translate turkish day2_nightmare_a552ed46:



    voice "voice/kate/47 KA.ogg"
    Kate "Ne ilginçtir ki bu baykuşu onun dışında kimsecikler görmemiş!"


translate turkish day2_nightmare_14bab388:



    voice "voice/kate/48 KA.ogg"
    Kate "Bu alık da ona inanıyor işte."


translate turkish day2_nightmare_7c983da9:



    voice "voice/kate/49 KA.ogg"
    Kate "Düşünebiliyor musunuz?"


translate turkish day2_nightmare_e662d987:


    "Pişmiş kelle gibi sırıtan kalabalığın arasında biricik, iyi kalpli birinin bakışlarını gördüm."


translate turkish day2_nightmare_7838176c:



    voice "voice/Polina/2day/45 Pravda.ogg"
    Pol "Gerçekten mi Anton?"


translate turkish day2_nightmare_50b1f802:



    voice "voice/Polina/2day/50 Kak ze tak.ogg"
    Pol "Peki ama nasıl?"


translate turkish day2_nightmare_41d6ade2:



    voice "voice/Polina/2day/46 Neuzeli.ogg"
    Pol "Cidden... İyi değil misin?"


translate turkish day2_nightmare_935f4557:



    voice "voice/anton/2day/225. Polina poslush.ogg"
    Ant "Polina... Lütfen beni dinle!"


translate turkish day2_nightmare_7ab118c5:



    voice "voice/kate/50 KA.ogg"
    Kate "Tabii canım, tabii!"


translate turkish day2_nightmare_3a63b508:



    voice "voice/kate/51 KA.ogg"
    Kate "Polinoçka, kulak asma şu yalancıya!"


translate turkish day2_nightmare_603a0eb2:



    voice "voice/kate/52 KA.ogg"
    Kate "Hem bilmiyorsan söyleyeyim."


translate turkish day2_nightmare_9f436308:



    voice "voice/kate/53 KA.ogg"
    Kate "Anton seni aldatıyor ama bizim okuldan biriyle değil."


translate turkish day2_nightmare_de622090:



    voice "voice/kate/54 KA.ogg"
    Kate "Kızın adı A-li-sa."


translate turkish day2_nightmare_81167d06:



    voice "voice/kate/61 KA.ogg"
    Kate "Bir de Moskova'ya gitmişmiş, ufak at da civcivler yesin."


translate turkish day2_nightmare_59a86e32:



    voice "voice/kate/57 KA.ogg"
    Kate "Bu ezik daha kendisini savunamıyor ki..."


translate turkish day2_nightmare_f0ed92c6:



    voice "voice/kate/58 KA.ogg"
    Kate "Zora düştüğünde seni nasıl savunsun?"


translate turkish day2_nightmare_80db8870:



    voice "voice/kate/59 KA.ogg"
    Kate "Senden önce kaçıp kendi canını kurtarır."


translate turkish day2_nightmare_6f4ad66d:



    voice "voice/kate/60 KA.ogg"
    Kate "Kor-kak."


translate turkish day2_nightmare_2d2a8079:


    "Polina karnına tekme yemişçesine iki büklüm oldu ve gözyaşlarına boğulup feryat figan yere yığıldı."


translate turkish day2_nightmare_75611b00:



    voice "voice/Polina/2day/153 net.ogg"
    Pol "Hayır! Olamaz!"


translate turkish day2_nightmare_4a942b29:



    voice "voice/Polina/2day/153  pochemu ona.ogg"
    Pol "Niye, Anton? Niye ben değil de o?"


translate turkish day2_nightmare_0a00ad11:



    voice "voice/Polina/2day/159 Anton.ogg"
    Pol "Niye, Anton, he? Niye?"


translate turkish day2_nightmare_0d70ff2c:


    "Olanlardan hiçbir şey anlamasam da Polina'nın yanına koştum ama Katya beni sertçe itiverdi."


translate turkish day2_nightmare_25ce437d:



    voice "voice/kate/62 KA.ogg"
    Kate "Çek o patilerini, seni canavar!"


translate turkish day2_nightmare_09e2fb1c:


    "Gözüme inen korku perdesinin ardında öfkem gitgide katlanıyor..."


translate turkish day2_nightmare_1b034634:


    "Sislerin arasından usulca açığa çıkıyordu."


translate turkish day2_nightmare_67b72dc9:


    "Üst dudağımın yavaşça gerilmesiyle diş gösterdiğimi fark ettim."


translate turkish day2_nightmare_ad457bf3:



    voice "voice/kate/63 KA.ogg"
    Kate "Baban anneni dövüyor diye senin de aynısını başka kızlara yapmaya hakkın yok!"


translate turkish day2_nightmare_09055aa6:


    "Ellerimi balyoz gibi yumruk yaptım, açamıyordum!"


translate turkish day2_nightmare_8e271cbf:


    "Kimse ailem hakkında böyle ileri geri konuşamaz!"


translate turkish day2_nightmare_415a47f1:


    "Kendime geldiğimde iş işten geçmiş, çoktan cadaloz Katya'ya saldırmıştım."


translate turkish day2_nightmare_9d956dd3:



    voice "voice/kate/64 KA.ogg"
    Kate "Aha, delirdi! Vallahi delirdi!"


translate turkish day2_nightmare_e91cdcb4:



    voice "voice/kate/65 KA.ogg"
    Kate "Yardım edin! Petrov kafayı sıyırdı!"


translate turkish day2_nightmare_c85bb11d:


    "Tam da o an, Katya'nın etrafındaki kalabalığın artmasıyla sesler de yükseldi."


translate turkish day2_nightmare_6a1c61f6:


    "Islıklar ve uğultular da beraberinde geldi."


translate turkish day2_nightmare_71d194da:


    "Okuldakilerin sıska silüetleri gitgide büyüdü. O kadar uzadılar ki boyları tavana yetişti."


translate turkish day2_nightmare_c53975cd:


    "Kendimi dişlek yüzlerle dolu kocaman, kapkara bir ormanın ortasında buldum."


translate turkish day2_nightmare_6faa715a:


    "Ağaçların veya insanların -ayırt etmesi imkansızdı- çıban dolu gövdelerinin heybeti karşısında korkudan küçücük kalmış, üflesen uçacak bir tüy yumağına dönüvermiştim."


translate turkish day2_nightmare_bcc3cb81:



    voice "voice/kate/66 KA.ogg"
    Kate "İçindeki hayvanı ortaya çıkardın hele!"


translate turkish day2_nightmare_0bd8efef:



    voice "voice/kate/67 KA.ogg"
    Kate "Korkak tavuk!"


translate turkish day2_nightmare_06ddb992:


    "Katya'nın yüzü, zevkten eğri büğrü bir hâl alıvermişti."


translate turkish day2_nightmare_7c24c3c5:



    voice "voice/Polina/2day/51 Anton.ogg"
    Pol "Anton!"


translate turkish day2_nightmare_75cc05b1:



    voice "voice/Polina/2day/157  pochemu ona_net.ogg"
    Pol "Niye onu seçtin? Olamaz!"


translate turkish day2_nightmare_b8420e77:



    voice "voice/Polina/2day/158 Chem ona.ogg"
    Pol "Benim ondan ne eksiğim vardı?"


translate turkish day2_nightmare_93d7d584:



    voice "voice/Polina/2day/155 Pochemu.ogg"
    Pol "Hayır ya, hayır!"


translate turkish day2_nightmare_75df694f:



    voice "voice/Polina/2day/156 Zachto.ogg"
    Pol "Bana bunu niye yaptın?"


translate turkish day2_nightmare_a0e93bb0:


    "Polina, feryat figan gözyaşlarına boğulmuştu."


translate turkish day2_nightmare_866a8efe:



    voice "voice/kate/68 KA.ogg"
    Kate "Çünkü..."


translate turkish day2_nightmare_f28d57ae:



    voice "voice/kate/69 KA.ogg"
    Kate "O hem bir hayvan!.."


translate turkish day2_nightmare_846861d9:



    voice "voice/kate/70 KA.ogg"
    Kate "Hem de yabancı!"


translate turkish day2_nightmare_dfef7ed6:


    "Ormandan ürkünç çırpıntı sesleri yükseldi."


translate turkish day2_nightmare_3e10d2aa:


    "Kendimi bana doğru alçalan bembeyaz, kocaman bir çift kanadın arasında buldum."


translate turkish day2_nightmare_c2e8ff82:



    voice "voice/Polina/2day/148 Dva ogromnih.ogg"
    Pol "Anton! Anton!"


translate turkish day2_nightmare_f0e0945a:



    voice "voice/kate/71 KA.ogg"
    Kate "Lütfen!"


translate turkish day2_nightmare_18596436:



    voice "voice/olya/2day/24 Vstavai.ogg"
    Oly "Uyan!"


translate turkish day2_nightmare_1e891349:


    "Yattığım yerden sıçrayıverdim, az kalsın yere düşüyordum."


translate turkish day2_nightmare_84499192:


    "Aslında terden sırılsıklam olan yatağımda saatlerdir bir sağa bir sola dönüyormuşum."


translate turkish day2_nightmare_a251d742:


    "Gördüğüm kabusun pençesinden Olya'nın haykırışıyla kurtulmuştum."


translate turkish day2_nightmare_041ac0c3:



    voice "voice/olya/2day/25 Anton.ogg"
    Oly "Anton!"


translate turkish day2_nightmare_e816e94a:



    voice "voice/olya/2day/27 Pls.ogg"
    Oly "Lütfen."


translate turkish day2_nightmare_0ff9ef66:



    voice "voice/olya/2day/24 Vstavai_vstavai.ogg"
    Oly "Uyan. Uyansana!"


translate turkish day2_nightmare_bfc7486c:


    "Pencerenin oradaki silüete odaklanmam biraz zaman aldı."


translate turkish day2_nightmare_137b9971:


    "Olya'nın sesi uzaktan geliyordu. Başım o kavgadan beri zonkluyordu."


translate turkish day2_nightmare_b1936b74:


    "Sesler, kulağıma pamuk tıkamışlar gibi tuhaf geliyordu."


translate turkish day2_nightmare_e787bd06:


    "Hiç olmadığı kadar endişeli hıçkırıklara boğulan kardeşim aynı cümleleri tekrarlayıp duruyordu:"


translate turkish day2_nightmare_fee8623a:



    voice "voice/olya/2day/28 Sova.ogg"
    Oly "Baykuş! Baykuş!"


translate turkish day2_nightmare_2075b80d:



    voice "voice/olya/2day/29 Pls2.ogg"
    Oly "Lütfen."


translate turkish day2_nightmare_d9ba444c:



    voice "voice/olya/2day/30 Ya bouys.ogg"
    Oly "Korkuyorum!"


translate turkish day2_nightmare_269a017f:


    "Olya'nın gözyaşları, kalbimi kaynar sular gibi dağlasa da baykuşun ziyareti, bir bakıma hayra da vesile olmuştu."


translate turkish day2_nightmare_29d55105:


    "Yoksa Olya korkup beni kabusumdan uyandırmazdı."


translate turkish day2_nightmare_1a9ab8f3:



    voice "voice/anton/2day/227. Olya ya.ogg"
    Ant "Olya, bir saniye..."


translate turkish day2_nightmare_6d7ea1b6:



    voice "voice/anton/2day/228. Hochesh Murzilku.ogg"
    Ant "Sana {u}'{i}Murzilka{/i}'{/u} okumamı ister misin?"


translate turkish day2_nightmare_e7f76792:



    voice "voice/anton/2day/229. Podozdi.ogg"
    Ant "Getir bakayım."


translate turkish day2_nightmare_0ad3a4b1:


    "Çıplak ayaklarımı soğuk zemine attım."


translate turkish day2_nightmare_53dc4da0:


    "Elimle gözlüğümü aradım."


translate turkish day2_nightmare_d936fb27:


    "Sonra Semyon'un yaptığı şerefsizliği hatırlayıp iç çektim."


translate turkish day2_nightmare_09c375c4:



    voice "voice/olya/2day/31 Anton.ogg"
    Oly "Anton."


translate turkish day2_nightmare_d92dc6ae:



    voice "voice/olya/2day/31 Pls pls.ogg"
    Oly "Lütfen... Lütfen!"


translate turkish day2_nightmare_4e07d7e2:



    voice "voice/olya/2day/32 Posmotri.ogg"
    Oly "Bak!"


translate turkish day2_nightmare_1968b753:


    "Olya, göz kırpmama yarışı yaparcasına, bakışlarını pencereden ayıramıyordu."


translate turkish day2_nightmare_917d7f5e:


    "Lambayı açmaya uzandım ve odayı kısmen de olsa kör edici aydınlığa kavuşturdum."


translate turkish day2_nightmare_06472478:


    "Kalktım."


translate turkish day2_nightmare_6892d788:


    "Gözüm yanılmış olmalı ki pencere bir gidip geldi."


translate turkish day2_nightmare_57c49de7:


    "Kardeşim, karşımda bulanık bir karaltı gibi duruyordu."


translate turkish day2_nightmare_5aff6b47:


    "Ürkerek yaklaştım."


translate turkish day2_nightmare_115408df:



    voice "voice/anton/2day/231 Ol.ogg"
    Ant "Olya..."


translate turkish day2_nightmare_b42c67c5:



    voice "voice/anton/2day/231.2 Chto tam.ogg"
    Ant "Orada ne var?"


translate turkish day2_nightmare_94403258:



    voice "voice/anton/2day/232 Chto-to sluch.ogg"
    Ant "Bir şey mi oldu?"


translate turkish day2_nightmare_d77e015c:



    voice "voice/anton/2day/232.2 Ti hochshesh.ogg"
    Ant "Perdeyi açayım mı?"


translate turkish day2_nightmare_49064e7a:



    voice "voice/olya/2day/33 Net pls.ogg"
    Oly "Hayır! Açma!"


translate turkish day2_nightmare_563f428a:



    voice "voice/olya/2day/34 Tam ze.ogg"
    Oly "Baykuş var!"


translate turkish day2_nightmare_a7e7687e:


    "Ses arkamdan gelmişti."


translate turkish day2_nightmare_a9725d16:


    "Arkamı döndüğüm anda dehşetle donakaldım."


translate turkish day2_nightmare_bf600f29:


    "Gözleri yaşlı Olya kapı eşiğinde dikiliyordu."


translate turkish day2_nightmare_0aef4c84:



    voice "voice/olya/2day/35 S kem.ogg"
    Oly "Kim..."


translate turkish day2_nightmare_47240916:



