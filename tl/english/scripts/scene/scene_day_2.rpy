    voice "voice/Owl/Owl_2day/06 Anton.ogg"
    Noname "Anton! Anton!"


translate english day2_nightmare_1d67faff:



    voice "voice/Owl/Owl_2day/07 Podoidi.ogg"
    Noname "Come closer!"


translate english day2_nightmare_cb9a3835:


