translate english day2_nightmare_866a8efe:



    voice "voice/kate/68 KA.ogg"
    Kate "He is just!"


translate english day2_nightmare_f28d57ae:



    voice "voice/kate/69 KA.ogg"
    Kate "An animal!"


translate english day2_nightmare_846861d9:



    voice "voice/kate/70 KA.ogg"
    Kate "An outsider!"


translate english day2_nightmare_dfef7ed6:


    "A scary flapping of wings came from the forest."


translate english day2_nightmare_3e10d2aa:


