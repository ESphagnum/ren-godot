translate english day2_nightmare_139b9270:



    voice "voice/karina/2day/97 Zharko.ogg"
    Mam "Did it feel hot in here?!"


translate english day2_nightmare_7eb37580:



    voice "voice/karina/2day/98 Ne boleli.ogg"
