    voice "voice/anton/3day/086 Ya.ogg"
    Ant "I remember."


translate english day3_corner_notfox_c31e4a40:


    "The blade glowed under the setting sun, and Romka’s eyes had the same evil glow."


translate english day3_corner_notfox_fa709f8b:


    "He stepped toward me."


translate english day3_corner_notfox_1c77e194:


    "His knife traveled inches away from my coat."


translate english day3_corner_notfox_47f9235a:


