translate english d5_ending_call_2e6b355e:



    voice "voice/Polina/5day/15 tak.ogg"
    Pol "So..."


translate english d5_ending_call_55ab51a9:


    "She held out her hand."


translate english d5_ending_call_ad686cb5:


    "I clung to her cold fingers."


translate english d5_ending_call_ac775f00:


    "Side by side, we entered the forest that nobody could return from alive."


translate english d5_ending_call_20633c4e:


    "Shadows crawled out of their dens."


translate english d5_ending_call_99bcf6db:


    "And we ran."


translate english d5_ending_call_a275ae50:


    "In the eternal darkness that enveloped us..."


translate english d5_ending_call_d8d5fc79:


    "...the sun will never rise."


