translate english event_slaughter_devend_28838c2c:


    "I felt uneasy from these threats."


translate english event_slaughter_devend_34c69a7e:


    "Somebody inside me, a total stranger, directed my thoughts, my feelings, and my fears."


translate english event_slaughter_devend_92c79517:



    voice "voice/Anton/5day/05 Ver.ogg"
    Ant_m "I'll be back..."


translate english event_slaughter_devend_8f08353a:



    voice "voice/Anton/5day/06 Kog.ogg"
