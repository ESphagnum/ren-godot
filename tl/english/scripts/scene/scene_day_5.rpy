translate english d5_ending_mad_world_afterdev_181a14d5:


    voice "voice/anton/5day/13 hnik.ogg" 


translate english d5_ending_mad_world_afterdev_c92fc1d4:


    "He turned around and gave me a heavy look."


translate english d5_ending_mad_world_afterdev_8503e22a:



    voice "voice/tihonov/5day/08 Em.ogg"
    Tikhonov "They got lucky. They won't find out what you did."


translate english d5_ending_mad_world_afterdev_e40b8a79:


    "Snowflakes floated outside the barred windows of a police UAZ. The lights on top of it floundered in the darkness."


translate english d5_ending_mad_world_afterdev_29ed3235:


    "Inside the police station, a desktop lamp blinded me, making me squint."


translate english d5_ending_mad_world_afterdev_a13692c1:


    "Tikhonov measured the room with long strides."


translate english d5_ending_mad_world_afterdev_356f4bbf:


    "His shadow kept on invading the map of Russia, only to then leave its expanses that I will never explore."


translate english d5_ending_mad_world_afterdev_79e1172b:



    voice "voice/tihonov/5day/09 Tak.ogg"
    Tikhonov "Okaaay."


translate english d5_ending_mad_world_afterdev_92988adb:



    voice "voice/tihonov/5day/10 Kto.ogg"
    Tikhonov "So who was looking into your windows, again?"


translate english d5_ending_mad_world_afterdev_2fa8018b:



    voice "voice/anton/5day/134.Zver.ogg"
    Ant "The beasts."


translate english d5_ending_mad_world_afterdev_02a7aabb:



    voice "voice/anton/5day/134.Ali.ogg"
    Ant "Alisa... Hooty... Teddy... Wolfy..."


translate english d5_ending_mad_world_afterdev_e16784a0:



    voice "voice/anton/5day/135.Oni.ogg"
