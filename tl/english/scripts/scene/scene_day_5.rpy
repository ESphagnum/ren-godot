translate english d5_ending_mad_world_afterdev_2fa44f85:



    voice "voice/anton/5day/135.E.ogg"
    Ant "And then Bunny told me that I need to feed them."


translate english d5_ending_mad_world_afterdev_55ccd5e6:


    "Tikhonov slammed his fist against the desk."


translate english d5_ending_mad_world_afterdev_f07b6a4e:



    voice "voice/tihonov/5day/11 Kak.ogg"
    Tikhonov "What Wolfy, what Bunny? What the fuck are you on about?!"


translate english d5_ending_mad_world_afterdev_173ae374:



    voice "voice/tihonov/5day/12 Zoo.ogg"
    Tikhonov "Was that a traveling zoo or something?!"


translate english d5_ending_mad_world_afterdev_54546311:


    "I slouched in fear."


translate english d5_ending_mad_world_afterdev_66081b36:



    voice "voice/tihonov/5day/13 Na.ogg"
    Tikhonov "Look at me, mongrel!"


translate english d5_ending_mad_world_afterdev_56ef8af6:



    voice "voice/tihonov/5day/14 Sl.ogg"
    Tikhonov "Have you ever heard what Haloperidol can do to you?"


translate english d5_ending_mad_world_afterdev_fca62bc1:


    "I shook my head."


translate english d5_ending_mad_world_afterdev_a4e517d6:



    voice "voice/tihonov/5day/15 Em.ogg"
    Tikhonov "That's what they inject the loonies with."


translate english d5_ending_mad_world_afterdev_0beceeb2:



    voice "voice/tihonov/5day/16 Me.ogg"
    Tikhonov "It twists your muscles. A hellish torture."


translate english d5_ending_mad_world_afterdev_63d0d918:



    voice "voice/tihonov/5day/17 Ho.ogg"
    Tikhonov "Want to try it?"


translate english d5_ending_mad_world_afterdev_56d77e71:



    voice "voice/anton/5day/136.net.ogg"
    Ant "N-no."


translate english d5_ending_mad_world_afterdev_332243b0:


    "Why?"


translate english d5_ending_mad_world_afterdev_fe342c0b:


    "Don't they understand?"


translate english d5_ending_mad_world_afterdev_3b598767:


    "Can't they feel what lurks in the forest?"


translate english d5_ending_mad_world_afterdev_1b995f2a:


    "Dark taiga looked at me from the map, right above the officer's head."


translate english d5_ending_mad_world_afterdev_7d5151f0:


    "A place far away from civilization, where owls hoot, and the icy fingers of living corpses scrape the frosty ground."


translate english d5_ending_mad_world_afterdev_57e24f20:



    voice "voice/anton/5day/139.Vi.ogg"
    Ant "Did you find the footprints?"


translate english d5_ending_mad_world_afterdev_7347bcf5:



    voice "voice/anton/5day/139.Oni.ogg"
    Ant "They walked all over the field, and the front yard."


translate english d5_ending_mad_world_afterdev_ff8612e1:



    voice "voice/tihonov/5day/18 Oni.ogg"
    Tikhonov "Them! Them again!"


translate english d5_ending_mad_world_afterdev_325d6ff2:


    "The lieutenant rolled his eyes."


translate english d5_ending_mad_world_afterdev_bb1322f0:



    voice "voice/tihonov/5day/19 Sn.ogg"
    Tikhonov "The snowstorm has already covered your shack of a house up to its roof!"


translate english d5_ending_mad_world_afterdev_2ab23176:



    voice "voice/tihonov/5day/20 Ee.ogg"
    Tikhonov "We won't be able to find it, let alone any footprints..."


translate english d5_ending_mad_world_afterdev_11a2fca5:



    voice "voice/anton/5day/140.SprPol.ogg"
    Ant "Ask Polina."


translate english d5_ending_mad_world_afterdev_fd839b65:



    voice "voice/anton/5day/140.SprRom.ogg"
    Ant "Ask Roma."


translate english d5_ending_mad_world_afterdev_7dc85d48:




    voice "voice/anton/5day/142.Oni.ogg"
    voice "voice/Anton/5day/298 oni.ogg"
    Ant "They saw..."


translate english d5_ending_mad_world_afterdev_519060fc:



    voice "voice/Anton/5day/299 ona.ogg"
    Ant "She saw..."


translate english d5_ending_mad_world_afterdev_51c7563e:



    voice "voice/Anton/5day/300 on.ogg"
    Ant "He saw..."


translate english d5_ending_mad_world_afterdev_5a8307d9:



    voice "voice/tihonov/5day/21 Ti.ogg"
    Tikhonov "Do you think I don't know how to do my work?"


translate english d5_ending_mad_world_afterdev_2b0dc9f3:



    voice "voice/tihonov/5day/22 Sp.ogg"
    Tikhonov "We did ask."


translate english d5_ending_mad_world_afterdev_6991876a:



    voice "voice/tihonov/5day/23 On.ogg"
    Tikhonov "They saw the barricades that you constructed."


translate english d5_ending_mad_world_afterdev_70ad7504:



    voice "voice/tihonov/5day/06 Ona.ogg"
    Tikhonov "She saw the barricades that you constructed."


translate english d5_ending_mad_world_afterdev_18ff980d:



    voice "voice/tihonov/5day/04 On.ogg"
    Tikhonov "He saw the barricades that you constructed."


translate english d5_ending_mad_world_afterdev_2941b80c:



    voice "voice/tihonov/5day/24 No.ogg"
    Tikhonov "Yet not a single word about your zoo!"


translate english d5_ending_mad_world_afterdev_e59da802:


    "How could it be? Were they on the side of the monsters?"


translate english d5_ending_mad_world_afterdev_ce42200e:


    "How could it be? Was she on the side of the monsters?"


translate english d5_ending_mad_world_afterdev_ef337dab:


    "How could it be? Was he on the side of the monsters?"


translate english d5_ending_mad_world_afterdev_9d736e35:


    "I remembered the parasite that writhed inside Zhulka."


translate english d5_ending_mad_world_afterdev_3280814f:



    voice "voice/anton/5day/143.Vmus.ogg"
    Ant "Look inside the trash can. There should be the thing that crawled out of the dog."


translate english d5_ending_mad_world_afterdev_eea4f3b6:



    voice "voice/tihonov/5day/25 Es.ogg"
    Tikhonov "Out of the stray that you killed?"


translate english d5_ending_mad_world_afterdev_e4a9c4ae:



    voice "voice/tihonov/5day/26 Mu.ogg"
    Tikhonov "We found it in your freezer, but no monsters in the waste bin."


translate english d5_ending_mad_world_afterdev_012ce875:



    voice "voice/anton/5day/144.Na.ogg"
    Ant "The beasts probably took it."


translate english d5_ending_mad_world_afterdev_6db1abbb:


    "I wanted to hug Polina so badly that I scooped up empty air and pressed that emptiness into my chest."


translate english d5_ending_mad_world_afterdev_a2f8268c:


    "I wanted to hug Romka so badly that I scooped up empty air and pressed that emptiness into my chest."


translate english d5_ending_mad_world_afterdev_dbefd125:


    "I wanted to hug Olya so badly that I scooped up empty air and pressed that emptiness into my chest."


translate english d5_ending_mad_world_afterdev_5035fe38:


    "Tikhonov exchanged meaningful glances with his colleague."


translate english d5_ending_mad_world_afterdev_ea64e8c5:


    "The lieutenant's voice softened, but I felt there was something else."


translate english d5_ending_mad_world_afterdev_770a5429:



    voice "voice/tihonov/5day/27 Ti.ogg"
    Tikhonov "Do you know what this is?"


translate english d5_ending_mad_world_afterdev_184ba62d:


    "He placed a small plastic container with pills in front of me."


translate english d5_ending_mad_world_afterdev_8a21885e:



    voice "voice/anton/5day/145.Vit.ogg"
    Ant "Vitamins."


translate english d5_ending_mad_world_afterdev_54f5bd3f:



    voice "voice/tihonov/5day/28 A.ogg"
    Tikhonov "And do you know what schizophrenia is?"


translate english d5_ending_mad_world_afterdev_ff55cb0f:



    voice "voice/anton/5day/146.Ps.ogg"
    Ant "A mental illness?"


translate english d5_ending_mad_world_afterdev_e5050900:



    voice "voice/tihonov/5day/29 Em.ogg"
    Tikhonov "That's right, son. It's an illness."


translate english d5_ending_mad_world_afterdev_05ba1783:



    voice "voice/tihonov/5day/30 Ee.ogg"
    Tikhonov "It's accompanied with cognitive dysfunction, issues with emotion management, delusions..."


translate english d5_ending_mad_world_afterdev_0df2548f:


    "I had no idea where he was going."


translate english d5_ending_mad_world_afterdev_68db3305:


    "What relevance did it have to me?"


translate english d5_ending_mad_world_afterdev_c0f5a508:



    voice "voice/tihonov/5day/31 Est.ogg"
    Tikhonov "There is medication that can help suppress that illness."


translate english d5_ending_mad_world_afterdev_fe4cf860:



    voice "voice/tihonov/5day/32 No.ogg"
    Tikhonov "But they don't always work."


translate english d5_ending_mad_world_afterdev_04bc8d63:


    "I thought that I should probably stop hugging empty air, as well as compulsively licking my lips, but that urge was stronger than me."


translate english d5_ending_mad_world_afterdev_e7ba0b4d:



    voice "voice/anton/5day/147.Ya.ogg"
    Ant "I saw the Black Garage."


translate english d5_ending_mad_world_afterdev_69f70fcd:


    "Tikhonov clicked with a lighter, ignited a cigarette."


translate english d5_ending_mad_world_afterdev_d7ea217a:


    "I started coughing, which only made him smirk."


translate english d5_ending_mad_world_afterdev_ade4c13b:



    voice "voice/tihonov/5day/33 Cho.ogg"
    Tikhonov "Black Garage is an urban legend."


translate english d5_ending_mad_world_afterdev_a07c5cee:



    voice "voice/tihonov/5day/34 Ya.ogg"
    Tikhonov "I've been reading this newspaper, \"Criminal news\". They often write about serial killers from overseas."


translate english d5_ending_mad_world_afterdev_9325f59e:



    voice "voice/tihonov/5day/35 Pra.ogg"
    Tikhonov "The reality is that twenty or so years ago an American called Herbert Mullin killed a dozen people to prevent an earthquake."


translate english d5_ending_mad_world_afterdev_087ebf5e:



    voice "voice/tihonov/5day/36 Dr.ogg"
    Tikhonov "Another of his compatriots, Richard Chase, drank human blood because he thought that would save him from the poison that clandestine nazi organizations injected him with."


translate english d5_ending_mad_world_afterdev_c533dcbd:



    voice "voice/anton/5day/150.Ya.ogg"
    Ant "I don't know those people."


translate english d5_ending_mad_world_afterdev_13e238cc:


    "Tikhonov's tone of voice was ingratiating, full of fake sympathy."


translate english d5_ending_mad_world_afterdev_4a76553b:



    voice "voice/tihonov/5day/37 O.ogg"
    Tikhonov "Oh, of course you don't."


translate english d5_ending_mad_world_afterdev_cfb7d8d4:



    voice "voice/tihonov/5day/38 No.ogg"
    Tikhonov "But you do know a boy... a sad, desperately ill boy, whose parents were on the brink of divorce. And the stress only worsened his condition."


translate english d5_ending_mad_world_afterdev_b0846e33:



    voice "voice/tihonov/5day/39 On.ogg"
    Tikhonov "He made up a bunch of talking animals. Then, he befriended them."


translate english d5_ending_mad_world_afterdev_65fc9aa1:


    "Tikhonov took a long puff and let out a cloud of smoke."


translate english d5_ending_mad_world_afterdev_8a8b2b06:



    voice "voice/anton/5day/151.Net.ogg"
    Ant "No..."


translate english d5_ending_mad_world_afterdev_71aa886d:


    "My thoughts got tangled, my vision blurred."


translate english d5_ending_mad_world_afterdev_ca171d8e:


    "I jumped over the forest with Alisa!"


translate english d5_ending_mad_world_afterdev_b7f32bde:


    "I was in Grandpa Frost's palace!"


translate english d5_ending_mad_world_afterdev_9049c216:


    "I..."


translate english d5_ending_mad_world_afterdev_c6e7be2c:



    voice "voice/tihonov/5day/41 Pos.ogg"
    Tikhonov "After Semyon went missing, you became a person of interest."


translate english d5_ending_mad_world_afterdev_e4ae3fbd:



    voice "voice/tihonov/5day/42 ta.ogg"
    Tikhonov "A weird, introverted boy like that... But we didn't have enough evidence."


translate english d5_ending_mad_world_afterdev_b80cb1b0:



    voice "voice/tihonov/5day/43 Da.ogg"
    Tikhonov "Even when Katya disappeared..."


translate english d5_ending_mad_world_afterdev_add94fb4:



    voice "voice/anton/5day/152.Vr.ogg"
    Ant "Lies!"


translate english d5_ending_mad_world_afterdev_8ad55f83:


    "I pounced at the nasty, disgusting police officer, but his partner quickly returned me to my seat."


translate english d5_ending_mad_world_afterdev_3129cfca:


    "I was suffocating from frustration."


translate english d5_ending_mad_world_afterdev_d4422e94:


    "There was an unbearable taste in my mouth, similar to how a raw human finger would taste..."


translate english d5_ending_mad_world_afterdev_448cd602:


    "Wait, why do I know what human flesh tastes like?"


translate english d5_ending_mad_world_afterdev_d51715d4:


    "I clutched my temples."


translate english d5_ending_mad_world_afterdev_61c09540:


    "It felt like my brain was getting boiled under the lid of my skull."


translate english d5_ending_mad_world_afterdev_0da187f8:



    voice "voice/tihonov/5day/44 Mal.ogg"
    Tikhonov "That boy eliminated his enemies."


translate english d5_ending_mad_world_afterdev_149a856c:



    voice "voice/tihonov/5day/45 No.ogg"
    Tikhonov "But the beasts in his head demanded more."


translate english d5_ending_mad_world_afterdev_5ad296ff:



    voice "voice/tihonov/5day/46 Oni.ogg"
    Tikhonov "They forced him to..."


translate english d5_ending_mad_world_afterdev_8ca06b01:



    voice "voice/anton/5day/156.Zam.ogg"
    Ant "Shut up!"


translate english d5_ending_mad_world_afterdev_503fdd3a:


    "Tikhonov snubbed out his cigarette in the ashtray."


translate english d5_ending_mad_world_afterdev_1e13d3f9:



    voice "voice/tihonov/5day/48 Zaru.ogg"
    Tikhonov "Chop up his only friend."


translate english d5_ending_mad_world_afterdev_25b999de:



    voice "voice/tihonov/5day/49 Zarub.ogg"
    Tikhonov "Chop up his girlfriend."


translate english d5_ending_mad_world_afterdev_cd3335b3:



    voice "voice/tihonov/5day/47 Zar.ogg"
    Tikhonov "Chop up his sister."


translate english d5_ending_mad_world_afterdev_4f5e6244:


    "I whined from horror, pulling on my lower lip with my fingers, stretching my cheeks."


translate english d5_ending_mad_world_afterdev_5ceabbf2:



    voice "voice/tihonov/5day/50 Sem.ogg"
    Tikhonov "You caught up to Semyon in the thicket after your confrontation."


translate english d5_ending_mad_world_afterdev_2bfd6de7:



    voice "voice/tihonov/5day/53 Kat.ogg"
    Tikhonov "You also lured Katya away under the pretense of telling her a secret."


translate english d5_ending_mad_world_afterdev_7993caa7:



    voice "voice/tihonov/5day/51 Vov.ogg"
    Tikhonov "You met Vova randomly while wandering through the forest."


translate english d5_ending_mad_world_afterdev_9ca4a0e6:



    voice "voice/tihonov/5day/52 Voz.ogg"
    Tikhonov "Maybe you wanted to play with his toy gun, and he didn't give it to you."


translate english d5_ending_mad_world_afterdev_aff08a99:



    voice "voice/anton/5day/158.Per.ogg"
    Ant "Stop it!"


translate english d5_ending_mad_world_afterdev_92583479:



    voice "voice/tihonov/5day/54 Sl.ogg"
    Tikhonov "Senechka is a tougher case."


translate english d5_ending_mad_world_afterdev_04ed8051:



    voice "voice/tihonov/5day/55 ona.ogg"
    Tikhonov "She disappeared before your arrival, so that left us stumped for a long time... But now I remember."


translate english d5_ending_mad_world_afterdev_7360cff6:



    voice "voice/tihonov/5day/56 Tv.ogg"
    Tikhonov "Your gran is buried here, right?"


translate english d5_ending_mad_world_afterdev_221f9300:



    voice "voice/anton/5day/159.Eto.ogg"
    Ant "This is not real! It's just a dream!"


translate english d5_ending_mad_world_afterdev_c12a86ee:


    "Tikhonov moved up so close, his face almost pressed into mine."


translate english d5_ending_mad_world_afterdev_32cad7ae:


    "I sensed the smell of lotion and tobacco."


translate english d5_ending_mad_world_afterdev_eed4fc45:


    "He whispered, studying me point-blank with a merciless stare."


translate english d5_ending_mad_world_afterdev_451196ce:



    voice "voice/tihonov/5day/57 Ti.ogg"
    Tikhonov "You came to the village in December."


translate english d5_ending_mad_world_afterdev_aeb9808f:



    voice "voice/tihonov/5day/58 Pro.ogg"
    Tikhonov "To visit your grandma at the cemetery."


translate english d5_ending_mad_world_afterdev_721eb8da:



    voice "voice/tihonov/5day/59 Tam.ogg"
    Tikhonov "That's when you saw Senya."


translate english d5_ending_mad_world_afterdev_856d6262:


    "Torn clothes along the cemetery path."


translate english d5_ending_mad_world_afterdev_891d1506:


    "I bawled."


translate english d5_ending_mad_world_afterdev_63d207b6:


    "Tikhonov leaned away, lit another cigarette, and spoke."


translate english d5_ending_mad_world_afterdev_c45465a3:



    voice "voice/tihonov/5day/60 Ad.ogg"
    Tikhonov "Hell is our memories."


translate english d5_ending_mad_world_afterdev_db77d2ba:



    voice "voice/tihonov/5day/61 Ya.ogg"
    Tikhonov "I can't think of a worse punishment for you than just remembering everything you did."


translate english d5_ending_mad_world_afterdev_d4c1bff0:



    voice "voice/tihonov/5day/62 Uv.ogg"
    Tikhonov "Take him away!"


translate english d5_ending_mad_world_afterdev_91edd27c:



    voice "voice/anton/5day/161.Eto.ogg"
    Ant "They deceived me! It's all their fault!"


translate english d5_ending_mad_world_afterdev_95c054ab:



    voice "voice/anton/5day/161.Po.ogg"
    Ant "Please, believe me!"


translate english d5_ending_mad_world_afterdev_a8ca38ff:



    voice "voice/anton/5day/162.Let.ogg"
    Ant "Officer!"


translate english d5_ending_mad_world_aftertitles_40abc550:


    "The hospital room was bright and spacious."


translate english d5_ending_mad_world_aftertitles_4dca6f57:


    "And completely white. Winter never ended here."


translate english d5_ending_mad_world_aftertitles_526eeef0:


    "The food is good, but most of it is liquid–many of my neighbors, who medical workers escort into the canteen, don't have enough teeth to chew solid food."


translate english d5_ending_mad_world_aftertitles_01f77262:


    "Some of them are fed through straws. Those I usually meet in the corridor."


translate english d5_ending_mad_world_aftertitles_6f7a94ea:


    "Dirty and disheveled, they nap on the benches or scratch at the walls with their nails."


translate english d5_ending_mad_world_aftertitles_3d981604:


    "Those who don't behave end up in the soft room, or even worse, in the basement."


translate english d5_ending_mad_world_aftertitles_1568c4cc:


    "After that, they become completely silent. Empty, like dolls."


translate english d5_ending_mad_world_aftertitles_690f0bc8:


    "I always behave, though."


translate english d5_ending_mad_world_aftertitles_705b8856:


    "I don't get beaten with rubber batons like the guilty ones."


translate english d5_ending_mad_world_aftertitles_99703f04:


    "But the people who share the room with me can be monstrously mean."


translate english d5_ending_mad_world_aftertitles_d7f71e9f:


    "Not all of them actually suffer from schi... schipho... I started to forget some words... But yes, some people are here just to hide from the {u}draft{/u}."


translate english d5_ending_mad_world_aftertitles_159e9c74:


    "Those fakers bully me for no reason, just like my former classmates."


translate english d5_ending_mad_world_aftertitles_dc67d0fa:


    "They might put out their cigarettes on the bare parts of my body, or make me wash their clothes, laughing all the while."


translate english d5_ending_mad_world_aftertitles_506e5f31:


    "One day, a certain village moron snuck up on me while I was sleeping and almost raped me."


translate english d5_ending_mad_world_aftertitles_e0400283:


    "From that moment on, I barely ever sleep."


translate english d5_ending_mad_world_aftertitles_fcbc7ec5:


    "I keep thinking about what the policeman said to me. He's so silly."


translate english d5_ending_mad_world_aftertitles_f06dc193:


    "The masks actually existed, as did the Garage, and the dances in the forest, and everything else."


translate english d5_ending_mad_world_aftertitles_2d0cbde8:


    "If that's not the case, why would I kill the girl that sounded like a refreshing spring?"


translate english d5_ending_mad_world_aftertitles_21cef860:


    "If that's not the case, why would I kill my best friend?"


translate english d5_ending_mad_world_aftertitles_139170b3:


    "If that's not the case, why would I kill the person I loved the most?"


translate english d5_ending_mad_world_aftertitles_a7874968:


    "Isn't that plain madness?"


translate english d5_ending_mad_world_aftertitles_b482a8f3:


    "Somebody screamed in the corridor."


translate english d5_ending_mad_world_aftertitles_58ef3e6d:


    "But I don't care."


translate english d5_ending_mad_world_aftertitles_62ba1e67:


    "I wait for the coming of spring."


translate english d5_ending_mad_world_aftertitles_f211bcc6:


    "I look into the only barred window in the room."


translate english d5_ending_mad_world_aftertitles_968e717a:


    "Afraid that the warm season will never come."


translate english d5_ending_mad_world_aftertitles_e9f3f775:


    "Far, far away, somebody starts playing a flute."


translate english d5_ending_mad_world_aftertitles_8c6d2328:


    "And then I see them..."


translate english d5_ending_apocalypse_965bb1fa:


    "A tear, a single tear rolled down my cheek, burning me like a drop of sulfuric acid."


translate english d5_ending_apocalypse_20972997:


    "The same acid boiled up inside, corroding my organs."


translate english d5_ending_apocalypse_01b80f7f:


    "I looked at Olya without blinking."


translate english d5_ending_apocalypse_9167ec39:


    "Dead Olya."


translate english d5_ending_apocalypse_095e159e:


    "Her eyelids dropped. Blood painted her hair red, but her face was still pure and serene."


translate english d5_ending_apocalypse_7ed1f1f7:


    "Her skull buckled like a chocolate egg pressed with a thumb."


translate english d5_ending_apocalypse_35b01201:


    "Although there are no bones and hair sticking to the brain inside a chocolate egg."


translate english d5_ending_apocalypse_d3cdc692:


    "If not for the wound on the top of her head, I could've thought she was just sleeping."


translate english d5_ending_apocalypse_94a16171:



    voice "voice/Anton/5day/301 hn.ogg"
    "I sniffled."


translate english d5_ending_apocalypse_7b21e1e9:


    "It was I who killed my sister. It was I who didn't save our parents. It was I who destroyed our family."


translate english d5_ending_apocalypse_d49bff7f:


    "I wanted a bunch of adults to storm the house. Led by Tikhonov, for example."


translate english d5_ending_apocalypse_994c07a6:


    "I wanted him to see the axe in my hands and sentence me to an execution by a firing squad then and there."


translate english d5_ending_apocalypse_c9b0e1fe:


    "As soon as I thought that, the being that lay dormant inside my head all this time took control of my lips and spread them in a wide, disgusting smile."


translate english d5_ending_apocalypse_08dd6ad2:



    voice "voice/bunny/20 T.ogg"
    Bunny "You don't deserve death, you deserve the highest award."


translate english d5_ending_apocalypse_a5f3d044:



    voice "voice/bunny/21 Ti.ogg"
    Bunny "You did the right thing, Anton. The sacrifice was necessary. The sacrifice is always justified."


translate english d5_ending_apocalypse_c8c7fa15:



    voice "voice/anton/5day/27 ti.ogg"
    Bunny "You'll get your revenge, you just gotta be patient…"


translate english d5_ending_apocalypse_81c67654:



    voice "voice/Anton/5day/301 Kog.ogg"
    Ant "When?"


translate english d5_ending_apocalypse_bc2d89ef:



    voice "voice/anton/5day/28 p.ogg"
    Bunny "A bit later, boy. Just a little bit later…"


translate english d5_ending_apocalypse_4a0deb54:



    voice "voice/anton/5day/29 t.ogg"
    Bunny "You're still weak. You need to become stronger."


translate english d5_ending_apocalypse_d045b35c:



    voice "voice/anton/5day/30 e.ogg"
    Bunny "If you die now, who will feed the kind beasts?"


translate english d5_ending_apocalypse_12fe95a5:



    voice "voice/anton/5day/22 v.ogg"
    Bunny "It's time to feed."


translate english d5_ending_apocalypse_6501d0df:


    "I dropped the axe, and it hit the floorboards with a dull sound. But that didn't wake up Olya. Dead people are such sound sleepers…"


translate english d5_ending_apocalypse_391365ff:


    "I put my coat on, even though some sort of sixth sense told me that I wouldn't need clothes where I'm heading."


translate english d5_ending_apocalypse_9eb122ee:


    "I bent down and slid my hands under Olya's neck and knees."


translate english d5_ending_apocalypse_34c2d582:


    "A thin streak of saliva dripped on her chest from my open mouth."


translate english d5_ending_apocalypse_533cf5ba:



    voice "voice/anton/5day/23 s.ogg"
    Bunny "We're salivating, eh?"


translate english d5_ending_apocalypse_32024df3:


    "My dear Olya…"


translate english d5_ending_apocalypse_e9bb3a8c:


    "It was my duty to protect her. As her older brother."


translate english d5_ending_apocalypse_679350fa:


    "Duty only makes us weak."


translate english d5_ending_apocalypse_493677ba:


    "Only freedom can give us strength. And Olya was free now."


translate english d5_ending_apocalypse_f5059d19:


    "Thick shadows filled in her eyelids and her cheekbones."


translate english d5_ending_apocalypse_ce58476c:


    "A painting of a dead person... Is it still a portrait or already a still-life?"


translate english d5_ending_apocalypse_1845de20:


    "I picked up my sister. She barely weighed anything."


translate english d5_ending_apocalypse_911ee0eb:


    "Her hair that always smelled so good emanated a coppery and pleasant aroma of blood."


translate english d5_ending_apocalypse_98b9444d:


    "Olya's head hung over my hand."


translate english d5_ending_apocalypse_e2435002:


    "I remembered how Mom brought the newborn Olya to me and let me hold her."


translate english d5_ending_apocalypse_01cfcd68:


    "Back then I thought: \"So tiny and tasty, yet already a human?\""


translate english d5_ending_apocalypse_26e9bf08:


    "Not even a human anymore…"


translate english d5_ending_apocalypse_f31432d4:


    "I did this. I turned a living being into a corpse—cold, sweet, sticky."


translate english d5_ending_apocalypse_836a2405:


    "I leaned in and gave her an awkward kiss on her cold cheek. It was still as soft as ever."


translate english d5_ending_apocalypse_53a8a5ea:



    voice "voice/anton/5day/31 ot.ogg"
    Bunny "Take a bite."


translate english d5_ending_apocalypse_6962ca5a:


    "The door behind me flung open, and the wind flooded the house. The hallway got covered in snow."


translate english d5_ending_apocalypse_dc647a1e:


    "I went toward the snowstorm, carrying a terrifying load in front of me with utmost care."


translate english d5_ending_apocalypse_1fdd644b:


    "Four letters: Olya."


translate english d5_ending_apocalypse_81f245b8:


    "Four letters: food."


translate english d5_ending_apocalypse_7c78c1c6:


    "I went out to the porch. The world has changed. Could it really stay the same after what I've done?"


translate english d5_ending_apocalypse_c5c96464:


    "Some sort of amorphous mass bubbled and swelled."


translate english d5_ending_apocalypse_af966151:


    "\"It's the forest,\" I thought, \"In its true form.\""


translate english d5_ending_apocalypse_9dc1b671:


    "This is my new home."


translate english d5_ending_apocalypse_fa87fd22:


    "The trees lurked in the darkness, reaching for prey with their branches. Their thick roots rose from the frozen soil, drawing nightmarish lines in the snow."


translate english d5_ending_apocalypse_de42cf33:


    "The world was hungry. Its children stood between me and the writhing, twisting pines."


translate english d5_ending_apocalypse_111dd520:


    "They grew to fantastical scale but still felt so familiar and so dear…"


translate english d5_ending_apocalypse_dbdb653c:


    "A black trail led to the monstrous figures. A thin stripe, in a place where the snow thawed."


translate english d5_ending_apocalypse_3cb6bf4a:


    "The hard soil reminded me of the scales of a giant reptile. It rose and descended under my soles."


translate english d5_ending_apocalypse_2d8eac31:


    "The beast I walked on was breathing."


translate english d5_ending_apocalypse_e58a4031:



    voice "voice/Alisa/5day/03 Mi.ogg" 
    Alis "Welcome, Bunny."


translate english d5_ending_apocalypse_fb60bda6:



    voice "voice/Owl/40 Uh.ogg" 
    Owl "So that's what you look like, hoot."


translate english d5_ending_apocalypse_9269f363:



    voice "voice/Wolf/125 k.ogg"
    Wolf "P-grr-etty."


translate english d5_ending_apocalypse_28c01768:


    "I picked Olya up, as if weighing her."


translate english d5_ending_apocalypse_1e185807:



    voice "voice/Anton/5day/304 eto.ogg"
    Ant "This is my sister. I loved her."


translate english d5_ending_apocalypse_6d34d9ac:



    voice "voice/Alisa/5day/04 E.ogg" 
    Alis "We like her, too… Bring her closer."


translate english d5_ending_apocalypse_2533fbef:


    "The wind hit me in the face. It smelled of cinder and corroded my mucous."


translate english d5_ending_apocalypse_0f0558ef:


    "A harsh sound that tormented my eardrums came from somewhere above. Something between an air raid alert siren and a woman, wailing in agony."


translate english d5_ending_apocalypse_9792d046:


    "I looked up at the sky that moved and writhed, as if it were woven from millions of worms. The sky died, just like Olya, and now it was full of larvae."


translate english d5_ending_apocalypse_0d353560:


    "Moon, round and yellow, bubbled above the forest like a bulging eye of a dead person."


translate english d5_ending_apocalypse_6a0f85f7:


    "The Moon saw what I did. And it screamed. The Moon squealed in horror and bled."


translate english d5_ending_apocalypse_1045b8cc:


    "I felt like a feather in the wind. And I also felt that this is exactly what the world without Olya must look like."


translate english d5_ending_apocalypse_80c3258f:


    "With the screaming moon, with the rotting skies, with the taiga, crawling in the boneyard."


translate english d5_ending_apocalypse_2a556259:


    "The beast's shadow covered me along with my dead sister."


translate english d5_ending_apocalypse_af027513:



    voice "voice/Alisa/5day/05 Sp.ogg" 
    Alis "Thank you, Bunny. I never doubted you. Can I?"


translate english d5_ending_apocalypse_65c8f9e7:


    "My gaze darted between the horrifying silhouettes. They moved closer one moment only to pull away the next. They switched places as soon as I blinked."


translate english d5_ending_apocalypse_9548cd7c:


    "This is not right. These monsters can tear me to pieces at any moment."


translate english d5_ending_apocalypse_b15357f2:



    voice "voice/anton/5day/24 ra.ogg"
    Bunny "Do friends act like that?"


translate english d5_ending_apocalypse_b4c2f39e:



    voice "voice/anton/5day/25 p.ogg"
    Bunny "Look at them, they're your family, your pack…"


translate english d5_ending_apocalypse_d4cebdea:



    voice "voice/anton/5day/26 d.ogg"
    Bunny "Trust them, there is no way back. All of the bridges have been burned, give them the meat, they will be tender with it, give them the meat."


translate english d5_ending_apocalypse_265174f8:


    "My numb, bloodied hands were empty."


translate english d5_ending_apocalypse_e1b2c5be:


    "The hungry beast that looked like a fox pressed herself against the corpse."


translate english d5_ending_apocalypse_93b0e405:


    "I heard the crunching of bones."


translate english d5_ending_apocalypse_65090373:


    "The body of a disgusting centipede stretched, its mandibles opened and closed, sharp as sickles."


translate english d5_ending_apocalypse_2a85d47d:


    "They cut open my sister's stomach. At the same time, the horrendous jaws locked on Olya's pale face."


translate english d5_ending_apocalypse_b1e03161:


    "I staggered, but I couldn't look away."


translate english d5_ending_apocalypse_c9e96ca5:


    "Alisa threw the innards to the side."


translate english d5_ending_apocalypse_f0c3c02d:



    voice "voice/Alisa/5day/08 Pr.ogg" 
    Alis "Bon appétit."


translate english d5_ending_apocalypse_4c2c4254:


    "The owl rushed toward them and plunged into those gray, slimy sausages. She devoured them greedily, like a stray dog would devour carrion."


translate english d5_ending_apocalypse_528b0439:


    "The fox tore the corpse limb from limb. Sinews popped under the strength of the claws."


translate english d5_ending_apocalypse_448ce9e2:


    "Juicy bits of human flesh plopped in front of me."


translate english d5_ending_apocalypse_8b1cb495:


    "Dead, but, for some reason, still not coagulated blood ran toward my feet."


translate english d5_ending_apocalypse_3607a6e9:


    "Olya's head hung toward the ground, connected to her body with a small patch of skin."


translate english d5_ending_apocalypse_6e770e0a:


    "Some violet-colored tube was hidden in her neck, and now it peeked out."


translate english d5_ending_apocalypse_d0804750:


    "\"She had so many things inside her,\" — I thought."


translate english d5_ending_apocalypse_1cf5f603:


    "Either my sister's eyes opened as she was being gutted, or Alisa just tore off her eyelids."


translate english d5_ending_apocalypse_5217a850:


    "Olya looked at me point-blank now. Her head swung like a pendulum. I swung in unison with it."


translate english d5_ending_apocalypse_98938c51:


    "The beasts were preparing food. A giant feast. A late dinner for the leprous planet."


translate english d5_ending_apocalypse_12ed03dd:



    voice "voice/Bear/5day/Da.ogg"
    Bear "There's no way this will be enough…"


translate english d5_ending_apocalypse_aa7644d5:


    "The beast that still partially looked like a bear dragged a couple of dolls on the pink snow. No, they weren't dolls…"


translate english d5_ending_apocalypse_a4dfa4bf:



    voice "voice/Bear/5day/Za.ogg"
    Bear "For Daddy… For Mommy…"


translate english d5_ending_apocalypse_1d949aca:


    "Teddy threw the bodies of my lifeless parents to the clearing."


translate english d5_ending_apocalypse_32ad29a8:


    "I moaned faintly, my hands reaching toward Mom and Dad."


translate english d5_ending_apocalypse_75dd97ec:



    voice "voice/Alisa/5day/09 Se.ogg"
    Alis "We'll have our bellies full tonight."


translate english d5_ending_apocalypse_c656842f:


    "Alisa grabbed my Dad and threw him to the pack as she licked her lips. The beasts lunged at the corpse."


translate english d5_ending_apocalypse_008ea0df:


    "The person who let me sit on his shoulders so I could better see the New Year's fireworks…"


translate english d5_ending_apocalypse_a7049e07:


    "No longer had shoulders."


translate english d5_ending_apocalypse_cdef01d3:


    "The person who let me sit on his lap…"


translate english d5_ending_apocalypse_78485961:


    "No longer had legs."


translate english d5_ending_apocalypse_d9b4d131:


    "Stop it, my daddy is the best in the world."


translate english d5_ending_apocalypse_448e498c:


    "That world no longer exists—we devoured it."


translate english d5_ending_apocalypse_037ffb3d:



    voice "voice/Alisa/5day/11 Eto.ogg" 
    Alis "This is not just meat, Bunny… "


translate english d5_ending_apocalypse_0b4fb35d:



    voice "voice/Alisa/5day/12 Eto.ogg" 
    Alis "This is the key that opens the door to our bright future."


translate english d5_ending_apocalypse_7899a4a9:



    voice "voice/Alisa/5day/13 V.ogg" 
    Alis "To the land where we will be able to eat everything."


translate english d5_ending_apocalypse_df27cf23:


    "My moерук crackled and crunched as she was torn apart. The sickles cut, сhopped, removed meat and lard from the white bones."


translate english d5_ending_apocalypse_54e69e86:


    "The bits of meat fell down, mixing in with what was left of my sister."


translate english d5_ending_apocalypse_26a83494:


    "One came from the other and then became one again."


translate english d5_ending_apocalypse_d8f84104:


    "I remembered."


translate english d5_ending_apocalypse_602f9798:


    "You remembered nothing."


translate english d5_ending_apocalypse_ae06570d:


    "I remembered Mom, playing with Olya and me, digging a small hole in the ground. We would put beads in there and cover them with stained glass."


translate english d5_ending_apocalypse_a3249752:


    "It was our treasury."


translate english d5_ending_apocalypse_70f3a6d9:


    "It was a grave."


translate english d5_ending_apocalypse_d091ea8d:



    voice "voice/Alisa/5day/14 Zr.ogg" 
    Alis "Eat up, Bunny. Do it, don't you dare resist."


translate english d5_ending_apocalypse_09225bd0:


    "The beast inside me was the first to follow the order. Before I could even blink, I was already on my knees, my hands rummaging through cold, sticky flesh."


translate english d5_ending_apocalypse_ede9132b:



    voice "voice/Anton/5day/305 1v.ogg"
    "Tears and saliva poured out of me."


translate english d5_ending_apocalypse_8262220a:


    "I brought a thick slice to my face. Was it Mom? Olya? Who cares! I'm so hungry!"


translate english d5_ending_apocalypse_d0f7466c:



    voice "voice/Anton/5day/305 0v.ogg"
    "My teeth tore into the tasty treat. There was a chip of bone inside. I swallowed it, too."


translate english d5_ending_apocalypse_d3c2e401:



    voice "voice/Anton/5day/10 Gl.ogg"
    "Mom. I'm pretty sure it was her."


translate english d5_ending_apocalypse_08bb2396:



    voice "voice/Anton/5day/305 v.ogg"
    Ant "Tasty!"


translate english d5_ending_apocalypse_c5352a59:



    voice "voice/Alisa/5day/15 Ne.ogg" 
    Alis "Tastes a bit like bunny, right?"


translate english d5_ending_apocalypse_ea51b454:



    voice "voice/Alisa/5day/16 A t.ogg" 
    Alis "Do you know that old tale about a Bunny that couldn't bite the moon?"


translate english d5_ending_apocalypse_380480f0:



    voice "voice/Alisa/5day/17 Zi.ogg" 
    Alis "There was once a boy who had many, many toys."


translate english d5_ending_apocalypse_35f0ef7c:



    voice "voice/Alisa/5day/18 E.ogg" 
    Alis "And when their owner fell asleep, they ran away from him in the dead of the night and went to the snowy clearing."


translate english d5_ending_apocalypse_0f4d389d:



    voice "voice/Alisa/5day/19 Tam.ogg" 
    Alis "There, in the soot black skies, a full moon shone."


translate english d5_ending_apocalypse_8a59d796:



    voice "voice/Alisa/5day/20 Med.ogg"
    Alis "The bear jumped first and tore off a chunk. \"Tastes like honey,\" he said."


translate english d5_ending_apocalypse_ce02a861:



    voice "voice/Alisa/5day/21 Go.ogg"
    Alis "The hungry wolf cub flew into the sky and clanged his teeth. \"Plump fishy,\" his roar rolled across the fields."


translate english d5_ending_apocalypse_ab2f4b93:



    voice "voice/Alisa/5day/22 Pr.ogg" 
    Alis "One more jump—and it was the fox's turn to lick her lips under the moonlight."


translate english d5_ending_apocalypse_521ae70a:



    voice "voice/Alisa/5day/23 Vs.ogg" 
    Alis "'Everyone knows that the moon is made of cheese,' the cunning beast said as she smirked."


translate english d5_ending_apocalypse_d29d14c5:



    voice "voice/Alisa/5day/24 As.ogg" 
    Alis "And the owl said nothing. But the others knew that everything in the world tastes like mice to her."


translate english d5_ending_apocalypse_4435a87a:



    voice "voice/Alisa/5day/25 E.ogg" 
    Alis "The tiny bunny was the only one who was afraid to jump so high that she could get a tasty chunk from the sky."


translate english d5_ending_apocalypse_0163bc7c:



    voice "voice/Alisa/5day/26 tr.ogg" 
    Alis "The scared girl escaped her master, built a nest, sewn two more tiny bunnies, and stuffed with sawdust."


translate english d5_ending_apocalypse_1126c3cc:



    voice "voice/Alisa/5day/27 E.ogg" 
    Alis "And none of them would be able to bite the moon ever again, because the Bunny shared her powers with her children."


translate english d5_ending_apocalypse_fed4482c:



    voice "voice/Alisa/5day/28 No.ogg"
    Alis "But now, Bunny, you absorbed all of that power..."


translate english d5_ending_apocalypse_f6fa50ea:


    "The Moon howled in agreement. Pus flowed out of the holes in the sky."


translate english d5_ending_apocalypse_15a8dd5a:


    "And the hunger that tormented me made me shove more and more meat into my mouth."


translate english d5_ending_apocalypse_683efc15:


    "I saw Mom standing in the kitchen, bathed in the morning sunlight. She smiles mysteriously and looks at me with kindness."


translate english d5_ending_apocalypse_66d2d10e:


    "I saw Olya running into the room to plop into my embrace. Her bright smile."


translate english d5_ending_apocalypse_56dc20c2:


    "I saw meat. My stomach swelled. My Mom and my sister got stuck between my teeth."


translate english d5_ending_apocalypse_b09469be:


    "I burped and started laughing. I licked my fingers and guffawed, slamming my fists against the leftovers."


translate english d5_ending_apocalypse_5a6bd474:


    "The pack replied with the same barking laughter. The blizzard hit us, and the beasts retreated toward the forest."


translate english d5_ending_apocalypse_f4a56e34:


    "I crawled after them on all fours after grabbing some more meat, gnawing on a joint on the go."


translate english d5_ending_apocalypse_5d32cbcc:


    "A nail pierced my palate. I spit it out and stood on my feet."


translate english d5_ending_apocalypse_5adcda02:


    "The creatures were still backtracking toward the forest."


translate english d5_ending_apocalypse_701e87e2:


    "The trees swirled in the pestilent darkness, sometimes even attacking each other."


translate english d5_ending_apocalypse_f1345f41:


    "Scarlet plasma seethed in the pits."


translate english d5_ending_apocalypse_d529d6d6:


    "Clusters of eyes grew on the trunks. They followed my every move."


translate english d5_ending_apocalypse_ee88e3c7:


    "I felt myself molting, and that was a wonderful feeling."


translate english d5_ending_apocalypse_4fed18f8:


    "The past flaked away together with the shell of a young boy."


translate english d5_ending_apocalypse_831b237d:


    "Under my old skin, something wild and unbridled spread out. Something true."


translate english d5_ending_apocalypse_61f8e512:


    "I don't feel fear in this thicket. The night belongs to us. I am the pack…"


translate english d5_ending_apocalypse_da431363:


    Narr_color "Look, this ancient forest… is it… the same?"


translate english d5_ending_apocalypse_cccee08c:


    Narr_color "I looked back at the trees that were now just trees—they didn't swarm like distressed bugs anymore."


translate english d5_ending_apocalypse_8b4b6654:


    Narr_color "Under my feet was plain old ground. And a normal girl who walked out from behind the pines and moved toward me."


translate english d5_ending_apocalypse_81b9a4a5:



    voice "voice/Alisa/5day/22 Dob.ogg"
    Alis_Color "Welcome home, Bunny."


translate english d5_ending_apocalypse_066a9a4c:



    voice "voice/Anton/5day/01 eto.ogg"
    Ant_Color "This place is so beautiful… And the festive sounds…"


translate english d5_ending_apocalypse_753fdff0:



    voice "voice/Alisa/5day/24 Ost.ogg"
    Alis_Color "There's just a tiny bit left until your reincarnation will be complete."


translate english d5_ending_apocalypse_7d8bb216:



    voice "voice/Alisa/5day/25 Den.ogg"
    Alis_Color "A birthday for a new Bunny…"


translate english d5_ending_apocalypse_c5c06a01:



    voice "voice/Alisa/5day/26 raz.ogg"
    Alis_Color "Will you allow me to pull your ears?"


translate english d5_ending_apocalypse_f0269c3f:


    Narr_color "The music and the poppers beckoned me."


translate english d5_ending_apocalypse_8aba7ab4:


    Narr_color "Somewhere near, one step away from this wondrous clearing, a heart-rending happiness awaited me."


translate english d5_ending_apocalypse_1902cba9:



    voice "voice/Alisa/5day/27 Pot.ogg"
    Alis_Color "Hurry up, silly. And I promise that I called you \"silly\" for the last time."


translate english d5_ending_apocalypse_533ea142:


    Narr_color "I took her by the hand."


translate english d5_ending_apocalypse_2e5d804e:



    voice "voice/Alisa/5day/28 Be.ogg"
    Alis_Color "Let's run!"


translate english d5_ending_apocalypse_10858d97:



    voice "voice/Anton/5day/03 no.ogg"
    Ant_Color "But where?"


translate english d5_ending_apocalypse_250ca2f5:



    voice "voice/Alisa/5day/29 Ti.ogg"
    Alis_Color "You already know."


translate english d5_ending_apocalypse_a4ef02d0:


    Narr_color "She pointed at the sky, crowned by the screaming Moon."


translate english d5_ending_apocalypse_0c6db255:


    Narr_color "I spoke hesitantly after looking at my weak legs."


translate english d5_ending_apocalypse_a5bdd886:



    voice "voice/Anton/5day/04 ona.ogg"
    Ant_Color "It's too high up."


translate english d5_ending_apocalypse_df44953d:



    voice "voice/Alisa/5day/30 Pr.ogg"
    Alis_Color "Simply forget everything they taught you in school."


translate english d5_ending_apocalypse_4bd27b18:



    voice "voice/Alisa/5day/31 Zem.ogg"
    Alis_Color "The laws of gravity are for fools."


translate english d5_ending_apocalypse_c8100a7c:



    voice "voice/Alisa/5day/32 Sd.ogg"
    Alis_Color "Want to do it together?"


translate english d5_ending_apocalypse_6c689111:


    Narr_color "I nodded. Of course, we'll do it together. This new sky was made for the two of us. And the moon was also screaming just for us."


translate english d5_ending_apocalypse_02f15857:



    voice "voice/Alisa/5day/33 R.ogg"
    Alis_Color "One…"


translate english d5_ending_apocalypse_130c6cb1:


    Narr_color "We jumped."


translate english d5_ending_apocalypse_ac90b594:



    voice "voice/Anton/5day/05 D.ogg"
    Ant_Color "Two…"


translate english d5_ending_apocalypse_23c83544:


    Narr_color "Another jump."


translate english d5_ending_apocalypse_ae72dac4:



    voice "voice/Alisa/5day/34 Tri.ogg"
    Alis_Color "Three! Come on!"


translate english d5_ending_apocalypse_62ea6a3a:


    Narr_color "And then it happened."


translate english d5_ending_apocalypse_a5b80b07:


    Narr_color "Our strong legs pushed off from the frozen ground, and our bodies rushed toward the sky, leaving the rotten filth of our black shadows behind."


translate english d5_ending_apocalypse_d8c08a03:


    "Bitter cold enveloped me, drilled into my vertebrae like a torture device, chilling me to the bone."


translate english d5_ending_apocalypse_947da193:


    "My skin cracked, blood drops turned into ice and scattered from my wounds."


translate english d5_ending_apocalypse_25a74460:


    "I blew up with laughter. But not from within my mouth, where my tongue turned blue and stiffened, but from somewhere else."


translate english d5_ending_apocalypse_dc25e2cd:


    "It was probably the darkness itself guffawing inside me."


translate english d5_ending_apocalypse_cb0e94e9:


    "Alisa flashed me a blinding smile."


translate english d5_ending_apocalypse_7b28b5e3:


    "We swirled in the howling hurricane, among the acne of stars. Frozen flesh peeled off our bones."


translate english d5_ending_apocalypse_301f0333:



    voice "voice/Alisa/5day/35 Va.ogg"
    Alis "A waltz!"


translate english d5_ending_apocalypse_a6117cd2:


    "A crack ran through her blueish face. Fragments of her cheek fell into the abyss like shards of ice."


translate english d5_ending_apocalypse_a451fe3d:


    "The wind blew the slurry of her eyeballs out of the widening holes. The movement of the sky dancers slowed down."


translate english d5_ending_apocalypse_3eefc8f3:


    "I was waltzing about embracing an ice sculpture that was once Alisa. We merged into a single silhouette."


translate english d5_ending_apocalypse_ac2ca439:



    voice "voice/Alisa/5day/30 Ya.ogg" 
    Alis "I'll be waiting for you on the ground."


translate english d5_ending_apocalypse_fdec83ec:



    voice "voice/Anton/5day/306 p.ogg"
    Ant "Wait!"


translate english d5_ending_apocalypse_f610d79f:


    "She broke away from me, shattered to pieces and crumbled in my hands, falling into the darkness that writhed underneath."


translate english d5_ending_apocalypse_d548e741:



    voice "voice/Alisa/5day/31 Let.ogg"
    Alis "Fly!"


translate english d5_ending_apocalypse_9a617c5b:


    "I knew what had to be done. I rushed upward, toward the balls of larvae and ulcers that made holes in space itself."


translate english d5_ending_apocalypse_fe60cb8b:


    "Toward the yellow Moon."


translate english d5_ending_apocalypse_02dab0da:


    "It drooled, just like me."


translate english d5_ending_apocalypse_99f73dbf:


    "My past was left somewhere below."


translate english d5_ending_apocalypse_8f825f08:


    "Katya."


translate english d5_ending_apocalypse_37e65e51:


    "She hated me, that nasty bitch."


translate english d5_ending_apocalypse_fd8c03a6:


    "Semyon."


translate english d5_ending_apocalypse_778bb2ec:


    "An ugly fatso that hit and bullied me, called me a wimp."


translate english d5_ending_apocalypse_cd60e5a8:


    "Romka."


translate english d5_ending_apocalypse_7042f478:


    "He was never truly my friend. He can rot for all I care."


translate english d5_ending_apocalypse_a37f8a80:


    "He can rot for all I care."


translate english d5_ending_apocalypse_cef4fa07:


    "Byasha."


translate english d5_ending_apocalypse_b3dc514d:


    "A sycophant and a coward. I should've gotten rid of him at the first opportunity."


translate english d5_ending_apocalypse_e48b5207:


    "Mom and Dad."


translate english d5_ending_apocalypse_c49bbec2:


    "Their screams, their endless squabbles, their cold eyes…"


translate english d5_ending_apocalypse_a33bb6b3:


    "That cursed village. That stuffy house that I hated."


translate english d5_ending_apocalypse_f0b32676:


    "Olya."


translate english d5_ending_apocalypse_aae978c4:


    "She's dead... everything's dead. Dead, destroyed, decomposed."


translate english d5_ending_apocalypse_8fca9ee6:


    "I was finally free."


translate english d5_ending_apocalypse_78ba46c1:


    "The moon pulled me upward."


translate english d5_ending_apocalypse_43b89f5f:


    "Something very important cracked and disintegrated inside me."


translate english d5_ending_apocalypse_bb1a83a2:


    "Something unnecessary."


translate english d5_ending_apocalypse_fd8a710d:


    "I forgot the name of my father."


translate english d5_ending_apocalypse_402a02cd:


    "I forgot the name of my mother."


translate english d5_ending_apocalypse_42395f02:


    "I forgot the name of that little girl I used to squeeze in a hug."


translate english d5_ending_apocalypse_c82615cd:


    "Inside the creeping, growing shadow of the yellow moon…"


translate english d5_ending_apocalypse_ee7b35d6:


    "… I forgot my own name."


translate english d5_ending_apocalypse_692a8068:


    "But I also did it…"


translate english d5_ending_apocalypse_9da5b839:


    "I managed to bite the moon."


translate english d5_ending_apocalypse_6253a0e4:


    "My skin bubbled, ungluing from the flesh. My bones popped out of it with a tearing sound."


translate english d5_ending_apocalypse_28009ad1:


    "Hunger."


translate english d5_ending_apocalypse_d4ab6502:


    "My mouth flew open so hard that my cheeks tore apart."


translate english d5_ending_apocalypse_80c88e54:


    "It was no longer a mouth. A maw."


translate english d5_ending_apocalypse_9b7ffabb:


    "My teeth all fell out, like I was a baby. Sharp bony knives grew out of my gums and pierced my lips."


translate english d5_ending_apocalypse_28009ad1_1:


    "Hunger."


translate english d5_ending_apocalypse_271e71b1:


    "My eyes popped, splashing onto my face."


translate english d5_ending_apocalypse_ddd5288b:


    "It was no longer a human face, but that of an animal."


translate english d5_ending_apocalypse_c967b697:


    "My muscles twisted into knots. New eyes were forming in my eye sockets. They saw everything as food."


translate english d5_ending_apocalypse_3c54cc0b:


    "An edible world. An endless forest, an endless hunting ground. A darkness where I could hide."


translate english d5_ending_apocalypse_a917f027:


    "I roared."


translate english d5_ending_apocalypse_fc788f37:


    "Claws protracted from my fingers, ripping off my nails. I tore off the remains of my old skin, the pieces of my old face, my old hair."


translate english d5_ending_apocalypse_3d700041:


    "The moon howled as it watched my transformation."


translate english d5_ending_apocalypse_0d15b8a0:


    "And when the rite was complete, when my new bones conjoined under my hide, when my skull hardened, taking on its true form, I stopped inside the mucous sky, among the stars…"


translate english d5_ending_apocalypse_96b90833:


    "And rushed back to the Earth."


translate english d5_ending_apocalypse_aftertitles_4f1f2870:


    "The world was bleeding. The planet descended into pitch-black darkness. The fires went out, and entire cities turned to ash in the blink of an eye."


translate english d5_ending_apocalypse_aftertitles_f85bb0cb:


    "An assmeblage of claws, tails, and teeth crawled, destroying life itself."


translate english d5_ending_apocalypse_aftertitles_b059498b:


    "Seas turned crimson."


translate english d5_ending_apocalypse_aftertitles_ec12dbb1:


    "Forest fires were the only source of light. Shadows of colossal monsters darted inside their flames."


translate english d5_ending_apocalypse_aftertitles_f41bc95d:


    "They devoured rivers and mountains. They gnawed on the bones of reality."


translate english d5_ending_apocalypse_aftertitles_945ec078:


    "I'm hiding in the dark."


translate english d5_ending_apocalypse_aftertitles_e7675e99:


    "I dig into the ground, I spend nights in the dug-up graves after slurping up their contents. But I still can't hide from hunger."


translate english d5_ending_apocalypse_aftertitles_b4a15109:


    "It can't be sated, not even for a moment."


translate english d5_ending_apocalypse_aftertitles_4c5e6ebf:


    "I'm starving. I'm so hungry I'm chewing myself. I wouldn't be full even if I ate the moon."


translate english d5_ending_apocalypse_aftertitles_5ac75451:


    "All I can do is consume. I am hunger, I am the devourer of worlds."


translate english d5_ending_apocalypse_aftertitles_b5681231:


    "I create nothingness."


translate english d5_ending_apocalypse_aftertitles_c2372922:


    "I leave the half-eaten core of the planet. I devour graveyards."


translate english d5_ending_apocalypse_aftertitles_44dbc48e:


    "My howl is a death chant. My body is bigger than anything anyone could ever imagine if I hadn't already eaten everybody."


translate english d5_ending_apocalypse_aftertitles_9d9df590:


    "I walk in the darkness, scooping up cliffs and seas with my open mouth. My eyes roll around in the craters of my eye sockets, seeking nutrition around me."


translate english d5_ending_apocalypse_aftertitles_e6112b58:


    "I eat the stars."


translate english d5_ending_apocalypse_aftertitles_0327f1df:


    "I consume the cosmos."


translate english d5_ending_apocalypse_aftertitles_bd9f34b4:


    "I can hear the planets scream. I hear the universe wail in horror, its dying convulsions never-ending."


translate english d5_ending_genius_24b69a63:


    "I wouldn't dare judge her for that quirk after the madness she endured."


translate english d5_ending_genius_5f166b28:


    "My own face was twisted in a smirk of my inner beast's doing."


translate english d5_ending_genius_98bf043d:


    "In the end, everything I ever wanted, everything I strived for was this girl and our friendship."


translate english d5_ending_genius_d41696b5:


    "Or even something more than friendship..."


translate english d5_ending_genius_222c0f58:


    "I hugged Polina, and she replied with a strong embrace of her own."


translate english d5_ending_genius_aftertitles_a6cffed1:



    voice "voice/anton/Adult/01 Ni.ogg"
    Ant "I could never understand why they put a psych ward in such a small village."


translate english d5_ending_genius_aftertitles_cc5d1ead:



    voice "voice/Polina/5day/240 Et.ogg"
    Pol "It's the regional hospital."


translate english d5_ending_genius_aftertitles_0533997a:



    voice "voice/Polina/5day/241 E.ogg" 
    Pol "Besides… Here, near the forest, it's so easy to go insane."


translate english d5_ending_genius_aftertitles_ff4328a3:


    "I was oh-so painfully aware of that."


translate english d5_ending_genius_aftertitles_072df676:


    "The wind rustled with the naked tree branches in a small, deserted park."


translate english d5_ending_genius_aftertitles_4f51b9e6:


    "The sun set over the taiga. The air was damp and smelled of pine."


translate english d5_ending_genius_aftertitles_ba6e02b3:


    "Shadows slithered near the building's weathered face like the ghosts of madmen in black hospital gowns."


translate english d5_ending_genius_aftertitles_9cf23689:


    "This village was akin to a corpse with balsamic liquid solidifying inside it."


translate english d5_ending_genius_aftertitles_741a7b3f:


    "A horrific doll, crafted by some necrophiliac from the clothes he stole from dead people."


translate english d5_ending_genius_aftertitles_8f48c252:


    "After everything that I had to do. After Polina and I had touched the darkness…"


translate english d5_ending_genius_aftertitles_4420c13b:


    "We were deep in it up to our elbows, like in blood."


translate english d5_ending_genius_aftertitles_f30b464f:


    "Standing near the car, side by side with my partner, I glared at the barred windows."


translate english d5_ending_genius_aftertitles_5e6d53a3:


    "Snow fell from the sky, solemn and anxious."


translate english d5_ending_genius_aftertitles_1f3801fd:


    "I could end up in this place myself. Tied to a bed, sedated with drugs."


translate english d5_ending_genius_aftertitles_510419b0:


    "But we managed to escape the locked hospital rooms."


translate english d5_ending_genius_aftertitles_e9698ead:


    "When the EMERCOM people picked up Byasha all those years ago, he was crawling down in the forest ravines."


translate english d5_ending_genius_aftertitles_9a7dc6aa:


    "The doctors found remains of voles and squirrels in his stomach."


translate english d5_ending_genius_aftertitles_51bdc441:


    "He survived the best he could. The police reasoned that the poor boy became the victim of a serial killer, and that shook his mind."


translate english d5_ending_genius_aftertitles_24076b5e:


    "Polina and I stayed in one piece using our own methods."


translate english d5_ending_genius_aftertitles_b238fdde:


    "But what if the real madmen are not inside, but out there?"


translate english d5_ending_genius_aftertitles_9d9523e7:


    "I looked at my phone. My dad, with a soft smile on his face, looked back at me from the wallpaper."


translate english d5_ending_genius_aftertitles_e56fd699:


    "He was holding Olya by the hand."


translate english d5_ending_genius_aftertitles_bdca3966:


    "My little sister laughed, as if fossilized in amber, in that distant, forever lost summer day."


translate english d5_ending_genius_aftertitles_8919fed2:


    "I checked the time in the corner of the screen."


translate english d5_ending_genius_aftertitles_bb29541b:



    voice "voice/anton/Adult/02 Pr.ogg"
    Ant "It's visitation hours."


translate english d5_ending_genius_aftertitles_8a746ce9:



    voice "voice/Polina/5day/242 Poi.ogg"
    Pol "Let's go."


translate english d5_ending_genius_aftertitles_ceead2b1:


    "Drafts blew through the entrance hall of the decrepit building."


translate english d5_ending_genius_aftertitles_8fbee3ed:


    "Every other light bulb was busted, so the hallways were barely illuminated."


translate english d5_ending_genius_aftertitles_936efac0:



    voice "voice/Med/01Vi.ogg"
    Doctor "Can I help you?"


translate english d5_ending_genius_aftertitles_e579464c:



    voice "voice/Polina/5day/243 K.ogg" 
    Pol "We're here to see Igor Budaev."


translate english d5_ending_genius_aftertitles_c7620562:



    voice "voice/Med/02 A.ogg"
    Doctor "Ah… Our regular!"


translate english d5_ending_genius_aftertitles_06921d76:



    voice "voice/Med/04 Pa.ogg"
    Doctor "The patients are all currently in the canteen or undergoing routine treatment, but Igor Dulgarovich is already back in his room."


translate english d5_ending_genius_aftertitles_3777a7c7:



    voice "voice/anton/Adult/03 Ka.ogg"
    Ant "How is he feeling?"


translate english d5_ending_genius_aftertitles_150687a3:



    voice "voice/Med/05 Nad.ogg"
    Doctor "Still no hope for recovery, I'm afraid."


translate english d5_ending_genius_aftertitles_bc837448:



    voice "voice/Med/06 Bo.ogg"
    Doctor "He will probably need medical assistance for the rest of his life."


translate english d5_ending_genius_aftertitles_087ce2fa:



    voice "voice/Med/07 no.ogg"
    Doctor "But, you know, Igor has been so engrossed in arts and crafts lately. And we welcome any form of art therapy here."


translate english d5_ending_genius_aftertitles_27593af4:



    voice "voice/Med/08 on.ogg"
    Doctor "He even became the head of an arts club in our children's ward."


translate english d5_ending_genius_aftertitles_91451150:



    voice "voice/anton/Adult/04 Ne.ogg"
    Ant "Ha, is he doing wood burning again?"


translate english d5_ending_genius_aftertitles_4b78d5bf:



    voice "voice/Med/09 da.ogg"
    Doctor "Oh no, there's no way we'd trust him with a soldering iron."


translate english d5_ending_genius_aftertitles_724f1558:



    voice "voice/Med/10 net.ogg"
    Doctor "He sews costumes for our amateur theater."


translate english d5_ending_genius_aftertitles_85f45293:



    voice "voice/Polina/5day/244 Da.ogg"
    Pol "This is a talent factory you have here, not a hospital."


translate english d5_ending_genius_aftertitles_87ab264d:


    "The medical worker didn't catch the sarcasm."


translate english d5_ending_genius_aftertitles_29f2f94f:



    voice "voice/Med/11 Na.ogg"
    Doctor "Yes, they are such great kids."


translate english d5_ending_genius_aftertitles_78a3e29a:



    voice "voice/Med/03 Ed.ogg"
    Doctor "Follow me."


translate english d5_ending_genius_aftertitles_82b507c1:


    "A cockroach ran across the linoleum floor. Polina crushed it with her shoe and winced in disgust."


translate english d5_ending_genius_aftertitles_8d7c84ec:


    "The medical worker opened the door."


translate english d5_ending_genius_aftertitles_3ec90d1a:



    voice "voice/Med/12 Eg.ogg"
    Doctor "Igor Dulganovich, you have guests."


translate english d5_ending_genius_aftertitles_e651be23:


    "I prepared myself for this meeting, but the sight of Byashsa, who clearly aged faster than normal, still left me stunned."


translate english d5_ending_genius_aftertitles_b4330c0a:


    "The patient wearing state-issued pajamas tore his gaze from the window and turned his silver-haired head to us."


translate english d5_ending_genius_aftertitles_488a9883:


    "His watery eyes were empty."


translate english d5_ending_genius_aftertitles_ec7537a7:


    "Polina sensed it was the right moment to give us some privacy, so she started talking to the medical worker to distract her."


translate english d5_ending_genius_aftertitles_90a6ec6c:


    "I couldn't hear them anymore. My initial shock was replaced with determination."


translate english d5_ending_genius_aftertitles_9237ef0b:


    "I got close to my old buddy, covering him with my shadow."


translate english d5_ending_genius_aftertitles_4d3504d8:


    "Byasha shriveled as if that shadow burned him."


translate english d5_ending_genius_aftertitles_844d06ed:



    voice "voice/byasha/5day/01k.ogg"
    Bya "Wh-h-h-o are y-y-y-ou, eh?"


translate english d5_ending_genius_aftertitles_fe016b6f:



    voice "voice/anton/Adult/05 Pr.ogg"
    Ant "Pretending that you forgot me, huh?"


translate english d5_ending_genius_aftertitles_8df23e76:



    voice "voice/byasha/5day/02ne.ogg"
    Bya "D-d-don't hurt me, eh."


translate english d5_ending_genius_aftertitles_981ea14b:


    "I lowered my voice down to a chilling whisper. It was a one-on-one conversation."


translate english d5_ending_genius_aftertitles_4a693303:



    voice "voice/anton/Adult/06 Es.ogg"
    Ant "If pain can make you remember…"


translate english d5_ending_genius_aftertitles_5c34aed3:



    voice "voice/byasha/5day/03ee.ogg"
    "I stood in front of him to cover the medical worker's vision with my back and grabbed him by the collar."


translate english d5_ending_genius_aftertitles_3c264bba:



    voice "voice/byasha/5day/04d.ogg"
    Bya "M-m-mister, p-p-please."


translate english d5_ending_genius_aftertitles_1937606d:



    voice "voice/byasha/5day/05Ya.ogg"
    Bya "I'm j-j-j-ust a kid, eh."


translate english d5_ending_genius_aftertitles_7a282e46:



    voice "voice/anton/Adult/07 Te.ogg"
    Ant "You're thirty-seven."


translate english d5_ending_genius_aftertitles_dc2ff582:



    voice "voice/byasha/5day/06ne.ogg"
    Bya "L-Lies."


translate english d5_ending_genius_aftertitles_5a9473c8:



    voice "voice/byasha/5day/07po.ogg"
    Bya "Why are you t-t-t-telling lies?"


translate english d5_ending_genius_aftertitles_f2b7b204:


    "I tugged at his clothes harder."


translate english d5_ending_genius_aftertitles_c3ae084c:



    voice "voice/anton/Adult/09 E.ogg"
    Ant "I would kill you on the spot if I could, do you understand?"


translate english d5_ending_genius_aftertitles_966c2932:



    voice "voice/anton/Adult/09 V.ogg"
    Ant "Look at me."


translate english d5_ending_genius_aftertitles_12ab6ce5:



    voice "voice/Med/13 Se.ogg"
    Doctor "I'm sorry, but you can't treat our patients like that."


translate english d5_ending_genius_aftertitles_8b9e7234:


    "\"I haven't even started,\" I thought as I unclenched my fingers."


translate english d5_ending_genius_aftertitles_3489f996:



    voice "voice/Polina/5day/246 Vs.ogg" 
    Pol "It's okay, they're old friends."


translate english d5_ending_genius_aftertitles_9156bab7:


    "Byasha's gaze started darting around the room until it stopped on Polina."


translate english d5_ending_genius_aftertitles_f28dc922:


    "Our former classmate pressed his back into the wall, his entire body trembling."


translate english d5_ending_genius_aftertitles_7553063e:



    voice "voice/byasha/5day/10za.ogg"
    Bya "Why did you b-b-bring her here!?"


translate english d5_ending_genius_aftertitles_0deec457:



    voice "voice/byasha/5day/11pr.ogg"
    Bya "Chase h-her away, eh, away!!!"


translate english d5_ending_genius_aftertitles_2a301c57:



    voice "voice/byasha/5day/12uh.ogg"
    Bya "Leave, you and that b-b-beast both!"


translate english d5_ending_genius_aftertitles_6115c863:


    "I also turned toward Polina, who stood unmoving in the dark corner."


translate english d5_ending_genius_aftertitles_a832d9bd:


    "A scary smile gaped on her face like an open wound."


translate english d5_ending_genius_aftertitles_669933d9:


    "We exchanged non-verbal signs."


translate english d5_ending_genius_aftertitles_ae360a4a:


    "It was time."


translate english d5_ending_genius_aftertitles_c3339476:


    "Time for a ride."


translate english d5_ending_genius_aftertitles_a23a076b:


    "She beckoned the medical worker away."


translate english d5_ending_genius_aftertitles_e0d8e1fa:



    voice "voice/Polina/5day/247 M.ogg" 
    Pol "Could we maybe go for a walk with Bya… with Budaev?"


translate english d5_ending_genius_aftertitles_aa056f35:



    voice "voice/Polina/5day/248 Es.ogg" 
    Pol "Under our responsibility, of course."


translate english d5_ending_genius_aftertitles_7c9c5287:



