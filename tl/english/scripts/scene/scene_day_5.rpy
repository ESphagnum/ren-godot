translate english event_slaughter_devend_07fb321b:



    voice "voice/Alisa/5day/Vpizdu.ogg" 
    Alis "Fuck Polina!"


translate english event_slaughter_devend_469f4526:



    voice "voice/Alisa/5day/21 To.ogg" 
    Alis "Only you and I. Time to decide, baby."


translate english event_slaughter_devend_fb78610c:



    voice "voice/Alisa/5day/22 Tol.ogg"
